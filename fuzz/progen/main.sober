package main

// progen: 表層の Sober プログラムの生成器（desugar 規律スイープの網 — check ≟ build の差分オラクルの入力。文法指向 = Csmith の型）。
//   progen <シード> [<大きさ>]   — 標準出力にプログラムを 1 本書く。同じ (シード, 大きさ) なら同じバイト列（std/rand — グローバルな乱数は持たない）
// 型の付いた式を型ごとに生成する（int / bool / string / S〔struct〕/ int?）。error 系（`(int, error?)` を返す関数・ラベル Bad〔欄あり〕/ Worse・`?` の伝播・
// `catch D`・多値の束縛 + `!= nil`）と総称（明示のインスタンス化 `ident[int](…)` / `pick2[bool](…)`・推論 `pick2(…)` — region を持たない型だけ。ラムダの結果から決まる型引数 `apL(x, (w) => …)` は展開される総称なので string / S も — P3b 残穴2。
// string でのインスタンス化は R3 の未実装で両方が拒否する既知の形）も混ぜる（掃除枠 C 段 3 — 網の拡張）。
// mut 実引数は 1 本（`f(mut vK)`）か 2 本（`f(mut vK, mut vJ.a)` — 根を非復元で引く: mut 実引数の排他〔diag.MutAlias〕を守る。破れば fuzz_cb が GenMutAlias で名指す）。
// error の switch は入れない（analyzer〔check だけ〕が到達しない腕を拒否するので、check だけの拒否 = 偽の食い違いになる）。文は 1 行 1 文・ブロックの { は行末・} は単独の行に置く
// — 駆動部（scripts/fuzz_cb.ts）の縮小が「行の範囲を消す」で構造を壊さずに済むように。生成するのは型の合うプログラムを狙った形だけで、
// 型の合わないものは check / build の両方が拒否する（一致 — 差分オラクルは両者の受理 / 拒否の食い違いだけを拾う）

import "std/convert"
import "std/io"
import "std/iter"
import "std/os"
import "std/rand"
import "std/strings"

const TInt = 0
const TBool = 1
const TStr = 2
const TS = 3
const TOpt = 4
const NTY = 5

// G は生成の状態: 出力・乱数・変数の環境（名前の番号と型・mut か）・関数の表
type G struct {
    out mut []byte
    r rand.Rand
    size int
    vty mut []int    // 変数 v<i> の型（-1 = 見えない — スコープの外）
    vmut mut []bool
    vdm mut []bool   // v<i> が mut で宣言された（ループの数え上げは vmut を落とすが、子の捕獲には使えない — par の文）
    nv int
    fty mut []int    // 関数 f<i> の戻りの型（-1 = 値なし）
    fpar mut []int   // 関数 f<i> の仮引数の型（1 つ — mut S か int）
    fmutp mut []bool
    fmut2 mut []bool // mut S の関数が 2 本目の仮引数 `mut int` を持つか（呼び出しは別の mut S の欄 `mut vK.a` を渡す — mut 実引数の排他: 根を重ねない）
    fer mut []bool   // 関数 f<i> が (int, error?) を返すか
    nf int
    depth int
    inErr bool       // 今の関数が (int, error?) を返す（`?` を書ける）
    par bool         // std/task の文を混ぜる（第 3 引数 `par` — 無ければ今までのシードと同じバイト列）
    usedPar bool
}

func emit(g mut G, s string) {
    b := bytes(s)
    for i <- iter.Range(0, len(b)) {
        g.out = append(g.out, b[i])
    }
}

func line(g mut G, s string) {
    for i <- iter.Range(0, g.depth) {
        emit(mut g, "    ")
    }
    emit(mut g, s)
    emit(mut g, "\n")
}

func pick(g mut G, n int) int {
    return rand.Intn(mut g.r, n)
}

func vname(i int) string {
    return "v" + convert.FormatInt(i)
}

// varOf は型 t の見えている変数の番号（無ければ -1）。mut のものだけなら wantMut
func varOf(g mut G, t int, wantMut bool) int {
    mut cands := mut []int{}
    for i <- iter.Range(0, g.nv) {
        if g.vty[i] == t && (!wantMut || g.vmut[i]) {
            cands = append(cands, i)
        }
    }
    if len(cands) == 0 {
        return -1
    }
    return cands[pick(mut g, len(cands))]
}

// varOther は型 t の見えている mut の変数のうち except でないものの番号（無ければ -1）— 1 つの呼び出しの mut 実引数を非復元で引く
func varOther(g mut G, t int, except int) int {
    mut cands := mut []int{}
    for i <- iter.Range(0, g.nv) {
        if g.vty[i] == t && g.vmut[i] && i != except {
            cands = append(cands, i)
        }
    }
    if len(cands) == 0 {
        return -1
    }
    return cands[pick(mut g, len(cands))]
}

// cond は条件位置（if の条件・switch の subject）の式: 先頭の `{` は subject なし switch / 本体の `{` と読まれ、composite literal は条件中では括弧が要る
// （syntax.md 決定 5）ので、そのどちらかを含めば括弧で包む（両方が文法で拒否する偽の both-reject を出さない）
func cond(g mut G, t int, d int) string {
    e := expr(mut g, t, d)
    return if strings.HasPrefix(e, "{") || strings.Contains(e, "S{") { "(" + e + ")" } else { e }
}

// elem は composite literal の欄の値: 先頭の `{` は（Go の literal 省略と同じ位置で）文法が受けないので括弧で包む
func elem(e string) string {
    return if strings.HasPrefix(e, "{") { "(" + e + ")" } else { e }
}

// expr は型 t の式（d = 残りの深さ）
func expr(g mut G, t int, d int) string {
    if d <= 0 || pick(mut g, 4) == 0 {
        return leaf(mut g, t)
    }
    k := pick(mut g, 6)
    if k == 0 {
        // if 式
        return "if " + cond(mut g, TBool, d - 1) + " { " + expr(mut g, t, d - 1) + " } else { " + expr(mut g, t, d - 1) + " }"
    }
    if k == 1 && t != TOpt {
        // ブロック式
        return "{ " + expr(mut g, t, d - 1) + " }"
    }
    if k == 2 {
        // switch 式（int の定数の腕）
        return "switch " + cond(mut g, TInt, d - 1) + " { case 0: " + expr(mut g, t, d - 1) + "; case 1 | 2: " + expr(mut g, t, d - 1) + "; default: " + expr(mut g, t, d - 1) + " }"
    }
    if k == 3 {
        f := funcOf(mut g, t)
        if f >= 0 && !g.fmutp[f] && !g.fer[f] {
            return "f" + convert.FormatInt(f) + "(" + expr(mut g, g.fpar[f], d - 1) + ")"
        }
    }
    return switch t {
    case TInt: intOp(mut g, d)
    case TBool: boolOp(mut g, d)
    case TStr: strOp(mut g, d)
    case TS: "S{a: " + elem(expr(mut g, TInt, d - 1)) + ", s: " + elem(expr(mut g, TStr, d - 1)) + "}"
    default: leaf(mut g, t)
    }
}

func intOp(g mut G, d int) string {
    k := pick(mut g, 10)
    if k == 8 {
        // ラムダの結果から決まる型引数（P3b 残穴2 — string → int）
        x := expr(mut g, TStr, d - 1)
        w := lamParam(mut g, TStr)
        b := "(len(bytes(" + vname(w) + ")) + " + expr(mut g, TInt, d - 1) + ")"
        g.vty[w] = -3
        return "apL(" + x + ", (" + vname(w) + ") => " + b + ")"
    }
    if k == 9 {
        // int → S（ラムダの本体の struct の宣言から欄を読む）
        x := expr(mut g, TInt, d - 1)
        w := lamParam(mut g, TInt)
        b := "S{a: " + vname(w) + ", s: " + elem(expr(mut g, TStr, d - 1)) + "}"
        g.vty[w] = -3
        return "(apL(" + x + ", (" + vname(w) + ") => " + b + ")).a"
    }
    if k == 5 {
        // catch 式（二項演算子より強い — 括弧で包んで他の演算の項に置く）。D は単項式の閉集合（リテラル・変数・負の数）
        return "(" + errCall(mut g, d - 1) + " catch " + catchD(mut g) + ")"
    }
    if k == 6 {
        return "ident[int](" + expr(mut g, TInt, d - 1) + ")"
    }
    if k == 7 {
        return "pick2(" + expr(mut g, TBool, d - 1) + ", " + expr(mut g, TInt, d - 1) + ", " + expr(mut g, TInt, d - 1) + ")"
    }
    if k == 0 {
        return "len(bytes(" + expr(mut g, TStr, d - 1) + "))"
    }
    if k == 1 {
        return "(" + expr(mut g, TS, d - 1) + ").a"
    }
    op := switch k {
    case 2: " + "
    case 3: " - "
    default: " * "
    }
    return "(" + expr(mut g, TInt, d - 1) + op + expr(mut g, TInt, d - 1) + ")"
}

func boolOp(g mut G, d int) string {
    k := pick(mut g, 6)
    if k == 5 {
        // ラムダの結果から決まる型引数（int → bool）
        x := expr(mut g, TInt, d - 1)
        w := lamParam(mut g, TInt)
        b := "(" + vname(w) + " < " + expr(mut g, TInt, d - 1) + ")"
        g.vty[w] = -3
        return "apL(" + x + ", (" + vname(w) + ") => " + b + ")"
    }
    // 総称は region を持たない型（int / bool）だけ — string 等でのインスタンス化は R3（region を持つ型引数の実体 Def — 未実装のピン）で両方が拒否する既知の形
    if k == 4 {
        return "pick2[bool](" + expr(mut g, TBool, d - 1) + ", " + expr(mut g, TBool, d - 1) + ", " + leaf(mut g, TBool) + ")"
    }
    return switch k {
    case 0: "(" + expr(mut g, TInt, d - 1) + " < " + expr(mut g, TInt, d - 1) + ")"
    case 1: "(" + expr(mut g, TBool, d - 1) + " && " + expr(mut g, TBool, d - 1) + ")"
    case 2: "!" + leaf(mut g, TBool)
    default: "(" + expr(mut g, TStr, d - 1) + " == " + expr(mut g, TStr, d - 1) + ")"
    }
}

func strOp(g mut G, d int) string {
    k := pick(mut g, 4)
    if k == 3 {
        // ラムダの結果から決まる型引数（int → string）
        x := expr(mut g, TInt, d - 1)
        w := lamParam(mut g, TInt)
        b := "(\"n\${" + vname(w) + "}\" + " + expr(mut g, TStr, d - 1) + ")"
        g.vty[w] = -3
        return "apL(" + x + ", (" + vname(w) + ") => " + b + ")"
    }
    return switch k {
    case 0: "(" + expr(mut g, TStr, d - 1) + " + " + expr(mut g, TStr, d - 1) + ")"
    case 1: "\"n\${" + expr(mut g, TInt, d - 1) + "}\""
    default: "(" + expr(mut g, TS, d - 1) + ").s"
    }
}

// lamParam はラムダの仮引数（型 t の imm の変数 — 本体を作った後に呼び手が見えなくする。名前は使い回さない）
func lamParam(g mut G, t int) int {
    return declare(mut g, t, false)
}

func leaf(g mut G, t int) string {
    v := varOf(mut g, t, false)
    if v >= 0 && pick(mut g, 3) != 0 {
        return vname(v)
    }
    return switch t {
    case TInt: convert.FormatInt(pick(mut g, 20))
    case TBool: if pick(mut g, 2) == 0 { "true" } else { "false" }
    case TStr: strLit(pick(mut g, 3))
    case TS: "S{a: " + convert.FormatInt(pick(mut g, 9)) + ", s: \"z\"}"
    default: if pick(mut g, 2) == 0 { "nil" } else { convert.FormatInt(pick(mut g, 9)) }
    }
}

// errCall は (int, error?) を返す呼び出し（mayFail か、前に宣言した error を返す関数）
func errCall(g mut G, d int) string {
    mut cands := mut []int{}
    for i <- iter.Range(0, g.nf) {
        if g.fer[i] {
            cands = append(cands, i)
        }
    }
    if len(cands) > 0 && pick(mut g, 2) == 0 {
        f := cands[pick(mut g, len(cands))]
        return "f" + convert.FormatInt(f) + "(" + expr(mut g, g.fpar[f], d) + ")"
    }
    return "mayFail(" + expr(mut g, TInt, d) + ")"
}

// catchD は catch の既定値（単項式 — リテラル・int の変数・負のリテラル）
func catchD(g mut G) string {
    k := pick(mut g, 3)
    if k == 0 {
        v := varOf(mut g, TInt, false)
        if v >= 0 {
            return vname(v)
        }
    }
    return if k == 1 { "-" + convert.FormatInt(pick(mut g, 5)) } else { convert.FormatInt(pick(mut g, 9)) }
}

func strLit(k int) string {
    return if k == 0 { "\"a\"" } else if k == 1 { "\"bc\"" } else { "\"\"" }
}

func funcOf(g mut G, t int) int {
    mut cands := mut []int{}
    for i <- iter.Range(0, g.nf) {
        if g.fty[i] == t {
            cands = append(cands, i)
        }
    }
    if len(cands) == 0 {
        return -1
    }
    return cands[pick(mut g, len(cands))]
}

// declare は新しい変数（名前は使い回さない — シャドーイング禁止の下で兄弟のスコープでも同じ名前を避ける）
func declare(g mut G, t int, m bool) int {
    g.vty = append(g.vty, t)
    g.vmut = append(g.vmut, m)
    g.vdm = append(g.vdm, m)
    g.nv = g.nv + 1
    return g.nv - 1
}

// stmts は文の列（n 文 — ret = 関数の戻りの型〔-1 = 値なし〕・最後の文で return するか）
func stmts(g mut G, n int, ret int, d int) {
    mark := g.nv
    for k <- iter.Range(0, n) {
        stmt(mut g, ret, d)
    }
    // スコープを閉じる（このブロックで宣言した変数は見えなくする — 名前は使い回さない: シャドーイング禁止）
    for i <- iter.Range(mark, g.nv) {
        g.vty[i] = -3
    }
}

func stmt(g mut G, ret int, d int) {
    if g.par && d > 0 && pick(mut g, 4) == 0 {
        parStmt(mut g)
        return
    }
    k := pick(mut g, 12)
    if k == 9 && g.inErr {
        // `?` の伝播（error を返す関数の中だけ）
        // 右辺を先に作る（宣言の前 — 右辺が自分を参照しない）
        rhs := errCall(mut g, 2)
        v := declare(mut g, TInt, pick(mut g, 2) == 0)
        line(mut g, (if g.vmut[v] { "mut " } else { "" }) + vname(v) + " := " + rhs + "?")
        return
    }
    if k == 10 {
        // 多値の束縛 + `!= nil`（error の値は捨てる — switch は入れない）
        rhs := errCall(mut g, 2)
        v := declare(mut g, TInt, false)
        line(mut g, vname(v) + ", e" + convert.FormatInt(v) + " := " + rhs)
        line(mut g, "if e" + convert.FormatInt(v) + " != nil {")
        g.depth = g.depth + 1
        if g.inErr && pick(mut g, 2) == 0 {
            line(mut g, "return 0, Worse{}")
        } else {
            line(mut g, "println(-2)")
        }
        g.depth = g.depth - 1
        line(mut g, "}")
        line(mut g, "println(" + vname(v) + ")")
        return
    }
    if k == 11 && g.inErr && d > 0 {
        // ラベルを返す早期 return（欄ありの Bad）
        line(mut g, "if " + cond(mut g, TBool, 2) + " {")
        g.depth = g.depth + 1
        line(mut g, "return 0, Bad{n: " + elem(expr(mut g, TInt, 2)) + "}")
        g.depth = g.depth - 1
        line(mut g, "}")
        return
    }
    if k <= 2 {
        t := pick(mut g, NTY)
        m := pick(mut g, 2) == 0
        // int? は optOf で作る（nil だけの初期化は型が決まらない）
        e := if t == TOpt { "optOf(" + expr(mut g, TInt, 2) + ", " + expr(mut g, TBool, 2) + ")" } else { expr(mut g, t, 3) }
        v := declare(mut g, t, m)
        line(mut g, (if m { "mut " } else { "" }) + vname(v) + " := " + e)
        return
    }
    if k == 3 {
        t := pick(mut g, NTY - 1)
        v := varOf(mut g, t, true)
        if v >= 0 {
            line(mut g, vname(v) + " = " + expr(mut g, t, 3))
            return
        }
    }
    if k == 4 && d > 0 {
        line(mut g, "if " + cond(mut g, TBool, 2) + " {")
        g.depth = g.depth + 1
        stmts(mut g, 1 + pick(mut g, 3), ret, d - 1)
        g.depth = g.depth - 1
        if pick(mut g, 2) == 0 {
            line(mut g, "} else {")
            g.depth = g.depth + 1
            stmts(mut g, 1 + pick(mut g, 3), ret, d - 1)
            g.depth = g.depth - 1
        }
        line(mut g, "}")
        return
    }
    if k == 5 && d > 0 {
        // 有界のループ
        c := declare(mut g, TInt, true)
        line(mut g, "mut " + vname(c) + " := 0")
        line(mut g, "while " + vname(c) + " < " + convert.FormatInt(1 + pick(mut g, 3)) + " {")
        g.depth = g.depth + 1
        g.vmut[c] = false
        stmts(mut g, 1 + pick(mut g, 2), ret, d - 1)
        line(mut g, vname(c) + " += 1")
        g.depth = g.depth - 1
        line(mut g, "}")
        return
    }
    if k == 6 {
        // 値を捨てる式文（関数の呼び出し — F-e の型）
        f := funcOf(mut g, TInt)
        if f >= 0 && !g.fmutp[f] && !g.fer[f] {
            line(mut g, "f" + convert.FormatInt(f) + "(" + expr(mut g, g.fpar[f], 2) + ")")
            return
        }
    }
    if k == 7 {
        // mut S を受ける関数の呼び出し
        for i <- iter.Range(0, g.nf) {
            if g.fmutp[i] {
                v := varOf(mut g, TS, true)
                if v >= 0 && !g.fmut2[i] {
                    line(mut g, "f" + convert.FormatInt(i) + "(mut " + vname(v) + ")")
                    return
                }
                w := varOther(mut g, TS, v)
                if v >= 0 && w >= 0 {
                    line(mut g, "f" + convert.FormatInt(i) + "(mut " + vname(v) + ", mut " + vname(w) + ".a)")
                    return
                }
            }
        }
    }
    if k == 8 && ret >= 0 && d > 0 {
        // 早期 return
        line(mut g, "if " + cond(mut g, TBool, 2) + " {")
        g.depth = g.depth + 1
        line(mut g, "return " + expr(mut g, ret, 2) + (if g.inErr { ", nil" } else { "" }))
        g.depth = g.depth - 1
        line(mut g, "}")
        return
    }
    line(mut g, "println(" + expr(mut g, TInt, 2) + ")")
}

// childExpr は Spawn の子の本体（int の式）: mut で宣言した変数は見せない（子は imm の値しか捕獲できない — 捕獲できる形だけを狙う）
func childExpr(g mut G, d int) string {
    mut saved := mut []int{}
    for i <- iter.Range(0, g.nv) {
        saved = append(saved, g.vty[i])
        if g.vdm[i] {
            g.vty[i] = -3
        }
    }
    e := expr(mut g, TInt, d)
    // 式の中で宣言したラムダの仮引数（lamParam — 見えなくしてある）は saved の外
    for i <- iter.Range(0, len(saved)) {
        g.vty[i] = saved[i]
    }
    return e
}

// spawnLine は `h := task.Spawn(s, () => …)`: 半分は子が印字する本体（段 6 P4-2 — stdout の先行順〔O1〕の網: 子の行は spawn の位置に入る）
func spawnLine(g mut G, h string, ns string) {
    if pick(mut g, 2) == 0 {
        line(mut g, h + " := task.Spawn(s" + ns + ", () => " + childExpr(mut g, 2) + ")")
        return
    }
    line(mut g, h + " := task.Spawn(s" + ns + ", () => {")
    g.depth = g.depth + 1
    line(mut g, "println(" + childExpr(mut g, 2) + ")")
    line(mut g, childExpr(mut g, 2))
    g.depth = g.depth - 1
    line(mut g, "})")
}

// parStmt は std/task の文（段 6 P3a — 捕獲の 2 実装〔desugar = コアの自由変数・lower = 表層の走査〕の網）: scope を開き、捕獲する子を 1〜2 本生んで
// Join / Try で受ける。scope の err は -3 を印字・値は println（子の死は Try で値・Join で親の死 — どちらも観測）
func parStmt(g mut G) {
    g.usedPar = true
    n := declare(mut g, TInt, false)
    ns := convert.FormatInt(n)
    // 束縛の名前は scope の後から見える（本体の中では見せない）
    g.vty[n] = -3
    line(mut g, vname(n) + ", pe" + ns + " := task.Run((s" + ns + " task.Scope) => {")
    g.depth = g.depth + 1
    spawnLine(mut g, "h" + ns, ns)
    form := pick(mut g, 3)
    if form == 0 {
        line(mut g, "task.Join(h" + ns + ") + " + expr(mut g, TInt, 2))
    } else if form == 1 {
        line(mut g, "k" + ns + " := switch task.Try(h" + ns + ") {")
        // 欄の名前の省略形（{v} / {cause}）— 付け替え {v: t} は値位置の switch で check が拒否する既知の形（F-aj 候補）
        line(mut g, "case task.Ok{v}: v")
        line(mut g, "case task.Failed{}: -5")
        line(mut g, "case task.Died{cause}: -4")
        line(mut g, "}")
        line(mut g, "k" + ns)
    } else {
        spawnLine(mut g, "g" + ns, ns)
        line(mut g, "task.Join(h" + ns + ") - task.Join(g" + ns + ")")
    }
    g.depth = g.depth - 1
    line(mut g, "})")
    g.vty[n] = TInt
    line(mut g, "if pe" + ns + " != nil {")
    line(mut g, "    println(-3)")
    line(mut g, "}")
    line(mut g, "println(" + vname(n) + ")")
}

// callShow は戻りの型 rt の関数 f<i> の呼び出しを println に渡せる int の式に（string は長さ・bool は 0 / 1・S は欄 a・int? は nil なら -1）
func callShow(i int, rt int, arg string) string {
    c := "f" + convert.FormatInt(i) + "(" + arg + ")"
    return switch rt {
    case TInt: c
    case TBool: "if " + c + " { 1 } else { 0 }"
    case TStr: "len(bytes(" + c + "))"
    case TS: "(" + c + ").a"
    default: "showOpt(" + c + ")"
    }
}

func tyName(t int) string {
    return switch t {
    case TInt: "int"
    case TBool: "bool"
    case TStr: "string"
    case TS: "S"
    default: "int?"
    }
}

func function(g mut G, i int) {
    rt := g.fty[i]
    g.nv = 0
    g.vty = mut []int{}
    g.vmut = mut []bool{}
    g.vdm = mut []bool{}
    p := declare(mut g, g.fpar[i], g.fmutp[i])
    mut sig := if g.fmutp[i] { vname(p) + " mut S" } else { vname(p) + " " + tyName(g.fpar[i]) }
    if g.fmut2[i] {
        q := declare(mut g, TInt, true)
        sig = sig + ", " + vname(q) + " mut int"
    }
    res := if g.fer[i] { " (int, error?)" } else if rt >= 0 { " " + tyName(rt) } else { "" }
    line(mut g, "func f" + convert.FormatInt(i) + "(" + sig + ")" + res + " {")
    g.depth = 1
    g.inErr = g.fer[i]
    stmts(mut g, 1 + pick(mut g, g.size), rt, 2)
    if rt >= 0 {
        line(mut g, "return " + expr(mut g, rt, 3) + (if g.fer[i] { ", nil" } else { "" }))
    }
    g.inErr = false
    g.depth = 0
    line(mut g, "}")
    line(mut g, "")
}

func main() int {
    args, aerr := os.Args()
    if aerr != nil {
        return 1
    }
    seed := if len(args) > 1 { parseInt(args[1]) } else { 1 }
    size := if len(args) > 2 { parseInt(args[2]) } else { 4 }
    usePar := len(args) > 3 && args[3] == "par"
    mut g := G{out: mut []byte{}, r: rand.New(seed), size: if size < 1 { 1 } else { size }, vty: mut []int{}, vmut: mut []bool{}, nv: 0, fty: mut []int{}, fpar: mut []int{}, fmutp: mut []bool{}, fmut2: mut []bool{}, fer: mut []bool{}, vdm: mut []bool{}, nf: 0, depth: 0, inErr: false, par: usePar, usedPar: false}
    line(mut g, "package main")
    line(mut g, "")
    line(mut g, "// progen seed=" + convert.FormatInt(seed) + " size=" + convert.FormatInt(size))
    line(mut g, "")
    line(mut g, "type S struct {")
    line(mut g, "    a int")
    line(mut g, "    s string")
    line(mut g, "}")
    line(mut g, "")
    line(mut g, "func optOf(x int, b bool) int? {")
    line(mut g, "    if b {")
    line(mut g, "        return x")
    line(mut g, "    }")
    line(mut g, "    return nil")
    line(mut g, "}")
    line(mut g, "")
    line(mut g, "type Bad error {")
    line(mut g, "    n int")
    line(mut g, "}")
    line(mut g, "")
    line(mut g, "type Worse error")
    line(mut g, "")
    line(mut g, "func mayFail(x int) (int, error?) {")
    line(mut g, "    if x < 0 {")
    line(mut g, "        return 0, Bad{n: x}")
    line(mut g, "    }")
    line(mut g, "    if x > 100 {")
    line(mut g, "        return 0, Worse{}")
    line(mut g, "    }")
    line(mut g, "    return x + 1, nil")
    line(mut g, "}")
    line(mut g, "")
    line(mut g, "func ident[T](x T) T {")
    line(mut g, "    return x")
    line(mut g, "}")
    line(mut g, "")
    line(mut g, "func pick2[T](b bool, x T, y T) T {")
    line(mut g, "    if b {")
    line(mut g, "        return x")
    line(mut g, "    }")
    line(mut g, "    return y")
    line(mut g, "}")
    line(mut g, "")
    line(mut g, "func apL[T, U](x T, f func(T) U) U {")
    line(mut g, "    return f(x)")
    line(mut g, "}")
    line(mut g, "")
    line(mut g, "func showOpt(x int?) int {")
    line(mut g, "    if x != nil {")
    line(mut g, "        return x")
    line(mut g, "    }")
    line(mut g, "    return -1")
    line(mut g, "}")
    line(mut g, "")
    nf := 1 + rand.Intn(mut g.r, g.size)
    for i <- iter.Range(0, nf) {
        m := rand.Intn(mut g.r, 3) == 0
        // error を返す関数（mut でないものの 1/3 — 戻りは (int, error?)）
        er := !m && rand.Intn(mut g.r, 3) == 0
        g.fmutp = append(g.fmutp, m)
        g.fmut2 = append(g.fmut2, m && rand.Intn(mut g.r, 2) == 0)
        g.fer = append(g.fer, er)
        g.fpar = append(g.fpar, if m { TS } else { rand.Intn(mut g.r, NTY - 1) })
        g.fty = append(g.fty, if m { 0 - 1 } else if er { TInt } else { rand.Intn(mut g.r, NTY) - 1 })
        // 呼び出しは前に宣言した関数だけ（再帰しない — 展開される mut 関数の再帰の拒否を避ける）
        g.nf = i
        function(mut g, i)
        g.nf = i + 1
    }
    g.nv = 0
    g.vty = mut []int{}
    g.vmut = mut []bool{}
    g.vdm = mut []bool{}
    line(mut g, "func main() {")
    g.depth = 1
    stmts(mut g, 2 + rand.Intn(mut g.r, g.size), 0 - 1, 2)
    // 全部の関数を呼ぶ（build は呼ばれない関数を下ろさない — 検査もしない — ので、呼ばれない関数の中の拒否は食い違いに見えるだけになる）
    line(mut g, "mut sv := S{a: 1, s: \"q\"}")
    line(mut g, "mut sw := S{a: 2, s: \"w\"}")
    for i <- iter.Range(0, g.nf) {
        if g.fmut2[i] {
            line(mut g, "f" + convert.FormatInt(i) + "(mut sv, mut sw.a)")
        } else if g.fmutp[i] {
            line(mut g, "f" + convert.FormatInt(i) + "(mut sv)")
        } else if g.fer[i] {
            line(mut g, "println(f" + convert.FormatInt(i) + "(" + leaf(mut g, g.fpar[i]) + ") catch -9)")
        } else if g.fty[i] >= 0 {
            line(mut g, "println(" + callShow(i, g.fty[i], leaf(mut g, g.fpar[i])) + ")")
        } else {
            line(mut g, "f" + convert.FormatInt(i) + "(" + leaf(mut g, g.fpar[i]) + ")")
        }
    }
    line(mut g, "println(sv.a)")
    line(mut g, "println(sw.a)")
    g.depth = 0
    line(mut g, "}")
    // par の文を出したプログラムだけ std/task を import する（package の行の後ろに差し込む — 出していなければ今までと同じバイト列）
    if g.usedPar {
        mut o := mut []byte{}
        hd := bytes("package main\n\nimport \"std/task\"\n")
        for i <- iter.Range(0, len(hd)) {
            o = append(o, hd[i])
        }
        rest := freeze(g.out)
        for i <- iter.Range(13, len(rest)) {
            o = append(o, rest[i])
        }
        g.out = o
    }
    werr := io.WriteStdout(freeze(g.out))
    return if werr != nil { 1 } else { 0 }
}

func parseInt(s string) int {
    b := bytes(s)
    mut neg := false
    mut i := 0
    if len(b) > 0 && b[0] == '-' {
        neg = true
        i = 1
    }
    mut v := 0
    while i < len(b) && b[i] >= '0' && b[i] <= '9' {
        v = v * 10 + int(b[i]) - 48
        i += 1
    }
    return if neg { 0 - v } else { v }
}
