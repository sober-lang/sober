package main

// シリアライザの双子 (a) mut builder を引き回す形（宛先構築レーンの入口の計測 — docs/bench.md「イディオムギャップ」）。
// 深さ d（2 / 4 / 6 — 入れ子の型 N0〜N5 の下から d 段）の木を作って JSON に書く。(b) = ../pieces（各節が文字列片を返して親が繋ぐ素直な形）

import "std/builder"
import "std/convert"
import "std/iter"
import "std/os"

type N0 struct {
    id int
    name string
    score float
    kids []N1
}

type N1 struct {
    id int
    name string
    score float
    kids []N2
}

type N2 struct {
    id int
    name string
    score float
    kids []N3
}

type N3 struct {
    id int
    name string
    score float
    kids []N4
}

type N4 struct {
    id int
    name string
    score float
    kids []N5
}

type N5 struct {
    id int
    name string
    score float
}

func mkN0(id int, f int) N0 {
    mut ks := mut []N1{}
    for i <- iter.Range(0, f) {
        ks = append(ks, mkN1(id * f + i, f))
    }
    return N0{id: id, name: "n${id % 1000}", score: float(id % 4000) * 0.25, kids: freeze(ks)}
}

func mkN1(id int, f int) N1 {
    mut ks := mut []N2{}
    for i <- iter.Range(0, f) {
        ks = append(ks, mkN2(id * f + i, f))
    }
    return N1{id: id, name: "n${id % 1000}", score: float(id % 4000) * 0.25, kids: freeze(ks)}
}

func mkN2(id int, f int) N2 {
    mut ks := mut []N3{}
    for i <- iter.Range(0, f) {
        ks = append(ks, mkN3(id * f + i, f))
    }
    return N2{id: id, name: "n${id % 1000}", score: float(id % 4000) * 0.25, kids: freeze(ks)}
}

func mkN3(id int, f int) N3 {
    mut ks := mut []N4{}
    for i <- iter.Range(0, f) {
        ks = append(ks, mkN4(id * f + i, f))
    }
    return N3{id: id, name: "n${id % 1000}", score: float(id % 4000) * 0.25, kids: freeze(ks)}
}

func mkN4(id int, f int) N4 {
    mut ks := mut []N5{}
    for i <- iter.Range(0, f) {
        ks = append(ks, mkN5(id * f + i, f))
    }
    return N4{id: id, name: "n${id % 1000}", score: float(id % 4000) * 0.25, kids: freeze(ks)}
}

func mkN5(id int, f int) N5 {
    return N5{id: id, name: "n${id % 1000}", score: float(id % 4000) * 0.25}
}

func wN0(o mut builder.Builder[byte], n N0) {
    put(mut o, "{\"id\":")
    put(mut o, convert.FormatInt(n.id))
    put(mut o, ",\"name\":\"")
    put(mut o, n.name)
    put(mut o, "\",\"score\":")
    put(mut o, convert.FormatFloat(n.score))
    put(mut o, ",\"kids\":[")
    for i <- iter.Range(0, len(n.kids)) {
        if i > 0 {
            builder.Push(mut o, ',')
        }
        wN1(mut o, n.kids[i])
    }
    builder.Push(mut o, ']')
    builder.Push(mut o, '}')
}

func wN1(o mut builder.Builder[byte], n N1) {
    put(mut o, "{\"id\":")
    put(mut o, convert.FormatInt(n.id))
    put(mut o, ",\"name\":\"")
    put(mut o, n.name)
    put(mut o, "\",\"score\":")
    put(mut o, convert.FormatFloat(n.score))
    put(mut o, ",\"kids\":[")
    for i <- iter.Range(0, len(n.kids)) {
        if i > 0 {
            builder.Push(mut o, ',')
        }
        wN2(mut o, n.kids[i])
    }
    builder.Push(mut o, ']')
    builder.Push(mut o, '}')
}

func wN2(o mut builder.Builder[byte], n N2) {
    put(mut o, "{\"id\":")
    put(mut o, convert.FormatInt(n.id))
    put(mut o, ",\"name\":\"")
    put(mut o, n.name)
    put(mut o, "\",\"score\":")
    put(mut o, convert.FormatFloat(n.score))
    put(mut o, ",\"kids\":[")
    for i <- iter.Range(0, len(n.kids)) {
        if i > 0 {
            builder.Push(mut o, ',')
        }
        wN3(mut o, n.kids[i])
    }
    builder.Push(mut o, ']')
    builder.Push(mut o, '}')
}

func wN3(o mut builder.Builder[byte], n N3) {
    put(mut o, "{\"id\":")
    put(mut o, convert.FormatInt(n.id))
    put(mut o, ",\"name\":\"")
    put(mut o, n.name)
    put(mut o, "\",\"score\":")
    put(mut o, convert.FormatFloat(n.score))
    put(mut o, ",\"kids\":[")
    for i <- iter.Range(0, len(n.kids)) {
        if i > 0 {
            builder.Push(mut o, ',')
        }
        wN4(mut o, n.kids[i])
    }
    builder.Push(mut o, ']')
    builder.Push(mut o, '}')
}

func wN4(o mut builder.Builder[byte], n N4) {
    put(mut o, "{\"id\":")
    put(mut o, convert.FormatInt(n.id))
    put(mut o, ",\"name\":\"")
    put(mut o, n.name)
    put(mut o, "\",\"score\":")
    put(mut o, convert.FormatFloat(n.score))
    put(mut o, ",\"kids\":[")
    for i <- iter.Range(0, len(n.kids)) {
        if i > 0 {
            builder.Push(mut o, ',')
        }
        wN5(mut o, n.kids[i])
    }
    builder.Push(mut o, ']')
    builder.Push(mut o, '}')
}

func wN5(o mut builder.Builder[byte], n N5) {
    put(mut o, "{\"id\":")
    put(mut o, convert.FormatInt(n.id))
    put(mut o, ",\"name\":\"")
    put(mut o, n.name)
    put(mut o, "\",\"score\":")
    put(mut o, convert.FormatFloat(n.score))
    builder.Push(mut o, '}')
}

func put(o mut builder.Builder[byte], s string) {
    builder.PushString(mut o, s)
}

func topN0(f int) string {
    mut o := builder.Builder[byte]{}
    builder.Push(mut o, '[')
    for i <- iter.Range(0, f) {
        if i > 0 {
            builder.Push(mut o, ',')
        }
        wN0(mut o, mkN0(i, f))
    }
    builder.Push(mut o, ']')
    s, e := string(builder.Build(mut o))
    return s
}

func topN2(f int) string {
    mut o := builder.Builder[byte]{}
    builder.Push(mut o, '[')
    for i <- iter.Range(0, f) {
        if i > 0 {
            builder.Push(mut o, ',')
        }
        wN2(mut o, mkN2(i, f))
    }
    builder.Push(mut o, ']')
    s, e := string(builder.Build(mut o))
    return s
}

func topN4(f int) string {
    mut o := builder.Builder[byte]{}
    builder.Push(mut o, '[')
    for i <- iter.Range(0, f) {
        if i > 0 {
            builder.Push(mut o, ',')
        }
        wN4(mut o, mkN4(i, f))
    }
    builder.Push(mut o, ']')
    s, e := string(builder.Build(mut o))
    return s
}

// fanout は葉の数がほぼ同じ（30 万前後）になるように深さごとに選ぶ
func fanout(d int) int {
    return if d == 2 { 550 } else if d == 4 { 24 } else { 8 }
}

// fnv は出力の照合用（FNV-1a）
func fnv(s string) int {
    p := bytes(s)
    mut h := -3750763034065230579
    for i <- iter.Range(0, len(p)) {
        h = (h ^ int(p[i])) * 1099511628211
    }
    return h
}

func main() {
    args, aerr := os.Args()
    if aerr != nil || len(args) < 2 {
        return
    }
    d := if args[1] == "2" { 2 } else if args[1] == "4" { 4 } else { 6 }
    f := fanout(d)
    s := switch d {
    case 2: topN4(f)
    case 4: topN2(f)
    default: topN0(f)
    }
    println(len(bytes(s)), fnv(s))
}
