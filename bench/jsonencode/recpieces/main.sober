package main

// シリアライザの双子 (d) 再帰の型 1 本の素直な形: (b)〔../pieces〕と同じ書き方で、入れ子の型 N0〜N5 を再帰の struct N 1 本に（葉は深さ 0 — kids を書かない）。
// (a) と同じバイト列（長さと FNV で照合）

import "std/builder"
import "std/convert"
import "std/iter"
import "std/os"
import "std/strings"

type N struct {
    id int
    name string
    score float
    kids []N
}

// mk は深さ d の部分木（d = 0 は葉 — 子の列は空・印字で kids を書かない）
func mk(id int, f int, d int) N {
    mut ks := mut []N{}
    if d > 0 {
        for i <- iter.Range(0, f) {
            ks = append(ks, mk(id * f + i, f, d - 1))
        }
    }
    return N{id: id, name: "n${id % 1000}", score: float(id % 4000) * 0.25, kids: freeze(ks)}
}

func sN(n N, d int) string {
    if d == 0 {
        return "{\"id\":${n.id},\"name\":\"${n.name}\",\"score\":${convert.FormatFloat(n.score)}}"
    }
    mut ps := mut []string{}
    for i <- iter.Range(0, len(n.kids)) {
        ps = append(ps, sN(n.kids[i], d - 1))
    }
    return "{\"id\":${n.id},\"name\":\"${n.name}\",\"score\":${convert.FormatFloat(n.score)},\"kids\":[${join(freeze(ps))}]}"
}

// join は片を ',' で繋ぐ（std に strings.Join が無いので同じ形を書く — 片の長さの和を 1 回だけ写す。
// `s = s + "," + p` の素直な繋ぎは先端一致の concat の in-place 成長が無いので 2 乗の写し — 深さ 2〔片 550 個〕で region 4 GB を溢れた）
func join(ps []string) string {
    mut o := builder.Builder[byte]{}
    for i <- iter.Range(0, len(ps)) {
        if i > 0 {
            builder.Push(mut o, ',')
        }
        builder.PushString(mut o, ps[i])
    }
    s, e := string(builder.Build(mut o))
    return s
}

// 根の列（深さ d の木を f 本）
func top(f int, d int) string {
    mut ps := mut []string{}
    for i <- iter.Range(0, f) {
        ps = append(ps, sN(mk(i, f, d), d))
    }
    return "[${join(freeze(ps))}]"
}

// fanout は葉の数がほぼ同じ（30 万前後）になるように深さごとに選ぶ
func fanout(d int) int {
    return if d == 2 { 550 } else if d == 4 { 24 } else { 8 }
}

// fnv は出力の照合用（FNV-1a）
func fnv(s string) int {
    p := bytes(s)
    mut h := -3750763034065230579
    for i <- iter.Range(0, len(p)) {
        h = (h ^ int(p[i])) * 1099511628211
    }
    return h
}

func main() {
    args, aerr := os.Args()
    if aerr != nil || len(args) < 2 {
        return
    }
    d := if args[1] == "2" { 2 } else if args[1] == "4" { 4 } else { 6 }
    f := fanout(d)
    s := top(f, d - 1)
    println(len(bytes(s)), fnv(s))
}
