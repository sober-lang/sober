package main

// シリアライザの対 (c) 再帰の型1本の形: (a)〔../builder〕と同じ書き方で、入れ子の型N0〜N5を再帰の struct N 1本に（葉は深さ0 — kidsを書かない）。
// (a) と同じバイト列（長さとFNVで照合）。(a) との差 = 再帰形の構築の費用（返り境界ごとに部分木をコピーする — 深さ比例・宛先構築レーンで回収予定）

import "std/builder"
import "std/convert"
import "std/iter"
import "std/os"

type N struct {
    id int
    name string
    score float
    kids []N
}

// mk は深さ d の部分木（d = 0 は葉 — 子の列は空・印字で kids を書かない）
func mk(id int, f int, d int) N {
    mut ks := mut []N{}
    if d > 0 {
        for i <- iter.Range(0, f) {
            ks = append(ks, mk(id * f + i, f, d - 1))
        }
    }
    return N{id: id, name: "n${id % 1000}", score: float(id % 4000) * 0.25, kids: freeze(ks)}
}

func w(o mut builder.Builder[byte], n N, d int) {
    put(mut o, "{\"id\":")
    put(mut o, convert.FormatInt(n.id))
    put(mut o, ",\"name\":\"")
    put(mut o, n.name)
    put(mut o, "\",\"score\":")
    put(mut o, convert.FormatFloat(n.score))
    if d > 0 {
        put(mut o, ",\"kids\":[")
        for i <- iter.Range(0, len(n.kids)) {
            if i > 0 {
                builder.Push(mut o, ',')
            }
            w(mut o, n.kids[i], d - 1)
        }
        builder.Push(mut o, ']')
    }
    builder.Push(mut o, '}')
}

func put(o mut builder.Builder[byte], s string) {
    builder.PushString(mut o, s)
}

// 根の列（深さ d の木を f 本）
func top(f int, d int) string {
    mut o := builder.Builder[byte]{}
    builder.Push(mut o, '[')
    for i <- iter.Range(0, f) {
        if i > 0 {
            builder.Push(mut o, ',')
        }
        w(mut o, mk(i, f, d), d)
    }
    builder.Push(mut o, ']')
    s, e := string(builder.Build(mut o))
    return s
}

// fanout は葉の数がほぼ同じ（30 万前後）になるように深さごとに選ぶ
func fanout(d int) int {
    return if d == 2 { 550 } else if d == 4 { 24 } else { 8 }
}

// fnv は出力の照合用（FNV-1a）
func fnv(s string) int {
    p := bytes(s)
    mut h := -3750763034065230579
    for i <- iter.Range(0, len(p)) {
        h = (h ^ int(p[i])) * 1099511628211
    }
    return h
}

func main() {
    args, aerr := os.Args()
    if aerr != nil || len(args) < 2 {
        return
    }
    d := if args[1] == "2" { 2 } else if args[1] == "4" { 4 } else { 6 }
    f := fanout(d)
    s := top(f, d - 1)
    println(len(bytes(s)), fnv(s))
}
