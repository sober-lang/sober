package main

// logagg（Web コア bench ③）: アクセスログ（logfmt — `key=value` を空白で区切る・引用符つきの値あり — bench/logagg/gen）を N 行読み、
// 行ごとに語へ割り（引用符の中の空白は割らない・引用符の中の \ は次の 1 バイトを守る）→ 鍵と値 → 欄を名前で引く → ts（RFC 3339 の部分集合 —
// 小数秒 0〜9 桁・Z か ±HH:MM・月ごとの日数とうるう年まで検査）を手書きで epoch 秒に → 1 分の固定窓 × svc の配列に集計
// （件数・4xx・5xx・所要時間の合計 / 最大・log2 のヒストグラム）・5 分の滑り窓で 5xx が 5% を超えた分を数える・ユーザーは map[string]int。
// 不正な行（閉じない引用符・= の無い語・ts 欠落・ts の値の不正・status が数でない）は種類ごとに数えて集計から外す。
// 出力 = 件数・svc ごとの集計・ユーザーの異なり数 / 最大 / 和で畳んだ FNV・全窓の FNV-1a 64（Go / Rust の双子とバイト一致）

import "std/convert"
import "std/io"
import "std/iter"
import "std/os"
import "std/utf8"

func svcs() []string {
    return []string{"api", "auth", "orders", "payments", "search", "catalog", "users", "static"}
}

func levels() []string {
    return []string{"debug", "info", "warn", "error"}
}

func fnv(h int, s string) int {
    mut x := h
    for c <- bytes(s) {
        x = (x ^ int(c)) * 1099511628211
    }
    return x
}

// num は b[a:a+n] の 10 進（数でない byte があれば -1）
func num(b []byte, a int, n int) int {
    mut v := 0
    for i <- iter.Range(a, a + n) {
        c := b[i]
        if c < '0' || c > '9' {
            return 0 - 1
        }
        v = v * 10 + int(c) - '0'
    }
    return v
}

func atoi(s string) int {
    b := bytes(s)
    if len(b) == 0 {
        return 0 - 1
    }
    return num(b, 0, len(b))
}

func leap(y int) bool {
    return y % 4 == 0 && (y % 100 != 0 || y % 400 == 0)
}

func dim(y int, m int) int {
    if m == 2 {
        return if leap(y) { 29 } else { 28 }
    }
    if m == 4 || m == 6 || m == 9 || m == 11 {
        return 30
    }
    return 31
}

// days は 1970-01-01 からの日数（Howard Hinnant の days_from_civil）
func days(y0 int, m int, d int) int {
    y := if m <= 2 { y0 - 1 } else { y0 }
    yy := if y < 0 { y - 399 } else { y }
    era := yy / 400
    yoe := y - era * 400
    doy := (153 * ((m + 9) % 12) + 2) / 5 + d - 1
    doe := yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

// parseTs は `YYYY-MM-DDTHH:MM:SS[.f{1,9}](Z|±HH:MM)` を (ok, epoch 秒, ナノ秒) に
func parseTs(ts string) (bool, int, int) {
    s := bytes(ts)
    n := len(s)
    if n < 20 || s[4] != '-' || s[7] != '-' || s[10] != 'T' || s[13] != ':' || s[16] != ':' {
        return false, 0, 0
    }
    y := num(s, 0, 4)
    mo := num(s, 5, 2)
    d := num(s, 8, 2)
    hh := num(s, 11, 2)
    mi := num(s, 14, 2)
    ss := num(s, 17, 2)
    if y < 0 || mo < 1 || mo > 12 || d < 1 || d > dim(y, mo) || hh < 0 || hh > 23 || mi < 0 || mi > 59 || ss < 0 || ss > 59 {
        return false, 0, 0
    }
    mut i := 19
    mut ns := 0
    if s[i] == '.' {
        i += 1
        mut k := 0
        while i < n && s[i] >= '0' && s[i] <= '9' && k < 9 {
            ns = ns * 10 + int(s[i]) - '0'
            i += 1
            k += 1
        }
        if k == 0 {
            return false, 0, 0
        }
        while k < 9 {
            ns = ns * 10
            k += 1
        }
    }
    mut off := 0
    if i < n && s[i] == 'Z' {
        i += 1
    } else if i + 6 <= n && (s[i] == '+' || s[i] == '-') && s[i + 3] == ':' {
        oh := num(s, i + 1, 2)
        om := num(s, i + 4, 2)
        if oh < 0 || oh > 23 || om < 0 || om > 59 {
            return false, 0, 0
        }
        off = oh * 3600 + om * 60
        if s[i] == '-' {
            off = 0 - off
        }
        i += 6
    } else {
        return false, 0, 0
    }
    if i != n {
        return false, 0, 0
    }
    return true, days(y, mo, d) * 86400 + hh * 3600 + mi * 60 + ss - off, ns
}

// unq は値の引用符を外したときのバイト数（\ は次の 1 バイトを守る）
func unq(x string) int {
    v := bytes(x)
    if len(v) < 2 || v[0] != '"' {
        return len(v)
    }
    mut k := 0
    mut i := 1
    while i < len(v) - 1 {
        if v[i] == '\\' {
            i += 1
        }
        k += 1
        i += 1
    }
    return k
}

// xs の末尾に 0 を n 個積む（mut の値は呼び手のゼロ値リテラルで作る — mut の仮引数を持たない関数は mut を返せない・language.md 26 節）
func zeros(xs mut []int, n int) {
    for _ <- iter.Range(0, n) {
        xs = append(xs, 0)
    }
}

func main() int {
    args := os.Args() catch return 2
    if len(args) != 2 {
        return 2
    }
    // W = 分の窓の数（起点の 1 分前から 24 時間 + 1 分）・H = 遅延のヒストグラムの箱（log2）
    W := 1442
    H := 24
    sv := svcs()
    lvs := levels()
    base := days(2026, 10, 10) * 86400
    mut cnt := mut []int{}
    zeros(mut cnt, W * 8)
    mut c4 := mut []int{}
    zeros(mut c4, W * 8)
    mut c5 := mut []int{}
    zeros(mut c5, W * 8)
    mut dsum := mut []int{}
    zeros(mut dsum, W * 8)
    mut dmax := mut []int{}
    zeros(mut dmax, W * 8)
    mut hist := mut []int{}
    zeros(mut hist, 8 * H)
    mut lv := mut []int{}
    zeros(mut lv, 4)
    mut users := mut map[string]int{}
    mut lines := 0
    mut bQuote := 0
    mut bNoeq := 0
    mut bNots := 0
    mut bTs := 0
    mut bStatus := 0
    mut bSvc := 0
    mut bRange := 0
    mut msgBytes := 0
    mut pathBytes := 0
    mut nsSum := 0
    b := io.ReadFile(args[1]) catch return 1
    v := utf8.Check(b) catch return 1
    mut i := 0
    while i < len(b) {
        mut e := i
        while b[e] != '\n' {
            e += 1
        }
        mut pos := i
        i = e + 1
        lines += 1
        mut ts := ""
        mut level := ""
        mut svc := ""
        mut status := ""
        mut dur := ""
        mut user := ""
        mut msg := ""
        mut path := ""
        mut hasTs := false
        mut hasUser := false
        // bad: 1 = 閉じない引用符・2 = = の無い語
        mut bad := 0
        while pos < e && bad == 0 {
            mut j := pos
            mut inq := false
            mut eq := 0 - 1
            while j < e {
                c := b[j]
                if inq {
                    if c == '\\' {
                        j += 2
                        continue
                    }
                    if c == '"' {
                        inq = false
                    }
                } else {
                    if c == ' ' {
                        break
                    }
                    if c == '"' {
                        inq = true
                    } else if c == '=' && eq < 0 {
                        eq = j
                    }
                }
                j += 1
            }
            if inq {
                bad = 1
            } else if eq < 0 {
                bad = 2
            } else {
                k := utf8.Str(v, pos, eq) catch return 1
                x := utf8.Str(v, eq + 1, j) catch return 1
                if k == "ts" {
                    ts = x
                    hasTs = true
                } else if k == "level" {
                    level = x
                } else if k == "svc" {
                    svc = x
                } else if k == "status" {
                    status = x
                } else if k == "dur_us" {
                    dur = x
                } else if k == "user" {
                    user = x
                    hasUser = true
                } else if k == "msg" {
                    msg = x
                } else if k == "path" {
                    path = x
                }
            }
            pos = j + 1
        }
        if bad == 1 {
            bQuote += 1
            continue
        }
        if bad == 2 {
            bNoeq += 1
            continue
        }
        if !hasTs {
            bNots += 1
            continue
        }
        ok, sec, ns := parseTs(ts)
        if !ok {
            bTs += 1
            continue
        }
        st := atoi(status)
        if st < 0 {
            bStatus += 1
            continue
        }
        mut si := 0 - 1
        for k <- iter.Range(0, len(sv)) {
            if sv[k] == svc {
                si = k
            }
        }
        if si < 0 {
            bSvc += 1
            continue
        }
        rel := sec - base + 60
        if rel < 0 || rel >= W * 60 {
            bRange += 1
            continue
        }
        c := rel / 60 * 8 + si
        cnt[c] = cnt[c] + 1
        if st >= 400 && st < 500 {
            c4[c] = c4[c] + 1
        }
        if st >= 500 && st < 600 {
            c5[c] = c5[c] + 1
        }
        d := atoi(dur)
        dsum[c] = dsum[c] + d
        if d > dmax[c] {
            dmax[c] = d
        }
        mut bk := 0
        while bk < H - 1 && d >> bk > 0 {
            bk += 1
        }
        hist[si * H + bk] = hist[si * H + bk] + 1
        for k <- iter.Range(0, len(lvs)) {
            if lvs[k] == level {
                lv[k] = lv[k] + 1
            }
        }
        if hasUser {
            u := users[user]
            users[user] = if u != nil { u + 1 } else { 1 }
        }
        msgBytes += unq(msg)
        pathBytes += len(bytes(path))
        nsSum += ns
    }
    println("lines ${lines}")
    println("bad quote ${bQuote} noeq ${bNoeq} nots ${bNots} ts ${bTs} status ${bStatus} svc ${bSvc} range ${bRange}")
    for k <- iter.Range(0, len(lvs)) {
        println("level ${lvs[k]} ${lv[k]}")
    }
    for si <- iter.Range(0, len(sv)) {
        mut n := 0
        mut n4 := 0
        mut n5 := 0
        mut ds := 0
        mut dm := 0
        for m <- iter.Range(0, W) {
            c := m * 8 + si
            n += cnt[c]
            n4 += c4[c]
            n5 += c5[c]
            ds += dsum[c]
            if dmax[c] > dm {
                dm = dmax[c]
            }
        }
        // p99 の箱: 累積が 99% に届く最初の箱
        mut p99 := 0
        mut cum := 0
        mut bk := 0
        while bk < H {
            cum += hist[si * H + bk]
            if cum * 100 >= n * 99 {
                p99 = bk
                break
            }
            bk += 1
        }
        // 滑り窓: 直近 5 分の 5xx が 5% を超えた分の数
        mut alarms := 0
        for m <- iter.Range(4, W) {
            mut wn := 0
            mut w5 := 0
            for k <- iter.Range(m - 4, m + 1) {
                wn += cnt[k * 8 + si]
                w5 += c5[k * 8 + si]
            }
            if wn > 0 && w5 * 100 > wn * 5 {
                alarms += 1
            }
        }
        println("svc ${sv[si]} ${n} 4xx ${n4} 5xx ${n5} dur_sum ${ds} dur_max ${dm} p99_bucket ${p99} alarms ${alarms}")
    }
    um := freeze(users)
    mut umax := 0
    mut uh := 0
    for u <- keys(um) {
        c := um[u]
        if c != nil {
            if c > umax {
                umax = c
            }
            uh += fnv(fnv(fnv(0 - 3750763034362895579, u), "="), convert.FormatInt(c))
        }
    }
    println("users ${len(keys(um))} max ${umax} hash ${uh}")
    println("msg_bytes ${msgBytes}")
    println("path_bytes ${pathBytes}")
    println("ns_sum ${nsSum}")
    mut h := 0 - 3750763034362895579
    for m <- iter.Range(0, W) {
        for si <- iter.Range(0, 8) {
            c := m * 8 + si
            if cnt[c] > 0 {
                h = fnv(h, "${m} ${si} ${cnt[c]} ${c5[c]} ${dsum[c]} ${dmax[c]}\n")
            }
        }
    }
    println("hash ${h}")
    return 0
}
