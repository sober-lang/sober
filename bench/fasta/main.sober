package main

// fasta（benchmarks game — docs/bench.md）: ALU の繰り返しと、線形合同法の乱数で 2 つの表から記号を選ぶ列を 1 行 60 文字で書く。
// 素直な形（Go の双子 bench/fasta/go と同じアルゴリズム）。書き出しは LINES 行ずつ — 1 回の書き出しを 1 つの関数呼び出しにして、
// 作業の列はその関数の region ごと捨てる（全体を溜めない）。
// 乱数の選択: 仕様は「r = last / IM（浮動小数）が累積確率 p_i 以下の最初の i」。Sober にはまだ float が無い（ロードマップ 5.8）ので、
// 同じ選択を整数の閾値 T_i = 「s / IM ≤ p_i となる最大の s」で行う（Go の float の累積を前計算した値 — 出力は Go と一致・公式の n=1000 とも一致）

import "std/io"
import "std/iter"
import "std/os"

const IM = 139968
const IA = 3877
const IC = 29573
const WIDTH = 60
const LINES = 1024

func atoi(s string) int {
    b := bytes(s)
    mut n := 0
    for i <- iter.Range(0, len(b)) {
        n = n * 10 + int(b[i]) - '0'
    }
    return n
}

func put(s string) {
    _ = io.WriteStdout(bytes(s))
}

// repeatChunk は alu の pos0 からの繰り返しを count 文字（WIDTH 文字ごとに改行）書き、次の位置を返す
func repeatChunk(alu []byte, pos0 int, count int) int {
    mut out := mut []byte{}
    mut pos := pos0
    mut left := count
    while left > 0 {
        line := if left < WIDTH { left } else { WIDTH }
        for j <- iter.Range(0, line) {
            out = append(out, alu[pos])
            pos += 1
            if pos == len(alu) {
                pos = 0
            }
        }
        out = append(out, '\n')
        left -= line
    }
    _ = io.WriteStdout(freeze(out))
    return pos
}

// randomChunk は乱数で選んだ記号を count 文字書き、次の乱数の状態を返す
func randomChunk(syms []byte, thr []int, seed0 int, count int) int {
    mut out := mut []byte{}
    mut seed := seed0
    mut left := count
    while left > 0 {
        line := if left < WIDTH { left } else { WIDTH }
        for j <- iter.Range(0, line) {
            seed = (seed * IA + IC) % IM
            mut i := 0
            while thr[i] < seed {
                i += 1
            }
            out = append(out, syms[i])
        }
        out = append(out, '\n')
        left -= line
    }
    _ = io.WriteStdout(freeze(out))
    return seed
}

func main() int {
    args := os.Args() catch return 2
    n := if len(args) > 1 { atoi(args[1]) } else { 1000 }
    alu := bytes("GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGG" +
        "GAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGA" +
        "CCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAAT" +
        "ACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCA" +
        "GCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGG" +
        "AGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCC" +
        "AGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA")
    iub := bytes("acgtBDHKMNRSVWY")
    iubT := []int{37791, 54587, 71383, 109175, 111974, 114773, 117573, 120372, 123171, 125971, 128770, 131569, 134369, 137168, 139967}
    homo := bytes("acgt")
    homoT := []int{42403, 70116, 97766, 139967}
    chunk := LINES * WIDTH

    put(">ONE Homo sapiens alu\n")
    mut pos := 0
    mut left := 2 * n
    while left > 0 {
        c := if left < chunk { left } else { chunk }
        pos = repeatChunk(alu, pos, c)
        left -= c
    }
    put(">TWO IUB ambiguity codes\n")
    mut seed := 42
    left = 3 * n
    while left > 0 {
        c := if left < chunk { left } else { chunk }
        seed = randomChunk(iub, iubT, seed, c)
        left -= c
    }
    put(">THREE Homo sapiens frequency\n")
    left = 5 * n
    while left > 0 {
        c := if left < chunk { left } else { chunk }
        seed = randomChunk(homo, homoT, seed, c)
        left -= c
    }
    return 0
}
