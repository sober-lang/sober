package main

import "std/iter"
import "std/os"

func atoi(s string) int {
    b := bytes(s)
    mut n := 0
    for i <- iter.Range(0, len(b)) {
        n = n * 10 + int(b[i]) - '0'
    }
    return n
}

// 1 本ずつ順に伸ばす（データ構造便の双子 (a) — 交互を避ける回避術の形。データ構造便の前は運用の規律でこちらを強いていた）
func main() int {
    args := os.Args() catch return 2
    n := atoi(args[1])
    mut xs := mut []int{}
    mut ys := mut []int{}
    mut bs := mut []byte{}
    mut cs := mut []byte{}
    for i <- iter.Range(0, n) {
        xs = append(xs, i)
    }
    for i <- iter.Range(0, n) {
        ys = append(ys, i * 2)
    }
    for i <- iter.Range(0, n) {
        bs = append(bs, byte(i & 127))
    }
    for i <- iter.Range(0, n) {
        cs = append(cs, byte(i & 63))
    }
    println(len(xs) + len(ys) + len(bs) + len(cs) + xs[n - 1] + ys[n / 2] + int(bs[n - 1]) + int(cs[1]))
    return 0
}
