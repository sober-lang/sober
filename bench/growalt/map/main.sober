package main

import "std/iter"
import "std/os"

func atoi(s string) int {
    b := bytes(s)
    mut n := 0
    for i <- iter.Range(0, len(b)) {
        n = n * 10 + int(b[i]) - '0'
    }
    return n
}

// 交互に 2 本の map へ挿入する（素直な形 — データ構造便の続編の双子 (b)。先端の奪い合いで 2 乗〔n=2 万で 102〕だった形・rt.map_grow で償却 O(1)）
func main() int {
    args := os.Args() catch return 2
    n := atoi(args[1])
    mut m1 := mut map[int]int{}
    mut m2 := mut map[int]int{}
    for i <- iter.Range(0, n) {
        m1[i] = i
        m2[i * 3] = i
    }
    mut s := 0
    for i <- iter.Range(0, n) {
        a := m1[i]
        b := m2[i * 3]
        if a != nil && b != nil {
            s += a + b
        }
    }
    println(s)
    return 0
}
