package main

import "std/iter"
import "std/os"

func atoi(s string) int {
    b := bytes(s)
    mut n := 0
    for i <- iter.Range(0, len(b)) {
        n = n * 10 + int(b[i]) - '0'
    }
    return n
}

// 文字列を連結で積む（息継ぎ ① の双子 (b) — 素直な形 `s = s + x`。先端一致の concat の前は O(n²) の写し）
func main() int {
    args := os.Args() catch return 2
    n := atoi(args[1])
    mut s := ""
    for i <- iter.Range(0, n) {
        s = s + "ab"
        if i % 7 == 0 {
            s = s + "c"
        }
    }
    b := bytes(s)
    mut h := 0
    for i <- iter.Range(0, len(b)) {
        h = (h * 31 + int(b[i])) & 1048575
    }
    println(len(b))
    println(h)
    return 0
}
