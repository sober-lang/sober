package main

// 外部ソート（実証便 その 2 — docs/bench.md）: 1 行 1 キーのテキストを、窓 W バイトより大きくても、バイト列の辞書順（`LC_ALL=C sort` と同じ）に並べて標準出力へ書く。
// 引数 = 入力のパス・一時ファイルの dir（在ること）・窓 W の MiB（省略 = 64）。行は改行で終わり、64 KiB より短いこと。
// 素直な形（Go / Rust の双子 bench/extsort/go・rust と同じアルゴリズム）:
// 1. run を作る: 入力を io.Chunks で読んで窓 W に達するまで 1 本のバイト列に積み（W に達した切片で break — 先読みの分は位置が戻る）、
//    完全な行の開始位置の列を std/sort の OrderUnstable（pdqsort — 添字を比較の閉包で並べる。等しい行の順は出力に現れないので安定は要らない）で並べ、並べた行を io.WriteFile で `<dir>/run-<i>` へ全量書く。1 本の run は 1 回の関数の呼び出しで、
//    窓の分のメモリは呼び出しの出口で region ごと消える（次の run へ持ち越すのは最後の改行より後ろの欠けた行だけ）
// 2. k 本の run をマージする: run ごとに 2 × 64 KiB の枠を 1 本の mut のバイト列（k 本分を最初に 1 回だけ作る）の中に持ち、
//    枠の中に完全な行が無くなったら、残りを枠の頭へ寄せて run のファイルの「次に読む位置」から io.ChunksAt で 1 切片だけ写し足す
//    （開いた io.File は列に持てない — run ごとに持つのは位置の int だけ）。先頭の行が最小の run を線形の走査で選び、io.Writer で標準出力へ
// メモリ = 窓の分（行のバイト列・開始位置の列・並べ替えの作業域）+ k × 128 KiB の枠。入力の大きさには比例しない（k = N / W の分を除く）

import "std/io"
import "std/iter"
import "std/os"
import "std/sort"

const slot = 65536

func main() int {
    args := os.Args() catch return 2
    if len(args) != 3 && len(args) != 4 {
        return 2
    }
    mut mib := 64
    if len(args) == 4 {
        mib = atoi(bytes(args[3]))
    }
    k := makeRuns(args[1], args[2], mib * 1048576) catch return 1
    mut w := io.Writer{}
    if mergeRuns(args[2], k, mut w) != nil {
        return 1
    }
    return if io.Flush(mut w) != nil { 1 } else { 0 }
}

// makeRuns は path を窓 w バイトずつの run に切って dir へ書き、run の本数を返す
func makeRuns(path string, dir string, w int) (int, error?) {
    f := io.Open(path)?
    defer io.Close(f)
    mut tail := []byte{}
    mut k := 0
    mut eof := false
    while !eof {
        rest, done, wrote := oneRun(f, "${dir}/run-${k}", w, tail)?
        tail = rest
        eof = done
        if wrote {
            k += 1
        }
    }
    if len(tail) > 0 {
        // 最後の行に改行が無い入力は形の外
        return 0, io.Other{errno: 22}
    }
    return k, nil
}

// oneRun は f の今の位置から窓 w バイト（head の欠けた行を頭に）を読み、完全な行を並べて out へ書く。最後の改行より後ろの欠けた行・EOF に達したか・
// 書いたか（行が無ければ書かない）を返す
func oneRun(f io.File, out string, w int, head []byte) ([]byte, bool, bool, error?) {
    mut buf := mut []byte{}
    for x <- head {
        buf = append(buf, x)
    }
    mut eof := true
    for c <- io.Chunks(f)? {
        for x <- io.Raw(c) {
            buf = append(buf, x)
        }
        if len(buf) >= w {
            eof = false
            break
        }
    }
    // 完全な行の終わり e（最後の改行の次）と、行の開始位置の列（番兵 = e — 行 i は [st[i], st[i + 1] − 1)）
    mut e := len(buf)
    while e > 0 && buf[e - 1] != '\n' {
        e -= 1
    }
    mut st := mut []int{}
    mut s := 0
    for i <- iter.Range(0, e) {
        if buf[i] == '\n' {
            st = append(st, s)
            s = i + 1
        }
    }
    n := len(st)
    st = append(st, e)
    mut rest := mut []byte{}
    for i <- iter.Range(e, len(buf)) {
        rest = append(rest, buf[i])
    }
    if n == 0 {
        return freeze(rest), eof, false, nil
    }
    order := lineOrder(freeze(buf), freeze(st), n)
    mut o := mut []byte{}
    for i <- order {
        for j <- iter.Range(st[i], st[i + 1]) {
            o = append(o, buf[j])
        }
    }
    io.WriteFile(out, freeze(o))?
    return freeze(rest), eof, true, nil
}

// lineOrder は行 0..n−1 を行の辞書順に並べた番号の列（std/sort の OrderUnstable — 比べ方は less の閉包。行の全体で比べるので、等しい行は
// バイト列ごと同じで、その順は出力に現れない — 安定は要らない）
func lineOrder(buf []byte, st []int, n int) []int {
    return sort.OrderUnstable(n, (x, y) => less(buf, st, x, y))
}

// less は行 x が行 y より前か（バイト列の辞書順 — 短い方が接頭辞なら前）
func less(buf []byte, st []int, x int, y int) bool {
    mut i := st[x]
    mut j := st[y]
    ex := st[x + 1] - 1
    ey := st[y + 1] - 1
    while i < ex && j < ey {
        if buf[i] != buf[j] {
            return buf[i] < buf[j]
        }
        i += 1
        j += 1
    }
    return i == ex && j < ey
}

// mergeRuns は dir の run-0..k−1 をマージして w へ書く。run r の枠は ar[r × 2 × slot ..]・状態は ss[r × 4 ..] = [頭の行の始まり, 枠の中の終わり,
// ファイルの次に読む位置, 頭の行の改行の位置〔−1 = 行が無い — run の終わり〕]（位置は全部 ar の中の絶対の添字）
func mergeRuns(dir string, k int, w mut io.Writer) error? {
    mut ar := mut []byte{}
    for i <- iter.Range(0, k * 2 * slot) {
        ar = append(ar, 0)
    }
    mut ss := mut []int{}
    for r <- iter.Range(0, k) {
        ss = append(ss, r * 2 * slot)
        ss = append(ss, r * 2 * slot)
        ss = append(ss, 0)
        ss = append(ss, -1)
    }
    for r <- iter.Range(0, k) {
        fill(dir, r, mut ar, mut ss)?
    }
    while true {
        // 頭の行が最小の run
        mut m := -1
        for r <- iter.Range(0, k) {
            if ss[r * 4 + 3] >= 0 && (m < 0 || lineLess(mut ar, ss[r * 4], ss[r * 4 + 3], ss[m * 4], ss[m * 4 + 3])) {
                m = r
            }
        }
        if m < 0 {
            return nil
        }
        for j <- iter.Range(ss[m * 4], ss[m * 4 + 3] + 1) {
            io.WriteByte(mut w, ar[j])
        }
        ss[m * 4] = ss[m * 4 + 3] + 1
        fill(dir, m, mut ar, mut ss)?
    }
    return nil
}

// lineLess は ar の行 [a, ea) が行 [b, eb) より前か（ea / eb は改行の位置。ar は読むだけ — mut で受けるのは、マージの間ずっと書き足す列を凍らせないため）
func lineLess(ar mut []byte, a0 int, ea int, b0 int, eb int) bool {
    mut a := a0
    mut b := b0
    while a < ea && b < eb {
        if ar[a] != ar[b] {
            return ar[a] < ar[b]
        }
        a += 1
        b += 1
    }
    return a == ea && b < eb
}

// fill は run r の頭の行の改行を探し、枠の中に無ければ残りを枠の頭へ寄せてファイルから 1 切片ずつ足す（run の終わりなら改行の位置 = −1）
func fill(dir string, r int, ar mut []byte, ss mut []int) error? {
    base := r * 2 * slot
    while true {
        mut i := ss[r * 4]
        lim := ss[r * 4 + 1]
        while i < lim && ar[i] != '\n' {
            i += 1
        }
        if i < lim {
            ss[r * 4 + 3] = i
            return nil
        }
        // 残りの欠けた行を頭へ
        mut d := base
        for j <- iter.Range(ss[r * 4], lim) {
            ar[d] = ar[j]
            d += 1
        }
        ss[r * 4] = base
        // 式ブロックで包む: pull は mut の引数を持つので region 透過で、包まないと切片の枠（io.ChunksAt の 1 回ごとに 2 × 64 KiB）が
        // マージの間ずっと積もる（RSS が入力の大きさの約 2 倍 — 包むと窓の分だけ）
        n := { pull("${dir}/run-${r}", ss[r * 4 + 2], mut ar, d) catch -1 }
        if n < 0 {
            return io.Other{errno: 5}
        }
        ss[r * 4 + 1] = d + n
        ss[r * 4 + 2] = ss[r * 4 + 2] + n
        if n == 0 {
            ss[r * 4 + 3] = -1
            return nil
        }
    }
    return nil
}

// pull は path の off から 1 切片を ar[at ..] へ写し、写したバイト数を返す（0 = EOF）
func pull(path string, off int, ar mut []byte, at int) (int, error?) {
    f := io.Open(path)?
    defer io.Close(f)
    mut n := 0
    for c <- io.ChunksAt(f, off)? {
        b := io.Raw(c)
        for j <- iter.Range(0, len(b)) {
            ar[at + j] = b[j]
        }
        n = len(b)
        break
    }
    return n, nil
}

func atoi(b []byte) int {
    mut v := 0
    for x <- b {
        v = v * 10 + int(x) - '0'
    }
    return v
}
