package main

// binary-trees（benchmarks game — docs/bench.md）: 深さ d の完全二分木を作っては数えて捨てるのを繰り返す（確保と解放の速さ）。
// Sober の形: 木は 1 本ずつの arena（mut []int — 節ごとに [左, 右]・葉は -1）。1 本を作って数える関数の region が木ごと捨てる（GC なし — region の
// 解放がこの題材の「回収」）。長寿命の木は main の region に置く。Go の双子（bench/binarytrees/go）はポインタの木と GC（定番の形）

import "std/iter"
import "std/os"

// bottomUp は深さ d の木を a に積み、根の番号を返す
func bottomUp(a mut []int, d int) int {
    mut l := -1
    mut r := -1
    if d > 0 {
        l = bottomUp(mut a, d - 1)
        r = bottomUp(mut a, d - 1)
    }
    a = append(a, l)
    a = append(a, r)
    return len(a) / 2 - 1
}

// check は節 n の部分木の節の数
func check(a []int, n int) int {
    l := a[n * 2]
    if l < 0 {
        return 1
    }
    return 1 + check(a, l) + check(a, a[n * 2 + 1])
}

// one は深さ d の木を作って数え、捨てる（この関数の region ごと）
func one(d int) int {
    mut a := mut []int{}
    r := bottomUp(mut a, d)
    return check(freeze(a), r)
}

func atoi(s string) int {
    b := bytes(s)
    mut n := 0
    for i <- iter.Range(0, len(b)) {
        n = n * 10 + int(b[i]) - '0'
    }
    return n
}

func main() int {
    args := os.Args() catch return 2
    n := if len(args) > 1 { atoi(args[1]) } else { 10 }
    minDepth := 4
    maxDepth := if minDepth + 2 > n { minDepth + 2 } else { n }
    stretch := maxDepth + 1
    println("stretch tree of depth ${stretch}\t check: ${one(stretch)}")
    mut long := mut []int{}
    lr := bottomUp(mut long, maxDepth)
    mut d := minDepth
    while d <= maxDepth {
        iters := 1 << (maxDepth - d + minDepth)
        mut c := 0
        for i <- iter.Range(0, iters) {
            c += one(d)
        }
        println("${iters}\t trees of depth ${d}\t check: ${c}")
        d += 2
    }
    println("long lived tree of depth ${maxDepth}\t check: ${check(freeze(long), lr)}")
    return 0
}
