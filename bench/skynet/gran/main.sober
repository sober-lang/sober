package main

// Skynet の粒度の対照: 葉が L 回の足し算をしてから番号を返す。実引数 = 葉の数・L
import "std/iter"
import "std/os"
import "std/par"

func leaf(num int, l int) int {
    mut a := 0
    mut i := 0
    while i < l {
        a = a + (i ^ num)
        i += 1
    }
    return num + a - a
}

func skynet(num int, size int, div int, l int) int {
    if size == 1 {
        return leaf(num, l)
    }
    sub := size / div
    mut ds := mut []int{}
    for i <- iter.Range(0, div) {
        ds = append(ds, i)
    }
    vs, e := par.Map(freeze(ds), (i) => skynet(num + i * sub, sub, div, l))
    if e != nil {
        return -1
    }
    mut acc := 0
    for j <- iter.Range(0, len(vs)) {
        acc += vs[j]
    }
    return acc
}

func atoi(s string) int {
    b := bytes(s)
    mut n := 0
    for i <- iter.Range(0, len(b)) {
        n = n * 10 + int(b[i]) - '0'
    }
    return n
}

func main() int {
    args := os.Args() catch return 2
    n := atoi(args[1])
    l := atoi(args[2])
    r := skynet(0, n, 10, l)
    println(r)
    return if r == n * (n - 1) / 2 { 0 } else { 1 }
}
