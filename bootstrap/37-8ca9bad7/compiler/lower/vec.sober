package lower

// 自動ベクトル化のスパイク（性能投資 第三便 — DESIGN の収穫仮説 5 本・rtlower / inline / cfgclean の後・最適化のバックエンドの経路だけ）:
// バイトの走査のループ（`while b[i] != ';' { i += 1 }` の形 — 帰納変数 1 本の +1・境界の検査・load8 と定数の比較だけ・副作用なし）の前置きに
// `j = scanb(p, i0, 上限…)` を挿し、前置きの辺の i0 を j に差し替える。scanb は「継続の条件が 16 レーン全部で成り立つ塊」を上限の手前まで読み飛ばし、
// 出口のレーンがあればそこへ進める（SSE2 — x86.sober の xScanB）。その後は元のスカラーのループがそのまま走るので、出口・境界検査の panic・端数は
// 全部スカラーが持つ — ループは書き換えない。正しさの論証は「読み飛ばした反復はどれも、境界の内側で継続の条件が成り立ち、副作用が無い（i の +1 だけ）」の 1 点。
// 判定（エイリアス・依存の解析は要らない — ループの中に store も呼び出しも無いことを形で見る）:
//   ① 頭 H の前任 = 外の 1 つ（br — 前置き P）+ ループの中の latch（br H）
//   ② H から継続の側を辿った鎖（4 ブロックまで）の命令が const・gep.byte(p, i)・load8(その gep, 0)・比較・i + 1 だけ
//   ③ 各 condbr は「i <u / < 上限（不変）」の境界（偽の側 or 真の側が exit — panic の点）か「load8 の値と定数の比較」（片側が出口）
//   ④ 上限の検査は load より前（読み飛ばしの 16 バイトの読みの安全 = スカラーが同じ上限の内側だけを読む）・上限が 1 つ以上
//   ⑤ latch の実引数: i の位置は i + 1・他の仮引数はそのまま（不変）

import "desugar"
import "std/iter"

const VK_EQ = 0  // 出口 = x == K
const VK_NE = 1  // 出口 = x != K
const VK_LT = 2  // 出口 = x <u K
const VK_GE = 3  // 出口 = x >=u K

// vecModule はモジュールの全関数に掛ける（掛けた数を返す）
func vecModule(st mut St) int {
    mut n := 0
    mut f := st.fhead
    while f != -1 {
        if irFnBHead(mut st, f) != -1 {
            n = n + {
                vecFunc(mut st, f)
            }
        }
        f = irFnNext(mut st, f)
    }
    return n
}

func vecFunc(st mut St, f FnRef) int {
    st.fn = f
    mut n := 0
    mut b := irFnBHead(mut st, f)
    while b != -1 {
        if irBlkPHead(mut st, b) >= 0 && irBlkPreds(mut st, b) == 2 {
            if vecLoop(mut st, f, b) || vecCount(mut st, f, b) {
                n += 1
            }
        }
        b = irBlkNext(mut st, b)
    }
    return n
}

// vecDef は値 v を定義する命令（ブロックの列 blks の中で — 無ければ -1）
func vecDef(st mut St, blks mut []int, nb int, v int) InsRef {
    for k <- iter.Range(0, nb) {
        mut i := irBlkIHead(mut st, BlkRef(blks[k]))
        while i != -1 {
            if irInsRes(mut st, i) == v {
                return i
            }
            i = irInsNext(mut st, i)
        }
    }
    return -1
}

// vecParamIdx は v が H の何番目の仮引数か（-1 = 違う）
func vecParamIdx(st mut St, h BlkRef, v int) int {
    mut k := 0
    mut p := irBlkPHead(mut st, h)
    while p >= 0 {
        if desugar.HeapGet(mut st.d, p + 1) == v {
            return k
        }
        k += 1
        p = desugar.HeapGet(mut st.d, p)
    }
    return -1
}

// vecIsExit は b が panic の点（exit で終わる）か
func vecIsExit(st mut St, b BlkRef) bool {
    return irBlkTerm(mut st, b) == TmExit
}

// vecLoop は頭 h のループを判定し、合えば前置きに scanb を挿す
func vecLoop(st mut St, f FnRef, h BlkRef) bool {
    // 鎖: h から継続の側を辿り latch（br h）まで
    mut blks := mut []int{}
    xFill(mut blks, 9, -1)
    mut nb := 0
    mut at := h
    mut latch := BlkRef(-1)
    // 鎖の各 condbr の継続の側（0 = then・1 = else）
    mut contSide := mut []int{}
    xFill(mut contSide, 9, -1)
    while int(latch) == -1 {
        if nb >= 8 {
            return false
        }
        blks[nb] = int(at)
        nb += 1
        t := irBlkTerm(mut st, at)
        if t == TmBr {
            to := irBrTo(mut st, at)
            if to == h {
                latch = at
            } else if irBlkPreds(mut st, to) == 1 && irBlkPHead(mut st, to) < 0 && emptyArgs(mut st, irBlkX2(mut st, at)) {
                at = to
            } else {
                return false
            }
        } else if t == TmCondbr {
            tt := irCondThen(mut st, at)
            te := irCondElse(mut st, at)
            if !emptyArgs(mut st, irBlkX3(mut st, at)) || !emptyArgs(mut st, irBlkX5(mut st, at)) {
                return false
            }
            // 継続の側 = 鎖の中へ戻る側（片側が panic の点ならもう片側・そうでなければ h へ戻れる側）
            side := if vecIsExit(mut st, tt) { 1 } else if vecIsExit(mut st, te) { 0 } else if vecReaches(mut st, tt, h) { 0 } else if vecReaches(mut st, te, h) { 1 } else { -1 }
            if side < 0 {
                return false
            }
            contSide[nb - 1] = side
            nxt := if side == 0 { tt } else { te }
            if nxt != h && (irBlkPreds(mut st, nxt) != 1 || irBlkPHead(mut st, nxt) >= 0) {
                return false
            }
            if nxt == h {
                return false
            }
            at = nxt
        } else {
            return false
        }
    }
    // 前置き: h の前任のうち鎖の外の 1 つ（br h）
    preh, pslot := vecPreheader(mut st, f, h, latch)
    if int(preh) == -1 {
        return false
    }
    // latch の実引数: 帰納変数の位置を探す
    largs := irBlkX2(mut st, latch)
    np := xLen(mut st, largs)
    mut ik := -1
    mut iv := -1
    mut incr := -1
    for k <- iter.Range(0, np) {
        a := xAt(mut st, largs, k)
        pv := vecParamAt(mut st, h, k)
        if a != pv {
            if ik >= 0 {
                return false
            }
            d := vecDef(mut st, mut blks, nb, a)
            if int(d) == -1 || irInsOp(mut st, d) != OpBin || irInsA(mut st, d) != BAdd || irInsB(mut st, d) != pv || !vecConstIs(mut st, mut blks, nb, irInsC(mut st, d), 1) {
                return false
            }
            ik = k
            iv = pv
            incr = a
        }
    }
    if ik < 0 {
        return false
    }
    // 命令と分岐の分類（鎖の順に — 上限の検査が load より前か）
    mut lims := mut []int{}
    xFill(mut lims, 2, -1)
    mut nl := 0
    mut kinds := mut []int{}
    xFill(mut kinds, 2, 0)
    mut ks := mut []int{}
    xFill(mut ks, 2, 0)
    mut npred := 0
    mut base := -1
    mut gv := -1
    mut xv := -1
    // 同じ gep からの 2 度目の load8（GVN がブロックを跨いで畳まない読み直し）も同じバイトの値（ループの中に store は無い）
    mut xv2 := -1
    for bk <- iter.Range(0, nb) {
        bb := BlkRef(blks[bk])
        mut i := irBlkIHead(mut st, bb)
        while i != -1 {
            op := irInsOp(mut st, i)
            r := irInsRes(mut st, i)
            if op == OpConst || op == OpCmp {
                // 比較は分岐の分類で見る
            } else if op == OpBin && r == incr {
                // i + 1
            } else if op == OpGepB && irInsB(mut st, i) == iv && gv == -1 && vecInvariant(mut st, mut blks, nb, h, irInsA(mut st, i)) {
                if nl == 0 {
                    return false
                }
                base = irInsA(mut st, i)
                gv = r
            } else if op == OpLoad8 && irInsA(mut st, i) == gv && gv != -1 && irInsB(mut st, i) == 0 && (xv == -1 || xv2 == -1) {
                if xv == -1 {
                    xv = r
                } else {
                    xv2 = r
                }
            } else {
                return false
            }
            i = irInsNext(mut st, i)
        }
        if irBlkTerm(mut st, bb) == TmCondbr {
            cv := irBlkX1(mut st, bb)
            d := vecDef(mut st, mut blks, nb, cv)
            if int(d) == -1 || irInsOp(mut st, d) != OpCmp {
                return false
            }
            co := irInsA(mut st, d)
            l := irInsB(mut st, d)
            rr := irInsC(mut st, d)
            // 継続する条件の真偽（継続の側が then なら比較が真で継続）
            contTrue := contSide[bk] == 0
            if l == iv && vecInvariant(mut st, mut blks, nb, h, rr) && ((contTrue && (co == CLt || co == CUlt)) || (!contTrue && co == CUge)) {
                // 同じ上限の検査の繰り返し（&& の各項の境界検査）は 1 つに
                if nl == 0 || (lims[0] != rr && (nl == 1 || lims[1] != rr)) {
                    if nl >= 2 {
                        return false
                    }
                    lims[nl] = rr
                    nl += 1
                }
            } else if (l == xv || l == xv2) && xv != -1 && vecConstOf(mut st, mut blks, nb, rr) {
                kv := vecConstVal(mut st, mut blks, nb, rr)
                kd, kk := vecKind(co, kv, contTrue)
                if kd < 0 || npred >= 2 {
                    return false
                }
                if kd < 4 {
                    kinds[npred] = kd
                    ks[npred] = kk
                    npred += 1
                }
            } else {
                return false
            }
        }
    }
    if nl == 0 || npred == 0 || xv == -1 {
        return false
    }
    // 前置きに scanb を挿す（不変の値が h の仮引数なら前置きの実引数に読み替える）
    pargs := if pslot == 2 { irBlkX2(mut st, preh) } else if pslot == 3 { irBlkX3(mut st, preh) } else { irBlkX5(mut st, preh) }
    ops := listN(mut st, 2 + nl)
    desugar.HeapSet(mut st.d, ops + 1, vecOuter(mut st, h, pargs, base))
    desugar.HeapSet(mut st.d, ops + 2, xAt(mut st, pargs, ik))
    for k <- iter.Range(0, nl) {
        desugar.HeapSet(mut st.d, ops + 3 + k, vecOuter(mut st, h, pargs, lims[k]))
    }
    desc := listN(mut st, 2 + 2 * npred)
    desugar.HeapSet(mut st.d, desc + 1, nl)
    desugar.HeapSet(mut st.d, desc + 2, npred)
    for k <- iter.Range(0, npred) {
        desugar.HeapSet(mut st.d, desc + 3 + 2 * k, kinds[k])
        desugar.HeapSet(mut st.d, desc + 4 + 2 * k, ks[k])
    }
    j := newValueIn(mut st, f)
    linkInst(mut st, preh, mkInst(mut st, j, OpScanB, ops, desc, 0))
    // 前置きの実引数の列を写して i0 を j に（列は他の辺と共有しうるので書き換えない）
    nargs := listN(mut st, xLen(mut st, pargs))
    for k <- iter.Range(0, xLen(mut st, pargs)) {
        desugar.HeapSet(mut st.d, nargs + 1 + k, if k == ik { j } else { xAt(mut st, pargs, k) })
    }
    if pslot == 2 {
        irSetBlkX2(mut st, preh, nargs)
    } else if pslot == 3 {
        irSetBlkX3(mut st, preh, nargs)
    } else {
        irSetBlkX5(mut st, preh, nargs)
    }
    return true
}

// 数え上げ（文字列 SIMD 便 段 3 — report-557 (E3)）: `while i < X { if b[i] == K1 || … || b[i] == Km { n += 1 }; i += 1 }`（json.bound の形 — 等値の
// 鎖・当たりのブロックで n + 1・合流の latch で i + 1。m ≤ 4・K は 0〜255 の定数）の前置きに、i0 から上限までの 16 バイトの塊の数だけの区間
// [i0, j)（j = i0 + (max(X − i0, 0) & −16)）を数える scanb（記述の列の先頭 = -2 — x86 の xCountB）を挿し、ループへは (n0 + 数, j) を渡す。
// 端数はスカラーのループがそのまま数える。論証: 読み飛ばす反復はどれも i < j ≤ X で、効果は「b[i] が K のどれかなら n + 1・i + 1」だけ
// （ループの中に他の命令・出口が無いことを形で見る）。K は重ねない（同じ K の述語は 1 つに — 塊の中でレーンごとの当たりの数を足すので）
func vecCount(st mut St, f FnRef, h BlkRef) bool {
    if irBlkTerm(mut st, h) != TmCondbr || !vecOnlyCmp(mut st, h) {
        return false
    }
    hc := vecDefIn(mut st, h, irBlkX1(mut st, h))
    if int(hc) == -1 || irInsOp(mut st, hc) != OpCmp || (irInsA(mut st, hc) != CLt && irInsA(mut st, hc) != CUlt) {
        return false
    }
    t0 := irCondThen(mut st, h)
    if !emptyArgs(mut st, irBlkX3(mut st, h)) || irBlkPreds(mut st, t0) != 1 || irBlkPHead(mut st, t0) >= 0 {
        return false
    }
    // 等値の鎖: 各ブロックの condbr の片側が当たりのブロック hit（全部同じ）・もう片側が次の検査か合流の latch（実引数 = n）
    mut ksv := mut []int{}
    xFill(mut ksv, 4, -1)
    mut nk := 0
    mut hit := BlkRef(-1)
    mut latch := BlkRef(-1)
    mut missArgs := -1
    mut gv := -1
    mut xv := -1
    mut base := -1
    mut at := t0
    mut steps := 0
    mut cb := mut []int{}
    xFill(mut cb, 4, -1)
    // 境界の検査のブロック（数えない — 不変の確かめだけ）
    mut bcb := mut []int{}
    xFill(mut bcb, 2, -1)
    mut nbc := 0
    iv := irInsB(mut st, hc)
    lim := irInsC(mut st, hc)
    while int(latch) == -1 {
        if steps >= 4 || irBlkTerm(mut st, at) != TmCondbr {
            return false
        }
        cb[steps] = int(at)
        steps += 1
        mut i := irBlkIHead(mut st, at)
        while i != -1 {
            op := irInsOp(mut st, i)
            r := irInsRes(mut st, i)
            if op == OpConst || op == OpCmp {
            } else if op == OpGepB && gv == -1 && irInsB(mut st, i) == iv {
                base = irInsA(mut st, i)
                gv = r
            } else if op == OpLoad8 && xv == -1 && gv != -1 && irInsA(mut st, i) == gv && irInsB(mut st, i) == 0 {
                xv = r
            } else {
                return false
            }
            i = irInsNext(mut st, i)
        }
        // 比較は前の検査のブロックのものでもよい（GVN が同じ比較を畳む — x == K を 2 度書いた形）
        d := vecDefFn(mut st, irBlkX1(mut st, at))
        if int(d) == -1 || irInsOp(mut st, d) != OpCmp {
            return false
        }
        // 頭と同じ上限の境界の検査（真の側が panic の点 — i0 が負なら最初の反復で panic。そのときは塊を読まない — 下の j の守り）
        if xv == -1 && irInsA(mut st, d) == CUge && irInsB(mut st, d) == iv && irInsC(mut st, d) == lim && vecIsExit(mut st, irCondThen(mut st, at)) {
            nx := irCondElse(mut st, at)
            if !emptyArgs(mut st, irBlkX5(mut st, at)) || irBlkPreds(mut st, nx) != 1 || irBlkPHead(mut st, nx) >= 0 || nbc >= 2 {
                return false
            }
            bcb[nbc] = int(at)
            nbc += 1
            steps -= 1
            at = nx
            continue
        }
        if irInsB(mut st, d) != xv || xv == -1 {
            return false
        }
        co := irInsA(mut st, d)
        kd := vecDefFn(mut st, irInsC(mut st, d))
        if (co != CEq && co != CNe) || int(kd) == -1 || irInsOp(mut st, kd) != OpConst || irInsA(mut st, kd) < 0 || irInsA(mut st, kd) > 255 {
            return false
        }
        kv := irInsA(mut st, kd)
        hs := if co == CEq { irCondThen(mut st, at) } else { irCondElse(mut st, at) }
        ms := if co == CEq { irCondElse(mut st, at) } else { irCondThen(mut st, at) }
        hargs := if co == CEq { irBlkX3(mut st, at) } else { irBlkX5(mut st, at) }
        margs := if co == CEq { irBlkX5(mut st, at) } else { irBlkX3(mut st, at) }
        if !emptyArgs(mut st, hargs) || (int(hit) != -1 && hs != hit) {
            return false
        }
        hit = hs
        mut dup := false
        for k <- iter.Range(0, nk) {
            if ksv[k] == kv {
                dup = true
            }
        }
        if !dup {
            ksv[nk] = kv
            nk += 1
        }
        if irBlkTerm(mut st, ms) == TmBr && irBrTo(mut st, ms) == h && irBlkPHead(mut st, ms) >= 0 {
            latch = ms
            missArgs = margs
        } else if irBlkPreds(mut st, ms) == 1 && irBlkPHead(mut st, ms) < 0 && emptyArgs(mut st, margs) {
            at = ms
        } else {
            return false
        }
    }
    // 当たりのブロック: n + 1 だけで latch へ
    if irBlkTerm(mut st, hit) != TmBr || irBrTo(mut st, hit) != latch || irBlkPHead(mut st, hit) >= 0 || irBlkPreds(mut st, hit) != steps {
        return false
    }
    // latch: 仮引数 1 つ（n）・前任 2 つ（hit と最後の検査）・命令は i + 1 だけ
    if irBlkPreds(mut st, latch) != 2 || xLen(mut st, missArgs) != 1 || xLen(mut st, irBlkX2(mut st, hit)) != 1 {
        return false
    }
    lp := vecParamAt(mut st, latch, 0)
    if vecParamAt(mut st, latch, 1) != -1 {
        return false
    }
    acc := xAt(mut st, missArgs, 0)
    hd := vecDefIn(mut st, hit, xAt(mut st, irBlkX2(mut st, hit), 0))
    if int(hd) == -1 || irInsOp(mut st, hd) != OpBin || irInsA(mut st, hd) != BAdd || irInsB(mut st, hd) != acc || !vecIsConst(mut st, irInsC(mut st, hd), 1) || !vecOnlyIns(mut st, hit, hd) {
        return false
    }
    // 頭の仮引数: n の位置は latch の仮引数・i の位置は latch の中の i + 1・他はそのまま
    preh, pslot := vecPreheader(mut st, f, h, latch)
    if int(preh) == -1 {
        return false
    }
    largs := irBlkX2(mut st, latch)
    mut ik := -1
    mut nkp := -1
    mut incr := -1
    for k <- iter.Range(0, xLen(mut st, largs)) {
        a := xAt(mut st, largs, k)
        pv := vecParamAt(mut st, h, k)
        if a == lp && pv == acc {
            nkp = k
        } else if a != pv {
            dd := vecDefIn(mut st, latch, a)
            if ik >= 0 || int(dd) == -1 || irInsOp(mut st, dd) != OpBin || irInsA(mut st, dd) != BAdd || irInsB(mut st, dd) != pv || pv != iv || !vecIsConst(mut st, irInsC(mut st, dd), 1) {
                return false
            }
            ik = k
            incr = a
        }
    }
    if ik < 0 || nkp < 0 || !vecOnlyIns(mut st, latch, vecDefIn(mut st, latch, incr)) {
        return false
    }
    // 上限と基底はループの外の値（頭の仮引数なら前置きの実引数）
    mut inLoop := vecDefIn(mut st, h, lim) != -1 || vecDefIn(mut st, h, base) != -1 || vecDefIn(mut st, hit, base) != -1 || vecDefIn(mut st, latch, base) != -1
    for k <- iter.Range(0, steps) {
        if vecDefIn(mut st, BlkRef(cb[k]), base) != -1 || vecDefIn(mut st, BlkRef(cb[k]), lim) != -1 {
            inLoop = true
        }
    }
    for k <- iter.Range(0, nbc) {
        if vecDefIn(mut st, BlkRef(bcb[k]), base) != -1 {
            inLoop = true
        }
    }
    if inLoop {
        return false
    }
    pargs := if pslot == 2 { irBlkX2(mut st, preh) } else if pslot == 3 { irBlkX3(mut st, preh) } else { irBlkX5(mut st, preh) }
    i0 := xAt(mut st, pargs, ik)
    n0 := xAt(mut st, pargs, nkp)
    limO := vecOuter(mut st, h, pargs, lim)
    baseO := vecOuter(mut st, h, pargs, base)
    // j = i0 + (max(X − i0, 0) & −16)・i0 が負なら j = i0（スカラーが最初の反復で panic するか、上限の検査で出る）
    k63 := vecK(mut st, f, preh, 63)
    km1 := vecK(mut st, f, preh, -1)
    dv := vecBin(mut st, f, preh, BSub, limO, i0)
    ng := vecBin(mut st, f, preh, BXor, vecBin(mut st, f, preh, BSar, dv, k63), km1)
    ni := vecBin(mut st, f, preh, BXor, vecBin(mut st, f, preh, BSar, i0, k63), km1)
    dp := vecBin(mut st, f, preh, BAnd, vecBin(mut st, f, preh, BAnd, dv, ng), ni)
    k16 := vecBin(mut st, f, preh, BAnd, dp, vecK(mut st, f, preh, -16))
    jv := vecBin(mut st, f, preh, BAdd, i0, k16)
    ops := listN(mut st, 3)
    desugar.HeapSet(mut st.d, ops + 1, baseO)
    desugar.HeapSet(mut st.d, ops + 2, i0)
    desugar.HeapSet(mut st.d, ops + 3, jv)
    desc := listN(mut st, 2 + nk)
    desugar.HeapSet(mut st.d, desc + 1, -2)
    desugar.HeapSet(mut st.d, desc + 2, nk)
    for k <- iter.Range(0, nk) {
        desugar.HeapSet(mut st.d, desc + 3 + k, ksv[k])
    }
    cv := newValueIn(mut st, f)
    linkInst(mut st, preh, mkInst(mut st, cv, OpScanB, ops, desc, 0))
    n1 := vecBin(mut st, f, preh, BAdd, n0, cv)
    nargs := listN(mut st, xLen(mut st, pargs))
    for k <- iter.Range(0, xLen(mut st, pargs)) {
        desugar.HeapSet(mut st.d, nargs + 1 + k, if k == ik { jv } else if k == nkp { n1 } else { xAt(mut st, pargs, k) })
    }
    if pslot == 2 {
        irSetBlkX2(mut st, preh, nargs)
    } else if pslot == 3 {
        irSetBlkX3(mut st, preh, nargs)
    } else {
        irSetBlkX5(mut st, preh, nargs)
    }
    return true
}

// vecDefIn は値 v を定義するブロック b の中の命令（無ければ -1）
func vecDefIn(st mut St, b BlkRef, v int) InsRef {
    mut i := irBlkIHead(mut st, b)
    while i != -1 {
        if irInsRes(mut st, i) == v {
            return i
        }
        i = irInsNext(mut st, i)
    }
    return -1
}

// vecOnlyCmp は b の命令が const と比較だけか
func vecOnlyCmp(st mut St, b BlkRef) bool {
    mut i := irBlkIHead(mut st, b)
    while i != -1 {
        op := irInsOp(mut st, i)
        if op != OpConst && op != OpCmp {
            return false
        }
        i = irInsNext(mut st, i)
    }
    return true
}

// vecOnlyIns は b の命令が x と const だけか
func vecOnlyIns(st mut St, b BlkRef, x InsRef) bool {
    mut i := irBlkIHead(mut st, b)
    while i != -1 {
        if i != x && irInsOp(mut st, i) != OpConst {
            return false
        }
        i = irInsNext(mut st, i)
    }
    return true
}

func vecIsConst(st mut St, v int, n int) bool {
    d := vecDefFn(mut st, v)
    return int(d) != -1 && irInsOp(mut st, d) == OpConst && irInsA(mut st, d) == n
}

// vecK / vecBin は前置き b の末尾に定数 / 二項の演算を足して結果の値を返す
func vecK(st mut St, f FnRef, b BlkRef, n int) int {
    r := newValueIn(mut st, f)
    linkInst(mut st, b, mkInst(mut st, r, OpConst, n, 0, 0))
    return r
}

func vecBin(st mut St, f FnRef, b BlkRef, kind int, x int, y int) int {
    r := newValueIn(mut st, f)
    linkInst(mut st, b, mkInst(mut st, r, OpBin, kind, x, y))
    return r
}

// vecNorm は x co K（x = 0〜255 のバイト）を「x < T」かその否定に揃える: (T, less〔true = x < T の形〕, ok)。符号なしの比較で K が負は扱わない
func vecNorm(co int, kv int) (int, bool, bool) {
    if (co == CUlt || co == CUge) && kv < 0 {
        return 0, false, false
    }
    if co == CLt || co == CUlt {
        return kv, true, true
    }
    if co == CLe {
        return kv + 1, true, true
    }
    if co == CGt {
        return kv + 1, false, true
    }
    if co == CGe || co == CUge {
        return kv, false, true
    }
    return 0, false, false
}

// vecKind は「比較 co x, K の結果が contTrue なら継続」を出口の種類と K に: (種類, K)。種類 -1 = 扱えない・4 = 常に継続（述語を落とす）
func vecKind(co int, kv int, contTrue bool) (int, int) {
    if co == CEq || co == CNe {
        if kv < 0 || kv > 255 {
            return -1, 0
        }
        // 継続 = (x == K) なら出口 = x != K
        eqCont := (co == CEq) == contTrue
        return if eqCont { VK_NE } else { VK_EQ }, kv
    }
    t, less, ok := vecNorm(co, kv)
    if !ok {
        return -1, 0
    }
    // 継続 ⇔ (x < T) == contLess
    contLess := less == contTrue
    if t <= 0 || t >= 256 {
        // x < T が全レーンで同じ真偽: 常に継続なら述語を落とす・常に出口なら得が無い
        always := t >= 256
        return if always == contLess { 4 } else { -1 }, 0
    }
    // 継続 = x < T なら出口 = x >=u T・継続 = x >= T なら出口 = x <u T
    return if contLess { VK_GE } else { VK_LT }, t
}

func vecParamAt(st mut St, h BlkRef, k int) int {
    mut n := 0
    mut p := irBlkPHead(mut st, h)
    while p >= 0 {
        if n == k {
            return desugar.HeapGet(mut st.d, p + 1)
        }
        n += 1
        p = desugar.HeapGet(mut st.d, p)
    }
    return -1
}

// vecInvariant は v がループの中で変わらないか（鎖の命令の結果でない・h の仮引数ならその位置が latch でそのまま渡る — vecLoop が帰納変数以外は確かめ済み）
func vecInvariant(st mut St, blks mut []int, nb int, h BlkRef, v int) bool {
    return int(vecDef(mut st, mut blks, nb, v)) == -1
}

// vecOuter は不変の値 v の前置きでの値（h の仮引数なら前置きの実引数）
func vecOuter(st mut St, h BlkRef, pargs int, v int) int {
    k := vecParamIdx(mut st, h, v)
    return if k >= 0 { xAt(mut st, pargs, k) } else { v }
}

func vecConstOf(st mut St, blks mut []int, nb int, v int) bool {
    d := vecDef(mut st, mut blks, nb, v)
    if int(d) != -1 {
        return irInsOp(mut st, d) == OpConst
    }
    // 鎖の外の定数（関数の中を探す）
    return int(vecDefFn(mut st, v)) != -1 && irInsOp(mut st, vecDefFn(mut st, v)) == OpConst
}

func vecConstVal(st mut St, blks mut []int, nb int, v int) int {
    d := vecDef(mut st, mut blks, nb, v)
    return irInsA(mut st, if int(d) != -1 { d } else { vecDefFn(mut st, v) })
}

func vecConstIs(st mut St, blks mut []int, nb int, v int, n int) bool {
    return vecConstOf(mut st, mut blks, nb, v) && vecConstVal(mut st, mut blks, nb, v) == n
}

// vecDefFn は今の関数（st.fn）の中で v を定義する命令
func vecDefFn(st mut St, v int) InsRef {
    mut b := irFnBHead(mut st, st.fn)
    while b != -1 {
        mut i := irBlkIHead(mut st, b)
        while i != -1 {
            if irInsRes(mut st, i) == v {
                return i
            }
            i = irInsNext(mut st, i)
        }
        b = irBlkNext(mut st, b)
    }
    return -1
}

// vecReaches は b から前任 1 つのブロックだけを通って（深さ 7 まで — panic の点の側は辿らない）h へ戻れるか（継続の側の判定）
func vecReaches(st mut St, b BlkRef, h BlkRef) bool {
    return vecReachesD(mut st, b, h, 7)
}

func vecReachesD(st mut St, b BlkRef, h BlkRef, d int) bool {
    if d == 0 || irBlkPreds(mut st, b) != 1 || vecIsExit(mut st, b) {
        return false
    }
    t := irBlkTerm(mut st, b)
    if t == TmBr {
        to := irBrTo(mut st, b)
        return to == h || vecReachesD(mut st, to, h, d - 1)
    }
    if t == TmCondbr {
        return vecReachesD(mut st, irCondThen(mut st, b), h, d - 1) || vecReachesD(mut st, irCondElse(mut st, b), h, d - 1)
    }
    return false
}

// vecPreheader は h の前任のうち latch 以外の 1 つ（無ければ -1）と、h へ入る辺の実引数の欄（2 = br の X2・3 = condbr の then・5 = condbr の else）。
// condbr の片側でもよい — scanb は純粋（上限の内側だけを読む）なので、もう片側の経路では結果が捨てられるだけ
func vecPreheader(st mut St, f FnRef, h BlkRef, latch BlkRef) (BlkRef, int) {
    mut found := BlkRef(-1)
    mut slot := 0
    mut b := irFnBHead(mut st, f)
    while b != -1 {
        t := irBlkTerm(mut st, b)
        if b != latch {
            n := if t == TmBr && irBrTo(mut st, b) == h { 1 } else if t == TmCondbr { (if irCondThen(mut st, b) == h { 1 } else { 0 }) + (if irCondElse(mut st, b) == h { 1 } else { 0 }) } else { 0 }
            if n > 1 || (n == 1 && int(found) != -1) {
                return BlkRef(-1), 0
            }
            if n == 1 {
                found = b
                slot = if t == TmBr { 2 } else if irCondThen(mut st, b) == h { 3 } else { 5 }
            }
        }
        b = irBlkNext(mut st, b)
    }
    return found, slot
}
