package desugar

// 式の型の静的計算（src/desugar.zig の computeTy / declOfExpr / elemDeclOfExpr 一族の写し）。
// 分からなければ -1（Zig 版の null。中の失敗は握りつぶす — catch null）

import "ast"
import "lexer"

// tailExpr はブロック（KBlock / EBlock — どちらも a = 文の列）の末尾の式（末尾が式文でなければ -1）
func tailExpr(st mut S, blk int) int {
    l := hget(mut st, blk + NA)
    n := llen(mut st, l)
    if n == 0 {
        return -1
    }
    s := lat(mut st, l, n - 1)
    return if kindOf(mut st, s) == ast.SExpr { hget(mut st, s + NA) } else { -1 }
}

// dictConstOf は式が辞書 const の参照（`N` / `pkg.N`）ならその const の表の添字（でなければ -1）
func dictConstOf(st mut S, e int, eb int) int {
    k := kindOf(mut st, e)
    if k == ast.EIdent {
        name := hget(mut st, e + NA)
        if lookup(mut st, eb, name) >= 0 {
            return -1
        }
        c := lookupConst(mut st, st.curPkg, name, 0)
        return if c >= 0 && conDict(mut st, c) { c } else { -1 }
    }
    if k == ast.ESelector {
        name := qualName(mut st, e, eb)
        if name < 0 {
            return -1
        }
        pk, lo := resolveIn(mut st, st.curPkg, name)
        if pk < 0 {
            return -1
        }
        c := lookupConst(mut st, pk, name, lo)
        return if c >= 0 && conDict(mut st, c) { c } else { -1 }
    }
    return -1
}

func conPkg(st mut S, c int) int {
    return hget(mut st, st.cons + c * CNSZ + 1)
}

// dictEnter は辞書 const の文脈（宣言側 package・空の型環境・型パラメータ無し）に切り替え、戻す値の記録を返す
func dictEnter(st mut S, pk int) int {
    at := top(mut st)
    put(mut st, st.curPkg)
    put(mut st, st.tenv)
    put(mut st, st.curTparams)
    put(mut st, b2i((st.hasOuter != 0)))
    put(mut st, st.outerB)
    put(mut st, st.outerF)
    put(mut st, b2i((st.inDict != 0)))
    st.curPkg = pk
    st.tenv = -1
    st.curTparams = 0
    st.hasOuter = b2i(false)
    st.inDict = b2i(true)
    return at
}

func dictLeave(st mut S, r int) {
    st.curPkg = hget(mut st, r)
    st.tenv = hget(mut st, r + 1)
    st.curTparams = hget(mut st, r + 2)
    st.hasOuter = b2i(hget(mut st, r + 3) != 0)
    st.outerB = hget(mut st, r + 4)
    st.outerF = hget(mut st, r + 5)
    st.inDict = b2i(hget(mut st, r + 6) != 0)
}

// computeTy は式のコア型（T? の暗黙 some の判定・string の演算の分岐・型引数の推論用）
func computeTy(st mut S, e int, eb int, ef int) int {
    k := kindOf(mut st, e)
    if k == ast.EFor {
        return forIterTy(mut st, e, eb, ef)
    }
    if k == ast.EMutArg {
        if isDotted(mut st, e) {
            return computeTy(mut st, mutArgExpr(mut st, e), eb, ef)
        }
        b := lookup(mut st, eb, hget(mut st, e + NA))
        return if b >= 0 { bnd(mut st, b).ty } else { -1 }
    }
    if k == ast.ETry {
        if kindOf(mut st, hget(mut st, e + NA)) != ast.ECall {
            return -1
        }
        st.trySkip = 1
        t := computeTy(mut st, hget(mut st, e + NA), eb, ef)
        st.trySkip = 0
        return t
    }
    if k == ast.EInt {
        return st.tInt
    }
    if k == ast.EIdent {
        name := hget(mut st, e + NA)
        b := lookup(mut st, eb, name)
        if b >= 0 {
            return bnd(mut st, b).ty
        }
        c := lookupConst(mut st, st.curPkg, name, 0)
        if c >= 0 {
            if !conDict(mut st, c) {
                return st.tInt
            }
            r := dictEnter(mut st, st.curPkg)
            t := computeTy(mut st, hget(mut st, conNode(mut st, c) + NB), -1, -1)
            dictLeave(mut st, r)
            return t
        }
        if strIs(mut st, name, "true") || strIs(mut st, name, "false") {
            return st.tBool
        }
        fi := findFn(mut st, e, eb)
        if fi < 0 {
            return -1
        }
        t, err := sigTy(mut st, fi)
        return if err != nil { -1 } else { t }
    }
    if k == ast.EStrlit || k == ast.EInterp {
        return tString(mut st)
    }
    if k == ast.EIndex {
        bt := computeTy(mut st, hget(mut st, e + NA), eb, ef)
        if bt < 0 {
            return -1
        }
        if tg(mut st, bt) == TSl {
            return tC(mut st, bt)
        }
        if tg(mut st, bt) == TMp {
            // V はセルが組まれた点の座標（F-34 — getm の注釈と同じ読み）
            return tOpt(mut st, mapValueAt(mut st, hget(mut st, e + NA), bt, eb))
        }
        return -1
    }
    if k == ast.ESlice3 {
        return computeTy(mut st, hget(mut st, e + NA), eb, ef)
    }
    if k == ast.EMaplit {
        key, err := tyOf(mut st, st.curPkg, hget(mut st, e + NA), tokOf(mut st, e), 32)
        if err != nil {
            return -1
        }
        value, err2 := tyOf(mut st, st.curPkg, hget(mut st, e + NB), tokOf(mut st, e), 32)
        if err2 != nil {
            return -1
        }
        return tMap(mut st, hget(mut st, e + ND) != 0, st.rdepth - 1, key, value)
    }
    if k == ast.ESlicelit {
        elem, err := tyOf(mut st, st.curPkg, hget(mut st, e + NA), tokOf(mut st, e), 32)
        if err != nil {
            return -1
        }
        return tSlice(mut st, hget(mut st, e + NC) != 0, st.rdepth - 1, elem, false)
    }
    if k == ast.EBinary {
        op := hget(mut st, e + NA)
        if op == lexer.Plus {
            lt := computeTy(mut st, hget(mut st, e + NB), eb, ef)
            rt := if isStringTy(mut st, lt) { lt } else { computeTy(mut st, hget(mut st, e + NC), eb, ef) }
            if isStringTy(mut st, rt) {
                return tSlice(mut st, false, st.rdepth - 1, st.tInt, true)
            }
            return st.tInt
        }
        if op == lexer.Minus || op == lexer.Star || op == lexer.Slash || op == lexer.Percent || op == lexer.Ampersand || op == lexer.Pipe || op == lexer.Caret || op == lexer.Shl || op == lexer.Shr {
            return st.tInt
        }
        if op == lexer.EqualEqual || op == lexer.BangEqual || op == lexer.Less || op == lexer.LessEqual || op == lexer.Greater || op == lexer.GreaterEqual || op == lexer.AmpersandAmpersand || op == lexer.PipePipe {
            return st.tBool
        }
        return -1
    }
    if k == ast.EUnary {
        op := hget(mut st, e + NA)
        if op == lexer.Minus || op == lexer.Caret {
            return st.tInt
        }
        return if op == lexer.Bang { st.tBool } else { -1 }
    }
    if k == ast.ECall {
        return callTy(mut st, e, eb, ef)
    }
    if k == ast.EComposite {
        return compositeTy(mut st, e)
    }
    if k == ast.ESelector {
        dc := dictConstOf(mut st, e, eb)
        if dc >= 0 {
            r := dictEnter(mut st, conPkg(mut st, dc))
            t := computeTy(mut st, hget(mut st, conNode(mut st, dc) + NB), -1, -1)
            dictLeave(mut st, r)
            return t
        }
        return selectorTy(mut st, e, eb, ef)
    }
    if k == ast.EBlock {
        tl := tailExpr(mut st, e)
        return if tl < 0 { -1 } else { computeTy(mut st, tl, eb, ef) }
    }
    return -1
}

// selectorTy は `x.f` のフィールド型（base の型宣言から。分からなければ -1）
func selectorTy(st mut S, e int, eb int, ef int) int {
    base := declOfExpr(mut st, hget(mut st, e + NA), eb, ef)
    fs := structFields(mut st, base)
    if fs < 0 {
        return -1
    }
    i := fieldIndex(mut st, fs, hget(mut st, e + NB))
    if i < 0 {
        return -1
    }
    t, err := tyIn(mut st, hget(mut st, base + 1), hget(mut st, base + 2), hget(mut st, lat(mut st, fs, i) + NB), tokOf(mut st, e))
    return if err != nil { -1 } else { t }
}

func compositeTy(st mut S, e int) int {
    name := hget(mut st, e + NA)
    tok := tokOf(mut st, e)
    dr := lookupType(mut st, st.curPkg, name)
    if dr >= 0 && declKind(mut st, hget(mut st, dr)) == ast.BStruct {
        fs := hget(mut st, hget(mut st, hget(mut st, dr) + NC) + NA)
        targs := hget(mut st, e + NC)
        if llen(mut st, targs) > 0 {
            genv, err := genericEnv(mut st, st.curPkg, dr, targs, tok)
            if err != nil {
                return -1
            }
            saved := st.tenv
            st.tenv = genv
            t, err2 := fieldsTy(mut st, hget(mut st, dr + 1), fs, tok, 32)
            st.tenv = saved
            return if err2 != nil { -1 } else { t }
        }
        t, err := fieldsTy(mut st, hget(mut st, dr + 1), fs, tok, 32)
        return if err != nil { -1 } else { t }
    }
    decl, pk, _ := findVariant(mut st, st.curPkg, name)
    if decl == -1 {
        return -1
    }
    if decl == ERRS {
        t, err := errTy(mut st, pk, tok, 32)
        return if err != nil { -1 } else { t }
    }
    t, err := unionTreeTy(mut st, pk, decl, 0, tok, 32)
    return if err != nil { -1 } else { t }
}

// callTy は呼び出しの結果型（単値）
func callTy(st mut S, e int, eb int, ef int) int {
    skip := st.trySkip
    st.trySkip = 0
    callee0 := hget(mut st, e + NA)
    args := hget(mut st, e + NB)
    na := llen(mut st, args)
    tok := tokOf(mut st, e)
    if skip == 0 && kindOf(mut st, callee0) == ast.EIdent {
        name := hget(mut st, callee0 + NA)
        if strIs(mut st, name, "len") {
            return st.tInt
        }
        // keys(m): 最内 region の imm slice（要素 = キー型）
        if strIs(mut st, name, "keys") && na == 1 {
            mt := computeTy(mut st, lat(mut st, args, 0), eb, ef)
            return if isTag(mut st, mt, TMp) { tSlice(mut st, false, st.rdepth - 1, tC(mut st, mt), false) } else { -1 }
        }
        if strIs(mut st, name, "append") {
            return if na != 2 { -1 } else { computeTy(mut st, lat(mut st, args, 0), eb, ef) }
        }
        if strIs(mut st, name, "freeze") {
            if na != 1 {
                return -1
            }
            at := computeTy(mut st, lat(mut st, args, 0), eb, ef)
            if at < 0 {
                return -1
            }
            if tg(mut st, at) == TSl {
                return mkTy(mut st, TSl, 0, tB(mut st, at), tC(mut st, at), tD(mut st, at))
            }
            if tg(mut st, at) == TMp {
                return mkTy(mut st, TMp, 0, tB(mut st, at), tC(mut st, at), tD(mut st, at))
            }
            return -1
        }
        if isStdPkg(mut st, st.curPkg) {
            if strIs(mut st, name, "sysErrno") || strIs(mut st, name, "sysWriteFile") || strIs(mut st, name, "sysWriteFd") {
                return st.tInt
            }
            if strIs(mut st, name, "sysReadFile") || strIs(mut st, name, "sysReadDir") || strIs(mut st, name, "sysArgs") {
                return tSlice(mut st, false, st.rdepth - 1, st.tInt, false)
            }
        }
        if strIs(mut st, name, "bytesToString") && isStdPkg(mut st, st.curPkg) {
            if na != 1 {
                return -1
            }
            bt := computeTy(mut st, lat(mut st, args, 0), eb, ef)
            if bt < 0 || tg(mut st, bt) != TSl || tD(mut st, bt) != 0 {
                return -1
            }
            return tSlice(mut st, false, tB(mut st, bt), tC(mut st, bt), true)
        }
        if strIs(mut st, name, "bytes") {
            if na != 1 {
                return -1
            }
            bt := computeTy(mut st, lat(mut st, args, 0), eb, ef)
            if !isStringTy(mut st, bt) {
                return -1
            }
            return tSlice(mut st, false, tB(mut st, bt), tC(mut st, bt), false)
        }
    }
    if skip == 0 {
        ft := fnValueTy(mut st, callee0, eb, ef)
        if ft >= 0 {
            return tB(mut st, ft)
        }
    }
    mut callee := callee0
    mut explicit := -1
    if kindOf(mut st, callee) == ast.EIndex {
        explicit = hget(mut st, callee + NB)
        callee = hget(mut st, callee + NA)
    }
    fi := findFn(mut st, callee, eb)
    if fi < 0 {
        return -1
    }
    rs := fnResults(mut st, fi)
    if llen(mut st, rs) != 1 + skip {
        return -1
    }
    tps := fnTParams(mut st, fi)
    if llen(mut st, tps) > 0 {
        ts, err := inferTs(mut st, fi, explicit, args, eb, ef, tok, fnExpands(mut st, fi))
        if err != nil {
            return -1
        }
        penv := listN(mut st, llen(mut st, tps) * 3)
        hv347 := llen(mut st, tps)
        hset(mut st, penv, hv347)
        mut i := 0
        while i < llen(mut st, tps) {
            hv350 := lat(mut st, tps, i)
            hset(mut st, penv + 1 + i * 3, hv350)
            hv351 := lat(mut st, ts, i)
            hset(mut st, penv + 2 + i * 3, hv351)
            hset(mut st, penv + 3 + i * 3, -1)
            i += 1
        }
        t, err2 := tyIn(mut st, fnPkg(mut st, fi), penv, lat(mut st, rs, 0), tok)
        return if err2 != nil { -1 } else { plainResult(mut st, fi, t) }
    }
    t, err := tyOf(mut st, fnPkg(mut st, fi), lat(mut st, rs, 0), tok, 32)
    return if err != nil { -1 } else { plainResult(mut st, fi, t) }
}

// plainResult は素の Def 呼び出し（展開されない・callM でない）の結果型を呼び手座標（最内 region）で読む（Lean の ret.relocR d — F-25）。
// 展開される関数・mut_def は署名の座標のまま
func plainResult(st mut S, fi int, t int) int {
    if fnExpands(mut st, fi) || fnMutDef(mut st, fi) {
        return t
    }
    ps := fnParams(mut st, fi)
    mut i := 0
    while i < llen(mut st, ps) {
        if hget(mut st, lat(mut st, ps, i) + NC) != 0 {
            return t
        }
        i += 1
    }
    c := callResultTop(mut st, t)
    return if c >= 0 { c } else { t }
}

// declOfExpr は式の値の型宣言（struct / union）を静的に辿る
func declOfExpr(st mut S, e int, eb int, ef int) int {
    dc := dictConstOf(mut st, e, eb)
    if dc >= 0 {
        r := dictEnter(mut st, conPkg(mut st, dc))
        d := declOfExpr(mut st, hget(mut st, conNode(mut st, dc) + NB), -1, -1)
        dictLeave(mut st, r)
        return d
    }
    k := kindOf(mut st, e)
    if k == ast.EIdent {
        b := lookup(mut st, eb, hget(mut st, e + NA))
        return if b >= 0 { bnd(mut st, b).decl } else { -1 }
    }
    if k == ast.ETry {
        if kindOf(mut st, hget(mut st, e + NA)) != ast.ECall {
            return -1
        }
        st.trySkip = 1
        d := declOfExpr(mut st, hget(mut st, e + NA), eb, ef)
        st.trySkip = 0
        return d
    }
    if k == ast.ECall {
        skip := st.trySkip
        st.trySkip = 0
        mut callee := hget(mut st, e + NA)
        mut explicit := -1
        if kindOf(mut st, callee) == ast.EIndex {
            explicit = hget(mut st, callee + NB)
            callee = hget(mut st, callee + NA)
        }
        fi := findFn(mut st, callee, eb)
        if fi < 0 {
            return -1
        }
        rs := fnResults(mut st, fi)
        if llen(mut st, rs) != 1 + skip {
            return -1
        }
        if llen(mut st, fnTParams(mut st, fi)) == 0 {
            return declOfTypeExpr(mut st, fnPkg(mut st, fi), lat(mut st, rs, 0))
        }
        penv, err := callEnv(mut st, fi, explicit, hget(mut st, e + NB), eb, ef, tokOf(mut st, e))
        if err != nil {
            return -1
        }
        saved := st.tenv
        st.tenv = penv
        d := declOfTypeExpr(mut st, fnPkg(mut st, fi), lat(mut st, rs, 0))
        st.tenv = saved
        return d
    }
    if k == ast.EComposite {
        name := hget(mut st, e + NA)
        dr := lookupType(mut st, st.curPkg, name)
        if dr >= 0 && declKind(mut st, hget(mut st, dr)) == ast.BStruct {
            targs := hget(mut st, e + NC)
            if llen(mut st, targs) > 0 {
                genv, err := genericEnv(mut st, st.curPkg, dr, targs, tokOf(mut st, e))
                if err != nil {
                    return -1
                }
                return declRef(mut st, hget(mut st, dr), hget(mut st, dr + 1), genv)
            }
            return dr
        }
        decl, pk, _ := findVariant(mut st, st.curPkg, name)
        if decl == -1 {
            return -1
        }
        return declRef(mut st, decl, pk, -1)
    }
    if k == ast.ESelector {
        base := declOfExpr(mut st, hget(mut st, e + NA), eb, ef)
        fs := structFields(mut st, base)
        if fs < 0 {
            return -1
        }
        i := fieldIndex(mut st, fs, hget(mut st, e + NB))
        if i < 0 {
            return -1
        }
        ft := hget(mut st, lat(mut st, fs, i) + NB)
        fk := kindOf(mut st, ft)
        if fk == ast.TName {
            return lookupType(mut st, hget(mut st, base + 1), hget(mut st, ft + NA))
        }
        if fk == ast.TGeneric {
            saved := st.tenv
            st.tenv = hget(mut st, base + 2)
            d := declOfTypeExpr(mut st, hget(mut st, base + 1), ft)
            st.tenv = saved
            return d
        }
        return -1
    }
    if k == ast.EIndex {
        return elemDeclOfExpr(mut st, hget(mut st, e + NA), eb, ef)
    }
    if k == ast.EBlock {
        tl := tailExpr(mut st, e)
        return if tl < 0 { -1 } else { declOfExpr(mut st, tl, eb, ef) }
    }
    if k == ast.EIf {
        tl := tailExpr(mut st, hget(mut st, e + NB))
        return if tl < 0 { -1 } else { declOfExpr(mut st, tl, eb, ef) }
    }
    return -1
}

// elemDeclOfExpr は式が slice のとき、その要素型の宣言
func elemDeclOfExpr(st mut S, e int, eb int, ef int) int {
    k := kindOf(mut st, e)
    if k == ast.EIdent {
        b := lookup(mut st, eb, hget(mut st, e + NA))
        return if b >= 0 { bnd(mut st, b).elem } else { -1 }
    }
    if k == ast.ETry {
        if kindOf(mut st, hget(mut st, e + NA)) != ast.ECall {
            return -1
        }
        st.trySkip = 1
        d := elemDeclOfExpr(mut st, hget(mut st, e + NA), eb, ef)
        st.trySkip = 0
        return d
    }
    if k == ast.ESlicelit {
        return declOfTypeExpr(mut st, st.curPkg, hget(mut st, e + NA))
    }
    if k == ast.ESlice3 {
        return elemDeclOfExpr(mut st, hget(mut st, e + NA), eb, ef)
    }
    if k == ast.ESelector {
        base := declOfExpr(mut st, hget(mut st, e + NA), eb, ef)
        fs := structFields(mut st, base)
        if fs < 0 {
            return -1
        }
        i := fieldIndex(mut st, fs, hget(mut st, e + NB))
        if i < 0 {
            return -1
        }
        saved := st.tenv
        st.tenv = hget(mut st, base + 2)
        d := elemDeclOfTypeExpr(mut st, hget(mut st, base + 1), hget(mut st, lat(mut st, fs, i) + NB))
        st.tenv = saved
        return d
    }
    if k == ast.ECall {
        skip := st.trySkip
        st.trySkip = 0
        c0 := hget(mut st, e + NA)
        args := hget(mut st, e + NB)
        if skip == 0 && kindOf(mut st, c0) == ast.EIdent && strIs(mut st, hget(mut st, c0 + NA), "freeze") && llen(mut st, args) == 1 {
            return elemDeclOfExpr(mut st, lat(mut st, args, 0), eb, ef)
        }
        mut callee := c0
        mut explicit := -1
        if kindOf(mut st, callee) == ast.EIndex {
            explicit = hget(mut st, callee + NB)
            callee = hget(mut st, callee + NA)
        }
        fi := findFn(mut st, callee, eb)
        if fi < 0 {
            return -1
        }
        rs := fnResults(mut st, fi)
        if llen(mut st, rs) != 1 + skip {
            return -1
        }
        if llen(mut st, fnTParams(mut st, fi)) == 0 {
            return elemDeclOfTypeExpr(mut st, fnPkg(mut st, fi), lat(mut st, rs, 0))
        }
        penv, err := callEnv(mut st, fi, explicit, args, eb, ef, tokOf(mut st, e))
        if err != nil {
            return -1
        }
        saved := st.tenv
        st.tenv = penv
        d := elemDeclOfTypeExpr(mut st, fnPkg(mut st, fi), lat(mut st, rs, 0))
        st.tenv = saved
        return d
    }
    return -1
}

// targetTy は代入先の期待型（T? coercion 用。分からなければ -1）
func targetTy(st mut S, target int, eb int, ef int) int {
    k := kindOf(mut st, target)
    if k == ast.EIdent {
        b := lookup(mut st, eb, hget(mut st, target + NA))
        return if b >= 0 { bnd(mut st, b).ty } else { -1 }
    }
    if k == ast.ESelector {
        return selectorTy(mut st, target, eb, ef)
    }
    return -1
}

// callResultTop は call 結果の imm slice / map を呼び手座標（最内 region）で読む（mut を含むものは -1）
func callResultTop(st mut S, rt int) int {
    if tyArgOk(mut st, rt) {
        return rt
    }
    r := st.rdepth - 1
    k := tg(mut st, rt)
    if k == TSl {
        if tA(mut st, rt) != 0 {
            return -1
        }
        t2 := callResultTop(mut st, tC(mut st, rt))
        return if t2 < 0 { -1 } else { mkTy(mut st, TSl, 0, r, t2, tD(mut st, rt)) }
    }
    if k == TMp {
        if tA(mut st, rt) != 0 {
            return -1
        }
        k2 := callResultTop(mut st, tC(mut st, rt))
        if k2 < 0 {
            return -1
        }
        t2 := callResultTop(mut st, tD(mut st, rt))
        return if t2 < 0 { -1 } else { mkTy(mut st, TMp, 0, r, k2, t2) }
    }
    if k == TOpt {
        t2 := callResultTop(mut st, tA(mut st, rt))
        return if t2 < 0 { -1 } else { tOpt(mut st, t2) }
    }
    if k == TUn || k == TPr {
        l := callResultTop(mut st, tA(mut st, rt))
        if l < 0 {
            return -1
        }
        r2 := callResultTop(mut st, tB(mut st, rt))
        return if r2 < 0 { -1 } else { mkTy(mut st, k, l, r2, 0, 0) }
    }
    return -1
}

// patFieldTy はパターンで束縛したフィールドの型
func patFieldTy(st mut S, pk int, te int, tok int) int {
    t, err := tyOf(mut st, pk, te, tok, 32)
    if err != nil {
        return -1
    }
    return callResultTop(mut st, t)
}

// sigTy は関数のシグネチャ → 関数値の型（defOf の param / ret と同じ）
func sigTy(st mut S, fi int) (int, error?) {
    pk := fnPkg(mut st, fi)
    tok := tokOf(mut st, fnNode(mut st, fi))
    pl := fnParams(mut st, fi)
    ps := listN(mut st, llen(mut st, pl))
    mut i := 0
    while i < llen(mut st, pl) {
        hv619 := tyOf(mut st, pk, hget(mut st, lat(mut st, pl, i) + NB), tok, 32)?
        hset(mut st, ps + 1 + i, hv619)
        i += 1
    }
    rl := fnResults(mut st, fi)
    rs := listN(mut st, llen(mut st, rl))
    i = 0
    while i < llen(mut st, rl) {
        rt := tyOf(mut st, pk, lat(mut st, rl, i), tok, 32)?
        hv627 := retTy(mut st, rt)
        hset(mut st, rs + 1 + i, hv627)
        i += 1
    }
    p := tyChain(mut st, ps)
    return tFn(mut st, p, tyChain(mut st, rs)), nil
}

// fnValueTy は callee が関数値（関数型のローカル / フィールド）ならその型（名前付き関数・builtin・ラムダは -1）
func fnValueTy(st mut S, callee int, eb int, ef int) int {
    k := kindOf(mut st, callee)
    if k == ast.EIdent {
        b := lookup(mut st, eb, hget(mut st, callee + NA))
        if b < 0 {
            return -1
        }
        t := bnd(mut st, b).ty
        return if isTag(mut st, t, TFn) { t } else { -1 }
    }
    if k == ast.ESelector {
        base := hget(mut st, callee + NA)
        if kindOf(mut st, base) == ast.EIdent && lookup(mut st, eb, hget(mut st, base + NA)) < 0 && importRef(mut st, st.curPkg, hget(mut st, base + NA)) {
            return -1
        }
        t := computeTy(mut st, callee, eb, ef)
        return if isTag(mut st, t, TFn) { t } else { -1 }
    }
    return -1
}

// typeNameOf は index 位置の式を型名として読む（`f[int]`）— 名前なら同じ綴りの TName 節、でなければ -1
func typeNameOf(st mut S, e int) int {
    if kindOf(mut st, e) != ast.EIdent {
        return -1
    }
    return rec8(mut st, ast.TName, tokOf(mut st, e), hget(mut st, e + NA), 0, 0, 0, 0, 0)
}

// inferTs はジェネリック関数の型引数（明示か、値引数の型からの推論）。inl は展開されるジェネリック（型引数は region を含んでよい）
func inferTs(st mut S, fi int, explicit int, args int, eb int, ef int, tok int, inl bool) (int, error?) {
    tps := fnTParams(mut st, fi)
    n := llen(mut st, tps)
    binds := listN(mut st, n)
    mut i := 0
    while i < n {
        hset(mut st, binds + 1 + i, -1)
        i += 1
    }
    if explicit >= 0 {
        if n != 1 {
            return 0, Fail{k: KMalformed, tok: tok}
        }
        te := typeNameOf(mut st, explicit)
        if te < 0 {
            return 0, Fail{k: KMalformed, tok: tok}
        }
        hv682 := tyOf(mut st, st.curPkg, te, tok, 32)?
        hset(mut st, binds + 1, hv682)
    }
    ph := tvarEnv(mut st, tps, PH)
    ps := fnParams(mut st, fi)
    if llen(mut st, args) != llen(mut st, ps) {
        return 0, Fail{k: KMalformed, tok: tok}
    }
    i = 0
    while i < llen(mut st, ps) {
        pat := tyIn(mut st, fnPkg(mut st, fi), ph, hget(mut st, lat(mut st, ps, i) + NB), tok)?
        act := computeTy(mut st, lat(mut st, args, i), eb, ef)
        if act >= 0 && !unifyTy(mut st, pat, act, binds) {
            return 0, Fail{k: KMalformed, tok: tok}
        }
        i += 1
    }
    i = 0
    while i < n {
        t := lat(mut st, binds, i)
        if t < 0 {
            return 0, Fail{k: KFrag, tok: tok}
        }
        if inl {
            if !tyArgValueOk(mut st, t) {
                return 0, Fail{k: KFrag, tok: tok}
            }
        } else if !tyArgOk(mut st, t) {
            return 0, Fail{k: KFrag, tok: tok}
        }
        i += 1
    }
    return binds, nil
}

// callEnv はジェネリック呼び出しの束縛（型引数 + 分かる範囲で型引数の struct 宣言）
func callEnv(st mut S, fi int, explicit int, args int, eb int, ef int, tok int) (int, error?) {
    ts := inferTs(mut st, fi, explicit, args, eb, ef, tok, true)?
    tps := fnTParams(mut st, fi)
    n := llen(mut st, tps)
    penv := listN(mut st, n * 3)
    hset(mut st, penv, n)
    mut i := 0
    while i < n {
        hv725 := lat(mut st, tps, i)
        hset(mut st, penv + 1 + i * 3, hv725)
        hv726 := lat(mut st, ts, i)
        hset(mut st, penv + 2 + i * 3, hv726)
        hset(mut st, penv + 3 + i * 3, -1)
        i += 1
    }
    ps := fnParams(mut st, fi)
    mut j := 0
    while j < llen(mut st, ps) {
        pt := hget(mut st, lat(mut st, ps, j) + NB)
        mut pn := -1
        mut is_elem := false
        if kindOf(mut st, pt) == ast.TName {
            pn = hget(mut st, pt + NA)
        } else if kindOf(mut st, pt) == ast.TSlice && kindOf(mut st, hget(mut st, pt + NA)) == ast.TName {
            pn = hget(mut st, hget(mut st, pt + NA) + NA)
            is_elem = true
        }
        if pn >= 0 {
            arg := lat(mut st, args, j)
            i = 0
            while i < n {
                if strEq(mut st, hget(mut st, penv + 1 + i * 3), pn) && hget(mut st, penv + 3 + i * 3) == -1 {
                    hv747 := if is_elem { elemDeclOfExpr(mut st, arg, eb, ef) } else { declOfExpr(mut st, arg, eb, ef) }
                    hset(mut st, penv + 3 + i * 3, hv747)
                }
                i += 1
            }
        }
        j += 1
    }
    return penv, nil
}

// isClosureName は e が閉包（関数型の引数に束縛されたラムダ）の名前か
func isClosureName(st mut S, e int, eb int, ef int) bool {
    if kindOf(mut st, e) != ast.EIdent {
        return false
    }
    n := hget(mut st, e + NA)
    return lookup(mut st, eb, n) < 0 && lookupF(mut st, ef, n) >= 0
}

// forOut は for 式が断片外か（V3-4 は単一ジェネレータ・単一束縛）
func forOut(st mut S, fe int) bool {
    gens := hget(mut st, fe + NA)
    if llen(mut st, gens) != 1 {
        return true
    }
    return llen(mut st, hget(mut st, lat(mut st, gens, 0) + NA)) != 1
}

// forIterTy は for 式の型 = Iter[T]（func(func(T))）。推論に使えるのは生成元が slice のときだけ
func forIterTy(st mut S, fe int, eb int, ef int) int {
    if forOut(mut st, fe) {
        return -1
    }
    g := lat(mut st, hget(mut st, fe + NA), 0)
    src := hget(mut st, g + NB)
    if isClosureName(mut st, src, eb, ef) {
        return -1
    }
    t := computeTy(mut st, src, eb, ef)
    // map の生成元はキーを回す（keysm の段）
    isMap := isTag(mut st, t, TMp)
    if !isTag(mut st, t, TSl) && !isMap {
        return -1
    }
    ed := if isMap { -1 } else { elemDeclOfExpr(mut st, src, eb, ef) }
    eb2 := bind(mut st, eb, lat(mut st, hget(mut st, g + NA), 0), 0, false, ed, tC(mut st, t), -1, 0, -1, false)
    y := if hget(mut st, fe + NB) == 0 { computeTy(mut st, hget(mut st, fe + NC), eb2, ef) } else { yieldTyIn(mut st, hget(mut st, fe + NC), eb2, ef) }
    if y < 0 {
        return -1
    }
    kf := tFn(mut st, y, st.tUnit)
    return tFn(mut st, kf, st.tUnit)
}

// bindsOf は束縛の文の各名前を型追跡つきで束縛した環境（yieldTyIn / blockTailTy — 名前と値の数が違えば -2）
func bindsOf(st mut S, s int, eb0 int, ef int) int {
    names := hget(mut st, s + NA)
    vals := hget(mut st, s + NC)
    if llen(mut st, names) != llen(mut st, vals) {
        return -2
    }
    mut eb := eb0
    mut i := 0
    while i < llen(mut st, names) {
        v := lat(mut st, vals, i)
        t := computeTy(mut st, v, eb, ef)
        d := declOfExpr(mut st, v, eb, ef)
        el := elemDeclOfExpr(mut st, v, eb, ef)
        eb = bind(mut st, eb, lat(mut st, names, i), 0, hget(mut st, s + NB) != 0, d, t, el, 0, -1, false)
        i += 1
    }
    return eb
}

// yieldTyIn はブロック形の本体で最初に現れる yield の値の型（束縛・if・while の中まで見る）
func yieldTyIn(st mut S, l int, eb0 int, ef int) int {
    mut eb := eb0
    mut i := 0
    while i < llen(mut st, l) {
        s := lat(mut st, l, i)
        k := kindOf(mut st, s)
        if k == ast.SYield {
            return computeTy(mut st, hget(mut st, s + NA), eb, ef)
        }
        if k == ast.SBind {
            e2 := bindsOf(mut st, s, eb, ef)
            if e2 != -2 {
                eb = e2
            }
        } else if k == ast.SWhile {
            t := yieldTyIn(mut st, hget(mut st, hget(mut st, s + NB) + NA), eb, ef)
            if t >= 0 {
                return t
            }
        } else if k == ast.SExpr && kindOf(mut st, hget(mut st, s + NA)) == ast.EIf {
            mut cur := hget(mut st, s + NA)
            while cur >= 0 {
                if kindOf(mut st, cur) != ast.EIf {
                    if kindOf(mut st, cur) == ast.EBlock {
                        t := yieldTyIn(mut st, hget(mut st, cur + NA), eb, ef)
                        if t >= 0 {
                            return t
                        }
                    }
                    cur = -1
                } else {
                    t := yieldTyIn(mut st, hget(mut st, hget(mut st, cur + NB) + NA), eb, ef)
                    if t >= 0 {
                        return t
                    }
                    cur = hget(mut st, cur + NC)
                }
            }
        }
        i += 1
    }
    return -1
}

// blockTailTy はブロックの末尾値の型（文の束縛を辿ってから末尾の式を型付ける）
func blockTailTy(st mut S, l int, eb0 int, ef int) int {
    n := llen(mut st, l)
    if n == 0 || kindOf(mut st, lat(mut st, l, n - 1)) != ast.SExpr {
        return -1
    }
    mut eb := eb0
    mut i := 0
    while i < n - 1 {
        s := lat(mut st, l, i)
        if kindOf(mut st, s) == ast.SBind {
            e2 := bindsOf(mut st, s, eb, ef)
            if e2 == -2 {
                return -1
            }
            eb = e2
        }
        i += 1
    }
    return computeTy(mut st, hget(mut st, lat(mut st, l, n - 1) + NA), eb, ef)
}

// armTy は腕の末尾の値の型（式文なら computeTy、値を持たない文・空の腕は unit、脱出の文は不明）
func armTy(st mut S, l int, eb int, ef int) int {
    n := llen(mut st, l)
    if n == 0 {
        return st.tUnit
    }
    s := lat(mut st, l, n - 1)
    k := kindOf(mut st, s)
    if k == ast.SExpr {
        return computeTy(mut st, hget(mut st, s + NA), eb, ef)
    }
    if k == ast.SRet || k == ast.SBreak || k == ast.SContinue || k == ast.SYield {
        return -1
    }
    return st.tUnit
}

// switchTy は switch の値の型（腕の末尾から。上の case → default の順に分かる方）
func switchTy(st mut S, sw int, eb int, ef int) int {
    cs := hget(mut st, sw + NB)
    mut i := 0
    while i < llen(mut st, cs) {
        t := armTy(mut st, hget(mut st, hget(mut st, lat(mut st, cs, i) + NB) + NA), eb, ef)
        if t >= 0 {
            return t
        }
        i += 1
    }
    dflt := hget(mut st, sw + NC)
    return if dflt >= 0 { armTy(mut st, hget(mut st, dflt + NA), eb, ef) } else { -1 }
}

// ifTy は if 式の値の型（then → else の順に分かる方）
func ifTy(st mut S, e int, eb int, ef int) int {
    els := hget(mut st, e + NC)
    if els < 0 {
        return -1
    }
    t := armTy(mut st, hget(mut st, hget(mut st, e + NB) + NA), eb, ef)
    if t >= 0 {
        return t
    }
    if kindOf(mut st, els) == ast.EBlock {
        return armTy(mut st, hget(mut st, els + NA), eb, ef)
    }
    return computeTy(mut st, els, eb, ef)
}

// singleExpr は文の列がちょうど式文 1 つならその式（でなければ -1）
func singleExpr(st mut S, l int) int {
    if llen(mut st, l) != 1 {
        return -1
    }
    s := lat(mut st, l, 0)
    return if kindOf(mut st, s) == ast.SExpr { hget(mut st, s + NA) } else { -1 }
}

// retExprTy は return の値の式の型（if 式は両腕が単一式で型が一致すればその型）
func retExprTy(st mut S, e int, eb int, ef int) int {
    if kindOf(mut st, e) == ast.EIf {
        els := hget(mut st, e + NC)
        if els < 0 {
            return computeTy(mut st, e, eb, ef)
        }
        te := singleExpr(mut st, hget(mut st, hget(mut st, e + NB) + NA))
        if te < 0 {
            return computeTy(mut st, e, eb, ef)
        }
        t1 := retExprTy(mut st, te, eb, ef)
        if t1 < 0 {
            return -1
        }
        mut t2 := -1
        if kindOf(mut st, els) == ast.EBlock {
            ee := singleExpr(mut st, hget(mut st, els + NA))
            if ee >= 0 {
                t2 = retExprTy(mut st, ee, eb, ef)
            }
        } else if kindOf(mut st, els) == ast.EIf {
            t2 = retExprTy(mut st, els, eb, ef)
        }
        if t2 < 0 {
            return -1
        }
        return if tyEql(mut st, t1, t2) { t1 } else { -1 }
    }
    return computeTy(mut st, e, eb, ef)
}

// readAnn は読み出しの注釈（imm slice の要素型が注釈を持つならその型。でなければ -1）
func readAnn(st mut S, bt int) int {
    if bt < 0 || tg(mut st, bt) != TSl || tA(mut st, bt) != 0 || tyAnnFree(mut st, tC(mut st, bt)) {
        return -1
    }
    return tC(mut st, bt)
}

// isErrOpt は error?（組み込み error の opt）か。region は見ない
func isErrOpt(st mut S, t int) (bool, error?) {
    if tg(mut st, t) != TOpt {
        return false, nil
    }
    et := errTy(mut st, st.curPkg, 0, 32)?
    return tyEqlLoose(mut st, tA(mut st, t), et), nil
}
