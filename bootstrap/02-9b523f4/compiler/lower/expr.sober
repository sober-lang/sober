package lower

// 式（src/lower.zig の expr / call / if / 演算子の写し）

import "desugar"
import "ast"
import "lexer"

// ── 多値 ──

// evalMulti は多値を許す評価。呼び出しは結果の並び、他の式は 1 値（値なしは空）。到達しないなら -1
func evalMulti(st mut St, e int) (int, error?) {
    k := kindOf(mut st, e)
    if k == ast.ECall {
        return callArgs(mut st, hget(mut st, e + NA), hget(mut st, e + NB), tokOf(mut st, e))
    }
    if k == ast.EPipe {
        return pipe(mut st, e)
    }
    if k == ast.ETry {
        return tryResults(mut st, e)
    }
    t, v := expr(mut st, e)?
    if isTag(mut st, t, TNever) {
        return -1, nil
    }
    if isTag(mut st, t, TNone) {
        return list0(mut st), nil
    }
    r := list2(mut st, t, v)
    hset(mut st, r, 1)
    return r, nil
}

// multiValue は `a, b := e` の右辺: 1 つの多値の式で、結果の個数が want_n
func multiValue(st mut St, values int, want_n int, tok int) (int, error?) {
    if llen(mut st, values) != 1 {
        return 0, LowerFail{k: KMismatch, tok: tok}
    }
    r := evalMulti(mut st, lat(mut st, values, 0))?
    if r < 0 {
        return r, nil
    }
    if hget(mut st, r) != want_n {
        return 0, LowerFail{k: KMismatch, tok: tok}
    }
    return r, nil
}

// pipe は `lhs |> f(args)`: 左辺（多値可）を 1 回評価し、穴 `_` へ順に、穴が無ければ第 1 引数へ渡す
func pipe(st mut St, e int) (int, error?) {
    tok := tokOf(mut st, e)
    lhs := hget(mut st, e + NA)
    args := hget(mut st, e + NC)
    na0 := llen(mut st, args)
    if kindOf(mut st, lhs) == ast.EFor {
        // for 式（Iter[T]）は値にならない: 穴（無ければ第 1 引数）へ式のまま渡し、消費点で展開する
        mut fh := 0
        mut j := 0
        while j < na0 {
            if lat(mut st, args, j) < 0 {
                fh += 1
            }
            j += 1
        }
        if fh > 1 {
            return 0, LowerFail{k: KMismatch, tok: tok}
        }
        fs := listN(mut st, if fh == 0 { na0 + 1 } else { na0 })
        mut q := 0
        if fh == 0 {
            hset(mut st, fs + 1, lhs)
            q = 1
        }
        j = 0
        while j < na0 {
            x := lat(mut st, args, j)
            hset(mut st, fs + 1 + q, if x < 0 { lhs } else { x })
            q += 1
            j += 1
        }
        return callArgs(mut st, hget(mut st, e + NB), fs, tok)
    }
    r := evalMulti(mut st, lhs)?
    if r < 0 {
        return r, nil
    }
    if hget(mut st, r) == 0 {
        return 0, LowerFail{k: KMismatch, tok: tok}
    }
    na := llen(mut st, args)
    mut holes := 0
    mut i := 0
    while i < na {
        if lat(mut st, args, i) < 0 {
            holes += 1
        }
        i += 1
    }
    mut srcs := 0
    mut k := 0
    if holes == 0 {
        if hget(mut st, r) != 1 {
            return 0, LowerFail{k: KMismatch, tok: tok}
        }
        srcs = listN(mut st, na + 1)
        hv1 := node(mut st, EVal, tok, hget(mut st, r + 1), hget(mut st, r + 2), 0, 0)
        hset(mut st, srcs + 1, hv1)
        k = 1
    } else if holes != hget(mut st, r) {
        return 0, LowerFail{k: KMismatch, tok: tok}
    } else {
        srcs = listN(mut st, na)
    }
    mut next := 0
    i = 0
    while i < na {
        x := lat(mut st, args, i)
        if x >= 0 {
            hset(mut st, srcs + 1 + k, x)
        } else {
            hv2 := node(mut st, EVal, tok, hget(mut st, r + 1 + next * 2), hget(mut st, r + 2 + next * 2), 0, 0)
            hset(mut st, srcs + 1 + k, hv2)
            next += 1
        }
        k += 1
        i += 1
    }
    return callArgs(mut st, hget(mut st, e + NB), srcs, tok)
}

// interpExpr は補間（src/interp.zig の固定テンプレート）: 穴を左から順に合成名へ束縛して型を得てから、その名前を参照する
// 連結の連鎖を組んで下ろす（int は std/strings.Itoa（予約参照名 $strings）、bool は if）
func interpExpr(st mut St, e int) (int, int, error?) {
    tok := tokOf(mut st, e)
    lits := hget(mut st, e + NA)
    holes := hget(mut st, e + NB)
    pushScope(mut st)
    nh := llen(mut st, holes)
    ids := listN(mut st, nh)
    mut i := 0
    while i < nh {
        h := lat(mut st, holes, i)
        t, v := expr(mut st, h)?
        if isTag(mut st, t, TNever) {
            popScope(mut st)
            return t, v, nil
        }
        name := strCat(mut st, strLit(mut st, "$interp"), decimal(mut st, st.ninterp))
        st.ninterp = st.ninterp + 1
        bindName(mut st, name, t, v, false, tok)?
        hv1 := node(mut st, ast.EIdent, tokOf(mut st, h), name, 0, 0, 0)
        hset(mut st, ids + 1 + i, hv1)
        i += 1
    }
    mut acc := -1
    mut k := 0
    while k < llen(mut st, lits) {
        text := lat(mut st, lits, k)
        if hget(mut st, text) > 0 {
            acc = interpAppend(mut st, acc, node(mut st, ast.EStrlit, tok, text, 0, 0, 0), tok)
        }
        if k == nh {
            k = llen(mut st, lits)
        } else {
            id := lat(mut st, ids, k)
            l := lookup(mut st, hget(mut st, id + NA))
            t := hget(mut st, l + 3)
            mut piece := id
            if isTag(mut st, t, TInt) {
                base := node(mut st, ast.EIdent, tok, strLit(mut st, "$strings"), 0, 0, 0)
                callee := node(mut st, ast.ESelector, tok, base, strLit(mut st, "Itoa"), 0, 0)
                piece = node(mut st, ast.ECall, tok, callee, list1(mut st, id), 0, 0)
            } else if isTag(mut st, t, TBool) {
                tb := node(mut st, ast.KBlock, tok, list1(mut st, node(mut st, ast.SExpr, tok, node(mut st, ast.EStrlit, tok, strLit(mut st, "true"), 0, 0, 0), 0, 0, 0)), 0, 0, 0)
                fb := node(mut st, ast.EBlock, tok, list1(mut st, node(mut st, ast.SExpr, tok, node(mut st, ast.EStrlit, tok, strLit(mut st, "false"), 0, 0, 0), 0, 0, 0)), 0, 0, 0)
                piece = node(mut st, ast.EIf, tok, id, tb, fb, 0)
            } else if !isString(mut st, t) {
                popScope(mut st)
                return 0, 0, LowerFail{k: KMismatch, tok: tok}
            }
            acc = interpAppend(mut st, acc, piece, tok)
            k += 1
        }
    }
    if acc < 0 {
        acc = node(mut st, ast.EStrlit, tok, strLit(mut st, ""), 0, 0, 0)
    }
    rt, rv := expr(mut st, acc)?
    popScope(mut st)
    return rt, rv, nil
}

// interpAppend は連鎖の末尾に 1 片足す
func interpAppend(st mut St, acc int, piece int, tok int) int {
    if acc < 0 {
        return piece
    }
    return node(mut st, ast.EBinary, tok, lexer.Plus, acc, piece, 0)
}

// ── 呼び出し ──

func callArgs(st mut St, callee0 int, args int, tok int) (int, error?) {
    // 明示の型引数 `f[T](...)`（index + call と同形。型名の index をここで型適用として読む）
    mut explicit := -1
    mut callee := callee0
    if kindOf(mut st, callee0) == ast.EIndex {
        ix := hget(mut st, callee0 + NB)
        if kindOf(mut st, ix) == ast.EIdent {
            explicit = node(mut st, ast.TName, tokOf(mut st, ix), hget(mut st, ix + NA), 0, 0, 0)
            callee = hget(mut st, callee0 + NA)
        } else if kindOf(mut st, ix) == ast.ESelector && kindOf(mut st, hget(mut st, ix + NA)) == ast.EIdent {
            bn := strCat(mut st, strCat(mut st, hget(mut st, hget(mut st, ix + NA) + NA), strLit(mut st, ".")), hget(mut st, ix + NB))
            explicit = node(mut st, ast.TName, tokOf(mut st, ix), bn, 0, 0, 0)
            callee = hget(mut st, callee0 + NA)
        }
    }
    ck := kindOf(mut st, callee)
    mut pk := st.curPkg
    mut fi := -1
    if ck == ast.EIdent {
        name := hget(mut st, callee + NA)
        if strIs(mut st, name, "println") {
            return printlnCall(mut st, args, tok)
        }
        br0 := builtin(mut st, name, args, tok)?
        if br0 != -2 {
            return br0, nil
        }
        l := lookup(mut st, name)
        if l >= 0 {
            if hget(mut st, l + 2) == LClosure {
                return lambdaCall(mut st, hget(mut st, l + 4), args, tok)
            }
            if isTag(mut st, hget(mut st, l + 3), TFnv) {
                return callIndirect0(mut st, callee, args, tok)
            }
            return 0, LowerFail{k: KUnsupported, tok: tok}
        }
        fi = findFnIn(mut st, pk, name, 0, hget(mut st, name))
    } else if ck == ast.ESelector {
        base := hget(mut st, callee + NA)
        field := hget(mut st, callee + NB)
        // pkg.F（import の参照名）。base が import の参照名でなければ値（関数型フィールド）の呼び出し
        if kindOf(mut st, base) != ast.EIdent || lookup(mut st, hget(mut st, base + NA)) >= 0 {
            return callIndirect0(mut st, callee, args, tok)
        }
        bn := hget(mut st, base + NA)
        ip := importOf(mut st, pk, bn, 0, hget(mut st, bn))
        if ip < 0 {
            return callIndirect0(mut st, callee, args, tok)
        }
        if hget(mut st, field) == 0 || hget(mut st, field + 1) < 65 || hget(mut st, field + 1) > 90 {
            return 0, LowerFail{k: KUndefined, tok: tok}
        }
        pk = ip
        fi = findFnIn(mut st, pk, field, 0, hget(mut st, field))
    } else {
        return 0, LowerFail{k: KUnsupported, tok: tok}
    }
    if fi < 0 {
        return 0, LowerFail{k: KUndefined, tok: tok}
    }
    if llen(mut st, fnTParams(mut st, fi)) > 0 {
        return genericCall(mut st, fi, explicit, args, tok)
    }
    if explicit >= 0 {
        return 0, LowerFail{k: KMismatch, tok: tok}
    }
    if fnExpands(mut st, fi) && !fnTransparent(mut st, fi) {
        params, results := sigIn(mut st, fnNode(mut st, fi), pk, -1)?
        return inlineCall(mut st, fnNode(mut st, fi), pk, params, results, args, tok, -1)
    }
    info := funcByKey(mut st, fi)?
    if llen(mut st, args) != llen(mut st, infoAt(mut st, info).params) {
        return 0, LowerFail{k: KMismatch, tok: tok}
    }
    return emitCall(mut st, infoAt(mut st, info).ir, -1, infoAt(mut st, info).params, infoAt(mut st, info).results, args, tok, fnNode(mut st, fi))
}

// callIndirect0 は関数値（callee の値）の間接呼び出し。呼び出し規約は直接呼び出しと同じ。関数値を先に評価する
func callIndirect0(st mut St, callee int, args int, tok int) (int, error?) {
    ft0, fv := expr(mut st, callee)?
    if isTag(mut st, ft0, TNever) {
        return -1, nil
    }
    if !isTag(mut st, ft0, TFnv) {
        return 0, LowerFail{k: KMismatch, tok: tok}
    }
    ft := hget(mut st, ft0 + 1)
    if llen(mut st, hget(mut st, ft)) != llen(mut st, args) {
        return 0, LowerFail{k: KMismatch, tok: tok}
    }
    return emitCall(mut st, -1, fv, hget(mut st, ft), hget(mut st, ft + 1), args, tok, -1)
}

// emitCall は呼び出し（irf >= 0 は直接、でなければ関数値 fv の間接）。decl: 直接呼び出しの宣言の節（mut 仮引数の位置 — 関数値は -1）
func emitCall(st mut St, irf int, fv int, params int, results int, args int, tok int, fi int) (int, error?) {
    sret := sretOf(mut st, results)
    np := llen(mut st, params)
    mut total := if sret { 1 } else { 0 }
    mut i := 0
    while i < np {
        total += if isMutParam(mut st, fi, i) { 1 } else { tWords(mut st, lat(mut st, params, i)) }
        i += 1
    }
    argl := listN(mut st, total)
    mut k := 0
    mut sp := -1
    if sret {
        mut rw := 0
        i = 0
        while i < llen(mut st, results) {
            rw += tWords(mut st, lat(mut st, results, i))
            i += 1
        }
        // 結果スロットのアドレスは第 0 引数（スロットは入口で取るので先に作ってよい）
        sp = newSlotAddr(mut st, if rw > 1 { rw } else { 1 })
        hset(mut st, argl + 1, sp)
        k = 1
    }
    i = 0
    while i < np {
        pt := lat(mut st, params, i)
        if isMutParam(mut st, fi, i) {
            // 呼び手のセルのアドレス（mut 仮引数を転送するときは受け取ったアドレスそのもの — 同じセル）
            l := mutArgCell(mut st, lat(mut st, args, i), tok)?
            if !tEql(mut st, hget(mut st, l + 3), pt) {
                return 0, LowerFail{k: KMismatch, tok: tok}
            }
            hset(mut st, argl + 1 + k, hget(mut st, l + 4))
            k += 1
            i += 1
            continue
        }
        t, v := exprExpecting(mut st, lat(mut st, args, i), pt, tok)?
        if isTag(mut st, t, TNever) {
            return -1, nil
        }
        // アグリゲートは評価した直後に語へ展開する
        if isScalar(mut st, t) {
            hset(mut st, argl + 1 + k, v)
            k += 1
        } else {
            mut w := 0
            while w < tWords(mut st, t) {
                hv1 := load(mut st, v, w)
                hset(mut st, argl + 1 + k, hv1)
                k += 1
                w += 1
            }
        }
        i += 1
    }
    nr := llen(mut st, results)
    r := if irf >= 0 { call(mut st, irf, argl) } else { callIndirect(mut st, fv, argl, if sret || nr == 0 { -1 } else { TyI64 }) }
    out := listN(mut st, nr * 2)
    hset(mut st, out, nr)
    if sret {
        mut off := 0
        i = 0
        while i < nr {
            t := lat(mut st, results, i)
            hset(mut st, out + 1 + i * 2, t)
            hv2 := loadVal(mut st, sp, off, t)
            hset(mut st, out + 2 + i * 2, hv2)
            off += tWords(mut st, t)
            i += 1
        }
    } else if nr == 1 {
        hset(mut st, out + 1, lat(mut st, results, 0))
        hset(mut st, out + 2, r)
    }
    return out, nil
}

// printlnCall は全引数を先に評価してから書く（Go の順）。空白区切り + 改行
func printlnCall(st mut St, args int, tok int) (int, error?) {
    n := llen(mut st, args)
    vs := listN(mut st, n * 2)
    mut i := 0
    while i < n {
        t, v := expr(mut st, lat(mut st, args, i))?
        if isTag(mut st, t, TNever) {
            return -1, nil
        }
        if !isTag(mut st, t, TInt) && !isTag(mut st, t, TBool) && !isString(mut st, t) {
            return 0, LowerFail{k: KUnsupported, tok: tok}
        }
        hset(mut st, vs + 1 + i * 2, t)
        hset(mut st, vs + 2 + i * 2, v)
        i += 1
    }
    i = 0
    while i < n {
        t := hget(mut st, vs + 1 + i * 2)
        v := hget(mut st, vs + 2 + i * 2)
        if isString(mut st, t) {
            call(mut st, st.rtPstr, list1(mut st, v))
        } else if isTag(mut st, t, TInt) {
            call(mut st, st.rtPint, list1(mut st, v))
        } else {
            t_b := newBlock(mut st)
            f_b := newBlock(mut st)
            done := newBlock(mut st)
            condbr(mut st, v, t_b, -1, f_b, -1)
            setCur(mut st, t_b)
            printChars(mut st, "true")
            br(mut st, done, -1)
            setCur(mut st, f_b)
            printChars(mut st, "false")
            br(mut st, done, -1)
            setCur(mut st, done)
        }
        if i + 1 < n {
            printChars(mut st, " ")
        }
        i += 1
    }
    printChars(mut st, "\n")
    return list0(mut st), nil
}

func printChars(st mut St, w string) {
    b := bytes(w)
    mut i := 0
    while i < len(b) {
        call(mut st, st.rtPchar, list1(mut st, iconst(mut st, b[i])))
        i += 1
    }
}

// ── 型の突き合わせ ──

func want(st mut St, t int, w int, tok int) error? {
    if !tEql(mut st, t, w) {
        return LowerFail{k: KMismatch, tok: tok}
    }
    return nil
}

// coerce は値を期待型 w に合わせる: T? の期待に対して nil はタグ 0 の実体化、ペイロード型の値はタグ 1 で包む（暗黙 some）。他は型一致
func coerce(st mut St, t int, v int, w int, tok int) (int, int, error?) {
    if tEql(mut st, t, w) || isTag(mut st, t, TNever) {
        return t, v, nil
    }
    if isTag(mut st, w, TOpt) {
        if isTag(mut st, t, TNil) {
            p := newAgg(mut st, w)
            store(mut st, p, 0, iconst(mut st, 0))
            return w, p, nil
        }
        mut it := t
        mut iv := v
        if isErr(mut st, hget(mut st, w + 1)) && isLabel(mut st, t) {
            a1, b1 := labelToErr(mut st, t, v)?
            it = a1
            iv = b1
        }
        if tEql(mut st, it, hget(mut st, w + 1)) {
            p := newAgg(mut st, w)
            store(mut st, p, 0, iconst(mut st, 1))
            storeVal(mut st, p, 1, it, iv)
            return w, p, nil
        }
    }
    if isErr(mut st, w) && isLabel(mut st, t) {
        return labelToErr(mut st, t, v)
    }
    return 0, 0, LowerFail{k: KMismatch, tok: tok}
}

// exprExpecting は期待型つきの式評価（sink: return・引数・フィールド・代入）。T? を期待する if 式は腕ごとに合わせる
func exprExpecting(st mut St, e int, w int, tok int) (int, int, error?) {
    k := kindOf(mut st, e)
    if k == ast.ELambda {
        if isTag(mut st, w, TFnv) {
            return liftLambda(mut st, e, hget(mut st, w + 1), tok)
        }
        return 0, 0, LowerFail{k: KUnsupported, tok: tok}
    }
    if k == ast.EIf && isTag(mut st, w, TOpt) && hget(mut st, e + NC) >= 0 {
        t, v := ifExpr(mut st, e, w)?
        return coerce(mut st, t, v, w, tok)
    }
    t, v := expr(mut st, e)?
    return coerce(mut st, t, v, w, tok)
}

// ── 式 ──

func expr(st mut St, e int) (int, int, error?) {
    k := kindOf(mut st, e)
    tok := tokOf(mut st, e)
    if k == ast.EInt {
        return tInt(mut st), iconst(mut st, hget(mut st, e + NA)), nil
    }
    if k == ast.ENil {
        return tNil(mut st), 0, nil
    }
    if k == ast.EIdent {
        return ident(mut st, e)
    }
    if k == ast.EBinary {
        return binary(mut st, e)
    }
    if k == ast.EUnary {
        return unary(mut st, e)
    }
    if k == EVal {
        return hget(mut st, e + NA), hget(mut st, e + NB), nil
    }
    if k == ast.EInterp {
        return interpExpr(mut st, e)
    }
    if k == ast.ETry {
        r := tryResults(mut st, e)?
        if r < 0 {
            return tNever(mut st), 0, nil
        }
        if hget(mut st, r) == 0 {
            return tNone(mut st), 0, nil
        }
        if hget(mut st, r) > 1 {
            return 0, 0, LowerFail{k: KMismatch, tok: tok}
        }
        return hget(mut st, r + 1), hget(mut st, r + 2), nil
    }
    if k == ast.ECall || k == ast.EPipe {
        r := evalMulti(mut st, e)?
        if r < 0 {
            return tNever(mut st), 0, nil
        }
        if hget(mut st, r) == 0 {
            return tNone(mut st), 0, nil
        }
        if hget(mut st, r) > 1 {
            return 0, 0, LowerFail{k: KMismatch, tok: tok}
        }
        return hget(mut st, r + 1), hget(mut st, r + 2), nil
    }
    if k == ast.EComposite {
        return composite(mut st, e)
    }
    if k == ast.ESelector {
        return selector(mut st, e)
    }
    if k == ast.EIf {
        return ifExpr(mut st, e, -1)
    }
    if k == ast.ESwitch {
        return switchExpr(mut st, e)
    }
    if k == ast.EBlock {
        return blockValue(mut st, hget(mut st, e + NA), tok)
    }
    if k == ast.EStrlit {
        return mkString(mut st), strlit(mut st, hget(mut st, e + NA)), nil
    }
    if k == ast.ESlicelit {
        return slicelit(mut st, e)
    }
    if k == ast.EMaplit {
        return maplit(mut st, e)
    }
    if k == ast.EIndex {
        return index(mut st, e)
    }
    if k == ast.ESlice3 {
        return slice3(mut st, e)
    }
    return 0, 0, LowerFail{k: KUnsupported, tok: tok}
}

func ident(st mut St, e int) (int, int, error?) {
    name := hget(mut st, e + NA)
    tok := tokOf(mut st, e)
    if strIs(mut st, name, "_") {
        return 0, 0, LowerFail{k: KUnsupported, tok: tok}
    }
    l := lookup(mut st, name)
    if l >= 0 {
        t := hget(mut st, l + 3)
        if hget(mut st, l + 2) == LClosure {
            return 0, 0, LowerFail{k: KMismatch, tok: tok}
        }
        if hget(mut st, l + 2) == LCell && isScalar(mut st, t) {
            return t, load(mut st, hget(mut st, l + 4), 0), nil
        }
        return t, hget(mut st, l + 4), nil
    }
    if strIs(mut st, name, "true") {
        return tBool(mut st), iconst(mut st, 1), nil
    }
    if strIs(mut st, name, "false") {
        return tBool(mut st), iconst(mut st, 0), nil
    }
    return constOrFn(mut st, st.curPkg, name, tok)
}

// constOrFn はトップレベル const（int はロード時に畳み込み済み）か名前付き関数の参照（関数値 — 未対応）
func constOrFn(st mut St, pk int, name int, tok int) (int, int, error?) {
    c := findConIn(mut st, pk, name, 0, hget(mut st, name))
    if c >= 0 {
        if conDict(mut st, c) {
            return dictConst(mut st, c, pk)
        }
        if !conHas(mut st, c) {
            return 0, 0, LowerFail{k: KUnsupported, tok: tok}
        }
        return tInt(mut st), iconst(mut st, conValue(mut st, c)), nil
    }
    fi := findFnIn(mut st, pk, name, 0, hget(mut st, name))
    if fi >= 0 {
        // 名前付き関数の参照 = 関数値（展開される関数・ジェネリック関数は値にならない）
        if fnExpands(mut st, fi) || llen(mut st, fnTParams(mut st, fi)) > 0 {
            return 0, 0, LowerFail{k: KUnsupported, tok: tok}
        }
        info := funcByKey(mut st, fi)?
        t, v := fnValue(mut st, info)
        return t, v, nil
    }
    return 0, 0, LowerFail{k: KUndefined, tok: tok}
}

// selector は `x.f`（struct のフィールド）/ `pkg.N`（修飾 const）
func selector(st mut St, e int) (int, int, error?) {
    base := hget(mut st, e + NA)
    field := hget(mut st, e + NB)
    tok := tokOf(mut st, e)
    if kindOf(mut st, base) == ast.EIdent && lookup(mut st, hget(mut st, base + NA)) < 0 {
        bn := hget(mut st, base + NA)
        ip := importOf(mut st, st.curPkg, bn, 0, hget(mut st, bn))
        if ip >= 0 {
            if hget(mut st, field) == 0 || hget(mut st, field + 1) < 65 || hget(mut st, field + 1) > 90 {
                return 0, 0, LowerFail{k: KUndefined, tok: tok}
            }
            return constOrFn(mut st, ip, field, tok)
        }
    }
    bt, bv := expr(mut st, base)?
    if isTag(mut st, bt, TNever) {
        return bt, bv, nil
    }
    f := fieldOf(mut st, bt, field, tok)?
    t := hget(mut st, f + 1)
    return t, loadVal(mut st, bv, hget(mut st, f + 2), t), nil
}

// variantOf は型の名前（"N" か "ref.N"）の union の variant (UnionInfo, 添字)。無ければ (-1, 0)
func variantOf(st mut St, pk int, name int) (int, int) {
    mut from := pk
    mut lo := 0
    dot := dotAt(mut st, name)
    if dot >= 0 {
        from = importOf(mut st, pk, name, 0, dot)
        lo = dot + 1
    }
    li := errLabelOf(mut st, pk, name)
    if li >= 0 {
        return errsInfo(mut st), li
    }
    mut x := st.types
    while x >= 0 {
        if hget(mut st, x) == TUnion && hget(mut st, x + SI_PKG) == from {
            dvs := hget(mut st, hget(mut st, hget(mut st, x + SI_DECL) + NC) + NA)
            mut i := 0
            while i < llen(mut st, dvs) {
                if strEqPart(mut st, hget(mut st, lat(mut st, dvs, i) + NA), name, lo, hget(mut st, name)) {
                    return x, i
                }
                i += 1
            }
        }
        x = hget(mut st, x + SI_NEXT)
    }
    return -1, 0
}

// composite はリテラル: 新しいスロットに位置か名前でフィールドを埋める。名前指定で省いたフィールドは 0。
// 型名が variant なら union 値（語 0 にタグ、ペイロードは語 1 から）。`T{}` はゼロ値
func composite(st mut St, e int) (int, int, error?) {
    tok := tokOf(mut st, e)
    pk := st.curPkg
    tn := hget(mut st, e + NA)
    mut t := -1
    mut fields := -1
    mut bs := 0
    mut tag := -1
    td := lookupTypeDecl(mut st, pk, tn)
    mut info := if td >= 0 { infoOf(mut st, td) } else { -1 }
    if llen(mut st, hget(mut st, e + NC)) > 0 {
        a1 := instStruct(mut st, pk, tn, hget(mut st, e + NC), tok)?
        info = a1
    }
    if info >= 0 && hget(mut st, info) == TStruct {
        layoutInfo(mut st, info)?
        t = hget(mut st, info + SI_TY)
        fields = hget(mut st, info + SI_FIELDS)
    } else {
        u, vi := variantOf(mut st, pk, tn)
        if u < 0 {
            return 0, 0, LowerFail{k: KUndefined, tok: tok}
        }
        layoutInfo(mut st, u)?
        t = hget(mut st, u + SI_TY)
        vr := lat(mut st, hget(mut st, u + SI_FIELDS), vi)
        fields = hget(mut st, vr + 2)
        bs = 1
        tag = hget(mut st, vr + 1)
    }
    els := hget(mut st, e + NB)
    n := llen(mut st, els)
    keyed := n > 0 && hget(mut st, lat(mut st, els, 0) + NA) >= 0
    mut i := 0
    while i < n {
        if (hget(mut st, lat(mut st, els, i) + NA) >= 0) != keyed {
            return 0, 0, LowerFail{k: KUnsupported, tok: tok}
        }
        i += 1
    }
    // 値を全部評価してから書く（評価中の式が同じ型のリテラルを作ってもよい）
    vs := listN(mut st, n * 3)
    if keyed {
        i = 0
        while i < n {
            mut j := 0
            while j < i {
                if strEq(mut st, hget(mut st, lat(mut st, els, j) + NA), hget(mut st, lat(mut st, els, i) + NA)) {
                    return 0, 0, LowerFail{k: KMismatch, tok: tok}
                }
                j += 1
            }
            i += 1
        }
        i = 0
        while i < n {
            el := lat(mut st, els, i)
            f := findField(mut st, fields, hget(mut st, el + NA))
            if f < 0 {
                return 0, 0, LowerFail{k: KUndefined, tok: tok}
            }
            vt, v0 := exprExpecting(mut st, hget(mut st, el + NB), hget(mut st, f + 1), tokOf(mut st, hget(mut st, el + NB)))?
            if isTag(mut st, vt, TNever) {
                return vt, v0, nil
            }
            v := copyVal(mut st, vt, v0)
            hset(mut st, vs + 1 + i * 3, vt)
            hset(mut st, vs + 2 + i * 3, v)
            hset(mut st, vs + 3 + i * 3, bs + hget(mut st, f + 2))
            i += 1
        }
    } else if n > 0 || llen(mut st, fields) == 0 {
        if n != llen(mut st, fields) {
            return 0, 0, LowerFail{k: KMismatch, tok: tok}
        }
        i = 0
        while i < n {
            el := lat(mut st, els, i)
            f := lat(mut st, fields, i)
            vt, v0 := exprExpecting(mut st, hget(mut st, el + NB), hget(mut st, f + 1), tokOf(mut st, hget(mut st, el + NB)))?
            if isTag(mut st, vt, TNever) {
                return vt, v0, nil
            }
            v := copyVal(mut st, vt, v0)
            hset(mut st, vs + 1 + i * 3, vt)
            hset(mut st, vs + 2 + i * 3, v)
            hset(mut st, vs + 3 + i * 3, bs + hget(mut st, f + 2))
            i += 1
        }
    } else {
        // ゼロ値リテラル `T{}`: int 0・bool false・T? は nil（タグ 0）・struct はフィールドごと
        i = 0
        while i < llen(mut st, fields) {
            requireZero(mut st, hget(mut st, lat(mut st, fields, i) + 1), tok)?
            i += 1
        }
    }
    p := newAgg(mut st, t)
    zero := iconst(mut st, 0)
    mut w := 0
    while w < tWords(mut st, t) {
        store(mut st, p, w, zero)
        w += 1
    }
    if tag >= 0 {
        store(mut st, p, 0, iconst(mut st, tag))
    }
    // `T{}` の slice / map フィールドは現在の region の先端を指す空ヘッダ
    if n == 0 {
        i = 0
        while i < llen(mut st, fields) {
            f := lat(mut st, fields, i)
            zeroFill(mut st, p, bs + hget(mut st, f + 2), hget(mut st, f + 1))
            i += 1
        }
    } else if keyed {
        // 名前つきで省いた欄もゼロ値（`T{}` と同じ — ゼロ値を持つ型に限る）。旧: 省いた slice / map の欄が空ヘッダにならず 0 語のまま残り、
        // 使うと実行時に落ちていた（reaudit round 6。int / bool の欄は 0 語がゼロ値なので IR は変わらない）
        i = 0
        while i < llen(mut st, fields) {
            f := lat(mut st, fields, i)
            mut named := false
            mut j := 0
            while j < n {
                if strEq(mut st, hget(mut st, lat(mut st, els, j) + NA), hget(mut st, f)) {
                    named = true
                }
                j += 1
            }
            if !named {
                requireZero(mut st, hget(mut st, f + 1), tok)?
                zeroFill(mut st, p, bs + hget(mut st, f + 2), hget(mut st, f + 1))
            }
            i += 1
        }
    }
    i = 0
    while i < n {
        storeVal(mut st, p, hget(mut st, vs + 3 + i * 3), hget(mut st, vs + 1 + i * 3), hget(mut st, vs + 2 + i * 3))
        i += 1
    }
    return t, p, nil
}

// requireZero はゼロ値を持つ型か
func requireZero(st mut St, t int, tok int) error? {
    k := hget(mut st, t)
    if k == TInt || k == TBool || k == TOpt || k == TSlice || k == TMap {
        return nil
    }
    if k == TStruct {
        fs := hget(mut st, hget(mut st, t + 1) + SI_FIELDS)
        mut i := 0
        while i < llen(mut st, fs) {
            requireZero(mut st, hget(mut st, lat(mut st, fs, i) + 1), tok)?
            i += 1
        }
        return nil
    }
    return LowerFail{k: KMismatch, tok: tok}
}

// ── 演算子 ──

func cmpOf(op int) int {
    if op == lexer.EqualEqual {
        return CEq
    }
    if op == lexer.BangEqual {
        return CNe
    }
    if op == lexer.Less {
        return CLt
    }
    if op == lexer.LessEqual {
        return CLe
    }
    if op == lexer.Greater {
        return CGt
    }
    if op == lexer.GreaterEqual {
        return CGe
    }
    return -1
}

func binary(st mut St, e int) (int, int, error?) {
    op := hget(mut st, e + NA)
    lhs := hget(mut st, e + NB)
    rhs := hget(mut st, e + NC)
    tok := tokOf(mut st, e)
    if op == lexer.AmpersandAmpersand || op == lexer.PipePipe {
        return shortCircuit(mut st, e)
    }
    // `x == nil` / `x != nil`: T? のタグ検査（語 0 が 0 なら nil）
    if (op == lexer.EqualEqual || op == lexer.BangEqual) && (kindOf(mut st, lhs) == ast.ENil || kindOf(mut st, rhs) == ast.ENil) {
        if kindOf(mut st, lhs) == ast.ENil && kindOf(mut st, rhs) == ast.ENil {
            return 0, 0, LowerFail{k: KMismatch, tok: tok}
        }
        st2, sv := expr(mut st, if kindOf(mut st, lhs) == ast.ENil { rhs } else { lhs })?
        if isTag(mut st, st2, TNever) {
            return st2, sv, nil
        }
        if !isTag(mut st, st2, TOpt) {
            return 0, 0, LowerFail{k: KMismatch, tok: tok}
        }
        tagv := load(mut st, sv, 0)
        return tBool(mut st), cmp(mut st, if op == lexer.EqualEqual { CEq } else { CNe }, tagv, iconst(mut st, 0)), nil
    }
    lt, lv := expr(mut st, lhs)?
    if isTag(mut st, lt, TNever) {
        return lt, lv, nil
    }
    // string の == / != / + はセル列の演算（language.md 21 節）
    if isString(mut st, lt) && (op == lexer.EqualEqual || op == lexer.BangEqual || op == lexer.Plus) {
        return stringBinary(mut st, e, lt, lv)
    }
    rt, rv := expr(mut st, rhs)?
    if isTag(mut st, rt, TNever) {
        return rt, rv, nil
    }
    c := cmpOf(op)
    if c >= 0 {
        // == / != は int と bool、順序比較は int のみ
        if !tEql(mut st, lt, rt) || (!isTag(mut st, lt, TInt) && !(isTag(mut st, lt, TBool) && (c == CEq || c == CNe))) {
            return 0, 0, LowerFail{k: KMismatch, tok: tok}
        }
        return tBool(mut st), cmp(mut st, c, lv, rv), nil
    }
    want(mut st, lt, tInt(mut st), tok)?
    want(mut st, rt, tInt(mut st), tok)?
    v := arith(mut st, op, lv, rv, tok)?
    return tInt(mut st), v, nil
}

// arith は int の二項演算（二項式と複合代入の共通部）
func arith(st mut St, op int, x int, y int, tok int) (int, error?) {
    mut b := -1
    if op == lexer.Plus {
        b = BAdd
    } else if op == lexer.Minus {
        b = BSub
    } else if op == lexer.Star {
        b = BMul
    } else if op == lexer.Slash {
        b = BDiv
    } else if op == lexer.Percent {
        b = BRem
    } else if op == lexer.Ampersand {
        b = BAnd
    } else if op == lexer.Pipe {
        b = BOr
    } else if op == lexer.Caret {
        b = BXor
    } else if op == lexer.Shl || op == lexer.Shr {
        return shift(mut st, op == lexer.Shl, x, y), nil
    } else {
        return 0, LowerFail{k: KUnsupported, tok: tok}
    }
    return bin(mut st, b, x, y), nil
}

// shift（Go 準拠）: 負の量は panic（exit 101）、量 ≥ 64 は << = 0・>> = 63 bit に畳む
func shift(st mut St, left bool, x int, n int) int {
    neg_b := newBlock(mut st)
    ok_b := newBlock(mut st)
    join := newBlock(mut st)
    res := param(mut st, join, TyI64)
    condbr(mut st, cmp(mut st, CLt, n, iconst(mut st, 0)), neg_b, -1, ok_b, -1)
    setCur(mut st, neg_b)
    exit(mut st, PANIC)
    setCur(mut st, ok_b)
    over_b := newBlock(mut st)
    in_b := newBlock(mut st)
    condbr(mut st, cmp(mut st, CGt, n, iconst(mut st, 63)), over_b, -1, in_b, -1)
    setCur(mut st, over_b)
    over_v := if left { iconst(mut st, 0) } else { bin(mut st, BSar, x, iconst(mut st, 63)) }
    br(mut st, join, list1(mut st, over_v))
    setCur(mut st, in_b)
    br(mut st, join, list1(mut st, bin(mut st, if left { BShl } else { BSar }, x, n)))
    setCur(mut st, join)
    return res
}

// shortCircuit は a && b / a || b: 右辺は左辺で決まらないときだけ評価する
func shortCircuit(st mut St, e int) (int, int, error?) {
    op := hget(mut st, e + NA)
    tok := tokOf(mut st, e)
    lt, lv := expr(mut st, hget(mut st, e + NB))?
    if isTag(mut st, lt, TNever) {
        return lt, lv, nil
    }
    want(mut st, lt, tBool(mut st), tok)?
    rhs := newBlock(mut st)
    join := newBlock(mut st)
    res := param(mut st, join, TyI64)
    if op == lexer.AmpersandAmpersand {
        condbr(mut st, lv, rhs, -1, join, list1(mut st, lv))
    } else {
        condbr(mut st, lv, join, list1(mut st, lv), rhs, -1)
    }
    setCur(mut st, rhs)
    rt, rv := expr(mut st, hget(mut st, e + NC))?
    if !isTag(mut st, rt, TNever) {
        want(mut st, rt, tBool(mut st), tok)?
        br(mut st, join, list1(mut st, rv))
    }
    setCur(mut st, join)
    return tBool(mut st), res, nil
}

func unary(st mut St, e int) (int, int, error?) {
    op := hget(mut st, e + NA)
    tok := tokOf(mut st, e)
    xt, xv := expr(mut st, hget(mut st, e + NB))?
    if isTag(mut st, xt, TNever) {
        return xt, xv, nil
    }
    if op == lexer.Minus {
        want(mut st, xt, tInt(mut st), tok)?
        return tInt(mut st), bin(mut st, BSub, iconst(mut st, 0), xv), nil
    }
    if op == lexer.Caret {
        want(mut st, xt, tInt(mut st), tok)?
        return tInt(mut st), bin(mut st, BXor, xv, iconst(mut st, -1)), nil
    }
    if op == lexer.Bang {
        want(mut st, xt, tBool(mut st), tok)?
        return tBool(mut st), bin(mut st, BXor, xv, iconst(mut st, 1)), nil
    }
    return 0, 0, LowerFail{k: KUnsupported, tok: tok}
}

// ── 腕の合流 ──

// joinType は腕の型を合わせる（acc = -1 は未定）: 一致か片方 never、片方が値なしなら値なし
func joinType(st mut St, acc int, t int, tok int) (int, error?) {
    if acc < 0 || tEql(mut st, acc, t) {
        return if acc < 0 { t } else { acc }, nil
    }
    if isTag(mut st, acc, TNever) {
        return t, nil
    }
    if isTag(mut st, t, TNever) {
        return acc, nil
    }
    if isTag(mut st, acc, TNone) || isTag(mut st, t, TNone) {
        return tNone(mut st), nil
    }
    return 0, LowerFail{k: KMismatch, tok: tok}
}

// 腕の末尾の列 = [n, (ブロック, 型, 値)…]（容量は呼び手が決める）
func endsNew(st mut St, cap int) int {
    l := listN(mut st, cap * 3)
    hset(mut st, l, 0)
    return l
}

func endsAdd(st mut St, l int, blk int, t int, v int) {
    n := hget(mut st, l)
    hset(mut st, l + 1 + n * 3, blk)
    hset(mut st, l + 2 + n * 3, t)
    hset(mut st, l + 3 + n * 3, v)
    hset(mut st, l, n + 1)
}

// joinArms は腕の末尾を合流させる。値のある型ならブロック引数で受ける（アグリゲートはアドレス）
func joinArms(st mut St, ends int, t int) (int, int) {
    n := hget(mut st, ends)
    if isTag(mut st, t, TNever) || n == 0 {
        setCur(mut st, -1)
        return tNever(mut st), 0
    }
    join := newBlock(mut st)
    ty := irTy(mut st, t)
    res := if ty >= 0 { param(mut st, join, ty) } else { 0 }
    mut i := 0
    while i < n {
        setCur(mut st, hget(mut st, ends + 1 + i * 3))
        if ty >= 0 {
            br(mut st, join, list1(mut st, hget(mut st, ends + 3 + i * 3)))
        } else {
            br(mut st, join, -1)
        }
        i += 1
    }
    setCur(mut st, join)
    if ty >= 0 {
        return t, res
    }
    return tNone(mut st), 0
}

// nilTest は条件が `x != nil` / `x == nil`（x は T? の名前）なら (名前, then 側が値ありか)。でなければ (-1, false)
func nilTest(st mut St, c int) (int, bool) {
    if kindOf(mut st, c) != ast.EBinary {
        return -1, false
    }
    op := hget(mut st, c + NA)
    if op != lexer.EqualEqual && op != lexer.BangEqual {
        return -1, false
    }
    lhs := hget(mut st, c + NB)
    rhs := hget(mut st, c + NC)
    mut side := -1
    if kindOf(mut st, lhs) == ast.ENil {
        side = rhs
    } else if kindOf(mut st, rhs) == ast.ENil {
        side = lhs
    }
    if side < 0 || kindOf(mut st, side) != ast.EIdent {
        return -1, false
    }
    l := lookup(mut st, hget(mut st, side + NA))
    if l < 0 || !isTag(mut st, hget(mut st, l + 3), TOpt) {
        return -1, false
    }
    return hget(mut st, side + NA), op == lexer.BangEqual
}

// narrowedArm は絞り込みつきの腕: name（T?）のペイロードのコピーを同名で再束縛して本体を実行する
func narrowedArm(st mut St, name int, l int) (int, int, error?) {
    en := lookup(mut st, name)
    o := hget(mut st, en + 3)
    pt := hget(mut st, o + 1)
    payload := copyVal(mut st, pt, loadVal(mut st, hget(mut st, en + 4), 1, pt))
    pushScope(mut st)
    declare(mut st, name, LVal, pt, payload)
    t, v := armTail(mut st, l)?
    popScope(mut st)
    return t, v, nil
}

// ifExpr は if 式 / 文。then は腕（region 透過）、else はブロックなら腕・else if なら式。else 無しは none。
// w（T? の期待、無ければ -1）があれば腕ごとに合わせてから合流する
func ifExpr(st mut St, e int, w int) (int, int, error?) {
    tok := tokOf(mut st, e)
    nname, some_then := nilTest(mut st, hget(mut st, e + NA))
    ct, cv := expr(mut st, hget(mut st, e + NA))?
    if isTag(mut st, ct, TNever) {
        return ct, cv, nil
    }
    want(mut st, ct, tBool(mut st), tok)?
    then_b := newBlock(mut st)
    else_b := newBlock(mut st)
    condbr(mut st, cv, then_b, -1, else_b, -1)
    ends := endsNew(mut st, 2)
    mut t := -1
    el := hget(mut st, e + NC)
    mut arm := 0
    while arm < 2 {
        setCur(mut st, if arm == 0 { then_b } else { else_b })
        narrow := nname >= 0 && some_then == (arm == 0)
        mut vt := -1
        mut vv := 0
        if arm == 0 {
            ss := hget(mut st, hget(mut st, e + NB) + NA)
            if narrow {
                a1, b1 := narrowedArm(mut st, nname, ss)?
                vt = a1
                vv = b1
            } else {
                a2, b2 := armValue(mut st, ss)?
                vt = a2
                vv = b2
            }
        } else if el >= 0 {
            if kindOf(mut st, el) != ast.EBlock {
                if w >= 0 {
                    a3, b3 := exprExpecting(mut st, el, w, tok)?
                    vt = a3
                    vv = b3
                } else {
                    a4, b4 := expr(mut st, el)?
                    vt = a4
                    vv = b4
                }
            } else if narrow {
                a5, b5 := narrowedArm(mut st, nname, hget(mut st, el + NA))?
                vt = a5
                vv = b5
            } else {
                a6, b6 := armValue(mut st, hget(mut st, el + NA))?
                vt = a6
                vv = b6
            }
        } else {
            vt = tNone(mut st)
        }
        if w >= 0 && cur(mut st) >= 0 && !isTag(mut st, vt, TNone) {
            a7, b7 := coerce(mut st, vt, vv, w, tok)?
            vt = a7
            vv = b7
        }
        t = joinType(mut st, t, if cur(mut st) < 0 { tNever(mut st) } else { vt }, tok)?
        if cur(mut st) >= 0 {
            endsAdd(mut st, ends, cur(mut st), vt, vv)
        }
        arm += 1
    }
    if el < 0 {
        t = if isTag(mut st, t, TNever) { t } else { tNone(mut st) }
    }
    rt, rv := joinArms(mut st, ends, t)
    return rt, rv, nil
}
