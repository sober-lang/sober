package desugar

// 値の位置の閉包（クロージャの波 工程 3b — language.md 25 節 2026-10-17・report-742 / 744 / 745）: 値化可能な named fn type の struct の欄
// （+ その option）に置いた値は、常に閉包の組 `pair (fnref d) env`（捕捉なし = env が int 0）で表す — bare fnref を置かない（呼び出し点が
// 宣言だけで「閉包の呼び出し」と分かるように）。持ち上げた Def の仮引数は `pair env 元の引数鎖`、呼び出しは
// `let f := 閉包 in callv (fst f) (pair (snd f) 引数鎖)`（コア・Lean 無変更 — fnref + pair + callv の既存の語彙。report-744 の写経 ec1〜ec4）。
// 型 = `prod (fn (prod U P) R) U`。U = named fn type F の env の型 = プログラム中で F の値の位置に作った閉包の env の形（捕捉の型の鎖・
// 捕捉なしは int）の閉じた union（工程 4 B1 — 組み込み error と同じ「世界を閉じる」形。形は重複なし・1 種類なら union を作らずその形・
// 0 種類なら int）。作成点は自分の形の variant へ inl / inr で包み、持ち上げた Def は case で自分の形を取り出す（他の腕は unreach）。
// 形は本体の脱糖の前に要る（Def の署名が U を含む）ので、入口が前走り（shapesFor — 同じ脱糖を 1 回走らせて形だけ持ち帰る）で集める。
// 値の位置の判定は loader（loader.FnValDecl — check と build が同じ判定を読む）、捕捉の名前の列も loader の表（Program.cap_*）を読む

import "diag"
import "ast"
import "loader"
import "std/iter"
import "std/table"

// fnValDeclNode は型宣言の節 decl が値化可能な named fn type か（loader の判定 — 木の節だけ。合成の節は false）
func fnValDeclNode(st mut S, decl NodeRef) bool {
    if decl == NodeRef(ERRS) || !isTreeNode(int(decl)) || kindN(mut st, nC(nodeOf(mut st, decl))) != ast.BFunc {
        return false
    }
    return loader.FnValDecl(st.fvcx, refFile(int(decl)), refIdx(int(decl)))
}

// fnValDr は型宣言の参照 dr（[decl, pkg, tenv]）が値化可能な named fn type か
func fnValDr(st mut S, dr int) bool {
    return dr >= 0 && fnValDeclNode(mut st, hgetN(mut st, dr))
}

// closTyOf は値化可能な named fn type の宣言 decl（package pk）の閉包の型 `prod (fn (prod int P) R) int`
func closTyOf(st mut S, pk int, decl NodeRef, at NodeRef, fuel int) (TyRef, error?) {
    body := nC(nodeOf(mut st, decl))
    return closTyOfKey(mut st, pk, body, decl, at, fuel)
}

// closTyOfKey は関数型の形の節 sig（BFunc / TFunc — a = 仮引数・b = 結果）の閉包の型。env の形の鍵 key = named fn type の宣言か
// 借りの位置の型式の節（(α-L0) — 借りの閉包の env は借りの位置ごとの閉じた union）。仮引数の匿名の関数型は借りの閉包の型
func closTyOfKey(st mut S, pk int, sig NodeRef, key NodeRef, at NodeRef, fuel int) (TyRef, error?) {
    pl := lA(nodeOf(mut st, sig))
    ps := ListRef(listN(mut st, lenL(mut st, pl)))
    for i <- iter.Range(0, lenL(mut st, pl)) {
        pe := latN(mut st, pl, i)
        pt := if kindN(mut st, pe) == ast.TFunc { closTyOfKey(mut st, pk, pe, brwKey(mut st, pk, pe, at, fuel - 1, false)?, at, fuel - 1)? } else { tyOf(mut st, pk, pe, at, fuel - 1)? }
        hsetTy(mut st, int(ps) + 1 + i, pt)
    }
    rl := lB(nodeOf(mut st, sig))
    rs := ListRef(listN(mut st, lenL(mut st, rl)))
    for i <- iter.Range(0, lenL(mut st, rl)) {
        rt := tyOf(mut st, pk, latN(mut st, rl, i), at, fuel - 1)?
        hsetTy(mut st, int(rs) + 1 + i, retTy(mut st, rt))
    }
    u := envU(mut st, key)
    p := tProd(mut st, u, tyChain(mut st, ps))
    return tProd(mut st, tFn(mut st, p, tyChain(mut st, rs)), u), nil
}

// brwKey は借りの位置の型式 te（匿名の関数型・package pk）の env の鍵: 関数型の構造（核の型 `fn P R` — hash-cons で同一）が同じ借りの位置は
// 最初に出会った型式の節を共有する（構造の鍵 — 別の F の借りの位置へ借りの値を転送できる。lower の構造の鍵と揃える — 工程 5c）。
// af = 値の位置の匿名の関数型の欄（工程 5d）の鍵: 欄どうしで構造の鍵を共有し、借りの位置とは分ける（2026-10-22 ユーザー裁定・report-1038 (c) 案 A —
// 借りの mut の捕捉〔(α-L1)〕の形が欄の型の env の union に入って、欄を持つ struct が遠くの mut の借りで mutFree でなくなる遠隔作用を断つ。
// 欄の閉包の値を借りの位置へ渡す形は loader の η が借りのラムダに写す — fnValAnonArgScan）
func brwKey(st mut S, pk int, te NodeRef, at NodeRef, fuel int, af bool) (NodeRef, error?) {
    pl := lA(nodeOf(mut st, te))
    ps := ListRef(listN(mut st, lenL(mut st, pl)))
    for i <- iter.Range(0, lenL(mut st, pl)) {
        hsetTy(mut st, int(ps) + 1 + i, tyOf(mut st, pk, latN(mut st, pl, i), at, fuel - 1)?)
    }
    rl := lB(nodeOf(mut st, te))
    rs := ListRef(listN(mut st, lenL(mut st, rl)))
    for i <- iter.Range(0, lenL(mut st, rl)) {
        hsetTy(mut st, int(rs) + 1 + i, retTy(mut st, tyOf(mut st, pk, latN(mut st, rl, i), at, fuel - 1)?))
    }
    sig := int(tFn(mut st, tyChain(mut st, ps), tyChain(mut st, rs))) * 2 + b2i(af)
    for i <- iter.Range(0, table.Len(mut st.bkSig)) {
        if table.Get(mut st.bkSig, i) == sig {
            return NodeRef(table.Get(mut st.bkNode, i)), nil
        }
    }
    table.Push(mut st.bkSig, sig)
    table.Push(mut st.bkNode, int(te))
    return te, nil
}

// ── env の形（工程 4 B1）──

// shapeList は前走りが集めた F（宣言 decl）の形の列（出現順）
func shapeList(st mut S, decl NodeRef) []int {
    mut out := mut []int{}
    for i <- iter.Range(0, table.Len(mut st.shDecl)) {
        if table.Get(mut st.shDecl, i) == int(decl) {
            out = append(out, table.Get(mut st.shTy, i))
        }
    }
    return freeze(out)
}

// unionFrom は形の列 sh の i 番目からの右結合の union（残り 1 つならその形）
func unionFrom(st mut S, sh []int, i int) TyRef {
    if i + 1 == len(sh) {
        return TyRef(sh[i])
    }
    return tUnion(mut st, TyRef(sh[i]), unionFrom(mut st, sh, i + 1))
}

// envU は F の env の型 U（形が無ければ int — 捕捉なしの置き場）
func envU(st mut S, decl NodeRef) TyRef {
    sh := shapeList(mut st, decl)
    return if len(sh) == 0 { st.tInt } else { unionFrom(mut st, sh, 0) }
}

// injectFrom は env の値 v（形 k）を形の列 sh の i 番目からの union へ包む
func injectFrom(st mut S, sh []int, k int, i int, v CoreRef) CoreRef {
    if i + 1 == len(sh) {
        return v
    }
    if k == i {
        return cInl(mut st, unionFrom(mut st, sh, i + 1), v)
    }
    return cInr(mut st, TyRef(sh[i]), injectFrom(mut st, sh, k, i + 1, v))
}

// extractFrom は union の値 x（形の列 sh の i 番目から）から形 k を取り出す（他の腕は unreach — 作成点が形と fnref を組で作るので来ない）
func extractFrom(st mut S, sh []int, k int, i int, x CoreRef) CoreRef {
    if i + 1 == len(sh) {
        return x
    }
    l := if k == i { cVar(mut st, 0) } else { cUnreach(mut st, TyRef(sh[k])) }
    r := if k == i { cUnreach(mut st, TyRef(sh[k])) } else { extractFrom(mut st, sh, k, i + 1, cVar(mut st, 0)) }
    return ce(mut st, CCase, int(x), int(l), int(r), 0)
}

// shapeRec は持ち上げた閉包の形（F の宣言 decl・env の型 t）を記録する（重複なし — 前走りの持ち帰り）
func shapeRec(st mut S, decl NodeRef, t TyRef) {
    for i <- iter.Range(0, table.Len(mut st.shRecDecl)) {
        if table.Get(mut st.shRecDecl, i) == int(decl) && table.Get(mut st.shRecTy, i) == int(t) {
            return
        }
    }
    table.Push(mut st.shRecDecl, int(decl))
    table.Push(mut st.shRecTy, int(t))
}

// tyEnc / tyDec は捕捉できる型（capTyOk の範囲）の S をまたぐ写し: [tag, 葉の欄…] の前置順（tyEnc は st.shBuf へ積む —
// mut の仮引数を 1 つに保つ。2 つにすると呼び出し点ごとの展開になる）
func tyEnc(st mut S, t TyRef) {
    x := tyAt(mut st, t)
    table.Push(mut st.shBuf, x.tag)
    switch x.tag {
    case TOpt: tyEnc(mut st, TyRef(x.a))
    case TPr | TUn:
        tyEnc(mut st, TyRef(x.a))
        tyEnc(mut st, TyRef(x.b))
    case TSl:
        table.Push(mut st.shBuf, x.a)
        table.Push(mut st.shBuf, x.b)
        table.Push(mut st.shBuf, x.d)
        tyEnc(mut st, TyRef(x.c))
    case TMp:
        table.Push(mut st.shBuf, x.a)
        table.Push(mut st.shBuf, x.b)
        tyEnc(mut st, TyRef(x.c))
        tyEnc(mut st, TyRef(x.d))
    case TRef:
        // mut の捕捉のセル（(α-L1)）
        table.Push(mut st.shBuf, x.a)
        table.Push(mut st.shBuf, x.b)
        tyEnc(mut st, TyRef(x.c))
    case TFn:
        st.shHasFn = true
        tyEnc(mut st, TyRef(x.a))
        tyEnc(mut st, TyRef(x.b))
    default:
        table.Push(mut st.shBuf, x.a)
        table.Push(mut st.shBuf, x.b)
        table.Push(mut st.shBuf, x.c)
        table.Push(mut st.shBuf, x.d)
    }
}

func tyDec(st mut S, xs []int, at int) (TyRef, int) {
    tag := xs[at]
    switch tag {
    case TOpt:
        a, p := tyDec(mut st, xs, at + 1)
        return tOpt(mut st, a), p
    case TPr | TUn:
        a, p := tyDec(mut st, xs, at + 1)
        b, q := tyDec(mut st, xs, p)
        return mkTy(mut st, tag, int(a), int(b), 0, 0), q
    case TSl:
        c, p := tyDec(mut st, xs, at + 4)
        return mkTy(mut st, TSl, xs[at + 1], xs[at + 2], int(c), xs[at + 3]), p
    case TMp:
        c, p := tyDec(mut st, xs, at + 3)
        d, q := tyDec(mut st, xs, p)
        return mkTy(mut st, TMp, xs[at + 1], xs[at + 2], int(c), int(d)), q
    case TRef:
        c, p := tyDec(mut st, xs, at + 3)
        return mkTy(mut st, TRef, xs[at + 1], xs[at + 2], int(c), 0), p
    case TFn:
        a, p := tyDec(mut st, xs, at + 1)
        b, q := tyDec(mut st, xs, p)
        return mkTy(mut st, TFn, int(a), int(b), 0, 0), q
    default:
        return mkTy(mut st, tag, xs[at + 1], xs[at + 2], xs[at + 3], xs[at + 4]), at + 5
    }
}

// shapesOut は記録した形の写し [decl, 型の写し…]…（前走りの持ち帰り）
func shapesOut(st mut S) []int {
    for i <- iter.Range(0, table.Len(mut st.shRecDecl)) {
        table.Push(mut st.shBuf, table.Get(mut st.shRecDecl, i))
        tyEnc(mut st, TyRef(table.Get(mut st.shRecTy, i)))
    }
    mut out := mut []int{}
    for i <- iter.Range(0, table.Len(mut st.shBuf)) {
        out = append(out, table.Get(mut st.shBuf, i))
    }
    return freeze(out)
}

// loadShapes は前走りの形の写し xs を積む（入口が run の前に）
func loadShapes(st mut S, xs []int) {
    mut at := 0
    while at < len(xs) {
        d := xs[at]
        t, p := tyDec(mut st, xs, at + 1)
        table.Push(mut st.shDecl, d)
        table.Push(mut st.shTy, int(t))
        at = p
    }
}

// needShapes は前走りが要るか（捕捉を持つ値の位置のラムダがあるときだけ — 捕捉なしの形は全部 int で U = int）
func needShapes(p loader.Program) bool {
    for i <- iter.Range(0, len(p.cap_lo)) {
        if p.cap_hi[i] > p.cap_lo[i] {
            return true
        }
    }
    return false
}

// shapesFor は前走り: p を同じ設定（E2-S・逃げ・部分検査・std の信頼）で区間なしに脱糖し、持ち上げた閉包の形を持ち帰る
// （拒否は捨てる — 本走りが同じ本体を同じ順で脱糖して同じ拒否を出す。作業域はこの関数の region ごと捨てる）
func shapesFor(p loader.Program, e2s bool, excl []int, only int, trust bool) []int {
    if !needShapes(p) {
        return []int{}
    }
    // 形が関数値（閉包の値 — 借りの閉包の捕捉・report-1038 (c) 案 A の η）を含むと、形の型が他の鍵の U に依る: 前の周の形を読み込んで回し直し、
    // 形が変わらなくなるまで（固定点 — 4 周まで。収まらない循環は本走りの食い違いで断る）。関数値を含まない形は今どおり 1 周
    mut prev := []int{}
    mut out := []int{}
    mut round := 0
    while round < 4 {
        mut st := S{}
        initState(mut st, p)
        st.e2s = e2s
        st.e2sExcl = excl
        st.only = only
        st.onlySet = only >= 0
        st.trustStd = trust
        st.preRun = true
        loadShapes(mut st, prev)
        _, _, _ = run(mut st)
        out = shapesOut(mut st)
        if !st.shHasFn || intsEq(out, prev) {
            return out
        }
        prev = out
        round += 1
    }
    return out
}

// intsEq は 2 つの int の列が等しいか
func intsEq(a []int, b []int) bool {
    if len(a) != len(b) {
        return false
    }
    for i <- iter.Range(0, len(a)) {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

// closParam / closRet は閉包の型の元の引数鎖 P と結果 R
func closParam(st mut S, ct TyRef) TyRef {
    return tRight(mut st, tLeft(mut st, tLeft(mut st, ct)))
}

func closRet(st mut S, ct TyRef) TyRef {
    return tRight(mut st, tLeft(mut st, ct))
}

// isClosTy は閉包の型の形か（prod (fn (prod _ _) _) _）
func isClosTy(st mut S, t TyRef) bool {
    if t == -1 || !isTag(mut st, t, TPr) || !isTag(mut st, tLeft(mut st, t), TFn) {
        return false
    }
    return isTag(mut st, tLeft(mut st, tLeft(mut st, t)), TPr)
}

// anonFieldTE は型式の節 te が値の位置の匿名の関数型の欄の型か（工程 5d — loader.FnValAnonFields の印）
func anonFieldTE(st mut S, te NodeRef) bool {
    for i <- iter.Range(0, len(st.anonFT)) {
        if st.anonFT[i] == int(te) {
            return true
        }
    }
    return false
}

// fieldFnValDecl は欄の型式 ftype（package pk・型環境 fenv）が値の位置（値化可能な named fn type かその option・匿名の関数型の欄）なら
// 値の位置の記録 [env の鍵, package, 型環境, 関数型の形の節]（named fn type = その宣言と BFunc・匿名の欄 = 構造の鍵〔brwKey〕と TFunc。でなければ -1）
func fieldFnValDecl(st mut S, pk int, fenv int, ftype NodeRef) (int, error?) {
    if anonFieldTE(mut st, ftype) {
        saved := st.tenv
        st.tenv = fenv
        bk, err := brwKey(mut st, pk, ftype, ftype, EXPANDFUEL, true)
        st.tenv = saved
        if err != nil {
            return 0, err
        }
        return rec5(mut st, int(bk), pk, fenv, int(ftype), 0), nil
    }
    te := if kindN(mut st, ftype) == ast.TOpt { nA(nodeOf(mut st, ftype)) } else { ftype }
    if kindN(mut st, te) != ast.TName {
        return -1, nil
    }
    saved := st.tenv
    st.tenv = fenv
    dr := declOfTypeExpr(mut st, pk, te)
    st.tenv = saved
    if !fnValDr(mut st, dr) {
        return -1, nil
    }
    return rec5(mut st, hget(mut st, dr), hget(mut st, dr + 1), hget(mut st, dr + 2), int(nC(nodeOf(mut st, hgetN(mut st, dr)))), 0), nil
}

// closureValue は値の位置（期待型 want = 閉包の型かその option・値の位置の記録 vp — fieldFnValDecl）の値 e の脱糖: ラムダは持ち上げて閉包の組に、nil は nil、
// それ以外（閉包の値の束縛・欄の読み — 関数の名前は loader が η 展開済みで来ない）は素通し
func closureValue(st mut S, e NodeRef, want TyRef, dr int, eb int, ef int, depth int, at NodeRef) (CoreRef, error?) {
    k := kindN(mut st, e)
    if tg(mut st, want) == TOpt {
        if k == ast.ENil {
            return cNil(mut st, tInner(mut st, want)), nil
        }
        if k != ast.ELambda && isTag(mut st, computeTy(mut st, e, eb, ef), TOpt) {
            return expr(mut st, e, eb, ef, depth)
        }
        v := closureValue(mut st, e, tInner(mut st, want), dr, eb, ef, depth, at)?
        return c1(mut st, CSome, v), nil
    }
    if k == ast.ELambda {
        st.liftHint = rec5(mut st, hget(mut st, dr + 1), hget(mut st, dr + 2), hget(mut st, dr + 3), 0, 0)
        return liftLambdaCap(mut st, e, want, hgetN(mut st, dr), eb, ef, depth, at)
    }
    return expr(mut st, e, eb, ef, depth)
}

// capEntry は値の位置のラムダ lam の捕捉の表の行（loader の Program.cap_* — 無ければ -1）
func capEntry(st mut S, lam NodeRef) int {
    if !isTreeNode(int(lam)) {
        return -1
    }
    f := refFile(int(lam))
    n := refIdx(int(lam))
    for i <- iter.Range(0, len(st.capFile)) {
        if st.capFile[i] == f && st.capNode[i] == n {
            return i
        }
    }
    return -1
}

// capLive は値の位置のラムダの行 row が main から届く関数の中にあるか（report-957）。届かない関数の中の閉包の env の形は U_F に入れない —
// import しただけで呼ばない std の閉包（http.Static の stream）が、そのプログラムの全部の値の型を太らせない（閉じた union は世界全体でなく届く世界で閉じる）。
// 届く = mainReach（名前の参照の辺 — 呼び出しに限らず関数値も・ラムダの中の参照は囲む関数から — 保守的）。届かない関数の本体は実行されないので
// 作成点は unreach、持ち上げた Def は自分の形を直に受ける（本体の検査は今どおり）。lower は main から届く関数だけを下ろす（作業列）ので、
// 届く扱いの誤り（脱糖テンプレートの暗黙の呼び出しの先の std が値の位置の捕捉つき閉包を作る形 — 今は無い）は build の Mismatch で表に出る
func capLive(st mut S, row int) bool {
    if st.capLiveN == 0 {
        mk, ok := mainReach(mut st)
        st.capReach = int(mk)
        st.capLiveN = if ok { 2 } else { 1 }
    }
    if st.capLiveN == 1 || row < 0 {
        return true
    }
    f := st.capFile[row]
    fi := e2sEnclosing(mut st, f, st.capNode[row])
    return fi < 0 || latI(mut st, ListRef(st.capReach), fi) == 1
}

// CapRow は値の位置のラムダ lam の捕捉の表の行（無ければ -1 — analyzer の口。U1 の捕捉の判定）
func CapRow(st mut S, lam NodeRef) int {
    return capEntry(mut st, lam)
}

// CapLive は lower の口（closPrep — check と同じ判定で形を集める）
func CapLive(st mut S, i int) bool {
    return capLive(mut st, i)
}

// capTyOk は捕捉できる核の型か（スカラー・string・imm の slice / map と、その struct / option / union の組。関数値・能力〔端点〕・mut の器・
// 型変数は値として写せないので不可）
func capTyOk(st mut S, t TyRef) bool {
    k := tg(mut st, t)
    switch k {
    case TInt | TBool | TByte | TFloat | TUnit: return true
    case TPr | TUn: return capTyOk(mut st, tLeft(mut st, t)) && capTyOk(mut st, tRight(mut st, t))
    case TOpt: return capTyOk(mut st, tInner(mut st, t))
    case TSl: return tMutBit(mut st, t) == 0 && capTyOk(mut st, tElem(mut st, t))
    case TMp: return tMutBit(mut st, t) == 0 && capTyOk(mut st, tKey(mut st, t)) && capTyOk(mut st, tVal(mut st, t))
    default: return false
    }
}

// capBrwTyOk は借りの閉包が捕捉できる核の型か: capTyOk に関数値（閉包の値 — fnref と env の組）を足したもの（寿命は借りの呼び出しの内側。
// 匿名の欄の閉包の値を借りの位置へ渡す η `(…) => x.f(…)` が欄を持つ値 x を捕捉する — report-1038 (c) 案 A）
func capBrwTyOk(st mut S, t TyRef) bool {
    k := tg(mut st, t)
    switch k {
    case TInt | TBool | TByte | TFloat | TUnit | TFn: return true
    case TPr | TUn: return capBrwTyOk(mut st, tLeft(mut st, t)) && capBrwTyOk(mut st, tRight(mut st, t))
    case TOpt: return capBrwTyOk(mut st, tInner(mut st, t))
    case TSl: return tMutBit(mut st, t) == 0 && capBrwTyOk(mut st, tElem(mut st, t))
    case TMp: return tMutBit(mut st, t) == 0 && capBrwTyOk(mut st, tKey(mut st, t)) && capBrwTyOk(mut st, tVal(mut st, t))
    default: return false
    }
}

// idDeclName は型宣言の参照 dr が同一性の族か（loader/identityx.sober の idBase と同じ名前の閉じた集合 + net の Conn / Listener・tls の Conn）
func idDeclName(st mut S, dr int) bool {
    pp := PkgPath(mut st, hget(mut st, dr + 1))
    nm := sA(nodeOf(mut st, hgetN(mut st, dr)))
    if strIs(mut st, pp, "std/task") {
        return strIs(mut st, nm, "Scope") || strIs(mut st, nm, "Handle") || strIs(mut st, nm, "Sender") || strIs(mut st, nm, "Receiver") || strIs(mut st, nm, "Pool") || strIs(mut st, nm, "Local")
    }
    if strIs(mut st, pp, "std/io") {
        return strIs(mut st, nm, "File")
    }
    if strIs(mut st, pp, "std/net") {
        return strIs(mut st, nm, "Conn") || strIs(mut st, nm, "Listener")
    }
    if strIs(mut st, pp, "std/tls") {
        return strIs(mut st, nm, "Conn")
    }
    return false
}

// idDecl は型宣言の参照 dr が同一性を（欄を通して推移的に）持つか
func idDecl(st mut S, dr int, fuel int) bool {
    if dr < 0 || fuel == 0 || hget(mut st, dr) == ERRS {
        return false
    }
    if idDeclName(mut st, dr) {
        return true
    }
    fs := structFields(mut st, dr)
    if fs == -1 {
        return false
    }
    for i <- iter.Range(0, lenL(mut st, fs)) {
        te := nB(nodeOf(mut st, latN(mut st, fs, i)))
        saved := st.tenv
        st.tenv = hget(mut st, dr + 2)
        d := declOfTypeExpr(mut st, hget(mut st, dr + 1), te)
        e := elemDeclOfTypeExpr(mut st, hget(mut st, dr + 1), te)
        st.tenv = saved
        if idDecl(mut st, d, fuel - 1) || idDecl(mut st, e, fuel - 1) {
            return true
        }
    }
    return false
}

// liftLambdaCap は値の位置のラムダ lam（閉包の型 ct）→ 持ち上げた Def（仮引数 = pair env 元の引数鎖）と、作成点（深さ depth・束縛 outer_b）で
// 捕捉を写した閉包の組 `pair (fnref d) env`。捕捉は loader の表の名前を作成点の束縛で引く — 値として写せない束縛（同一性・関数値・能力・mut）は FnCap kind 5
func liftLambdaCap(st mut S, lam NodeRef, ct TyRef, fdecl NodeRef, outer_b int, outer_f int, depth int, at NodeRef) (CoreRef, error?) {
    brwLift := st.liftBrw != 0
    st.liftBrw = 0
    anc := st.liftAnchor - 1
    st.liftAnchor = 0
    cr := capEntry(mut st, lam)
    if cr < 0 {
        return 0, diag.CoreFragment{at: posOf(mut st, at)}
    }
    // 捕捉は平たく数える（展開待ちの捕捉は束縛の閉包の実引数のラムダの捕捉に置き換わる — capFlat）
    ncap := capFlatN(mut st, cr, outer_b, outer_f, brwLift, lam, 8)?
    // 捕捉の束縛・作成点の値・Def の中の型（region を Def の仮引数の region 0 へ締める）
    cbs := ListRef(listN(mut st, ncap))
    cvals := ListRef(listN(mut st, ncap))
    ctys := ListRef(listN(mut st, ncap))
    _ = capFlatFill(mut st, cr, outer_b, outer_f, 0, cbs, cvals, ctys, depth, anc, lam)?
    envT := if ncap == 0 { st.tInt } else { tyChain(mut st, ctys) }
    envV0 := if ncap == 0 { cLit(mut st, 0) } else { pairChain(mut st, cvals) }
    // 形の記録と U の中の位置（前走りに無い形 = 本走りと前走りの食い違い — 断片として断る）。main から届かない関数の閉包は形を記録せず、
    // 持ち上げた Def が自分の形を直に受け、作成点は unreach（capLive）
    live := capLive(mut st, cr)
    if live {
        shapeRec(mut st, fdecl, envT)
    }
    sh := if live { shapeList(mut st, fdecl) } else { []int{} }
    mut kk := 0 - 1
    for j <- iter.Range(0, len(sh)) {
        if sh[j] == int(envT) {
            kk = j
        }
    }
    if len(sh) > 0 && kk < 0 && !st.preRun {
        return 0, diag.CoreFragment{at: posOf(mut st, lam)}
    }
    // anchor つきの呼び出し（(α-L1)）の実引数は Def の region 0 が anchor へ写るので、union の他の腕の注釈（Def の座標 — region 0）も anchor へ
    // （mut は正確一致 — 他の作成点の mut の捕捉の形の ref の region が anchor と揃うこと）
    sha := if anc < 0 { sh } else { shapesAt(mut st, sh, anc) }
    // 前走りの固定点の途中（読み込んだ形が前の周の U の座標 — 関数値を捕捉する形）では食い違いを断らず、形の記録を続ける
    envV := if len(sh) == 0 || kk < 0 { envV0 } else { injectFrom(mut st, sha, kk, 0, envV0) }
    uT := if !live { envT } else if len(sh) == 0 { st.tInt } else { unionFrom(mut st, sh, 0) }
    pT := closParam(mut st, ct)
    rT := closRet(mut st, ct)

    saved_rd := st.rdepth
    st.rdepth = 2
    saved_tf := st.taskFloor
    st.taskFloor = 0
    saved_ps := st.parScope1
    st.parScope1 = 0
    defer {
        st.taskFloor = saved_tf
        st.parScope1 = saved_ps
    }
    lps := lA(nodeOf(mut st, lam))
    n := lenL(mut st, lps)
    ptys := ListRef(listN(mut st, n))
    mut p := pT
    mut i := 0
    while i < n {
        if i + 1 == n {
            hsetTy(mut st, int(ptys) + 1 + i, p)
        } else if tg(mut st, p) == TPr {
            hsetTy(mut st, int(ptys) + 1 + i, tLeft(mut st, p))
            p = tRight(mut st, p)
        } else {
            return 0, diag.Malformed{at: posOf(mut st, at)}
        }
        i += 1
    }
    if n == 0 && tg(mut st, pT) != TUnit {
        return 0, diag.Malformed{at: posOf(mut st, at)}
    }
    pdecls := ListRef(listN(mut st, n))
    pelems := ListRef(listN(mut st, n))
    pbrw := ListRef(listN(mut st, n))
    i = 0
    while i < n {
        lput(mut st, pdecls, i, -1)
        lput(mut st, pelems, i, -1)
        lput(mut st, pbrw, i, 0)
        i += 1
    }
    if st.liftHint >= 0 {
        h := st.liftHint
        st.liftHint = -1
        hps := lA(nodeOf(mut st, hgetN(mut st, h + 2)))
        if lenL(mut st, hps) == n {
            saved := st.tenv
            st.tenv = hget(mut st, h + 1)
            i = 0
            while i < n {
                te := latN(mut st, hps, i)
                lput(mut st, pdecls, i, declOfTypeExpr(mut st, hget(mut st, h), te))
                lput(mut st, pelems, i, elemDeclOfTypeExpr(mut st, hget(mut st, h), te))
                if kindN(mut st, te) == ast.TFunc {
                    lput(mut st, pbrw, i, int(te) + 1)
                }
                i += 1
            }
            st.tenv = saved
        }
    }
    // Def の仮引数 var 0 = pair env 引数鎖: 捕捉 → 引数の順に let で束縛する（liftLambda の exs の形の一般化）
    exs := ListRef(listN(mut st, ncap + n))
    for j <- iter.Range(0, ncap) {
        ev := c1(mut st, CFst, cVar(mut st, j))
        hsetCore(mut st, int(exs) + 1 + j, projection(mut st, if len(sh) == 0 { ev } else { extractFrom(mut st, sh, kk, 0, ev) }, j, ncap))
    }
    // 捕捉の束縛: 自分の捕捉は本体の鎖へ、展開待ちの捕捉は実引数のラムダの捕捉だけを見る鎖で閉包に束ね直す（本体の `send(p)` は今どおり展開）
    cb := capFlatBind(mut st, cr, outer_f, cbs, ctys, 0)
    mut benv := cb.eb
    mut fenv := cb.ef
    mut d := 1 + ncap
    i = 0
    while i < n {
        a := if n == 1 { c1(mut st, CSnd, cVar(mut st, d - 1)) } else { projection(mut st, c1(mut st, CSnd, cVar(mut st, d - 1)), i, n) }
        hsetCore(mut st, int(exs) + 1 + ncap + i, a)
        benv = bind(mut st, benv, sA(nodeOf(mut st, latN(mut st, lps, i))), d, false, latI(mut st, pdecls, i), latTy(mut st, ptys, i), latI(mut st, pelems, i), 0, -1, false, SUNK)
        if latI(mut st, pbrw, i) != 0 {
            setBrw(mut st, benv, latI(mut st, pbrw, i))
        }
        d += 1
        i += 1
    }
    saved := fnCtx(mut st)
    st.hasOuter = b2i(true)
    st.outerB = outer_b
    st.outerF = outer_f
    st.retTarget = -1
    st.loopFloor = st.nlab
    lbody := nB(nodeOf(mut st, lam))
    mut body := CoreRef(-1)
    if kindN(mut st, lbody) == ast.EBlock {
        // 末尾の式の型が取れない（`{ n += len(b); nil }` の nil — report-755 懸念 2・F-bw の値の位置版）なら末尾の期待型（結果 R）を渡す
        bl := lA(nodeOf(mut st, lbody))
        nb := lenL(mut st, bl)
        tw := nb > 0 && kindN(mut st, latN(mut st, bl, nb - 1)) == ast.SExpr && armTy(mut st, bl, benv, fenv) == -1
        body = scoped(mut st, bl, benv, fenv, d, false, false, if tw { rT } else { TyRef(-1) })?
    } else {
        body = coerceExpr(mut st, lbody, rT, benv, fenv, d, at)?
    }
    setFnCtx(mut st, saved)
    body = wrapLets(mut st, exs, body)
    idx := st.ndef + st.nlifted
    def := rec5(mut st, int(tProd(mut st, uT, pT)), int(rT), int(body), st.curTparams, -1)
    if st.liftedTail >= 0 {
        hset(mut st, st.liftedTail + 4, def)
    } else {
        st.liftedHead = def
    }
    st.liftedTail = def
    st.nlifted = st.nlifted + 1
    table.Push(mut st.liftAt, int(lam))
    mut ts := -1
    if st.curTparams > 0 {
        ts = listN(mut st, st.curTparams)
        i = 0
        while i < st.curTparams {
            hsetTy(mut st, ts + 1 + i, tVar(mut st, i))
            i += 1
        }
    }
    st.rdepth = saved_rd
    if !live {
        return cUnreach(mut st, ct), nil
    }
    return c2(mut st, CPair, cFnref(mut st, idx, ts), envV), nil
}

// 展開待ちの捕捉（language.md 25 節 (α-L0) — report-833〜836）: 借りの位置のラムダの中で囲む展開される関数の匿名の関数型の仮引数 send を呼ぶ形は、
// 持ち上げの時に send の束縛の閉包（展開の実引数のラムダ L）の捕捉を env に平たく積み、本体では send を L の閉包に束ね直す（L の捕捉だけを見る鎖）。
// 資格の検査は L の捕捉に今の文面で掛かる（展開の後に今の捕捉の検査 — 8 節「生成方式は意味に触れない」）

// capFlatN は行 row の平たい捕捉の数（束縛の鎖 eb / ef で引く。値になれない形は FnCap kind 5）
func capFlatN(st mut S, row int, eb int, ef int, brw bool, lam NodeRef, fuel int) (int, error?) {
    if fuel == 0 {
        return 0, diag.FnCap{at: posOf(mut st, lam), kind: 5}
    }
    mut n := 0
    for j <- iter.Range(st.capLo[row], st.capHi[row]) {
        nm := strOf(mut st, bytes(st.capNames[j]))
        if capPkAt(mut st, j) >= 0 {
            // 展開待ち: 借りの位置のラムダだけ・束縛が展開の閉包で、実引数のラムダに流れの行があること
            cl := if brw && lookup(mut st, eb, nm) < 0 { lookupF(mut st, ef, nm) } else { 0 - 1 }
            lr := if cl >= 0 { capEntry(mut st, clo(mut st, cl).lambda) } else { 0 - 1 }
            if lr < 0 || !capFlowAt(mut st, lr) {
                return 0, diag.FnCap{at: posOf(mut st, lam), kind: 5}
            }
            n += capFlatN(mut st, lr, clo(mut st, cl).envB, clo(mut st, cl).envF, brw, lam, fuel - 1)?
        } else {
            b := lookup(mut st, eb, nm)
            if b < 0 {
                return 0, diag.FnCap{at: posOf(mut st, lam), kind: 5}
            }
            x := bnd(mut st, b)
            // 借りの閉包（(α-L0)）は同一性の型を捕捉してよい（寿命は借りの呼び出しの内側 — 使い方は filecheck）。
            // mut の束縛も捕捉してよい（(α-L1) — 束縛そのもの〔ref・欄ごとのセルの木〕を env に積む。資格は loader が見た — 借りの実引数のラムダだけ・
            // 呼び出しごとに束縛 1 つ）。チャネルを持つ mut は Def の仮引数に置けない（paramOk の chanFree）
            if x.mutable && brw {
                if x.ty == -1 || !tyChanFree(mut st, x.ty) {
                    return 0, diag.FnCap{at: posOf(mut st, lam), kind: 5}
                }
            } else if x.mutable || x.split || x.ty == -1 || !(capTyOk(mut st, x.ty) || brw && capBrwTyOk(mut st, x.ty)) || !brw && (idDecl(mut st, x.decl, 8) || idDecl(mut st, x.elem, 8)) {
                return 0, diag.FnCap{at: posOf(mut st, lam), kind: 5}
            }
            n += 1
        }
    }
    return n, nil
}

// capFlatFill は行 row の平たい捕捉を k 番目から埋める（束縛・作成点の値・Def の中の型）。次の k を返す（検査は capFlatN が済ませている）。
// anc = anchor つきの呼び出しの anchor（-1 = callv）: imm の捕捉が anchor より深ければ anchor へ形式コピー（M4 (a) の写し — callM の imm の実引数と同じ）。
// mut の捕捉（(α-L1)）は束縛そのもの: 値 = 束縛の ref（mut 実引数の mutParamArg と同じ ann — 割った束縛はセルの木そのまま）・Def の中の型 = region 0 の ref / セルの木
func capFlatFill(st mut S, row int, eb int, ef int, k0 int, cbs ListRef, cvals ListRef, ctys ListRef, depth int, anc int, at NodeRef) (int, error?) {
    mut k := k0
    for j <- iter.Range(st.capLo[row], st.capHi[row]) {
        nm := strOf(mut st, bytes(st.capNames[j]))
        if capPkAt(mut st, j) >= 0 {
            c := clo(mut st, lookupF(mut st, ef, nm))
            k = capFlatFill(mut st, capEntry(mut st, c.lambda), c.envB, c.envF, k, cbs, cvals, ctys, depth, anc, at)?
        } else {
            b := lookup(mut st, eb, nm)
            x := bnd(mut st, b)
            lput(mut st, cbs, k, b)
            v := cVar(mut st, depth - 1 - x.level)
            if x.mutable {
                hsetCore(mut st, int(cvals) + 1 + k, if x.split { v } else { cAnn(mut st, v, mutCellTy(mut st, x, x.region)) })
                hsetTy(mut st, int(ctys) + 1 + k, if x.split { splitTy(mut st, x.decl, 0, true, at)? } else { mutCellTy(mut st, x, 0) })
            } else {
                mut cv := v
                if anc >= 0 {
                    saved := st.rdepth
                    st.rdepth = anc + 1
                    et := pointTy(mut st, x.ty)
                    st.rdepth = saved
                    c := storeCopy(mut st, v, x.ty, et, anc)
                    if c != -1 {
                        cv = c
                    }
                }
                hsetCore(mut st, int(cvals) + 1 + k, cv)
                hsetTy(mut st, int(ctys) + 1 + k, tyClamp(mut st, x.ty, 0))
            }
            k += 1
        }
    }
    return k, nil
}

// mutCellTy は割っていない mut の束縛 x のセル（ref）の region r の型（mutParamArg の ann と同じ — 中身の型は束縛点の座標へ）
func mutCellTy(st mut S, x Binding, r int) TyRef {
    saved := st.rdepth
    st.rdepth = r + 1
    inner := pointTy(mut st, x.ty)
    st.rdepth = saved
    return tRefOf(mut st, 1, r, inner)
}

// shapesAt は env の形の列 sh（Def の座標 — region 0）を region a の座標へ写した列（anchor つきの呼び出しの作成点の union の注釈）
func shapesAt(st mut S, sh []int, a int) []int {
    saved := st.rdepth
    st.rdepth = a + 1
    mut out := mut []int{}
    for i <- iter.Range(0, len(sh)) {
        out = append(out, int(pointTy(mut st, TyRef(sh[i]))))
    }
    st.rdepth = saved
    return freeze(out)
}

// mutRegion は型 t の mut のコンテナ・参照の region の最小（関数型の中は見ない — 閉じた型スキーム。無ければ -1）
func mutRegion(st mut S, t TyRef) int {
    if t == -1 {
        return -1
    }
    x := tg(mut st, t)
    return switch x {
    case TOpt: mutRegion(mut st, tInner(mut st, t))
    case TUn | TPr: minAnc(mutRegion(mut st, tLeft(mut st, t)), mutRegion(mut st, tRight(mut st, t)))
    case TSl | TRef: minAnc(if tMutBit(mut st, t) != 0 { tRegion(mut st, t) } else { -1 }, mutRegion(mut st, tElem(mut st, t)))
    case TMp: minAnc(if tMutBit(mut st, t) != 0 { tRegion(mut st, t) } else { -1 }, minAnc(mutRegion(mut st, tKey(mut st, t)), mutRegion(mut st, tVal(mut st, t))))
    default: -1
    }
}

// minAnc は region の最小（-1 = 無し）
func minAnc(a int, b int) int {
    return if a < 0 { b } else if b < 0 || a <= b { a } else { b }
}

// CapChains は capFlatBind の結果: 値の束縛の鎖・関数型の束縛の鎖・次の k
type CapChains struct {
    eb int
    ef int
    k int
}

// capFlatBind は持ち上げた Def の中の束縛（平たい捕捉の k 番目 = 段 k + 1）: 自分の捕捉は eb へ、展開待ちの捕捉は L の捕捉の鎖で L の閉包に束ね直して ef へ。
// 作成点の関数型の束縛の鎖 src で閉包を引き、自分の捕捉の束縛は cbs（capFlatFill と同じ順）から読む
func capFlatBind(st mut S, row int, src int, cbs ListRef, ctys ListRef, k0 int) CapChains {
    mut eb := -1
    mut ef := -1
    mut k := k0
    for j <- iter.Range(st.capLo[row], st.capHi[row]) {
        nm := strOf(mut st, bytes(st.capNames[j]))
        if capPkAt(mut st, j) >= 0 {
            c := clo(mut st, lookupF(mut st, src, nm))
            sub := capFlatBind(mut st, capEntry(mut st, c.lambda), c.envF, cbs, ctys, k)
            table.Push(mut st.closures, Closure{lambda: c.lambda, envB: sub.eb, envF: sub.ef, pkg: c.pkg, tenv: c.tenv, ft: c.ft, retTarget: -1, inlrec: c.inlrec})
            ef = bindF(mut st, ef, int(nm), table.Len(mut st.closures) - 1, SUNK)
            k = sub.k
        } else {
            x := bnd(mut st, latI(mut st, cbs, k))
            if x.mutable {
                // 捕捉した mut の束縛（(α-L1)）: Def の中では region 0 の mut の束縛（mut 仮引数と同じ — 中身の型は region 0 の座標）
                saved := st.rdepth
                st.rdepth = 1
                vt := pointTy(mut st, x.ty)
                st.rdepth = saved
                eb = bind(mut st, eb, x.name, k + 1, true, x.decl, vt, x.elem, 0, -1, x.split, x.sty)
            } else {
                eb = bind(mut st, eb, x.name, k + 1, false, x.decl, latTy(mut st, ctys, k), x.elem, 0, -1, false, x.sty)
            }
            k += 1
        }
    }
    return CapChains{eb, ef, k}
}

// closureCallee は呼び出しの callee が閉包の値（値化可能な named fn type の宣言を持つ束縛か欄の読み）ならその閉包の型（でなければ -1）
func closureCallee(st mut S, callee NodeRef, eb int, ef int) TyRef {
    k := kindN(mut st, callee)
    if k == ast.EIdent {
        b := lookup(mut st, eb, sA(nodeOf(mut st, callee)))
        if b < 0 {
            return -1
        }
        x := bnd(mut st, b)
        // 匿名の関数型の欄の値の束縛は宣言を持たない（閉包の型の形で見分ける — struct の値の束縛は宣言を持つ）
        return if (fnValDr(mut st, x.decl) || x.brw != 0 || x.decl < 0) && isClosTy(mut st, x.ty) { x.ty } else { TyRef(-1) }
    }
    if k == ast.ESelector {
        base := nA(nodeOf(mut st, callee))
        if kindN(mut st, base) == ast.EIdent && lookup(mut st, eb, sA(nodeOf(mut st, base))) < 0 && importRef(mut st, st.curPkg, sA(nodeOf(mut st, base))) {
            return -1
        }
        if !fnValDr(mut st, declOfExpr(mut st, callee, eb, ef)) && !anonFieldTE(mut st, selFieldTE(mut st, callee, eb, ef)) {
            return -1
        }
        t := computeTy(mut st, callee, eb, ef)
        return if isClosTy(mut st, t) { t } else { TyRef(-1) }
    }
    return -1
}

// selFieldTE は欄の読み e の欄の型式の節（解決できなければ -1）
func selFieldTE(st mut S, e NodeRef, eb int, ef int) NodeRef {
    base := declOfExpr(mut st, nA(nodeOf(mut st, e)), eb, ef)
    fs := structFields(mut st, base)
    if fs == -1 {
        return -1
    }
    i := fieldIndex(mut st, fs, sB(nodeOf(mut st, e)))
    return if i < 0 { NodeRef(-1) } else { nB(nodeOf(mut st, latN(mut st, fs, i))) }
}

// callClosure は閉包の呼び出し: `let f := 閉包 in callv (fst f) (pair (snd f) 引数鎖)`（引数は let の内側 = 深さ depth + 1）
func callClosure(st mut S, callee NodeRef, ct TyRef, args ListRef, at NodeRef, eb int, ef int, depth int) (CoreRef, error?) {
    f := expr(mut st, callee, eb, ef, depth)?
    // 呼び先の named fn type の宣言（借りの仮引数の型式を引く — 借りの閉包自身の呼び出しは宣言なし）
    dr := closureCalleeDr(mut st, callee, eb, ef)
    sig := if dr >= 0 { nC(nodeOf(mut st, hgetN(mut st, dr))) } else { NodeRef(-1) }
    n := lenL(mut st, args)
    vs := ListRef(listN(mut st, n))
    mut p := closParam(mut st, ct)
    // 実引数の組 prod U P（U = 呼び先の env・P = 元の引数鎖）が mut を持つ（借りの閉包の mut 捕捉が閉じた世界の env の union を通して届く — (α-L1)）なら
    // anchor つきの callMv（callv は Def の region 0 を呼び手の最内へ固定し、mut の正確一致で落ちる）
    anchor := if tyMutFreeD(mut st, tRight(mut st, ct)) && tyMutFreeD(mut st, p) { -1 } else { closAnchor(mut st, ct, args, eb, ef) }
    for i <- iter.Range(0, n) {
        mut want := p
        if i + 1 != n {
            if tg(mut st, p) != TPr {
                return 0, diag.Malformed{at: posOf(mut st, at)}
            }
            want = tLeft(mut st, p)
            p = tRight(mut st, p)
        }
        a := latN(mut st, args, i)
        bte := if sig != -1 && i < lenL(mut st, lA(nodeOf(mut st, sig))) { latN(mut st, lA(nodeOf(mut st, sig)), i) } else { NodeRef(-1) }
        if bte != -1 && kindN(mut st, bte) == ast.TFunc && kindN(mut st, a) == ast.ELambda {
            // 借りの実引数のラムダ（(α-L0)）: 借りの位置 bte を鍵に持ち上げる（作成点 = let の内側の深さ depth + 1）
            st.liftHint = rec5(mut st, hget(mut st, dr + 1), hget(mut st, dr + 2), int(bte), 0, 0)
            bk := brwKey(mut st, hget(mut st, dr + 1), bte, at, EXPANDFUEL, false)?
            st.liftBrw = 1
            st.liftAnchor = anchor + 1
            hsetCore(mut st, int(vs) + 1 + i, liftLambdaCap(mut st, a, want, bk, eb, ef, depth + 1, at)?)
        } else {
            av := coerceExpr(mut st, a, want, eb, ef, depth + 1, at)?
            hsetCore(mut st, int(vs) + 1 + i, if anchor >= 0 { copyAt(mut st, av, computeTy(mut st, a, eb, ef), want, anchor) } else { av })
        }
    }
    if n == 0 && tg(mut st, p) != TUnit {
        return 0, diag.Malformed{at: posOf(mut st, at)}
    }
    fv := cVar(mut st, 0)
    if anchor >= 0 {
        // imm の実引数・呼び先の env は anchor より深ければ anchor へ形式コピー（M4 (a) — callM の実引数と同じ）
        u := tRight(mut st, ct)
        env := copyAt(mut st, c1(mut st, CSnd, cVar(mut st, 0)), u, u, anchor)
        return cLet(mut st, f, cCallMv(mut st, anchor, c1(mut st, CFst, fv), c2(mut st, CPair, env, pairChain(mut st, vs)))), nil
    }
    cv := c2(mut st, CCallv, c1(mut st, CFst, fv), c2(mut st, CPair, c1(mut st, CSnd, cVar(mut st, 0)), pairChain(mut st, vs)))
    return cLet(mut st, f, cv), nil
}

// copyAt は値 v（型 vt — -1 = 不明）を region a へ形式コピーした式（期待型 want を a の座標へ写した型で — 写す要の無い値・写せない型〔mut を持つ〕はそのまま）
func copyAt(st mut S, v CoreRef, vt TyRef, want TyRef, a int) CoreRef {
    saved := st.rdepth
    st.rdepth = a + 1
    et := pointTy(mut st, want)
    st.rdepth = saved
    c := storeCopy(mut st, v, vt, et, a)
    return if c != -1 { c } else { v }
}

// closAnchor は anchor つきの閉包の呼び出しの anchor の region: 借りの実引数のラムダが捕捉する mut の束縛の region・実引数と呼び先の env の型の
// mut の region の最小（(α-L1) — 1 つの呼び出しの mut は 1 つの束縛〔loader の縛り〕か Def の仮引数の region 0）。無ければ最内（callv と同じ写し）
func closAnchor(st mut S, ct TyRef, args ListRef, eb int, ef int) int {
    mut a := mutRegion(mut st, tRight(mut st, ct))
    for i <- iter.Range(0, lenL(mut st, args)) {
        x := latN(mut st, args, i)
        if kindN(mut st, x) == ast.ELambda {
            row := capEntry(mut st, x)
            if row >= 0 {
                for j <- iter.Range(st.capLo[row], st.capHi[row]) {
                    if capPkAt(mut st, j) < 0 {
                        b := lookup(mut st, eb, strOf(mut st, bytes(st.capNames[j])))
                        if b >= 0 && bnd(mut st, b).mutable {
                            a = minAnc(a, bnd(mut st, b).region)
                        }
                    }
                }
            }
        } else {
            a = minAnc(a, mutRegion(mut st, computeTy(mut st, x, eb, ef)))
        }
    }
    return if a < 0 { st.rdepth - 1 } else { a }
}

// closureCalleeDr は閉包の値の callee の named fn type の宣言の参照（借りの閉包・解決できない形は -1）
func closureCalleeDr(st mut S, callee NodeRef, eb int, ef int) int {
    k := kindN(mut st, callee)
    if k == ast.EIdent {
        b := lookup(mut st, eb, sA(nodeOf(mut st, callee)))
        if b < 0 {
            return -1
        }
        d := bnd(mut st, b).decl
        return if fnValDr(mut st, d) { d } else { -1 }
    }
    if k == ast.ESelector {
        d := declOfExpr(mut st, callee, eb, ef)
        return if fnValDr(mut st, d) { d } else { -1 }
    }
    return -1
}

// setBrw は束縛 b を借りの閉包の仮引数にする（key = 借りの位置の型式の節 + 1）
func setBrw(st mut S, b int, key int) {
    mut x := bnd(mut st, b)
    x.brw = key
    table.Set(mut st.binds, b, x)
}

// ── lower の口（クロージャの波 工程 5 — lower が値の位置の閉包の env の形を前段で集める）──

// lamRec は値の位置のラムダ lam の期待型の記録の添字（無ければ -1）
func lamRec(st mut S, lam NodeRef) int {
    for i <- iter.Range(0, table.Len(mut st.ylamN)) {
        if table.Get(mut st.ylamN, i) == int(lam) {
            return i
        }
    }
    return -1
}

// LamKey は値の位置のラムダ lam の期待型の named fn type の宣言（表層型検査器の記録 — 匿名の関数型・記録なしは -1）
func LamKey(st mut S, lam NodeRef) int {
    i := lamRec(mut st, lam)
    return if i < 0 { -1 } else { table.Get(mut st.ylamK, i) }
}

// FnTypeOf は式 e の表層型が名前付き関数型（option なら中身）ならその型宣言の節（でなければ -1 — analyzer が関数値の呼び出しの契約を引く口。
// effect の波 段 1 — language.md 12 節の面「高階」）
func FnTypeOf(st mut S, e NodeRef) int {
    y0 := yGet(mut st, int(e))
    y := if yk(mut st, y0) == YOpt { YAt(mut st, y0).a } else { y0 }
    k := yk(mut st, y)
    d := if k == YDecl { YAt(mut st, y).a } else if k == YFn { YAt(mut st, y).c - 1 } else { -1 }
    return if d >= 0 && isTreeNode(d) && kindN(mut st, nC(nodeOf(mut st, NodeRef(d)))) == ast.BFunc { d } else { -1 }
}

// IsFnValue は式 e の表層型が関数型（匿名・名前付き — option なら中身）か（analyzer の効果の導出が関数値の呼び出しを組み込み・型変換・型の構築と分ける口 —
// effect の波 段 5a）
func IsFnValue(st mut S, e NodeRef) bool {
    y0 := yGet(mut st, int(e))
    y := if yk(mut st, y0) == YOpt { YAt(mut st, y0).a } else { y0 }
    return yk(mut st, y) == YFn || FnTypeOf(mut st, e) != -1
}

// ExprDecl は式 e の表層型が型宣言（struct / union / named scalar / 名前付き関数型 — option なら中身）ならその型宣言の節（でなければ -1 —
// analyzer の値の流れが欄のスロットを型 × 名前で引く口。language.md 13 節の補 2）
func ExprDecl(st mut S, e NodeRef) NodeRef {
    y0 := yGet(mut st, int(e))
    y := if yk(mut st, y0) == YOpt { YAt(mut st, y0).a } else { y0 }
    return if yk(mut st, y) == YDecl { NodeRef(YAt(mut st, y).a) } else { NodeRef(-1) }
}

// FnTypeErrors は名前付き関数型の型宣言 decl の後置 `@errors` のラベル名の列（無ければ -1）と `@` の字句・宣言の package
func FnTypeErrors(st mut S, decl NodeRef) (ListRef, int, int) {
    body := nodeOf(mut st, nC(nodeOf(mut st, decl)))
    pk := FilePkg(mut st, refFile(int(decl)))
    if body.d == 0 {
        return -1, 0, pk
    }
    return ListRef(LBASE + LSTRS * LK + refFile(int(decl)) * FW + body.d - 1), body.e, pk
}

// FnTypeEffects は名前付き関数型の型宣言 decl の後置 `@effects` の項の列（無ければ -1）と `@` の字句・宣言の package
func FnTypeEffects(st mut S, decl NodeRef) (ListRef, int, int) {
    body := nodeOf(mut st, nC(nodeOf(mut st, decl)))
    pk := FilePkg(mut st, refFile(int(decl)))
    if body.f == 0 {
        return -1, 0, pk
    }
    return ListRef(LBASE + LSTRS * LK + refFile(int(decl)) * FW + body.f - 1), body.tok, pk
}

// LamYFn は値の位置のラムダ lam の期待型の表層型（関数型 YFn — 記録なしは -1）
func LamYFn(st mut S, lam NodeRef) int {
    i := lamRec(mut st, lam)
    return if i < 0 { -1 } else { table.Get(mut st.ylamY, i) }
}

// AnonFieldTE は型式の節 te が値の位置の匿名の関数型の欄の型か（lower の口 — 工程 5d）
func AnonFieldTE(st mut S, te NodeRef) bool {
    return anonFieldTE(mut st, te)
}

// CapCount は値の位置のラムダの捕捉の表の行数（loader の Program.cap_*）
func CapCount(st mut S) int {
    return len(st.capFile)
}

// CapLam は捕捉の表の i 行目のラムダの節
func CapLam(st mut S, i int) NodeRef {
    return NodeRef(ABASE + st.capFile[i] * FW + st.capNode[i])
}

// CapBrw は捕捉の表の i 行目のラムダの借りの仮引数のビット
func CapBrw(st mut S, i int) int {
    return st.capBrw[i]
}

// capPkAt は捕捉の名前の通しの添字 j の展開待ちの的（-1 = 普通の捕捉。詰めた列 capPend — loader.FnVals.cap_pend の形）
func capPkAt(st mut S, j int) int {
    if len(st.capPend) == 0 {
        return 0 - 1
    }
    return st.capPend[1 + j]
}

// capFlowAt は捕捉の表の i 行目が流れの行（的の仮引数へ流れる実引数のラムダ — 値の位置のラムダではない）か
func capFlowAt(st mut S, i int) bool {
    if len(st.capPend) == 0 {
        return false
    }
    return st.capPend[2 + st.capPend[0] + i] == 1
}

// CapBorrowArg は捕捉の表の i 行目が借りの実引数のラムダ（値の呼び出しの実引数 — loader の行の印 2）か（lower の口 — 匿名の関数型の鍵を借りの位置と
// 匿名の欄に分ける・report-1038 (c) 案 A）
func CapBorrowArg(st mut S, i int) bool {
    return len(st.capPend) > 0 && st.capPend[2 + st.capPend[0] + i] == 2
}

// CapPend は捕捉の表の i 行目の j 番目の捕捉の展開待ちの的（-1 = 普通の捕捉）
func CapPend(st mut S, i int, j int) int {
    return capPkAt(mut st, st.capLo[i] + j)
}

// CapMut は捕捉の表の i 行目の j 番目の捕捉が mut の束縛の捕捉（(α-L1) — loader の印 -2）か
func CapMut(st mut S, i int, j int) bool {
    return capPkAt(mut st, st.capLo[i] + j) == -2
}

// CapMutAfter は名前 name の束縛（木の節 at）を、同じファイルで at より後ろの値の位置のラムダが mut で捕捉するか（lower の置き場の口 —
// 大きい捕捉セルを region に置く・report-1068）。名前で照合する近似（同じファイルの後ろの別の関数の同名の捕捉も拾う）— 外れても置き場だけ
func CapMutAfter(st mut S, name StrRef, at NodeRef) bool {
    if !isTreeNode(int(at)) || len(st.capPend) == 0 {
        return false
    }
    f := refFile(int(at))
    ix := refIdx(int(at))
    for i <- iter.Range(0, len(st.capFile)) {
        if st.capFile[i] == f && st.capNode[i] > ix {
            for j <- iter.Range(st.capLo[i], st.capHi[i]) {
                if capPkAt(mut st, j) == -2 && strIs(mut st, name, st.capNames[j]) {
                    return true
                }
            }
        }
    }
    return false
}

// CapNameRef は捕捉の表の i 行目の j 番目の捕捉の名前（ヒープの文字列 — `mut z` の実引数だけの捕捉は識別子の節が無い）
func CapNameRef(st mut S, i int, j int) StrRef {
    return strOf(mut st, bytes(st.capNames[st.capLo[i] + j]))
}

// CapFlow は capFlowAt の lower の口
func CapFlow(st mut S, i int) bool {
    return capFlowAt(mut st, i)
}

// PendN / PendRow は的 q へ流れる行の数と k 番目の行
func PendN(st mut S, q int) int {
    qb := 2 + st.capPend[0] + st.capPend[1 + st.capPend[0]]
    nq := st.capPend[qb]
    return st.capPend[qb + 1 + nq + q] - st.capPend[qb + 1 + q]
}

func PendRow(st mut S, q int, k int) int {
    qb := 2 + st.capPend[0] + st.capPend[1 + st.capPend[0]]
    nq := st.capPend[qb]
    return st.capPend[qb + 1 + 2 * nq + st.capPend[qb + 1 + q] + k]
}

// CapIdents は捕捉の表の i 行目のラムダの捕捉の名前ごとに、本体での最初の出現の識別子の節（捕捉の並び — 型は表層型の表で引く）
func CapIdents(st mut S, i int) ListRef {
    lo := st.capLo[i]
    hi := st.capHi[i]
    out := ListRef(listN(mut st, hi - lo))
    body := nB(nodeOf(mut st, CapLam(mut st, i)))
    for j <- iter.Range(lo, hi) {
        lput(mut st, out, j - lo, int(identNamed(mut st, body, st.capNames[j], false)))
    }
    return out
}

// CapNodes は CapIdents の、`mut x` / `mut x.f` の実引数（EMutArg — 根の名前）にも当たる版（analyzer の口 — 借りのラムダの mut の捕捉は
// `mut z` で渡すだけのこともある。(α-L1)）
func CapNodes(st mut S, i int) ListRef {
    lo := st.capLo[i]
    hi := st.capHi[i]
    out := ListRef(listN(mut st, hi - lo))
    body := nB(nodeOf(mut st, CapLam(mut st, i)))
    for j <- iter.Range(lo, hi) {
        lput(mut st, out, j - lo, int(identNamed(mut st, body, st.capNames[j], true)))
    }
    return out
}

// identNamed は木 n の中で名前が s の最初の識別子の節（無ければ -1 — 影の禁止により中の束縛と衝突しない）
func identNamed(st mut S, n NodeRef, s string, m bool) NodeRef {
    if n == -1 {
        return -1
    }
    x := nodeOf(mut st, n)
    if x.kind == ast.EIdent {
        return if strIs(mut st, sA(x), s) { n } else { -1 }
    }
    if m && x.kind == ast.EMutArg {
        return if strIs(mut st, latS(mut st, DotParts(mut st, x.a), 0), s) { n } else { -1 }
    }
    c := pcDesc(mut st, x)
    for j <- iter.Range(0, 6) {
        d := c / pow8(j) % 8
        v := pcField(x, j)
        if d == 1 && v != -1 {
            r := identNamed(mut st, NodeRef(v), s, m)
            if r != -1 {
                return r
            }
        } else if d == 3 && v != -1 {
            for k <- iter.Range(0, lenL(mut st, ListRef(v))) {
                r := identNamed(mut st, latN(mut st, ListRef(v), k), s, m)
                if r != -1 {
                    return r
                }
            }
        }
    }
    return -1
}
