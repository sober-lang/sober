package diag

// 診断（C4 — reaudit 第 2 弾）: 位置 Pos と拒否の種類ごとの error ラベル（language.md 13 節 — 種類 = ラベルのタグ）、印字 Format。
// 層（loader / desugar / lower）は拒否をここのラベルで返し、app が Format で 1 行にする。位置は各層が手元の節（desugar の NodeRef・
// loader の字句）から raise の時点で Pos に落とす（ファイルは推測しない — 引けなければ -1）。
// ラベルは位置だけを持つ（文言は Format の腕 — string の欄を持たせると error? の全値が中身つきの境界コピーを背負う）。
// 溜める形（loader の NameHit・desugar の nomLog）は Pos か (ファイル, 字句) の組を別に持つ

import "lexer"
import "std/iter"

// Pos はファイル file（loader の Program のファイルの番号 — 無ければ -1）の字句 tok
type Pos struct {
    file int
    tok int
}

// None は位置の無い拒否の Pos
func None() Pos {
    return Pos{file: -1, tok: 0}
}

// ── desugar（脱糖器）の拒否 — 綴りは Zig 版の error 名 ──

// CoreFragment はコアの断片の外（型検査器が扱わない形）
type CoreFragment error {
    at Pos
}

// UnknownName は名前が引けない
type UnknownName error {
    at Pos
}

// Malformed は形が不正
type Malformed error {
    at Pos
}

// TypeMismatch は型宣言の区別の違反（language.md 32 節 — 表層型の照合）
type TypeMismatch error {
    at Pos
}

// ── lower の拒否（種類の綴りは Zig 版の error 名 — Undefined* は引けなかったものの種類ごと）──

type Unsupported error {
    at Pos
}

type UndefinedName error {
    at Pos
}

type UndefinedFunction error {
    at Pos
}

type UndefinedType error {
    at Pos
}

type UndefinedField error {
    at Pos
}

type Mismatch error {
    at Pos
}

type Missing error {
    at Pos
}

// ── loader の拒否（1 ラベル 1 文言 — 文言は Format）──

type ReadFail error {
    at Pos
}

type GrammarMismatch error {
    at Pos
}

type NoPkgDir error {
    at Pos
}

type NoStd error {
    at Pos
}

type EmbedReceiver error {
    at Pos
}

type EmbedPattern error {
    at Pos
}

type EmbedNoMatch error {
    at Pos
}

type EmbedPathUtf8 error {
    at Pos
}

type EmbedRead error {
    at Pos
}

type EmbedFileUtf8 error {
    at Pos
}

type PkgName error {
    at Pos
}

type RefCollide error {
    at Pos
}

// NotImported は修飾名の参照名をそのファイルが import していない（import はファイルごと — language.md 20 節）
type NotImported error {
    at Pos
}

type ImportCycle error {
    at Pos
}

type Noinline error {
    at Pos
}

type ErrorHoldsError error {
    at Pos
}

type ConstExpr error {
    at Pos
}

type LocalBuiltin error {
    at Pos
}

type LocalImport error {
    at Pos
}

type LocalTop error {
    at Pos
}

type TParamBuiltin error {
    at Pos
}

type TParamTop error {
    at Pos
}

type DeclBuiltin error {
    at Pos
}

type VariantDup error {
    at Pos
}

type Shadow error {
    at Pos
}

type PureExprStmt error {
    at Pos
}

// At は拒否 err の位置（ここのラベルでなければ None）
func At(err error?) Pos {
    mut p := None()
    if err != nil {
        switch err {
        case CoreFragment{at}:
            p = at
        case UnknownName{at}:
            p = at
        case Malformed{at}:
            p = at
        case TypeMismatch{at}:
            p = at
        case Unsupported{at}:
            p = at
        case UndefinedName{at}:
            p = at
        case UndefinedFunction{at}:
            p = at
        case UndefinedType{at}:
            p = at
        case UndefinedField{at}:
            p = at
        case Mismatch{at}:
            p = at
        case Missing{at}:
            p = at
        case ReadFail{at}:
            p = at
        case GrammarMismatch{at}:
            p = at
        case NoPkgDir{at}:
            p = at
        case NoStd{at}:
            p = at
        case EmbedReceiver{at}:
            p = at
        case EmbedPattern{at}:
            p = at
        case EmbedNoMatch{at}:
            p = at
        case EmbedPathUtf8{at}:
            p = at
        case EmbedRead{at}:
            p = at
        case EmbedFileUtf8{at}:
            p = at
        case PkgName{at}:
            p = at
        case RefCollide{at}:
            p = at
        case NotImported{at}:
            p = at
        case ImportCycle{at}:
            p = at
        case Noinline{at}:
            p = at
        case ErrorHoldsError{at}:
            p = at
        case ConstExpr{at}:
            p = at
        case LocalBuiltin{at}:
            p = at
        case LocalImport{at}:
            p = at
        case LocalTop{at}:
            p = at
        case TParamBuiltin{at}:
            p = at
        case TParamTop{at}:
            p = at
        case DeclBuiltin{at}:
            p = at
        case VariantDup{at}:
            p = at
        case Shadow{at}:
            p = at
        case PureExprStmt{at}:
            p = at
        default:
            p = None()
        }
    }
    return p
}

// Format は拒否 err の 1 行（where = At(err) の `<path>:<行>:<列>` — Where）:
// `desugar error at <where> (<種類>)`・`lower error at <where> (<種類>)`・`load error: <理由>`（位置があれば `load error at <where>: <理由>`）
func Format(err error?, where string) string {
    mut s := "error"
    mut why := ""
    if err != nil {
        switch err {
        case CoreFragment{at}:
            s = "desugar error at ${where} (CoreFragment)"
        case UnknownName{at}:
            s = "desugar error at ${where} (UnknownName)"
        case Malformed{at}:
            s = "desugar error at ${where} (Malformed)"
        case TypeMismatch{at}:
            s = "desugar error at ${where} (TypeMismatch)"
        case Unsupported{at}:
            s = "lower error at ${where} (Unsupported)"
        case UndefinedName{at}:
            s = "lower error at ${where} (UndefinedName)"
        case UndefinedFunction{at}:
            s = "lower error at ${where} (UndefinedFunction)"
        case UndefinedType{at}:
            s = "lower error at ${where} (UndefinedType)"
        case UndefinedField{at}:
            s = "lower error at ${where} (UndefinedField)"
        case Mismatch{at}:
            s = "lower error at ${where} (Mismatch)"
        case Missing{at}:
            s = "lower error at ${where} (Missing)"
        case ReadFail{at}:
            why = "cannot read file"
        case GrammarMismatch{at}:
            why = "source does not match the grammar"
        case NoPkgDir{at}:
            why = "cannot open package directory"
        case NoStd{at}:
            why = "no such std package"
        case EmbedReceiver{at}:
            why = "@embed needs the receiver `map[string]string{}` (empty, imm)"
        case EmbedPattern{at}:
            why = "invalid @embed pattern"
        case EmbedNoMatch{at}:
            why = "@embed pattern matches no file"
        case EmbedPathUtf8{at}:
            why = "@embed path is not valid UTF-8"
        case EmbedRead{at}:
            why = "@embed cannot read file"
        case EmbedFileUtf8{at}:
            why = "@embed file is not valid UTF-8"
        case PkgName{at}:
            why = "package name must match the directory name"
        case RefCollide{at}:
            why = "import reference name collides (use an alias)"
        case NotImported{at}:
            why = "this file does not import the package it names (imports are per file — add the import to this file)"
        case ImportCycle{at}:
            why = "import cycle"
        case Noinline{at}:
            why = "@noinline applies to a function with mut parameters and no function-typed parameters"
        case ErrorHoldsError{at}:
            why = "an error label cannot hold an error"
        case ConstExpr{at}:
            why = "const expression"
        case LocalBuiltin{at}:
            why = "a local binding cannot reuse a builtin name (len, shape, println, await, freeze, keys, bytes, true, false, append, delete)"
        case LocalImport{at}:
            why = "a local binding cannot reuse an import reference name"
        case LocalTop{at}:
            why = "a local binding cannot reuse a top-level name (const, func or type)"
        case TParamBuiltin{at}:
            why = "a type parameter cannot reuse a builtin name"
        case TParamTop{at}:
            why = "a type parameter cannot reuse a top-level type name"
        case DeclBuiltin{at}:
            why = "a top-level declaration cannot reuse a builtin name"
        case VariantDup{at}:
            why = "a variant name must be unique among the package's top-level names"
        case Shadow{at}:
            why = "a local binding cannot shadow or redeclare another local binding"
        case PureExprStmt{at}:
            why = "an expression statement must be a call: the value of a pure expression is unused (bind or assign it, or remove it)"
        default:
            s = "error"
        }
    }
    if why != "" {
        s = if At(err).file >= 0 { "load error at ${where}: ${why}" } else { "load error: ${why}" }
    }
    return s
}

// Where はファイル path（ソース src）の字句 tok の `<path>:<行>:<列>`（tok が字句の範囲外なら `token <tok>`）
func Where(path string, src []int, tok int) string {
    toks := lexer.Lex(src)
    if tok < 0 || tok >= len(toks) {
        return "token ${tok}"
    }
    at := toks[tok].start
    mut line := 1
    mut col := 1
    for i <- iter.Range(0, at) {
        if src[i] == 10 {
            line += 1
            col = 1
        } else {
            col += 1
        }
    }
    return "${path}:${line}:${col}"
}
