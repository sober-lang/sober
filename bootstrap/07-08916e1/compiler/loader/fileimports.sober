package loader

// import はファイルごと（language.md 20 節 — Go と同じ。ユーザー裁定 2026-10-01）: ファイルに書いた修飾名 `ref.N`（式の選択子・型名・
// 型パターン・composite の型名・@errors のラベル名）の参照名 ref は、そのファイル自身の import 宣言に要る（同じ package の別ファイルの
// import は見えない — そのファイルを読むだけで参照名が分かる）。解決（desugar.ImportOf・fileImportOf）もファイル単位で、ここは
// 拒否の位置と文言を 1 か所で出すための検査。同じ package で同じ参照名に別の path（RefCollide）と、局所名と別ファイルの import 名の
// 衝突（LocalImport）は package 単位の拒否のまま（Go より狭い側 — ナビ裁定）

import "ast"
import "diag"
import "std/iter"

// notImportedHit は最初の違反（ファイル・字句 — 無ければ file = -1）
func notImportedHit(cx Cx) NameHit {
    for f <- iter.Range(0, len(cx.trees)) {
        t := cx.trees[f]
        for i <- iter.Range(0, len(t.nodes)) {
            x := t.nodes[i]
            mut bad := false
            if x.kind == ast.ESelector && x.a >= 0 && t.nodes[x.a].kind == ast.EIdent {
                bad = missing(cx, f, Name(t, t.nodes[x.a].a))
            } else if (x.kind == ast.TName || x.kind == ast.TGeneric || x.kind == ast.EComposite) && x.a >= 0 {
                bad = missingDotted(cx, f, Name(t, x.a))
            } else if x.kind == ast.KPType && x.b >= 0 {
                bad = missingDotted(cx, f, Name(t, x.b))
            }
            if bad {
                return NameHit{f, x.tok, diag.NotImported{at: diag.Pos{f, x.tok}}}
            }
            if x.kind == ast.KFuncDecl && x.f >= 0 && ast.ListLen(t, x.f) >= 7 {
                raw := ast.ListAt(t, x.f, 5)
                if raw >= 0 {
                    for k <- iter.Range(0, ast.ListLen(t, raw)) {
                        if missingDotted(cx, f, Name(t, ast.ListAt(t, raw, k))) {
                            return NameHit{f, ast.ListAt(t, x.f, 6), diag.NotImported{at: diag.Pos{f, ast.ListAt(t, x.f, 6)}}}
                        }
                    }
                }
            }
        }
    }
    return noHit()
}

// missing は参照名 ref が package の import の参照名なのに、ファイル f 自身は import していないか
func missing(cx Cx, f int, ref string) bool {
    return importOf(cx, cx.file_pkg[f], ref) >= 0 && fileImportOf(cx, f, ref) < 0
}

// missingDotted は名前 s が `ref.N` で、ref について missing か
func missingDotted(cx Cx, f int, s string) bool {
    b := bytes(s)
    mut dot := 0 - 1
    for i <- iter.Range(0, len(b)) {
        if b[i] == 46 && dot < 0 {
            dot = i
        }
    }
    return dot >= 0 && missing(cx, f, cut(s, 0, dot))
}
