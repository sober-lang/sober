package main

// `sober check` の handler と check の道（一括 / 小分け / 関数単位キャッシュ・L0・前段の並走）— watch もこの道で検査し直す

import "std/io"
import "std/hex"
import "std/hash"
import "std/iter"
import "std/os"
import "std/cli"
import "std/strings"
import "std/task"
import "loader"
import "lower"
import "desugar"
import "checker"
import "iface"
import "analyzer"

// p を脱糖して検査する（判定 JSON は checker.Out・拒否の位置は checker.At。脱糖の拒否なら diag のラベル）。関数に割るのは脱糖器のヒープの region を分けるため（sobercheck と同じ）
func check(p loader.Program) (checker.E2Out, error?) {
    return checkW(p, false)
}

// check に watch の印 wc を足したもの
func checkW(p loader.Program, wc bool) (checker.E2Out, error?) {
    return checkWC(p, wc, ckNoCache())
}

// check の道で load の前に開いた置き場（P0 と analyzer の γ と D が同じ表を使う）と parse の読みの結果（書く木の候補）。
// ok = false なら check の子が置き場を開く（load が置き場を読まない道 — 逐次の開発の口など）
type CkCache struct {
    ok bool
    v lower.BcView
    pcs []loader.PcPut
}

func ckNoCache() CkCache {
    return CkCache{ok: false, v: lower.BcOpen(""), pcs: []loader.PcPut{}}
}

// checkW に load の前に開いた置き場 cc を足したもの
func checkWC(p loader.Program, wc bool, cc CkCache) (checker.E2Out, error?) {
    // E2-S の逃げの周回込み（checker/e2s.sober — 周回ごとに脱糖器のヒープの region を捨てる）。L0 がプログラムの std を全部持てば std の Def は
    // 検査しない（受理印は焼き込みが運ぶ — 逃げは焼き込みの .sobi の `@expand`）
    l0 := L0
    trust := l0On() && l0Complete(p, l0)
    dir := checkCacheDir(wc)
    if dir != "" {
        return checkCached(p, trust, if trust { l0Excl(p, l0) } else { []int{} }, dir, if cc.ok { cc } else { CkCache{ok: true, v: lower.BcOpen(dir), pcs: []loader.PcPut{}} })
    }
    if trust {
        return checker.RunE2(p, true, l0Excl(p, l0), desugarPar())
    }
    return checker.RunE2(p, false, []int{}, desugarPar())
}

// check の関数単位キャッシュの道（既定 on — SOBER_CHECK_CACHE=0 で切れる・置き場 = build と同じ世代のディレクトリの切り口 D）:
// 置き場を読んで判定し、外れの値（脱糖の拒否も）を書く。検証モード（SOBER_CACHE_VERIFY=1）の食い違いは名指しして落ちる・SOBER_CACHE_STAT=1 なら当否を標準エラーへ
func checkCached(p loader.Program, trust bool, excl0 []int, dir string, ca CkCache) (checker.E2Out, error?) {
    v := ca.v
    pps := lower.BcParseCheck(v, ca.pcs)
    cc := checker.CkWith(lower.BcCheckView(v), bytes(buildCacheGen()), envIs("SOBER_CACHE_VERIFY", "2"))
    r := checker.RunE2C(p, trust, excl0, desugarPar(), cc)?
    st := checker.Stale(r)
    if len(st) > 0 {
        for i <- st {
            _ = io.WriteStderr(bytes("cache: stale entry check-def ${i}\n"))
        }
        panic(InvariantBroken{})
    }
    c := checker.CkCount(r)
    ps := checker.Puts(r)
    if envIs("SOBER_CACHE_STAT", "1") {
        _ = io.WriteStderr(bytes("cache: check-def ${c[0]}/${c[0] + c[1]} ranges=${c[2]} put=${len(ps)} parse=${len(ca.pcs) - len(pps)}/${len(ca.pcs)}\n"))
    }
    lower.BcWriteD(dir, ps, pps, c[0] == 0)
    // 脱糖の拒否（拒否の値も書いてから返す）
    rerr := checker.RejErr(r)
    if rerr != nil {
        return r, rerr
    }
    return r, nil
}

// check の関数単位キャッシュの世代のディレクトリ（既定で使う — SOBER_CHECK_CACHE=0 で切れる。build の置き場と同じ世代。無ければ ""）
func checkCacheDir(wc bool) string {
    if envIs("SOBER_CHECK_CACHE", "0") {
        return ""
    }
    root := buildCacheRoot()
    gen := buildCacheGen()
    if root == "" || gen == "" {
        return ""
    }
    return "${root}/${gen}"
}

// 環境変数 name が w か
func envIs(name string, w string) bool {
    v, err := os.Getenv(name)
    if err != nil {
        return false
    }
    if v != nil {
        return v == w
    }
    return false
}

// 検査器の拒否の位置の診断（stderr の 1 行 — 判定 JSON〔stdout〕は Lean と同じまま。受理・位置が無ければ空）。
// 語は build の同じ誤りと揃える（`type error at <where>` — docs/language.md の診断の節）
func rejLines(p loader.Program, std map[string]string, r checker.E2Out) []string {
    out := checker.Out(r)
    if verdictOk(out) || len(out) == 0 || out[0] != '{' {
        return []string{}
    }
    at := desugar.UnpackPos(checker.At(r))
    // 位置の無い拒否（合成の関数の中など — 網 checkpos が数える）も行は出す（検査器の拒否は必ず stderr に 1 行）
    if at.file < 0 || at.file >= len(p.file_path) {
        return []string{"sober: type error (no source position)"}
    }
    // 合成のファイル（`$json/…` など — 型の宣言から生成したコード）はソースが無いので、生成コードの中だと名指す
    fp := p.file_path[at.file]
    return if strings.HasPrefix(fp, "$") { []string{"sober: type error in generated code ${fp}"} } else { []string{"sober: type error at ${where(p, std, at)}"} }
}

// check と同じ経路（L0 の信頼の有無）を脱糖まで走らせて止める（計測の口 — checkStop の 3）
func checkStopAll(p loader.Program, lvl int) ([]byte, error?) {
    l0 := L0
    if l0On() && l0Complete(p, l0) {
        return checker.CheckStop(p, -1, true, l0Excl(p, l0), lvl, desugarPar())
    }
    return checker.CheckStop(p, -1, false, []int{}, lvl, desugarPar())
}

// 計測の口（scripts/checkstats.sh）: 環境変数 SOBER_CHECK_STOP の段で check を止める（出力は空・終了コード 0）。
// 1 = load（読んで表層の写しまで）・2 = analyzer（一括の check だけ）・3 = desugar（脱糖して検査器の手前）・
// 4 = typer（脱糖の前段の後）・5 = defs（Def と根の脱糖の後・検査器への写しの前）・6 = init（前段の表層型検査器の前）・7 = typeall（表層型検査器の直後）・
// 0 = 止めない。4〜7 は判定の経路の区間の並列でも効く（親の計画 + 子ごとに止める）
func checkStop() int {
    v, err := os.Getenv("SOBER_CHECK_STOP")
    if err != nil || v == nil {
        return 0
    }
    return if v == "load" { 1 } else if v == "analyzer" { 2 } else if v == "desugar" { 3 } else if v == "typer" { 4 } else if v == "defs" { 5 } else if v == "init" { 6 } else if v == "typeall" { 7 } else { 0 }
}

// L0 が有効か（環境変数 SOBER_L0=0 で無効 — 照合用）
func l0On() bool {
    v, err := os.Getenv("SOBER_L0")
    if err != nil {
        return true
    }
    if v != nil {
        return v != "0"
    }
    return true
}

// L0 の package path の .sobi（無ければ ok = false）
func l0Get(l0 map[string]string, path string) ([]byte, bool) {
    v := l0["l0/${path}.sobi"]
    if v != nil {
        return bytes(v), true
    }
    return []byte{}, false
}

// p の std の package が全部 L0 にあるか（std を使わないプログラムは false — 信頼の経路に入る理由が無い）。std の package の
// _test.sober を読んだプログラム（`check std/<pkg> --test`）も false: 焼き込みの受理印は _test.sober を含まない — 信頼すると
// テストの本体を検査しない（受理されたのに test の build が落ちる形になる）
func l0Complete(p loader.Program, l0 map[string]string) bool {
    for f <- iter.Range(0, len(p.file_path)) {
        if strings.HasPrefix(p.pkg_path[p.file_pkg[f]], "std/") && strings.HasSuffix(p.file_path[f], "_test.sober") {
            return false
        }
    }
    mut any := false
    for k <- iter.Range(0, len(p.pkg_path)) {
        if strings.HasPrefix(p.pkg_path[k], "std/") {
            _, ok := l0Get(l0, p.pkg_path[k])
            if !ok {
                return false
            }
            any = true
        }
    }
    return any
}

// 焼き込みの std の .sobi の `@expand`（E2-S の逃げ）の関数の p の添字
func l0Excl(p loader.Program, l0 map[string]string) []int {
    mut out := mut []int{}
    for k <- iter.Range(0, len(p.fn_node)) {
        path := p.pkg_path[p.file_pkg[p.fn_file[k]]]
        if strings.HasPrefix(path, "std/") {
            src, ok := l0Get(l0, path)
            if ok && expandNamed(src, fnNameOf(p, k)) {
                out = append(out, k)
            }
        }
    }
    return freeze(out)
}

// p の関数 k の名前
func fnNameOf(p loader.Program, k int) string {
    t := p.trees[p.fn_file[k]]
    return loader.Name(t, t.nodes[p.fn_node[k]].a)
}

// .sobi src に `@expand` の付いた func name があるか（字面 — `@expand` の次の行が `func <name>(` / `func <name>[`）
func expandNamed(src []byte, name string) bool {
    return hasBytes(src, bytes("@expand\nfunc ${name}(")) || hasBytes(src, bytes("@expand\nfunc ${name}["))
}

func hasBytes(src []byte, w []byte) bool {
    mut i := 0
    while i + len(w) <= len(src) {
        mut k := 0
        while k < len(w) && src[i + k] == w[k] {
            k += 1
        }
        if k == len(w) {
            return true
        }
        i += 1
    }
    return false
}

// analyzer の指摘の行を拒否（errs）と警告（warns — 性能の lint。受理は変えない）に分けたもの
type AzLines struct {
    errs []string
    warns []string
}

// analyzer 層（受理の定義に含む — language.md 30 節）の指摘の行: 拒否は Zig 版と同じ形 `<位置>: error: <本文> (Analyzer)`（あれば判定 JSON は出さない）、
// 警告は `<位置>: warning: …`（受理した check だけが判定の前に stderr へ出す）。--core-json と開発用のフラグでは走らせない（Zig 版と同じ）
func analyzeAll(p loader.Program, std map[string]string) AzLines {
    return analyzeAllC(p, std, desugar.TyCacheOff())
}

// analyzeAll に置き場の切り口 γ を掛けた形（check の道）
func analyzeAllC(p loader.Program, std map[string]string, c desugar.TyCache) AzLines {
    fs := analyzer.RunC(p, c)
    loader.Stage("ck-analyzer")
    mut es := mut []string{}
    mut ws := mut []string{}
    for i <- iter.Range(0, len(fs)) {
        if fs[i].warn {
            ws = append(ws, "${where(p, std, fs[i].at)}: warning: ${fs[i].what} (Analyzer)")
        } else {
            es = append(es, "${where(p, std, fs[i].at)}: error: ${fs[i].what} (Analyzer)")
        }
    }
    return AzLines{freeze(es), freeze(ws)}
}

// 行を stderr へ（0 = 書けた）
func stderrLines(ws []string) int {
    for i <- iter.Range(0, len(ws)) {
        if io.WriteStderr(bytes("${ws[i]}\n")) != nil {
            return 1
        }
    }
    return 0
}

// p の検査の def error の Def の添字（[j] — 無ければ [-1]。region を分けるため関数に割る — check と同じ）
func defFail(p loader.Program) (checker.E2Out, error?) {
    return checker.DefFailE2(p)
}

// p を脱糖したコア AST の JSON（脱糖の拒否なら diag のラベル）。region を分けるため関数に割る（check と同じ）。
// 判定と同じコア（E2-S の逃げの集合を検査器で決めてから）を出す — Lean の照合（selfhost_check --lean・leanbatch）の入力
func coreJson(p loader.Program) ([]byte, error?) {
    excl := checker.ExclE2(p, desugarPar())?
    out, err := desugar.Json(p, true, excl)
    return out, err
}

// E2-S で上げない（全部展開の）コアの JSON（開発用 `--core-json-expanded`）
func coreJsonExpanded(p loader.Program) ([]byte, error?) {
    out, err := desugar.Json(p, false, []int{})
    return out, err
}

// 判定 JSON が受理（`{"ok":true` で始まる）か
func verdictOk(out []byte) bool {
    w := bytes("{\"ok\":true")
    if len(out) < len(w) {
        return false
    }
    for i <- iter.Range(0, len(w)) {
        if out[i] != w[i] {
            return false
        }
    }
    return true
}

// check の道の読み（置き場 v が開いていれば parse の木 P0 を引く）・2 つ目の戻り = ファイルごとの読みの結果（check の子が書く）。
// 積み先 sink はここで持つ（loadNamed と同じ — 読みの作業域を呼び手に残さない）
func loadCk(entry string, test bool, std map[string]string, v lower.BcView) (loader.Program, []loader.PcPut, error?) {
    mut sink := loader.PcSink{}
    p, lerr := loader.LoadFsC(entry, std, if v.on { lower.BcParseView(v) } else { loader.PcOff() }, test, mut sink)
    return p, loader.PcList(mut sink), lerr
}

// `sober check <entry> --pkg <path> --iface <dir> [--sigs]`（--sigs = 視点の関数の署名表 — G-d。package 単位の部分検査）: <dir>（iface -o の書き出し）の link.txt の順に
// package <path> だけソースから・他は .sobi から読み（loader.LoadView）、その package の Def だけを本体つきで検査した判定 JSON（checker.CheckPkgE2）。
// stage1 の --pkg と同じく analyzer は走らせない（analyzer の小分けは別の道）
func cmdCheckPkg(entry string, pkg string, dir string, sigs bool) int {
    std := Std
    p0, lerr := loader.LoadView(entry, pkg, dir, std)
    if lerr != nil {
        return fail(loadDiag(p0, std, lerr))
    }
    p, nerr := surface(p0)
    if nerr != nil {
        return fail(loadDiag(p, std, nerr))
    }
    if sigs {
        return writeStdout(iface.Sigs(p))
    }
    stop := checkStop()
    if stop == 1 || stop == 2 {
        return 0
    }
    for k <- iter.Range(0, len(p.pkg_path)) {
        if p.pkg_path[k] == pkg {
            if stop >= 3 {
                _, serr := checker.CheckStop(p, k, false, []int{}, stop, desugarPar())
                if serr != nil {
                    return fail(errDiag(p, std, serr))
                }
                return 0
            }
            r, cerr := checker.PkgE2(p, k, desugarPar())
            if cerr != nil {
                return fail(errDiag(p, std, cerr))
            }
            if stderrLines(rejLines(p, std, r)) != 0 {
                return 1
            }
            return writeStdout(checker.Out(r))
        }
    }
    return fail("no package ${pkg} in ${dir}/link.txt")
}

// 小分けの check（`sober check <entry> --split`）: 全体を 1 回読んで analyzer を一括で走らせ（error の
// ラベル集合の導出 — cause の合併 C[L]・error 型の欄の合併 — は依存する側の package も含む閉世界の合併で、package の中で閉じない点に注意）、
// 依存の順に package ごとの region で「依存の .sobi を読む（LoadViewMem）→ その package の Def だけ check（E2-S の周回込み）→ .sobi を外へ写す」を回す。
// 出力は一括の check と同じ（最初に落ちた package の判定か診断・全部受理なら main の判定）
// キャッシュ: 置き場 = cacheDir（SOBER_CACHE — 空文字なら無効）。package ごとに鍵を計算し、当たりなら
// その package の検査を飛ばして値（main 以外 = .sobi・main = 判定 JSON）を使う。外れて受理なら値を書く（拒否は書かない）。
// 検証モード（SOBER_CACHE_VERIFY=1）は当たりでも検査し直して値をバイト比較し、違えば stale と名指して落ちる（ゲートの網）。
// trace = `--cache-trace`（鍵と当否を標準エラーへ）
func checkSplit(entry string, trace bool, l0out string) int {
    use := trace || cacheDir() != ""
    self := if use { selfKey() } else { []byte{} }
    return emitRes(checkSplitR(entry, trace, l0out, self))
}

// check の結果（一括の `sober check`・`sober check --split`・`sober watch` が共有する — 出し方だけが違う）: code = 終了コード・out = 標準出力（判定 JSON）・
// msgs = 標準エラーの診断の行（`sober: ` の前置きは emitRes が付ける — 付けない行は analyzer の指摘）・files = 読んだ利用者のファイル（std を除く — watch が見張る）
type CheckRes struct {
    code int
    out []byte
    msgs []string
    files []string
}

// CheckRes を `sober check --split` の形で出す（診断は標準エラー・判定は標準出力）
func emitRes(r CheckRes) int {
    for i <- iter.Range(0, len(r.msgs)) {
        if io.WriteStderr(bytes("${r.msgs[i]}\n")) != nil {
            return 1
        }
    }
    if len(r.out) > 0 && writeStdout(r.out) != 0 {
        return 1
    }
    return r.code
}

func failRes(msg string, files []string) CheckRes {
    return CheckRes{1, []byte{}, []string{"sober: ${msg}"}, files}
}

// 小分けの check の本体（self = コンパイラの鍵）
func checkSplitR(entry string, trace bool, l0out string, self []byte) CheckRes {
    std := Std
    l0 := L0
    l0on := l0On() && l0out == ""
    dir := cacheDir()
    use := trace || dir != ""
    pl := splitPlan(entry, std, use)
    fs := pl.files
    if pl.code >= 0 {
        return CheckRes{pl.code, []byte{}, pl.msgs, fs}
    }
    verify := use && envOn("SOBER_CACHE_VERIFY")
    mut sobis := mut []loader.Sobi{}
    for i <- iter.Range(0, len(pl.order)) {
        path := pl.order[i]
        // L0（std の焼き込み — 鍵は要らない・L1 より先）→ L1（置き場）
        lk := lookupL0(l0on, l0, path, lookup(use, dir, self, path, pl, i, freeze(sobis)))
        if trace && traceLine(path, lk.key, lk.hit) != 0 {
            return CheckRes{1, []byte{}, []string{}, fs}
        }
        if lk.hit && !verify {
            if path == "main" {
                return CheckRes{0, lk.val, pl.msgs, fs}
            }
            sobis = append(sobis, loader.MakeSobi(path, lk.val))
        } else {
            r := splitOne(entry, path, pl.links[i], freeze(sobis), std)
            if r.code > 0 {
                if lk.hit {
                    return failRes("cache: stale entry for ${path} (${lk.key}) — the cached value says accepted, the check rejects", fs)
                }
                if r.code == 2 {
                    return failRes(r.msg, fs)
                }
                return CheckRes{r.code, r.out, if r.msg != "" { []string{r.msg} } else { []string{} }, fs}
            }
            val := if r.code == 0 { r.out } else { r.sobi }
            if lk.hit && !bytesEq(lk.val, val) {
                return failRes("cache: stale entry for ${path} (${lk.key}) — the cached value differs from the check", fs)
            }
            if use && !lk.hit && dir != "" {
                cachePut(dir, lk.key, val)
            }
            // --l0-out（stage2.sh の L0 の生成）: 計算した std の .sobi を <l0out>/<path>.sobi へ
            if l0out != "" && r.code < 0 && strings.HasPrefix(path, "std/") {
                op := "${l0out}/${path}.sobi"
                mkdirs(parentOf(op))
                if io.WriteFile(op, val) != nil {
                    return failRes("cannot write ${op}", fs)
                }
            }
            if r.code == 0 {
                return CheckRes{0, val, pl.msgs, fs}
            }
            sobis = append(sobis, loader.MakeSobi(path, val))
        }
    }
    return failRes("no main package", fs)
}

// 1 package のキャッシュの引き当て（key = 鍵・hit = 置き場に正しい値があった・val = その値）
type Lookup struct {
    key string
    hit bool
    val []byte
}

// std の package を L0 から引く（当たれば L1 の引き当て lk を置き換える — 鍵は印字用に残す）
func lookupL0(on bool, l0 map[string]string, path string, lk Lookup) Lookup {
    if !on || !strings.HasPrefix(path, "std/") {
        return lk
    }
    v, ok := l0Get(l0, path)
    if !ok {
        return lk
    }
    return Lookup{lk.key, true, v}
}

func lookup(use bool, dir string, self []byte, path string, pl SplitPlan, i int, sobis []loader.Sobi) Lookup {
    if !use {
        return Lookup{"", false, []byte{}}
    }
    key := pkgKey(self, path, pl.digests[i], pl.links[i], sobis)
    v := cacheGet(dir, key)
    return Lookup{key, v.ok, v.val}
}

// 小分けの順（依存が先）の package のパスと各々の視点のリンク集合。code >= 0 なら load / analyzer で終わった（その終了コード — 診断は msgs）。
// code < 0 の msgs は analyzer の警告（受理したときだけ判定の前に出す）。
// files = 読んだ利用者のファイル（std を除く — watch が見張る。load の拒否でも読めたところまで）
type SplitPlan struct {
    code int
    order []string
    links [][]string
    digests [][]byte   // package ごとの入力の要約（キャッシュの鍵の材料 — trace のときだけ。でなければ空）
    msgs []string
    files []string
}

// 全体を読んで analyzer を走らせ、小分けの順を決める（全体の Program はここの region で捨てる）
func splitPlan(entry string, std map[string]string, trace bool) SplitPlan {
    p, lerr := loadEntry(entry, false, std)
    fs := userFiles(p)
    if lerr != nil {
        return SplitPlan{1, []string{}, [][]string{}, [][]byte{}, []string{"sober: ${loadDiag(p, std, lerr)}"}, fs}
    }
    am := analyzeAll(p, std)
    if len(am.errs) > 0 {
        return SplitPlan{1, []string{}, [][]string{}, [][]byte{}, am.errs, fs}
    }
    ks := loader.SplitOrder(p)
    mut order := mut []string{}
    mut links := mut [][]string{}
    for i <- iter.Range(0, len(ks)) {
        order = append(order, p.pkg_path[ks[i]])
        links = append(links, loader.SplitLink(p, ks[i]))
    }
    mut digests := mut [][]byte{}
    if trace {
        for i <- iter.Range(0, len(ks)) {
            digests = append(digests, pkgDigest(p, ks[i], std))
        }
    }
    return SplitPlan{0 - 1, freeze(order), freeze(links), freeze(digests), am.warns, fs}
}

// p の利用者のファイル（std を除く）のパス
func userFiles(p loader.Program) []string {
    mut out := mut []string{}
    for f <- iter.Range(0, len(p.file_path)) {
        if f < len(p.file_std) && !p.file_std[f] {
            out = append(out, p.file_path[f])
        }
    }
    return freeze(out)
}

// 1 package の結果: code < 0 = 受理して続ける（sobi = その package の .sobi）・0 / 1 = 最後の判定 out で終わる（main の受理か拒否）・
// 2 = 診断 msg で終わる（1 の msg = 検査器の拒否の位置の行 — 空なら無し）
type SplitOne struct {
    code int
    out []byte
    msg string
    sobi []byte
}

func splitOne(entry string, pkg string, link []string, sobis []loader.Sobi, std map[string]string) SplitOne {
    p0, raw, lerr := loader.LoadViewMemRaw(entry, pkg, link, sobis, std)
    if lerr != nil {
        return SplitOne{2, []byte{}, loadDiag(p0, std, lerr), []byte{}}
    }
    p, nerr := surface(p0)
    if nerr != nil {
        return SplitOne{2, []byte{}, loadDiag(p, std, nerr), []byte{}}
    }
    k := pkgIndex(p, pkg)
    r, cerr := checker.PkgE2(p, k, desugarPar())
    if cerr != nil {
        return SplitOne{2, []byte{}, errDiag(p, std, cerr), []byte{}}
    }
    out := checker.Out(r)
    if !verdictOk(out) {
        rl := rejLines(p, std, r)
        return SplitOne{1, out, if len(rl) > 0 { rl[0] } else { "" }, []byte{}}
    }
    if pkg == "main" {
        return SplitOne{0, out, "", []byte{}}
    }
    // 生の木は視点の読み込みが parse したもの（ソースを読み直さない）
    return SplitOne{0 - 1, []byte{}, "", iface.Emit(p, k, checker.Excl(r), raw)}
}

func pkgIndex(p loader.Program, pkg string) int {
    for k <- iter.Range(0, len(p.pkg_path)) {
        if p.pkg_path[k] == pkg {
            return k
        }
    }
    return 0 - 1
}

// `sober check`（表 = Check）。既定の形（開発の口なし）と --test は判定、開発の口は 1 本ずつ（組は --pkg + --iface [+ --sigs]・
// --split [+ --l0-out <file> | --cache-trace] だけ — 他の組は misuse）
func cmdCheck(cl cli.Parsed) int {
    entry := cli.Pos(cl, Entry)
    pk := cli.StrOpt(cl, Pkg)
    pkg := if pk == nil { "" } else { pk }
    id := cli.StrOpt(cl, IfaceDir)
    idir := if id == nil { "" } else { id }
    sigs := cli.Bool(cl, Sigs)
    split := cli.Bool(cl, Split)
    lo := cli.StrOpt(cl, L0Out)
    l0out := if lo == nil { "" } else { lo }
    ctrace := cli.Bool(cl, CacheTrace)
    core := cli.Bool(cl, CoreJson)
    // 開発用: E2-S で上げない（全部展開の）コア — regionbound（G2 — 脱糖器と lower〔パスなし = 全部展開〕の region 境界の数の照合）の入力
    corex := cli.Bool(cl, CoreJsonX)
    tdiff := cli.Bool(cl, TyperDiff)
    nall := cli.Bool(cl, NominalAll)
    didx := cli.Bool(cl, DefIndex)
    edump := cli.Bool(cl, ErrorsDump)
    sdump := cli.Bool(cl, SecretDump)
    odump := cli.Bool(cl, OriginDump)
    fdump := cli.Bool(cl, EffectsDump)
    xrep := cli.Bool(cl, ExpReport)
    // 開発用: 関数ごとの費用（Def の本体・展開の寄与）と展開の辺・package の import の辺（関数単位の check キャッシュ — scripts の外の計器が閉包を数える）
    dcost := cli.Bool(cl, DefCost)
    // 開発用: 検査する Def ごとの鍵 K-D（関数単位の check キャッシュ — desugar/defkey.sober）・--def-graph は項目と辺も
    dgraph := cli.Bool(cl, DefGraph)
    dkeys := cli.ChoiceOpt(cl, CEmit) != nil || dgraph
    // 開発用: 外すと同じ点で暗黙の freeze になる明示の freeze の位置（暗黙 ≡ 明示のオラクル scripts/implicitfreeze.sh）
    fsites := cli.Bool(cl, FreezeSites)
    // 開発用: 暗黙の freeze の点の位置（std を含む — typer の表）
    ipts := cli.Bool(cl, ImplicitPts)
    // テストのビルド（entry = package のディレクトリ — 合成の main と _test.sober ごと検査する。T12）
    tst := cli.Bool(cl, CTest)
    withPkg := pk != nil || id != nil
    modes := []bool{withPkg, split, sigs && !withPkg, core, corex, tdiff, nall, didx, edump, sdump, odump, fdump, xrep, dcost, dkeys, fsites, ipts, tst}
    mut nmode := 0
    for m <- modes {
        nmode += if m { 1 } else { 0 }
    }
    if nmode > 1 || (cli.ChoiceOpt(cl, CEmit) != nil && dgraph) {
        return misuse("check: the development flags do not combine")
    }
    if (lo != nil || ctrace) && (!split || (lo != nil && ctrace)) {
        return misuse("check: --l0-out or --cache-trace goes with --split (one of them)")
    }
    if withPkg {
        if pk == nil || id == nil {
            return misuse("check: --pkg <path> and --iface <dir> go together")
        }
        return cmdCheckPkg(entry, pkg, idir, sigs)
    }
    if split {
        return checkSplit(entry, ctrace, l0out)
    }
    // 開発用: 関数の署名表（scripts/sobi.sh の G-d — 全体の表）
    if sigs {
        std := Std
        p, lerr := loadEntry(entry, false, std)
        if lerr != nil {
            return fail(loadDiag(p, std, lerr))
        }
        return writeStdout(iface.Sigs(p))
    }
    std := Std
    // 判定だけを出す既定の形は ParCheck ‖ analyzer ‖ check の並走（checkFront）。開発用のフラグ・計測の口・1 本の経路は逐次
    if nmode == 0 || tst {
        if checkStop() == 0 && desugarPar() {
            return checkFront(entry, tst, std)
        }
    }
    p, lerr := loadEntry(entry, tst, std)
    if lerr != nil {
        return fail(loadDiag(p, std, lerr))
    }
    if edump || sdump || odump || fdump {
        // 開発用: error のラベル集合の導出（compiler/analyzer の errors.sober — error 網羅 analyzer A2 の影）・秘密の値の流れの表 T（secret.sober）・
        // 出所の表（origin.sober — 源の口・Eff の関数・SH の variant と欄・出会いの口・違反）
        fs := if sdump { analyzer.SecretDump(p) } else if odump { analyzer.OriginDump(p) } else if fdump { analyzer.EffectsDump(p) } else { analyzer.ErrorsDump(p) }
        mut msg := ""
        for i <- iter.Range(0, len(fs)) {
            msg = if fs[i].at.file < 0 { msg + "${fs[i].what}\n" } else { msg + "${where(p, std, fs[i].at)}: ${fs[i].what}\n" }
        }
        return writeStdout(bytes(msg))
    }
    if xrep {
        // 開発用: 関数ごとの展開の寄与（コア式の節の数）の上位 40（desugar.ExpansionReport — コスト可視化の口）
        r, xerr := desugar.ExpansionReport(p, 40)
        if xerr != nil {
            return fail(errDiag(p, std, xerr))
        }
        return writeStdout(r)
    }
    if dkeys {
        l0 := L0
        trust := l0On() && l0Complete(p, l0)
        mut ex := mut []int{}
        xs := if trust { l0Excl(p, l0) } else { []int{} }
        for k <- iter.Range(0, len(xs)) {
            ex = append(ex, xs[k])
        }
        mk := loader.ExpandMarked(p)
        for k <- iter.Range(0, len(mk)) {
            ex = append(ex, mk[k])
        }
        r, kerr := desugar.DefKeys(p, freeze(ex), trust, selfKey(), dgraph)
        if kerr != nil {
            return fail(errDiag(p, std, kerr))
        }
        return writeStdout(r)
    }
    if dcost {
        r, xerr := desugar.DefCostDump(p, loader.ExpandMarked(p))
        if xerr != nil {
            return fail(errDiag(p, std, xerr))
        }
        mut ps := mut []byte{}
        for k <- iter.Range(0, len(p.pkg_path)) {
            appendBytes(mut ps, bytes("P ${k} ${p.pkg_path[k]}\n"))
        }
        for k <- iter.Range(0, len(p.imp_pkg)) {
            q := pkgIndex(p, p.imp_path[k])
            appendBytes(mut ps, bytes("I ${p.imp_pkg[k]} ${q}\n"))
        }
        appendBytes(mut ps, r)
        return writeStdout(freeze(ps))
    }
    if nall {
        // 開発用: 表層型の照合の拒否を全部（desugar.NominalAll — 1 件で止めない）
        r, derr := desugar.NominalAll(p)
        if derr != nil {
            return fail(errDiag(p, std, derr))
        }
        mut msg := "nominal ${len(r) / 2}\n"
        for i <- iter.Range(0, len(r) / 2) {
            msg = msg + "  ${srcPos(p, std, r[i * 2], r[i * 2 + 1])}\n"
        }
        return writeStdout(bytes(msg))
    }
    if fsites || ipts {
        ps := if fsites { desugar.FreezeSites(p) } else { desugar.ImplicitPoints(p) }
        mut out := ""
        for i <- iter.Range(0, len(ps)) {
            out = out + "${where(p, std, ps[i])}\n"
        }
        return writeStdout(bytes(out))
    }
    if didx {
        // 開発用: 検査の判定が def error なら、何番目の Def か（名前付き関数 → 持ち上げた Def の順）とその出所の位置
        r, derr := defFail(p)
        if derr != nil {
            return fail(errDiag(p, std, derr))
        }
        j := checker.Def(r)
        // E2-S の逃げの周回（docs/formal.md「check の callM の段」の条件 6）の数と展開へ戻した関数の数
        e2 := " (e2s: rounds=${checker.Rounds(r)} back=${len(checker.Excl(r))})"
        if j == -2 {
            return writeStdout(bytes("checker: too deep${e2}\n"))
        }
        if j < 0 {
            return writeStdout(bytes("no def error${e2}\n"))
        }
        at, aerr := desugar.DefAt(p, checker.Excl(r), j)
        if aerr != nil {
            return fail(errDiag(p, std, aerr))
        }
        // 確定した周回で落ちた Def の全部（最初の 1 件以外も — 2 件目以降は位置だけ）
        mut more := ""
        fs := checker.Fails(r)
        for k <- iter.Range(0, len(fs)) {
            if fs[k] != j {
                a2, e2err := desugar.DefAt(p, checker.Excl(r), fs[k])
                if e2err == nil {
                    more = more + "  also def ${fs[k]} at ${where(p, std, a2)}\n"
                }
            }
        }
        return writeStdout(bytes("def error: def ${j} at ${where(p, std, at)}${e2}\n${more}"))
    }
    if tdiff {
        // 表層型検査器 × exprSty の突き合わせ（desugar.TyperDiff — C1 B3 の入口）
        r, derr := desugar.TyperDiff(p)
        if derr != nil {
            return fail(errDiag(p, std, derr))
        }
        mut msg := "typer-sty same=${r[0]} gain=${r[1]} loss=${r[2]} mismatch=${r[3]} skip=${r[4]} targs-same=${r[5]} targs-diff=${r[6]}\n"
        for i <- iter.Range(0, r[7]) {
            b := 8 + i * 4
            if r[b + 2] == 2 {
                msg = msg + "  ${srcPos(p, std, r[b], r[b + 1])} targs inferTs-ok=${r[b + 3] == 1}\n"
            } else {
                msg = msg + "  ${srcPos(p, std, r[b], r[b + 1])} lost=${r[b + 2] == 0} y=${r[b + 3]}\n"
            }
        }
        return writeStdout(bytes(msg))
    }
    if corex {
        cx, xerr := coreJsonExpanded(p)
        if xerr != nil {
            return fail(errDiag(p, std, xerr))
        }
        return writeStdout(cx)
    }
    if core {
        cj, cerr := coreJson(p)
        if cerr != nil {
            return fail(errDiag(p, std, cerr))
        }
        return writeStdout(cj)
    }
    stop := checkStop()
    if stop == 1 {
        return 0
    }
    az := analyzeAll(p, std)
    if len(az.errs) > 0 {
        _ = stderrLines(az.errs)
        return 1
    }
    if stop == 2 {
        return 0
    }
    if stop >= 3 {
        _, serr := checkStopAll(p, stop)
        if serr != nil {
            return fail(errDiag(p, std, serr))
        }
        return 0
    }
    r, cerr := check(p)
    if cerr != nil {
        return fail(errDiag(p, std, cerr))
    }
    out := checker.Out(r)
    if stderrLines(az.warns) != 0 || stderrLines(rejLines(p, std, r)) != 0 || writeStdout(out) != 0 {
        return 1
    }
    return if verdictOk(out) { 0 } else { 1 }
}

// checkFront の並走の合流（kind 0 = 判定 out を出す〔msgs = analyzer の警告 — stderr へ先に〕・1 = 診断 msgs〔`sober: ` を付ける〕で 1・2 = analyzer の指摘 msgs〔前置きなし〕で 1）
type FrontRes struct {
    kind int
    msgs []string
    out []byte
}

// check の子の結果（msg = 脱糖の拒否の診断・"" なら判定 out）
type CkMsg struct {
    out []byte
    msg string
    rej []string   // 検査器の拒否の位置の行（rejLines）
}

// `sober check <entry>` の既定の形: 読んで名前付き実引数を写した後、
// ParCheck（std/task の呼び出し点の形 — load の拒否の層）・analyzer・check（脱糖 + 検査）を 3 つの子で並走させ、親が逐次の優先順で畳む:
// ParCheck の拒否 > analyzer の指摘 > check の結果（逐次では前の層が拒否すれば後ろの層は走らない — 後ろの子の結果は捨てるだけで値は同じ）。
// 子は印字しない（診断の行の文字列を返す — ソースの読み直しは読みの io だけ）。どれかの子が死んだら（前の層が拒否した入力で後ろの層が死ぬ形を含む）
// 結果を全部捨てて逐次の経路で走らせ直す（死の順・死因も逐次と同じ）。
// budget: = 木の節の数 × 係数 + 余白（親で計算 — 宣言の段。校正 = 自己 check〔37 万節〕の実測: ParCheck 15 MB・analyzer 3.8 MB・check は自分 2.4 MB +
// 区間の子の最大 197 MB〔逐次の上界は子を含む〕→ 64 / 16 / 768 B / 節 — どれも 1.5〜2.6 倍の側。analyzer は表層型の表〔TypeAll —
// 暗黙の freeze の点〕を組むので ParCheck の分を足して 80）
func checkFront(entry string, tst bool, std map[string]string) int {
    dir := checkCacheDir(false)
    key := replayKey(entry, tst)
    verify := envIs("SOBER_CACHE_VERIFY", "1") || envIs("SOBER_CACHE_VERIFY", "2")
    if dir != "" && !envIs("SOBER_CHECK_REPLAY", "0") {
        hit := replayGet(dir, key)
        if hit.ok && !verify {
            replayStat("1/1")
            return emitRes(hit.res)
        }
        r := checkFrontR(entry, tst, std, false)
        if hit.ok && !resEq(hit.res, r) {
            _ = io.WriteStderr(bytes("cache: stale entry check-replay ${key}\n"))
            panic(InvariantBroken{})
        }
        replayStat(if hit.ok { "1/1" } else { "0/1" })
        replayPut(dir, key, r)
        return emitRes(r)
    }
    return emitRes(checkFrontR(entry, tst, std, false))
}

// ── 答えの再生（watch 温め係 — docs/incremental.md）──
//
// 既定の `sober check <entry>` の答え（終了コード・標準出力・診断の行）を置き場に丸ごと覚え、次の同じ問い合わせは検査せずに返す。
// 鍵 = entry の綴り ‖ test の印 ‖ 答えに効く宣言済みの環境変数（置き場は世代のディレクトリ — コンパイラが変われば別）。値には答えと一緒に
// 読んだ利用者のファイルの中身のハッシュと、そのディレクトリの .sober の名前の列のハッシュを持ち、引くときに全部を照合する（1 つでも違えば外れ —
// ファイルの編集・追加・削除を拾う）。std は焼き込みなので世代が持つ。@embed を持つファイルは埋め込みの入力（パターンの一致と中身 —
// loader.EmbedInputs）のハッシュも持って照合する

// 答えに効かない環境変数（置き場・計測・watch の口）— 鍵に入れない
const replayEnvSkip = []string{"SOBER_CACHE", "SOBER_CACHE_MAX", "SOBER_CACHE_GENS", "SOBER_CACHE_FLOOR", "SOBER_CACHE_STAT", "SOBER_CACHE_VERIFY",
    "SOBER_CACHE_FSCK", "SOBER_CHECK_CACHE", "SOBER_CHECK_REPLAY", "SOBER_BUILD_CACHE", "SOBER_SELF_KEY", "SOBER_WATCH_MS",
    "SOBER_WATCH_QUIET", "SOBER_WATCH_BUILD", "SOBER_WATCH_TEST", "SOBER_COVER"}

func replayKey(entry string, tst bool) string {
    return replayKeyOf("check-replay 1", entry, tst)
}

// replayKey の形を kind（check / build）で分けたもの
func replayKeyOf(kind string, entry string, tst bool) string {
    mut b := mut []byte{}
    lenPut(mut b, bytes(kind))
    lenPut(mut b, bytes(entry))
    lenPut(mut b, bytes(if tst { "test" } else { "" }))
    for i <- iter.Range(0, len(Sober.env)) {
        name := Sober.env[i].name
        if !hasStr(replayEnvSkip, name) {
            v, err := os.Getenv(name)
            if err == nil && v != nil {
                lenPut(mut b, bytes(name))
                lenPut(mut b, bytes(v))
            }
        }
    }
    return hex.Format(hash.Sha256(freeze(b)))
}

func replayStat(s string) {
    replayStatOf("check", s)
}

func replayStatOf(kind string, s string) {
    if envIs("SOBER_CACHE_STAT", "1") {
        _ = io.WriteStderr(bytes("cache: ${kind}-replay ${s}\n"))
    }
}

// 引き当ての結果（ok = 照合まで通った・res = 覚えた答え）
type Replay struct {
    ok bool
    res CheckRes
}

func noReplay() Replay {
    return Replay{false, CheckRes{0, []byte{}, []string{}, []string{}}}
}

// 読んだファイルのうちディスクにあるもの（loader が `@layout` から合成する `$layout/…` は元のソースが決めるので外す）
func realFiles(files []string) []string {
    mut out := mut []string{}
    for i <- iter.Range(0, len(files)) {
        if !strings.HasPrefix(files[i], "$") {
            out = append(out, files[i])
        }
    }
    return freeze(out)
}

// 読んだファイルのディレクトリの列（重複なし — 現れた順）
func replayDirs(files []string) []string {
    mut out := mut []string{}
    for i <- iter.Range(0, len(files)) {
        d := parentOf(files[i])
        if !hasStr(freeze(out), d) {
            out = append(out, d)
        }
    }
    return freeze(out)
}

// ディレクトリの .sober の名前の列のハッシュ（読めなければ ""）
func dirSum(d string) string {
    es := io.ReadDir(if d == "" { "." } else { d }) catch return ""
    mut b := mut []byte{}
    for i <- iter.Range(0, len(es)) {
        if strings.HasSuffix(es[i].Name, ".sober") {
            lenPut(mut b, bytes(es[i].Name))
        }
    }
    return hex.Format(hash.Sha256(freeze(b)))
}

// @embed を持つファイルの埋め込みの入力のハッシュ（持たなければ ""・parse できなければ "!"）
func embedSum(path string, b []byte) string {
    if !hasBytes(b, bytes("@embed(")) {
        return ""
    }
    t, ok := parseFile(path, b)
    return if ok { hex.Format(hash.Sha256(loader.EmbedInputs(t))) } else { "!" }
}

// 答え r を覚える（受理でも拒否でも — 使い方の誤り〔2〕・読んだファイルが無い・読めないときは覚えない）
func replayPut(dir string, key string, r CheckRes) {
    if r.code == 2 || len(r.files) == 0 {
        replayStat("skip (no files)")
        return
    }
    mut v := mut []byte{}
    fs := realFiles(r.files)
    ds := replayDirs(fs)
    lenPut(mut v, bytes("${len(fs)}"))
    for i <- iter.Range(0, len(fs)) {
        b := io.ReadFile(fs[i]) catch {
            replayStat("skip (cannot read ${fs[i]})")
            return
        }
        lenPut(mut v, bytes(fs[i]))
        lenPut(mut v, bytes(hex.Format(hash.Sha256(b))))
        lenPut(mut v, bytes(embedSum(fs[i], b)))
    }
    lenPut(mut v, bytes("${len(ds)}"))
    for i <- iter.Range(0, len(ds)) {
        sum := dirSum(ds[i])
        if sum == "" {
            replayStat("skip (cannot list ${ds[i]})")
            return
        }
        lenPut(mut v, bytes(ds[i]))
        lenPut(mut v, bytes(sum))
    }
    lenPut(mut v, bytes("${r.code}"))
    lenPut(mut v, r.out)
    lenPut(mut v, bytes("${len(r.msgs)}"))
    for i <- iter.Range(0, len(r.msgs)) {
        lenPut(mut v, bytes(r.msgs[i]))
    }
    cachePut(dir, key, freeze(v))
}

// lenPut の列を読み戻した結果（ok = 形が正しい）
type Fields struct {
    ok bool
    xs [][]byte
}

func lenFields(b []byte) Fields {
    mut xs := mut [][]byte{}
    mut q := 0
    while q < len(b) {
        mut n := 0
        mut d := q
        while d < len(b) && b[d] >= '0' && b[d] <= '9' {
            n = n * 10 + int(b[d]) - 48
            d += 1
        }
        if d == q || d >= len(b) || b[d] != ':' || d + 1 + n > len(b) {
            return Fields{false, [][]byte{}}
        }
        xs = append(xs, b[d + 1:d + 1 + n])
        q = d + 1 + n
    }
    return Fields{true, freeze(xs)}
}

func atoiOf(b []byte) int {
    mut n := 0
    mut neg := false
    for i <- iter.Range(0, len(b)) {
        if i == 0 && b[i] == '-' {
            neg = true
        } else {
            n = n * 10 + int(b[i]) - 48
        }
    }
    return if neg { 0 - n } else { n }
}

// 鍵の値を引き、読んだファイルとディレクトリを今の中身と照合する
func replayGet(dir string, key string) Replay {
    cv := cacheGet(dir, key)
    if !cv.ok {
        return noReplay()
    }
    fs := lenFields(cv.val)
    if !fs.ok || len(fs.xs) < 1 {
        return noReplay()
    }
    xs := fs.xs
    mut q := 0
    mut files := mut []string{}
    nf := atoiOf(xs[q])
    q += 1
    for i <- iter.Range(0, nf) {
        if q + 2 >= len(xs) {
            return noReplay()
        }
        path := string(xs[q]) catch return noReplay()
        b := io.ReadFile(path) catch return noReplay()
        if hex.Format(hash.Sha256(b)) != (string(xs[q + 1]) catch "") || embedSum(path, b) != (string(xs[q + 2]) catch "") {
            return noReplay()
        }
        files = append(files, path)
        q += 3
    }
    if q >= len(xs) {
        return noReplay()
    }
    nd := atoiOf(xs[q])
    q += 1
    for i <- iter.Range(0, nd) {
        if q + 1 >= len(xs) {
            return noReplay()
        }
        d := string(xs[q]) catch return noReplay()
        if dirSum(d) != (string(xs[q + 1]) catch "") {
            return noReplay()
        }
        q += 2
    }
    if q + 2 >= len(xs) {
        return noReplay()
    }
    code := atoiOf(xs[q])
    out := xs[q + 1]
    nm := atoiOf(xs[q + 2])
    q += 3
    mut msgs := mut []string{}
    for i <- iter.Range(0, nm) {
        if q >= len(xs) {
            return noReplay()
        }
        msgs = append(msgs, string(xs[q]) catch return noReplay())
        q += 1
    }
    return Replay{true, CheckRes{code, out, freeze(msgs), freeze(files)}}
}

// 2 つの答えが同じか（終了コード・標準出力・診断の行）
func resEq(a CheckRes, b CheckRes) bool {
    if a.code != b.code || !bytesEq(a.out, b.out) || len(a.msgs) != len(b.msgs) {
        return false
    }
    for i <- iter.Range(0, len(a.msgs)) {
        if a.msgs[i] != b.msgs[i] {
            return false
        }
    }
    return true
}

// checkFront の本体（出し方は emitRes — `sober watch` と共有する。wc = watch の印〔checkW〕・files = 読んだ利用者のファイル）
func checkFrontR(entry string, tst bool, std map[string]string, wc bool) CheckRes {
    // 関数単位キャッシュの置き場は load の前に 1 回開く（parse の木 P0・analyzer の全部の型付けの γ・check の D が同じ表を使う）
    dir := checkCacheDir(wc)
    cv := lower.BcOpen(dir)
    p0, pcs, lerr := loadCk(entry, tst, std, cv)
    cc := CkCache{ok: true, v: cv, pcs: pcs}
    loader.Stage("ck-load")
    if lerr != nil {
        return failRes(loadDiag(p0, std, lerr), userFiles(p0))
    }
    p, nerr := desugar.NamedValueArgs(p0)
    loader.Stage("ck-nva")
    fs := userFiles(p)
    if nerr != nil {
        return failRes(loadDiag(p, std, nerr), fs)
    }
    n := nodeCount(p)
    bpc := n * 64 + 4 * task.MB
    ban := n * 80 + 4 * task.MB
    bck := n * 768 + 16 * task.MB
    r, serr := task.Run((s task.Scope) => {
        hp := task.Spawn(s, () => pcMsg(p, std), budget: bpc)
        ha := task.Spawn(s, () => analyzeAllC(p, std, if cv.on { lower.BcGammaCache(cv, dir) } else { desugar.TyCacheOff() }), budget: ban)
        hc := task.Spawn(s, () => ckMsg(p, std, wc, cc), budget: bck)
        pm := switch task.Try(hp) {
        case task.Ok{v}: v
        case task.Failed{}: ""
        case task.Died{cause}: ""
        }
        al := switch task.Try(ha) {
        case task.Ok{v}: v
        case task.Failed{}: AzLines{[]string{}, []string{}}
        case task.Died{cause}: AzLines{[]string{}, []string{}}
        }
        ck := switch task.Try(hc) {
        case task.Ok{v}: v
        case task.Failed{}: CkMsg{[]byte{}, "", []string{}}
        case task.Died{cause}: CkMsg{[]byte{}, "", []string{}}
        }
        frontMerge(pm, al, ck)
    })
    if serr != nil {
        return checkSeqR(p, std, wc, fs, cc)
    }
    return frontRes(r, fs)
}

// 3 つの子の結果を逐次の優先順で 1 つに
func frontMerge(pm string, az AzLines, ck CkMsg) FrontRes {
    al := az.errs
    if pm != "" {
        return FrontRes{1, []string{pm}, []byte{}}
    }
    if len(al) > 0 {
        return FrontRes{2, al, []byte{}}
    }
    if ck.msg != "" {
        return FrontRes{1, []string{ck.msg}, []byte{}}
    }
    // analyzer の警告 → 検査器の拒否の位置の行（逐次の cmdCheck と同じ順）
    mut ms := mut []string{}
    for i <- iter.Range(0, len(az.warns)) {
        ms = append(ms, az.warns[i])
    }
    for i <- iter.Range(0, len(ck.rej)) {
        ms = append(ms, ck.rej[i])
    }
    return FrontRes{0, freeze(ms), ck.out}
}

// FrontRes を逐次の cmdCheck と同じ形の CheckRes に（emitRes が出す — 診断は `sober: ` つき・analyzer の指摘は前置きなし）
func frontRes(r FrontRes, fs []string) CheckRes {
    if r.kind == 1 {
        return failRes(r.msgs[0], fs)
    }
    if r.kind == 2 {
        return CheckRes{1, []byte{}, r.msgs, fs}
    }
    return CheckRes{if verdictOk(r.out) { 0 } else { 1 }, r.out, r.msgs, fs}
}

// checkFront の逐次の経路（子が死んだときの走らせ直し — ParCheck → analyzer → check の順。名前付き実引数の写しの後の p から）
func checkSeqR(p loader.Program, std map[string]string, wc bool, fs []string, cc CkCache) CheckRes {
    perr := desugar.ParCheck(p)
    if perr != nil {
        return failRes(loadDiag(p, std, perr), fs)
    }
    az := analyzeAllC(p, std, if cc.v.on { lower.BcGammaCache(cc.v, checkCacheDir(wc)) } else { desugar.TyCacheOff() })
    if len(az.errs) > 0 {
        return CheckRes{1, []byte{}, az.errs, fs}
    }
    r, cerr := checkWC(p, wc, cc)
    if cerr != nil {
        return failRes(errDiag(p, std, cerr), fs)
    }
    out := checker.Out(r)
    mut ms := mut []string{}
    for x <- az.warns {
        ms = append(ms, x)
    }
    for x <- rejLines(p, std, r) {
        ms = append(ms, x)
    }
    return CheckRes{if verdictOk(out) { 0 } else { 1 }, out, freeze(ms), fs}
}

// ParCheck の拒否の診断（"" = 受理）
func pcMsg(p loader.Program, std map[string]string) string {
    perr := desugar.ParCheck(p)
    loader.Stage("ck-parcheck")
    return if perr != nil { loadDiag(p, std, perr) } else { "" }
}

// check の結果（脱糖の拒否なら診断・検査器の拒否なら位置の行 rej）
func ckMsg(p loader.Program, std map[string]string, wc bool, cc CkCache) CkMsg {
    r, cerr := checkWC(p, wc, cc)
    loader.Stage("ck-check")
    if cerr != nil {
        return CkMsg{[]byte{}, errDiag(p, std, cerr), []string{}}
    }
    return CkMsg{checker.Out(r), "", rejLines(p, std, r)}
}

// p の木の節の数の和（checkFront の budget: の物差し）
func nodeCount(p loader.Program) int {
    mut n := 0
    for f <- iter.Range(0, len(p.trees)) {
        n += len(p.trees[f].nodes)
    }
    return n
}


// ── 小分けの check のキャッシュの鍵。鍵を計算して当否を印字するだけ（`check --split --cache-trace` —
// 置き場は読むだけで書かない）。
//   key(P) = SHA-256("sobercache 1" ‖ コンパイラの鍵 ‖ P のパス ‖ P の入力の要約 ‖ 視点のリンク集合の各依存 D について D のパス ‖ SHA-256(sobi(D)))
//   P の入力の要約 = SHA-256(P の各ファイルの パス ‖ 長さ ‖ SHA-256(中身) ‖ その木の @embed の入力)
// 依存の項は鍵でなく .sobi の中身のハッシュ（早期打ち切り — 依存の本体だけの編集で .sobi が変わらなければ P は当たる）。
// 長さの前置きで連結するので、区切りの取り違えで別の入力が同じ列にならない


// キャッシュの中身の形の版（形を変えたら上げる — 鍵の先頭に入る）
func cacheFormat() []byte {
    return bytes("sobercache 1")
}

// package path の鍵（16 進 64 桁）。digest = pkgDigest・link = 視点のリンク集合（ロード順 — path 自身を含む）・sobis = 依存の .sobi
func pkgKey(self []byte, path string, digest []byte, link []string, sobis []loader.Sobi) string {
    mut out := mut []byte{}
    lenPut(mut out, cacheFormat())
    lenPut(mut out, self)
    lenPut(mut out, bytes(path))
    lenPut(mut out, digest)
    for i <- iter.Range(0, len(link)) {
        if link[i] != path {
            lenPut(mut out, bytes(link[i]))
            lenPut(mut out, hash.Sha256(sobiOf(sobis, link[i])))
        }
    }
    return hex.Format(hash.Sha256(freeze(out)))
}

// sobis の中の package path の .sobi（無ければ空 — 依存の順に回すので起きない）
func sobiOf(sobis []loader.Sobi, path string) []byte {
    for i <- iter.Range(0, len(sobis)) {
        if sobis[i].path == path {
            return sobis[i].src
        }
    }
    return []byte{}
}

// 置き場 dir の鍵 key のファイル（`<dir>/sobercache-1/<先頭 2 桁>/<64 桁>` — cache-draft 5.2）
func cachePath(dir string, key string) string {
    b := bytes(key)
    head := string(b[0:2]) catch "00"
    return "${dir}/sobercache-1/${head}/${key}"
}

// 置き場から読んだ値（ok = 鍵の行と長さが合った）
type CacheVal struct {
    ok bool
    val []byte
}

// 置き場 dir の鍵 key の値。ファイルの形 = `sobercache 1 <鍵> <長さ> <値の SHA-256>\n` + 値（cache-draft 5.2）— 先頭の行の鍵・長さ・
// 値のハッシュが合わなければ外れ（書きかけ・壊れ・手での改竄 — 計算し直して上書きされる）。dir が空なら外れ
func cacheGet(dir string, key string) CacheVal {
    if dir == "" {
        return CacheVal{false, []byte{}}
    }
    b := io.ReadFile(cachePath(dir, key)) catch return CacheVal{false, []byte{}}
    pre := bytes("sobercache 1 ${key} ")
    if len(b) < len(pre) {
        return CacheVal{false, []byte{}}
    }
    for k <- iter.Range(0, len(pre)) {
        if b[k] != pre[k] {
            return CacheVal{false, []byte{}}
        }
    }
    mut n := 0
    mut q := len(pre)
    while q < len(b) && b[q] >= '0' && b[q] <= '9' {
        n = n * 10 + int(b[q]) - 48
        q += 1
    }
    // 長さの後ろは ` <値の SHA-256 の 16 進 64 桁>\n`
    if q == len(pre) || q + 66 > len(b) || b[q] != ' ' || b[q + 65] != '\n' || len(b) - q - 66 != n {
        return CacheVal{false, []byte{}}
    }
    v := b[q + 66:len(b)]
    want := bytes(hex.Format(hash.Sha256(v)))
    for k <- iter.Range(0, 64) {
        if b[q + 1 + k] != want[k] {
            return CacheVal{false, []byte{}}
        }
    }
    return CacheVal{true, v}
}

// 値 val を鍵 key で置き場に書く（一時ファイルに書いて Rename で公開 — 読み手は書きかけを見ない。失敗は黙って捨てる — キャッシュは
// 速さのためだけで、書けなくても結果は変わらない）。同じ鍵を 2 つのプロセスが同時に書いても値は同じバイト列（内容アドレス + 決定的）
func cachePut(dir string, key string, val []byte) {
    p := cachePath(dir, key)
    mkdirs(parentOf(p))
    mut out := mut []byte{}
    appendBytes(mut out, bytes("sobercache 1 ${key} ${len(val)} ${hex.Format(hash.Sha256(val))}\n"))
    appendBytes(mut out, val)
    // 一時ファイルの名前は pid + 乱数（同じ鍵を同時に書く 2 つのプロセスが同じ一時ファイルを奪い合わない）
    tmp := "${p}.${lower.TmpTag()}.tmp"
    if io.WriteFile(tmp, freeze(out)) != nil {
        return
    }
    _ = os.Rename(tmp, p)
}

// 環境変数 name が "1" か
func envOn(name string) bool {
    v, err := os.Getenv(name)
    if err != nil {
        return false
    }
    if v != nil {
        return v == "1"
    }
    return false
}

// バイト列の一致
func bytesEq(a []byte, b []byte) bool {
    if len(a) != len(b) {
        return false
    }
    for i <- iter.Range(0, len(a)) {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

// `--cache-trace` の 1 行（標準エラーへ — `cache: <path> <鍵> hit|miss`）
func traceLine(path string, key string, hit bool) int {
    werr := io.WriteStderr(bytes("cache: ${path} ${key} ${if hit { "hit" } else { "miss" }}\n"))
    return if werr != nil { 1 } else { 0 }
}
