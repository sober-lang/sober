package sha256

// SHA-256（FIPS 180-4）のインクリメンタル API。
// 状態 State は値（写せば途中の値の写し — TLS の transcript hash は同じ状態から何度も Sum を取る）:
//
//     mut s := sha256.New()
//     sha256.Write(mut s, a)
//     h1 := sha256.Sum(s)        // a の値（s は変わらない）
//     sha256.Write(mut s, b)
//     h2 := sha256.Sum(s)        // a ++ b の値
//
// ワンショット API は Sum256（std/hash の hash.Sha256 はこれを呼ぶ）。算術は全部 32 bit の語（[0, 2^32)）の上で閉じる — 和は 5 項まで（2^35 未満）を
// 足してから mask32 で畳み、回転は shift 2 回 + or。積を使わないので int の 64 bit の溢れに触れない。データに依る分岐・添字は無い（定数時間 —
// HMAC の鍵を通してよい）

import "std/iter"

// 長さの定数（バイト）
const Size = 32 // 値の長さ
const BlockSize = 64 // 1 ブロックの長さ

// 途中の状態（h = 8 語の連鎖値・tail = まだ畳んでいない 64 バイト未満の端・n = これまでに書いた長さ）
type State struct {
    h []int
    tail []byte
    n int
}

// 空の入力の状態
@effects()
func New() State {
    return State{h: []int{0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19}, tail: []byte{}, n: 0}
}

// data を続けて書く（64 バイトのブロックが揃った分だけ畳み、端は tail に残す）（対の Read は実需まで足さない — 34 節 2 の注記）
@effects()
func Write(s mut State, data []byte) {
    n := len(data)
    t := len(s.tail)
    if t + n < 64 {
        s.tail = cat(s.tail, data, 0, n)
        s.n = s.n + n
        return
    }
    k := sha256K()
    mut h := mut []int{}
    for i <- iter.Range(0, 8) {
        h = append(h, s.h[i])
    }
    mut w := mut []int{}
    for i <- iter.Range(0, 64) {
        w = append(w, 0)
    }
    mut off := 0
    if t > 0 {
        off = 64 - t
        load(mut w, cat(s.tail, data, 0, off), 0)
        compress(mut h, mut w, k)
    }
    while off + 64 <= n {
        load(mut w, data, off)
        compress(mut h, mut w, k)
        off = off + 64
    }
    s.h = freeze(h)
    s.tail = cat([]byte{}, data, off, n)
    s.n = s.n + n
}

// s に書いた全体の値（32 バイト）。s は変えない（末尾の詰め = 端 + 0x80 + 0 埋め + ビット長〔64 bit big endian〕を写しの上で畳む）
@effects()
func Sum(s State) []byte {
    rest := len(s.tail)
    tlen := if rest < 56 { 64 } else { 128 }
    mut t := mut []byte{}
    for i <- iter.Range(0, rest) {
        t = append(t, s.tail[i])
    }
    t = append(t, byte(0x80))
    for i <- iter.Range(rest + 1, tlen - 8) {
        t = append(t, byte(0))
    }
    bits := s.n * 8
    for i <- iter.Range(0, 8) {
        t = append(t, byte((bits >> (56 - 8 * i)) & 0xff))
    }
    tail := freeze(t)
    mut f := s
    f.tail = []byte{}
    // 詰めた端は 64 / 128 バイト = ブロックが揃うので Write が全部畳む
    Write(mut f, tail)
    mut out := mut []byte{}
    for i <- iter.Range(0, 8) {
        for j <- iter.Range(0, 4) {
            out = append(out, byte((f.h[i] >> (24 - 8 * j)) & 0xff))
        }
    }
    return freeze(out)
}

// data の SHA-256 の値（ワンショット API）
@effects()
func Sum256(data []byte) []byte {
    mut s := New()
    Write(mut s, data)
    return Sum(s)
}

// a ++ b[from:to]（新しい切片）
func cat(a []byte, b []byte, from int, to int) []byte {
    mut out := mut []byte{}
    for i <- iter.Range(0, len(a)) {
        out = append(out, a[i])
    }
    for i <- iter.Range(from, to) {
        out = append(out, b[i])
    }
    return freeze(out)
}

const mask32 = 0xffffffff

// src[off..off+64) の 16 語（big endian）を w[0..16) に書く
func load(w mut []int, src []byte, off int) {
    for i <- iter.Range(0, 16) {
        p := off + 4 * i
        w[i] = (int(src[p]) << 24) | (int(src[p + 1]) << 16) | (int(src[p + 2]) << 8) | int(src[p + 3])
    }
}

// 1 ブロック（w[0..16) に読み込み済み）を状態 h に畳み込む。w[16..64) は語の拡張で上書きする
func compress(h mut []int, w mut []int, k []int) {
    for i <- iter.Range(16, 64) {
        x := w[i - 15]
        y := w[i - 2]
        s0 := rotr(x, 7) ^ rotr(x, 18) ^ (x >> 3)
        s1 := rotr(y, 17) ^ rotr(y, 19) ^ (y >> 10)
        w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & mask32
    }
    mut a := h[0]
    mut b := h[1]
    mut c := h[2]
    mut d := h[3]
    mut e := h[4]
    mut f := h[5]
    mut g := h[6]
    mut hh := h[7]
    for i <- iter.Range(0, 64) {
        bs1 := rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
        ch := (e & f) ^ ((e ^ mask32) & g)
        t1 := (hh + bs1 + ch + k[i] + w[i]) & mask32
        bs0 := rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
        maj := (a & b) ^ (a & c) ^ (b & c)
        t2 := (bs0 + maj) & mask32
        hh = g
        g = f
        f = e
        e = (d + t1) & mask32
        d = c
        c = b
        b = a
        a = (t1 + t2) & mask32
    }
    h[0] = (h[0] + a) & mask32
    h[1] = (h[1] + b) & mask32
    h[2] = (h[2] + c) & mask32
    h[3] = (h[3] + d) & mask32
    h[4] = (h[4] + e) & mask32
    h[5] = (h[5] + f) & mask32
    h[6] = (h[6] + g) & mask32
    h[7] = (h[7] + hh) & mask32
}

// 32 bit の右回転（x は [0, 2^32)・k は 1..31）
func rotr(x int, k int) int {
    return ((x >> k) | (x << (32 - k))) & mask32
}

// 丸め定数（最初の 64 個の素数の立方根の小数部の先頭 32 bit — FIPS 180-4 4.2.2）
func sha256K() []int {
    return []int{
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    }
}
