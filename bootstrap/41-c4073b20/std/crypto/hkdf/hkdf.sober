package hkdf

// HKDF-SHA256（RFC 5869）。
// TLS 1.3 の HKDF-Expand-Label は std/tls の側（ラベルの綴りは TLS の約束）
//
//     prk := hkdf.Extract(salt, ikm)
//     okm := hkdf.Expand(prk, info, 42)?   // 255 × 32 バイトを超える長さは hkdf.TooLong

import "std/crypto/hmac"
import "std/crypto/sha256"
import "std/iter"

// PRK = HMAC-SHA256(salt, ikm)（salt が空なら 32 バイトの 0 — RFC 5869 2.2）
@secret(ikm)
@effects(!io, !block, !nondet)
func Extract(salt []byte, ikm []byte) []byte {
    mut z := mut []byte{}
    if len(salt) == 0 {
        for i <- iter.Range(0, sha256.Size) {
            z = append(z, byte(0))
        }
    }
    s := if len(salt) == 0 { freeze(z) } else { salt }
    return hmac.Sum256(s, ikm)
}

// Expand の長さが RFC の上限（255 × 32 バイト）を超えた（または負）
type TooLong error

// OKM の先頭 n バイト（T(i) = HMAC(prk, T(i-1) ++ info ++ i) を繋ぐ — RFC 5869 2.3）。n が 255 × 32 を超えれば TooLong（RFC の上限）
@errors(TooLong)
@secret(prk)
@effects(!io, !block, !nondet)
func Expand(prk []byte, info []byte, n int) ([]byte, error?) {
    if n < 0 || n > 255 * sha256.Size {
        return []byte{}, TooLong{}
    }
    mut out := mut []byte{}
    mut t := []byte{}
    mut i := 1
    while len(out) < n {
        mut m := mut []byte{}
        for j <- iter.Range(0, len(t)) {
            m = append(m, t[j])
        }
        for j <- iter.Range(0, len(info)) {
            m = append(m, info[j])
        }
        m = append(m, byte(i))
        t = hmac.Sum256(prk, freeze(m))
        for j <- iter.Range(0, len(t)) {
            if len(out) < n {
                out = append(out, t[j])
            }
        }
        i = i + 1
    }
    return freeze(out), nil
}
