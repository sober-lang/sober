package lower

// ジェネリクスの単相化（src/lower_types.zig の instStruct / typeKey / tyArgOk、src/lower_inline.zig の genericCall / genericInline /
// instFunc の写し）と辞書 const（dictConst）。型引数の推論は表層型検査器（desugar/typer.sober）の表を引く（tableTArgs — C1 B2）。
// 型環境 = 型パラメータの束縛の列 [n, (名前, 型)…]（st.tenv — 下ろし中の関数・展開・ジェネリック struct のレイアウト中のもの）

import "diag"
import "desugar"
import "ast"
import "std/iter"

// envLookup は型環境 env の名前 name の型（無ければ -1）
func envLookup(st mut St, env int, name desugar.StrRef) int {
    if env < 0 {
        return -1
    }
    mut i := 0
    while i < hget(mut st, env) {
        if strEq(mut st, hgetS(mut st, env + 1 + i * 2), name) {
            return hget(mut st, env + 2 + i * 2)
        }
        i += 1
    }
    return -1
}

// bindsOf は型パラメータの名前の列 names（文字列の列）と型引数の列 targs の型環境
func bindsOf(st mut St, names desugar.ListRef, targs desugar.ListRef) int {
    n := lenL(mut st, names)
    env := recN(mut st, 1 + n * 2)
    hset(mut st, env, n)
    for i <- iter.Range(0, n) {
        hset(mut st, env + 1 + i * 2, latI(mut st, names, i))
        hset(mut st, env + 2 + i * 2, latI(mut st, targs, i))
    }
    return env
}

// tyArgOk は Def として呼ぶジェネリックの型引数として許される型（region を持たない）
func tyArgOk(st mut St, t int) bool {
    k := hget(mut st, t)
    if k == TInt || k == TBool || k == TFnv || k == TNamed {
        return true
    }
    if k == TOpt {
        return tyArgOk(mut st, hget(mut st, t + 1))
    }
    if k == TStruct || k == TUnion {
        return tyArgFields(mut st, t, false)
    }
    return false
}

// tyArgValueOk は展開されるジェネリック・ジェネリック struct の型引数（値を持つ型なら string / slice / map を含んでよい）
func tyArgValueOk(st mut St, t int) bool {
    k := hget(mut st, t)
    if k == TInt || k == TBool || k == TFnv || k == TNamed {
        return true
    }
    if k == TSlice || k == TOpt {
        return tyArgValueOk(mut st, hget(mut st, t + 1))
    }
    if k == TMap {
        return tyArgValueOk(mut st, hget(mut st, t + 1)) && tyArgValueOk(mut st, hget(mut st, t + 2))
    }
    if k == TStruct || k == TUnion {
        return tyArgFields(mut st, t, true)
    }
    return false
}

// tyArgFields は struct / union のフィールドがすべて型引数として許されるか
func tyArgFields(st mut St, t int, value bool) bool {
    info := hget(mut st, t + 1)
    fs := hgetL(mut st, info + SI_FIELDS)
    if hget(mut st, t) == TStruct {
        for i <- iter.Range(0, lenL(mut st, fs)) {
            ft := hget(mut st, latI(mut st, fs, i) + 1)
            ok := if value { tyArgValueOk(mut st, ft) } else { tyArgOk(mut st, ft) }
            if !ok {
                return false
            }
        }
        return true
    }
    for v <- iter.Range(0, lenL(mut st, fs)) {
        vfs := hgetL(mut st, latI(mut st, fs, v) + 2)
        for i <- iter.Range(0, lenL(mut st, vfs)) {
            ft := hget(mut st, latI(mut st, vfs, i) + 1)
            ok := if value { tyArgValueOk(mut st, ft) } else { tyArgOk(mut st, ft) }
            if !ok {
                return false
            }
        }
    }
    return true
}

// ── 型の綴り（インスタンスのキー — IR の関数名に出る）──
// 綴りはヒープの先端へ 1 バイト 1 語で直接積む（綴りの途中でヒープの他の記録を作らない — 連続した文字列になる）。
// 出力先を別の mut slice にして再帰の Def に渡す形は sober check が def error にした（mut 引数 2 本の再帰 — F-31）

func putLit(st mut St, w string) {
    b := bytes(w)
    for i <- iter.Range(0, len(b)) {
        hpush(mut st, b[i])
    }
}

func putStr(st mut St, s int) {
    n := dat(mut st, s)
    for i <- iter.Range(0, n) {
        hpush(mut st, dat(mut st, s + 1 + i))
    }
}

func typeKey(st mut St, t int) {
    k := hget(mut st, t)
    if k == TInt {
        putLit(mut st, "int")
        return
    }
    if k == TBool {
        putLit(mut st, "bool")
        return
    }
    if k == TNamed {
        // named scalar のインスタンスは型の名前で分ける（同名の named が別 package にあると同じインスタンスを共有する — 表現は下地なので観測は同じ）
        putStr(mut st, nodeOf(mut st, hgetN(mut st, t + 2)).a)
        return
    }
    if k == TStruct {
        putStr(mut st, hget(mut st, hget(mut st, t + 1) + SI_KEY))
        return
    }
    if k == TUnion {
        info := hget(mut st, t + 1)
        if hget(mut st, info + SI_DECL) == -1 {
            putLit(mut st, "error")
        } else {
            putStr(mut st, hget(mut st, info + SI_KEY))
        }
        return
    }
    if k == TOpt {
        hpush(mut st, 63)
        typeKey(mut st, hget(mut st, t + 1))
        return
    }
    if k == TFnv || k == TFunc {
        ft := hget(mut st, t + 1)
        putLit(mut st, "fn(")
        mut i := 0
        while i < lenL(mut st, hgetL(mut st, ft)) {
            typeKey(mut st, latI(mut st, hgetL(mut st, ft), i))
            hpush(mut st, 44)
            i += 1
        }
        hpush(mut st, 41)
        i = 0
        while i < lenL(mut st, hgetL(mut st, ft + 1)) {
            typeKey(mut st, latI(mut st, hgetL(mut st, ft + 1), i))
            i += 1
        }
        return
    }
    if k == TSlice {
        putLit(mut st, if hget(mut st, t + 2) != 0 { "mut[]" } else { "[]" })
        typeKey(mut st, hget(mut st, t + 1))
        return
    }
    if k == TMap {
        putLit(mut st, "map[")
        typeKey(mut st, hget(mut st, t + 1))
        putLit(mut st, "]")
        typeKey(mut st, hget(mut st, t + 2))
        return
    }
    hpush(mut st, 63)
}

// instKey は `base[T1,T2]`（base は文字列）の文字列
func instKey(st mut St, base int, targs desugar.ListRef) desugar.StrRef {
    at := desugar.StrRef(hlen(mut st))
    hpush(mut st, 0)
    putStr(mut st, base)
    hpush(mut st, 91)
    for i <- iter.Range(0, lenL(mut st, targs)) {
        if i > 0 {
            hpush(mut st, 44)
        }
        typeKey(mut st, latI(mut st, targs, i))
    }
    hpush(mut st, 93)
    hset(mut st, int(at), hlen(mut st) - int(at) - 1)
    return at
}

// ── ジェネリック struct ──

// structByKey は型表のキー（文字列）の struct / union の情報（無ければ -1）
func structByKey(st mut St, key desugar.StrRef) int {
    mut x := st.types
    while x >= 0 {
        if (hget(mut st, x) == TStruct || hget(mut st, x) == TUnion) && hget(mut st, x + SI_KEY) >= 0 && strEq(mut st, hgetS(mut st, x + SI_KEY), key) {
            return x
        }
        x = hget(mut st, x + SI_NEXT)
    }
    return -1
}

// instStruct はジェネリック struct の適用 `Name[args]`（型引数は呼び手の文脈で読む）。レイアウトは呼び手が済ませる
func instStruct(st mut St, pk int, name desugar.StrRef, args desugar.ListRef, at desugar.NodeRef) (int, error?) {
    r := desugar.ResolveType(mut st.d, pk, name)
    td := desugar.NodeRef(r.idx)
    if td == -1 || lenL(mut st, lB(nodeOf(mut st, td))) == 0 {
        return 0, diag.UndefinedType{at: posOf(mut st, at)}
    }
    if lenL(mut st, args) != lenL(mut st, lB(nodeOf(mut st, td))) {
        return 0, diag.Mismatch{at: posOf(mut st, at)}
    }
    n := lenL(mut st, args)
    targs := desugar.ListRef(listN(mut st, n))
    for i <- iter.Range(0, n) {
        t := resolveType(mut st, pk, latN(mut st, args, i), false)?
        if !tyArgValueOk(mut st, t) {
            return 0, diag.Mismatch{at: posOf(mut st, at)}
        }
        lput(mut st, targs, i, t)
    }
    return instStructTys(mut st, td, r.pkg, targs, at)
}

// instStructTys はジェネリック struct / union（型宣言 td・宣言側 package dpk）の型引数 targs（型の列）のインスタンスの情報
// （union は report-67 §2 の (1) — 明示の型引数。レイアウトは layoutBody が型環境 SI_ENV で variant の欄を引く）
func instStructTys(st mut St, td desugar.NodeRef, dpk int, targs desugar.ListRef, at desugar.NodeRef) (int, error?) {
    for i <- iter.Range(0, lenL(mut st, targs)) {
        if !tyArgValueOk(mut st, latI(mut st, targs, i)) {
            return 0, diag.Mismatch{at: posOf(mut st, at)}
        }
    }
    ik := instKey(mut st, int(strDot(mut st, pkgPath(mut st, dpk), sA(nodeOf(mut st, td)))), targs)
    x := structByKey(mut st, ik)
    if x >= 0 {
        return x, nil
    }
    bk := kindN(mut st, nC(nodeOf(mut st, td)))
    if bk != ast.BStruct && bk != ast.BUnion {
        return 0, diag.Unsupported{at: posOf(mut st, at)}
    }
    info := recN(mut st, SISZ)
    hset(mut st, info, if bk == ast.BStruct { TStruct } else { TUnion })
    hset(mut st, info + SI_DECL, int(td))
    hset(mut st, info + SI_PKG, dpk)
    hset(mut st, info + SI_WORDS, 0)
    hset(mut st, info + SI_STATE, LPending)
    hset(mut st, info + SI_NEXT, st.types)
    hset(mut st, info + SI_TY, rec4(mut st, hget(mut st, info), info, 0, 0))
    hset(mut st, info + SI_KEY, int(ik))
    hset(mut st, info + SI_ENV, bindsOf(mut st, lB(nodeOf(mut st, td)), targs))
    hset(mut st, info + SI_TARGS, int(targs))
    st.types = info
    return info, nil
}


// ── ジェネリック関数 ──

// sigIn は関数宣言 decl の署名を package pk・型環境 env で読む
func sigIn(st mut St, decl desugar.NodeRef, pk int, env int) (Sig, error?) {
    saved := st.tenv
    st.tenv = env
    sig, err := sigOf(mut st, decl, pk)
    st.tenv = saved
    if err != nil {
        return Sig{}, err
    }
    return sig, nil
}

// tableTArgs は呼び出し（callee の節 cn）の型引数: 表層型検査器の表（desugar/typer.sober の YTArgsOf — 明示の型引数・実引数との
// 単一化・型なしの定数の扱いは検査器の規則が正）を lower の型へ写す。決まらないものがあるか、型引数に置けない型なら拒否（C1 B2）
func tableTArgs(st mut St, cn desugar.NodeRef, at desugar.NodeRef, value_ok bool) (desugar.ListRef, error?) {
    yl := desugar.YTArgsOf(mut st.d, desugar.NodeRef(cn))
    if yl == -1 {
        return 0, diag.Mismatch{at: posOf(mut st, at)}
    }
    targs := yLowerList(mut st, yl, at)?
    if targs == -1 {
        return 0, diag.Mismatch{at: posOf(mut st, at)}
    }
    for i <- iter.Range(0, lenL(mut st, targs)) {
        t := latI(mut st, targs, i)
        ok := if value_ok { tyArgValueOk(mut st, t) } else { tyArgOk(mut st, t) }
        if !ok {
            return 0, diag.Mismatch{at: posOf(mut st, at)}
        }
    }
    return targs, nil
}

// ── 型なしの定数の実引数（language.md 32 節）: 値は今までどおり先に評価し（IR の順は不変）、型引数の推論では一度外す
// （外して決まらなければ定数の型 = int / bool で推論し直す — 推論は検査器の yNamedCall）。インスタンスの仮引数が named scalar なら値の型だけ付け替える ──

// constArgs は実引数ごとの「型なしの定数なら評価した型、でなければ -1」の列
func constArgs(st mut St, n int) desugar.ListRef {
    l := desugar.ListRef(listN(mut st, n))
    for i <- iter.Range(0, n) {
        lput(mut st, l, i, -1)
    }
    return l
}

// noteConstArg は i 番目の実引数 a が型なしの定数なら型 t を覚える（インスタンスの仮引数の型に合わせて付け替える — retagConsts）
func noteConstArg(st mut St, cts int, i int, a desugar.NodeRef, t int) {
    if untypedConst(mut st, a) {
        hset(mut st, cts + 1 + i, t)
    }
}

// retagConsts は定数の実引数（評価済みの EVal）の型を、インスタンスの仮引数の型 pts が named scalar なら付け替える
func retagConsts(st mut St, cts desugar.ListRef, srcs desugar.ListRef, pts desugar.ListRef) {
    for i <- iter.Range(0, lenL(mut st, cts)) {
        ct := latI(mut st, cts, i)
        if ct >= 0 && i < lenL(mut st, pts) {
            pt := latI(mut st, pts, i)
            src := latN(mut st, srcs, i)
            if isTag(mut st, pt, TNamed) && tEql(mut st, baseTy(mut st, pt), ct) && kindN(mut st, src) == EVal {
                lput(mut st, srcs, i, node(mut st, EVal, src, pt, nodeOf(mut st, src).b, 0, 0))
            }
        }
    }
}

// instFunc はジェネリック関数のインスタンス（単相コピー）。キー = "pkg.name[型…]"、本体は作業列で下ろす
func instFunc(st mut St, fidx int, targs desugar.ListRef) (int, error?) {
    pk := fnPkg(mut st, fidx)
    decl := fnNode(mut st, fidx)
    k := instKey(mut st, int(strDot(mut st, pkgPath(mut st, pk), fnName(mut st, fidx))), targs)
    mut x := st.insts
    while x >= 0 {
        if strEq(mut st, hgetS(mut st, x + 1), k) {
            return hget(mut st, x + 2), nil
        }
        x = hget(mut st, x)
    }
    env := bindsOf(mut st, lB(nodeOf(mut st, decl)), targs)
    sig := sigIn(mut st, decl, pk, env)?
    fi := newFuncSig(mut st, int(k), decl, pk, desugar.ListRef(sig.ps), desugar.ListRef(sig.rs), -1, env)
    if fnTransparent(mut st, fidx) {
        markTransp(mut st, fi)
    }
    st.insts = rec4(mut st, st.insts, int(k), fi, 0)
    return fi, nil
}

// genericCall はジェネリック関数の呼び出し: 引数を左から評価して退避 → 型引数（表層型検査器の表）→ インスタンスを呼ぶ
func genericCall(st mut St, fidx int, args desugar.ListRef, at desugar.NodeRef, cn desugar.NodeRef) (int, error?) {
    pk := fnPkg(mut st, fidx)
    decl := fnNode(mut st, fidx)
    transp := fnTransparent(mut st, fidx)
    if fnExpands(mut st, fidx) && !transp {
        return genericInline(mut st, fidx, args, at, cn)
    }
    ps := lC(nodeOf(mut st, decl))
    n := lenL(mut st, ps)
    if lenL(mut st, args) != n {
        return 0, diag.Mismatch{at: posOf(mut st, at)}
    }
    vsrcs := desugar.ListRef(listN(mut st, n))
    cts := constArgs(mut st, n)
    for i <- iter.Range(0, n) {
        a := latN(mut st, args, i)
        if ast.ParamIsMut(nodeOf(mut st, latN(mut st, ps, i))) {
            // mut 仮引数（mut_def）: 実引数は呼び手のセルのまま渡す（評価してコピーしない）
            mutArgCell(mut st, a, at)?
            lput(mut st, vsrcs, i, int(a))
        } else {
            x := expr(mut st, a)?
            if isTag(mut st, x.t, TNever) {
                return -1, nil
            }
            v := copyVal(mut st, x.t, x.v)
            noteConstArg(mut st, int(cts), i, a, x.t)
            lput(mut st, vsrcs, i, node(mut st, EVal, at, x.t, v, 0, 0))
        }
    }
    // region 透過の実体関数の型引数は展開と同じ制約（値を持つ型なら string / slice / map を含んでよい）
    targs := tableTArgs(mut st, cn, at, transp)?
    fi := instFunc(mut st, fidx, targs)?
    retagConsts(mut st, cts, vsrcs, desugar.ListRef(infoAt(mut st, fi).params))
    return emitCall(mut st, infoAt(mut st, fi).ir, -1, desugar.ListRef(infoAt(mut st, fi).params), desugar.ListRef(infoAt(mut st, fi).results), vsrcs, at, decl)
}

// genericInline はジェネリックかつ関数型 / mut の仮引数を持つ関数: 値の引数を先に評価し、閉包は型引数（表層型検査器の表）が決まってから作る。
// 本体は束縛した型環境で展開する
func genericInline(st mut St, fidx int, args desugar.ListRef, at desugar.NodeRef, cn desugar.NodeRef) (int, error?) {
    pk := fnPkg(mut st, fidx)
    decl := fnNode(mut st, fidx)
    ps := lC(nodeOf(mut st, decl))
    n := lenL(mut st, ps)
    if lenL(mut st, args) != n {
        return 0, diag.Mismatch{at: posOf(mut st, at)}
    }
    outs := desugar.ListRef(listN(mut st, n))
    cts := constArgs(mut st, n)
    for i <- iter.Range(0, n) {
        a := latN(mut st, args, i)
        prm := latN(mut st, ps, i)
        lput(mut st, outs, i, int(a))
        if ast.ParamIsMut(nodeOf(mut st, prm)) {
            mutArgCell(mut st, a, at)?
        } else if kindN(mut st, nB(nodeOf(mut st, prm))) == ast.TFunc {
            // 閉包（ラムダ・for 式・閉包の名前）は型引数が決まってから作る
        } else {
            x := expr(mut st, a)?
            if isTag(mut st, x.t, TNever) {
                return -1, nil
            }
            v := copyVal(mut st, x.t, x.v)
            lput(mut st, outs, i, node(mut st, EVal, at, x.t, v, 0, 0))
            noteConstArg(mut st, int(cts), i, a, x.t)
        }
    }
    targs := tableTArgs(mut st, cn, at, true)?
    env := bindsOf(mut st, lB(nodeOf(mut st, decl)), targs)
    sig := sigIn(mut st, decl, pk, env)?
    retagConsts(mut st, cts, outs, desugar.ListRef(sig.ps))
    return inlineCall(mut st, decl, pk, desugar.ListRef(sig.ps), desugar.ListRef(sig.rs), outs, at, env)
}

// ── 辞書 const ──

// ExpCtx は式を別の文脈で下ろすときに入れ替える束（名前の可視範囲・package・型環境・辞書 const の中か — C10）
type ExpCtx struct {
    chain int
    curPkg int
    tenv int
    inDict int
}

func expCtx(st mut St) ExpCtx {
    return ExpCtx{chain: st.chain, curPkg: st.curPkg, tenv: st.tenv, inDict: st.inDict}
}

func setExpCtx(st mut St, c ExpCtx) {
    st.chain = c.chain
    st.curPkg = c.curPkg
    st.tenv = c.tenv
    st.inDict = c.inDict
}

// dictConst は辞書 const の参照点での展開: 宣言側の文脈（package・空の可視範囲・空の型環境）で struct リテラルを作り直す
func dictConst(st mut St, c int, pk int) (Val, error?) {
    saved := expCtx(mut st)
    st.chain = list2(mut st, st.nscope, VOPEN)
    st.curPkg = pk
    st.tenv = -1
    st.inDict = 1
    x, err := expr(mut st, nB(nodeOf(mut st, conNode(mut st, c))))
    setExpCtx(mut st, saved)
    if err != nil {
        return Val{}, err
    }
    return x, nil
}

