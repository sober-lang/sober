package analyzer

// `@errors(...)` の注釈の検査（error 網羅 analyzer A3 — language.md 13 節・裁定 E5 = M-a: 正の列挙だけ・否定形なし）。
// 注釈は parser が関数宣言の付加の列（6・7 番目 = ラベル名の列・`@` の字句）に持つ。ここではラベル名が解決できるかだけを見る
// （宣言と導出の照合・公開関数への強制は A4）

import "ast"
import "desugar"
import "std/iter"

const MAnnUnknown = 11   // 解決できないラベル名（付帯 = 項の添字）
const MAnnNegated = 12   // 否定形 `!L`
const MAnnMalformed = 13 // 読めない項

// errsOf は関数宣言 fd の `@errors` のラベル名の列（無ければ -1）
func errsOf(az mut Az, fd ast.Node) desugar.ListRef {
    l, t := desugar.FuncErrors(mut az.d, fd)
    return l
}

// errsTok は関数宣言 fd の `@errors` の `@` の字句
func errsTok(az mut Az, fd ast.Node) int {
    l, t := desugar.FuncErrors(mut az.d, fd)
    return t
}

// checkAnnots は全関数の `@errors` の項を照合する
func checkAnnots(az mut Az) {
    for fi <- iter.Range(0, desugar.Nfn(mut az.d)) {
        fd := fnDecl(mut az, fi)
        l := errsOf(mut az, fd)
        if l != -1 {
            az.pk = desugar.FnAt(mut az.d, fi).pkg
            for i <- iter.Range(0, desugar.LenL(mut az.d, l)) {
                s := desugar.StrRef(desugar.LatI(mut az.d, l, i))
                c := desugar.Dat(mut az.d, int(s) + 1)
                if c == 33 {
                    reportAnn(mut az, MAnnNegated, fi, i)
                } else if c == 63 {
                    reportAnn(mut az, MAnnMalformed, fi, i)
                } else if labelOf(mut az, s) == -1 {
                    reportAnn(mut az, MAnnUnknown, fi, i)
                }
            }
        }
    }
}

// reportAnn は注釈の指摘（位置は `@` の字句 — 節は関数宣言、付帯は項の添字）
func reportAnn(az mut Az, k int, fi int, i int) {
    report(mut az, k, desugar.FnAt(mut az.d, fi).node, desugar.NodeRef(i))
}

// annMessage は注釈の指摘の本文（fn = 関数宣言の節・i = 項の添字）
func annMessage(az mut Az, k int, fn desugar.NodeRef, i int) string {
    item := str(mut az, desugar.StrRef(desugar.LatI(mut az.d, errsOf(mut az, node(mut az, fn)), i)))
    if k == MAnnNegated {
        return "@errors lists the labels the function may return: the negated form '${item}' is not allowed"
    }
    if k == MAnnMalformed {
        return "@errors expects error label names (`L` or `pkg.L`)"
    }
    return "@errors: '${item}' is not an error label"
}
