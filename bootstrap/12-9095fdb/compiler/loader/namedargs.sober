package loader

// 名前付き実引数と `T?` 仮引数の省略（syntax.md 決定 7）を位置引数へ写す — 脱糖の固定テンプレート（nilcase と同じ: desugar・lower・typer・
// analyzer は写した後の位置引数だけの木を読む。コア・Lean は無変更）:
//
//     func f(a int, b string?, c int?)      f(1, c: 2)  →  f(1, nil, 2)      f(1)  →  f(1, nil, nil)
//
// 写す相手は func 宣言の直接呼び出し（`f(…)`・`ref.F(…)`・`f[T](…)`）だけ（名前付き関数型の変数を通した呼び出しは第 2 便 — 仮引数名を
// 知るのに局所の型が要る）。名前付きは宣言の順に限る（並べ替えない — 評価の順 = 字面の順。night-adjudications 6）。名前付きの無い呼び出しは、
// 位置引数が仮引数より少なく、足りない仮引数が全部 `T?` のときだけ nil を足す（他は今までどおり後段の拒否）。
// パイプ段（`x |> f(…)`）は穴 `_` で左辺の位置を書いた段だけを写す（穴の無い段は左辺が第 1 引数に入り、多値の左辺もあって位置の数が字面で決まらない）。
// 写せない形は loader の拒否（diag.NamedArg — 位置 = 名前付きの実引数か呼び出し・理由ごとの文言）

import "std/builder"
import "std/iter"
import "ast"
import "diag"

// FnTab は func 宣言の表（package と名前で引く — 名前のハッシュの鎖。funcs.sober の FnIndex と同じ形）
type FnTab struct {
    pkg []int
    file []int
    node []int
    head []int
    next []int
    mask int
}

// namedArgsAll は全ファイルの木の名前付き実引数と省略を写す（写せない形は拒否）
@errors(diag.NamedArg)
func namedArgsAll(cx Cx) ([]ast.Tree, error?) {
    ft := fnTab(cx)
    mut out := mut []ast.Tree{}
    for f <- iter.Range(0, len(cx.trees)) {
        r := namedArgs(cx, ft, f)
        if r.bad != 0 {
            return []ast.Tree{}, diag.NamedArg{at: diag.Pos{file: f, tok: r.tok}, kind: r.bad}
        }
        out = append(out, r.tree)
    }
    return freeze(out), nil
}

func fnTab(cx Cx) FnTab {
    mut pkg := mut []int{}
    mut file := mut []int{}
    mut node := mut []int{}
    for f <- iter.Range(0, len(cx.trees)) {
        t := cx.trees[f]
        fs := t.nodes[t.file].d
        for k <- iter.Range(0, ast.ListLen(t, fs)) {
            pkg = append(pkg, cx.file_pkg[f])
            file = append(file, f)
            node = append(node, ast.ListAt(t, fs, k))
        }
    }
    mut mask := 1023
    while mask < len(file) * 2 {
        mask = mask * 2 + 1
    }
    mut head := mut []int{}
    for i <- iter.Range(0, mask + 1) {
        head = append(head, -1)
    }
    mut next := mut []int{}
    for i <- iter.Range(0, len(file)) {
        t := cx.trees[file[i]]
        b := nameHash(Name(t, t.nodes[node[i]].a), mask)
        next = append(next, head[b])
        head[b] = i
    }
    return FnTab{freeze(pkg), freeze(file), freeze(node), freeze(head), freeze(next), mask}
}

// fnFind は package pk の func 宣言 name の表の番号（無ければ -1）
func fnFind(cx Cx, ft FnTab, pk int, name string) int {
    mut h := ft.head[nameHash(name, ft.mask)]
    while h >= 0 {
        if ft.pkg[h] == pk && StrIs(cx.trees[ft.file[h]], cx.trees[ft.file[h]].nodes[ft.node[h]].a, name) {
            return h
        }
        h = ft.next[h]
    }
    return -1
}

// calleeFn はファイル f の callee の節 c が指す func 宣言の表の番号（直接呼び出しでなければ -1）
func calleeFn(cx Cx, ft FnTab, f int, c int) int {
    t := cx.trees[f]
    // `f[T](…)` の明示インスタンス化は土台の名前で引く
    x := if t.nodes[c].kind == ast.EIndex { t.nodes[t.nodes[c].a] } else { t.nodes[c] }
    if x.kind == ast.EIdent {
        return fnFind(cx, ft, cx.file_pkg[f], Name(t, x.a))
    }
    if x.kind == ast.ESelector && t.nodes[x.a].kind == ast.EIdent {
        pk := fileImportOf(cx, f, Name(t, t.nodes[x.a].a))
        return if pk < 0 { -1 } else { fnFind(cx, ft, pk, Name(t, x.b)) }
    }
    return -1
}

// NaOut は 1 ファイルの写しの結果（bad != 0 なら拒否 — 理由と字句）
type NaOut struct {
    tree ast.Tree
    bad int
    tok int
}

// naPlan は実引数の列 args（位置 np 本 + 名前付き）を func 宣言 fi の仮引数へ並べた新しい実引数の節の列（拒否なら bad / tok）。
// 足りない `T?` 仮引数の nil は -2 で印し、呼び手が節を合成する
type NaPlan struct {
    args []int
    bad int
    tok int
}

func naPlan(cx Cx, ft FnTab, f int, args int, np int, fi int, ctok int) NaPlan {
    t := cx.trees[f]
    dt := cx.trees[ft.file[fi]]
    ps := dt.nodes[ft.node[fi]].c
    npar := ast.ListLen(dt, ps)
    na := ast.ListLen(t, args)
    mut out := mut []int{}
    for k <- iter.Range(0, if np < npar { np } else { npar }) {
        out = append(out, ast.ListAt(t, args, k))
    }
    mut j := np
    for k <- iter.Range(np, npar) {
        p := dt.nodes[ast.ListAt(dt, ps, k)]
        pname := Name(dt, p.a)
        if j < na && Name(t, t.nodes[ast.ListAt(t, args, j)].a) == pname {
            out = append(out, t.nodes[ast.ListAt(t, args, j)].b)
            j += 1
        } else if dt.nodes[p.b].kind == ast.TOpt {
            out = append(out, -2)
        } else {
            // 省略できない仮引数 k が無い。k を後ろの名前付きで渡していれば順でない（3）。残りの名前付きが k より前の仮引数・無い名前を
            // 指すなら、そちらの理由を先に言う
            for q <- iter.Range(j + 1, na) {
                if Name(t, t.nodes[ast.ListAt(t, args, q)].a) == pname {
                    return NaPlan{[]int{}, 3, t.nodes[ast.ListAt(t, args, q)].tok}
                }
            }
            l := if j < na { naLeft(t, dt, args, j, ps, np, k) } else { NaPlan{[]int{}, 0, 0} }
            return if l.bad != 0 { l } else { NaPlan{[]int{}, 5, ctok} }
        }
    }
    if j < na {
        return naLeft(t, dt, args, j, ps, np, npar)
    }
    return NaPlan{freeze(out), 0, 0}
}

// naLeft は写し切れなかった名前付きの実引数 j の理由（仮引数 at まで並べ終えた時点）: 位置で渡した仮引数の名前（4）・既に並べた仮引数の名前 =
// 順でない / 重複（3）・無い名前（2）。まだ並べていない仮引数の名前なら 0（呼び手が「省略できない仮引数が無い」を言う）
func naLeft(t ast.Tree, dt ast.Tree, args int, j int, ps int, np int, at int) NaPlan {
    a := t.nodes[ast.ListAt(t, args, j)]
    name := Name(t, a.a)
    for k <- iter.Range(0, ast.ListLen(dt, ps)) {
        if Name(dt, dt.nodes[ast.ListAt(dt, ps, k)].a) == name {
            return NaPlan{[]int{}, if k < np { 4 } else if k < at { 3 } else { 0 }, a.tok}
        }
    }
    return NaPlan{[]int{}, 2, a.tok}
}

// namedArgs はファイル f の木の呼び出し（ECall の実引数 b・EPipe の実引数 c）を写す
func namedArgs(cx Cx, ft FnTab, f int) NaOut {
    t := cx.trees[f]
    n0 := len(t.nodes)
    mut ns := mut []ast.Node{}
    mut db := builder.Builder[int]{}
    mut nb := builder.Builder[ast.Node]{}
    mut changed := false
    for i <- iter.Range(0, n0) {
        x := t.nodes[i]
        ns = append(ns, x)
        if x.kind != ast.ECall && x.kind != ast.EPipe {
            continue
        }
        pipe := x.kind == ast.EPipe
        args := if pipe { x.c } else { x.b }
        na := ast.ListLen(t, args)
        mut np := 0
        while np < na && !(ast.ListAt(t, args, np) >= 0 && t.nodes[ast.ListAt(t, args, np)].kind == ast.KNamedArg) {
            np += 1
        }
        named := np < na
        mut holes := false
        for k <- iter.Range(0, na) {
            holes = holes || ast.ListAt(t, args, k) < 0
        }
        if pipe && !holes {
            if named {
                return NaOut{t, 6, t.nodes[ast.ListAt(t, args, np)].tok}
            }
            continue
        }
        if pipe && !named {
            continue
        }
        fi := calleeFn(cx, ft, f, if pipe { x.b } else { x.a })
        if fi < 0 {
            if named {
                return NaOut{t, 1, t.nodes[ast.ListAt(t, args, np)].tok}
            }
            continue
        }
        dt := cx.trees[ft.file[fi]]
        npar := ast.ListLen(dt, dt.nodes[ft.node[fi]].c)
        if !named && np >= npar {
            continue
        }
        plan := naPlan(cx, ft, f, args, np, fi, x.tok)
        if plan.bad != 0 {
            if !named && plan.bad == 5 {
                // 名前付きの無い呼び出しで足りない仮引数が `T?` でない: 今までどおり後段（実引数の数の拒否）に任せる
                continue
            }
            return NaOut{t, plan.bad, plan.tok}
        }
        if !changed {
            for j <- iter.Range(0, len(t.data)) {
                builder.Push(mut db, t.data[j])
            }
            changed = true
        }
        mut out := mut []int{}
        for k <- iter.Range(0, len(plan.args)) {
            if plan.args[k] == -2 {
                out = append(out, n0 + builder.Len(mut nb))
                builder.Push(mut nb, ast.Node{ast.ENil, x.tok, 0, 0, 0, 0, 0, 0})
            } else {
                out = append(out, plan.args[k])
            }
        }
        l := ast.PutList(mut db, freeze(out))
        ns[i] = if pipe { ast.Node{x.kind, x.tok, x.a, x.b, l, x.d, x.e, x.f} } else { ast.Node{x.kind, x.tok, x.a, l, x.c, x.d, x.e, x.f} }
    }
    if !changed {
        return NaOut{t, 0, 0}
    }
    added := builder.Build(mut nb)
    for i <- iter.Range(0, len(added)) {
        ns = append(ns, added[i])
    }
    return NaOut{ast.Tree{freeze(ns), builder.Build(mut db), t.file}, 0, 0}
}
