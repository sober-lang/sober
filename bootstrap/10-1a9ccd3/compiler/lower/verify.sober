package lower

// IR の検証器（src/ir_verify.zig の写し — 正規バックエンドの Sober 化 B-3）: 構造（定義の一意・終端・入口・前任数・辺の引数の数）と、命令ごとの
// オペランドの型・参照の範囲、定義が使用を支配すること（同じブロックなら先に、他のブロックなら支配するブロックで定義）を検査する。
// 辺の引数の使用点は前任ブロックの末尾。到達しないブロックの中は型と範囲だけを見る（支配は定義されない）。
// 値の型は記録から導く（valueTypes — Sober の IR は値の型の表を持たない）ので、結果の型の検査は Zig 版より弱い（オペランドの型・数・範囲・支配は同じ）。
// 正規バックエンドの経路（lower.Elf*）で lower の出力・設計整合パス・mem2reg・rtlower の後に掛ける。違反は内部エラー（標準エラーに 1 行 + panic）

import "obuf"
import "std/io"
import "std/iter"

// vfyModule はモジュールの全関数を検査する（after = どの段の後か — 診断の文言）
func vfyModule(st mut St, after string) {
    nf := xCountFuncs(mut st)
    mut f := st.fhead
    while f >= 0 {
        if hget(mut st, f + F_BHEAD) >= 0 {
            msg := vfyFunc(mut st, f, nf)
            if msg != "" {
                mut out := mut []byte{}
                obuf.Lit(mut out, "sober: internal error: invalid IR after ${after}: func ")
                printName(mut st, mut out, hget(mut st, f + F_NAME))
                obuf.Lit(mut out, ": ${msg}\n")
                werr := io.WriteStderr(freeze(out))
                none := []int{}
                println(none[if werr == nil { 0 } else { 1 }])
            }
        }
        f = hget(mut st, f + F_NEXT)
    }
}

// recountPreds は全ブロックの前任数（B_PREDS）を辺から数え直す。設計整合パス（P4 の空ブロックの短絡）は辺を付け替えるが前任数を保たない —
// テキストの境界（stage1 の ir_parse）は前任数を辺から数え直すので、正規バックエンドの経路もパスの後で同じにする
func recountPreds(st mut St) {
    mut f := st.fhead
    while f >= 0 {
        mut b := hget(mut st, f + F_BHEAD)
        while b >= 0 {
            hset(mut st, b + B_PREDS, 0)
            b = hget(mut st, b + B_NEXT)
        }
        b = hget(mut st, f + F_BHEAD)
        while b >= 0 {
            t := hget(mut st, b + B_TERM)
            if t == TmBr {
                to := hget(mut st, b + B_X1)
                hset(mut st, to + B_PREDS, hget(mut st, to + B_PREDS) + 1)
            } else if t == TmCondbr {
                tt := hget(mut st, b + B_X2)
                hset(mut st, tt + B_PREDS, hget(mut st, tt + B_PREDS) + 1)
                te := hget(mut st, b + B_X4)
                hset(mut st, te + B_PREDS, hget(mut st, te + B_PREDS) + 1)
            }
            b = hget(mut st, b + B_NEXT)
        }
        f = hget(mut st, f + F_NEXT)
    }
}

func xCountFuncs(st mut St) int {
    mut n := 0
    mut f := st.fhead
    while f >= 0 {
        n += 1
        f = hget(mut st, f + F_NEXT)
    }
    return n
}

// 検査の状態（関数ごと）
type vfyS struct {
    vt int              // 値の型の列（valueTypes）
    nv int
    defB mut []int      // 値 → 定義ブロック（-1 = 未定義）
    defI mut []int      // 値 → ブロック内の位置（引数は -1）
    curB int
    curI int
}

func vfyFunc(st mut St, f int, nf int) string {
    nb := hget(mut st, f + F_NBLK)
    if nb == 0 {
        return "no blocks"
    }
    nv := hget(mut st, f + F_NVAL)
    mut w := m2rW{nb: nb, blk: mut []int{}, rpoIx: mut []int{}, rpo: mut []int{}, nrpo: 0, pcnt: mut []int{}, preds: mut []int{}, idom: mut []int{}}
    m2rCfg(mut st, mut w, f)
    entry := w.blk[0]
    if hget(mut st, entry + B_PREDS) != 0 || hget(mut st, entry + B_PHEAD) >= 0 {
        return "the entry block has predecessors or parameters"
    }
    mut v := vfyS{vt: valueTypes(mut st, f), nv: nv, defB: mut []int{}, defI: mut []int{}, curB: 0, curI: 0}
    xFill(mut v.defB, nv, -1)
    xFill(mut v.defI, nv, 0)
    np := hget(mut st, hget(mut st, f + F_PTYS))
    for p <- iter.Range(0, np) {
        if !vfyDef(mut v, p, 0, -1) {
            return "%${p} is defined twice or out of range"
        }
    }
    for bi <- iter.Range(0, nb) {
        b := w.blk[bi]
        if hget(mut st, b + B_TERM) == TmNone {
            return "b${bi} is not terminated"
        }
        mut p := hget(mut st, b + B_PHEAD)
        while p >= 0 {
            if !vfyDef(mut v, hget(mut st, p + 1), bi, -1) {
                return "b${bi}: %${hget(mut st, p + 1)} is defined twice or out of range"
            }
            p = hget(mut st, p)
        }
        mut ins := hget(mut st, b + B_IHEAD)
        mut k := 0
        while ins >= 0 {
            r := hget(mut st, ins + I_RES)
            if r >= 0 && !vfyDef(mut v, r, bi, k) {
                return "b${bi}: %${r} is defined twice or out of range"
            }
            k += 1
            ins = hget(mut st, ins + I_NEXT)
        }
    }
    for x <- iter.Range(0, nv) {
        if v.defB[x] < 0 {
            return "%${x} is never defined"
        }
    }
    // 前任数（組み立てが数えたもの）が辺と合うこと
    for bi <- iter.Range(0, nb) {
        if hget(mut st, w.blk[bi] + B_PREDS) != w.pcnt[bi + 1] - w.pcnt[bi] {
            return "b${bi} records ${hget(mut st, w.blk[bi] + B_PREDS)} predecessors but has ${w.pcnt[bi + 1] - w.pcnt[bi]} incoming edges"
        }
    }
    for bi <- iter.Range(0, nb) {
        b := w.blk[bi]
        v.curB = bi
        mut ins := hget(mut st, b + B_IHEAD)
        mut k := 0
        while ins >= 0 {
            v.curI = k
            m := vfyInst(mut st, mut v, mut w, f, ins, nf)
            if m != "" {
                return "b${bi}: ${m}"
            }
            k += 1
            ins = hget(mut st, ins + I_NEXT)
        }
        v.curI = 1 << 40
        m := vfyTerm(mut st, mut v, mut w, f, b)
        if m != "" {
            return "b${bi}: ${m}"
        }
    }
    return ""
}

func vfyDef(v mut vfyS, x int, b int, k int) bool {
    if x < 0 || x >= v.nv || v.defB[x] >= 0 {
        return false
    }
    v.defB[x] = b
    v.defI[x] = k
    return true
}

func vfyDominates(w mut m2rW, a int, b int) bool {
    mut x := b
    mut done := false
    mut res := false
    while !done {
        if x == a {
            res = true
            done = true
        } else {
            up := w.idom[x]
            if up == x {
                done = true
            } else {
                x = up
            }
        }
    }
    return res
}

// vfyUse は x の使用（wantTy = 型、-1 なら問わない）: 範囲・型・到達するブロックなら支配
func vfyUse(st mut St, v mut vfyS, w mut m2rW, x int, wantTy int, what string) string {
    if x < 0 || x >= v.nv {
        return "${what} uses undefined %${x}"
    }
    t := hget(mut st, v.vt + 1 + x)
    if wantTy >= 0 && t != wantTy {
        return "${what} wants ${if wantTy == TyPtr { "ptr" } else { "i64" }} but %${x} is ${if t == TyPtr { "ptr" } else { "i64" }}"
    }
    if w.rpoIx[v.curB] < 0 {
        return ""
    }
    db := v.defB[x]
    ok := if db == v.curB { v.defI[x] < v.curI } else { w.rpoIx[db] >= 0 && vfyDominates(mut w, db, v.curB) }
    return if ok { "" } else { "${what} uses %${x} whose definition (b${db}) does not dominate the use" }
}

func vfyList(st mut St, v mut vfyS, w mut m2rW, l int, wantTy int, what string) string {
    for k <- iter.Range(0, xLen(mut st, l)) {
        m := vfyUse(mut st, mut v, mut w, xAt(mut st, l, k), wantTy, what)
        if m != "" {
            return m
        }
    }
    return ""
}

func vfyInst(st mut St, v mut vfyS, w mut m2rW, f int, ins int, nf int) string {
    op := hget(mut st, ins + I_OP)
    a := hget(mut st, ins + I_A)
    b := hget(mut st, ins + I_B)
    c := hget(mut st, ins + I_C)
    hasRes := hget(mut st, ins + I_RES) >= 0
    if op == OpConst || op == OpSlotaddr || op == OpGlobal || op == OpFuncaddr || op == OpRDepth || op == OpRAlloc || op == OpRBump || op == OpBin || op == OpCmp ||
        op == OpLoad || op == OpLoad8 || op == OpGepW || op == OpGepB || op == OpPtoi || op == OpItop || op == OpSyscall {
        if !hasRes {
            return "the result is missing"
        }
    } else if op == OpStore || op == OpStore8 || op == OpREnter || op == OpRSetDepth || op == OpRReloc {
        if hasRes {
            return "an unexpected result"
        }
    }
    if op == OpBin || op == OpCmp {
        m := vfyUse(mut st, mut v, mut w, b, TyI64, "bin / cmp")
        return if m != "" { m } else { vfyUse(mut st, mut v, mut w, c, TyI64, "bin / cmp") }
    }
    if op == OpLoad || op == OpLoad8 {
        return vfyUse(mut st, mut v, mut w, a, TyPtr, "load")
    }
    if op == OpStore {
        m := vfyUse(mut st, mut v, mut w, a, TyPtr, "store")
        return if m != "" { m } else { vfyUse(mut st, mut v, mut w, c, -1, "store") }
    }
    if op == OpStore8 {
        m := vfyUse(mut st, mut v, mut w, a, TyPtr, "store8")
        return if m != "" { m } else { vfyUse(mut st, mut v, mut w, c, TyI64, "store8") }
    }
    if op == OpGepW || op == OpGepB {
        m := vfyUse(mut st, mut v, mut w, a, TyPtr, "gep")
        return if m != "" { m } else { vfyUse(mut st, mut v, mut w, b, TyI64, "gep") }
    }
    if op == OpPtoi {
        return vfyUse(mut st, mut v, mut w, a, TyPtr, "ptoi")
    }
    if op == OpItop || op == OpRSetDepth || op == OpRBump {
        return vfyUse(mut st, mut v, mut w, a, TyI64, "itop / region")
    }
    if op == OpSlotaddr {
        return if a < 0 || a >= hget(mut st, f + F_NSLOT) { "undefined slot s${a}" } else { "" }
    }
    if op == OpCall {
        n := xLen(mut st, b)
        ptys := hget(mut st, a + F_PTYS)
        if n != hget(mut st, ptys) {
            return "call with ${n} arguments for ${hget(mut st, ptys)}"
        }
        for k <- iter.Range(0, n) {
            m := vfyUse(mut st, mut v, mut w, xAt(mut st, b, k), hget(mut st, ptys + 1 + k), "call argument")
            if m != "" {
                return m
            }
        }
        return if hasRes != (hget(mut st, a + F_RET) >= 0) { "call result presence is wrong" } else { "" }
    }
    if op == OpCallI {
        m := vfyUse(mut st, mut v, mut w, a, TyI64, "call.indirect callee")
        if m != "" {
            return m
        }
        m2 := vfyList(mut st, mut v, mut w, b, -1, "call.indirect argument")
        return if m2 != "" { m2 } else if hasRes != (c >= 0) { "call.indirect result presence is wrong" } else { "" }
    }
    if op == OpSyscall {
        n := xLen(mut st, a)
        if n < 1 || n > 7 {
            return "syscall with ${n} arguments"
        }
        return vfyList(mut st, mut v, mut w, a, TyI64, "syscall")
    }
    if op == OpRAlloc {
        m := vfyUse(mut st, mut v, mut w, a, TyI64, "region.alloc")
        return if m != "" { m } else { vfyUse(mut st, mut v, mut w, b, TyI64, "region.alloc") }
    }
    if op == OpRReloc {
        m := vfyUse(mut st, mut v, mut w, a, TyPtr, "region.relocate")
        return if m != "" { m } else { vfyUse(mut st, mut v, mut w, c, TyI64, "region.relocate") }
    }
    if op == OpConst || op == OpGlobal || op == OpFuncaddr || op == OpREnter || op == OpRDepth {
        return ""
    }
    return "unknown op ${op}"
}

func vfyEdge(st mut St, v mut vfyS, w mut m2rW, to int, args int) string {
    tid := hget(mut st, to + B_ID)
    if tid == 0 {
        return "branch to the entry block"
    }
    mut n := 0
    mut p := hget(mut st, to + B_PHEAD)
    while p >= 0 {
        if n < xLen(mut st, args) {
            m := vfyUse(mut st, mut v, mut w, xAt(mut st, args, n), hget(mut st, p + 2), "edge argument")
            if m != "" {
                return m
            }
        }
        n += 1
        p = hget(mut st, p)
    }
    return if n != xLen(mut st, args) { "edge to b${tid} passes ${xLen(mut st, args)} arguments for ${n}" } else { "" }
}

func vfyTerm(st mut St, v mut vfyS, w mut m2rW, f int, b int) string {
    t := hget(mut st, b + B_TERM)
    if t == TmBr {
        return vfyEdge(mut st, mut v, mut w, hget(mut st, b + B_X1), hget(mut st, b + B_X2))
    }
    if t == TmCondbr {
        m := vfyUse(mut st, mut v, mut w, hget(mut st, b + B_X1), TyI64, "condbr")
        if m != "" {
            return m
        }
        m2 := vfyEdge(mut st, mut v, mut w, hget(mut st, b + B_X2), hget(mut st, b + B_X3))
        return if m2 != "" { m2 } else { vfyEdge(mut st, mut v, mut w, hget(mut st, b + B_X4), hget(mut st, b + B_X5)) }
    }
    if t == TmRet {
        x := hget(mut st, b + B_X1)
        rt := hget(mut st, f + F_RET)
        if (x < 0) != (rt < 0) {
            return "ret value presence differs from the signature"
        }
        return if x >= 0 { vfyUse(mut st, mut v, mut w, x, rt, "ret") } else { "" }
    }
    return ""
}
