package x509

// 証明書の読みの網（white-box）: Go の crypto/x509 の双子（scripts/oracles/crypto_x509.go → testdata/x509/fields.txt）と、
// Go の verify_test.go の証明書 36 本（testdata/x509/go）・NIST PKITS の証明書 405 本（testdata/x509/pkits/certs.txt）で欄を 1 行に揃えて照合する。
// Go が読めない 7 本（DSA の鍵の継承・負のシリアル・CRL の配布点の形）は照合から外して数だけ印字する

import "std/base64"
import "std/crypto/pem"
import "std/crypto/sha256"
import "std/hex"
import "std/iter"
import "std/strings"

@embed("testdata/x509/go/*.pem")
const GoCerts = map[string]string{}

@embed("testdata/x509/pkits/certs.txt")
const Pkits = map[string]string{}

@embed("testdata/x509/fields.txt")
const Fields = map[string]string{}

func get(fs map[string]string, p string) string {
    v := fs[p]
    if v != nil {
        return v
    }
    return ""
}

func h8(b []byte) string {
    return hex.Format(crypto.sha256.Sum256(b)[0:8])
}

func opt(b []byte) string {
    return if len(b) == 0 { "-" } else { hex.Format(b) }
}

// 文字列の列を辞書順に並べて , で繋ぐ（空なら -）
// a < b（バイトの辞書順）
func less(a string, b string) bool {
    ab := bytes(a)
    bb := bytes(b)
    for i <- iter.Range(0, len(ab)) {
        if i >= len(bb) {
            return false
        }
        if ab[i] != bb[i] {
            return ab[i] < bb[i]
        }
    }
    return len(ab) < len(bb)
}

func joinSorted(xs []string) string {
    if len(xs) == 0 {
        return "-"
    }
    mut s := mut []string{}
    for x <- xs {
        s = append(s, x)
    }
    for i <- iter.Range(0, len(s)) {
        for j <- iter.Range(i + 1, len(s)) {
            if less(s[j], s[i]) {
                t := s[i]
                s[i] = s[j]
                s[j] = t
            }
        }
    }
    return strings.Join(freeze(s), ",")
}

func sigName(a int) string {
    return switch a {
    case SigEcdsaSha256: "ECDSA-SHA256"
    case SigEcdsaSha384: "ECDSA-SHA384"
    case SigEcdsaSha512: "ECDSA-SHA512"
    case SigRsaSha256: "SHA256-RSA"
    case SigRsaSha384: "SHA384-RSA"
    case SigRsaSha512: "SHA512-RSA"
    case SigRsaSha1: "SHA1-RSA"
    case SigRsaPss: "SHA256-RSAPSS"
    case SigDsaSha1: "DSA-SHA1"
    default: "0"
    }
}

func pubName(c Cert) string {
    if c.pubAlg == PubP256 {
        return "ec-P-256"
    }
    if c.pubAlg == PubP384 {
        return "ec-P-384"
    }
    if c.pubAlg == PubRsa {
        n, _, ok := RsaKey(c.pubKey)
        return if ok { "rsa-${BitLen(n)}" } else { "other" }
    }
    return "other"
}

func ipText(b []byte) string {
    if len(b) == 4 {
        return "${int(b[0])}.${int(b[1])}.${int(b[2])}.${int(b[3])}"
    }
    return hex.Format(b)
}

// Go の双子と同じ形の 1 行
func line(name string, c Cert) string {
    ca := if c.bcValid { if c.isCA { "true" } else { "false" } } else { "-" }
    pl := if c.bcValid && c.pathLen >= 0 { "${c.pathLen}" } else { "-" }
    mut ips := mut []string{}
    for ip <- c.ips {
        ips = append(ips, ipText(ip))
    }
    return "${name} v=${c.version} sig=${sigName(c.sigAlg)} pub=${pubName(c)} nb=${c.notBefore} na=${c.notAfter} ca=${ca} pl=${pl} ku=${c.keyUsage} eku=${joinSorted(c.eku)} dns=${joinSorted(c.dns)} ip=${joinSorted(freeze(ips))} ski=${opt(c.ski)} aki=${opt(c.aki)} tbs=${h8(c.tbs)} spki=${h8(c.spki)} iss=${h8(c.issuer)} sub=${h8(c.subject)}"
}

func TestAgainstGo() {
    want := strings.Split(strings.TrimSpace(get(Fields, "testdata/x509/fields.txt")), "\n")
    assert(len(want) == 441)
    mut got := mut map[string]string{}
    mut accepted := mut map[string]bool{}
    gs := GoCerts
    for k <- gs {
        bs, _ := crypto.pem.Parse(get(gs, k))
        nm := "go/${strings.TrimPrefix(k, "testdata/x509/go/")}"
        c, ok := Parse(bs[0].der)
        accepted[nm] = ok
        if ok {
            got[nm] = line(nm, c)
        }
    }
    for l <- strings.Split(strings.TrimSpace(get(Pkits, "testdata/x509/pkits/certs.txt")), "\n") {
        f := strings.Fields(l)
        der, _ := base64.Decode(f[1])
        nm := "pkits/${f[0]}"
        c, ok := Parse(der)
        accepted[nm] = ok
        if ok {
            got[nm] = line(nm, c)
        }
    }
    mut bad := 0
    mut skipped := 0
    for w <- want {
        nm := strings.Fields(w)[0]
        if strings.HasSuffix(w, " error") {
            skipped += 1
            a := accepted[nm]
            ours := if a != nil && a { "accepts" } else { "rejects" }
            println("go rejects ${nm} — ours ${ours}")
            println("conf-item: go-x509/go-rejects/${ours} ${nm}")
        } else {
            g := got[nm]
            gs2 := if g != nil { g } else { "(rejected)" }
            if gs2 != w {
                println("mismatch ${nm}")
                println("  want ${w}")
                println("  got  ${gs2}")
                bad += 1
            }
        }
    }
    println("x509: ${len(want)} certs, ${skipped} rejected by Go, ${bad} mismatched")
    assert(bad == 0)
    println("conf: go-x509/fields ${len(want) - skipped}")
    println("conf: go-x509/go-rejects ${skipped}")
}

// 時刻の値と拒否（1970-01-01・閏日・UTCTime の 49 / 50 の境・GeneralizedTime・秒なし・Z なし・小数秒・範囲の外の月日時）
func tm(tag int, s string) int {
    b := bytes(s)
    v, ok := timeOf(b, El{tag: tag, at: 0, cs: 0, ce: len(b)})
    return if ok { v } else { -1 }
}

func TestTime() {
    assert(tm(0x17, "700101000000Z") == 0)
    assert(tm(0x17, "000229235959Z") == 951868799)
    assert(tm(0x17, "491231235959Z") == 2524607999)
    assert(tm(0x17, "500101000000Z") == -631152000)
    assert(tm(0x18, "20500101000000Z") == 2524608000)
    assert(tm(0x18, "99991231235959Z") == 253402300799)
    assert(tm(0x17, "7001010000Z") == -1)
    assert(tm(0x17, "700101000000+0000") == -1)
    assert(tm(0x18, "20500101000000.5Z") == -1)
    assert(tm(0x17, "010229000000Z") == -1)
    assert(tm(0x17, "701301000000Z") == -1)
    assert(tm(0x17, "700101240000Z") == -1)
    assert(tm(0x18, "700101000000Z") == -1)
}

// DER の頭の拒否（不定長・最短でない長さ・高タグ番号・中身が足りない）と受理
func TestDerHeads() {
    _, ok1 := elAt([]byte{0x30, 0x80, 0, 0}, 0, 4)
    assert(!ok1)
    _, ok2 := elAt([]byte{0x04, 0x81, 0x05, 1, 2, 3, 4, 5}, 0, 8)
    assert(!ok2)
    _, ok3 := elAt([]byte{0x1f, 0x01, 0x00}, 0, 3)
    assert(!ok3)
    _, ok4 := elAt([]byte{0x04, 0x03, 1, 2}, 0, 4)
    assert(!ok4)
    mut long := mut []byte{0x04, 0x82, 0x00, 0x80}
    for i <- iter.Range(0, 128) {
        long = append(long, byte(i))
    }
    _, ok5 := elAt(freeze(long), 0, 132)
    assert(!ok5)
    mut ok81 := mut []byte{0x04, 0x81, 0x80}
    for i <- iter.Range(0, 128) {
        ok81 = append(ok81, byte(i))
    }
    e, ok6 := elAt(freeze(ok81), 0, 131)
    assert(ok6 && e.cs == 3 && e.ce == 131)
    // 後ろに余りのある証明書は拒否
    bs, _ := crypto.pem.Parse(get(GoCerts, "testdata/x509/go/googleLeaf.pem"))
    mut tail := mut []byte{}
    for x <- bs[0].der {
        tail = append(tail, x)
    }
    tail = append(tail, byte(0))
    _, ok7 := Parse(freeze(tail))
    assert(!ok7)
    _, ok8 := Parse(bs[0].der)
    assert(ok8)
}

func TestOidText() {
    assert(oidText(hexBytes("2a864886f70d01010b")) == "1.2.840.113549.1.1.11")
    assert(oidText(hexBytes("551d25")) == "2.5.29.37")
    assert(oidText(hexBytes("2a8086")) == "?")
    assert(oidText(hexBytes("2a86")) == "?")
}

// CA/B の leaf 規則（焼き込みの起点の鎖だけ）: 形の良い leaf から 1 つずつ崩す
func TestCabLeaf() {
    mut g := noCert()
    g.version = 3
    g.eku = []string{"1.3.6.1.5.5.7.3.1"}
    g.dns = []string{"example.com"}
    g.notBefore = 1000000
    g.notAfter = 1000000 + 398 * 86400 - 1
    assert(CabLeaf(g) == nil)
    mut long := g
    long.notAfter = g.notAfter + 1
    assert(CabLeaf(long) != nil)
    mut noEku := g
    noEku.eku = []string{}
    assert(CabLeaf(noEku) != nil)
    mut anyEku := g
    anyEku.eku = []string{"1.3.6.1.5.5.7.3.1", "2.5.29.37.0"}
    assert(CabLeaf(anyEku) != nil)
    mut ca := g
    ca.bcValid = true
    ca.isCA = true
    assert(CabLeaf(ca) != nil)
    mut noSan := g
    noSan.dns = []string{}
    assert(CabLeaf(noSan) != nil)
    mut v1 := g
    v1.version = 1
    assert(CabLeaf(v1) != nil)
    // 焼き込みの起点には印・RootsFromPEM の起点には無い
    assert(Roots()[0].baked)
}
