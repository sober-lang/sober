package main

// `sober test` の handler（package の *_test.sober の TestXxx() を集めて走らせる）

import "std/io"
import "std/iter"
import "std/os"
import "std/cli"
import "std/strings"
import "std/hash"
import "std/hex"
import "std/sort"
import "ast"
import "loader"
import "lower"

// `sober test <package>… [--work <dir>] [--run <接頭辞>] [-v]`（T1・T8）: package ごとに
// テストのビルド（loader.LoadTestFs — 合成の main）を Sober の正規バックエンド（lower.ElfPasses — B-4）で <work>/t に書き、実行の bit を付けて
// （os.WriteMode）、TestXxx を 1 つずつ別プロセス（std/os.RunTo）で走らせて終了コードを集計する。子の出力は捕まえて、テストごとに
// 結果の行の前へ書き出す（-v は受けるが今は常に見せる形と同じ）。--run は名前の接頭辞で絞る。終了コード = 失敗があれば 1。
// 全部通った package の印字は置き場に覚え、次の同じ問い合わせは建てずに走らせずに同じ印字を返す（結果の再生 — --fresh で走らせ直す）
func cmdTest(cl cli.Parsed) int {
    pkgs := cli.PosList(cl, Pkgs)
    wo := cli.StrOpt(cl, TWork)
    ro := cli.StrOpt(cl, TRun)
    prefix := if ro == nil { "" } else { ro }
    fresh := cli.Bool(cl, TFresh)
    // --work が無ければ置き場を自分で作る（cacheDir()/sober-test/<pid> — 置き場が無ければ /tmp/sober-test/<pid>。同時に走る別のプロセスと
    // テストの実行ファイルを取り合わない。std に削除の口が無いので後片付けはしない — 中身は最後のテストの実行ファイル 1 本）
    work := if wo == nil { testWork() } else { wo }
    if work == "" {
        return fail("sober: test: cannot make a work directory (pass --work <dir>)")
    }
    std := Std
    mut pass := 0
    mut failn := 0
    for k <- iter.Range(0, len(pkgs)) {
        r := testReplayed(pkgs[k], std, work, prefix, fresh)
        pass += r.pass
        failn += r.fail
    }
    println("${pass} passed, ${failn} failed")
    return if failn == 0 { 0 } else { 1 }
}

// `sober test` の既定の作業場所（--work が無いとき）。pid は /proc/self/stat の最初の欄
func testWork() string {
    st := io.ReadFile("/proc/self/stat") catch return ""
    mut n := 0
    while n < len(st) && st[n] != ' ' {
        n += 1
    }
    pid := string(st[0:n]) catch return ""
    cd := cacheDir()
    base := if cd == "" { "/tmp/sober-test" } else { cd + "/sober-test" }
    dir := "${base}/${pid}"
    mkdirs(dir)
    return dir
}

// package 1 つ分の集計
type TestTally struct {
    pass int
    fail int
    files []string // テストのビルドが読んだ利用者のファイル（建たなければ空）
    envs []string  // テストのコードが読む環境変数の名前（リテラル — 静的に集めた）
    envOk bool     // 読む環境変数を全部リテラルで集められたか（偽なら結果を覚えない）
}

// package pkg のテストを建てて走らせる（建たなければ FAIL 1 件として数える）。テストのビルドは build と同じ後段の関数キャッシュの道
// （SOBER_BUILD_CACHE=0 で切れる）。子の標準出力 / 標準エラーは <work>/o・<work>/e に捕まえ、テストごとに標準出力 → 標準エラーの順で
// 書き出してから結果の行を印字する（1 本のテストの中の 2 本の流れの前後は保たない）
// log には書き出した順に（fd, バイト列）を積む（結果の再生の値）
func testPkg(pkg string, std map[string]string, work string, prefix string, log mut []byte) TestTally {
    bd := buildCacheDir()
    bv := lower.BcOpen(bd)
    p, pcs, lerr := loadNamed(pkg, true, std, if bv.on { lower.BcParseView(bv) } else { loader.PcOff() })
    if lerr != nil {
        say(mut log, 1, bytes("FAIL ${pkg} (build)\n"))
        // 診断は標準エラーへ（書けなくても集計は同じ — 失敗 1 件）
        say(mut log, 2, bytes("sober: ${loadDiag(p, std, lerr)}\n"))
        return failTally()
    }
    names, nerr := loader.TestNames(p, pkg)
    exe, berr := testExe(p, bd, bv, pcs)
    if nerr != nil || berr != nil {
        say(mut log, 1, bytes("FAIL ${pkg} (build)\n"))
        // 診断は build と同じ形で標準エラーへ（集計は同じ — 失敗 1 件）
        _ = if nerr != nil { fail(loadDiag(p, std, nerr)) } else { lowerFail(p, std, berr) }
        return failTally()
    }
    bin := work + "/t"
    if writeExeSync(bin, exe) != nil || os.WriteMode(bin, 493) != nil {
        say(mut log, 1, bytes("FAIL ${pkg} (build)\n"))
        return failTally()
    }
    mut pass := 0
    mut failn := 0
    for k <- iter.Range(0, len(names)) {
        if prefix == "" || strings.HasPrefix(names[k], prefix) {
            ec, eerr := os.RunTo(bin, []string{names[k]}, work + "/o", work + "/e")
            if eerr == nil {
                showCaught(mut log, work + "/o", 1)
                showCaught(mut log, work + "/e", 2)
            }
            if eerr == nil && ec == 0 {
                say(mut log, 1, bytes("ok   ${pkg}.${names[k]}\n"))
                pass += 1
            } else {
                say(mut log, 1, bytes("FAIL ${pkg}.${names[k]} (exit ${ec})\n"))
                failn += 1
            }
        }
    }
    fs := userFiles(p)
    ev := testEnvNames(realFiles(fs))
    return TestTally{pass: pass, fail: failn, files: fs, envs: ev.names, envOk: ev.ok}
}

func failTally() TestTally {
    return TestTally{pass: 0, fail: 1, files: []string{}, envs: []string{}, envOk: false}
}

// path を消してから exe を同期の write(2)（std/os の生の syscall — ring を通らない）で書く。stage2 自身の rt の WriteFile が ring で書く間は、
// 書いた直後の execve がファイルの参照の残りで ETXTBSY になりうる（rt の write_file を同期にした段より前の boot が stage2 を建てる間の橋）
func writeExeSync(path string, exe []byte) error? {
    _ = os.Remove(path)
    return os.AppendFile(path, exe)
}

// テストのビルドの ELF（置き場 bd があれば後段の関数キャッシュの道）
func testExe(p loader.Program, bd string, bv lower.BcView, pcs []loader.PcPut) ([]byte, error?) {
    if bd != "" {
        return lower.ElfPassesCache(p, bd, bv, pcs)
    }
    return lower.ElfPasses(p)
}

// 捕まえた子の出力を親の fd（1 / 2）へ書き出す（読めないときは黙って飛ばす — 集計は終了コードで決まる）
func showCaught(log mut []byte, path string, fd int) {
    b := io.ReadFile(path) catch return
    say(mut log, fd, b)
}

// b を fd（1 = 標準出力・2 = 標準エラー）へ書き、log に積む（空なら何もしない。書けなくても集計は同じ）
func say(log mut []byte, fd int, b []byte) {
    if len(b) == 0 {
        return
    }
    _ = if fd == 2 { io.WriteStderr(b) } else { io.WriteStdout(b) }
    lenPut(mut log, bytes("${fd}"))
    lenPut(mut log, b)
}

// ── テストの結果の再生（docs/incremental.md）──
//
// 全部通った package の印字（書き出した順の標準出力 / 標準エラーの列）を置き場に覚え、次の同じ問い合わせは建てずに走らせずに返す。
// 鍵 = package の綴り ‖ --run の接頭辞 ‖ PWD ‖ 環境の SOBER_* の全部（rt が読む種・ワーカー数等 — 置き場の口は除く）。置き場は build の世代の
// ディレクトリ（コンパイラが変われば別）。値には印字と一緒に、テストのビルドが読んだ利用者のファイルの中身・そのディレクトリの .sober の名前の列・
// package の testdata/ の丸ごと（名前と中身 — 再帰）・テストのコードが読む環境変数（os.Getenv のリテラル・env / cli の表の name — 静的に集める）の値を
// 持ち、引くときに全部を照合する。失敗のある package と、リテラルでない環境変数の読みを持つ package は覚えない

// package 1 つ分を、置き場に覚えた印字があれば返し、無ければ建てて走らせて（全部通ったら）覚える
func testReplayed(pkg string, std map[string]string, work string, prefix string, fresh bool) TestTally {
    dir := buildCacheDir()
    mut log := mut []byte{}
    if dir == "" || envIs("SOBER_CHECK_REPLAY", "0") {
        return testPkg(pkg, std, work, prefix, mut log)
    }
    key := testReplayKey(pkg, prefix)
    verify := envIs("SOBER_CACHE_VERIFY", "1") || envIs("SOBER_CACHE_VERIFY", "2")
    hit := if fresh { noTestHit() } else { testReplayGet(dir, key) }
    if hit.ok && !verify {
        replayStatOf("test", "1/1")
        replayLog(hit.log)
        return TestTally{pass: hit.pass, fail: 0, files: []string{}, envs: []string{}, envOk: true}
    }
    r := testPkg(pkg, std, work, prefix, mut log)
    if hit.ok && (r.fail != 0 || r.pass != hit.pass || !bytesEq(freeze(log), hit.log)) {
        _ = io.WriteStderr(bytes("cache: stale entry test-replay ${key}\n"))
        panic(InvariantBroken{})
    }
    replayStatOf("test", if hit.ok { "1/1" } else { "0/1" })
    if r.fail != 0 {
        replayStatOf("test", "skip (failed)")
    } else if !r.envOk {
        replayStatOf("test", "skip (environment read not a literal)")
    } else if len(r.files) == 0 {
        replayStatOf("test", "skip (no files)")
    } else {
        testReplayPut(dir, key, pkg, r, freeze(log))
    }
    return r
}

func testReplayKey(pkg string, prefix string) string {
    mut b := mut []byte{}
    lenPut(mut b, bytes("test-replay 1"))
    lenPut(mut b, bytes(pkg))
    lenPut(mut b, bytes(prefix))
    pwd := os.Getenv("PWD") catch nil
    lenPut(mut b, bytes(if pwd == nil { "" } else { pwd }))
    es := soberEnv()
    for i <- iter.Range(0, len(es)) {
        lenPut(mut b, bytes(es[i]))
    }
    return hex.Format(hash.Sha256(freeze(b)))
}

// 環境の SOBER_* の「NAME=値」の列（名前の順 — 置き場・計測・watch の口〔replayEnvSkip〕は除く。/proc/self/environ が読めなければ空）
func soberEnv() []string {
    b := io.ReadFile("/proc/self/environ") catch return []string{}
    mut out := mut []string{}
    mut start := 0
    for i <- iter.Range(0, len(b)) {
        if b[i] == 0 {
            mut eq := start
            while eq < i && b[eq] != '=' {
                eq += 1
            }
            kv := string(b[start:i]) catch ""
            name := string(b[start:eq]) catch ""
            start = i + 1
            if strings.HasPrefix(name, "SOBER_") && eq < i && !hasStr(replayEnvSkip, name) {
                out = append(out, kv)
            }
        }
    }
    // 名前の順へ（環境の並びは親に依る）
    xs := freeze(out)
    ord := sort.Order(len(xs), (i, j) => bytesLess(bytes(xs[i]), bytes(xs[j])))
    mut sorted := mut []string{}
    for i <- iter.Range(0, len(ord)) {
        sorted = append(sorted, xs[ord[i]])
    }
    return freeze(sorted)
}

// a が b より辞書順で前か（バイトごと）
func bytesLess(a []byte, b []byte) bool {
    n := if len(a) < len(b) { len(a) } else { len(b) }
    for i <- iter.Range(0, n) {
        if a[i] != b[i] {
            return a[i] < b[i]
        }
    }
    return len(a) < len(b)
}

// テストのコードが読む環境変数の名前（ok = 全部リテラルで集められた）
type EnvNames struct {
    names []string
    ok bool
}

// 利用者のファイルの木から、os.Getenv("名前") のリテラルと env.StrVar / IntVar / BoolVar・cli.Env の表の name: "名前" を集める。
// リテラルでない Getenv の実引数・表の name は ok = 偽（何を読むか静的に分からない）
func testEnvNames(files []string) EnvNames {
    mut out := mut []string{}
    for i <- iter.Range(0, len(files)) {
        b := io.ReadFile(files[i]) catch return EnvNames{names: []string{}, ok: false}
        t, ok := parseFile(files[i], b)
        if !ok || !envNamesOf(t, mut out) {
            return EnvNames{names: []string{}, ok: false}
        }
    }
    return EnvNames{names: freeze(out), ok: true}
}

// 木 t の節を全部見て out へ名前を足す（重複なし）。リテラルでない読みがあれば偽
func envNamesOf(t ast.Tree, out mut []string) bool {
    for k <- iter.Range(0, len(t.nodes)) {
        x := t.nodes[k]
        if x.kind == ast.ECall && x.a >= 0 && t.nodes[x.a].kind == ast.ESelector && loader.Name(t, t.nodes[x.a].b) == "Getenv" {
            if x.b < 0 || ast.ListLen(t, x.b) < 1 {
                return false
            }
            if !envLit(t, ast.ListAt(t, x.b, 0), mut out) {
                return false
            }
        }
        if x.kind == ast.EComposite && envTable(loader.Name(t, x.a)) {
            for i <- iter.Range(0, ast.ListLen(t, x.b)) {
                el := t.nodes[ast.ListAt(t, x.b, i)]
                if el.a >= 0 && loader.Name(t, el.a) == "name" && !envLit(t, el.b, mut out) {
                    return false
                }
            }
        }
    }
    return true
}

// 節 n が文字列リテラルならその値を out へ足して真
func envLit(t ast.Tree, n int, out mut []string) bool {
    if n < 0 || t.nodes[n].kind != ast.EStrlit {
        return false
    }
    v := loader.Name(t, t.nodes[n].a)
    for i <- iter.Range(0, len(out)) {
        if out[i] == v {
            return true
        }
    }
    out = append(out, v)
    return true
}

// 型の名前が環境変数の表の行（std/env の StrVar / IntVar / BoolVar・std/cli の Env — import の別名を問わず末尾で見る）か
func envTable(name string) bool {
    return strings.HasSuffix(name, ".StrVar") || strings.HasSuffix(name, ".IntVar") || strings.HasSuffix(name, ".BoolVar") || strings.HasSuffix(name, ".Env")
}

// ディレクトリ d の中身の丸ごとのハッシュ（相対の名前・種類・ファイルの中身 — 名前の順に再帰。無ければ "none"・読めなければ ""）
func treeSum(d string) string {
    if !isDir(d) {
        return "none"
    }
    mut b := mut []byte{}
    if !treeWalk(d, "", mut b) {
        return ""
    }
    return hex.Format(hash.Sha256(freeze(b)))
}

func treeWalk(d string, rel string, b mut []byte) bool {
    es := io.ReadDir(d) catch return false
    for i <- iter.Range(0, len(es)) {
        name := es[i].Name
        path := d + "/" + name
        r := rel + "/" + name
        switch es[i].Kind {
        case io.Dir{}:
            lenPut(mut b, bytes("d" + r))
            if !treeWalk(path, r, mut b) {
                return false
            }
        default:
            c := io.ReadFile(path) catch return false
            lenPut(mut b, bytes("f" + r))
            lenPut(mut b, bytes(hex.Format(hash.Sha256(c))))
        }
    }
    return true
}

func isDir(d string) bool {
    _ = io.ReadDir(d) catch return false
    return true
}

// 引き当ての結果（ok = 照合まで通った・pass = 通ったテストの数・log = 書き出した順の (fd, バイト列) の列）
type TestHit struct {
    ok bool
    pass int
    log []byte
}

func noTestHit() TestHit {
    return TestHit{ok: false, pass: 0, log: []byte{}}
}

// 覚えた印字 log を同じ順に fd へ書き出す
func replayLog(log []byte) {
    fs := lenFields(log)
    mut q := 0
    while q + 1 < len(fs.xs) {
        _ = if atoiOf(fs.xs[q]) == 2 { io.WriteStderr(fs.xs[q + 1]) } else { io.WriteStdout(fs.xs[q + 1]) }
        q += 2
    }
}

// 結果 r と印字 log を覚える（読んだファイルが読めない・ディレクトリが並べられない・testdata が読めないときは覚えない）
func testReplayPut(dir string, key string, pkg string, r TestTally, log []byte) {
    mut v := mut []byte{}
    fs := realFiles(r.files)
    ds := replayDirs(fs)
    lenPut(mut v, bytes("${len(fs)}"))
    for i <- iter.Range(0, len(fs)) {
        b := io.ReadFile(fs[i]) catch {
            replayStatOf("test", "skip (cannot read ${fs[i]})")
            return
        }
        lenPut(mut v, bytes(fs[i]))
        lenPut(mut v, bytes(hex.Format(hash.Sha256(b))))
        lenPut(mut v, bytes(embedSum(fs[i], b)))
    }
    lenPut(mut v, bytes("${len(ds)}"))
    for i <- iter.Range(0, len(ds)) {
        sum := dirSum(ds[i])
        if sum == "" {
            replayStatOf("test", "skip (cannot list ${ds[i]})")
            return
        }
        lenPut(mut v, bytes(ds[i]))
        lenPut(mut v, bytes(sum))
    }
    td := pkg + "/testdata"
    tsum := treeSum(td)
    if tsum == "" {
        replayStatOf("test", "skip (cannot read ${td})")
        return
    }
    lenPut(mut v, bytes(td))
    lenPut(mut v, bytes(tsum))
    lenPut(mut v, bytes("${len(r.envs)}"))
    for i <- iter.Range(0, len(r.envs)) {
        lenPut(mut v, bytes(r.envs[i]))
        lenPut(mut v, bytes(envVal(r.envs[i])))
    }
    lenPut(mut v, bytes("${r.pass}"))
    lenPut(mut v, log)
    cachePut(dir, key, freeze(v))
}

// 環境変数 name の値の印（無ければ "-"・あれば "=" + 値 — 空の値と無いのを分ける）
func envVal(name string) string {
    v := os.Getenv(name) catch return "!"
    return if v == nil { "-" } else { "=" + v }
}

// 鍵の値を引き、読んだファイル・ディレクトリ・testdata・環境変数を今と照合する
func testReplayGet(dir string, key string) TestHit {
    cv := cacheGet(dir, key)
    if !cv.ok {
        return noTestHit()
    }
    fs := lenFields(cv.val)
    if !fs.ok || len(fs.xs) < 1 {
        return noTestHit()
    }
    xs := fs.xs
    mut q := 0
    nf := atoiOf(xs[q])
    q += 1
    for i <- iter.Range(0, nf) {
        if q + 2 >= len(xs) {
            return noTestHit()
        }
        path := string(xs[q]) catch return noTestHit()
        b := io.ReadFile(path) catch return noTestHit()
        if hex.Format(hash.Sha256(b)) != (string(xs[q + 1]) catch "") || embedSum(path, b) != (string(xs[q + 2]) catch "") {
            return noTestHit()
        }
        q += 3
    }
    if q >= len(xs) {
        return noTestHit()
    }
    nd := atoiOf(xs[q])
    q += 1
    for i <- iter.Range(0, nd) {
        if q + 1 >= len(xs) {
            return noTestHit()
        }
        d := string(xs[q]) catch return noTestHit()
        if dirSum(d) != (string(xs[q + 1]) catch "") {
            return noTestHit()
        }
        q += 2
    }
    if q + 2 >= len(xs) {
        return noTestHit()
    }
    td := string(xs[q]) catch return noTestHit()
    if treeSum(td) != (string(xs[q + 1]) catch "") {
        return noTestHit()
    }
    ne := atoiOf(xs[q + 2])
    q += 3
    for i <- iter.Range(0, ne) {
        if q + 1 >= len(xs) {
            return noTestHit()
        }
        name := string(xs[q]) catch return noTestHit()
        if envVal(name) != (string(xs[q + 1]) catch "") {
            return noTestHit()
        }
        q += 2
    }
    if q + 1 >= len(xs) {
        return noTestHit()
    }
    return TestHit{ok: true, pass: atoiOf(xs[q]), log: xs[q + 1]}
}
