    case W_TX: "tx"
    case W_RX: "rx"
    case W_CLOSE: "close"
    case W_CALLMV: "callmv"
    case W_EPS: "eps"
    case W_CLONE: "clone"
    default: "byte" // W_BYTE
    }
}

func isExprKind(c int) bool {
    return c == W_NIL || c == W_SOME || (c >= W_LIT && c <= W_RECV) || c == W_STRLIT || c == W_COPYTO || c == W_KEYSM || c == W_CLONE || c == W_UNREACH || c == W_TOBYTE || c == W_TOINT || (c >= W_FLIT && c <= W_FFROMBITS) || (c >= W_SCOPE && c <= W_NEWCH) || c == W_CLOSE || c == W_CALLMV
}

func isTyKind(c int) bool {
    return c >= W_INT && c <= W_FN || c == W_BYTE || c == W_F64 || c == W_OWN
}

// 値の tag（parse 中の欄・配列の要素）
const V_NUM = 1   // val = 整数（i64 に収まる）
const V_BIG = 2   // i64 を超える整数（Int としては読める。Nat の欄では拒否 — コーパスに現れない）
const V_FRAC = 3  // 小数・指数つき（Lean の getInt? / getNat? は通さない）
const V_STR = 4   // val = 語の番号（0 = 語の表に無い）
const V_TRUE = 5
const V_FALSE = 6
const V_NULL = 7
const V_EXPR = 8  // val = 式の記録
const V_TY = 9    // val = 型の記録
const V_ERR = 10  // k はあるが型にも式にも組めない object
const V_OBJ = 11  // k の無い object
const V_ARR = 12  // val = [n, 先頭の cell]（cell = [tag, val, gen, next]）

func isObjTag(t int) bool {
    return t == V_EXPR || t == V_TY || t == V_ERR || t == V_OBJ
}

// ── 語の表（開番地法のハッシュ表。表の大きさ 1024、中身 = 語の番号）──

const WTSZ = 1024

func hashRange(src []byte, s int, e int) int {
    mut h := 7
    for i <- iter.Range(s, e) {
        h = (h * 31 + int(src[i])) % 1000003
    }
    return h
}

// 語の綴りをヒープへ置き（WSTR = st.wtab の表の直後に番号順の綴りへの添字）、表を組む
func initWords(st mut S) {
    tab := block(mut st, WTSZ + NW)
    st.wtab = tab
    mut c := 1
    while c < NW {
        b := bytes(wordStr(c))
        at := table.Len(mut st.h)
        table.Push(mut st.h, len(b))
        for j <- iter.Range(0, len(b)) {
            table.Push(mut st.h, int(b[j]))
        }
        table.Set(mut st.h, tab + WTSZ + c, at)
        mut p := hashRange(b, 0, len(b)) % WTSZ
        while table.Get(mut st.h, tab + p) != 0 {
            p = (p + 1) % WTSZ
        }
        table.Set(mut st.h, tab + p, c)
        c += 1
    }
}

// src[s:e] の綴りの語の番号（無ければ 0）
func wordOf(st mut S, src []byte, s int, e int) int {
    tab := st.wtab
    mut p := hashRange(src, s, e) % WTSZ
    while table.Get(mut st.h, tab + p) != 0 {
        c := table.Get(mut st.h, tab + p)
        w := table.Get(mut st.h, tab + WTSZ + c)
        if table.Get(mut st.h, w) == e - s {
            mut j := 0
            while j < e - s && table.Get(mut st.h, w + 1 + j) == int(src[s + j]) {
                j += 1
            }
            if j == e - s {
                return c
            }
        }
        p = (p + 1) % WTSZ
    }
    return 0
}

// ── parse の枠（深さごと。[ctype, stamp, curKey, arrN, arrHead, arrTail] + 語ごとの欄 [stamp, tag, val, gen]）──

const FS = 6 + 4 * NW
const C_OBJ = 1
const C_ARR = 2

func frameAt(st mut S, dep int) int {
    return st.pstk + (dep - 1) * FS
}

func slotOf(fb int, w int) int {
    return fb + 6 + 4 * w
}

func has(st mut S, fb int, w int) bool {
    return table.Get(mut st.h, slotOf(fb, w)) == table.Get(mut st.h, fb + 1)
}

func sTag(st mut S, fb int, w int) int {
    return if has(mut st, fb, w) { table.Get(mut st.h, slotOf(fb, w) + 1) } else { 0 }
}

func sVal(st mut S, fb int, w int) int {
    return table.Get(mut st.h, slotOf(fb, w) + 2)
}

// 欄の読み出し（読めなければ -1。Lean の getObjVal? >>= … の失敗 = parse error）
func fE(st mut S, fb int, w int) int {
    return if sTag(mut st, fb, w) == V_EXPR { sVal(mut st, fb, w) } else { -1 }
}

func fT(st mut S, fb int, w int) int {
    return if sTag(mut st, fb, w) == V_TY { sVal(mut st, fb, w) } else { -1 }
}

func fN(st mut S, fb int, w int) int {
    return if sTag(mut st, fb, w) == V_NUM && sVal(mut st, fb, w) >= 0 { sVal(mut st, fb, w) } else { -1 }
}

func fB(st mut S, fb int, w int) int {
    t := sTag(mut st, fb, w)
    return if t == V_TRUE { 1 } else if t == V_FALSE { 0 } else { -1 }
}

// 綴りの欄の語の番号（綴りでなければ -1。語の表に無い綴りは 0）
func fW(st mut S, fb int, w int) int {
    return if sTag(mut st, fb, w) == V_STR { sVal(mut st, fb, w) } else { -1 }
}

func fIntOk(st mut S, fb int, w int) bool {
    t := sTag(mut st, fb, w)
    return t == V_NUM || t == V_BIG
}

func nc(st mut S, e int) int {
    return table.Get(mut st.h, e + 1)
}

// 式の記録 [kind, nc, a, b, c]
func node(st mut S, k int, n int, a int, b int, c int) int {
    return rec5(mut st, k, n, a, b, c)
}

// "ts" の欄（省略 = -1、空の配列も -1）。要素が型でなければ -2（parse error）
func tsOf(st mut S, fb int) int {
    t := sTag(mut st, fb, W_TS)
    if t == 0 {
        return -1
    }
    if t != V_ARR {
        return -2
    }
    hd := sVal(mut st, fb, W_TS)
    n := table.Get(mut st.h, hd)
    if n == 0 {
        return -1
    }
    mut c := table.Get(mut st.h, hd + 1)
    while c >= 0 {
        if table.Get(mut st.h, c) != V_TY {
            return -2
        }
        c = table.Get(mut st.h, c + 3)
    }
    at := table.Len(mut st.h)
    table.Push(mut st.h, n)
    c = table.Get(mut st.h, hd + 1)
    while c >= 0 {
        table.Push(mut st.h, table.Get(mut st.h, c + 1))
        c = table.Get(mut st.h, c + 3)
    }
    return at
}

// 枠 fb の object を型 kind c として組む（組めなければ -1）
func buildTy(st mut S, fb int, c int) int {
    switch c {
    case W_INT:
        return st.tInt
    case W_BOOL:
        return st.tBool
    case W_BYTE:
        return st.tByte
    case W_F64:
        return st.tF64
    case W_UNIT:
        return st.tUnit
    case W_TVAR:
        i := fN(mut st, fb, W_I)
        return if i < 0 { -1 } else { mk(mut st, TVar, i, 0, 0) }
    case W_OPT:
        t := fT(mut st, fb, W_T)
        return if t < 0 { -1 } else { mk(mut st, TOpt, t, 0, 0) }
    case W_UNION | W_PROD | W_FN:
        l := fT(mut st, fb, if c == W_FN { W_P } else { W_L })
        r := fT(mut st, fb, W_R)
        if l < 0 || r < 0 {
            return -1
        }
        return mk(mut st, if c == W_UNION { TUn } else if c == W_PROD { TPr } else { TFn }, l, r, 0)
    case W_REF | W_SLICE | W_MAP:
        m := fB(mut st, fb, W_M)
        r := fN(mut st, fb, W_R)
        if m < 0 || r < 0 {
            return -1
        }
        if c == W_MAP {
            if has(mut st, fb, W_CELL) {
                cl := fT(mut st, fb, W_CELL)
                return if cl < 0 { -1 } else { mk(mut st, TMp, m, r, cl) }
            }
            kt := fT(mut st, fb, W_KEY)
            vt := fT(mut st, fb, W_T)
            if kt < 0 || vt < 0 {
                return -1
            }
            o := mk(mut st, TOpt, vt, 0, 0)
            cl := mk(mut st, TPr, kt, o, 0)
            return mk(mut st, TMp, m, r, cl)
        }
        t := fT(mut st, fb, W_T)
        return if t < 0 { -1 } else { mk(mut st, if c == W_REF { TRef } else { TSl }, m, r, t) }
    case W_CHAN:
        rc := fN(mut st, fb, W_RC)
        t := fT(mut st, fb, W_T)
        return if rc < 0 || t < 0 { -1 } else { mk(mut st, TChan, rc, t, 0) }
    case W_OWN:
        // o の綴り → 種類（0 scope / 1 task / 2 tx / 3 rx — Lean の ownKFromStr。他の綴りは parse error）
        ow := fW(mut st, fb, W_O)
        o := if ow == W_SCOPE { 0 } else if ow == W_TASK { 1 } else if ow == W_TX { 2 } else if ow == W_RX { 3 } else { -1 }
        r := fN(mut st, fb, W_R)
        t := fT(mut st, fb, W_T)
        return if o < 0 || r < 0 || t < 0 { -1 } else { mk(mut st, TOwn, o, r, t) }
    }
    return -1
}

// 枠 fb の object を式 kind c として組む（組めなければ -1）
func buildExpr(st mut S, fb int, c int) int {
    switch c {
    case W_LIT | W_FLIT:
        return if fIntOk(mut st, fb, W_N) { node(mut st, c, 0, 0, 0, 0) } else { -1 }
    case W_TRUE | W_FALSE | W_TRIV:
        return node(mut st, c, 0, 0, 0, 0)
    case W_VAR:
        i := fN(mut st, fb, W_I)
        return if i < 0 { -1 } else { node(mut st, c, 0, i, 0, 0) }
    }
    // 式 2 つ（欄の語 w1, w2）
    if c == W_LET || c == W_ADD || c == W_LT || (c >= W_SUB && c <= W_GE) || (c >= W_FADD && c <= W_FGE) || c == W_PAIR || c == W_CALLV || c == W_ASSIGN || c == W_WHILE || c == W_APPEND || c == W_EQS || c == W_CONCAT || c == W_PAR || c == W_SEND {
        w1 := if c == W_LET { W_E } else if c == W_CALLV { W_F } else if c == W_ASSIGN { W_L } else if c == W_WHILE { W_C } else if c == W_APPEND { W_E } else if c == W_PAR { W_E1 } else if c == W_SEND { W_C } else { W_A }
        w2 := if c == W_LET || c == W_WHILE { W_BODY } else if c == W_CALLV || c == W_ASSIGN || c == W_SEND { W_E } else if c == W_APPEND { W_V } else if c == W_PAR { W_E2 } else { W_B }
        a := fE(mut st, fb, w1)
        b := fE(mut st, fb, w2)
        if a < 0 || b < 0 {
            return -1
        }
        return node(mut st, c, nc(mut st, a) | nc(mut st, b), a, b, 0)
    }
    // 式 3 つ
    switch c {
    case W_IF | W_IFNIL | W_CASE | W_SETIDX | W_SUBSLICE | W_SETM:
        w1 := if c == W_IF { W_C } else { W_E }
        w2 := if c == W_IF { W_T } else if c == W_IFNIL { W_NIL } else if c == W_CASE { W_L } else if c == W_SETIDX { W_I } else if c == W_SUBSLICE { W_A } else { W_KEY }
        w3 := if c == W_IF { W_E } else if c == W_IFNIL { W_SOME } else if c == W_CASE { W_R } else if c == W_SUBSLICE { W_B } else { W_V }
        a := fE(mut st, fb, w1)
        b := fE(mut st, fb, w2)
        d := fE(mut st, fb, w3)
        if a < 0 || b < 0 || d < 0 {
            return -1
        }
        return node(mut st, c, nc(mut st, a) | nc(mut st, b) | nc(mut st, d), a, b, d)
    // 式 1 つ
    case W_SOME | W_FST | W_SND | W_DEREF | W_FREEZE | W_LEN | W_LENM | W_KEYSM | W_RECV | W_CLOSE | W_TOBYTE | W_TOINT | W_FNEG | W_FSQRT | W_TOFLOAT | W_FTOINT | W_FBITS | W_FFROMBITS:
        a := fE(mut st, fb, if c == W_RECV || c == W_CLOSE { W_C } else { W_E })
        return if a < 0 { -1 } else { node(mut st, c, nc(mut st, a), a, 0, 0) }
    // 型 1 つ
    case W_NIL | W_UNREACH:
        t := fT(mut st, fb, W_T)
        return if t < 0 { -1 } else { node(mut st, c, 0, t, 0, 0) }
    // 型 + 式（inl r e / inr l e / ann e t / label t e）
    case W_INL | W_INR | W_ANN | W_LABEL:
        t := fT(mut st, fb, if c == W_INL { W_R } else if c == W_INR { W_L } else { W_T })
        e := fE(mut st, fb, W_E)
        if t < 0 || e < 0 {
            return -1
        }
        return if c == W_ANN { node(mut st, c, nc(mut st, e), e, t, 0) } else { node(mut st, c, nc(mut st, e), t, e, 0) }
    case W_CALL | W_CALLM | W_FNREF:
        f := fN(mut st, fb, W_F)
        ts := tsOf(mut st, fb)
        if f < 0 || ts == -2 {
            return -1
        }
        if c == W_FNREF {
            return node(mut st, c, 0, f, ts, 0)
        }
        e := fE(mut st, fb, W_E)
        return if e < 0 { -1 } else { node(mut st, c, nc(mut st, e), f, ts, e) }
    case W_STRLIT:
        // Lean: bs は int の配列（getArr? >>= mapM getInt?）、r は Nat。検査はバイトを読まないので記録には r だけ持つ
        r := fN(mut st, fb, W_R)
        if r < 0 || sTag(mut st, fb, W_BS) != V_ARR {
            return -1
        }
        hd := sVal(mut st, fb, W_BS)
        mut x := if table.Get(mut st.h, hd) > 0 { table.Get(mut st.h, hd + 1) } else { -1 }
        while x >= 0 {
            if table.Get(mut st.h, x) != V_NUM && table.Get(mut st.h, x) != V_BIG {
                return -1
            }
            x = table.Get(mut st.h, x + 3)
        }
        return node(mut st, c, 0, r, 0, 0)
    case W_BLOCK:
        e := fE(mut st, fb, W_E)
        if e < 0 {
            return -1
        }
        if has(mut st, fb, W_T) {
            t := fT(mut st, fb, W_T)
            return if t < 0 { -1 } else { node(mut st, K_BLOCKR, nc(mut st, e), e, t, 0) }
        }
        return node(mut st, c, nc(mut st, e), e, 0, 0)
    case W_CALLMV:
        // {"k":"callmv","r":a,"f":F,"e":E} — 記録は [callmv, nc, f, e, a]
        k := fN(mut st, fb, W_R)
        f := fE(mut st, fb, W_F)
        e := fE(mut st, fb, W_E)
        if k < 0 || f < 0 || e < 0 {
            return -1
        }
        return node(mut st, c, nc(mut st, f) | nc(mut st, e), f, e, k)
    case W_COPYTO:
        // {"k":"copyto","r":k,"t":T,"e":E} — 記録は [copyto, nc, e, t, k]
        k := fN(mut st, fb, W_R)
        t := fT(mut st, fb, W_T)
        e := fE(mut st, fb, W_E)
        if k < 0 || t < 0 || e < 0 {
            return -1
        }
        return node(mut st, c, nc(mut st, e), e, t, k)
    case W_JUMP:
        n := fN(mut st, fb, W_N)
        t := fT(mut st, fb, W_T)
        e := fE(mut st, fb, W_E)
        if n < 0 || t < 0 || e < 0 {
            return -1
        }
        return node(mut st, c, nc(mut st, e), n, t, e)
    case W_ALLOC:
        m := fB(mut st, fb, W_MUT)
        e := fE(mut st, fb, W_E)
        if m < 0 || e < 0 {
            return -1
        }
        return node(mut st, c, nc(mut st, e), m, e, 0)
    case W_MKSLICE:
        m := fB(mut st, fb, W_M)
        t := fT(mut st, fb, W_T)
        if m < 0 || t < 0 {
            return -1
        }
        // "r" があれば region 指定版（mksliceAt。記録の c = r + 1、0 = 最内）
        if has(mut st, fb, W_R) {
            r := fN(mut st, fb, W_R)
            return if r < 0 { -1 } else { node(mut st, c, 0, m, t, r + 1) }
        }
        return node(mut st, c, 0, m, t, 0)
    case W_CLONE:
        e := fE(mut st, fb, W_E)
        if e < 0 {
            return -1
        }
        mut t := -1
        if has(mut st, fb, W_T) {
            t = fT(mut st, fb, W_T)
            if t < 0 {
                return -1
            }
        }
        return node(mut st, c, nc(mut st, e), e, t, 0)
    case W_INDEX:
        e := fE(mut st, fb, W_E)
        i := fE(mut st, fb, W_I)
        if e < 0 || i < 0 {
            return -1
        }
        mut t := -1
        if has(mut st, fb, W_T) {
            t = fT(mut st, fb, W_T)
            if t < 0 {
                return -1
            }
        }
        return node(mut st, c, nc(mut st, e) | nc(mut st, i), e, i, t)
    case W_MKMAP:
        m := fB(mut st, fb, W_M)
        if m < 0 {
            return -1
        }
        // "r" があれば region 指定版（mkmapAt — 記録の c = r + 1）
        mut rr := 0
        if has(mut st, fb, W_R) {
            r := fN(mut st, fb, W_R)
            if r < 0 {
                return -1
            }
            rr = r + 1
        }
        if has(mut st, fb, W_CELL) {
            cl := fT(mut st, fb, W_CELL)
            return if cl < 0 { -1 } else { node(mut st, c, 0, m, cl, rr) }
        }
        kt := fT(mut st, fb, W_KEY)
        vt := fT(mut st, fb, W_T)
        if kt < 0 || vt < 0 {
            return -1
        }
        o := mk(mut st, TOpt, vt, 0, 0)
        cl := mk(mut st, TPr, kt, o, 0)
        return node(mut st, c, 0, m, cl, rr)
    case W_GETM | W_DELM:
        t := fT(mut st, fb, W_T)
        e := fE(mut st, fb, W_E)
        k := fE(mut st, fb, W_KEY)
        if t < 0 || e < 0 || k < 0 {
            return -1
        }
        return node(mut st, c, nc(mut st, e) | nc(mut st, k), t, e, k)
    case W_PARCH:
        t := fT(mut st, fb, W_T)
        a := fE(mut st, fb, W_E1)
        b := fE(mut st, fb, W_E2)
        if t < 0 || a < 0 || b < 0 {
            return -1
        }
        return node(mut st, c, nc(mut st, a) | nc(mut st, b), t, a, b)
    case W_NEWCHAN:
        rc := fN(mut st, fb, W_RC)
        t := fT(mut st, fb, W_T)
        if rc < 0 || t < 0 {
            return -1
        }
        return node(mut st, c, 1, rc, t, 0)
    // Lean の noNewchan: scope / spawn / join / try は子の論理和（Def の本体での par を許すため）・newch は 0（家の region は shiftTy / renTy で写る）
    case W_SCOPE:
        t := fT(mut st, fb, W_T)
        ep := fT(mut st, fb, W_EPS)
        e := fE(mut st, fb, W_E)
        return if t < 0 || ep < 0 || e < 0 { -1 } else { node(mut st, c, nc(mut st, e), t, e, ep) }
    case W_SPAWN:
        sc := fE(mut st, fb, W_S)
        a := fE(mut st, fb, W_A)
        e := fE(mut st, fb, W_E)
        return if sc < 0 || a < 0 || e < 0 { -1 } else { node(mut st, c, nc(mut st, sc) | nc(mut st, a) | nc(mut st, e), sc, a, e) }
    case W_JOIN | W_TRY:
        t := fT(mut st, fb, W_T)
        h := fE(mut st, fb, W_H)
        return if t < 0 || h < 0 { -1 } else { node(mut st, c, nc(mut st, h), t, h, 0) }
    case W_NEWCH:
        r := fN(mut st, fb, W_R)
        cp := fN(mut st, fb, W_CAP)
        t := fT(mut st, fb, W_T)
        return if r < 0 || cp < 0 || t < 0 { -1 } else { node(mut st, c, 0, r, cp, t) }
    }
    return -1
}

// 枠 fb の立っている欄を汎用の記録 [n, (語, tag, val, gen)…] に写す
func genRec(st mut S, fb int) int {
    mut n := 0
    mut w := 1
    while w < NW {
        if has(mut st, fb, w) {
            n += 1
        }
        w += 1
    }
    at := table.Len(mut st.h)
    table.Push(mut st.h, n)
    w = 1
    while w < NW {
        if has(mut st, fb, w) {
            s := slotOf(fb, w)
            table.Push(mut st.h, w)
            table.Push(mut st.h, table.Get(mut st.h, s + 1))
            table.Push(mut st.h, table.Get(mut st.h, s + 2))
            table.Push(mut st.h, table.Get(mut st.h, s + 3))
        }
        w += 1
    }
    return at
}

// 汎用の記録 g の語 w の欄（[tag, val, gen] の先頭の添字。無ければ -1）
func gField(st mut S, g int, w int) int {
    if g < 0 {
        return -1
    }
    for i <- iter.Range(0, table.Get(mut st.h, g)) {
        at := g + 1 + i * 4
        if table.Get(mut st.h, at) == w {
            return at + 1
        }
    }
    return -1
}

func isWs(c byte) bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

func skipWs(src []byte, i0 int) int {
    mut i := i0
    while i < len(src) && isWs(src[i]) {
        i += 1
    }
    return i
}

func isDigit(c byte) bool {
    return c >= '0' && c <= '9'
}

// parse の結果。ok = false は parse error
type Parsed struct {
    ok bool
    tag int
    val int
    gen int
}

// 入力の入れ子の最大の深さ（文字列の中は数えない）。作業の枠の大きさを決める
func maxDepth(src []byte) int {
    mut d := 0
    mut m := 0
    mut i := 0
    mut instr := false
    while i < len(src) {
        c := src[i]
        if instr {
            if c == '\\' {
                i += 1
            } else if c == '"' {
                instr = false
            }
        } else if c == '"' {
            instr = true
        } else if c == '{' || c == '[' {
            d += 1
            if d > m {
                m = d
            }
        } else if c == '}' || c == ']' {
            d -= 1
        }
        i += 1
    }
    return m
}

// src 全体を 1 つの JSON 値として読む（反復）
func parseJson(st mut S, src []byte) Parsed {
    bad := Parsed{false, 0, 0, -1}
    n := len(src)
    mut i := skipWs(src, 0)
    mut dep := 0
    mut have := false
    mut vt := 0
    mut vv := 0
    mut vg := -1
    // 次に読むのが object のキーか（'{' か ',' の直後）
    mut wantKey := false
    while true {
        if wantKey {
            wantKey = false
            if i >= n || src[i] != '"' {
                return bad
            }
            s := i + 1
            mut j := s
            mut esc := false
            while j < n && src[j] != '"' {
                if src[j] == '\\' {
                    esc = true
                    j += 1
                }
                j += 1
            }
            if j >= n {
                return bad
            }
            fb := frameAt(mut st, dep)
            table.Set(mut st.h, fb + 2, if esc { 0 } else { wordOf(mut st, src, s, j) })
            i = skipWs(src, j + 1)
            if i >= n || src[i] != ':' {
                return bad
            }
            i = skipWs(src, i + 1)
            continue
        }
        if !have {
            if i >= n {
                return bad
            }
            c := src[i]
            if c == '{' || c == '[' {
                dep += 1
                fb := frameAt(mut st, dep)
                table.Set(mut st.h, fb, if c == '{' { C_OBJ } else { C_ARR })
                sp := st.stamp + 1
                st.stamp = sp
                table.Set(mut st.h, fb + 1, sp)
                table.Set(mut st.h, fb + 2, 0)
                table.Set(mut st.h, fb + 3, 0)
                table.Set(mut st.h, fb + 4, -1)
                table.Set(mut st.h, fb + 5, -1)
                i = skipWs(src, i + 1)
                if i < n && int(src[i]) == (if c == '{' { 125 } else { 93 }) {
                    i += 1
                    // 空の object / 配列は閉じる処理へ（下の close）
                } else {
                    if c == '{' {
                        wantKey = true
                    }
                    continue
                }
            } else if c == '"' {
                s := i + 1
                mut j := s
                mut esc := false
                while j < n && src[j] != '"' {
                    if src[j] == '\\' {
                        esc = true
                        j += 1
                    }
                    j += 1
                }
                if j >= n {
                    return bad
                }
                vt = V_STR
                vv = if esc { 0 } else { wordOf(mut st, src, s, j) }
                vg = -1
                i = j + 1
                have = true
                continue
            } else if c == '-' || isDigit(c) {
                mut j := i
                neg := c == '-'
                if neg {
                    j += 1
                }
                if j >= n || !isDigit(src[j]) {
                    return bad
                }
                mut x := 0
                mut big := false
                while j < n && isDigit(src[j]) {
                    dg := int(src[j]) - 48
                    if x > (9223372036854775807 - dg) / 10 {
                        big = true
                    } else {
                        x = x * 10 + dg
                    }
                    j += 1
                }
                mut frac := false
                if j < n && src[j] == '.' {
                    frac = true
                    j += 1
                    if j >= n || !isDigit(src[j]) {
                        return bad
                    }
                    while j < n && isDigit(src[j]) {
                        j += 1
                    }
                }
                if j < n && (src[j] == 'e' || src[j] == 'E') {
                    frac = true
                    j += 1
                    if j < n && (src[j] == '+' || src[j] == '-') {
                        j += 1
                    }
                    if j >= n || !isDigit(src[j]) {
                        return bad
                    }
                    while j < n && isDigit(src[j]) {
                        j += 1
                    }
                }
                vt = if frac { V_FRAC } else if big { V_BIG } else { V_NUM }
                vv = if neg { 0 - x } else { x }
                vg = -1
                i = j
                have = true
                continue
            } else if c == 't' && i + 4 <= n && src[i + 1] == 'r' && src[i + 2] == 'u' && src[i + 3] == 'e' {
                vt = V_TRUE
                vv = 0
                vg = -1
                i += 4
                have = true
                continue
            } else if c == 'f' && i + 5 <= n && src[i + 1] == 'a' && src[i + 2] == 'l' && src[i + 3] == 's' && src[i + 4] == 'e' {
                vt = V_FALSE
                vv = 0
                vg = -1
                i += 5
                have = true
                continue
            } else if c == 'n' && i + 4 <= n && src[i + 1] == 'u' && src[i + 2] == 'l' && src[i + 3] == 'l' {
                vt = V_NULL
                vv = 0
                vg = -1
                i += 4
                have = true
                continue
            } else {
                return bad
            }
        }
        if have {
            // 値を 1 つ持っている: 親の枠へ渡す
            if dep == 0 {
                i = skipWs(src, i)
                if i != n {
                    return bad
                }
                return Parsed{true, vt, vv, vg}
            }
            fb := frameAt(mut st, dep)
            if table.Get(mut st.h, fb) == C_OBJ {
                w := table.Get(mut st.h, fb + 2)
                if w > 0 {
                    s := slotOf(fb, w)
                    table.Set(mut st.h, s, table.Get(mut st.h, fb + 1))
                    table.Set(mut st.h, s + 1, vt)
                    table.Set(mut st.h, s + 2, vv)
                    table.Set(mut st.h, s + 3, vg)
                }
            } else {
                cell := rec4(mut st, vt, vv, vg, -1)
                if table.Get(mut st.h, fb + 4) < 0 {
                    table.Set(mut st.h, fb + 4, cell)
                } else {
                    table.Set(mut st.h, table.Get(mut st.h, fb + 5) + 3, cell)
                }
                table.Set(mut st.h, fb + 5, cell)
                table.Set(mut st.h, fb + 3, table.Get(mut st.h, fb + 3) + 1)
            }
            have = false
            i = skipWs(src, i)
            if i >= n {
                return bad
            }
            if src[i] == ',' {
                i = skipWs(src, i + 1)
                if table.Get(mut st.h, fb) == C_OBJ {
                    wantKey = true
                }
                continue
            }
            if int(src[i]) != (if table.Get(mut st.h, fb) == C_OBJ { 125 } else { 93 }) {
                return bad
            }
            i += 1
        }
        // close: 枠 dep の object / 配列を値にする
        fb := frameAt(mut st, dep)
        if table.Get(mut st.h, fb) == C_ARR {
            vt = V_ARR
            vv = rec4(mut st, table.Get(mut st.h, fb + 3), table.Get(mut st.h, fb + 4), 0, 0)
            vg = -1
        } else {
            vg = if dep <= 3 { genRec(mut st, fb) } else { -1 }
            kt := sTag(mut st, fb, W_K)
            if kt == 0 {
                vt = V_OBJ
                vv = 0
            } else if kt != V_STR {
                vt = V_ERR
                vv = 0
            } else {
                k := sVal(mut st, fb, W_K)
                if isExprKind(k) {
                    e := buildExpr(mut st, fb, k)
                    vt = if e < 0 { V_ERR } else { V_EXPR }
                    vv = e
                } else if isTyKind(k) {
                    t := buildTy(mut st, fb, k)
                    vt = if t < 0 { V_ERR } else { V_TY }
                    vv = t
                } else {
                    vt = V_ERR
                    vv = 0
                }
            }
        }
        dep -= 1
        have = true
    }
    return bad
}
