package checker

import "std/iter"
import "std/table"

// JSON 境界の写し（Json.lean の tyFromJson / exprFromJson / programFromJson / partsFromJson）。
//
// 入力のバイト列を 1 回なめて、型・式の記録を直接組む（汎用の JSON の木は作らない — 入力 5MB 級でヒープを倹約する。仮決め R11-2）:
// - parse は反復（明示の枠）。深さごとの枠に「語の番号 → (stamp, tag, val, gen)」の欄を持ち、object が閉じた時点で
//   "k" の値を見て型か式の記録を組む。キーの順は問わず、同じキーは後勝ち（Lean の Json の object = RBNode.insert）
// - 型の kind と式の kind は語が交わらないので、閉じた object は自分の k だけで型か式かが決まる。
//   位置（Lean の tyFromJson / exprFromJson のどちらで読まれるか）との食い違いは、親が欄を読む時点で拒否する
// - 組めない object（未知の k・欄の欠け）は V_ERR として運び、親が読んだときに初めて parse error にする
//   （Lean は読まない欄の中身を検査しない — 余計なキーの中身は壊れていてよい）
// - 深さ 3 以下の object は汎用の記録 gen も残す（根の object と defs の要素 — programFromJson / defFromJson が読む）
//
// 文字列は語の表（キーと kind の綴り）で番号に引く。escape を含む文字列は番号 0（どの語とも一致しない扱い）— Lean は escape を
// 解いてから比べるので、`"k"` のような綴りは食い違う（コーパスに現れない — 仮決め R11-2 の注）

// 語の番号（キー 1〜29・式の kind 30〜90・型の kind 91〜102）
const W_K = 1
const W_I = 2
const W_N = 3
const W_E = 4
const W_BODY = 5
const W_A = 6
const W_B = 7
const W_C = 8
const W_T = 9
const W_NIL = 10
const W_SOME = 11
const W_L = 12
const W_R = 13
const W_F = 14
const W_TS = 15
const W_MUT = 16
const W_M = 17
const W_V = 18
const W_KEY = 19
const W_CELL = 20
const W_RC = 21
const W_E1 = 22
const W_E2 = 23
const W_P = 24
const W_DEFS = 25
const W_PARAM = 26
const W_RET = 27
const W_TPARAMS = 28
const W_PARTS = 29
const W_LIT = 30
const W_TRUE = 31
const W_FALSE = 32
const W_TRIV = 33
const W_VAR = 34
const W_LET = 35
const W_ADD = 36
const W_LT = 37
const W_SUB = 38   // 38〜46 = arith（sub mul div mod and or xor shl shr）— 範囲判定は W_SUB..W_SHR
const W_MUL = 39
const W_DIV = 40
const W_MOD = 41
const W_AND = 42
const W_OR = 43
const W_XOR = 44
const W_SHL = 45
const W_SHR = 46
const W_EQ = 47    // 47〜51 = cmp（eq ne le gt ge）— 範囲判定は W_EQ..W_GE
const W_NE = 48
const W_LE = 49
const W_GT = 50
const W_GE = 51
const W_IF = 52
const W_IFNIL = 53
const W_INL = 54
const W_INR = 55
const W_CASE = 56
const W_PAIR = 57
const W_FST = 58
const W_SND = 59
const W_CALL = 60
const W_CALLM = 61
const W_FNREF = 62
const W_CALLV = 63
const W_ANN = 64
const W_BLOCK = 65
const W_LABEL = 66
const W_JUMP = 67
const W_ALLOC = 68
const W_DEREF = 69
const W_ASSIGN = 70
const W_WHILE = 71
const W_FREEZE = 72
const W_MKSLICE = 73
const W_INDEX = 74
const W_LEN = 75
const W_APPEND = 76
const W_SETIDX = 77
const W_SUBSLICE = 78
const W_EQS = 79
const W_CONCAT = 80
const W_MKMAP = 81
const W_GETM = 82
const W_SETM = 83
const W_DELM = 84
const W_LENM = 85
const W_PAR = 86
const W_PARCH = 87
const W_NEWCHAN = 88
const W_SEND = 89
const W_RECV = 90
const W_INT = 91
const W_TVAR = 92
const W_BOOL = 93
const W_UNIT = 94
const W_OPT = 95
const W_UNION = 96
const W_PROD = 97
const W_REF = 98
const W_SLICE = 99
const W_MAP = 100
const W_CHAN = 101
const W_FN = 102
// strlit の段で足した語（既存の番号を動かさないため末尾に置く — 式の kind の範囲判定は isExprKind が W_STRLIT を明示で足す）
const W_BS = 103
const W_STRLIT = 104
// keysm の段で足した語（同じく末尾）
const W_KEYSM = 105
// 到達しない項の段で足した語（同じく末尾）
const W_UNREACH = 106
// byte の段で足した語（同じく末尾 — 式の kind は isExprKind、型の kind は isTyKind が明示で足す）
const W_TOBYTE = 107
const W_TOINT = 108
const W_BYTE = 109
// float の段で足した語（同じく末尾 — Lean の flit / farith / fcmp / fconv と型 f64）
const W_FLIT = 110
const W_FADD = 111  // 111〜114 = farith（fadd fsub fmul fdiv）
const W_FSUB = 112
const W_FMUL = 113
const W_FDIV = 114
const W_FEQ = 115   // 115〜120 = fcmp（feq fne flt fle fgt fge）
const W_FNE = 116
const W_FLT = 117
const W_FLE = 118
const W_FGT = 119
const W_FGE = 120
const W_FNEG = 121  // 121〜126 = fconv（fneg fsqrt tofloat ftoint fbits ffrombits）
const W_FSQRT = 122
const W_TOFLOAT = 123
const W_FTOINT = 124
const W_FBITS = 125
const W_FFROMBITS = 126
const W_F64 = 127
// 境界コピー式の語（宛先構築レーン — Lean の copyTo）
const W_COPYTO = 128
// scope / spawn / join / tryJ / newch の式と型 own 用の語（Lean 対応 — 欄 o / cap / s / h と能力の種類の綴り）
const W_SCOPE = 129  // 129〜133 = scope spawn join try newch の式 — 範囲判定は W_SCOPE..W_NEWCH。"scope" は own の o の綴りも兼ねる
const W_SPAWN = 130
const W_JOIN = 131
const W_TRY = 132
const W_NEWCH = 133
const W_OWN = 134
const W_O = 135
const W_CAP = 136
const W_S = 137
const W_H = 138
const W_TASK = 139
const W_TX = 140
const W_RX = 141
// P3b-4 ③ で足した語（Lean の close — 送り端を閉じる）
const W_CLOSE = 142
// P3b-4 1b' で足した語（scope の err の型の欄 "eps"）
const W_EPS = 143
// clone の段で足した語（Lean の clone — 読み出しの注釈 "t" は省略可）
const W_CLONE = 144
// L1 で足した語（Lean の callMv — anchor つきの関数値の呼び出し。記録は [callmv, nc, f, e, a]）
const W_CALLMV = 145
const NW = 146
// 注釈つき block（Lean の blockR）の式の kind。綴りは持たない（JSON では "block" + "t"）
const K_BLOCKR = 146

// 綴りの表は switch（if 式の鎖は F-22 の形 — 入れ子が深くなる）
func wordStr(c int) string {
    return switch c {
    case W_K: "k"
    case W_I: "i"
    case W_N: "n"
    case W_E: "e"
    case W_BODY: "body"
    case W_A: "a"
    case W_B: "b"
    case W_C: "c"
    case W_T: "t"
    case W_NIL: "nil"
    case W_SOME: "some"
    case W_L: "l"
    case W_R: "r"
    case W_F: "f"
    case W_TS: "ts"
    case W_MUT: "mut"
    case W_M: "m"
    case W_V: "v"
    case W_KEY: "key"
    case W_CELL: "cell"
    case W_RC: "rc"
    case W_E1: "e1"
    case W_E2: "e2"
    case W_P: "p"
    case W_DEFS: "defs"
    case W_PARAM: "param"
    case W_RET: "ret"
    case W_TPARAMS: "tparams"
    case W_PARTS: "parts"
    case W_LIT: "lit"
    case W_TRUE: "true"
    case W_FALSE: "false"
    case W_TRIV: "triv"
    case W_VAR: "var"
    case W_LET: "let"
    case W_ADD: "add"
    case W_LT: "lt"
    case W_SUB: "sub"
    case W_MUL: "mul"
    case W_DIV: "div"
    case W_MOD: "mod"
    case W_AND: "and"
    case W_OR: "or"
    case W_XOR: "xor"
    case W_SHL: "shl"
    case W_SHR: "shr"
    case W_EQ: "eq"
    case W_NE: "ne"
    case W_LE: "le"
    case W_GT: "gt"
    case W_GE: "ge"
    case W_IF: "if"
    case W_IFNIL: "ifnil"
    case W_INL: "inl"
    case W_INR: "inr"
    case W_CASE: "case"
    case W_PAIR: "pair"
    case W_FST: "fst"
    case W_SND: "snd"
    case W_CALL: "call"
    case W_CALLM: "callm"
    case W_FNREF: "fnref"
    case W_CALLV: "callv"
    case W_ANN: "ann"
    case W_BLOCK: "block"
    case W_LABEL: "label"
    case W_JUMP: "jump"
    case W_ALLOC: "alloc"
    case W_DEREF: "deref"
    case W_ASSIGN: "assign"
    case W_WHILE: "while"
    case W_FREEZE: "freeze"
    case W_MKSLICE: "mkslice"
    case W_INDEX: "index"
    case W_LEN: "len"
    case W_APPEND: "append"
    case W_SETIDX: "setidx"
    case W_SUBSLICE: "subslice"
    case W_EQS: "eqs"
    case W_CONCAT: "concat"
    case W_MKMAP: "mkmap"
    case W_GETM: "getm"
    case W_SETM: "setm"
    case W_DELM: "delm"
    case W_LENM: "lenm"
    case W_PAR: "par"
    case W_PARCH: "parch"
    case W_NEWCHAN: "newchan"
    case W_SEND: "send"
    case W_RECV: "recv"
    case W_INT: "int"
    case W_TVAR: "tvar"
    case W_BOOL: "bool"
    case W_UNIT: "unit"
    case W_OPT: "opt"
    case W_UNION: "union"
    case W_PROD: "prod"
    case W_REF: "ref"
    case W_SLICE: "slice"
    case W_MAP: "map"
    case W_CHAN: "chan"
    case W_FN: "fn"
    case W_BS: "bs"
    case W_STRLIT: "strlit"
    case W_COPYTO: "copyto"
    case W_KEYSM: "keysm"
    case W_UNREACH: "unreach"
    case W_TOBYTE: "tobyte"
    case W_TOINT: "toint"
    case W_FLIT: "flit"
    case W_FADD: "fadd"
    case W_FSUB: "fsub"
    case W_FMUL: "fmul"
    case W_FDIV: "fdiv"
    case W_FEQ: "feq"
    case W_FNE: "fne"
    case W_FLT: "flt"
    case W_FLE: "fle"
    case W_FGT: "fgt"
    case W_FGE: "fge"
    case W_FNEG: "fneg"
    case W_FSQRT: "fsqrt"
    case W_TOFLOAT: "tofloat"
