package env

// 環境変数の宣言の表: プログラムが読む環境変数を const の表で宣言し（StrVar・IntVar・BoolVar・Table）、Load が入場で 1 回だけ全部を読んで
// 検査し、凍った値の表（Values）を返す。値は宣言の const を把手にして引く（Str・StrOpt・Int・IntOpt・Bool — 綴りの誤りはコンパイルで落ち、
// 値の型は把手の型で決まる）。表面は表に全部ある（Spec — 表の JSON）。値の規則: 空の値（`NAME=`）は無いのと同じ・
// 真偽は `1` / `true` が真・`0` / `false` / 無い が偽・それ以外は BadValue。例: examples/env_table.sober

import "std/os"
import "std/iter"
import "std/strings"
import "std/convert"
import "std/builder"
import "std/json"

// 文字列の環境変数。def は無いときの値。def も値も無いときは、opt なら StrOpt が nil を返し、opt でなければ Load が Missing で落とす。
// dev は開発の口（文書の印 — 読みは同じ）
type StrVar struct {
    name string
    help string
    def string?
    opt bool
    dev bool
}

// 整数の環境変数（10 進）。min / max は両端を含む範囲。他の欄は StrVar と同じ
type IntVar struct {
    name string
    help string
    def int?
    min int?
    max int?
    opt bool
    dev bool
}

// 真偽の環境変数（無ければ偽）
type BoolVar struct {
    name string
    help string
    dev bool
}

// プログラムが読む環境変数の表（Load の入口）
type Table struct {
    strs []StrVar
    ints []IntVar
    bools []BoolVar
}

// 読んだ値の表。作れるのは Load / Parse だけ（非公開の型の封の欄）。値は把手で引く
type Values struct {
    sn []string
    sv []string
    sh []bool
    inames []string
    iv []int
    ih []bool
    bn []string
    bv []bool
    seal sealed
}

// Values の封（非公開 — 外で値を書けない）
type sealed struct {
}

// ── 誤り（Load / Parse の error — Format が 1〜2 行の文面にする）──

// opt でも def つきでもない変数が無い
type Missing error {
    name string
}

// 値が受けられない（want = 受ける値の説明 — `an integer`・`an integer in 1..65535`・`1, true, 0 or false`）
type BadValue error {
    name string
    word string
    want string
}

// 値が不正な UTF-8
type InvalidUtf8 error {
    name string
}

// ── 到達 = バグ（panic — language.md 27 節）──

// 引いた把手が表に無い・値の無いことがある把手を値の要る引き（Str・Int）で引いた
type Undeclared panic {
    name string
    why string
}

// 表の宣言の誤り（同じ名前の 2 回の宣言・def と opt の併記・空の名前）
type Misdeclared panic {
    name string
    why string
}

// ── 入口 ──

// t の変数を全部プロセスの環境から読んで検査する（誤りは宣言の順で最初の 1 つ）。入場（main の頭）で 1 回呼んで、値の表を渡して使う
@errors(Missing, BadValue, InvalidUtf8)
@effects(io, panic)
func Load(t Table) (Values, error?) {
    names := declared(t)
    mut pairs := mut []string{}
    for n <- names {
        v, e := os.Getenv(n)
        if e != nil {
            return Values{}, InvalidUtf8{name: n}
        }
        if v != nil {
            pairs = append(pairs, n + "=" + v)
        }
    }
    return Parse(t, freeze(pairs))
}

// t の変数を pairs（`NAME=value` の列 — environ と同じ形・同名は最初の 1 つ）から読んで検査する（Load の中身 — テストと再現の口）
@errors(Missing, BadValue)
@effects(panic)
func Parse(t Table, pairs []string) (Values, error?) {
    _ = declared(t)
    mut sn := mut []string{}
    mut sv := mut []string{}
    mut sh := mut []bool{}
    for k <- iter.Range(0, len(t.strs)) {
        f := t.strs[k]
        w := lookup(pairs, f.name)
        d := f.def
        sn = append(sn, f.name)
        if w != nil {
            sv = append(sv, w)
            sh = append(sh, true)
        } else if d != nil {
            sv = append(sv, d)
            sh = append(sh, true)
        } else if f.opt {
            sv = append(sv, "")
            sh = append(sh, false)
        } else {
            return Values{}, Missing{name: f.name}
        }
    }
    mut inames := mut []string{}
    mut iv := mut []int{}
    mut ih := mut []bool{}
    for k <- iter.Range(0, len(t.ints)) {
        f := t.ints[k]
        w := lookup(pairs, f.name)
        d := f.def
        inames = append(inames, f.name)
        if w != nil {
            n, e := convert.ParseInt(w)
            if e != nil || !inRange(f, n) {
                return Values{}, BadValue{name: f.name, word: w, want: intWant(f)}
            }
            iv = append(iv, n)
            ih = append(ih, true)
        } else if d != nil {
            iv = append(iv, d)
            ih = append(ih, true)
        } else if f.opt {
            iv = append(iv, 0)
            ih = append(ih, false)
        } else {
            return Values{}, Missing{name: f.name}
        }
    }
    mut bn := mut []string{}
    mut bv := mut []bool{}
    for b <- t.bools {
        w0 := lookup(pairs, b.name)
        w := if w0 == nil { "" } else { w0 }
        bn = append(bn, b.name)
        if w == "" || w == "0" || w == "false" {
            bv = append(bv, false)
        } else if w == "1" || w == "true" {
            bv = append(bv, true)
        } else {
            return Values{}, BadValue{name: b.name, word: w, want: "1, true, 0 or false"}
        }
    }
    return Values{sn: freeze(sn), sv: freeze(sv), sh: freeze(sh), inames: freeze(inames), iv: freeze(iv), ih: freeze(ih), bn: freeze(bn),
        bv: freeze(bv), seal: sealed{}}, nil
}

// Load / Parse の誤り e の文面（1〜2 行 — 最後は改行）
@effects()
func Format(e error) string {
    return switch e {
    case Missing{name}: "missing environment variable " + name + "\n"
    case BadValue{name, word, want}: "invalid value " + quote(word) + " for environment variable " + name + "\n  want " + want + "\n"
    case InvalidUtf8{name}: "environment variable " + name + " is not valid UTF-8\n"
    case _: "invalid environment\n"
    }
}

// ── 引き（把手が表に無ければ panic(Undeclared)）──

// v の値（値・def のどちらも無い opt の変数は panic — StrOpt で引く）
@effects(panic)
func Str(v Values, h StrVar) string {
    i := at(v.sn, h.name)
    if !v.sh[i] {
        panic(Undeclared{name: h.name, why: "has no value — read it with StrOpt"})
    }
    return v.sv[i]
}

// v の値（無ければ nil）
@effects(panic)
func StrOpt(v Values, h StrVar) string? {
    i := at(v.sn, h.name)
    if !v.sh[i] {
        return nil
    }
    return v.sv[i]
}

// v の値（Str と同じ規則 — 無い opt の変数は panic — IntOpt で引く）
@effects(panic)
func Int(v Values, h IntVar) int {
    i := at(v.inames, h.name)
    if !v.ih[i] {
        panic(Undeclared{name: h.name, why: "has no value — read it with IntOpt"})
    }
    return v.iv[i]
}

// v の値（無ければ nil）
@effects(panic)
func IntOpt(v Values, h IntVar) int? {
    i := at(v.inames, h.name)
    if !v.ih[i] {
        return nil
    }
    return v.iv[i]
}

// v の値
@effects(panic)
func Bool(v Values, h BoolVar) bool {
    return v.bv[at(v.bn, h.name)]
}

// ── 表の JSON（文書の生成器が引く口）──

// t の表の JSON（空白なし・宣言の順。変数は種類つきの 1 本の列 — kind = string / int / bool）
@effects()
func Spec(t Table) string {
    mut o := builder.Builder[byte]{}
    json.Put(mut o, "{")
    json.PutKey(mut o, "vars", true)
    json.Put(mut o, "[")
    mut first := true
    for k <- iter.Range(0, len(t.strs)) {
        f := t.strs[k]
        first = head(mut o, first, "string", f.name, f.help, f.dev)
        putStr(mut o, "default", f.def)
        json.PutKey(mut o, "optional", false)
        json.PutBool(mut o, f.opt)
        json.Put(mut o, "}")
    }
    for k <- iter.Range(0, len(t.ints)) {
        f := t.ints[k]
        first = head(mut o, first, "int", f.name, f.help, f.dev)
        putInt(mut o, "default", f.def)
        putInt(mut o, "min", f.min)
        putInt(mut o, "max", f.max)
        json.PutKey(mut o, "optional", false)
        json.PutBool(mut o, f.opt)
        json.Put(mut o, "}")
    }
    for b <- t.bools {
        first = head(mut o, first, "bool", b.name, b.help, b.dev)
        json.Put(mut o, "}")
    }
    json.Put(mut o, "]}")
    return json.Done(mut o)
}

// 変数の項の頭（閉じは呼び手）。戻りは次の項が先頭でないこと
func head(o mut builder.Builder[byte], first bool, kind string, name string, help string, dev bool) bool {
    if !first {
        json.Put(mut o, ",")
    }
    json.Put(mut o, "{")
    json.PutKey(mut o, "kind", true)
    json.PutString(mut o, kind)
    json.PutKey(mut o, "name", false)
    json.PutString(mut o, name)
    json.PutKey(mut o, "help", false)
    json.PutString(mut o, help)
    json.PutKey(mut o, "dev", false)
    json.PutBool(mut o, dev)
    return false
}

func putStr(o mut builder.Builder[byte], key string, v string?) {
    json.PutKey(mut o, key, false)
    if v == nil {
        json.Put(mut o, "null")
    } else {
        json.PutString(mut o, v)
    }
}

func putInt(o mut builder.Builder[byte], key string, v int?) {
    json.PutKey(mut o, key, false)
    if v == nil {
        json.Put(mut o, "null")
    } else {
        json.PutInt(mut o, v)
    }
}

// ── 中身 ──

// t の名前の列（宣言の順）。宣言の誤りは panic(Misdeclared)
func declared(t Table) []string {
    mut ns := mut []string{}
    for k <- iter.Range(0, len(t.strs)) {
        f := t.strs[k]
        if f.opt && f.def != nil {
            panic(Misdeclared{name: f.name, why: "has both def and opt"})
        }
        ns = append(ns, f.name)
    }
    for k <- iter.Range(0, len(t.ints)) {
        f := t.ints[k]
        if f.opt && f.def != nil {
            panic(Misdeclared{name: f.name, why: "has both def and opt"})
        }
        ns = append(ns, f.name)
    }
    for k <- iter.Range(0, len(t.bools)) {
        ns = append(ns, t.bools[k].name)
    }
    for k <- iter.Range(0, len(ns)) {
        if ns[k] == "" || strings.Contains(ns[k], "=") {
            panic(Misdeclared{name: ns[k], why: "is not a variable name"})
        }
        for j <- iter.Range(0, k) {
            if ns[j] == ns[k] {
                panic(Misdeclared{name: ns[k], why: "is declared twice"})
            }
        }
    }
    return freeze(ns)
}

// pairs の中の name の値（無い・空は nil）
func lookup(pairs []string, name string) string? {
    for p <- pairs {
        k, v, ok := strings.Cut(p, "=")
        if ok && k == name {
            return if v == "" { nil } else { v }
        }
    }
    return nil
}

// names の中の name の添字（無ければ panic）
func at(names []string, name string) int {
    for k <- iter.Range(0, len(names)) {
        if names[k] == name {
            return k
        }
    }
    panic(Undeclared{name: name, why: "is not in the table"})
}

// n が f の min / max の内か
func inRange(f IntVar, n int) bool {
    lo := f.min
    hi := f.max
    if lo != nil && n < lo {
        return false
    }
    if hi != nil && n > hi {
        return false
    }
    return true
}

// f の受ける値の説明
func intWant(f IntVar) string {
    lo := f.min
    hi := f.max
    if lo != nil && hi != nil {
        return "an integer in " + convert.FormatInt(lo) + ".." + convert.FormatInt(hi)
    }
    if lo != nil {
        return "an integer >= " + convert.FormatInt(lo)
    }
    if hi != nil {
        return "an integer <= " + convert.FormatInt(hi)
    }
    return "an integer"
}

// 値の綴り（空なら ""）
func quote(w string) string {
    return if w == "" { "\"\"" } else { w }
}
