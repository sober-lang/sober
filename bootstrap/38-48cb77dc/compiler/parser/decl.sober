package parser

// 宣言と型（grammar.zig の 5.1 / 5.2 節、cst_to_ast.zig の funcDecl / typeDecl / typeExpr）

import "std/builder"
import "ast"
import "lexer"

// import_spec <- IDENT? STR（別名 "_" は拒否 — 決定 14）。path は引用符を剥がしただけ（escape は解かない）
func importSpec(nb mut builder.Builder[ast.Node], db mut builder.Builder[int], cx Cx, p0 int) (int, int) {
    mut p := p0
    mut alias := -1
    if tg(cx, p) == lexer.Identifier {
        if textIs(cx, p, "_") {
            return -1, p
        }
        alias = name(mut db, cx, p)
        p += 1
    }
    if tg(cx, p) != lexer.StringLiteral {
        return -1, p
    }
    t := cx.ts[p]
    path := ast.PutBytes(mut db, cx.src, t.start + 1, t.end - 1)
    return node(mut nb, ast.KImport, tk(cx, p), alias, path, 0, 0, 0, 0), p + 1
}

// typeParams: '[' IDENT (',' IDENT)* ']'（文字列の列）
func typeParams(db mut builder.Builder[int], cx Cx, p0 int) (int, int) {
    mut names := mut []int{}
    mut p := p0 + 1
    mut more := true
    while more {
        if tg(cx, p) != lexer.Identifier {
            return -1, p
        }
        names = append(names, name(mut db, cx, p))
        p += 1
        more = tg(cx, p) == lexer.Comma
        if more {
            p += 1
        }
    }
    if tg(cx, p) != lexer.RBracket {
        return -1, p
    }
    return ast.PutList(mut db, freeze(names)), p + 1
}

// func_decl <- 'func' IDENT type_params? signature block?（本体なしは .sobi だけ — cx.iface。付加の列の 7 番 = `@expand`〔.sobi だけ — 無ければ列は 7 個〕）
// noinl: 直前に `@noinline` があったか（付加の列の 5 番目 — loader が mut_def の判定に使う）。errs / errsTok: `@errors` のラベル名の列と
// その `@` の字句（付加の列の 6・7 番目 — analyzer が読む。無ければ -1。AST JSON には出さない）。exh: `@exhaustive` の印（付加の列の 9 番目 —
// 印があるときだけ 8 番目〔expand〕を 0 で埋めて 9 個にする。analyzer の表の網羅が読む）。`@secret(k, …)` の名前の列 / その `@` の字句 / `@bless` の印は
// 付加の列の 10〜12 番目（どれかがあるときだけ 12 個にする — 無ければ -1 / 0 / 0。analyzer が読む。AST JSON には出さない）。12 番目は印のビット:
// 0 = `@bless`・1 = `@bless(origin)`・2 = `@credential`
func funcDecl(nb mut builder.Builder[ast.Node], db mut builder.Builder[int], cx Cx, p0 int, start int, an Annot) (int, int) {
    noinl := an.noinl
    errs := an.errs
    errsTok := an.errsTok
    expand := an.expand
    exh := an.exh
    if tg(cx, p0 + 1) != lexer.Identifier {
        return -1, p0
    }
    fname := name(mut db, cx, p0 + 1)
    mut p := p0 + 2
    mut tps := ast.PutList(mut db, []int{})
    if tg(cx, p) == lexer.LBracket {
        l, q := typeParams(mut db, cx, p)
        if l < 0 {
            return -1, p
        }
        tps = l
        p = q
    }
    params, q1 := parameters(mut nb, mut db, cx, p, 0)
    if params < 0 {
        return -1, p
    }
    results, sig_end := resultOpt(mut nb, mut db, cx, q1)
    if cx.iface && tg(cx, sig_end) == lexer.Semicolon {
        // .sobi の本体の無い宣言（署名だけ）
        ext := funcExt(mut db, []int{1, start, sig_end + 1, sig_end, noinl, errs, errsTok, expand}, an)
        return node(mut nb, ast.KFuncDecl, tk(cx, p0 + 1), fname, tps, params, results, -1, ext), sig_end + 1
    }
    if tg(cx, sig_end) != lexer.LBrace {
        return -1, sig_end
    }
    body, q2 := block(mut nb, mut db, cx, sig_end)
    if body < 0 || tg(cx, q2) != lexer.Semicolon {
        return -1, q2
    }
    ext := if an.sec >= 0 || an.bless != 0 || an.cred != 0 || an.effs >= 0 || exh != 0 { funcExt(mut db, []int{0, start, q2 + 1, sig_end, noinl, errs, errsTok, expand}, an) } else if expand != 0 { ast.PutList(mut db, []int{0, start, q2 + 1, sig_end, noinl, errs, errsTok, expand}) } else { ast.PutList(mut db, []int{0, start, q2 + 1, sig_end, noinl, errs, errsTok}) }
    return node(mut nb, ast.KFuncDecl, tk(cx, p0 + 1), fname, tps, params, results, body, ext), q2 + 1
}

// funcExt は付加の列 head（8 個 — 番号 0〜7）に注釈の欄を足した列: `@secret` / `@bless` / `@credential` があれば 12 個・`@effects` があれば 14 個
// （12・13 番 = 項の列・`@` の字句）・`@exhaustive` だけなら 9 個（どれも無ければ head のまま）
func funcExt(db mut builder.Builder[int], head []int, an Annot) int {
    mut l := mut []int{}
    mut i := 0
    while i < len(head) {
        l = append(l, head[i])
        i += 1
    }
    if an.sec >= 0 || an.bless != 0 || an.cred != 0 || an.effs >= 0 {
        l = append(l, an.exh)
        l = append(l, an.sec)
        l = append(l, an.secTok)
        l = append(l, an.bless + an.cred * 4)
        if an.effs >= 0 {
            l = append(l, an.effs)
            l = append(l, an.effsTok)
        }
    } else if an.exh != 0 {
        l = append(l, an.exh)
    }
    return ast.PutList(mut db, freeze(l))
}

// intrinsicDecl は `@intrinsic("鍵")` の後の `func IDENT parameters result? ';'`（本体・型引数なし — KIntrinsic）
func intrinsicDecl(nb mut builder.Builder[ast.Node], db mut builder.Builder[int], cx Cx, p0 int, start int, key int) (int, int) {
    if tg(cx, p0 + 1) != lexer.Identifier {
        return -1, p0
    }
    fname := name(mut db, cx, p0 + 1)
    params, q1 := parameters(mut nb, mut db, cx, p0 + 2, 0)
    if params < 0 {
        return -1, p0
    }
    results, sig_end := resultOpt(mut nb, mut db, cx, q1)
    if tg(cx, sig_end) != lexer.Semicolon {
        return -1, sig_end
    }
    return node(mut nb, ast.KIntrinsic, tk(cx, p0 + 1), fname, key, params, results, start, sig_end + 1), sig_end + 1
}

// parameters <- '(' (parameter_decl (',' parameter_decl)* ','?)? ')'。
// mode 0 = 宣言（名前つき必須、KParam の列）/ 1 = 関数型（型の列 — 名前つきなら名前の数だけ型を並べる）/
// 2 = lambda（KLParam の列 — 型だけの parameter_decl は名前として読む・c = mut 引数の印）
func parameters(nb mut builder.Builder[ast.Node], db mut builder.Builder[int], cx Cx, p0 int, mode int) (int, int) {
    l, _, q := parametersN(mut nb, mut db, cx, p0, mode)
    return l, q
}

// parametersN は parameters に、関数型（mode 1）の仮引数名の列を足したもの（名前なしの関数型は -1）。
// 関数型の仮引数は名前を全部付けるか全部付けないか（Go と同じ — 混在は拒否）
func parametersN(nb mut builder.Builder[ast.Node], db mut builder.Builder[int], cx Cx, p0 int, mode int) (int, int, int) {
    if tg(cx, p0) != lexer.LParen {
        return -1, -1, p0
    }
    mut out := mut []int{}
    mut pnames := mut []int{}
    mut unnamed := 0
    mut p := p0 + 1
    mut going := tg(cx, p) != lexer.RParen
    while going {
        // parameter_decl <- identifier_list '...'? type / '...'? type
        mut names := mut []int{}
        mut q := p
        mut more := true
        while more && tg(cx, q) == lexer.Identifier {
            names = append(names, q)
            q += 1
            more = tg(cx, q) == lexer.Comma && tg(cx, q + 1) == lexer.Identifier
            if more {
                q += 1
            }
        }
        if tg(cx, q) == lexer.Ellipsis {
            return -1, -1, q
        }
        mut done := false
        if len(names) > 0 {
            // 宣言・ラムダの仮引数の先頭の mut は mut 引数の印（ラムダの mut 仮引数は task.Lease / task.NewLocal の窓の位置だけ — loader が柵。region-domain-pool.md 4d 節）
            pm := mode != 1 && tg(cx, q) == lexer.KwMut
            ty, r := typeOf(mut nb, mut db, cx, q, mode != 1)
            if ty >= 0 {
                mut k := 0
                while k < len(names) {
                    if mode == 0 {
                        out = append(out, node(mut nb, ast.KParam, 0, name(mut db, cx, names[k]), ty, if pm { 1 } else { 0 }, 0, 0, 0))
                    } else if mode == 1 {
                        out = append(out, ty)
                        pnames = append(pnames, name(mut db, cx, names[k]))
                    } else {
                        out = append(out, node(mut nb, ast.KLParam, 0, name(mut db, cx, names[k]), ty, if pm { 1 } else { 0 }, 0, 0, 0))
                    }
                    k += 1
                }
                p = r
                done = true
            }
        }
        if !done {
            // 型だけの parameter_decl（宣言では拒否、lambda では名前）
            if mode == 0 {
                return -1, -1, p
            }
            if mode == 2 {
                if tg(cx, p) != lexer.Identifier {
                    return -1, -1, p
                }
                out = append(out, node(mut nb, ast.KLParam, 0, name(mut db, cx, p), -1, 0, 0, 0, 0))
                p += 1
            } else {
                ty, r := typeOf(mut nb, mut db, cx, p, false)
                if ty < 0 {
                    return -1, -1, p
                }
                out = append(out, ty)
                unnamed += 1
                p = r
            }
        }
        if tg(cx, p) == lexer.Comma {
            p += 1
            going = tg(cx, p) != lexer.RParen
        } else {
            going = false
        }
    }
    if tg(cx, p) != lexer.RParen {
        return -1, -1, p
    }
    if len(pnames) > 0 && unnamed > 0 {
        // 関数型の仮引数で名前つきと名前なしの混在（`func(req Request, int)`）
        return -1, -1, p
    }
    l := ast.PutList(mut db, freeze(out))
    return l, if len(pnames) > 0 { ast.PutList(mut db, freeze(pnames)) } else { -1 }, p + 1
}

// typeStart は型を始めうる字句か（result? の試し読みの入口）
func typeStart(t int) bool {
    return t == lexer.Identifier || t == lexer.KwError || t == lexer.KwMut || t == lexer.LBracket ||
        t == lexer.KwMap || t == lexer.KwFunc || t == lexer.Star || t == lexer.LParen
}

// resultOpt: result?（result <- '(' type (',' type)* ')' / type）。結果は（型の列, signature の終わり）
func resultOpt(nb mut builder.Builder[ast.Node], db mut builder.Builder[int], cx Cx, p int) (int, int) {
    if tg(cx, p) == lexer.LParen {
        mut out := mut []int{}
        mut q := p + 1
        mut more := true
        mut ok := true
        while more && ok {
            ty, r := typeOf(mut nb, mut db, cx, q, false)
            if ty < 0 {
                ok = false
            } else {
                out = append(out, ty)
                q = r
                more = tg(cx, q) == lexer.Comma
                if more {
                    q += 1
                }
            }
        }
        if ok && tg(cx, q) == lexer.RParen {
            // `func() (func() R)?` — 括弧の 1 つの型に `?` が続けば省略可の型（loader が位置で拒否する）
            if len(out) == 1 && tg(cx, q + 1) == lexer.Question {
                return ast.PutList(mut db, []int{node(mut nb, ast.TOpt, tk(cx, p), out[0], 1, 0, 0, 0, 0)}), q + 2
            }
            return ast.PutList(mut db, freeze(out)), q + 1
        }
    }
    if typeStart(tg(cx, p)) {
        ty, r := typeOf(mut nb, mut db, cx, p, false)
        if ty >= 0 {
            return ast.PutList(mut db, []int{ty}), r
        }
    }
    return ast.PutList(mut db, []int{}), p
}

// qualName: type_name の綴り（IDENT ('.' IDENT)? / 'error'）。結果は（文字列, 次の位置）
func qualName(db mut builder.Builder[int], cx Cx, p int) (int, int) {
    if tg(cx, p) == lexer.KwError {
        return ast.PutLit(mut db, "error"), p + 1
    }
    if tg(cx, p) != lexer.Identifier {
        return -1, p
    }
    if tg(cx, p + 1) == lexer.Dot && tg(cx, p + 2) == lexer.Identifier {
        a := cx.ts[p]
        b := cx.ts[p + 2]
        at := builder.Len(mut db)
        builder.Push(mut db, a.end - a.start + 1 + b.end - b.start)
        mut i := a.start
        while i < a.end {
            builder.Push(mut db, int(cx.src[i]))
            i += 1
        }
        builder.Push(mut db, '.')
        i = b.start
        while i < b.end {
            builder.Push(mut db, int(cx.src[i]))
            i += 1
        }
        return at, p + 3
    }
    return name(mut db, cx, p), p + 1
}

// typeArgs: '[' type (',' type)* ']'（型の列、失敗は -1）
func typeArgs(nb mut builder.Builder[ast.Node], db mut builder.Builder[int], cx Cx, p0 int) (int, int) {
    mut out := mut []int{}
    mut p := p0 + 1
    mut more := true
    while more {
        ty, r := typeArg(mut nb, mut db, cx, p)
        if ty < 0 {
            return -1, p
        }
        out = append(out, ty)
        p = r
        more = tg(cx, p) == lexer.Comma
        if more {
            p += 1
        }
    }
    if tg(cx, p) != lexer.RBracket {
        return -1, p
    }
    return ast.PutList(mut db, freeze(out)), p + 1
}

// typeArg: type_arg <- '(' type (',' type)+ ')' / type。括弧の組は多値の型（P3b 残穴1 — 型引数の位置にだけ書ける: `task.Handle[(T, error?)]`）
func typeArg(nb mut builder.Builder[ast.Node], db mut builder.Builder[int], cx Cx, p0 int) (int, int) {
    if tg(cx, p0) != lexer.LParen {
        return typeOf(mut nb, mut db, cx, p0, false)
    }
    mut out := mut []int{}
    mut p := p0 + 1
    mut more := true
    while more {
        ty, r := typeOf(mut nb, mut db, cx, p, false)
        if ty < 0 {
            return -1, p
        }
        out = append(out, ty)
        p = r
        more = tg(cx, p) == lexer.Comma
        if more {
            p += 1
        }
    }
    if len(out) < 2 || tg(cx, p) != lexer.RParen {
        return -1, p
    }
    return node(mut nb, ast.TTuple, tk(cx, p0), ast.PutList(mut db, freeze(out)), 0, 0, 0, 0, 0), p + 1
}

// typeOf: type <- 'mut'? (type_name type_args? / type_lit / '(' type ')') '?'?。
// param なら先頭の mut は mut 引数の印（呼び手が字句で読む — parameters）で、型の mut はコンテナ（slice / map）だけに残す。
// それ以外の位置の mut はコンテナ限定（他は拒否）
func typeOf(nb mut builder.Builder[ast.Node], db mut builder.Builder[int], cx Cx, p0 int, param bool) (int, int) {
    mut p := p0
    mut m := false
    if tg(cx, p) == lexer.KwMut {
        m = true
        p += 1
    }
    t := tg(cx, p)
    // base の種類: 0 = 名前, 1 = generic, 2 = slice, 3 = map, 4 = func
    mut kind := 0
    mut x := -1
    mut y := -1
    mut z := -1
    if t == lexer.Identifier || t == lexer.KwError {
        n, q := qualName(mut db, cx, p)
        x = n
        p = q
        if tg(cx, p) == lexer.LBracket {
            args, r := typeArgs(mut nb, mut db, cx, p)
            if args >= 0 {
                kind = 1
                y = args
                p = r
            }
        }
    } else if t == lexer.LBracket {
        if tg(cx, p + 1) != lexer.RBracket {
            return -1, p
        }
        el, q := typeOf(mut nb, mut db, cx, p + 2, false)
        if el < 0 {
            return -1, p
        }
        kind = 2
        x = el
        p = q
    } else if t == lexer.KwMap {
        if tg(cx, p + 1) != lexer.LBracket {
            return -1, p
        }
        k, q := typeOf(mut nb, mut db, cx, p + 2, false)
        if k < 0 || tg(cx, q) != lexer.RBracket {
            return -1, p
        }
        v, r := typeOf(mut nb, mut db, cx, q + 1, false)
        if v < 0 {
            return -1, p
        }
        kind = 3
        x = k
        y = v
        p = r
    } else if t == lexer.LParen && tg(cx, p + 1) != lexer.RParen {
        // 括弧の型 `(T)` / `(T)?`（syntax.md の Type — 省略可の匿名関数型 `(func(…) R)?` の綴り。language.md 25 節 Z）。
        // `?` の付いた形は TOpt の b = 1（括弧の印 — 裸の `func(…)?` は loader が括弧の形へ誘導して拒否する）
        inner, q := typeOf(mut nb, mut db, cx, p + 1, false)
        if inner < 0 || tg(cx, q) != lexer.RParen {
            return -1, p
        }
        if m {
            return -1, p
        }
        if tg(cx, q + 1) == lexer.Question {
            return node(mut nb, ast.TOpt, tk(cx, p0), inner, 1, 0, 0, 0, 0), q + 2
        }
        return inner, q + 1
    } else if t == lexer.KwFunc {
        ps, pn, q := parametersN(mut nb, mut db, cx, p + 1, 1)
        if ps < 0 {
            return -1, p
        }
        rs, r := resultOpt(mut nb, mut db, cx, q)
        kind = 4
        x = ps
        y = rs
        z = pn
        p = r
    } else {
        return -1, p
    }
    opt := tg(cx, p) == lexer.Question
    if opt {
        p += 1
    }
    container := kind == 2 || kind == 3
    if param && !container {
        m = false
    }
    if m && (!container || opt) {
        return -1, p
    }
    mv := if m { 1 } else { 0 }
    base := switch kind {
    case 0: node(mut nb, ast.TName, tk(cx, p0), x, 0, 0, 0, 0, 0)
    case 1: node(mut nb, ast.TGeneric, tk(cx, p0), x, y, 0, 0, 0, 0)
    case 2: node(mut nb, ast.TSlice, tk(cx, p0), x, mv, 0, 0, 0, 0)
    case 3: node(mut nb, ast.TMap, tk(cx, p0), x, y, mv, 0, 0, 0)
    case _: node(mut nb, ast.TFunc, tk(cx, p0), x, y, z, 0, 0, 0)
    }
    if opt {
        return node(mut nb, ast.TOpt, tk(cx, p0), base, 0, 0, 0, 0, 0), p
    }
    return base, p
}

// fieldList: (field_decl (';' / &'}'))*（field_decl <- identifier_list (array_type / type) ('@' ('secret' / 'credential'))? — 後置の注釈は struct の欄の
// `@secret`〔KField の c = 1〕と `@credential`〔c = 2〕だけ〔ann〕。union の variant / error / panic の欄は拒否）。p は '{' の次。
// array_type `[N]T`（N は整数リテラル）は欄の型の最上段にだけ受ける（@layout の struct の外は loader の拒否 — language.md 36 節）
func fieldList(nb mut builder.Builder[ast.Node], db mut builder.Builder[int], cx Cx, p0 int, ann bool) (int, int) {
    mut out := mut []int{}
    mut p := p0
    while tg(cx, p) == lexer.Identifier {
        mut names := mut []int{}
        mut more := true
        while more {
            names = append(names, p)
            p += 1
            more = tg(cx, p) == lexer.Comma && tg(cx, p + 1) == lexer.Identifier
            if more {
                p += 1
            }
        }
        ty, q0 := fieldType(mut nb, mut db, cx, p)
        if ty < 0 {
            return -1, p
        }
        mut q := q0
        mut sec := 0
        if ann && tg(cx, q) == lexer.At && textIs(cx, q + 1, "secret") && tg(cx, q + 2) != lexer.LParen {
            sec = 1
            q += 2
        } else if ann && tg(cx, q) == lexer.At && textIs(cx, q + 1, "credential") && tg(cx, q + 2) != lexer.LParen {
            sec = 2
            q += 2
        }
        mut k := 0
        while k < len(names) {
            out = append(out, node(mut nb, ast.KField, tk(cx, names[k]), name(mut db, cx, names[k]), ty, sec, 0, 0, 0))
            k += 1
        }
        p = q
        if tg(cx, p) == lexer.Semicolon {
            p += 1
        } else if tg(cx, p) != lexer.RBrace {
            return -1, p
        }
    }
    return ast.PutList(mut db, freeze(out)), p
}

// fieldType は欄の型: `[N]T`（N は整数リテラル — TArray）か普通の型
func fieldType(nb mut builder.Builder[ast.Node], db mut builder.Builder[int], cx Cx, p int) (int, int) {
    if tg(cx, p) == lexer.LBracket && tg(cx, p + 1) == lexer.IntegerLiteral && tg(cx, p + 2) == lexer.RBracket {
        n, np := intLit(mut nb, cx, p + 1)
        if n < 0 {
            return -1, p
        }
        el, q := typeOf(mut nb, mut db, cx, np + 1, false)
        if el < 0 {
            return -1, p
        }
        return node(mut nb, ast.TArray, tk(cx, p), nodeAt(mut nb, n).a, el, 0, 0, 0, 0), q
    }
    return typeOf(mut nb, mut db, cx, p, false)
}

// type_decl <- 'type' IDENT type_params? ( type_spec_body / '=' type )（struct / union / error / 関数型 / 定義型 — 定義型の下地の制限は脱糖器。型パラメータつきの定義型は拒否）
func typeDecl(nb mut builder.Builder[ast.Node], db mut builder.Builder[int], cx Cx, p0 int, start int, layout int) (int, int) {
    if tg(cx, p0 + 1) != lexer.Identifier {
        return -1, p0
    }
    tname := name(mut db, cx, p0 + 1)
    mut p := p0 + 2
    mut tps := ast.PutList(mut db, []int{})
    generic := tg(cx, p) == lexer.LBracket
    if generic {
        l, q := typeParams(mut db, cx, p)
        if l < 0 {
            return -1, p
        }
        tps = l
        p = q
    }
    t := tg(cx, p)
    mut body := -1
    if t == lexer.Equal {
        // 型の別名 `type A = B`（language.md 32 節）: 右辺は型式として読み、形（型宣言の名前だけ・型パラメータなし）は loader の alias.sober が名指しで拒否する
        te, q := typeOf(mut nb, mut db, cx, p + 1, false)
        if te < 0 {
            return -1, p
        }
        body = node(mut nb, ast.BAlias, 0, te, 0, 0, 0, 0, 0)
        p = q
    } else if t == lexer.KwStruct {
        if tg(cx, p + 1) != lexer.LBrace {
            return -1, p
        }
        fs, q := fieldList(mut nb, mut db, cx, p + 2, true)
        if fs < 0 || tg(cx, q) != lexer.RBrace {
            return -1, q
        }
        body = node(mut nb, ast.BStruct, 0, fs, 0, 0, 0, 0, 0)
        p = q + 1
    } else if t == lexer.KwUnion {
        if tg(cx, p + 1) != lexer.LBrace {
            return -1, p
        }
        mut vs := mut []int{}
        mut q := p + 2
        while tg(cx, q) == lexer.Identifier {
            if tg(cx, q + 1) != lexer.LBrace {
                return -1, q
            }
            fs, r := fieldList(mut nb, mut db, cx, q + 2, false)
            if fs < 0 || tg(cx, r) != lexer.RBrace {
                return -1, r
            }
            // 後置の `@shared`（KVariant の c = 1 — 共有キャッシュも保存してよい方針の variant: std 限定・language.md 12 節「出所の依存」）
            vq := q
            mut sh := 0
            q = r + 1
            if tg(cx, q) == lexer.At && textIs(cx, q + 1, "shared") && tg(cx, q + 2) != lexer.LParen {
                sh = 1
                q += 2
            }
            vs = append(vs, node(mut nb, ast.KVariant, tk(cx, vq), name(mut db, cx, vq), fs, sh, 0, 0, 0))
            if tg(cx, q) == lexer.Semicolon {
                q += 1
            } else if tg(cx, q) != lexer.RBrace {
                return -1, q
            }
        }
        if tg(cx, q) != lexer.RBrace {
            return -1, q
        }
        body = node(mut nb, ast.BUnion, 0, ast.PutList(mut db, freeze(vs)), 0, 0, 0, 0, 0)
        p = q + 1
    } else if t == lexer.KwError || t == lexer.KwPanic {
        // error ラベル / panic ラベル（language.md 13 節・27 節 — 同じ宣言機構・別の語彙）
        if generic {
            return -1, p
        }
        bk := if t == lexer.KwError { ast.BError } else { ast.BPanic }
        if tg(cx, p + 1) == lexer.LBrace {
            fs, q := fieldList(mut nb, mut db, cx, p + 2, false)
            if fs < 0 || tg(cx, q) != lexer.RBrace {
                return -1, q
            }
            body = node(mut nb, bk, 0, fs, 0, 0, 0, 0, 0)
            p = q + 1
        } else {
            body = node(mut nb, bk, 0, ast.PutList(mut db, []int{}), 0, 0, 0, 0, 0)
            p += 1
        }
    } else if t == lexer.KwFunc {
        ps, pn, q := parametersN(mut nb, mut db, cx, p + 1, 1)
        if ps < 0 {
            return -1, p
        }
        rs, r := resultOpt(mut nb, mut db, cx, q)
        // 後置の `@errors(…)`（名前付き関数型の契約 — language.md 12 節の面「高階」・effect の波 段 1）: d = ラベル名の列 + 1（0 = 無し）・e = `@` の字句。
        // 後置の `@effects(…)`（段 5a — 順は問わない）: f = 項の列 + 1（0 = 無し）・節の字句 = その `@`
        mut ed := 0
        mut et := 0
        mut fd := 0
        mut ft := 0
        p = r
        mut more := true
        while more {
            more = false
            if tg(cx, p) == lexer.At && tg(cx, p + 2) == lexer.LParen && ((ed == 0 && textIs(cx, p + 1, "errors")) || (fd == 0 && textIs(cx, p + 1, "effects"))) {
                l := errorsArgs(mut db, cx, p + 2) + 1
                if textIs(cx, p + 1, "errors") {
                    et = tk(cx, p)
                    ed = l
                } else {
                    ft = tk(cx, p)
                    fd = l
                }
                p = skipParens(cx, p + 2)
                if p < 0 {
                    return -1, r
                }
                more = true
            }
        }
        body = node(mut nb, ast.BFunc, ft, ps, rs, pn, ed, et, fd)
    } else if !generic && typeStart(t) {
        te, q := typeOf(mut nb, mut db, cx, p, false)
        if te < 0 {
            return -1, p
        }
        body = node(mut nb, ast.BDefined, 0, te, 0, 0, 0, 0, 0)
        p = q
    } else {
        return -1, p
    }
    if tg(cx, p) != lexer.Semicolon {
        return -1, p
    }
    return node(mut nb, ast.KTypeDecl, tk(cx, p0 + 1), tname, tps, body, start, p + 1, layout), p + 1
}
