package http

// 認証の源の口と保存の方針の網（white-box — 非公開の request / frameAt / checkField 経由の頭）: Cookie の切り出し（RFC 6265 5.4 の `; ` 区切り・
// 前後の空白・`"` の囲み・名前の大文字小文字・`=` の無い組・2 本の Cookie 行）・Header が認証のヘッダを読まない・Authorization・Dispatch がルートの
// cache を cache の無い応答にだけ写す

// 頭 h（要求行から空行まで）の要求
func rq(h string) Request {
    b := bytes(h)
    r, e := request(b, frameAt(b, 0, 8192, 8192))
    assert(e == nil)
    return r
}

// v が s か（nil は偽）
func is(v string?, s string) bool {
    if v == nil {
        return false
    }
    return v == s
}

func TestCookie() {
    r := rq("GET / HTTP/1.1\r\nHost: x\r\nCookie: a=1; sid=\"ab cd\" ;  b = 2;flag; Sid=up\r\nCookie: c=3\r\n\r\n")
    assert(is(Cookie(r, "a"), "1"))
    assert(is(Cookie(r, "sid"), "ab cd"))
    assert(is(Cookie(r, "Sid"), "up"))
    assert(is(Cookie(r, "b"), "2"))
    assert(is(Cookie(r, "c"), "3"))
    assert(Cookie(r, "flag") == nil)
    assert(Cookie(r, "SID") == nil)
    assert(Cookie(r, "") == nil)
    e := rq("GET / HTTP/1.1\r\nHost: x\r\n\r\n")
    assert(Cookie(e, "a") == nil)
    // 空の値・= だけ
    z := rq("GET / HTTP/1.1\r\nCookie: a=; =b; c=\"\"\r\n\r\n")
    assert(is(Cookie(z, "a"), ""))
    assert(is(Cookie(z, "c"), ""))
}

func TestCredentialHeaders() {
    r := rq("GET / HTTP/1.1\r\nHost: x\r\nAuthorization: Bearer t0k\r\nProxy-Authorization: Basic eA==\r\nCookie: a=1\r\nAccept: */*\r\n\r\n")
    assert(Header(r, "authorization") == nil)
    assert(Header(r, "Authorization") == nil)
    assert(Header(r, "PROXY-AUTHORIZATION") == nil)
    assert(Header(r, "cookie") == nil)
    assert(is(Header(r, "accept"), "*/*"))
    assert(is(Header(r, "host"), "x"))
    assert(is(Authorization(r), "Bearer t0k"))
    assert(Authorization(rq("GET / HTTP/1.1\r\n\r\n")) == nil)
}

func TestCacheDefault() {
    assert(cacheValue(Private{}) == "private")
    assert(cacheValue(Private{maxAge: 60}) == "private, max-age=60")
    assert(cacheValue(Private{maxAge: -1}) == "private, max-age=0")
    assert(cacheValue(Shared{maxAge: 60}) == "public, max-age=60")
    assert(cacheValue(Shared{maxAge: 60, sMaxAge: 600}) == "public, max-age=60, s-maxage=600")
    h := string(respHead(Text("x"), true, false, 0)) catch ""
    assert(h == "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nCache-Control: private\r\nContent-Length: 1\r\n\r\n")
    n := string(respHead(Response{status: OK, contentType: "", body: []byte{}, cache: NoStore{}}, true, false, 0)) catch ""
    assert(n == "HTTP/1.1 200 OK\r\nCache-Control: no-store\r\nContent-Length: 0\r\n\r\n")
}

func TestRouteCache() {
    rs := []Route{
        Route{method: "GET", path: "/a", handler: (r) => Text("a"), middleware: []Middleware{}, cache: Fresh{maxAge: 60}},
        Route{method: "GET", path: "/b", handler: (r) => Response{status: OK, contentType: "", body: []byte{}, cache: NoStore{}}, middleware: []Middleware{}, cache: Fresh{maxAge: 60}},
        Route{method: "GET", path: "/c", handler: (r) => Text("c"), middleware: []Middleware{}},
        Route{method: "GET", path: "/d", handler: (r) => Status(NotFound), middleware: []Middleware{}, cache: Fresh{maxAge: 60}}}
    assert(cacheValue(Dispatch(rs, rq("GET /a HTTP/1.1\r\n\r\n")).cache) == "max-age=60")
    assert(cacheValue(Dispatch(rs, rq("GET /b HTTP/1.1\r\n\r\n")).cache) == "no-store")
    assert(cacheValue(Dispatch(rs, rq("GET /c HTTP/1.1\r\n\r\n")).cache) == "private")
    // 404 には行の方針を写さない
    assert(cacheValue(Dispatch(rs, rq("GET /d HTTP/1.1\r\n\r\n")).cache) == "private")
    // Mount はルートの cache を保つ
    m := Mount("/p", rs, []Middleware{})
    assert(cacheValue(Dispatch(m, rq("GET /p/a HTTP/1.1\r\n\r\n")).cache) == "max-age=60")
}
