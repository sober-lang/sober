    case TRef:
        // FS.Ty.relocA.eq_10
        if tA(mut st, a2) == 0 {
            v_rho0 := a0
            v_d := a1
            return mkLike(mut st, a2, TRef, b2i(false), if (tB(mut st, a2)) == 0 { v_rho0 } else { v_d }, relocA(mut st, v_rho0, v_d, (tC(mut st, a2))))
        }
        // FS.Ty.relocA.eq_13（最後の腕 — 先行の腕が外れれば当たる: tA(mut st, a2) != 0）
        v_rho0 := a0
        v_d := a1
        return mkLike(mut st, a2, TRef, b2i(true), rmap(v_rho0, v_d, (tB(mut st, a2))), renR(mut st, v_rho0, v_d, (tC(mut st, a2))))
    case TSl:
        // FS.Ty.relocA.eq_11
        if tA(mut st, a2) == 0 {
            v_rho0 := a0
            v_d := a1
            return mkLike(mut st, a2, TSl, b2i(false), if (tB(mut st, a2)) == 0 { v_rho0 } else { v_d }, relocA(mut st, v_rho0, v_d, (tC(mut st, a2))))
        }
