        return a2
    case TOpt:
        // FS.Ty.relocA.eq_7
        return mkLike(mut st, a2, TOpt, relocA(mut st, a0, a1, (tA(mut st, a2))), 0, 0)
    case TUn:
        // FS.Ty.relocA.eq_8
        v_rho0 := a0
        v_d := a1
        return mkLike(mut st, a2, TUn, relocA(mut st, v_rho0, v_d, (tA(mut st, a2))), relocA(mut st, v_rho0, v_d, (tB(mut st, a2))), 0)
    case TPr:
