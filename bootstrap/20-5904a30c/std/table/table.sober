package table

// Table[T] は添字で読み書きできる可変長の列（language.md 21 節の緩和策 2 の添字版）。
// 固定長の chunk の鎖に積み、Get / Set は O(1)（chunk = 添字 / CHUNK、chunk の中 = 添字 & (CHUNK - 1)）。
// 同じ region で他の割り当てと交錯して成長しても、成長のコピーによるゴミが出ない（chunk は一度確保したら動かない）。
// std/builder の Builder（倍々の chunk・Get は O(log n)・Set なし）は小さな列を積んで Build する用途、Table は大きな表を
// 添字で読み書きする用途（selfhost の脱糖器 / lower の記録 — reaudit ①）。
//
//     mut t := table.Table[int]{}
//     table.Push(mut t, 7)
//     table.Set(mut t, 0, table.Get(mut t, 0) + 1)
//
// 表現:
// - chunks は chunk ヘッダの列。初回の Push で空ヘッダ seed の写しを DIR0 本積み、足りなくなったら本数を倍にする（伸ばすときは列の写し
//   〔ヘッダだけ — chunk の中身は動かない〕が出うる。倍々なので償却 O(1)）
// - chunk は CHUNK 要素ずつ、seed の写しへ連続 append して確保する（seed は Table の region にあるので、確保先は Push を呼んだ深さに
//   依らない）。以降は添字で書く
// - 容量の上限は無い（2026-10-03 — 以前は CHUNK × DIR = 2^28 要素の固定で、raw〔--passes なし〕で自己を建てる lower のヒープが際を越えた。
//   NOTES の積み「Table の dir 自動成長」。初回の前置きも表 1 つあたり 32768 本 → 16 本）
type Table[T] struct {
    chunks mut []mut []T
    // 空の mut ヘッダ。ゼロ値リテラル `Table[T]{}` が束縛の region に作る（Builder の seed と同じ理由 — 21 節）
    seed mut []T
    n int
}

const CHUNK_BITS = 13 // CHUNK = 1 << CHUNK_BITS
const CHUNK = 8192
const DIR0 = 16

// Push は x を末尾に積む
func Push[T](t mut Table[T], x T) {
    k := t.n / CHUNK
    if k >= len(t.chunks) {
        // chunk のヘッダの列を伸ばす（初回は DIR0 本・以後は倍）
        grow := if len(t.chunks) == 0 { DIR0 } else { len(t.chunks) }
        mut i := 0
        while i < grow {
            t.chunks = append(t.chunks, t.seed)
            i += 1
        }
    }
    j := t.n & (CHUNK - 1)
    if j == 0 {
        mut c := t.chunks[k]
        mut m := 0
        while m < CHUNK {
            c = append(c, x)
            m += 1
        }
        t.chunks[k] = c
    } else {
        mut c := t.chunks[k]
        c[j] = x
    }
    t.n = t.n + 1
}

// PushAll は xs を順に末尾に積む（Push を要素ごとに呼ぶのと同じ結果 — chunk ごとにまとめて書く）
func PushAll[T](t mut Table[T], xs []T) {
    mut at := 0
    while at < len(xs) {
        k := t.n / CHUNK
        if k >= len(t.chunks) {
            grow := if len(t.chunks) == 0 { DIR0 } else { len(t.chunks) }
            mut i := 0
            while i < grow {
                t.chunks = append(t.chunks, t.seed)
                i += 1
            }
        }
        j := t.n & (CHUNK - 1)
        m := if len(xs) - at < CHUNK - j { len(xs) - at } else { CHUNK - j }
        if j == 0 {
            // 新しい chunk: 積む分を写し、残りは先頭の値で埋める（Push の確保と同じく CHUNK 要素の連続 append）
            // 写しのループの形（copyloop の一括の写し — lower の --passes の経路）
            mut c := t.chunks[k]
            e := at + m
            mut q := at
            while q < e {
                c = append(c, xs[q])
                q += 1
            }
            x0 := xs[at]
            mut r := m
            while r < CHUNK {
                c = append(c, x0)
                r += 1
            }
            t.chunks[k] = c
        } else {
            mut c := t.chunks[k]
            mut q := 0
            while q < m {
                c[j + q] = xs[at + q]
                q += 1
            }
        }
        t.n = t.n + m
        at += m
    }
}

// Len は積んだ要素の個数
func Len[T](t mut Table[T]) int {
    return t.n
}

// Get は i 番目（0 起点）の要素。i が範囲外（i < 0 か Len 以上）なら添字の境界検査で panic する
func Get[T](t mut Table[T], i int) T {
    // 範囲外は chunk の番号を -1 にして chunk の列の境界検査に落とす（chunk の中身は確保時の写しで埋まっているので、Len 以降も読めてしまう）。
    // 形は展開の量で選んだ（Get / Set は呼び出し点ごとに展開される）: 範囲外の判定は i | (n - 1 - i) の符号 1 つ（i < 0 か i ≥ n のとき、
    // かつそのときだけ負）、chunk の番号は定数の除算（i ≥ 0 なので >> と同じ値）。`>>` は量が定数でも lower が言語のシフトの場合分け
    // （負の量・64 以上 — docs/ir.md 4 節）を分岐で吐くので使わない。chunk のヘッダは局所に写さず二重添字で読む（写しのスロットを作らない）。
    // 判定を関数に括り出さないのは、mut 引数の無い関数は展開されず呼び出しになるため
    k := if (i | (t.n - 1 - i)) < 0 { -1 } else { i / CHUNK }
    return t.chunks[k][i & (CHUNK - 1)]
}

// Set は i 番目（0 起点）の要素を x にする。i が範囲外なら Get と同じく panic する（形は Get と同じ）
func Set[T](t mut Table[T], i int, x T) {
    k := if (i | (t.n - 1 - i)) < 0 { -1 } else { i / CHUNK }
    t.chunks[k][i & (CHUNK - 1)] = x
}

// Frozen[T] は Freeze が返す凍った表（imm — 書く口が無い。par の子へそのまま渡せる）
type Frozen[T] struct {
    chunks [][]T
    n int
}

// Freeze は t の中身を写さずに凍らせて返し、t を空の表に戻す（取り出し形 — language.md 17 節の bottom-up 凍結の Table 版:
// 中身のある chunk を 1 本ずつ取り出して表の欄を空の seed に差し替えてから freeze する。凍らせた chunk に届くのは返す Frozen だけ。
// t は以後も普通の空の表として使える — 新しく積む分は新しい chunk に入り、凍らせた中身には届かない）。
// 仮裁定（2026-10-07 夜間 — 朝のユーザー裁定で確定 / 差し戻し — report-346）
func Freeze[T](t mut Table[T]) Frozen[T] {
    nc := (t.n + CHUNK - 1) / CHUNK
    mut out := mut [][]T{}
    mut k := 0
    while k < nc {
        mut c := t.chunks[k]
        t.chunks[k] = t.seed
        out = append(out, freeze(c))
        k += 1
    }
    n := t.n
    t.chunks = mut []mut []T{}
    t.n = 0
    return Frozen[T]{chunks: freeze(out), n: n}
}

// FrozenLen は凍った表の要素の個数
func FrozenLen[T](f Frozen[T]) int {
    return f.n
}

// At は凍った表の i 番目（0 起点）の要素。範囲外なら Get と同じく panic する（形も Get と同じ）
func At[T](f Frozen[T], i int) T {
    k := if (i | (f.n - 1 - i)) < 0 { -1 } else { i / CHUNK }
    return f.chunks[k][i & (CHUNK - 1)]
}
