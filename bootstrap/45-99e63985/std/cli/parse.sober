package cli

// 引数の解析（Parse）と表の宣言の検査

import "std/convert"
import "std/iter"
import "std/os"
import "std/strings"

// 種類の番号（flagAt の戻り）
const kBool = 1
const kStr = 2
const kInt = 3
const kChoice = 4
const kList = 5

// args（0 番 = プログラム名 — os.Args の並び）を app の表で読む。誤りのときも、そこまでに当たったコマンドの道を持つ Parsed を返す
// （Format が文面の頭に使う）。予約の綴りは error の Request で返す。表の宣言の誤りは panic(Misdeclared)
@errors(UnknownFlag, UnknownCommand, MissingValue, BadValue, Missing, Extra, Duplicate, Request)
@effects(io, panic)
func Parse(app App, args []string) (Parsed, error?) {
    checkApp(app)
    mut i := 1
    mut ci := 0 - 1
    mut path := ""
    if len(app.commands) == 1 && app.commands[0].name == "" {
        ci = 0
    } else {
        if i < len(args) && args[i] == "help" {
            return helpCmd(app, args)
        }
        while i < len(args) && !flagLike(args[i]) {
            cand := join2(path, args[i])
            k := cmdIndex(app, cand)
            if k < 0 && !hasGroup(app, cand) {
                if ci >= 0 {
                    break
                }
                return bare(path), UnknownCommand{arg: i, word: args[i], near: closest(args[i], nextWords(app, path))}
            }
            path = cand
            ci = k
            i += 1
        }
        if ci < 0 {
            if i < len(args) {
                rq := reserved(args[i])
                if rq != "" {
                    return bare(path), Request{word: rq}
                }
                return bare(path), UnknownFlag{arg: i, word: args[i], near: closest(args[i], []string{"--help", "-h", "--version"})}
            }
            return bare(path), Missing{flag: "<command>"}
        }
    }
    return parseCmd(app.commands[ci], args, i)
}

// `prog help [コマンドの語…]`（= `prog <コマンド> --help`）
func helpCmd(app App, args []string) (Parsed, error?) {
    mut path := ""
    for i <- iter.Range(2, len(args)) {
        cand := join2(path, args[i])
        if cmdIndex(app, cand) < 0 && !hasGroup(app, cand) {
            return bare(path), UnknownCommand{arg: i, word: args[i], near: closest(args[i], nextWords(app, path))}
        }
        path = cand
    }
    return bare(path), Request{word: "help"}
}

// 値の無い Parsed（誤りのときの道だけ）
func bare(path string) Parsed {
    return Parsed{cmd: path, seal: sealed{}}
}

// コマンド c の表で args[i:] を読む
func parseCmd(c Command, args []string, start int) (Parsed, error?) {
    nb := len(c.bools)
    ns := len(c.strs)
    ni := len(c.ints)
    nc := len(c.choices)
    mut bv := mut []bool{}
    mut ba := mut []int{}
    mut sv := mut []string{}
    mut sa := mut []int{}
    mut iv := mut []int{}
    mut ia := mut []int{}
    mut cv := mut []string{}
    mut ca := mut []int{}
    for _ <- iter.Range(0, nb) {
        bv = append(bv, false)
        ba = append(ba, 0 - 1)
    }
    for _ <- iter.Range(0, ns) {
        sv = append(sv, "")
        sa = append(sa, 0 - 1)
    }
    for _ <- iter.Range(0, ni) {
        iv = append(iv, 0)
        ia = append(ia, 0 - 1)
    }
    for _ <- iter.Range(0, nc) {
        cv = append(cv, "")
        ca = append(ca, 0 - 1)
    }
    mut lk := mut []int{}
    mut lv := mut []string{}
    mut pk := mut []int{}
    mut pv := mut []string{}
    nfix := fixedCount(c)
    many := manyIndex(c)
    mut filled := 0
    mut nmany := 0
    // rest: many でない位置引数が全部埋まった後（無ければ最初の位置引数から）の引数はフラグとして読まない
    mut raw := false
    mut dashed := false
    mut i := start
    while i < len(args) {
        a := args[i]
        if raw || dashed || a == "--" || !flagLike(a) {
            if a == "--" && !raw && !dashed {
                dashed = true
            } else if !raw && filled < nfix {
                pk = append(pk, filled)
                pv = append(pv, a)
                filled += 1
                if c.rest && many >= 0 && filled == nfix {
                    raw = true
                    if i + 1 < len(args) && args[i + 1] == "--" {
                        i += 1
                    }
                }
            } else if many >= 0 {
                nmany += 1
                pk = append(pk, many)
                pv = append(pv, a)
                raw = raw || c.rest
            } else {
                return bare(c.name), Extra{arg: i, word: a}
            }
            i += 1
            continue
        }
        rq := reserved(a)
        if rq != "" {
            return bare(c.name), Request{word: rq}
        }
        long := strings.HasPrefix(a, "--")
        body := if long { strings.TrimPrefix(a, "--") } else { strings.TrimPrefix(a, "-") }
        name, val, eq := strings.Cut(body, "=")
        kind, k := flagAt(c, name, long)
        if kind == 0 {
            return bare(c.name), UnknownFlag{arg: i, word: a, near: closest(dashOf(a, eq), spellings(c))}
        }
        sp := spell(name)
        if kind == kBool {
            if eq {
                return bare(c.name), BadValue{arg: i, flag: sp, word: val, want: "no value"}
            }
            if ba[k] >= 0 {
                return bare(c.name), Duplicate{arg: i, flag: sp, first: ba[k]}
            }
            bv[k] = true
            ba[k] = i
            i += 1
            continue
        }
        at0 := i
        mut v := val
        if !eq {
            if i + 1 >= len(args) {
                return bare(c.name), MissingValue{arg: i, flag: sp}
            }
            i += 1
            v = args[i]
        }
        i += 1
        if kind == kList {
            lk = append(lk, k)
            lv = append(lv, v)
        } else if kind == kStr {
            if sa[k] >= 0 {
                return bare(c.name), Duplicate{arg: at0, flag: sp, first: sa[k]}
            }
            sv[k] = v
            sa[k] = at0
        } else if kind == kInt {
            if ia[k] >= 0 {
                return bare(c.name), Duplicate{arg: at0, flag: sp, first: ia[k]}
            }
            n, ok := intOf(c.ints[k], v)
            if !ok {
                return bare(c.name), BadValue{arg: at0, flag: sp, word: v, want: intWant(c.ints[k])}
            }
            iv[k] = n
            ia[k] = at0
        } else {
            if ca[k] >= 0 {
                return bare(c.name), Duplicate{arg: at0, flag: sp, first: ca[k]}
            }
            f := c.choices[k]
            if !has(f.choices, v) && !has(f.dev, v) {
                return bare(c.name), BadValue{arg: at0, flag: sp, word: v, want: choiceWant(f)}
            }
            cv[k] = v
            ca[k] = at0
        }
    }
    // 位置引数の欠け
    for k <- iter.Range(0, len(c.pos)) {
        p := c.pos[k]
        got := if p.many { nmany > 0 } else { k < filled }
        if !got && !p.optional {
            return bare(c.name), Missing{flag: "<" + p.name + ">"}
        }
    }
    // 無いフラグ: env → def → opt でなければ Missing
    mut sh := mut []bool{}
    for k <- iter.Range(0, ns) {
        f := c.strs[k]
        mut ok := sa[k] >= 0
        if !ok {
            ev := envOf(f.env)
            if ev != nil {
                sv[k] = ev
                ok = true
            } else {
                d := f.def
                if d != nil {
                    sv[k] = d
                    ok = true
                }
            }
        }
        if !ok && !f.opt {
            return bare(c.name), Missing{flag: spell(f.name)}
        }
        sh = append(sh, ok)
    }
    mut ih := mut []bool{}
    for k <- iter.Range(0, ni) {
        f := c.ints[k]
        mut ok := ia[k] >= 0
        if !ok {
            ev := envOf(f.env)
            if ev != nil {
                n, good := intOf(f, ev)
                if !good {
                    return bare(c.name), BadValue{arg: 0 - 1, flag: envName(f.env), word: ev, want: intWant(f)}
                }
                iv[k] = n
                ok = true
            } else {
                d := f.def
                if d != nil {
                    iv[k] = d
                    ok = true
                }
            }
        }
        if !ok && !f.opt {
            return bare(c.name), Missing{flag: spell(f.name)}
        }
        ih = append(ih, ok)
    }
    mut ch := mut []bool{}
    for k <- iter.Range(0, nc) {
        f := c.choices[k]
        mut ok := ca[k] >= 0
        if !ok {
            d := f.def
            if d != nil {
                cv[k] = d
                ok = true
            }
        }
        if !ok && !f.opt {
            return bare(c.name), Missing{flag: spell(f.name)}
        }
        ch = append(ch, ok)
    }
    return Parsed{
        cmd: c.name,
        found: true,
        bn: boolNames(c.bools),
        bv: freeze(bv),
        sn: strNames(c.strs),
        sv: freeze(sv),
        sh: freeze(sh),
        inames: intNames(c.ints),
        iv: freeze(iv),
        ih: freeze(ih),
        cn: choiceNames(c.choices),
        cv: freeze(cv),
        ch: freeze(ch),
        ln: listNames(c.lists),
        lk: freeze(lk),
        lv: freeze(lv),
        pn: posNames(c.pos),
        pk: freeze(pk),
        pv: freeze(pv),
        seal: sealed{},
    }, nil
}

// a がフラグの綴りか（`-` 1 文字は位置引数 — 標準入力の慣習）
func flagLike(a string) bool {
    return strings.HasPrefix(a, "-") && a != "-"
}

// 予約の綴りの要求の種類（無ければ ""）
func reserved(a string) string {
    if a == "--help" || a == "-h" {
        return "help"
    }
    if a == "--help=dev" {
        return "help=dev"
    }
    if a == "--version" {
        return "version"
    }
    if a == "--cli-spec" {
        return "cli-spec"
    }
    return ""
}

// 誤りの綴り a の `=` より前（near の比較に値を混ぜない）
func dashOf(a string, eq bool) string {
    if !eq {
        return a
    }
    h, _, _ := strings.Cut(a, "=")
    return h
}

// 名前の綴り（1 文字なら `-x`・それ以外は `--name`）
func spell(name string) string {
    return if len(bytes(name)) == 1 { "-" + name } else { "--" + name }
}

// 綴りの名前 name（long = `--` で書かれた）の種類と添字（無ければ 0）
func flagAt(c Command, name string, long bool) (int, int) {
    for k <- iter.Range(0, len(c.bools)) {
        if hit(c.bools[k].name, c.bools[k].short, name, long) {
            return kBool, k
        }
    }
    for k <- iter.Range(0, len(c.strs)) {
        if hit(c.strs[k].name, c.strs[k].short, name, long) {
            return kStr, k
        }
    }
    for k <- iter.Range(0, len(c.ints)) {
        if hit(c.ints[k].name, c.ints[k].short, name, long) {
            return kInt, k
        }
    }
    for k <- iter.Range(0, len(c.choices)) {
        if hit(c.choices[k].name, "", name, long) {
            return kChoice, k
        }
    }
    for k <- iter.Range(0, len(c.lists)) {
        if hit(c.lists[k].name, c.lists[k].short, name, long) {
            return kList, k
        }
    }
    return 0, 0
}

// 宣言（名前 n・short s）が綴りに当たるか: `--` は 2 文字以上の名前・`-` は 1 文字の名前か short
func hit(n string, s string, name string, long bool) bool {
    if long {
        return len(bytes(n)) > 1 && n == name
    }
    return (len(bytes(n)) == 1 && n == name) || (s != "" && s == name)
}

// コマンド c の全部の綴り（near の候補 — dev と予約の綴りも含む）
func spellings(c Command) []string {
    mut out := mut []string{"--help", "-h", "--version"}
    for f <- c.bools {
        addSpell(mut out, f.name, f.short)
    }
    for ix <- iter.Range(0, len(c.strs)) {
        f := c.strs[ix]
        addSpell(mut out, f.name, f.short)
    }
    for ix <- iter.Range(0, len(c.ints)) {
        f := c.ints[ix]
        addSpell(mut out, f.name, f.short)
    }
    for ix <- iter.Range(0, len(c.choices)) {
        f := c.choices[ix]
        addSpell(mut out, f.name, "")
    }
    for f <- c.lists {
        addSpell(mut out, f.name, f.short)
    }
    return freeze(out)
}

func addSpell(out mut []string, name string, short string) {
    out = append(out, spell(name))
    if short != "" {
        out = append(out, "-" + short)
    }
}

// v を f の整数として読む（範囲・許す値の表の外は false）
func intOf(f IntFlag, v string) (int, bool) {
    n, e := convert.ParseInt(v)
    if e != nil {
        return 0, false
    }
    lo := f.min
    if lo != nil && n < lo {
        return 0, false
    }
    hi := f.max
    if hi != nil && n > hi {
        return 0, false
    }
    if len(f.allow) > 0 && !hasInt(f.allow, n) {
        return 0, false
    }
    return n, true
}

// f の受ける値の説明
func intWant(f IntFlag) string {
    if len(f.allow) > 0 {
        // 続いた値は `a..b` に畳む（1, 2, 3, 5 → 1..3, 5）
        mut ws := mut []string{}
        mut k := 0
        while k < len(f.allow) {
            mut j := k
            while j + 1 < len(f.allow) && f.allow[j + 1] == f.allow[j] + 1 {
                j += 1
            }
            w := if j - k >= 2 { convert.FormatInt(f.allow[k]) + ".." + convert.FormatInt(f.allow[j]) } else { convert.FormatInt(f.allow[k]) }
            ws = append(ws, w)
            if j - k == 1 {
                ws = append(ws, convert.FormatInt(f.allow[j]))
            }
            k = j + 1
        }
        return "one of " + strings.Join(freeze(ws), ", ")
    }
    lo := f.min
    hi := f.max
    if lo != nil && hi != nil {
        return "an integer in " + convert.FormatInt(lo) + ".." + convert.FormatInt(hi)
    }
    if lo != nil {
        return "an integer >= " + convert.FormatInt(lo)
    }
    if hi != nil {
        return "an integer <= " + convert.FormatInt(hi)
    }
    return "an integer"
}

// f の受ける値の説明（dev の選択肢は出さない — choices が空なら dev を出す）
func choiceWant(f ChoiceFlag) string {
    cs := if len(f.choices) > 0 { f.choices } else { f.dev }
    return "one of " + strings.Join(cs, ", ")
}

// 環境変数 name の値（宣言なし・無い・空・不正な UTF-8 は nil）
func envOf(name string?) string? {
    if name == nil {
        return nil
    }
    v, e := os.Getenv(name)
    if e != nil || v == nil || v == "" {
        return nil
    }
    return v
}

func envName(name string?) string {
    if name == nil {
        return ""
    }
    return name
}

func has(xs []string, s string) bool {
    for x <- xs {
        if x == s {
            return true
        }
    }
    return false
}

func hasInt(xs []int, n int) bool {
    for x <- xs {
        if x == n {
            return true
        }
    }
    return false
}

// コマンドの道に語を足す
func join2(path string, w string) string {
    return if path == "" { w } else { path + " " + w }
}

// 名前 name のコマンドの添字（無ければ -1）
func cmdIndex(app App, name string) int {
    for k <- iter.Range(0, len(app.commands)) {
        if app.commands[k].name == name {
            return k
        }
    }
    return 0 - 1
}

// name の下にサブコマンドがあるか（`name ` で始まる名前のコマンドがあるか）
func hasGroup(app App, name string) bool {
    for ix <- iter.Range(0, len(app.commands)) {
        c := app.commands[ix]
        if strings.HasPrefix(c.name, name + " ") {
            return true
        }
    }
    return false
}

// 道 path の次の語の候補（near の候補）
func nextWords(app App, path string) []string {
    mut out := mut []string{}
    for ix <- iter.Range(0, len(app.commands)) {
        c := app.commands[ix]
        rest := if path == "" { c.name } else { strings.TrimPrefix(c.name, path + " ") }
        if path == "" || rest != c.name {
            w, _, _ := strings.Cut(rest, " ")
            out = append(out, w)
        }
    }
    return freeze(out)
}

func fixedCount(c Command) int {
    mut n := 0
    for p <- c.pos {
        if !p.many {
            n += 1
        }
    }
    return n
}

func manyIndex(c Command) int {
    for k <- iter.Range(0, len(c.pos)) {
        if c.pos[k].many {
            return k
        }
    }
    return 0 - 1
}

// ── 把手の名前の列（Parsed の表）──

func boolNames(fs []BoolFlag) []string {
    mut out := mut []string{}
    for f <- fs {
        out = append(out, f.name)
    }
    return freeze(out)
}

func strNames(fs []StrFlag) []string {
    mut out := mut []string{}
    for f <- fs {
        out = append(out, f.name)
    }
    return freeze(out)
}

func intNames(fs []IntFlag) []string {
    mut out := mut []string{}
    for f <- fs {
        out = append(out, f.name)
    }
    return freeze(out)
}

func choiceNames(fs []ChoiceFlag) []string {
    mut out := mut []string{}
    for f <- fs {
        out = append(out, f.name)
    }
    return freeze(out)
}

func listNames(fs []ListFlag) []string {
    mut out := mut []string{}
    for f <- fs {
        out = append(out, f.name)
    }
    return freeze(out)
}

func posNames(ps []Positional) []string {
    mut out := mut []string{}
    for p <- ps {
        out = append(out, p.name)
    }
    return freeze(out)
}

// ── near（編集距離 2 以内の最寄り）──

// word に最も近い候補（距離 ≤ 2 — 同じ距離なら先の候補。無ければ nil）
func closest(word string, cands []string) string? {
    mut best := 3
    mut bi := 0 - 1
    for k <- iter.Range(0, len(cands)) {
        d := dist(bytes(word), bytes(cands[k]))
        if d < best {
            best = d
            bi = k
        }
    }
    if bi < 0 {
        return nil
    }
    return cands[bi]
}

// a と b の編集距離（Levenshtein — 1 行の DP）
func dist(a []byte, b []byte) int {
    mut cur := mut []int{}
    for j <- iter.Range(0, len(b) + 1) {
        cur = append(cur, j)
    }
    for i <- iter.Range(1, len(a) + 1) {
        mut diag := cur[0]
        cur[0] = i
        for j <- iter.Range(1, len(b) + 1) {
            up := cur[j]
            cost := if a[i - 1] == b[j - 1] { 0 } else { 1 }
            mut v := diag + cost
            if up + 1 < v {
                v = up + 1
            }
            if cur[j - 1] + 1 < v {
                v = cur[j - 1] + 1
            }
            cur[j] = v
            diag = up
        }
    }
    return cur[len(b)]
}

// ── 表の宣言の検査（誤りは panic(Misdeclared) — 宣言はプログラムの一部なので到達 = バグ）──

func checkApp(app App) {
    for k <- iter.Range(0, len(app.commands)) {
        c := app.commands[k]
        if c.name == "" && len(app.commands) != 1 {
            panic(Misdeclared{flag: "", why: "a command without a name must be the only command"})
        }
        if c.name == "help" {
            panic(Misdeclared{flag: "help", why: "the command name help is reserved"})
        }
        if cmdIndex(app, c.name) != k {
            panic(Misdeclared{flag: c.name, why: "the command is declared twice"})
        }
        checkCmd(c)
    }
}

func checkCmd(c Command) {
    ss := spellings(c)
    for k <- iter.Range(0, len(ss)) {
        s := ss[k]
        for j <- iter.Range(0, k) {
            if ss[j] == s {
                why := if j < 3 { "the spelling is reserved" } else { "the spelling is declared twice" }
                panic(Misdeclared{flag: s, why: why})
            }
        }
        if s == "--cli-spec" {
            panic(Misdeclared{flag: s, why: "the spelling is reserved"})
        }
    }
    for k <- iter.Range(0, len(c.pos)) {
        if c.pos[k].many && k != len(c.pos) - 1 {
            panic(Misdeclared{flag: "<" + c.pos[k].name + ">", why: "only the last positional can be many"})
        }
    }
}
