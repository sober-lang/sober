package password

// パスワードの保存用のハッシュ（Argon2id・bcrypt・PBKDF2-HMAC-SHA256）と照合。
// 書く側は方式を名指しで呼ぶ — 書く口に既定の方式は無い（保存した値は他のシステム・組織の方針との約束なので、std が黙って選ばない）。
// 新しく選ぶなら Argon2id（RFC 9106 — NeedsRehash の UseDefault が目標にする std の推す方式もこれ）。読む側（Verify・NeedsRehash）は保存した文字列の頭で方式を判別する。
// 塩は書く側が OS の乱数で 16 バイト作る。保存の形は Argon2id と PBKDF2 が PHC 文字列（base64 は詰め物なし）・bcrypt が $2b$ の 60 文字
//
// 費用の仮引数は省略可の名前付きで、省いた費用は OWASP Password Storage Cheat Sheet（2026-11 時点の版）の推奨の下限
// （Argon2id: memoryKiB 19456・passes 2・lanes 1 / bcrypt: cost 10 / PBKDF2-HMAC-SHA256: iters 600000）。
// 既定の値の改訂は std の版で行い、CHANGELOG に載る。費用は保存した文字列に入るので、既定が変わっても前に保存した値の Verify は変わらない
// （作り直しの要否は NeedsRehash で分かる — UseDefault を渡せば、版上げで既定が変わったときに作り直しを求める）
//
//     h := password.Argon2id(pw)?
//     ok := password.Verify(h, pw)?
//     if ok && password.NeedsRehash(h, password.UseDefault{})? {
//         // 照合に通った pw で password.Argon2id(pw) を作り直して保存し直す（std の既定に追従する）
//     }

import "std/base64"
import "std/convert"
import "std/crypto"
import "std/internal/bless"
import "std/iter"
import "std/strings"

// NeedsRehash に渡す目標の方式と費用。UseDefault は方式も費用も std の版に任せる形で、今の std の推す方式と既定の費用
// （Argon2id・memoryKiB 19456・passes 2・lanes 1）を目標にする — 費用を省いた Argon2id(pw) で作り直せば目標に揃う。
// std の版上げで既定が変わると、同じ保存の文字列でも UseDefault の判定は変わる（作り直しを求める側へ）
type Policy union {
    UseDefault {}
    UseArgon2id { memoryKiB int; passes int; lanes int }
    UseBcrypt { cost int }
    UsePbkdf2 { iters int }
}

// 費用が方式の範囲の外（Argon2id: 1 ≤ lanes < 2^24・passes ≥ 1・8·lanes ≤ memoryKiB < 2^32 / bcrypt: 4 ≤ cost ≤ 31 / PBKDF2: 1 ≤ iters < 2^32）
type BadParams error

// bcrypt に渡せない pw（72 バイトを超える・NUL を含む — bcrypt は 72 バイトで黙って打ち切り、C の実装は NUL で切る。長い pw は Argon2id で）
type TooLong error

// 保存した文字列が読めない（知らない方式・欄の形・base64・範囲の外の費用）
type Bad error

// 省いた費用の既定（OWASP Password Storage Cheat Sheet の推奨の下限）
const defaultMemoryKiB = 19456
const defaultPasses = 2
const defaultLanes = 1
const defaultCost = 10
const defaultIters = 600000

const saltLen = 16
const tagLen = 32

// pw の Argon2id の PHC 文字列（$argon2id$v=19$m=…,t=…,p=…$塩$値 — 値は 32 バイト）。
// 費用は memoryKiB = メモリ m〔KiB〕・passes = パス t・lanes = レーン p（省けば 19456・2・1 — 19 MiB）。
// 作業域 m は呼んだ task の region に取るので、std/net の Serve の接続の task（region: 既定 128 MiB）で m を 100 MiB 超にするなら region: も上げる
@errors(BadParams)
@secret(pw)
@effects(io, panic)
func Argon2id(pw string, memoryKiB int?, passes int?, lanes int?) (string, error?) {
    m := if memoryKiB == nil { defaultMemoryKiB } else { memoryKiB }
    t := if passes == nil { defaultPasses } else { passes }
    p := if lanes == nil { defaultLanes } else { lanes }
    if !argon2Ok(m, t, p) {
        return "", BadParams{}
    }
    salt := crypto.Rand(saltLen)
    // 保存する値（照合の相手として外へ出す — 公開してよい）
    h := bless.Bytes(argon2idKey(bytes(pw), salt, []byte{}, []byte{}, t, m, p, tagLen))
    return strings.Join([]string{"", "argon2id", "v=19", "m=${m},t=${t},p=${p}", b64(salt), b64(h)}, "$"), nil
}

// pw の bcrypt の文字列（$2b$費用$塩と値 — 60 文字）。cost を省けば 10。72 バイトを超える pw・NUL を含む pw は TooLong（打ち切らない）
// 特に理由がなければ Argon2id を使う。長い pw を bcrypt で受けたいときの正当な形は bcrypt(base64(sha256(pw)))（44 文字・NUL を含まない）で、罠が 2 つある:
// ① 生のダイジェストを渡さない — 0 のバイトを含みうるので、NUL で切る実装では打ち切られる（ここでは TooLong で拒否）
// ② 内側のハッシュ sha256(pw) を別の所に保存しない — 漏れた内側のハッシュの表を bcrypt の表と突き合わせる hash shucking の的になる
@errors(BadParams, TooLong)
@secret(pw)
@effects(io, panic)
func Bcrypt(pw string, cost int?) (string, error?) {
    k := if cost == nil { defaultCost } else { cost }
    if k < 4 || k > 31 {
        return "", BadParams{}
    }
    b := bytes(pw)
    if !bcryptPwOk(b) {
        return "", TooLong{}
    }
    salt := crypto.Rand(saltLen)
    // 保存する値（照合の相手として外へ出す — 公開してよい）
    h := bless.Bytes(bcryptHash(b, salt, k))
    c := if k < 10 { "0${k}" } else { "${k}" }
    return strings.Join([]string{"", "2b", c, "${bcryptEncode(salt)}${bcryptEncode(h)}"}, "$"), nil
}

// pw の PBKDF2-HMAC-SHA256 の PHC 文字列（$pbkdf2-sha256$i=…,l=32$塩$値）。iters を省けば 600000
@errors(BadParams)
@secret(pw)
@effects(io, panic)
func Pbkdf2(pw string, iters int?) (string, error?) {
    n := if iters == nil { defaultIters } else { iters }
    if n < 1 || n > m32 {
        return "", BadParams{}
    }
    salt := crypto.Rand(saltLen)
    // 保存する値（照合の相手として外へ出す — 公開してよい）
    h := bless.Bytes(pbkdf2Key(bytes(pw), salt, n, tagLen))
    return strings.Join([]string{"", "pbkdf2-sha256", "i=${n},l=${tagLen}", b64(salt), b64(h)}, "$"), nil
}

// pw が保存した文字列 stored（Argon2id・bcrypt〔$2a$ / $2b$ / $2y$〕・PBKDF2-SHA256）と合うか。値の比較は定数時間。
// bcrypt に渡せない pw（72 バイト超・NUL）は false
@errors(Bad)
@secret(pw)
@effects(!io, !block, !nondet)
func Verify(stored string, pw string) (bool, error?) {
    s, ok := parseStored(stored)
    if !ok {
        return false, Bad{}
    }
    b := bytes(pw)
    if s.alg == algBcrypt && !bcryptPwOk(b) {
        return false, nil
    }
    got := if s.alg == algArgon2id {
        argon2idKey(b, s.salt, []byte{}, []byte{}, s.t, s.m, s.p, len(s.hash))
    } else if s.alg == algBcrypt {
        bcryptHash(b, s.salt, s.cost)
    } else {
        pbkdf2Key(b, s.salt, s.iters, len(s.hash))
    }
    return crypto.Equal(got, s.hash), nil
}

// 保存した文字列 stored を目標 policy で作り直すべきか（方式が違う・費用が目標と違う・値の長さが既定〔32 バイト〕でない）。
// 作り直すには pw が要るので、Verify に通った直後に呼ぶ
@errors(Bad)
@effects(!io, !block, !nondet)
func NeedsRehash(stored string, policy Policy) (bool, error?) {
    s, ok := parseStored(stored)
    if !ok {
        return false, Bad{}
    }
    same := switch policy {
    case UseDefault{}: s.alg == algArgon2id && s.m == defaultMemoryKiB && s.t == defaultPasses && s.p == defaultLanes && len(s.hash) == tagLen
    case UseArgon2id{memoryKiB, passes, lanes}: s.alg == algArgon2id && s.m == memoryKiB && s.t == passes && s.p == lanes && len(s.hash) == tagLen
    case UseBcrypt{cost}: s.alg == algBcrypt && s.cost == cost
    case UsePbkdf2{iters}: s.alg == algPbkdf2 && s.iters == iters && len(s.hash) == tagLen
    }
    return !same, nil
}

const algArgon2id = 1
const algBcrypt = 2
const algPbkdf2 = 3

// 読んだ保存の文字列（使う欄は方式ごと — Argon2id: m t p・bcrypt: cost・PBKDF2: iters）
type storedHash struct {
    alg int
    m int
    t int
    p int
    cost int
    iters int
    salt []byte
    hash []byte
}

func argon2Ok(m int, t int, p int) bool {
    return p >= 1 && p < 0x1000000 && t >= 1 && t <= m32 && m >= 8 * p && m <= m32
}

// bcrypt に渡せる pw か（72 バイト以下で NUL を含まない）。NUL の有無は拒否の答えとして外に出る 1 bit なので、数えた結果を公開に落としてから判定する
@secret(b)
func bcryptPwOk(b []byte) bool {
    if len(b) > 72 {
        return false
    }
    mut z := 0
    for i <- iter.Range(0, len(b)) {
        z = z | ^crypto.NonZero(int(b[i]))
    }
    return bless.Int(z) == 0
}

// 標準の字母の base64（詰め物の = を書かない — PHC 文字列の綴り）
func b64(b []byte) string {
    return strings.TrimSuffix(strings.TrimSuffix(base64.Encode(b), "="), "=")
}

// b64 の逆（字母の外の文字・長さ 4k + 1 なら ok = false）
func unb64(s string) ([]byte, bool) {
    sb := bytes(s)
    n := len(sb)
    if n % 4 == 1 {
        return []byte{}, false
    }
    for i <- iter.Range(0, n) {
        c := int(sb[i])
        if !((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 43 || c == 47) {
            return []byte{}, false
        }
    }
    pad := if n % 4 == 2 { "==" } else if n % 4 == 3 { "=" } else { "" }
    d, e := base64.Decode("${s}${pad}")
    if e != nil {
        return []byte{}, false
    }
    return d, true
}

// 10 進の非負の整数（先頭の 0 なし・2^32 未満 — PHC の欄の値）
func phcInt(s string) (int, bool) {
    sb := bytes(s)
    if len(sb) == 0 || len(sb) > 10 || (len(sb) > 1 && sb[0] == byte(48)) {
        return 0, false
    }
    mut v := 0
    for i <- iter.Range(0, len(sb)) {
        c := int(sb[i])
        if c < 48 || c > 57 {
            return 0, false
        }
        v = v * 10 + (c - 48)
    }
    if v > m32 {
        return 0, false
    }
    return v, true
}

// "k=値" の値（k が違えば ok = false）
func phcField(s string, k string) (int, bool) {
    name, val, found := strings.Cut(s, "=")
    if !found || name != k {
        return 0, false
    }
    return phcInt(val)
}

func noStored() (storedHash, bool) {
    return storedHash{alg: 0, m: 0, t: 0, p: 0, cost: 0, iters: 0, salt: []byte{}, hash: []byte{}}, false
}

// 保存の文字列を方式ごとに読む
func parseStored(stored string) (storedHash, bool) {
    f := strings.Split(stored, "$")
    if len(f) < 4 || f[0] != "" {
        return noStored()
    }
    if f[1] == "argon2id" {
        return parseArgon2id(f)
    }
    if f[1] == "2a" || f[1] == "2b" || f[1] == "2y" {
        return parseBcrypt(f)
    }
    if f[1] == "pbkdf2-sha256" {
        return parsePbkdf2(f)
    }
    return noStored()
}

// $argon2id$v=19$m=…,t=…,p=…$塩$値
func parseArgon2id(f []string) (storedHash, bool) {
    if len(f) != 6 || f[2] != "v=19" {
        return noStored()
    }
    ps := strings.Split(f[3], ",")
    if len(ps) != 3 {
        return noStored()
    }
    m, ok1 := phcField(ps[0], "m")
    t, ok2 := phcField(ps[1], "t")
    p, ok3 := phcField(ps[2], "p")
    salt, ok4 := unb64(f[4])
    hash, ok5 := unb64(f[5])
    if !(ok1 && ok2 && ok3 && ok4 && ok5) || !argon2Ok(m, t, p) || len(salt) < 8 || len(hash) < 4 {
        return noStored()
    }
    return storedHash{alg: algArgon2id, m: m, t: t, p: p, cost: 0, iters: 0, salt: salt, hash: hash}, true
}

// $2b$費用$塩（22 文字）と値（31 文字）
func parseBcrypt(f []string) (storedHash, bool) {
    if len(f) != 4 || len(bytes(f[2])) != 2 {
        return noStored()
    }
    cost, ok1 := phcInt(strings.TrimPrefix(f[2], "0"))
    sh := bytes(f[3])
    if !ok1 || cost < 4 || cost > 31 || len(sh) != 53 {
        return noStored()
    }
    salt, ok2 := bcryptDecode(sh[0:22])
    hash, ok3 := bcryptDecode(sh[22:53])
    if !ok2 || !ok3 {
        return noStored()
    }
    return storedHash{alg: algBcrypt, m: 0, t: 0, p: 0, cost: cost, iters: 0, salt: salt, hash: hash}, true
}

// $pbkdf2-sha256$i=…,l=…$塩$値（l = 値のバイト数）
func parsePbkdf2(f []string) (storedHash, bool) {
    if len(f) != 5 {
        return noStored()
    }
    ps := strings.Split(f[2], ",")
    if len(ps) != 2 {
        return noStored()
    }
    iters, ok1 := phcField(ps[0], "i")
    l, ok2 := phcField(ps[1], "l")
    salt, ok3 := unb64(f[3])
    hash, ok4 := unb64(f[4])
    if !(ok1 && ok2 && ok3 && ok4) || iters < 1 || len(hash) != l || l < 1 || len(salt) < 8 {
        return noStored()
    }
    return storedHash{alg: algPbkdf2, m: 0, t: 0, p: 0, cost: 0, iters: iters, salt: salt, hash: hash}, true
}
