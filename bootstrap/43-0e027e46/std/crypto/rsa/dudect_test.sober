package rsa

// dudect の題材（white-box: 非公開の sel を直に呼ぶ。scripts/dudect.sh が DUDECT_PKGS に std/crypto/rsa を足して回す）。
// 窓の表引き（expMont の秘密の窓の値 idx）を、クラス 0 = idx が 0〜7・クラス 1 = idx が 8〜15 の性質の差で検定する（両クラスとも毎回違う値 —
// 固定の入力を繰り返す形は Zen 3 / 4 で偽の漏れを出す）。TestRsaSignPSS（std/internal/dudect）は平文を変える形で、指数の窓は動かない。
// 環境変数 SOBER_DUDECT が無ければ何もしない（unittest では測らずに通る）

import "std/internal/dudect"
import "std/iter"

func TestSelIdx() {
    n := dudect.Count()
    if n == 0 {
        return
    }
    nl := 16
    l := nl + 1
    // 区画: 0〜15 = 表・16 = 選びの先
    mut t := mut []int{}
    mut x := 12345
    for i <- iter.Range(0, 17 * l) {
        x = x * 6364136223846793005 + 1442695040888963407
        t = append(t, x)
    }
    blk := freeze(t)
    wa := addrn(blk)
    dudect.Measure("rsa_sel_idx", n, 12, (c, i) => {
        []byte{byte(8 * c + ((i * 5 + 3) % 8))}
    }, (b) => {
        mut w := leaseView(blk, 0, 17 * l)
        sel(mut w, wa, 16 * l, 0, int(b[0]), nl, l, 16)
        (w[16 * l] & 1) == 1
    })
}

// 2 乗の塊（montSqr — 窓の 2 乗は秘密の値に掛かる）を、クラス 0 = 上半分の語が 0 の小さい値・クラス 1 = 全部の語が乱数の値で検定する（両クラスとも毎回違う値）
func TestMontSqrVal() {
    n := dudect.Count()
    if n == 0 {
        return
    }
    nl := 16
    l := nl + 1
    mut m := mut []int{}
    mut x := 777
    for i <- iter.Range(0, nl) {
        x = x * 6364136223846793005 + 1442695040888963407
        m = append(m, x)
    }
    m[0] = m[0] | 1
    m[nl - 1] = m[nl - 1] | (1 << 63)
    mt := newMont(freeze(m))
    dudect.Measure("rsa_montsqr_val", n, 13, (c, i) => {
        mut b := mut []byte{}
        mut y := i * 2654435761 + 12345
        for k <- iter.Range(0, 8 * nl) {
            y = y * 6364136223846793005 + 1442695040888963407
            hiw := k / 8 >= nl / 2
            v := if c == 0 && hiw { 0 } else if k / 8 == nl - 1 { (y >> 33) & 0x7f } else { (y >> 33) & 0xff }
            b = append(b, byte(v))
        }
        freeze(b)
    }, (b) => {
        blk := zeros(2 * l)
        mut w := leaseView(blk, 0, 2 * l)
        wa := addrn(blk)
        for k <- iter.Range(0, nl) {
            mut v := 0
            for q <- iter.Range(0, 8) {
                v = v | (int(b[8 * k + q]) << (8 * q))
            }
            w[k] = v
        }
        montSqr(mut w, wa, l, 0, mt)
        (w[l] & 1) == 1
    })
}
