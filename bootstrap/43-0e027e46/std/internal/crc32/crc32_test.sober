package crc32

// Update の継ぎ足しの網: どこで割っても Update(Update(0, a), b) = Update(0, a ‖ b)（3 つの道〔PCLMULQDQ の畳み 64 B 以上・slicing-by-8 256 B 以上・1 バイトずつ〕を
// またぐ割り方 — 割った片が別の道に落ちる）と照合値

import "std/iter"

func TestUpdateCheck() {
    assert(Update(0, bytes("123456789")) == 0xcbf43926)
    assert(Update(0, []byte{}) == 0)
    assert(Update(Update(0, bytes("1234")), bytes("56789")) == 0xcbf43926)
}

func TestUpdateSplits() {
    mut b := mut []byte{}
    for i <- iter.Range(0, 3000) {
        b = append(b, byte((i * 131 + (i >> 3)) & 255))
    }
    d := freeze(b)
    whole := Update(0, d)
    ks := []int{0, 1, 7, 15, 16, 63, 64, 65, 255, 256, 257, 1000, 2999, 3000}
    for k <- ks {
        mut x := mut []byte{}
        mut y := mut []byte{}
        for i <- iter.Range(0, 3000) {
            if i < k {
                x = append(x, d[i])
            } else {
                y = append(y, d[i])
            }
        }
        assert(Update(Update(0, freeze(x)), freeze(y)) == whole)
    }
}
