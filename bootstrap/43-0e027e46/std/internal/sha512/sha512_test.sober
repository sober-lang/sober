package sha512

// SHA-512 / SHA-384 の網（white-box）: FIPS 180-4 の例（"abc"）と、Python の hashlib の値を長さの境目（詰めが 1 ブロック / 2 ブロック — 112・128 の前後）で固定した表

import "std/hex"
import "std/iter"

func pat(n int, k int) []byte {
    mut b := mut []byte{}
    for i <- iter.Range(0, n) {
        b = append(b, byte((i * 31 + k * 13 + 7) % 256))
    }
    return freeze(b)
}

func same(a []byte, h string) bool {
    w, _ := hex.Parse(h)
    if len(a) != len(w) {
        return false
    }
    mut d := 0
    for i <- iter.Range(0, len(a)) {
        d = d | (int(a[i]) ^ int(w[i]))
    }
    return d == 0
}

func TestAbc() {
    assert(same(Sum512(bytes("abc")), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"))
    assert(same(Sum384(bytes("abc")), "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"))
}

type Case struct {
    n int
    h512 string
    h384 string
}

func TestLengths() {
    cs := []Case{
        Case{n: 0, h512: "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e", h384: "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b"},
        Case{n: 1, h512: "0b61241d7c17bcbb1baee7094d14b7c451efecc7ffcbd92598a0f13d313cc9ebc2a07e61f007baf58fbf94ff9a8695bdd5cae7ce03bbf1e94e93613a00f25f21", h384: "7582368259da8769965446762440c16e3ff4d09dd3bc0e9073a2b4e3d7d87d672c6de61faa09b2795d33da3264b05bcc"},
        Case{n: 3, h512: "5434d44a8fd6ead9d5b917d93d9f8572cdf6335a920bda8e36ae4a45f4a7b8704577b4f9379cc2b9c3c0425c429b5800b60635870e5fd021d63c3bc8c448670a", h384: "8f05f2451e2fe21f72e3cfb00537f9fcfb5fa53cd6985170d0103d368528be2abc06bd7fad8937400aaf421f3b5c8929"},
        Case{n: 111, h512: "dce90639f314f026a6d1121ec0f23dcd600080d95928b31e330905f8fd8036e947ab979d36a01d0cc5a303cbe7cfa83b9139eaabccbeba98649e8ff2b6bbeaaf", h384: "7f620febca0f65b13c470706b97428b0bf6a098a53c3a16436a3833ced4b934f1bd0484ec4bcb3404b2b906a647ebeb3"},
        Case{n: 112, h512: "ca6c219f81cd90e2a8eb512458c22649183418caae7a25bd77179e566cad8c3b821aeae776d654a37e9a6f561849b53c9a978bb49920f14f68c33e6f33fa7cd8", h384: "88d4693512aa3239967fa628863b1941d33e6f4fa32e2a7c55345b41fad16ac960223848aa2612a0b5321d95801107dc"},
        Case{n: 113, h512: "b93d9475cb6c584e81e572c503bf300ec9d014539b9fc3679106510328362be62ec8ea53a6b642f88dda912101f4526f6aaff668f2f1a835101231894deaea6d", h384: "a63988b6dc3913f91c63c45b2e48acdc445d19c0fc0b84a7576c7d0a894277f71c4200997ca7f6ca03efd5aef21809ba"},
        Case{n: 127, h512: "ba885ccfbe76c8c94c68e33be70de3db24e313e6e5b0b53f417145aad6a8842ec3598475ece7f776fbcdd8f0ea799ee5e4d889700151048b6343224a7d6cb331", h384: "a8d2723f79dc2f1276a7f13b5ee75082127b16c890d4f2c84a0756f7157d9e2a3d3484d2fab32183f2832473f6497ba3"},
        Case{n: 128, h512: "a799606cc933a3b9b7f024719495cb50dceb7fa25a85f107208f77048125a49379f315c1ec2c063f83d7be896967e6cba819b41637eda8efd19f0b6d4a6c75d9", h384: "e78ced03aa08137bb8a7a402839e3b51e572903ddbd7f98b629e414d762a15e70b1cb759ed4a76ff77f027440e10f94a"},
        Case{n: 129, h512: "581f92f28ae2cd6da6cefcf2b17da0f60dc4319f434e38213a130dd2f010177e9a076672aa1933e7fbd9b173515124cb01804a62d8684acba1c92b98daccd01a", h384: "7fa494f8b49714500530589500c1b080e491a6593f2e3518e8132927149c192b964ed3bcc28639f92f6c0326a609e3a7"},
        Case{n: 239, h512: "a9c4b441cf6c2e3b34dbec68a75925eaff7d046d8829191fc21f7a981d5f478cb21a73b74257fba65070faef394250d0f87061aec29dc8a5934552c5cf8b39f6", h384: "7f408329041a45cf7cef379a63441226785c552616385f8ccfc64732a43fe0a442172b36f68e339b164c215b3b215b37"},
        Case{n: 240, h512: "88fc192414f67f5a0efdaccb746df65471005ac73ffdef62d27eef3328312ae722ae5268119f82da8d68918b76bcbf0c5b29f5fb8628cd05e1dc217340fac8d9", h384: "c9c21efbd718f77ba11ecbcf6d6b198db3e5e47a3f2dfbdcf4246fe7f0a8ec971f73dd55e19b1774f27c5b08253c3646"},
        Case{n: 255, h512: "6b794e953e5eb357b6ef90283ae62fad0bd40a0020c18d536e27847c7dbbfdf61d0fe649886c03c5b168bfde802f079c2d42677149e7ae0eb468c3132c4f93e1", h384: "2f7293b4c18091aabbec8eb9b1f8aac701c5fd9dd43a490dac140046f5f141ae751ee8c42447f5b3d66a5e634137a1b2"},
        Case{n: 256, h512: "ba565e529b5f508db62da9d7daa860c75b9f2034f832ba569447b07d0024d53aa80b16e9d550d53cdd437500714061c8520c15196ce6875e46062d3018a75941", h384: "ae7f72770dcbc32504c561fcbc691d8f1c4a71469c3c93a70b6dad7aa55eb012bb78912e115623641c8941a5ca770e74"},
        Case{n: 1000, h512: "4e80c553685668b045732cbe05463288d4307654129aaa3ad31ff777ae1d7ea343ce950d6bce5037436f1e91919420335fffd05d4902d36550f1dee6b2546a8a", h384: "218293c3434bcd84845b60479fceefe273fbf727a5db425500c6ce95e0771d85fe61b2740b35e65063511b60f3e93b0b"},
    }
    for c <- cs {
        assert(same(Sum512(pat(c.n, 3)), c.h512))
        assert(same(Sum384(pat(c.n, 3)), c.h384))
    }
}
