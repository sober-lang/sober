package x509

// 証明書の時刻（RFC 5280 4.1.2.5 — UTCTime `YYMMDDHHMMSSZ`〔YY < 50 は 20YY〕・GeneralizedTime `YYYYMMDDHHMMSSZ`。秒は必須・Z だけ・小数秒なし）→ UNIX 秒

func timeOf(b []byte, e El) (int, bool) {
    s := b[e.cs:e.ce]
    n := len(s)
    if e.tag == 0x17 && n == 13 {
        yy := dig2(s, 0)
        if yy < 0 {
            return 0, false
        }
        return civil(if yy < 50 { 2000 + yy } else { 1900 + yy }, s, 2)
    }
    if e.tag == 0x18 && n == 15 {
        y1 := dig2(s, 0)
        y2 := dig2(s, 2)
        if y1 < 0 || y2 < 0 {
            return 0, false
        }
        return civil(100 * y1 + y2, s, 4)
    }
    return 0, false
}

// s[i:i+2] の 10 進 2 桁（数字でなければ -1）
func dig2(s []byte, i int) int {
    a := int(s[i]) - 48
    b := int(s[i + 1]) - 48
    if a < 0 || a > 9 || b < 0 || b > 9 {
        return -1
    }
    return 10 * a + b
}

// 年 y と s[i:] の MMDDHHMMSSZ の UNIX 秒（暦日の日数 — 1970-01-01 起点の先発グレゴリオ暦）
func civil(y int, s []byte, i int) (int, bool) {
    mo := dig2(s, i)
    d := dig2(s, i + 2)
    h := dig2(s, i + 4)
    mi := dig2(s, i + 6)
    se := dig2(s, i + 8)
    if s[i + 10] != byte(90) || mo < 1 || mo > 12 || d < 1 || d > mdays(y, mo) || h < 0 || h > 23 || mi < 0 || mi > 59 || se < 0 || se > 59 {
        return 0, false
    }
    yy := if mo <= 2 { y - 1 } else { y }
    era := yy / 400
    yoe := yy - era * 400
    mp := if mo > 2 { mo - 3 } else { mo + 9 }
    doy := (153 * mp + 2) / 5 + d - 1
    doe := yoe * 365 + yoe / 4 - yoe / 100 + doy
    days := era * 146097 + doe - 719468
    return days * 86400 + h * 3600 + mi * 60 + se, true
}

func mdays(y int, m int) int {
    if m == 2 {
        leap := (y % 4 == 0 && y % 100 != 0) || y % 400 == 0
        return if leap { 29 } else { 28 }
    }
    return if m == 4 || m == 6 || m == 9 || m == 11 { 30 } else { 31 }
}
