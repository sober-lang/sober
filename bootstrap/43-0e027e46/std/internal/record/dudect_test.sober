package record

// dudect の題材（white-box: 非公開の strip を直に呼ぶ。scripts/dudect.sh が DUDECT_PKGS に std/internal/record を足して回す）。
// 内側の平文の 0 埋めの剥がし（末尾 256 バイトの窓 — 0 埋めの長さは秘密）を、クラス 0 = 0 埋め 0〜31 バイト・クラス 1 = 200〜231 バイトの性質の差で
// 検定する（どちらも窓の中・本文と長さは毎回違う値 — 固定の入力を繰り返す形は Zen 3 / 4 で偽の漏れを出す）。
// 環境変数 SOBER_DUDECT が無ければ何もしない（unittest では測らずに通る）

import "std/internal/dudect"
import "std/iter"

func TestStripPad() {
    n := dudect.Count()
    if n == 0 {
        return
    }
    dudect.Measure("record_strip_pad", n, 14, (c, i) => {
        mut b := mut []byte{}
        mut y := i * 2654435761 + 4242
        pad := 200 * c + ((i * 7 + 3) % 32)
        body := 511 - pad
        for k <- iter.Range(0, body) {
            y = y * 6364136223846793005 + 1442695040888963407
            b = append(b, byte((y >> 33) & 0xff))
        }
        b = append(b, byte(CtApp))
        for k <- iter.Range(0, pad) {
            b = append(b, 0)
        }
        freeze(b)
    }, (b) => {
        ct, _ := strip(b)
        ct == CtApp
    })
}
