package lower

// ヘッダのループ昇格: GVN と hdr の後の SSA に掛ける。関数の ptr の仮引数 P（mut slice の仮引数は
// 呼び手のセルの番地）について、ループの中の P のメモリの読み書きが全部 `load P[k]` / `store P[k], v`（k は定数の語）で、ほかの読み書きと
// 呼び出しが P のセルと重ならないと言えるなら、語ごとに 1 語のスロットへ付け替えて前置きで読み込み・ループの出口の辺で書き戻し、その場で
// mem2reg が SSA にする（mut slice の仮引数へループで append する形 — jsonapi の zeroFill はヘッダ 3 語を毎周 load / store していた）。
// 重ならないと言える番地（別名の事実 — 番地の根の出どころで言う。mut の単一書き手の前提には依らない）:
//   ① 確保した番地: region.alloc の結果・確保する rt（rt.region_alloc / rt.region_alloc8 / rt.slice_grow / rt.slice_grow8）の結果とその gep
//      （確保したばかりのセルは関数の入口で既にあった P の指す先に属さない）
//   ② rt の大域・ワーカーの表（globaladdr / fsaddr）とスロット（この関数の局所 — 呼び手のセルを指す P とは別）
//   ③ P 自身のデータ（`itop(load P[0])` から gep した番地 — slice は自分自身を要素に含められないので、P のデータの中に P のヘッダは無い）
// ループの中で許す呼び出しは rt.slice_grow / rt.slice_grow8（ヘッダの値を引数で受け、古い列のデータを読んで新しい列と rt の表を書く —
// P のセルは読み書きしない）と戻らない rt.panic だけ。region の op（enter / depth / setdepth / bump / alloc）は rt の状態だけを触る。
// 諦める形: ほかの呼び出し・syscall・relocate・原子の op・罠・番地の根が分からない読み書き・P から gep した番地・ほかの仮引数の直の読み書き
// （2 つの仮引数が同じセルを指しうるかは言わない）・ループの中の ret
// 出口: ループの中のブロックから外へ出る辺ごとに書き戻しのブロックを挟む（行き先が exit〔panic の点〕の辺は飛ばす — 死んだ task のメモリは
// 誰も観測しない）。前置きの読み込みはループが 1 周もしなくても安全（P は仮引数 — 常に読める）

import "desugar"
import "std/iter"

// モジュールの全関数にヘッダのループ昇格を掛ける
func hloopModule(st mut St) {
    mut f := st.fhead
    while f != -1 {
        if irFnBHead(mut st, f) != -1 {
            hloopFunc(mut st, f)
        }
        f = irFnNext(mut st, f)
    }
}

// 関数 f のループにヘッダの昇格を掛ける（先に安い走査で対象を絞る — ループがあり、仮引数へ直に書く store がある関数だけ）
func hloopFunc(st mut St, f FnRef) {
    if !hlCheap(mut st, f) {
        return
    }
    saved := st.fn
    st.fn = f
    mut round := 0
    while round < 4 && hlRound(mut st, f) {
        round += 1
    }
    if round > 0 {
        recountPreds(mut st, f)
        m2rFunc(mut st, f)
        prClean(mut st, f)
    }
    st.fn = saved
}

// 利用者のループの頭があり、入口の仮引数へ直に書く store がある関数か（作業域を作らない走査）
func hlCheap(st mut St, f FnRef) bool {
    mut loop := false
    mut b := irFnBHead(mut st, f)
    while b != -1 && !loop {
        if irBlkLoop(mut st, b) & 1 == 1 {
            loop = true
        }
        b = irBlkNext(mut st, b)
    }
    if !loop {
        return false
    }
    b = irFnBHead(mut st, f)
    while b != -1 {
        mut i := irBlkIHead(mut st, b)
        while i != -1 {
            if irInsOp(mut st, i) == OpStore && hlIsParam(mut st, f, irInsA(mut st, i)) {
                return true
            }
            i = irInsNext(mut st, i)
        }
        b = irBlkNext(mut st, b)
    }
    return false
}

// 値 v が関数の ptr の仮引数か（関数の仮引数は値の番号 0 .. np − 1）
func hlIsParam(st mut St, f FnRef, v int) bool {
    pt := irFnPtys(mut st, f)
    np := desugar.HeapGet(mut st.d, pt)
    return v >= 0 && v < np && desugar.HeapGet(mut st.d, pt + 1 + v) == TyPtr
}

// 仮引数 v が mut の印のある ptr 仮引数（mut slice の仮引数 — 呼び手のヘッダのセル）か。印の無い ptr 仮引数（rt の補助・sret）は
// 別の slice のデータの中を指しうるので昇格しない（hdr.sober の資格の印と同じ門）
func hlMut(st mut St, f FnRef, v int) bool {
    return v < 62 && (irFnMutP(mut st, f) >> v) & 1 == 1
}

// ループを 1 つ昇格したら true（CFG が変わるので呼び手が組み直して次へ）
func hlRound(st mut St, f FnRef) bool {
    nb := irFnNBlk(mut st, f)
    nv := irFnNVal(mut st, f)
    mut w := m2rW{nb: nb, blk: mut []int{}, rpoIx: mut []int{}, rpo: mut []int{}, nrpo: 0, pcnt: mut []int{}, preds: mut []int{}, idom: mut []int{}}
    m2rCfg(mut st, mut w, f)
    // 値 → 定義の命令（-1 = 命令でない）・値 → 定義のブロック番号（ブロックの仮引数も — 関数の仮引数は入口 = 0）
    mut pw := PrW{def: mut []int{}, dblk: mut []int{}, inl: mut []int{}, mark: 0}
    xFill(mut pw.def, nv, -1)
    xFill(mut pw.dblk, nv, 0)
    xFill(mut pw.inl, nb, 0)
    for bi <- iter.Range(0, nb) {
        b := BlkRef(w.blk[bi])
        if int(b) >= 0 {
            mut p := irBlkPHead(mut st, b)
            while p >= 0 {
                pv := desugar.HeapGet(mut st.d, p + 1)
                pw.dblk[pv] = bi
                p = desugar.HeapGet(mut st.d, p)
            }
            mut ins := irBlkIHead(mut st, b)
            while ins != -1 {
                r := irInsRes(mut st, ins)
                if r >= 0 {
                    pw.def[r] = int(ins)
                    pw.dblk[r] = bi
                }
                ins = irInsNext(mut st, ins)
            }
        }
    }
    mut k := w.nrpo
    while k > 0 {
        k -= 1
        h := w.rpo[k]
        pre := loopPre(mut st, mut w, h)
        if pre >= 0 {
            pw.mark += 1
            loopMark(mut w, mut pw.inl, pw.mark, h)
            if hlLoop(mut st, f, mut w, mut pw, pre) {
                return true
            }
        }
    }
    return false
}

// ループ（印 pw.mark・前置き pre）の中の読み書きを調べ、昇格できる仮引数があれば書き換えて true
func hlLoop(st mut St, f FnRef, w mut m2rW, pw mut PrW, pre int) bool {
    // 直に読み書きされる仮引数 P（最初に見つかった 1 つ — ほかの仮引数の直の読み書きがあれば諦める）と、その命令・語
    mut p0 := -1
    mut pIns := mut []int{}
    mut pK := mut []int{}
    mut pSt := mut []int{}
    mut anySt := false
    // 番地の根を P との関係で後から判定する読み書き（P が決まってから見る）
    mut rest := mut []int{}
    for bi <- iter.Range(0, w.nb) {
        if pw.inl[bi] != pw.mark || w.blk[bi] < 0 {
            continue
        }
        b := BlkRef(w.blk[bi])
        t := irBlkTerm(mut st, b)
        if t != TmBr && t != TmCondbr && t != TmExit {
            return false
        }
        mut ins := irBlkIHead(mut st, b)
        while ins != -1 {
            op := irInsOp(mut st, ins)
            if op == OpLoad || op == OpStore || op == OpLoad8 || op == OpStore8 {
                a := irInsA(mut st, ins)
                if hlIsParam(mut st, f, a) {
                    if op == OpLoad8 || op == OpStore8 || (op == OpLoad && irInsC(mut st, ins) != 0) {
                        return false
                    }
                    if p0 == -1 {
                        p0 = a
                    } else if p0 != a {
                        return false
                    }
                    pIns = append(pIns, int(ins))
                    pK = append(pK, irInsB(mut st, ins))
                    pSt = append(pSt, if op == OpStore { 1 } else { 0 })
                    if op == OpStore {
                        anySt = true
                    }
                } else {
                    rest = append(rest, a)
                }
            } else if op == OpCall {
                g := irInsFn(mut st, ins)
                if g != st.rtGrow && g != st.rtGrow8 && g != st.rtPanic && g != st.rtPanicMem {
                    return false
                }
            } else if !(prQuiet(op) || op == OpREnter || op == OpRSetDepth || op == OpRBump || op == OpRAlloc) {
                return false
            }
            ins = irInsNext(mut st, ins)
        }
    }
    if p0 == -1 || !anySt || !hlMut(mut st, f, p0) {
        return false
    }
    for q <- iter.Range(0, len(rest)) {
        if !hlSafe(mut st, f, mut w, mut pw, rest[q], p0) {
            return false
        }
    }
    hlRewrite(mut st, f, mut w, mut pw, pre, p0, freeze(pIns), freeze(pK), freeze(pSt))
    return true
}

// 番地 v（の根）が仮引数 P のセルと重ならないと言えるか（別名の事実 ①〜③ — ファイルの冒頭）。gep は基底へ辿り、ブロックの仮引数は
// 入りの実引数を全部見る（辿る値は 16 本まで）。再帰でなく作業列で回す（mut 引数の関数の再帰は自己 check の def error — NOTES の地雷）
func hlSafe(st mut St, f FnRef, w mut m2rW, pw mut PrW, v0 int, p int) bool {
    mut todo := mut []int{}
    todo = append(todo, v0)
    mut q := 0
    while q < len(todo) {
        v := todo[q]
        q += 1
        if q > 16 || v < 0 || v >= len(pw.def) {
            return false
        }
        d := pw.def[v]
        if d >= 0 {
            i := InsRef(d)
            op := irInsOp(mut st, i)
            if op == OpGepW || op == OpGepB {
                todo = append(todo, irInsA(mut st, i))
            } else if op == OpCall {
                g := irInsFn(mut st, i)
                if g != st.rtGrow && g != st.rtGrow8 && g != st.rtRalloc && g != st.rtAlloc8 {
                    return false
                }
            } else if op == OpItop {
                x := irInsA(mut st, i)
                dx := if x >= 0 && x < len(pw.def) { pw.def[x] } else { -1 }
                if !(dx >= 0 && irInsOp(mut st, InsRef(dx)) == OpLoad && irInsA(mut st, InsRef(dx)) == p && irInsB(mut st, InsRef(dx)) == 0) {
                    return false
                }
            } else if !(op == OpRAlloc || op == OpSlotaddr || op == OpGlobal || op == OpFsAddr) {
                return false
            }
        } else {
            // 命令でない値 = 関数の仮引数（値の番号 0 .. np − 1 — 諦める）かブロックの仮引数（定義のブロック）
            if v < desugar.HeapGet(mut st.d, irFnPtys(mut st, f)) {
                return false
            }
            bi := pw.dblk[v]
            // 仮引数の番目 → 行き先が bi の辺の実引数を全部
            tb := BlkRef(w.blk[bi])
            mut n := 0
            mut pp := irBlkPHead(mut st, tb)
            while pp >= 0 && desugar.HeapGet(mut st.d, pp + 1) != v {
                n += 1
                pp = desugar.HeapGet(mut st.d, pp)
            }
            mut seen := false
            for b2 <- iter.Range(0, w.nb) {
                if w.blk[b2] >= 0 {
                    b := BlkRef(w.blk[b2])
                    t := irBlkTerm(mut st, b)
                    for e <- iter.Range(0, if t == TmBr { 1 } else if t == TmCondbr { 2 } else { 0 }) {
                        to := if t == TmBr { irBrTo(mut st, b) } else if e == 0 { irCondThen(mut st, b) } else { irCondElse(mut st, b) }
                        if to == tb {
                            args := if t == TmBr { irBlkX2(mut st, b) } else if e == 0 { irBlkX3(mut st, b) } else { irBlkX5(mut st, b) }
                            todo = append(todo, latI(mut st, desugar.ListRef(args), n))
                            seen = true
                        }
                    }
                }
            }
            if !seen {
                return false
            }
        }
    }
    return true
}

// P の語ごとにスロットを作り、前置きで読み込み・ループの中の P[k] の読み書きをスロットへ・出口の辺で書き戻す（書きのある語だけ）
func hlRewrite(st mut St, f FnRef, w mut m2rW, pw mut PrW, pre int, p int, pIns []int, pK []int, pSt []int) {
    // 語の一覧（出現の順）と書きの有無
    mut ks := mut []int{}
    mut kw := mut []int{}
    for a <- iter.Range(0, len(pK)) {
        mut seen := -1
        for g <- iter.Range(0, len(ks)) {
            if ks[g] == pK[a] {
                seen = g
            }
        }
        if seen < 0 {
            ks = append(ks, pK[a])
            kw = append(kw, pSt[a])
        } else if pSt[a] == 1 {
            kw[seen] = 1
        }
    }
    pbk := BlkRef(w.blk[pre])
    mut sa := mut []int{}
    for g <- iter.Range(0, len(ks)) {
        sroaNewSlot(mut st, f)
        s := newValueIn(mut st, f)
        linkInst(mut st, pbk, mkInst(mut st, s, OpSlotaddr, irFnNSlot(mut st, f) - 1, 0, 0))
        sa = append(sa, s)
        v := newValueIn(mut st, f)
        linkInst(mut st, pbk, mkInst(mut st, v, OpLoad, p, ks[g], 0))
        linkInst(mut st, pbk, mkInst(mut st, -1, OpStore, s, 0, v))
    }
    for a <- iter.Range(0, len(pIns)) {
        for g <- iter.Range(0, len(ks)) {
            if pK[a] == ks[g] {
                irSetInsA(mut st, InsRef(pIns[a]), sa[g])
                irSetInsB(mut st, InsRef(pIns[a]), 0)
            }
        }
    }
    for bi <- iter.Range(0, w.nb) {
        if pw.inl[bi] != pw.mark || w.blk[bi] < 0 {
            continue
        }
        b := BlkRef(w.blk[bi])
        t := irBlkTerm(mut st, b)
        for e <- iter.Range(0, if t == TmBr { 1 } else if t == TmCondbr { 2 } else { 0 }) {
            to := if t == TmBr { irBrTo(mut st, b) } else if e == 0 { irCondThen(mut st, b) } else { irCondElse(mut st, b) }
            if irBlkId(mut st, to) >= w.nb || pw.inl[irBlkId(mut st, to)] == pw.mark || irBlkTerm(mut st, to) == TmExit {
                continue
            }
            args := if t == TmBr { irBlkX2(mut st, b) } else if e == 0 { irBlkX3(mut st, b) } else { irBlkX5(mut st, b) }
            wb := newBlock(mut st)
            for g <- iter.Range(0, len(ks)) {
                if kw[g] == 1 {
                    v := newValueIn(mut st, f)
                    linkInst(mut st, wb, mkInst(mut st, v, OpLoad, sa[g], 0, 0))
                    linkInst(mut st, wb, mkInst(mut st, -1, OpStore, p, ks[g], v))
                }
            }
            prBr(mut st, wb, to, args)
            if t == TmBr {
                irSetBlkX1(mut st, b, int(wb))
                irSetBlkX2(mut st, b, -1)
            } else if e == 0 {
                irSetCondThen(mut st, b, wb)
                irSetBlkX3(mut st, b, -1)
            } else {
                irSetCondElse(mut st, b, wb)
                irSetBlkX5(mut st, b, -1)
            }
        }
    }
}
