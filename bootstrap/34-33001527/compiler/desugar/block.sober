package desugar

// block 効果の導出（language.md 12 節 — 今の消費者は analyzer の lease の窓の性能 lint だけ: 窓の中で待つと同じワーカーの別の task が
// 同じ置き場を借りに来て倒れうる。region-domain-pool.md 4d 節）。葉 = std/par の待つ関数（Scope・Join・Try・Send・Recv）と、待つ rt の口
// （@intrinsic の sleep・wait_fd・net_op・read_fd）を本体から直に呼ぶ関数。印は呼び先 → 呼び手へ伝わる。
// 近似: 呼び出しは字面の関数名だけ（関数値の呼び出しは見えない — 伝えない）・本体の字句の範囲で呼び手を引くので、本体の中で spawn する子の
// ラムダの待ちも呼び手に数える（保守側 — lint なので偽陽性は「倒れうる」の言い過ぎで済む）

import "ast"
import "loader"
import "std/iter"

// MayBlock は関数表の添字ごとの印（1 = 待ちに入りうる）
func MayBlock(st mut S) []int {
    mut mark := mut []int{}
    for i <- iter.Range(0, st.nfn) {
        k := ParKey(mut st, i)
        mark = append(mark, if k == PAR_SCOPE || k == PAR_JOIN || k == PAR_TRY || k == PAR_SEND || k == PAR_RECV { 1 } else { 0 })
    }
    // 辺 [呼び手, 呼び先]（呼び手が関数の外の呼び出しは要らない）
    mut edges := mut []int{}
    for f <- iter.Range(0, st.nfile) {
        t := st.trees[f]
        pk := FilePkg(mut st, f)
        mut rs := mut []int{}
        for i <- iter.Range(0, st.nfn) {
            nd := fnNode(mut st, i)
            if fileOf(mut st, nd) == f {
                ext := nodeOf(mut st, nd).f
                if ext >= 0 {
                    rs = append(rs, i)
                    rs = append(rs, latI(mut st, ListRef(ext), 1))
                    rs = append(rs, latI(mut st, ListRef(ext), 2))
                }
            }
        }
        rr := freeze(rs)
        for n <- iter.Range(0, len(t.nodes)) {
            k := t.nodes[n].kind
            if k == ast.ECall || k == ast.EPipe {
                caller := rangeOf(rr, t.nodes[n].tok)
                if caller >= 0 {
                    x := nodeOf(mut st, NodeRef(ABASE + f * FW + n))
                    callee := if k == ast.ECall { NodeRef(x.a) } else { NodeRef(x.b) }
                    ci := e2sCallee(mut st, pk, callee)
                    if ci >= 0 {
                        edges = append(edges, caller)
                        edges = append(edges, ci)
                    } else if kindN(mut st, callee) == ast.EIdent && blockKey(SysKey(mut st, pk, sA(nodeOf(mut st, callee)))) {
                        mark[caller] = 1
                    }
                }
            }
        }
    }
    mut changed := true
    while changed {
        changed = false
        for e <- iter.Range(0, len(edges) / 2) {
            if mark[edges[e * 2 + 1]] == 1 && mark[edges[e * 2]] == 0 {
                mark[edges[e * 2]] = 1
                changed = true
            }
        }
    }
    return freeze(mark)
}

// blockKey は @intrinsic の鍵の番号 code が待つ rt の口か
func blockKey(code int) bool {
    return code == loader.ISleep || code == loader.IWaitFd || code == loader.INetOp || code == loader.IReadFd
}
