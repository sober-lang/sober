package desugar

// 開いたファイル io.File の使い方の検査（IO 便 段 2 — language.md 28 節「資源とストリーム」・裁定 Q1 (A) / Q2 / 3.3 (i) — report-601 / 603 / 604）。
// File はコアでは封のデータ（fd 1 語）で、同一性は表層のこの規則が持つ。check と build が同じ層（ParCheck / ParCheckTyped — 表層型つき）:
// - 開く: `f := io.Open(path)?` か `f := io.Open(path) catch D`（loader の catchx が `$ctKv, $ctKe := io.Open(path)` + `f := if … else { $ctKv }` に写した形）。
//   直後の文は `defer io.Close(f)`（30 節の acquire / release の局所照合 R-a の形の移植 — 間に脱出が挟まる漏れが形で起きない）。
//   Open はこの束縛の形の外に書けず、Close はこの defer の形の外に書けない
// - 許す使い方: io の口・利用者の関数の実引数（受けた仮引数も同じ規則の下 — 外へは出せない）
// - 拒否: 写しの束縛・代入・return と File を持つ値を返す呼び出し・composite（struct / slice / map — 型が File を持つリテラル）・append・閉包の捕獲・
//   give:（scope の本体で開いた File を子へ渡すと、本体の defer Close が子の合流より先に走る — 子は path から自分で開く）
// io.Open を書かないプログラムでは走らない（File の値はほかに作れない — compiler 自身は書かないので自己 build の仕事は増えない）

import "ast"
import "diag"
import "std/iter"

// 指摘の種類（diag.FileUse の kind — 文面は diag.sober）
const FC_OPEN = 1      // 規則の形の外の Open
const FC_UNCLOSED = 2  // 直後の文が defer io.Close でない
const FC_CLOSE = 3     // 規則の形の外の Close
const FC_DEFER = 4     // 直後の defer が別の名前を閉じている
const FC_COPY = 5      // 写しの束縛
const FC_ASSIGN = 6    // 代入
const FC_ESCAPE = 7    // return / File を持つ値を返す呼び出し
const FC_HOLD = 8      // composite・append に入れる
const FC_CAPTURE = 9   // 閉包の捕獲
const FC_GIVE = 10     // give:
const FC_BORROW = 11   // 借りの関数値を呼ぶ・借りの位置へ渡す以外に使った（(α-L0)）

// fcFn は呼び出し先の節 callee が std/io の Open（1）・Close（2）か（違えば 0）
func fcFn(st mut S, callee NodeRef) int {
    k := kindN(mut st, callee)
    if k != ast.EIdent && k != ast.ESelector {
        return 0
    }
    fk := findFn(mut st, callee, -1)
    if fk < 0 || !strIs(mut st, PkgPath(mut st, fnPkg(mut st, fk)), "std/io") {
        return 0
    }
    nm := fnName(mut st, fk)
    return if strIs(mut st, nm, "Open") { 1 } else if strIs(mut st, nm, "Close") { 2 } else { 0 }
}

// fcIsFile は表層型 y が同一性を持つ資源の型か — std/io の File と std/net の Listener / Conn（net 段 4a-1 — 28 節の net）・std/tls の Conn（TLS 便 R4 — 28 節。
// net の 2 つは for の束縛でだけ生まれ Close の口を持たないので、Open / Close の対の照合は File だけ — 写し・持ち出し・捕獲・give: の規則は共通）
func fcIsFile(st mut S, y int) bool {
    if yk(mut st, y) != YDecl {
        return false
    }
    x := YAt(mut st, y)
    nm := sA(nodeOf(mut st, yNa(x)))
    return (strIs(mut st, PkgPath(mut st, x.b), "std/io") && strIs(mut st, nm, "File")) || (strIs(mut st, PkgPath(mut st, x.b), "std/net") && (strIs(mut st, nm, "Listener") || strIs(mut st, nm, "Conn"))) || (strIs(mut st, PkgPath(mut st, x.b), "std/tls") && strIs(mut st, nm, "Conn"))
}

// fcHolds は表層型 y が File を持つか（`T?`・slice / map の要素・多値・struct の欄・型引数を fuel 段まで）
func fcHolds(st mut S, y int, fuel int) bool {
    if y < 0 || fuel == 0 {
        return false
    }
    if fcIsFile(mut st, y) {
        return true
    }
    x := YAt(mut st, y)
    if x.k == YSlice || x.k == YOpt {
        return fcHolds(mut st, x.a, fuel - 1)
    }
    if x.k == YMap {
        return fcHolds(mut st, x.a, fuel - 1) || fcHolds(mut st, x.b, fuel - 1)
    }
    if x.k == YTuple {
        return fcHoldsL(mut st, yLa(x), fuel - 1)
    }
    if x.k == YDecl {
        if x.c != -1 && fcHoldsL(mut st, yLc(x), fuel - 1) {
            return true
        }
        if kindN(mut st, nC(nodeOf(mut st, yNa(x)))) == ast.BStruct {
            fs := lA(nodeOf(mut st, nC(nodeOf(mut st, yNa(x)))))
            for i <- iter.Range(0, lenL(mut st, fs)) {
                if fcHolds(mut st, yFieldAt(mut st, y, i), fuel - 1) {
                    return true
                }
            }
        }
    }
    return false
}

// fcHoldsL は型の列 l のどれかが File を持つか
func fcHoldsL(st mut S, l ListRef, fuel int) bool {
    for i <- iter.Range(0, lenL(mut st, l)) {
        if fcHolds(mut st, latI(mut st, l, i), fuel) {
            return true
        }
    }
    return false
}

// fcNodeHolds は式 e の表層型が File を持つか
func fcNodeHolds(st mut S, e NodeRef) bool {
    return e != -1 && fcHolds(mut st, YTypeOf(mut st, e), 6)
}

// fcOpenCall は式 v が Open の呼び出し（`?` は剥がす — 剥がした形を返す。違えば -1）か
func fcOpenCall(st mut S, v NodeRef, try bool) NodeRef {
    mut c := v
    if try {
        if kindN(mut st, c) != ast.ETry {
            return -1
        }
        c = nA(nodeOf(mut st, c))
    }
    if kindN(mut st, c) != ast.ECall || fcFn(mut st, nA(nodeOf(mut st, c))) != 1 {
        return -1
    }
    return c
}

// fcOpenAt は文の列 l の i 番から始まる Open の束縛の形（`f := io.Open(p)?` = 1 文・catch の写し = 2 文）の文の数（形でなければ 0）と、
// Open の呼び出しの節・束縛した名前
func fcOpenAt(st mut S, l ListRef, i int) (int, NodeRef, StrRef) {
    s := latN(mut st, l, i)
    // 列の穴（パイプの段の `_` は -1 — 2026-10-17: 借りの検査で io / net 以外のプログラムでも歩くようになって露見）
    if s == -1 || kindN(mut st, s) != ast.SBind {
        return 0, -1, -1
    }
    b := nodeOf(mut st, s)
    if lenL(mut st, lC(b)) != 1 || b.b != 0 {
        return 0, -1, -1
    }
    if lenL(mut st, lA(b)) == 1 {
        c := fcOpenCall(mut st, latN(mut st, lC(b), 0), true)
        return if c == -1 { 0 } else { 1 }, c, latS(mut st, lA(b), 0)
    }
    // catch の写し: `$ctKv, $ctKe := io.Open(p)` の次の文が `f := if $ctKe != nil { D } else { $ctKv }`
    if lenL(mut st, lA(b)) != 2 || !strHasPrefix(mut st, latS(mut st, lA(b), 0), "$ct") || i + 1 >= lenL(mut st, l) {
        return 0, -1, -1
    }
    c := fcOpenCall(mut st, latN(mut st, lC(b), 0), false)
    s2 := latN(mut st, l, i + 1)
    if c == -1 || kindN(mut st, s2) != ast.SBind {
        return 0, -1, -1
    }
    b2 := nodeOf(mut st, s2)
    if lenL(mut st, lA(b2)) != 1 || lenL(mut st, lC(b2)) != 1 || b2.b != 0 || kindN(mut st, latN(mut st, lC(b2), 0)) != ast.EIf {
        return 0, -1, -1
    }
    return 2, c, latS(mut st, lA(b2), 0)
}

// fcCloseOf は文 d が `defer io.Close(x)` なら x の節（違えば -1 — 実引数が名前でなければ実引数の節）
func fcCloseOf(st mut S, d NodeRef) NodeRef {
    if d == -1 || kindN(mut st, d) != ast.SDefer {
        return -1
    }
    c := nA(nodeOf(mut st, d))
    if kindN(mut st, c) != ast.ECall || fcFn(mut st, nA(nodeOf(mut st, c))) != 2 || lenL(mut st, lB(nodeOf(mut st, c))) != 1 {
        return -1
    }
    return latN(mut st, lB(nodeOf(mut st, c)), 0)
}

// fcPaired は文の列 l の i 番から始まる Open の束縛の形（文 k 個・Open の呼び出し c・束縛した名前 name）の直後の文が `defer io.Close(name)` か
// （違えば拒否 — 再帰しない: fcWalk の相互再帰を作らない〔mut 引数の関数の展開〕）
func fcPaired(st mut S, l ListRef, i int, k int, c NodeRef, name StrRef) PcHit {
    d := if i + k < lenL(mut st, l) { latN(mut st, l, i + k) } else { NodeRef(-1) }
    x := fcCloseOf(mut st, d)
    if x == -1 {
        return PcHit{at: c, kind: FC_UNCLOSED}
    }
    if kindN(mut st, x) != ast.EIdent || !strEq(mut st, sA(nodeOf(mut st, x)), name) {
        return PcHit{at: x, kind: FC_DEFER}
    }
    return pcNone()
}

// fcWalk は木 n の File の使い方を検査する（最初の拒否）
func fcWalk(st mut S, n NodeRef) PcHit {
    if n == -1 {
        return pcNone()
    }
    x := nodeOf(mut st, n)
    k := x.kind
    if k == ast.ECall {
        cal := if kindN(mut st, nA(x)) == ast.EIndex { nA(nodeOf(mut st, nA(x))) } else { nA(x) }
        f := fcFn(mut st, cal)
        if f == 1 {
            return PcHit{at: n, kind: FC_OPEN}
        }
        if f == 2 {
            return PcHit{at: n, kind: FC_CLOSE}
        }
        args := lB(x)
        fk := findFn(mut st, cal, -1)
        if fk >= 0 && ParKey(mut st, fk) == PAR_SPAWNGIVE && lenL(mut st, args) >= 2 && fcNodeHolds(mut st, latN(mut st, args, 1)) {
            return PcHit{at: latN(mut st, args, 1), kind: FC_GIVE}
        }
        // par.Scope の本体の lambda は捕獲を許す（net の裁定 N6 — 本体は同じ task の上で同期に走り、Scope が返ってから外の defer Close が走る）。
        // 本体の中は今どおり歩く（中の Spawn の g・他の閉包への捕獲は拒否）
        if fk >= 0 && ParKey(mut st, fk) == PAR_SCOPE && lenL(mut st, args) >= 1 && kindN(mut st, latN(mut st, args, 0)) == ast.ELambda {
            for i <- iter.Range(0, lenL(mut st, args)) {
                a := latN(mut st, args, i)
                h := fcWalk(mut st, if i == 0 { nB(nodeOf(mut st, a)) } else { a })
                if h.kind != 0 {
                    return h
                }
            }
            return pcNone()
        }
        // 借りの位置（(α-L0) — language.md 25 節「借り」）: 展開される関数の匿名の関数型の仮引数のうち借りとして安全なもの（fsSafe）と、
        // 値の呼び出し（値化可能な named fn type の閉包）の実引数。そこに置いたラムダは同一性の型・借りの値を捕捉してよい（捕捉の検査を飛ばして本体を歩く）
        vcall := fk < 0 && fcValueCallee(mut st, cal)
        if fk >= 0 || vcall {
            mut any := false
            for i <- iter.Range(0, lenL(mut st, args)) {
                a := latN(mut st, args, i)
                if a != -1 && kindN(mut st, a) == ast.ELambda && (vcall || fcBrwPos(mut st, fk, i, 8)) {
                    any = true
                }
            }
            if any {
                for i <- iter.Range(0, lenL(mut st, args)) {
                    a := latN(mut st, args, i)
                    h := if a != -1 && kindN(mut st, a) == ast.ELambda && (vcall || fcBrwPos(mut st, fk, i, 8)) { fcWalk(mut st, nB(nodeOf(mut st, a))) } else { fcWalk(mut st, a) }
                    if h.kind != 0 {
                        return h
                    }
                }
                return if vcall { fcWalk(mut st, nA(x)) } else { pcNone() }
            }
        }
        if fk < 0 && pcIsAppend(mut st, cal) {
            for i <- iter.Range(1, lenL(mut st, args)) {
                if fcNodeHolds(mut st, latN(mut st, args, i)) {
                    return PcHit{at: latN(mut st, args, i), kind: FC_HOLD}
                }
            }
        }
        if fcNodeHolds(mut st, n) {
            return PcHit{at: n, kind: FC_ESCAPE}
        }
        if fk < 0 {
            h := fcWalk(mut st, nA(x))
            if h.kind != 0 {
                return h
            }
        }
        for i <- iter.Range(0, lenL(mut st, args)) {
            h := fcWalk(mut st, latN(mut st, args, i))
            if h.kind != 0 {
                return h
            }
        }
        return pcNone()
    }
    if k == ast.EIdent || k == ast.ESelector {
        // 呼び出しの外の Open / Close（関数値として取り出す形）
        f := fcFn(mut st, n)
        if f != 0 {
            return PcHit{at: n, kind: if f == 1 { FC_OPEN } else { FC_CLOSE }}
        }
    }
    if k == ast.EPipe {
        f := fcFn(mut st, nB(x))
        if f != 0 {
            return PcHit{at: n, kind: if f == 1 { FC_OPEN } else { FC_CLOSE }}
        }
        if fcNodeHolds(mut st, n) {
            return PcHit{at: n, kind: FC_ESCAPE}
        }
    }
    if k == ast.SBind {
        vs := lC(x)
        for i <- iter.Range(0, lenL(mut st, vs)) {
            v := latN(mut st, vs, i)
            kv := kindN(mut st, v)
            // 呼び出し・composite は下の歩きが名指す（返す呼び出し・入れる形の文面で）
            if kv != ast.ECall && kv != ast.EPipe && kv != ast.ETry && kv != ast.ESlicelit && kv != ast.EMaplit && kv != ast.EComposite && fcNodeHolds(mut st, v) {
                return PcHit{at: v, kind: FC_COPY}
            }
        }
    }
    if k == ast.SAssign {
        vs := lC(x)
        for i <- iter.Range(0, lenL(mut st, vs)) {
            if fcNodeHolds(mut st, latN(mut st, vs, i)) {
                return PcHit{at: latN(mut st, vs, i), kind: FC_ASSIGN}
            }
        }
    }
    if k == ast.SRet {
        vs := lA(x)
        for i <- iter.Range(0, lenL(mut st, vs)) {
            if fcNodeHolds(mut st, latN(mut st, vs, i)) {
                return PcHit{at: latN(mut st, vs, i), kind: FC_ESCAPE}
            }
        }
    }
    if (k == ast.ESlicelit || k == ast.EMaplit || k == ast.EComposite) && fcNodeHolds(mut st, n) {
        return PcHit{at: n, kind: FC_HOLD}
    }
    if k == ast.ELambda {
        base := hlen(mut st)
        pcDecls(mut st, n)
        end := hlen(mut st)
        h := fcCapture(mut st, nB(x), base, end)
        if h.kind != 0 {
            return h
        }
        // 値の位置のラムダの匿名の関数型の仮引数 = 借り（(α-L0)）: 呼ぶ・借りの位置へ渡す・借りの位置のラムダに捕捉する、だけ
        vl := capEntry(mut st, n)
        if vl >= 0 && st.capBrw[vl] != 0 {
            ps := lA(x)
            for i <- iter.Range(0, lenL(mut st, ps)) {
                b := if st.capBrw[vl] / pow2(i) % 2 == 1 { fsBad(mut st, nB(x), sA(nodeOf(mut st, latN(mut st, ps, i))), 8) } else { NodeRef(-1) }
                if b != -1 {
                    return PcHit{at: b, kind: FC_BORROW}
                }
            }
        }
    }
    c := pcDesc(mut st, x)
    for j <- iter.Range(0, 6) {
        d := c / pow8(j) % 8
        v := pcField(x, j)
        if d == 1 && v != -1 {
            h := fcWalk(mut st, NodeRef(v))
            if h.kind != 0 {
                return h
            }
        } else if d == 3 && v != -1 {
            // 文（か式）の列: Open の束縛の形を見つけたら直後の defer Close と照合し、形の中の Open / Close の呼び出しは歩かない
            // （Open の実引数・catch の腕 D は歩く。束縛の値の File〔catch の $ctKv〕は写しの束縛の外）
            l := ListRef(v)
            mut i := 0
            while i < lenL(mut st, l) {
                kn, oc, name := fcOpenAt(mut st, l, i)
                if kn == 0 {
                    h := fcWalk(mut st, latN(mut st, l, i))
                    if h.kind != 0 {
                        return h
                    }
                    i += 1
                } else {
                    oa := lB(nodeOf(mut st, oc))
                    for a <- iter.Range(0, lenL(mut st, oa)) {
                        ha := fcWalk(mut st, latN(mut st, oa, a))
                        if ha.kind != 0 {
                            return ha
                        }
                    }
                    if kn == 2 {
                        hd := fcWalk(mut st, nB(nodeOf(mut st, latN(mut st, lC(nodeOf(mut st, latN(mut st, l, i + 1))), 0))))
                        if hd.kind != 0 {
                            return hd
                        }
                    }
                    hp := fcPaired(mut st, l, i, kn, oc, name)
                    if hp.kind != 0 {
                        return hp
                    }
                    i += kn + 1
                }
            }
        }
    }
    return pcNone()
}

// fcCapture は木 n の名前の参照のうち、ラムダの中で束ねていない（ヒープの [base, end) に無い）File を持つものの最初
func fcCapture(st mut S, n NodeRef, base int, end int) PcHit {
    if n == -1 {
        return pcNone()
    }
    x := nodeOf(mut st, n)
    if x.kind == ast.EIdent {
        if !pcIn(mut st, base, end, sA(x), false) && (fcNodeHolds(mut st, n) || fcBrwVal(mut st, n)) {
            return PcHit{at: n, kind: FC_CAPTURE}
        }
        return pcNone()
    }
    c := pcDesc(mut st, x)
    for j <- iter.Range(0, 6) {
        d := c / pow8(j) % 8
        v := pcField(x, j)
        if d == 1 && v != -1 {
            h := fcCapture(mut st, NodeRef(v), base, end)
            if h.kind != 0 {
                return h
            }
        } else if d == 3 && v != -1 {
            l := ListRef(v)
            for i <- iter.Range(0, lenL(mut st, l)) {
                h := fcCapture(mut st, latN(mut st, l, i), base, end)
                if h.kind != 0 {
                    return h
                }
            }
        }
    }
    return pcNone()
}

// fileCheck は std/io の外の全関数の File の使い方を検査する（ParCheckTyped から — io.Open を書くプログラムだけ）
@errors(diag.FileUse)
func fileCheck(st mut S) error? {
    for fi <- iter.Range(0, st.nfn) {
        body := fnBody(mut st, fi)
        if body != -1 && !strIs(mut st, PkgPath(mut st, fnPkg(mut st, fi)), "std/io") && !strIs(mut st, PkgPath(mut st, fnPkg(mut st, fi)), "std/net") && !strIs(mut st, PkgPath(mut st, fnPkg(mut st, fi)), "std/tls") {
            st.curPkg = fnPkg(mut st, fi)
            h := fcWalk(mut st, body)
            if h.kind != 0 {
                return diag.FileUse{at: posOf(mut st, h.at), kind: h.kind}
            }
        }
    }
    return nil
}

// ── 借り（(α-L0) — language.md 25 節「借り」・report-754 1 節）──

// fcBrwVal は名前の参照 e が値の位置のラムダの借りの仮引数（閉包の値 — 同一性を捕捉しうる）か（loader の表 cap_brw のビット。
// 影の禁止 — 名前で引ける。名前付き関数の匿名の関数型の仮引数は展開 — 借りの位置の安全は fcBrwPos が呼び手の側で見る）
func fcBrwVal(st mut S, e NodeRef) bool {
    if kindN(mut st, e) != ast.EIdent {
        return false
    }
    nm := sA(nodeOf(mut st, e))
    for i <- iter.Range(0, len(st.capFile)) {
        if st.capBrw[i] != 0 {
            ps := lA(nodeOf(mut st, NodeRef(ABASE + st.capFile[i] * FW + st.capNode[i])))
            for j <- iter.Range(0, lenL(mut st, ps)) {
                if st.capBrw[i] / pow2(j) % 2 == 1 && strEq(mut st, sA(nodeOf(mut st, latN(mut st, ps, j))), nm) {
                    return true
                }
            }
        }
    }
    return false
}

// pow2 は 2 の i 乗（借りの仮引数のビットの読み）
func pow2(i int) int {
    mut r := 1
    for _ <- iter.Range(0, i) { r *= 2 }
    return r
}

// fcValueCallee は callee（名前付き関数でない）が値の呼び出し（値化可能な named fn type の閉包・借りの閉包）か
func fcValueCallee(st mut S, cal NodeRef) bool {
    k := kindN(mut st, cal)
    if k != ast.EIdent && k != ast.ESelector {
        return false
    }
    mut y := YTypeOf(mut st, cal)
    if y >= 0 && yk(mut st, y) == YOpt {
        y = YAt(mut st, y).a
    }
    if y < 0 {
        return false
    }
    if yk(mut st, y) == YDecl {
        return fnValDeclNode(mut st, yNa(YAt(mut st, y)))
    }
    if yk(mut st, y) != YFn {
        return false
    }
    c := YAt(mut st, y).c
    return c > 0 && fnValDeclNode(mut st, NodeRef(c - 1)) || c == 0 && fcBrwVal(mut st, cal)
}

// fcBrwPos は名前付き関数 fk の i 番目の仮引数が借りとして安全な位置か: 匿名の関数型で、本体がその仮引数を呼ぶ・借りの位置へ渡す・借りの位置の
// ラムダに捕捉する、だけ（fsSafe）。std/par は Scope の本体だけ（Spawn の族・Map は子 task で走る）
func fcBrwPos(st mut S, fk int, i int, fuel int) bool {
    if fk < 0 || fuel == 0 {
        return false
    }
    ps := fnParams(mut st, fk)
    if i >= lenL(mut st, ps) {
        return false
    }
    prm := latN(mut st, ps, i)
    if kindN(mut st, nB(nodeOf(mut st, prm))) != ast.TFunc {
        return false
    }
    if strIs(mut st, PkgPath(mut st, fnPkg(mut st, fk)), "std/par") {
        return ParKey(mut st, fk) == PAR_SCOPE && i == 0
    }
    body := fnBody(mut st, fk)
    if body == -1 {
        return false
    }
    // fk の本体の中の名前（同じ package の関数・fk の package の import）は fk の package で引く — 呼び手の package のままだと、
    // 別の package の関数（http.ServeWith の serveBuf / linger）の中の呼び出しが見つからず借りの位置でない扱いになる（report-841）
    cp := st.curPkg
    st.curPkg = fnPkg(mut st, fk)
    b := fsBad(mut st, body, sA(nodeOf(mut st, prm)), fuel - 1)
    st.curPkg = cp
    return b == -1
}

// fsBad は木 n の中の名前 p（借りの関数値）の使い方のうち、借りの規則の外の最初の節（無ければ -1）: 許すのは呼ぶ・借りの位置
// （fcBrwPos / 値の呼び出しの実引数）へ渡す・借りの位置のラムダ / par.Scope の本体に捕捉する（その中の使い方も同じ規則）
func fsBad(st mut S, n NodeRef, p StrRef, fuel int) NodeRef {
    if n == -1 {
        return -1
    }
    x := nodeOf(mut st, n)
    if x.kind == ast.EIdent {
        return if strEq(mut st, sA(x), p) { n } else { NodeRef(-1) }
    }
    if x.kind == ast.ECall {
        cal := if kindN(mut st, nA(x)) == ast.EIndex { nA(nodeOf(mut st, nA(x))) } else { nA(x) }
        fk := findFn(mut st, cal, -1)
        vcall := fk < 0 && fcValueCallee(mut st, cal)
        if !(kindN(mut st, cal) == ast.EIdent && strEq(mut st, sA(nodeOf(mut st, cal)), p)) {
            b := fsBad(mut st, nA(x), p, fuel)
            if b != -1 {
                return b
            }
        }
        args := lB(x)
        for i <- iter.Range(0, lenL(mut st, args)) {
            a := latN(mut st, args, i)
            ka := if a == -1 { 0 } else { kindN(mut st, a) }
            pos := vcall || fcBrwPos(mut st, fk, i, fuel)
            if ka == ast.EIdent && strEq(mut st, sA(nodeOf(mut st, a)), p) {
                if !pos {
                    return a
                }
            } else if ka == ast.ELambda && !pos {
                b := fsAny(mut st, nB(nodeOf(mut st, a)), p)
                if b != -1 {
                    return b
                }
            } else {
                b := fsBad(mut st, if ka == ast.ELambda { nB(nodeOf(mut st, a)) } else { a }, p, fuel)
                if b != -1 {
                    return b
                }
            }
        }
        return -1
    }
    if x.kind == ast.ELambda {
        // 借りの位置でないラムダ（値の位置・Spawn の子など）への捕捉
        return fsAny(mut st, nB(x), p)
    }
    c := pcDesc(mut st, x)
    for j <- iter.Range(0, 6) {
        d := c / pow8(j) % 8
        v := pcField(x, j)
        if d == 1 && v != -1 {
            b := fsBad(mut st, NodeRef(v), p, fuel)
            if b != -1 {
                return b
            }
        } else if d == 3 && v != -1 {
            l := ListRef(v)
            for i <- iter.Range(0, lenL(mut st, l)) {
                b := fsBad(mut st, latN(mut st, l, i), p, fuel)
                if b != -1 {
                    return b
                }
            }
        }
    }
    return -1
}

// fsAny は木 n の中の名前 p の参照の最初（無ければ -1）
func fsAny(st mut S, n NodeRef, p StrRef) NodeRef {
    if n == -1 {
        return -1
    }
    x := nodeOf(mut st, n)
    if x.kind == ast.EIdent {
        return if strEq(mut st, sA(x), p) { n } else { NodeRef(-1) }
    }
    c := pcDesc(mut st, x)
    for j <- iter.Range(0, 6) {
        d := c / pow8(j) % 8
        v := pcField(x, j)
        if d == 1 && v != -1 {
            b := fsAny(mut st, NodeRef(v), p)
            if b != -1 {
                return b
            }
        } else if d == 3 && v != -1 {
            l := ListRef(v)
            for i <- iter.Range(0, lenL(mut st, l)) {
                b := fsAny(mut st, latN(mut st, l, i), p)
                if b != -1 {
                    return b
                }
            }
        }
    }
    return -1
}
