package desugar

// 脱糖器（src/desugar.zig の写し — AST → コア AST（Lean の Json.lean スキーマ）→ JSON）の状態と土台。
//
// 表現（仮決め R10-1 — selfhost-drafts）: 状態は S 1 つ。スカラーは S の欄、記録は全部 1 本の int ヒープ st.h（std/table の Table — 添字で読み書きし、成長でコピーしない）に積む
// （Zig 版のポインタの木・ArrayList・HashMap の代わり）。記録は「ヒープの添字」で指し、無しは -1。
// - 表層 AST: loader の木を写さずに参照で指す（astref.sober — 木の節・合成の節・木の列 / 文字列の基底つき参照）。読みは nodeAt(mut st, n).a 等で、
//   欄は参照に付け替わって返る（括弧 EParen は透過 — Zig の AST は括弧を持たない。`$utf8` の書き換え先 EUtf8Ref は名前 `$utf8` の EIdent に見える）。
//   補間・for 式の書き換え（Zig の interp.zig / forexpand.zig）などが作る節は合成の表 st.syn に足す
// - 列 = [n, 要素…]、文字列 = [n, バイト…]
// - コア式は st.cores（CoreExpr の表 — 参照 = CBASE + 添字 — core.sober）。型は st.types（Ty の表 — intern、参照 = TBASE + 添字 — ty.sober）
// 再帰する関数は `st mut S` を持ち回る（Def として呼ぶ mut 引数の関数 — R2）。その関数に渡す imm の値は int だけにする
// （frame の中で作った slice を渡すと検査が拒否する — language.md 31 節の anchor 1 slot、selfhost-drafts F-6。string リテラルは
// strlit の段で渡せる）

import "ast"
import "loader"
import "std/iter"
import "std/table"

// Fail は脱糖の拒否（Zig 版の error.CoreFragment / UnknownName / Malformed）。k は種類、tok は位置
type Fail error {
    k int
    tok int
}

const KFrag = 1
const KUnknown = 2
const KMalformed = 3
const KNominal = 4   // 型宣言の区別の違反（language.md 32 節 — 表層型の照合。診断の種類は TypeMismatch）

// 状態のスカラーは src/desugar.zig の Desugarer の欄と同じ名前・意味（bool は 0 / 1）。表（pkgs / files / fns / cons / errv）と
// 作業スタック（lstk / sstk / jstk）はヒープの添字
type S struct {
    h table.Table[int]
    trees []ast.Tree            // loader の木（imm のまま — 参照は astref.sober）
    syn table.Table[ast.Node]   // 合成の節（参照 = SBASE + 添字）
    utf8 int                    // 名前 `$utf8` の文字列（EUtf8Ref の見せ方 — treeNode）
    descs []int                 // 節の種類 → 欄の付け替えの種類（desc の表 — treeNode が引く）
    binds table.Table[Binding]
    labels table.Table[Label]
    closures table.Table[Closure]
    types table.Table[Ty]
    cores table.Table[CoreExpr]
    tyNext table.Table[int]
    tyBucket table.Table[int]
    tyMemo table.Table[TyMemo]   // 名前付き型の解決の memo（resolve.sober の tyOf — 型環境なしの参照だけ）
    tyMemoBucket table.Table[int]
    npkg int
    pkgs int
    nfile int
    files int
    nfn int
    fns table.Table[FnInfo]
    ndef int
    ncon int
    cons int
    errv int
    mainPkg int
    tInt int
    tBool int
    tUnit int
    curPkg int
    curRtys int
    tenv int
    curTparams int
    liftedHead int
    liftedTail int
    lastTok int    // tokOf が最後に位置を読んだ節（拒否の位置からファイルを引く — failInfo）
    nlifted int
    hasOuter int
    outerB int
    outerF int
    inlining int
    inDict int
    dictConst int
    dictLifts int
    liftHint int
    rdepth int
    lstk int
    nlab int
    sstk int
    nscope int
    nextLabel int
    retTarget int
    trySkip int
    stmtIf int
    loopFloor int
    tailWant int
    swWant int
    hasErrSw int
    errLevel int
    errTy int
    jstk int
    jlab int
    // 再帰展開の検査に使う展開中の関数の鎖（inlining と同じ形）。ラムダの本体を展開する間は、閉包が定義時に持った鎖へ差し替える
    // （本体は字句的に callee の外 — `iter.Slice` の中のラムダが `iter.Slice` を呼ぶのは再帰でない。lower の CL_INL と同じ方式）
    inlrec int
    stys table.Table[STy]        // 表層型の表（surface.sober — STBASE + 添字）
    smemo table.Table[SMemo]     // 表層型のメモ（surface.sober — 型名の解決と intern）
    smemoBucket table.Table[int]
    fnBucket table.Table[int]    // 関数の索引（resolve.sober の findFn — (package, 名前) のハッシュ → 関数の添字の鎖。最初の findFn で組む）
    fnNext table.Table[int]
    fnNamed table.Table[int]     // 名前付き関数型の展開の結果 → 型宣言（対 [te, td]…— surface.sober の noteNamedFn）
    curRes int                   // 今の関数の結果の型式の列（表層型の照合用 — -1 = 無し）
    hasNamed bool                // 読み込んだ package に named scalar の型宣言があるか（無ければ named の照合を飛ばす — surface.sober）
    curResPkg int
}

// ── ヒープの読み書き（st.h = std/table の Table）──
// 包みは展開される（呼び出し点ごとの一時領域は lower の文の出口で返して使い回す — S-1。以前は @noinline で暫定回避していた: 展開すると
// LLVM 経路（-O0）で呼び出し点ごとに一時領域が積もり、再帰する関数のフレームが 3〜4 倍に膨らんで 8MB のスタックを溢れた — reaudit ① report-15）

func hget(st mut S, i int) int {
    return table.Get(mut st.h, i)
}

func hset(st mut S, i int, v int) {
    table.Set(mut st.h, i, v)
}

func hpush(st mut S, v int) {
    table.Push(mut st.h, v)
}

func hlen(st mut S) int {
    return table.Len(mut st.h)
}

// dat は生の 1 語（文字列のバイト・値の列の要素・列の個数）— 木の列・文字列（LBASE）なら木の data、他はヒープ
func dat(st mut S, x int) int {
    if x >= LBASE {
        if x >= LBASE + LK {
            return badRef()
        }
        return st.trees[refFile(x)].data[refIdx(x)]
    }
    return hget(mut st, x)
}

// ── ヒープの小道具（展開される — 呼び出し点ごとに小さい）──

func put(st mut S, x int) {
    hpush(mut st, x)
}

func top(st mut S) int {
    return hlen(mut st)
}

func rec5(st mut S, tag int, a int, b int, c int, d int) int {
    at := hlen(mut st)
    hpush(mut st, tag)
    hpush(mut st, a)
    hpush(mut st, b)
    hpush(mut st, c)
    hpush(mut st, d)
    return at
}

// rec8 は表層 AST の節を合成する（合成の表 st.syn — 参照 = SBASE + 添字。補間・for 式・yield・名前付き関数型の展開などの書き換えが作る）
func rec8(st mut S, k int, tok int, a int, b int, c int, d int, e int, f int) int {
    return synNode(mut st, ast.Node{kind: k, tok: tok, a: a, b: b, c: c, d: d, e: e, f: f})
}

// strLit は綴り w をヒープの文字列にする
func strLit(st mut S, w string) int {
    b := bytes(w)
    at := hlen(mut st)
    hpush(mut st, len(b))
    for i <- iter.Range(0, len(b)) {
        hpush(mut st, b[i])
    }
    return at
}

// strOf はバイト列 b をヒープの文字列にする
func strOf(st mut S, b []int) int {
    at := hlen(mut st)
    hpush(mut st, len(b))
    for i <- iter.Range(0, len(b)) {
        hpush(mut st, b[i])
    }
    return at
}

// strPart は文字列 s のバイト [a, b) を新しい文字列にする
func strPart(st mut S, s int, a int, b int) int {
    at := hlen(mut st)
    hpush(mut st, b - a)
    for i <- iter.Range(a, b) {
        hpush(mut st, dat(mut st, s + 1 + i))
    }
    return at
}

// list0 / list1 / list2 は要素 0〜2 個の列
func list0(st mut S) int {
    at := hlen(mut st)
    hpush(mut st, 0)
    return at
}

func list1(st mut S, x int) int {
    at := hlen(mut st)
    hpush(mut st, 1)
    hpush(mut st, x)
    return at
}

func list2(st mut S, x int, y int) int {
    at := hlen(mut st)
    hpush(mut st, 2)
    hpush(mut st, x)
    hpush(mut st, y)
    return at
}

// listN は長さ n の列を確保する（中身は 0 — 呼び手が埋める）
func listN(st mut S, n int) int {
    at := hlen(mut st)
    hpush(mut st, n)
    for i <- iter.Range(0, n) {
        hpush(mut st, 0)
    }
    return at
}

// lset は listN で取った固定長の列 l（作業域 — jstk / jlab / lstk / sstk）の i 番に v を書く。範囲外は panic 101（badRef —
// ヒープは 1 本の表なので、検査しないと溢れた書き込みが隣の列を黙って上書きする）
func lset(st mut S, l int, i int, v int) {
    if i < 0 || i >= hget(mut st, l) {
        badRef()
    }
    hset(mut st, l + 1 + i, v)
}

// ── 文字列の比較 ──

func strEq(st mut S, a int, b int) bool {
    n := dat(mut st, a)
    if dat(mut st, b) != n {
        return false
    }
    return strSpanEq(mut st, a, 0, b, 0, n)
}

func strIs(st mut S, a int, w string) bool {
    b := bytes(w)
    if dat(mut st, a) != len(b) {
        return false
    }
    if a >= LBASE {
        return dataIs(st.trees[refFile(a)].data, refIdx(a) + 1, b)
    }
    for i <- iter.Range(0, len(b)) {
        if hget(mut st, a + 1 + i) != b[i] {
            return false
        }
    }
    return true
}

// strEqPart は文字列 a と、文字列 s のバイト [lo, hi) の一致
func strEqPart(st mut S, a int, s int, lo int, hi int) bool {
    if dat(mut st, a) != hi - lo {
        return false
    }
    return strSpanEq(mut st, a, 0, s, lo, hi - lo)
}

// strSpanEq は文字列 a のバイト [alo, alo + n) と文字列 s のバイト [slo, slo + n) の一致（両方が木の文字列なら data を直に比べる）
func strSpanEq(st mut S, a int, alo int, s int, slo int, n int) bool {
    if a >= LBASE && s >= LBASE {
        return dataEq(st.trees[refFile(a)].data, refIdx(a) + 1 + alo, st.trees[refFile(s)].data, refIdx(s) + 1 + slo, n)
    }
    for i <- iter.Range(0, n) {
        if dat(mut st, a + 1 + alo + i) != dat(mut st, s + 1 + slo + i) {
            return false
        }
    }
    return true
}

// StrEq / StrIs / StrEqPart は lower が使う（同じ速い道を共有する）
func StrEq(st mut S, a int, b int) bool {
    return strEq(mut st, a, b)
}

func StrIs(st mut S, a int, w string) bool {
    return strIs(mut st, a, w)
}

func StrEqPart(st mut S, a int, s int, lo int, hi int) bool {
    return strEqPart(mut st, a, s, lo, hi)
}

// dotAt は文字列 s の最初の '.' の位置（無ければ -1）
func dotAt(st mut S, s int) int {
    mut i := 0
    while i < dat(mut st, s) {
        if dat(mut st, s + 1 + i) == 46 {
            return i
        }
        i += 1
    }
    return -1
}

// ── 表層 AST の読み出し（節 = ast.Node — 木か合成の表。参照は astref.sober）──

// nodeAt は節 n（木か合成の参照 — それ以外は合成の表の範囲外で panic）を、欄を参照にして返す
func nodeAt(st mut S, n int) ast.Node {
    if isTreeNode(n) {
        return treeNode(refFile(n), st.trees[refFile(n)].nodes, refIdx(n), st.descs, st.utf8)
    }
    return synAt(mut st, n - SBASE)
}

// NodeAt は nodeAt と同じ（lower が読む — 包みの段を増やさないよう本体を同じに書く）
func NodeAt(st mut S, n int) ast.Node {
    if isTreeNode(n) {
        return treeNode(refFile(n), st.trees[refFile(n)].nodes, refIdx(n), st.descs, st.utf8)
    }
    return synAt(mut st, n - SBASE)
}

// synAt は合成の表の i 番目（非ジェネリックの包み — F-10）
func synAt(st mut S, i int) ast.Node {
    return table.Get(mut st.syn, i)
}

// synNode は合成の節を足して参照を返す
func synNode(st mut S, x ast.Node) int {
    table.Push(mut st.syn, x)
    return SBASE + table.Len(mut st.syn) - 1
}

// synSet は合成の節 n を x に差し替える（文形 for のラムダに break の行き先を後から書く — stmts.sober の 1 か所だけ）
func synSet(st mut S, n int, x ast.Node) {
    table.Set(mut st.syn, n - SBASE, x)
}

// SynSet は synSet（lower の文形 for — 同じ形の書き込み）
func SynSet(st mut S, n int, x ast.Node) {
    synSet(mut st, n, x)
}

// SynNode は synNode（lower が合成する）
func SynNode(st mut S, x ast.Node) int {
    return synNode(mut st, x)
}

// KindAt / TokAt は節の種類・位置（lower が読む — tokOf と違って拒否の位置の記録 lastTok を動かさない）
func KindAt(st mut S, n int) int {
    if isTreeNode(n) {
        return treeKind(st.trees[refFile(n)], refIdx(n))
    }
    return synAt(mut st, n - SBASE).kind
}

func TokAt(st mut S, n int) int {
    if n < 0 {
        return 0
    }
    if isTreeNode(n) {
        return st.trees[refFile(n)].nodes[refIdx(n)].tok
    }
    return synAt(mut st, n - SBASE).tok
}

func kindOf(st mut S, n int) int {
    return KindAt(mut st, n)
}

func tokOf(st mut S, n int) int {
    if n < 0 {
        return 0
    }
    st.lastTok = n
    return TokAt(mut st, n)
}

// FileAt は節 n の属するファイル（木の節で、その位置が tok と一致するときだけ — でなければ -1。lower の拒否の位置 — failInfo と同じ考え方）
func FileAt(st mut S, n int, tok int) int {
    if isTreeNode(n) && TokAt(mut st, n) == tok {
        return refFile(n)
    }
    return -1
}

// failInfo は拒否 err の [種類, ファイル, 字句の位置]。ファイルは tokOf が最後に読んだ節の属するファイルで、その節の位置が拒否の位置と
// 一致するときだけ（一致しなければ -1 — 位置を引いた節が別なら出さない。正確か無しか）
func failInfo(st mut S, err error?) []int {
    mut fk := KMalformed
    mut ft := 0
    if err != nil {
        switch err {
        case Fail{k, tok}:
            fk = k
            ft = tok
        default:
            fk = KMalformed
        }
    }
    mut file := -1
    n := st.lastTok
    if isTreeNode(n) && TokAt(mut st, n) == ft {
        file = refFile(n)
    }
    return []int{fk, file, ft}
}

// llen / lat は列の個数・i 番目（木の列なら要素を参照へ付け替える）
func llen(st mut S, l int) int {
    if l >= LBASE {
        return st.trees[refFile(l)].data[refIdx(l)]
    }
    return hget(mut st, l)
}

func lat(st mut S, l int, i int) int {
    if l >= LBASE {
        return treeLat(refFile(l), st.trees[refFile(l)].nodes, st.trees[refFile(l)].data, refKind(l), refIdx(l), i)
    }
    return hget(mut st, l + 1 + i)
}

// Llen / Lat / Dat は llen / lat / dat と同じ（lower が読む — 本体を同じに書く）
func Llen(st mut S, l int) int {
    if l >= LBASE {
        return st.trees[refFile(l)].data[refIdx(l)]
    }
    return hget(mut st, l)
}

func Lat(st mut S, l int, i int) int {
    if l >= LBASE {
        return treeLat(refFile(l), st.trees[refFile(l)].nodes, st.trees[refFile(l)].data, refKind(l), refIdx(l), i)
    }
    return hget(mut st, l + 1 + i)
}

func Dat(st mut S, x int) int {
    if x >= LBASE {
        if x >= LBASE + LK {
            return badRef()
        }
        return st.trees[refFile(x)].data[refIdx(x)]
    }
    return hget(mut st, x)
}

// ── 表: package（6 語 [path, name, flo, fhi, imports（列 [n, (ref, pkg)…]）, 0]）──

const PKSZ = 6

func pkgRec(st mut S, pk int) int {
    return st.pkgs + pk * PKSZ
}

func PkgPath(st mut S, pk int) int {
    return hget(mut st, st.pkgs + pk * PKSZ)
}

func PkgFlo(st mut S, pk int) int {
    return hget(mut st, st.pkgs + pk * PKSZ + 2)
}

func PkgFhi(st mut S, pk int) int {
    return hget(mut st, st.pkgs + pk * PKSZ + 3)
}

// FileRoot はファイル f の KFile 節
func FileRoot(st mut S, f int) int {
    return hget(mut st, st.files + f * 2)
}

// FilePkg はファイル f の package
func FilePkg(st mut S, f int) int {
    return hget(mut st, st.files + f * 2 + 1)
}

// ImportOf は package pk の import の参照名（文字列 s のバイト [lo, hi)）の行き先 package（無ければ -1）
func ImportOf(st mut S, pk int, s int, lo int, hi int) int {
    im := hget(mut st, st.pkgs + pk * PKSZ + 4)
    mut i := 0
    while i < hget(mut st, im) {
        if strEqPart(mut st, hget(mut st, im + 1 + i * 2), s, lo, hi) {
            return hget(mut st, im + 2 + i * 2)
        }
        i += 1
    }
    return -1
}

// IsStdPkg は std/ 配下の package か
func IsStdPkg(st mut S, pk int) bool {
    p := PkgPath(mut st, pk)
    return hget(mut st, p) >= 4 && hget(mut st, p + 1) == 115 && hget(mut st, p + 2) == 116 && hget(mut st, p + 3) == 100 && hget(mut st, p + 4) == 47
}

// ── 表: 関数（st.fns の要素 — 関数表の添字で指す）──

// FnInfo は関数表の 1 行（ファイル順 × 宣言順）
type FnInfo struct {
    node int      // 関数宣言の節
    pkg int
    expands bool  // 呼び出し点に展開される（関数型引数を持つ）
    mutDef bool   // mut 引数を持つ Def（R2 の callm）
    closed bool   // 関数型の引数を持たない展開関数（lower の --passes で region 透過の実体関数 — check は展開のまま）
    hasTry bool
    def int       // Def の添字（展開される・main は -1）
}

// FnAt は関数表の i 行目（lower も読む — 非ジェネリックの包み）
func FnAt(st mut S, i int) FnInfo {
    return table.Get(mut st.fns, i)
}

func fnNode(st mut S, i int) int {
    return FnAt(mut st, i).node
}

func fnPkg(st mut S, i int) int {
    return FnAt(mut st, i).pkg
}

func fnExpands(st mut S, i int) bool {
    return FnAt(mut st, i).expands
}

func fnMutDef(st mut S, i int) bool {
    return FnAt(mut st, i).mutDef
}

func fnHasTry(st mut S, i int) bool {
    return FnAt(mut st, i).hasTry
}

func fnDef(st mut S, i int) int {
    return FnAt(mut st, i).def
}

// 関数宣言の欄（KFuncDecl: a = 名前, b = type_params, c = params, d = results, e = body）
func fnName(st mut S, i int) int {
    return nodeAt(mut st, fnNode(mut st, i)).a
}

func fnTParams(st mut S, i int) int {
    return nodeAt(mut st, fnNode(mut st, i)).b
}

func fnParams(st mut S, i int) int {
    return nodeAt(mut st, fnNode(mut st, i)).c
}

func fnResults(st mut S, i int) int {
    return nodeAt(mut st, fnNode(mut st, i)).d
}

func fnBody(st mut S, i int) int {
    return nodeAt(mut st, fnNode(mut st, i)).e
}

// ── 表: const（5 語 [node, pkg, value, has, dict]）──

const CNSZ = 5

func ConNode(st mut S, i int) int {
    return hget(mut st, st.cons + i * CNSZ)
}

func ConValue(st mut S, i int) int {
    return hget(mut st, st.cons + i * CNSZ + 2)
}

func ConDict(st mut S, i int) bool {
    return hget(mut st, st.cons + i * CNSZ + 4) != 0
}

func ConPkg(st mut S, i int) int {
    return hget(mut st, st.cons + i * CNSZ + 1)
}

func ConHas(st mut S, i int) bool {
    return hget(mut st, st.cons + i * CNSZ + 3) != 0
}

// ── 表の大きさと、表に載らない大域（lower も読む — 表の記録のオフセットは desugar の外に出さない。reaudit 第 2 弾 C2）──

func Nfn(st mut S) int {
    return st.nfn
}

func Ncon(st mut S) int {
    return st.ncon
}

func Nfile(st mut S) int {
    return st.nfile
}

func MainPkg(st mut S) int {
    return st.mainPkg
}

// error ラベル（st.errv = 列 [(型宣言, package)…] — リンク時に閉じる union の variant の並び）

func NErr(st mut S) int {
    return llen(mut st, st.errv) / 2
}

func ErrNode(st mut S, i int) int {
    return hget(mut st, st.errv + 1 + i * 2)
}

func ErrPkg(st mut S, i int) int {
    return hget(mut st, st.errv + 2 + i * 2)
}

// ── 初期化: loader の Program をヒープへ ──

// d6 は 6 欄の付け替えの種類（8 進 1 桁ずつ）: 0 = 値、1 = 節、2 = 文字列、3 = 節の列、4 = 文字列の列、5 = 値の列
func d6(a int, b int, c int, d int, e int, f int) int {
    return a + b * 8 + c * 64 + d * 512 + e * 4096 + f * 32768
}

