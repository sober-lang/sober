package desugar

import "std/iter"
import "obuf"



// コア AST の JSON 印字（src/desugar.zig の JsonWriter と同じバイト列 — 1 行・空白なし）。
// 式は明示スタックで印字する（let の鎖・文字列リテラルの append の鎖は深い — 再帰の実効上限を踏まない）。型は浅いので再帰

// 作業の種類（スタックに (op, arg) で積む）
const OE = 0   // 式を印字
const OT = 1   // 型を印字
const OS = 2   // 定型の断片（emitFrag の番号）
const OPop = 3 // 印字中のラベルを 1 つ降ろす

func putBool(out mut []int, b bool) {
    if b {
        obuf.Lit(mut out, "true")
    } else {
        obuf.Lit(mut out, "false")
    }
}

func emitFrag(out mut []int, c int) {
    if c == 1 {
        out = append(out, 125)
    } else if c == 2 {
        obuf.Lit(mut out, ",\"e\":")
    } else if c == 3 {
        obuf.Lit(mut out, ",\"body\":")
    } else if c == 4 {
        obuf.Lit(mut out, ",\"b\":")
    } else if c == 5 {
        obuf.Lit(mut out, ",\"t\":")
    } else if c == 6 {
        obuf.Lit(mut out, ",\"nil\":")
    } else if c == 7 {
        obuf.Lit(mut out, ",\"some\":")
    } else if c == 8 {
        obuf.Lit(mut out, ",\"l\":")
    } else if c == 9 {
        obuf.Lit(mut out, ",\"r\":")
    } else if c == 10 {
        obuf.Lit(mut out, ",\"i\":")
    } else if c == 11 {
        obuf.Lit(mut out, ",\"v\":")
    } else if c == 12 {
        obuf.Lit(mut out, ",\"a\":")
    } else if c == 13 {
        obuf.Lit(mut out, ",\"key\":")
    } else if c == 15 {
        obuf.Lit(mut out, ",\"body\":{\"k\":\"triv\"}}")
    }
}

// tyJson は型 t を印字する
func tyJson(st mut S, out mut []int, t int) {
    k := tg(mut st, t)
    if k == TInt {
        obuf.Lit(mut out, "{\"k\":\"int\"}")
    } else if k == TVar {
        obuf.Lit(mut out, "{\"k\":\"tvar\",\"i\":")
        obuf.Int(mut out, tA(mut st, t))
        out = append(out, 125)
    } else if k == TBool {
        obuf.Lit(mut out, "{\"k\":\"bool\"}")
    } else if k == TUnit {
        obuf.Lit(mut out, "{\"k\":\"unit\"}")
    } else if k == TSl || k == TRef {
        obuf.Lit(mut out, if k == TSl { "{\"k\":\"slice\",\"m\":" } else { "{\"k\":\"ref\",\"m\":" })
        putBool(mut out, tA(mut st, t) != 0)
        obuf.Lit(mut out, ",\"r\":")
        obuf.Int(mut out, tB(mut st, t))
        obuf.Lit(mut out, ",\"t\":")
        tyJson(mut st, mut out, tC(mut st, t))
        out = append(out, 125)
    } else if k == TMp {
        obuf.Lit(mut out, "{\"k\":\"map\",\"m\":")
        putBool(mut out, tA(mut st, t) != 0)
        obuf.Lit(mut out, ",\"r\":")
        obuf.Int(mut out, tB(mut st, t))
        obuf.Lit(mut out, ",\"key\":")
        tyJson(mut st, mut out, tC(mut st, t))
        obuf.Lit(mut out, ",\"t\":")
        tyJson(mut st, mut out, tD(mut st, t))
        out = append(out, 125)
    } else if k == TOpt {
        obuf.Lit(mut out, "{\"k\":\"opt\",\"t\":")
        tyJson(mut st, mut out, tA(mut st, t))
        out = append(out, 125)
    } else if k == TUn || k == TPr {
        obuf.Lit(mut out, if k == TUn { "{\"k\":\"union\",\"l\":" } else { "{\"k\":\"prod\",\"l\":" })
        tyJson(mut st, mut out, tA(mut st, t))
        obuf.Lit(mut out, ",\"r\":")
        tyJson(mut st, mut out, tB(mut st, t))
        out = append(out, 125)
    } else if k == TChan {
        obuf.Lit(mut out, "{\"k\":\"chan\",\"rc\":")
        obuf.Int(mut out, tA(mut st, t))
        obuf.Lit(mut out, ",\"t\":")
        tyJson(mut st, mut out, tB(mut st, t))
        out = append(out, 125)
    } else if k == TFn {
        obuf.Lit(mut out, "{\"k\":\"fn\",\"p\":")
        tyJson(mut st, mut out, tA(mut st, t))
        obuf.Lit(mut out, ",\"r\":")
        tyJson(mut st, mut out, tB(mut st, t))
        out = append(out, 125)
    }
}

// tsJson は型引数の列（-1 か空なら何も書かない）
func tsJson(st mut S, out mut []int, l int) {
    if l < 0 || llen(mut st, l) == 0 {
        return
    }
    obuf.Lit(mut out, ",\"ts\":[")
    for i <- iter.Range(0, llen(mut st, l)) {
        if i > 0 {
            out = append(out, 44)
        }
        tyJson(mut st, mut out, lat(mut st, l, i))
    }
    out = append(out, 93)
}

func binName(out mut []int, k int) {
    if k == BSub {
        obuf.Lit(mut out, "sub")
    } else if k == BMul {
        obuf.Lit(mut out, "mul")
    } else if k == BDiv {
        obuf.Lit(mut out, "div")
    } else if k == BMod {
        obuf.Lit(mut out, "mod")
    } else if k == BEq {
        obuf.Lit(mut out, "eq")
    } else if k == BNe {
        obuf.Lit(mut out, "ne")
    } else if k == BLe {
        obuf.Lit(mut out, "le")
    } else if k == BGt {
        obuf.Lit(mut out, "gt")
    } else if k == BGe {
        obuf.Lit(mut out, "ge")
    } else if k == BAnd {
        obuf.Lit(mut out, "and")
    } else if k == BOr {
        obuf.Lit(mut out, "or")
    } else if k == BXor {
        obuf.Lit(mut out, "xor")
    } else if k == BShl {
        obuf.Lit(mut out, "shl")
    } else if k == BShr {
        obuf.Lit(mut out, "shr")
    }
}

// spush は作業スタック（ヒープの st.jstk から (op, arg) の対 — 先頭 sp 対が生きている）に 1 対積み、新しい深さを返す。
// スタックを印字の関数の frame の mut slice に置くと、この関数は呼び手へ展開されるので出力 out と同じ region で交互に伸び、
// 伸びるたびにコピーが走る（region の上限 64MB で exit 102 — selfhost-drafts F-16）
func spush(st mut S, sp int, op int, x int) int {
    lset(mut st, st.jstk, sp * 2, op)
    lset(mut st, st.jstk, sp * 2 + 1, x)
    return sp + 1
}

// exprJson は式 e0 を印字する（明示スタック）
func exprJson(st mut S, out mut []int, e0 int) {
    mut nl := 0
    mut sp := spush(mut st, 0, OE, e0)
    while sp > 0 {
        sp -= 1
        op := hget(mut st, st.jstk + 1 + sp * 2)
        x := hget(mut st, st.jstk + 2 + sp * 2)
        if op == OS {
            emitFrag(mut out, x)
            continue
        }
        if op == OT {
            tyJson(mut st, mut out, x)
            continue
        }
        if op == OPop {
            nl -= 1
            continue
        }
        cx := coreAt(mut st, x)
        k := cx.tag
        a := cx.a
        b := cx.b
        c := cx.c
        d := cx.d
        // 積む順は印字の逆
        if k == CLit {
            obuf.Lit(mut out, "{\"k\":\"lit\",\"n\":")
            obuf.Int(mut out, a)
            out = append(out, 125)
        } else if k == CTT {
            obuf.Lit(mut out, "{\"k\":\"true\"}")
        } else if k == CFF {
            obuf.Lit(mut out, "{\"k\":\"false\"}")
        } else if k == CTriv {
            obuf.Lit(mut out, "{\"k\":\"triv\"}")
        } else if k == CVar {
            obuf.Lit(mut out, "{\"k\":\"var\",\"i\":")
            obuf.Int(mut out, a)
            out = append(out, 125)
        } else if k == CLet || k == CAdd || k == CLt || k == CPair || k == CAssign || k == CWhile || k == CAppend || k == CEqs || k == CConcat || k == CCallv {
            // node2
            if k == CLet {
                obuf.Lit(mut out, "{\"k\":\"let\",\"e\":")
            } else if k == CAdd {
                obuf.Lit(mut out, "{\"k\":\"add\",\"a\":")
            } else if k == CLt {
                obuf.Lit(mut out, "{\"k\":\"lt\",\"a\":")
            } else if k == CPair {
                obuf.Lit(mut out, "{\"k\":\"pair\",\"a\":")
            } else if k == CAssign {
                obuf.Lit(mut out, "{\"k\":\"assign\",\"l\":")
            } else if k == CWhile {
                obuf.Lit(mut out, "{\"k\":\"while\",\"c\":")
            } else if k == CAppend {
                obuf.Lit(mut out, "{\"k\":\"append\",\"e\":")
            } else if k == CEqs {
                obuf.Lit(mut out, "{\"k\":\"eqs\",\"a\":")
            } else if k == CConcat {
                obuf.Lit(mut out, "{\"k\":\"concat\",\"a\":")
            } else {
                obuf.Lit(mut out, "{\"k\":\"callv\",\"f\":")
            }
            f2 := if k == CLet { 3 } else if k == CAssign || k == CCallv { 2 } else if k == CWhile { 3 } else if k == CAppend { 11 } else { 4 }
            sp = spush(mut st, sp, OS, 1)
            sp = spush(mut st, sp, OE, b)
            sp = spush(mut st, sp, OS, f2)
            sp = spush(mut st, sp, OE, a)
        } else if k == CBin {
            obuf.Lit(mut out, "{\"k\":\"")
            binName(mut out, a)
            obuf.Lit(mut out, "\",\"a\":")
            sp = spush(mut st, sp, OS, 1)
            sp = spush(mut st, sp, OE, c)
            sp = spush(mut st, sp, OS, 4)
            sp = spush(mut st, sp, OE, b)
        } else if k == CIte || k == CIfnil || k == CCase || k == CSetidx || k == CSubslice || k == CSetm {
            // node3
            if k == CIte {
                obuf.Lit(mut out, "{\"k\":\"if\",\"c\":")
            } else if k == CIfnil {
                obuf.Lit(mut out, "{\"k\":\"ifnil\",\"e\":")
            } else if k == CCase {
                obuf.Lit(mut out, "{\"k\":\"case\",\"e\":")
            } else if k == CSetidx {
                obuf.Lit(mut out, "{\"k\":\"setidx\",\"e\":")
            } else if k == CSubslice {
                obuf.Lit(mut out, "{\"k\":\"subslice\",\"e\":")
            } else {
                obuf.Lit(mut out, "{\"k\":\"setm\",\"e\":")
            }
            f2 := if k == CIte { 5 } else if k == CIfnil { 6 } else if k == CCase { 8 } else if k == CSetidx { 10 } else if k == CSubslice { 12 } else { 13 }
            f3 := if k == CIte { 2 } else if k == CIfnil { 7 } else if k == CCase { 9 } else if k == CSetidx || k == CSetm { 11 } else { 4 }
            sp = spush(mut st, sp, OS, 1)
            sp = spush(mut st, sp, OE, c)
            sp = spush(mut st, sp, OS, f3)
            sp = spush(mut st, sp, OE, b)
            sp = spush(mut st, sp, OS, f2)
            sp = spush(mut st, sp, OE, a)
        } else if k == CNil {
            obuf.Lit(mut out, "{\"k\":\"nil\",\"t\":")
            tyJson(mut st, mut out, a)
            out = append(out, 125)
        } else if k == CSome || k == CFst || k == CSnd || k == CBlock || k == CDeref || k == CFreeze || k == CLen || k == CLenm || k == CKeysm {
            // node1
            if k == CSome {
                obuf.Lit(mut out, "{\"k\":\"some\",\"e\":")
            } else if k == CFst {
                obuf.Lit(mut out, "{\"k\":\"fst\",\"e\":")
            } else if k == CSnd {
                obuf.Lit(mut out, "{\"k\":\"snd\",\"e\":")
            } else if k == CBlock {
                obuf.Lit(mut out, "{\"k\":\"block\",\"e\":")
            } else if k == CDeref {
                obuf.Lit(mut out, "{\"k\":\"deref\",\"e\":")
            } else if k == CFreeze {
                obuf.Lit(mut out, "{\"k\":\"freeze\",\"e\":")
            } else if k == CLen {
                obuf.Lit(mut out, "{\"k\":\"len\",\"e\":")
            } else if k == CLenm {
                obuf.Lit(mut out, "{\"k\":\"lenm\",\"e\":")
            } else {
                obuf.Lit(mut out, "{\"k\":\"keysm\",\"e\":")
            }
            sp = spush(mut st, sp, OS, 1)
            sp = spush(mut st, sp, OE, a)
        } else if k == CAnn || k == CBlockR {
            // {"k":"ann","e":E,"t":T} / {"k":"block","e":E,"t":T}（blockR は a = 型, b = e）
            obuf.Lit(mut out, if k == CAnn { "{\"k\":\"ann\",\"e\":" } else { "{\"k\":\"block\",\"e\":" })
            sp = spush(mut st, sp, OS, 1)
            sp = spush(mut st, sp, OT, if k == CAnn { b } else { a })
            sp = spush(mut st, sp, OS, 5)
            sp = spush(mut st, sp, OE, if k == CAnn { a } else { b })
        } else if k == CInl || k == CInr {
            obuf.Lit(mut out, if k == CInl { "{\"k\":\"inl\",\"r\":" } else { "{\"k\":\"inr\",\"l\":" })
            tyJson(mut st, mut out, a)
            obuf.Lit(mut out, ",\"e\":")
            sp = spush(mut st, sp, OS, 1)
            sp = spush(mut st, sp, OE, b)
        } else if k == CCall {
            obuf.Lit(mut out, if d != 0 { "{\"k\":\"callm\",\"f\":" } else { "{\"k\":\"call\",\"f\":" })
            obuf.Int(mut out, a)
            tsJson(mut st, mut out, c)
            obuf.Lit(mut out, ",\"e\":")
            sp = spush(mut st, sp, OS, 1)
            sp = spush(mut st, sp, OE, b)
        } else if k == CFnref {
            obuf.Lit(mut out, "{\"k\":\"fnref\",\"f\":")
            obuf.Int(mut out, a)
            tsJson(mut st, mut out, b)
            out = append(out, 125)
        } else if k == CAlloc {
            obuf.Lit(mut out, "{\"k\":\"alloc\",\"mut\":")
            putBool(mut out, a != 0)
            obuf.Lit(mut out, ",\"e\":")
            sp = spush(mut st, sp, OS, 1)
            sp = spush(mut st, sp, OE, b)
        } else if k == CStrlit {
            obuf.Lit(mut out, "{\"k\":\"strlit\",\"bs\":[")
            mut i := 0
            while i < dat(mut st, a) {
                if i > 0 {
                    out = append(out, 44)
                }
                obuf.Int(mut out, dat(mut st, a + 1 + i))
                i += 1
            }
            obuf.Lit(mut out, "],\"r\":")
            obuf.Int(mut out, b)
            out = append(out, 125)
        } else if k == CMkslice {
            obuf.Lit(mut out, "{\"k\":\"mkslice\",\"m\":")
            putBool(mut out, a != 0)
            obuf.Lit(mut out, ",\"t\":")
            tyJson(mut st, mut out, b)
            out = append(out, 125)
        } else if k == CIndex {
            obuf.Lit(mut out, "{\"k\":\"index\",\"e\":")
            sp = spush(mut st, sp, OS, 1)
            if c >= 0 {
                sp = spush(mut st, sp, OT, c)
                sp = spush(mut st, sp, OS, 5)
            }
            sp = spush(mut st, sp, OE, b)
            sp = spush(mut st, sp, OS, 10)
            sp = spush(mut st, sp, OE, a)
        } else if k == CMkmap {
            obuf.Lit(mut out, "{\"k\":\"mkmap\",\"m\":")
            putBool(mut out, a != 0)
            obuf.Lit(mut out, ",\"key\":")
            tyJson(mut st, mut out, b)
            obuf.Lit(mut out, ",\"t\":")
            tyJson(mut st, mut out, c)
            out = append(out, 125)
        } else if k == CGetm || k == CDelm {
            obuf.Lit(mut out, if k == CGetm { "{\"k\":\"getm\",\"t\":" } else { "{\"k\":\"delm\",\"t\":" })
            tyJson(mut st, mut out, a)
            obuf.Lit(mut out, ",\"e\":")
            sp = spush(mut st, sp, OS, 1)
            sp = spush(mut st, sp, OE, c)
            sp = spush(mut st, sp, OS, 13)
            sp = spush(mut st, sp, OE, b)
        } else if k == CLabel {
            if !lab(mut st, a).used {
                sp = spush(mut st, sp, OE, c)
            } else {
                lset(mut st, st.jlab, nl, lab(mut st, a).id)
                nl += 1
                obuf.Lit(mut out, "{\"k\":\"label\",\"t\":")
                tyJson(mut st, mut out, b)
                obuf.Lit(mut out, ",\"e\":")
                sp = spush(mut st, sp, OS, 1)
                sp = spush(mut st, sp, OPop, 0)
                if d == WDiscard {
                    obuf.Lit(mut out, "{\"k\":\"let\",\"e\":")
                    sp = spush(mut st, sp, OS, 15)
                } else if d == WAnn {
                    obuf.Lit(mut out, "{\"k\":\"ann\",\"e\":")
                    sp = spush(mut st, sp, OS, 1)
                    sp = spush(mut st, sp, OT, b)
                    sp = spush(mut st, sp, OS, 5)
                }
                sp = spush(mut st, sp, OE, c)
            }
        } else if k == CJump {
            // 添字 = 印字中の囲むラベルのうち、目標より内側にある数
            mut n := 0
            mut j := nl - 1
            while j >= 0 && hget(mut st, st.jlab + 1 + j) != a {
                n += 1
                j -= 1
            }
            obuf.Lit(mut out, "{\"k\":\"jump\",\"n\":")
            obuf.Int(mut out, n)
            obuf.Lit(mut out, ",\"t\":")
            tyJson(mut st, mut out, b)
            obuf.Lit(mut out, ",\"e\":")
            sp = spush(mut st, sp, OS, 1)
            sp = spush(mut st, sp, OE, c)
        }
    }
}

// defJson は Def 1 つ（[param, ret, body, tparams]）を印字する
func defJson(st mut S, out mut []int, d int) {
    out = append(out, 123)
    if hget(mut st, d + 3) > 0 {
        obuf.Lit(mut out, "\"tparams\":")
        obuf.Int(mut out, hget(mut st, d + 3))
        out = append(out, 44)
    }
    obuf.Lit(mut out, "\"param\":")
    tyJson(mut st, mut out, hget(mut st, d))
    obuf.Lit(mut out, ",\"ret\":")
    tyJson(mut st, mut out, hget(mut st, d + 1))
    obuf.Lit(mut out, ",\"body\":")
    exprJson(mut st, mut out, hget(mut st, d + 2))
    out = append(out, 125)
}
