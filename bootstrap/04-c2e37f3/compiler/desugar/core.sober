package desugar

import "std/iter"
import "std/table"

// コア式（Lean の Expr と同形 — 5 語 [tag, a, b, c, d]）

const CLit = 1       // a = 値
const CTT = 2
const CFF = 3
const CTriv = 4
const CVar = 5       // a = de Bruijn 添字
const CLet = 6       // a = e, b = body
const CAdd = 7       // a, b
const CLt = 8        // a, b
const CBin = 9       // a = 種類（B*）, b, c
const CIte = 10      // a = c, b = t, c = e
const CNil = 11      // a = 型
const CSome = 12     // a
const CIfnil = 13    // a = e, b = nil, c = some
const CInl = 14      // a = r（型）, b = e
const CInr = 15      // a = l（型）, b = e
const CCase = 16     // a = e, b = l, c = r
const CPair = 17     // a, b
const CFst = 18      // a
const CSnd = 19      // a
const CCall = 20     // a = 関数の添字, b = e, c = 型引数の列（-1 = 無し）, d = callm
const CFnref = 21    // a = 関数の添字, b = 型引数の列（-1 = 無し）
const CCallv = 22    // a = f, b = e
const CAnn = 23      // a = e, b = 型
const CBlock = 24    // a
const CBlockR = 25   // a = 型, b = e
const CAlloc = 26    // a = m, b = e
const CDeref = 27    // a
const CAssign = 28   // a = l, b = e
const CWhile = 29    // a = c, b = body
const CFreeze = 30   // a
const CMkslice = 31  // a = m, b = 型
const CIndex = 32    // a = e, b = i, c = 型（-1 = 注釈なし）
const CLen = 33      // a
const CAppend = 34   // a = e, b = v
const CSetidx = 35   // a = e, b = i, c = v
const CSubslice = 36 // a = e, b = a, c = b
const CEqs = 37      // a, b
const CConcat = 38   // a, b
const CMkmap = 39    // a = m, b = キー型, c = 値型
const CGetm = 40     // a = 型, b = e, c = key
const CSetm = 41     // a = e, b = key, c = v
const CDelm = 42     // a = 型, b = e, c = key
const CLenm = 43     // a
const CLabel = 44    // a = ラベルの記録（LB*）, b = 型, c = e, d = 整形（W*）
const CJump = 45     // a = ラベルの id, b = 型, c = e
const CStrlit = 46   // a = バイト列（ヒープの文字列）, b = region（Lean の strlit — region b の imm int セル列）
const CKeysm = 47    // a（keysm の段 — map のキー列のスナップショット）

// arith / cmp ファミリの種類
const BSub = 1
const BMul = 2
const BDiv = 3
const BMod = 4
const BEq = 5
const BNe = 6
const BLe = 7
const BGt = 8
const BGe = 9
const BAnd = 10
const BOr = 11
const BXor = 12
const BShl = 13
const BShr = 14

// ラベルの整形
const WNone = 0
const WDiscard = 1
const WAnn = 2

// CoreExpr はコア式 1 つ（st.cores の要素 — 作ったら変えない）。参照 = CBASE + 添字（ヒープの番地・型の参照と取り違えて読むと
// 範囲外で panic する）
type CoreExpr struct {
    tag int
    a int
    b int
    c int
    d int
}

const CBASE = 2199023255552

// ce はコア式を作る
func ce(st mut S, tag int, a int, b int, c int, d int) int {
    n := table.Len(mut st.cores)
    table.Push(mut st.cores, CoreExpr{tag: tag, a: a, b: b, c: c, d: d})
    return CBASE + n
}

// coreAt はコア式 x の記録（非ジェネリックの包み — F-10）
func coreAt(st mut S, x int) CoreExpr {
    return table.Get(mut st.cores, x - CBASE)
}

func cLit(st mut S, n int) int {
    return ce(mut st, CLit, n, 0, 0, 0)
}

func cVar(st mut S, i int) int {
    return ce(mut st, CVar, i, 0, 0, 0)
}

func cTriv(st mut S) int {
    return ce(mut st, CTriv, 0, 0, 0, 0)
}

func cTT(st mut S) int {
    return ce(mut st, CTT, 0, 0, 0, 0)
}

func cFF(st mut S) int {
    return ce(mut st, CFF, 0, 0, 0, 0)
}

func cLet(st mut S, e int, body int) int {
    return ce(mut st, CLet, e, body, 0, 0)
}

func c1(st mut S, tag int, a int) int {
    return ce(mut st, tag, a, 0, 0, 0)
}

func c2(st mut S, tag int, a int, b int) int {
    return ce(mut st, tag, a, b, 0, 0)
}

func c3(st mut S, tag int, a int, b int, c int) int {
    return ce(mut st, tag, a, b, c, 0)
}

func cAnn(st mut S, e int, t int) int {
    return ce(mut st, CAnn, e, t, 0, 0)
}

func cIte(st mut S, c int, t int, e int) int {
    return ce(mut st, CIte, c, t, e, 0)
}

func cBin(st mut S, k int, a int, b int) int {
    return ce(mut st, CBin, k, a, b, 0)
}

// pairChain は値の列 → 右結合の pair 鎖（0 は triv、1 は素の値）
func pairChain(st mut S, l int) int {
    n := llen(mut st, l)
    if n == 0 {
        return cTriv(mut st)
    }
    mut acc := lat(mut st, l, n - 1)
    mut i := n - 2
    while i >= 0 {
        acc = c2(mut st, CPair, lat(mut st, l, i), acc)
        i -= 1
    }
    return acc
}

// projection は n フィールドの i 番目の射影（i < n-1 は fst(snd^i)、i = n-1 は snd^(n-1)）
func projection(st mut S, base int, i int, n int) int {
    mut cur := base
    for k <- iter.Range(0, i) {
        cur = c1(mut st, CSnd, cur)
    }
    if n >= 2 && i < n - 1 {
        cur = c1(mut st, CFst, cur)
    }
    return cur
}

// wrapLets は e の列を外側から let で被せる（列の先頭が最外）
func wrapLets(st mut S, lets int, body int) int {
    mut out := body
    mut i := llen(mut st, lets) - 1
    while i >= 0 {
        out = cLet(mut st, lat(mut st, lets, i), out)
        i -= 1
    }
    return out
}
