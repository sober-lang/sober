package loader

// `@embed("glob")`（language.md 20 節 — go:embed の意味論。src/embed.zig と src/loader.zig の embedConst の写し）。
// パターンはルート（= cwd）相対の `/` 区切り。`**` はセグメントまるごとで 0 個以上のディレクトリ、`*` は `/` を含まない任意の列、
// `?` は 1 バイト。最後のセグメントは通常ファイルにだけ、途中はディレクトリにだけ当たる（symlink は当たらない）。
// 受け皿 `map[string]string{}` を「パス → 内容」の map リテラル（パスのバイト辞書順）に置き換えた木を作り直す

import "std/builder"
import "std/io"
import "std/iter"
import "std/utf8"
import "ast"

// validPattern は src/embed.zig の validPattern と同じ拒否（空・先頭 `/`・空セグメント・`.` / `..`・セグメントの一部の `**`・`[` と `\`）
func validPattern(p []int) bool {
    if len(p) == 0 || p[0] == 47 {
        return false
    }
    segs := split(p)
    for i <- iter.Range(0, len(segs)) {
        s := segs[i]
        if len(s) == 0 || EqLit(s, ".") || EqLit(s, "..") {
            return false
        }
        for j <- iter.Range(0, len(s)) {
            if s[j] == 91 || s[j] == 92 {
                return false
            }
            if s[j] == 42 && j + 1 < len(s) && s[j + 1] == 42 && !EqLit(s, "**") {
                return false
            }
        }
    }
    return true
}

// split は `/` で割る
func split(p []int) [][]int {
    mut out := mut [][]int{}
    mut s := 0
    mut i := 0
    while i <= len(p) {
        if i == len(p) || p[i] == 47 {
            out = append(out, p[s:i])
            s = i + 1
        }
        i += 1
    }
    return freeze(out)
}

// matchSeg はセグメント 1 つの照合（pat[pi:] と name[ni:]）
func matchSeg(pat []int, pi int, name []int, ni int) bool {
    if pi == len(pat) {
        return ni == len(name)
    }
    if pat[pi] == 42 {
        mut k := ni
        while k <= len(name) {
            if matchSeg(pat, pi + 1, name, k) {
                return true
            }
            k += 1
        }
        return false
    }
    if ni == len(name) {
        return false
    }
    if pat[pi] != 63 && pat[pi] != name[ni] {
        return false
    }
    return matchSeg(pat, pi + 1, name, ni + 1)
}

func join(dir []int, name []int) []int {
    if len(dir) == 0 {
        return name
    }
    return cat(cat(dir, bytes("/")), name)
}

// orDot は dir、空なら "."（ReadDir に渡す名前）。if 式の腕に「リテラル」と「仮引数」を並べると腕の region が合わない（F-35 — 腕の合流は
// 直さない側）ので、腕ごとに return する
func orDot(dir []int) []int {
    if len(dir) == 0 {
        return bytes(".")
    }
    return dir
}

// walk は dir（ルート相対、空 = ルート）の中で segs[si:] を照合し、当たったファイルのパスを返す。開けないディレクトリは当たりなし
func walk(dir []int, segs [][]int, si int) [][]int {
    mut out := mut [][]int{}
    if si == len(segs) {
        return freeze(out)
    }
    seg := segs[si]
    star2 := EqLit(seg, "**")
    if star2 {
        sub := walk(dir, segs, si + 1)
        for k <- iter.Range(0, len(sub)) {
            out = append(out, sub[k])
        }
    }
    dname, derr := string(orDot(dir))
    if derr != nil {
        return freeze(out)
    }
    es, err := io.ReadDir(dname)
    if err != nil {
        return freeze(out)
    }
    mut i := 0
    while i < len(es) {
        e := es[i]
        nm := bytes(e.Name)
        child := join(dir, nm)
        entDir := switch e.Kind {
        case io.Dir{}: true
        default: false
        }
        entFile := switch e.Kind {
        case io.File{}: true
        default: false
        }
        mut sub := [][]int{}
        if star2 {
            if entDir {
                sub = walk(child, segs, si)
            }
        } else if matchSeg(seg, 0, nm, 0) {
            if si + 1 == len(segs) {
                if entFile {
                    out = append(out, child)
                }
            } else if entDir {
                sub = walk(child, segs, si + 1)
            }
        }
        for k <- iter.Range(0, len(sub)) {
            out = append(out, sub[k])
        }
        i += 1
    }
    return freeze(out)
}

// expand は pat に合うファイルのパスをバイト辞書順・重複なしで返す（pat は validPattern 済み）
func expand(pat []int) [][]int {
    ps := walk([]int{}, split(pat), 0)
    // 挿入ソート（件数はパターンの当たりの数 — std 全体で数十）
    mut xs := mut [][]int{}
    mut i := 0
    while i < len(ps) {
        xs = append(xs, ps[i])
        mut m := len(xs) - 1
        while m > 0 && Less(xs[m], xs[m - 1]) {
            t := xs[m]
            xs[m] = xs[m - 1]
            xs[m - 1] = t
            m -= 1
        }
        i += 1
    }
    mut out := mut [][]int{}
    i = 0
    while i < len(xs) {
        if i == 0 || !Eq(xs[i], xs[i - 1]) {
            out = append(out, xs[i])
        }
        i += 1
    }
    return freeze(out)
}

// isStringName は型の節 ty が `string` か
func isStringName(t ast.Tree, ty int) bool {
    n := t.nodes[ty]
    return n.kind == ast.TName && EqLit(Str(t, n.a), "string")
}

// embedTree は木 t の @embed の const をすべて畳んだ木（失敗なら理由の綴り、成功なら ""）
func embedTree(t0 ast.Tree) (ast.Tree, string) {
    mut t := t0
    cl := t.nodes[t.file].e
    mut k := 0
    while k < ast.ListLen(t, cl) {
        c := ast.ListAt(t, cl, k)
        if t.nodes[c].f == 1 {
            nt, why := embedConst(t, c)
            if why != "" {
                return t, why
            }
            t = nt
        }
        k += 1
    }
    return t, ""
}

// embedConst は const の節 c の受け皿を検査し、パターンに合うファイルで埋めた map リテラルに差し替えた木を作る
func embedConst(t ast.Tree, c int) (ast.Tree, string) {
    x := t.nodes[c]
    recv := t.nodes[x.b]
    if recv.kind != ast.EMaplit || recv.d != 0 || ast.ListLen(t, recv.c) != 0 || !isStringName(t, recv.a) || !isStringName(t, recv.b) {
        return t, "@embed needs the receiver `map[string]string{}` (empty, imm)"
    }
    pat := Str(t, x.e)
    if !validPattern(pat) {
        return t, "invalid @embed pattern"
    }
    ps := expand(pat)
    if len(ps) == 0 {
        return t, "@embed pattern matches no file"
    }
    // 中身を先に全部読む（検査が通ってから木を組む）
    mut bodies := mut [][]int{}
    for i <- iter.Range(0, len(ps)) {
        if !utf8.Valid(ps[i]) {
            return t, "@embed path is not valid UTF-8"
        }
        b, ok := readPath(ps[i])
        if !ok {
            return t, "@embed cannot read file"
        }
        if !utf8.Valid(b) {
            return t, "@embed file is not valid UTF-8"
        }
        bodies = append(bodies, b)
    }
    bs := freeze(bodies)
    n0 := len(t.nodes)
    n := len(ps)
    mut nb := builder.Builder[ast.Node]{}
    mut db := builder.Builder[int]{}
    mut j := 0
    while j < len(t.data) {
        builder.Push(mut db, t.data[j])
        j += 1
    }
    // 足す節: ファイルごとに (キーの strlit, 値の strlit, KEntry)、最後に EMaplit
    mut ents := mut []int{}
    mut strs := mut []int{}
    for i <- iter.Range(0, n) {
        strs = append(strs, ast.PutBytes(mut db, ps[i], 0, len(ps[i])))
        strs = append(strs, ast.PutBytes(mut db, bs[i], 0, len(bs[i])))
        ents = append(ents, n0 + 3 * i + 2)
    }
    el := ast.PutList(mut db, freeze(ents))
    j = 0
    while j < n0 {
        if j == c {
            builder.Push(mut nb, ast.Node{x.kind, x.tok, x.a, n0 + 3 * n, x.c, x.d, x.e, x.f})
        } else {
            builder.Push(mut nb, t.nodes[j])
        }
        j += 1
    }
    for i <- iter.Range(0, n) {
        builder.Push(mut nb, ast.Node{ast.EStrlit, recv.tok, strs[2 * i], 0, 0, 0, 0, 0})
        builder.Push(mut nb, ast.Node{ast.EStrlit, recv.tok, strs[2 * i + 1], 0, 0, 0, 0, 0})
        builder.Push(mut nb, ast.Node{ast.KEntry, recv.tok, n0 + 3 * i, n0 + 3 * i + 1, 0, 0, 0, 0})
    }
    builder.Push(mut nb, ast.Node{ast.EMaplit, recv.tok, recv.a, recv.b, el, 0, 0, 0})
    return ast.Tree{builder.Build(mut nb), builder.Build(mut db), t.file}, ""
}

// embedAll は全ファイルの @embed を畳む
func embedAll(ts []ast.Tree) ([]ast.Tree, string) {
    mut out := mut []ast.Tree{}
    for i <- iter.Range(0, len(ts)) {
        t, why := embedTree(ts[i])
        if why != "" {
            return []ast.Tree{}, why
        }
        out = append(out, t)
    }
    return freeze(out), ""
}
