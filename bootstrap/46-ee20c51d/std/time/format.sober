package time

import "std/iter"

func pad(n int, w int) string {
    mut s := "${n}"
    mut k := len(bytes(s))
    while k < w {
        s = "0${s}"
        k += 1
    }
    return s
}

func monthName(m int) string {
    return []string{"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"}[m - 1]
}

func dayName(w int) string {
    return []string{"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"}[w]
}

// t の RFC 3339（`YYYY-MM-DDThh:mm:ssZ`・オフセットが 0 でなければ末尾が `+hh:mm` の形・端数の秒があれば末尾の 0 を落として最大 9 桁）。
// offset は秒（東が正 — 分の単位に切り捨て・±23:59 まで）。年は 0000〜9999 の範囲で
@effects()
func FormatRFC3339(t Time, offset int) string {
    c := ToCivil(t, offset)
    mut s := "${pad(c.year, 4)}-${pad(c.month, 2)}-${pad(c.day, 2)}T${pad(c.hour, 2)}:${pad(c.minute, 2)}:${pad(c.second, 2)}"
    if c.nsec > 0 {
        mut f := pad(c.nsec, 9)
        while len(bytes(f)) > 1 && strEndsWith0(f) {
            fb := bytes(f)
            f = bytesToString(fb[0:len(fb) - 1])
        }
        s = "${s}.${f}"
    }
    if offset == 0 {
        return "${s}Z"
    }
    a := if offset < 0 { -offset } else { offset }
    sign := if offset < 0 { "-" } else { "+" }
    return "${s}${sign}${pad(a / 3600, 2)}:${pad(a / 60 % 60, 2)}"
}

func strEndsWith0(s string) bool {
    b := bytes(s)
    return len(b) > 0 && b[len(b) - 1] == '0'
}

// s（RFC 3339 の date-time — `T` / `t`・`Z` / `z` / ±hh:mm・端数の秒は 1〜9 桁）の時刻
@errors(Bad)
@effects()
func ParseRFC3339(s string) (Time, error?) {
    b := bytes(s)
    if len(b) < 20 || b[4] != '-' || b[7] != '-' || (b[10] != 'T' && b[10] != 't') || b[13] != ':' || b[16] != ':' {
        return Time{sec: 0, nsec: 0}, Bad{}
    }
    y := digits(b, 0, 4)
    mo := digits(b, 5, 2)
    d := digits(b, 8, 2)
    h := digits(b, 11, 2)
    mi := digits(b, 14, 2)
    se := digits(b, 17, 2)
    if y < 0 || mo < 1 || mo > 12 || d < 1 || d > monthDays(y, mo) || h < 0 || h > 23 || mi < 0 || mi > 59 || se < 0 || se > 59 {
        return Time{sec: 0, nsec: 0}, Bad{}
    }
    mut at := 19
    mut ns := 0
    if at < len(b) && b[at] == '.' {
        at += 1
        mut k := 0
        while at < len(b) && b[at] >= '0' && b[at] <= '9' {
            if k >= 9 {
                return Time{sec: 0, nsec: 0}, Bad{}
            }
            ns = ns * 10 + int(b[at]) - 48
            k += 1
            at += 1
        }
        if k == 0 {
            return Time{sec: 0, nsec: 0}, Bad{}
        }
        for i <- iter.Range(k, 9) {
            ns = ns * 10
        }
    }
    mut off := 0
    if at + 1 == len(b) && (b[at] == 'Z' || b[at] == 'z') {
        off = 0
    } else if at + 6 == len(b) && (b[at] == '+' || b[at] == '-') && b[at + 3] == ':' {
        oh := digits(b, at + 1, 2)
        om := digits(b, at + 4, 2)
        if oh < 0 || oh > 23 || om < 0 || om > 59 {
            return Time{sec: 0, nsec: 0}, Bad{}
        }
        off = (oh * 3600 + om * 60) * (if b[at] == '-' { -1 } else { 1 })
    } else {
        return Time{sec: 0, nsec: 0}, Bad{}
    }
    return FromCivil(Civil{year: y, month: mo, day: d, hour: h, minute: mi, second: se, nsec: ns, weekday: 0}, off), nil
}

// b[at:at+n] の 10 進（数字でなければ -1）
func digits(b []byte, at int, n int) int {
    if at + n > len(b) {
        return -1
    }
    mut v := 0
    for i <- iter.Range(at, at + n) {
        x := b[i]
        if x < '0' || x > '9' {
            return -1
        }
        v = v * 10 + int(x) - 48
    }
    return v
}

// t の HTTP の日付（IMF-fixdate — `Sun, 06 Nov 1994 08:49:37 GMT`・RFC 9110 5.6.7。端数の秒は落とす）
@effects()
func FormatHTTP(t Time) string {
    c := ToCivil(t, 0)
    return "${dayName(c.weekday)}, ${pad(c.day, 2)} ${monthName(c.month)} ${pad(c.year, 4)} ${pad(c.hour, 2)}:${pad(c.minute, 2)}:${pad(c.second, 2)} GMT"
}

// s の HTTP の日付（IMF-fixdate と、受け手が読む旧い 2 形 — rfc850 `Sunday, 06-Nov-94 08:49:37 GMT`〔2 桁の年は 70 未満を 20YY〕・
// asctime `Sun Nov  6 08:49:37 1994`。曜日の綴りは見るが日付との一致は問わない — RFC 9110 5.6.7）
@errors(Bad)
@effects()
func ParseHTTP(s string) (Time, error?) {
    b := bytes(s)
    if len(b) == 29 && b[3] == ',' && b[4] == ' ' && b[7] == ' ' && b[11] == ' ' && b[16] == ' ' && b[25] == ' ' && bytesToString(b[26:29]) == "GMT" {
        return hms(digits(b, 12, 4), monthOf(b, 8), digits(b, 5, 2), b, 17)
    }
    if len(b) == 24 && b[3] == ' ' && b[7] == ' ' && b[10] == ' ' && b[19] == ' ' {
        dd := if b[8] == ' ' { digits(b, 9, 1) } else { digits(b, 8, 2) }
        return hms(digits(b, 20, 4), monthOf(b, 4), dd, b, 11)
    }
    comma := indexOf(b, ',')
    if comma > 0 && comma + 24 == len(b) && b[comma + 1] == ' ' && b[comma + 4] == '-' && b[comma + 8] == '-' && b[comma + 11] == ' ' && bytesToString(b[comma + 21:len(b)]) == "GMT" {
        yy := digits(b, comma + 9, 2)
        y := if yy < 0 { -1 } else if yy < 70 { 2000 + yy } else { 1900 + yy }
        return hms(y, monthOf(b, comma + 5), digits(b, comma + 2, 2), b, comma + 12)
    }
    return Time{sec: 0, nsec: 0}, Bad{}
}

// 年月日と b[at:] の `HH:MM:SS` の時刻（範囲の外は Bad）
func hms(y int, mo int, d int, b []byte, at int) (Time, error?) {
    if at + 8 > len(b) || b[at + 2] != ':' || b[at + 5] != ':' {
        return Time{sec: 0, nsec: 0}, Bad{}
    }
    h := digits(b, at, 2)
    mi := digits(b, at + 3, 2)
    se := digits(b, at + 6, 2)
    if y < 0 || mo < 1 || d < 1 || d > monthDays(y, mo) || h < 0 || h > 23 || mi < 0 || mi > 59 || se < 0 || se > 60 {
        return Time{sec: 0, nsec: 0}, Bad{}
    }
    return FromCivil(Civil{year: y, month: mo, day: d, hour: h, minute: mi, second: if se == 60 { 59 } else { se }, nsec: 0, weekday: 0}, 0), nil
}

// b[at:at+3] の月の綴り（Jan〜Dec — 大文字小文字を区別する）の 1〜12（他は 0）
func monthOf(b []byte, at int) int {
    if at + 3 > len(b) {
        return 0
    }
    w := bytesToString(b[at:at + 3])
    for m <- iter.Range(1, 13) {
        if monthName(m) == w {
            return m
        }
    }
    return 0
}

func indexOf(b []byte, c byte) int {
    for i <- iter.Range(0, len(b)) {
        if b[i] == c {
            return i
        }
    }
    return -1
}
