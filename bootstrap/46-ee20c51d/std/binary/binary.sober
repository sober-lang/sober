package binary

// バイト列の語単位の読み（1 バイトずつの読みを 1 回の検査 + 1 回の load に）と末尾への語の書き（AppendWord）。途中の位置を書き換える口（Store64）は無い

// 組み込みの宣言（本体なし。実装はコンパイラの表: loader/intrinsic.sober・lower の ioBuiltin）。検査なしの読み — 境界は下の Load64 の 1 か所だけで見る
@intrinsic("load64")
func sysLoad64(b []byte, i int) int

// b[i]〜b[i + 7] の 8 バイトを little-endian で読んだ int（b[i] が最下位のバイト）。i < 0 か i + 8 > len(b) なら panic(OutOfRange{i, len(b)})
// （検査は 1 か所 — `i > len(b) - 8` は len(b) ≥ 0 なので桁あふれしない）
@effects(panic)
func Load64(b []byte, i int) int {
    if i < 0 || i > len(b) - 8 {
        outOfRange(i, len(b))
    }
    return sysLoad64(b, i)
}

// Load64 / MatchLen の契約違反の panic（本体を小さく保つ — 呼び出し点に展開される大きさに）
func outOfRange(i int, n int) {
    panic(OutOfRange{i: i, n: n})
}

// Load64 / MatchLen の読みが b の外にはみ出した・AppendWord の k が 0〜8 の外（呼び手の契約違反 — panic ラベル。language.md 27 節）
type OutOfRange panic {
    i int
    n int
}

// 一致の長さの組み込み（検査なし — 境界は下の MatchLen の 1 か所だけで見る・rt.matchlen — x86 の最適化のバックエンドは手書きの本体）
@intrinsic("matchlen")
func sysMatchLen(b []byte, i int, j int, n int) int

// b[i:i+n] と b[j:j+n] の先頭からの一致の長さ（0〜n — 最初に食い違うバイトの位置・全部一致なら n）。区間は重なってよい。
// i < 0・j < 0・n < 0・i + n > len(b)・j + n > len(b) のどれかなら panic(OutOfRange{…})（検査は 1 か所 — 読むのは 2 つの区間の中だけ）。
// 最初の食い違いで止まるので時間は一致の長さに依る（秘密の比較には使わない — 定数時間の比較は std/crypto/ct）
@effects(panic)
func MatchLen(b []byte, i int, j int, n int) int {
    if i < 0 || j < 0 || n < 0 || i > len(b) - n || j > len(b) - n {
        outOfRange(if i > j { i } else { j }, len(b))
    }
    return sysMatchLen(b, i, j, n)
}

// 末尾への語の書きの組み込み（v を 8 バイト書いて長さを k 進めた列か、b を伸ばせる位置になければ b のまま — 検査なし。
// k の範囲は下の AppendWord が見る・b は AppendWord の mut の束縛の値）
@intrinsic("appendword")
func sysAppendWord(b []byte, v int, k int) mut []byte

// v の下位 k バイトを b の末尾に積む（v の最下位のバイトが先 — little-endian）。k < 0 か k > 8 なら panic(OutOfRange{k, 8})。
// 結果は byte(v & 0xff), byte((v >> 8) & 0xff), … を k 回 append したのと同じで、b が伸ばせる位置にあれば検査 1 回・書き 1 本で済む
// （ビットの溜めの吐き出し・可変長の整数の書き）
@effects(panic)
func AppendWord(b mut []byte, v int, k int) {
    if k < 0 || k > 8 {
        outOfRange(k, 8)
    }
    n := len(b)
    b = sysAppendWord(b, v, k)
    if len(b) == n {
        appendBytes(mut b, v, k)
    }
}

// AppendWord の遅い道（b が伸ばせる位置にない — 1 バイトずつ。k = 0 なら何もしない）
func appendBytes(b mut []byte, v int, k int) {
    mut x := v
    mut i := 0
    while i < k {
        b = append(b, byte(x & 0xff))
        x = x >> 8
        i += 1
    }
}
