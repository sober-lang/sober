package x509

// 拡張の読み（RFC 5280 4.2.1 — basicConstraints・keyUsage・extKeyUsage・subjectAltName・subjectKeyIdentifier・authorityKeyIdentifier）。
// 同じ拡張の 2 本目は拒否。知らない拡張は exts に残すだけ（critical の扱いは鎖の側）

import "std/iter"

func parseExts(b []byte, x El, c mut Cert) bool {
    sq, ok := firstChild(b, x)
    if !ok || sq.tag != 0x30 || sq.ce != x.ce || sq.ce == sq.cs {
        return false
    }
    mut list := mut []Ext{}
    mut at := sq.cs
    while at < sq.ce {
        e, oke := elAt(b, at, sq.ce)
        if !oke || e.tag != 0x30 {
            return false
        }
        o, oko := firstChild(b, e)
        if !oko || o.tag != 0x06 {
            return false
        }
        n1, okn := nextEl(b, o, e.ce)
        if !okn {
            return false
        }
        mut crit := false
        mut v := n1
        if n1.tag == 0x01 {
            if n1.ce - n1.cs != 1 || (b[n1.cs] != byte(0) && b[n1.cs] != byte(0xff)) {
                return false
            }
            crit = b[n1.cs] == byte(0xff)
            v2, okv := nextEl(b, n1, e.ce)
            if !okv {
                return false
            }
            v = v2
        }
        if v.tag != 0x04 || v.ce != e.ce {
            return false
        }
        oid := content(b, o)
        for k <- iter.Range(0, len(list)) {
            if same(list[k].oid, oid) {
                return false
            }
        }
        list = append(list, Ext{oid: oid, critical: crit, value: content(b, v)})
        if !decodeExt(oid, content(b, v), mut c) {
            return false
        }
        at = e.ce
    }
    c.exts = freeze(list)
    return true
}

func same(a []byte, b []byte) bool {
    if len(a) != len(b) {
        return false
    }
    for i <- iter.Range(0, len(a)) {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

// 知っている拡張の中身 v を c の欄へ
func decodeExt(oid []byte, v []byte, c mut Cert) bool {
    if same(oid, hexBytes("551d13")) {
        return basicConstraints(v, mut c)
    }
    if same(oid, hexBytes("551d0f")) {
        return keyUsage(v, mut c)
    }
    if same(oid, hexBytes("551d25")) {
        return extKeyUsage(v, mut c)
    }
    if same(oid, hexBytes("551d11")) {
        return subjectAltName(v, mut c)
    }
    if same(oid, hexBytes("551d0e")) {
        e, ok := elAt(v, 0, len(v))
        if !ok || e.tag != 0x04 || e.ce != len(v) {
            return false
        }
        c.ski = content(v, e)
        return true
    }
    if same(oid, hexBytes("551d1e")) {
        return nameConstraints(v, mut c)
    }
    if same(oid, hexBytes("551d23")) {
        s, ok := elAt(v, 0, len(v))
        if !ok || s.tag != 0x30 || s.ce != len(v) {
            return false
        }
        mut at := s.cs
        while at < s.ce {
            k, okk := elAt(v, at, s.ce)
            if !okk {
                return false
            }
            if k.tag == 0x80 {
                c.aki = content(v, k)
            }
            at = k.ce
        }
        return true
    }
    return true
}

// BasicConstraints ::= SEQUENCE { cA BOOLEAN DEFAULT FALSE, pathLenConstraint INTEGER (0..MAX) OPTIONAL }
func basicConstraints(v []byte, c mut Cert) bool {
    s, ok := elAt(v, 0, len(v))
    if !ok || s.tag != 0x30 || s.ce != len(v) {
        return false
    }
    c.bcValid = true
    mut at := s.cs
    if at < s.ce {
        e, oke := elAt(v, at, s.ce)
        if !oke {
            return false
        }
        if e.tag == 0x01 {
            if e.ce - e.cs != 1 || (v[e.cs] != byte(0) && v[e.cs] != byte(0xff)) {
                return false
            }
            c.isCA = v[e.cs] == byte(0xff)
            at = e.ce
        }
    }
    if at < s.ce {
        p, okp := elAt(v, at, s.ce)
        if !okp || p.tag != 0x02 || p.ce != s.ce || p.ce - p.cs > 4 || int(v[p.cs]) >= 0x80 {
            return false
        }
        mut n := 0
        for i <- iter.Range(p.cs, p.ce) {
            n = (n << 8) | int(v[i])
        }
        c.pathLen = n
    }
    return true
}

// KeyUsage ::= BIT STRING（bit i → 1 << i — bit 0 = digitalSignature・5 = keyCertSign）
func keyUsage(v []byte, c mut Cert) bool {
    e, ok := elAt(v, 0, len(v))
    if !ok || e.tag != 0x03 || e.ce != len(v) || e.ce - e.cs < 1 || int(v[e.cs]) > 7 {
        return false
    }
    mut k := 0
    nbits := 8 * (e.ce - e.cs - 1) - int(v[e.cs])
    for i <- iter.Range(0, nbits) {
        if i < 16 && ((int(v[e.cs + 1 + i / 8]) >> (7 - i % 8)) & 1) == 1 {
            k = k | (1 << i)
        }
    }
    c.keyUsage = k
    return true
}

// ExtKeyUsageSyntax ::= SEQUENCE SIZE (1..MAX) OF KeyPurposeId（点区切りの OID の列）
func extKeyUsage(v []byte, c mut Cert) bool {
    s, ok := elAt(v, 0, len(v))
    if !ok || s.tag != 0x30 || s.ce != len(v) || s.ce == s.cs {
        return false
    }
    mut out := mut []string{}
    mut at := s.cs
    while at < s.ce {
        o, oko := elAt(v, at, s.ce)
        if !oko || o.tag != 0x06 {
            return false
        }
        t := oidText(content(v, o))
        if t == "?" {
            return false
        }
        out = append(out, t)
        at = o.ce
    }
    c.eku = freeze(out)
    return true
}

// GeneralNames の dNSName（[2] IA5String）と iPAddress（[7] — 4 か 16 バイト）。他の形は読み飛ばす
func subjectAltName(v []byte, c mut Cert) bool {
    s, ok := elAt(v, 0, len(v))
    if !ok || s.tag != 0x30 || s.ce != len(v) {
        return false
    }
    mut dns := mut []string{}
    mut ips := mut [][]byte{}
    mut at := s.cs
    while at < s.ce {
        g, okg := elAt(v, at, s.ce)
        if !okg {
            return false
        }
        if g.tag == 0x82 {
            nb := content(v, g)
            for i <- iter.Range(0, len(nb)) {
                if int(nb[i]) >= 0x80 {
                    return false
                }
            }
            nm := string(nb) catch return false
            if !dnsSyntax(nb) {
                return false
            }
            dns = append(dns, nm)
        } else if g.tag == 0x87 {
            if g.ce - g.cs != 4 && g.ce - g.cs != 16 {
                return false
            }
            ips = append(ips, content(v, g))
        }
        at = g.ce
    }
    c.dns = freeze(dns)
    c.ips = freeze(ips)
    return true
}

// NameConstraints ::= SEQUENCE { permittedSubtrees [0] GeneralSubtrees OPTIONAL, excludedSubtrees [1] GeneralSubtrees OPTIONAL }
// GeneralSubtree ::= SEQUENCE { base GeneralName, minimum [0] DEFAULT 0, maximum [1] OPTIONAL }（minimum / maximum は書かれていたら拒否 — RFC 5280 で MUST NOT）
func nameConstraints(v []byte, c mut Cert) bool {
    s, ok := elAt(v, 0, len(v))
    if !ok || s.tag != 0x30 || s.ce != len(v) || s.ce == s.cs {
        return false
    }
    c.ncPresent = true
    mut pdns := mut []string{}
    mut edns := mut []string{}
    mut pip := mut [][]byte{}
    mut eip := mut [][]byte{}
    mut at := s.cs
    while at < s.ce {
        t, okt := elAt(v, at, s.ce)
        if !okt || (t.tag != 0xa0 && t.tag != 0xa1) {
            return false
        }
        excl := t.tag == 0xa1
        // GeneralSubtrees は SIZE (1..MAX) — 空の列は拒否
        if t.ce == t.cs {
            return false
        }
        mut st := t.cs
        while st < t.ce {
            g, okg := elAt(v, st, t.ce)
            if !okg || g.tag != 0x30 {
                return false
            }
            base, okb := firstChild(v, g)
            if !okb || base.ce != g.ce {
                return false
            }
            if base.tag == 0x82 {
                nb := content(v, base)
                for i <- iter.Range(0, len(nb)) {
                    if int(nb[i]) >= 0x80 {
                        return false
                    }
                }
                nm := string(nb) catch return false
                if excl {
                    edns = append(edns, nm)
                } else {
                    pdns = append(pdns, nm)
                }
            } else if base.tag == 0x87 {
                if base.ce - base.cs != 8 && base.ce - base.cs != 32 {
                    return false
                }
                if excl {
                    eip = append(eip, content(v, base))
                } else {
                    pip = append(pip, content(v, base))
                }
            } else {
                c.ncOther = true
            }
            st = g.ce
        }
        at = t.ce
    }
    c.ncPermDNS = freeze(pdns)
    c.ncExclDNS = freeze(edns)
    c.ncPermIP = freeze(pip)
    c.ncExclIP = freeze(eip)
    return true
}

// SAN の dNSName の綴り（LDH のラベル — 英数字と途中の - だけ・1〜63 文字・全体 253 文字まで。最左のラベルだけ "*" 丸ごとを許す）
func dnsSyntax(b []byte) bool {
    if len(b) == 0 || len(b) > 253 {
        return false
    }
    mut start := 0
    mut first := true
    mut i := 0
    while i <= len(b) {
        if i == len(b) || b[i] == '.' {
            n := i - start
            if n == 0 || n > 63 {
                return false
            }
            if !(first && n == 1 && b[start] == '*' && i < len(b)) {
                for k <- iter.Range(start, i) {
                    x := b[k]
                    ok := (x >= 'a' && x <= 'z') || (x >= 'A' && x <= 'Z') || (x >= '0' && x <= '9') || (x == '-' && k != start && k != i - 1)
                    if !ok {
                        return false
                    }
                }
            }
            first = false
            start = i + 1
        }
        i += 1
    }
    return true
}
