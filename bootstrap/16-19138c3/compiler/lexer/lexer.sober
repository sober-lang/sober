package lexer

// 字句解析器（legacy/zig/lexer.zig の移植）。Go 式のセミコロン自動挿入を行う（docs/syntax.md 1 節）。
// ソースはバイト列（bytes(s) か io.ReadFile の []byte）。末尾より先は 0 として読む — Zig 版の番兵 0 と同じ扱いで、
// 途中の NUL バイトも終わりとして読む。
// 読み飛ばしの補助は (b, 位置) を取って新しい位置を返す純関数に割る（mut な読み手の状態を持ち回らない）

import "std/builder"
import "std/iter"

// at は b[i]。範囲外は 0（番兵）
func at(b []byte, i int) int {
    return if i < len(b) { int(b[i]) } else { 0 }
}

func isIdentStart(c int) bool {
    return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_'
}

// RadixOf は n 進リテラルの接頭辞の 2 文字目（`0x` の x 等）の基数（でなければ 10）
func RadixOf(c int) int {
    return switch c {
    case 'x': 16
    case 'o': 8
    case 'b': 2
    default: 10
    }
}

// DigitVal は基数 r の桁 c の値（桁でなければ -1）
func DigitVal(c int, r int) int {
    v := if c >= '0' && c <= '9' { c - '0' } else if c >= 'a' && c <= 'f' { c - 'a' + 10 } else if c >= 'A' && c <= 'F' { c - 'A' + 10 } else { 99 }
    return if v < r { v } else { -1 }
}

func digitIn(c int, r int) bool {
    return DigitVal(c, r) >= 0
}

func isDigit(c int) bool {
    return c >= '0' && c <= '9'
}

// IsDecimalDigit は c が 10 進の桁か（parser の整数リテラルが接頭辞を見分ける）
func IsDecimalDigit(c int) bool {
    return isDigit(c)
}

func isIdentCont(c int) bool {
    return isIdentStart(c) || isDigit(c)
}

// Lex は b 全体を字句に分ける（末尾は必ず Eof）
func Lex(b []byte) []Token {
    mut tb := builder.Builder[Token]{}
    mut i := 0
    mut last := Eof
    mut done := false
    while !done {
        t, next := lexOne(b, i, last)
        builder.Push(mut tb, t)
        i = next
        last = t.tag
        done = t.tag == Eof
    }
    return builder.Build(mut tb)
}

// LexSynth は loader が合成するソース（@layout の写し — loader/layout.sober）の字句: Lex に加えて、`$` の直後に続く名前を 1 つの名前にする。
// `$` の名前は利用者のソースには書けない（Lex では `$` が Invalid）ので、合成の名前は利用者の名前とぶつからない
func LexSynth(b []byte) []Token {
    ts := Lex(b)
    mut out := mut []Token{}
    mut i := 0
    while i < len(ts) {
        t := ts[i]
        if t.tag == Invalid && t.end == t.start + 1 && b[t.start] == '$' && i + 1 < len(ts) && ts[i + 1].tag == Identifier && ts[i + 1].start == t.end {
            out = append(out, Token{Identifier, t.start, ts[i + 1].end})
            i += 2
        } else {
            out = append(out, t)
            i += 1
        }
    }
    return freeze(out)
}

// lexOne は位置 i から字句を 1 つ読む。last は直前の字句の種類（改行でのセミコロン挿入の判定）。
// 結果は（字句, 次の読み位置）
func lexOne(b []byte, i0 int, last int) (Token, int) {
    insert := EndsStatement(last)
    i, nl := skipTrivia(b, i0, insert)
    if nl >= 0 {
        return Token{Semicolon, nl, nl}, i
    }
    c := at(b, i)
    switch c {
    case 0:
        return if insert { Token{Semicolon, i, i} } else { Token{Eof, i, i} }, i
    case '"':
        end, ok := skipString(b, i)
        return Token{if ok { StringLiteral } else { Invalid }, i, end}, end
    case '`':
        return lexRawString(b, i)
    case '\'':
        n := charLen(b, i)
        if n == 0 {
            return Token{Invalid, i, i + 1}, i + 1
        }
        return Token{CharLiteral, i, i + n}, i + n
    }
    if isIdentStart(c) {
        mut j := i
        while isIdentCont(at(b, j)) {
            j += 1
        }
        return Token{keyword(b, i, j), i, j}, j
    }
    if isDigit(c) {
        // n 進リテラル `0x` / `0o` / `0b`（小文字の接頭辞 + その基数の桁 1 つ以上 — syntax.md の字句）。桁が続かなければ 10 進の 0
        r := if c == '0' { RadixOf(at(b, i + 1)) } else { 10 }
        if r != 10 && digitIn(at(b, i + 2), r) {
            mut j := i + 2
            while digitIn(at(b, j), r) {
                j += 1
            }
            return Token{IntegerLiteral, i, j}, j
        }
        mut j := i
        while isDigit(at(b, j)) {
            j += 1
        }
        return Token{IntegerLiteral, i, j}, j
    }
    return lexSymbol(b, i)
}

// skipTrivia は空白とコメントを飛ばす。セミコロンを挿入すべき改行に当たったらその位置を返す（無ければ -1）。
// 結果は（次の読み位置, 改行の位置 or -1）
func skipTrivia(b []byte, i0 int, insert bool) (int, int) {
    mut i := i0
    while true {
        c := at(b, i)
        if c == ' ' || c == '\t' || c == '\r' {
            i += 1
        } else if c == '\n' {
            nl := i
            i += 1
            if insert {
                return i, nl
            }
        } else if c == '/' && at(b, i + 1) == '/' {
            while at(b, i) != '\n' && at(b, i) != 0 {
                i += 1
            }
        } else if c == '/' && at(b, i + 1) == '*' {
            // 改行を含むブロックコメントは改行として扱う（Go 仕様）
            start := i
            i += 2
            mut has_newline := false
            mut closed := false
            while !closed && at(b, i) != 0 {
                if at(b, i) == '*' && at(b, i + 1) == '/' {
                    i += 2
                    closed = true
                } else {
                    if at(b, i) == '\n' {
                        has_newline = true
                    }
                    i += 1
                }
            }
            if has_newline && insert {
                return i, start
            }
        } else {
            return i, -1
        }
    }
    return i, -1
}

// skipString は `"..."` を読み飛ばす（i0 は開きの `"`）。補間 `${ 式 }` は 1 字句のまま中を読み飛ばし、
// 式の中の入れ子の文字列（補間込み）・raw 文字列・`{ }` の対応を追う。改行は補間の中でも不可。
// 結果は（止まった位置, 閉じたか）— 閉じなければ止まった位置までが Invalid の字句
func skipString(b []byte, i0 int) (int, bool) {
    mut i := i0 + 1
    while true {
        c := at(b, i)
        if c == 0 || c == '\n' {
            return i, false
        }
        if c == '\\' {
            i += 1
            if at(b, i) != 0 {
                i += 1
            }
        } else if c == '"' {
            return i + 1, true
        } else if c == '$' {
            i += 1
            if at(b, i) == '{' {
                j, ok := skipInterp(b, i)
                if !ok {
                    return j, false
                }
                i = j
            }
        } else {
            i += 1
        }
    }
    return i, false
}

// skipInterp は `${ ... }` を読み飛ばす（i0 は `{`）。閉じれば位置は閉じの `}` の直後
func skipInterp(b []byte, i0 int) (int, bool) {
    mut i := i0 + 1
    mut depth := 1
    while depth > 0 {
        c := at(b, i)
        if c == 0 || c == '\n' {
            return i, false
        }
        if c == '{' {
            depth += 1
            i += 1
        } else if c == '}' {
            depth -= 1
            i += 1
        } else if c == '"' {
            j, ok := skipString(b, i)
            if !ok {
                return j, false
            }
            i = j
        } else if c == '\'' && charLen(b, i) > 0 {
            // 文字リテラル（`'}'` `'"'` の中身を括弧・文字列の開きと読まない）
            i += charLen(b, i)
        } else if c == '`' {
            i += 1
            while at(b, i) != '`' {
                if at(b, i) == 0 {
                    return i, false
                }
                i += 1
            }
            i += 1
        } else {
            i += 1
        }
    }
    return i, true
}

func lexRawString(b []byte, start int) (Token, int) {
    mut i := start + 1
    while at(b, i) != '`' {
        if at(b, i) == 0 {
            return Token{Invalid, start, i}, i
        }
        i += 1
    }
    return Token{RawStringLiteral, start, i + 1}, i + 1
}

// 文字リテラル（language.md 33 節・syntax.md 1 節）: ASCII の印字可能文字 1 つ（`'` `\` を除く）か escape 6 種（\n \t \r \0 \\ \'）を
// `'` で囲む。値はコード（型なし整数定数）。非 ASCII・空・閉じなし・他の escape は字句エラー（Rune の裁定まで）

// charLen は位置 i（開きの `'`）からの文字リテラルの長さ（3 か 4。字句にならなければ 0）
func charLen(b []byte, i int) int {
    c := at(b, i + 1)
    if c == '\\' {
        return if escapeValue(at(b, i + 2)) >= 0 && at(b, i + 3) == '\'' { 4 } else { 0 }
    }
    return if c >= ' ' && c <= '~' && c != '\'' && at(b, i + 2) == '\'' { 3 } else { 0 }
}

// escapeValue は escape `\e` の値（6 種以外は -1）
func escapeValue(e int) int {
    return switch e {
    case 'n': '\n'
    case 't': '\t'
    case 'r': '\r'
    case '0': '\0'
    case '\\': '\\'
    case '\'': '\''
    default: -1
    }
}

// CharValue は字句 CharLiteral（b[s:e]）の値
func CharValue(b []byte, s int, e int) int {
    return if e - s == 4 { escapeValue(int(b[s + 2])) } else { int(b[s + 1]) }
}

// wordIs は b[s:e] が w と同じ綴りか
func wordIs(b []byte, s int, e int, w string) bool {
    wb := bytes(w)
    if e - s != len(wb) {
        return false
    }
    for k <- iter.Range(0, len(wb)) {
        if b[s + k] != wb[k] {
            return false
        }
    }
    return true
}

// keyword は b[s:e] の単語の種類（キーワードでなければ Identifier）
func keyword(b []byte, s int, e int) int {
    return switch {
    case wordIs(b, s, e, "package"): KwPackage
    case wordIs(b, s, e, "import"): KwImport
    case wordIs(b, s, e, "const"): KwConst
    case wordIs(b, s, e, "type"): KwType
    case wordIs(b, s, e, "func"): KwFunc
    case wordIs(b, s, e, "struct"): KwStruct
    case wordIs(b, s, e, "map"): KwMap
    case wordIs(b, s, e, "if"): KwIf
    case wordIs(b, s, e, "else"): KwElse
    case wordIs(b, s, e, "switch"): KwSwitch
    case wordIs(b, s, e, "case"): KwCase
    case wordIs(b, s, e, "default"): KwDefault
    case wordIs(b, s, e, "return"): KwReturn
    case wordIs(b, s, e, "break"): KwBreak
    case wordIs(b, s, e, "continue"): KwContinue
    case wordIs(b, s, e, "defer"): KwDefer
    case wordIs(b, s, e, "for"): KwFor
    case wordIs(b, s, e, "mut"): KwMut
    case wordIs(b, s, e, "union"): KwUnion
    case wordIs(b, s, e, "error"): KwError
    case wordIs(b, s, e, "yield"): KwYield
    case wordIs(b, s, e, "while"): KwWhile
    case wordIs(b, s, e, "scope"): KwScope
    case wordIs(b, s, e, "parallel"): KwParallel
    case wordIs(b, s, e, "spawn"): KwSpawn
    case wordIs(b, s, e, "shield"): KwShield
    case wordIs(b, s, e, "catch"): KwCatch
    case wordIs(b, s, e, "panic"): KwPanic
    case _: Identifier
    }
}

// symAt は b の位置 i から w の綴りが続くか（範囲外は 0 なので、末尾で切れた記号には一致しない）
func symAt(b []byte, i int, w string) bool {
    wb := bytes(w)
    for k <- iter.Range(0, len(wb)) {
        if at(b, i + k) != int(wb[k]) {
            return false
        }
    }
    return true
}

// sym3 / sym2 / sym1 は長さごとの記号表（一致しなければ -1）。lexSymbol が最長一致で引く
func sym3(b []byte, i int) int {
    return switch {
    case symAt(b, i, "..."): Ellipsis
    case symAt(b, i, "<<="): ShlEqual
    case symAt(b, i, ">>="): ShrEqual
    case _: -1
    }
}

func sym2(b []byte, i int) int {
    return switch {
    case symAt(b, i, ":="): ColonEqual
    case symAt(b, i, "<<"): Shl
    case symAt(b, i, ">>"): Shr
    case symAt(b, i, "&&"): AmpersandAmpersand
    case symAt(b, i, "||"): PipePipe
    case symAt(b, i, "=="): EqualEqual
    case symAt(b, i, "!="): BangEqual
    case symAt(b, i, "<="): LessEqual
    case symAt(b, i, ">="): GreaterEqual
    case symAt(b, i, "+="): PlusEqual
    case symAt(b, i, "-="): MinusEqual
    case symAt(b, i, "*="): StarEqual
    case symAt(b, i, "/="): SlashEqual
    case symAt(b, i, "%="): PercentEqual
    case symAt(b, i, "&="): AmpersandEqual
    case symAt(b, i, "|="): PipeEqual
    case symAt(b, i, "^="): CaretEqual
    case symAt(b, i, "|>"): PipeGreater
    case symAt(b, i, "=>"): FatArrow
    case symAt(b, i, "<-"): LeftArrow
    case _: -1
    }
}

func sym1(c int) int {
    return switch c {
    case '(': LParen
    case ')': RParen
    case '{': LBrace
    case '}': RBrace
    case '[': LBracket
    case ']': RBracket
    case ',': Comma
    case '.': Dot
    case ';': Semicolon
    case ':': Colon
    case '@': At
    case '?': Question
    case '+': Plus
    case '-': Minus
    case '*': Star
    case '/': Slash
    case '%': Percent
    case '&': Ampersand
    case '|': Pipe
    case '^': Caret
    case '!': Bang
    case '=': Equal
    case '<': Less
    case '>': Greater
    case _: -1
    }
}

// lexSymbol は記号を最長一致（3 文字 → 2 文字 → 1 文字）で読む。どれでもなければ 1 バイトの Invalid
func lexSymbol(b []byte, i int) (Token, int) {
    t3 := sym3(b, i)
    if t3 >= 0 {
        return Token{t3, i, i + 3}, i + 3
    }
    t2 := sym2(b, i)
    if t2 >= 0 {
        return Token{t2, i, i + 2}, i + 2
    }
    t1 := sym1(at(b, i))
    if t1 >= 0 {
        return Token{t1, i, i + 1}, i + 1
    }
    return Token{Invalid, i, i + 1}, i + 1
}

// InterpEnd は、字句済みの文字列リテラル内の `${` の `{`（位置 pos）に対応する閉じ `}` の直後の位置（閉じなければ -1）。
// parser が補間の式を切り出すのに使う（字句と同じ読み飛ばし規則を共有する — Zig 版の Lexer.interpEnd）
func InterpEnd(b []byte, pos int) int {
    j, ok := skipInterp(b, pos)
    return if ok { j } else { -1 }
}
