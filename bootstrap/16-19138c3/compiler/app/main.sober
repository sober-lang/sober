package main

// stage2 の CLI（selfhost の R35 / 主役交代 R39）: Sober で書いたコンパイラの単体の入口。Zig 版 `sober`（legacy/zig/main.zig）の綴りに合わせて
//   sober build <entry> [--emit=ll|ir|elf] [--passes] [--no-opt] [-o <out>]   .ll（既定）/ IR テキスト / ELF（Sober の正規バックエンド — B-1d。
//                                                   ELF は mem2reg を掛ける — --no-opt で外す。B-3）を書く
//                                                   （-o が無ければ標準出力）。bin/sober の既定は IR テキストを凍結した Zig の正規バックエンドへ渡す
//                                                   （B-4 で切り替え）か、.ll を `zig cc -target x86_64-linux-none -nostdlib -static` で下ろす
//   sober check <entry> [--core-json]               analyzer（compiler/analyzer — 指摘は `<位置>: error: <本文> (Analyzer)` を標準エラーへ・判定は出さない）→
//                                                   脱糖 → 型検査（Checker.lean の移植 — compiler/checker）の判定 JSON を標準出力へ
//                                                   （--core-json は脱糖したコア AST の JSON — Lean の sober-check に渡す形 — を出して終わる）
//   sober lex <file>                                字句の列（1 行 1 字句: 種類 開始 終わり 綴り）
//   sober parse --ast-json <file>                   1 ファイルの表層 AST の JSON（C4 黄金の形）
//   sober parse --loader-json <entry>               load した Program の、loader が決める情報の JSON（第 2 黄金の形）
//   sober fmt <file>                                AST から整形したソース（compiler/printer — Zig 版の CST printer とは綴りが違う）
// を持つ。entry は .sober ファイルか main package のディレクトリ（cwd 相対 — import もルート = cwd 相対）。
// 終了コードは Zig 版と同じ: 成功 0・失敗（使い方・load / parse / 脱糖 / lower の拒否・型エラー・読み書きの失敗）1。診断は 1 行（`sober: load error` 等 — 質は別レーン）。
// std はコンパイラの一部（language.md 20 節 R8-2）: `@embed` で自分に焼き込み、`std/…` の import はここから読む

import "std/io"
import "std/hex"
import "std/hash"
import "std/iter"
import "std/os"
import "std/strings"
import "lexer"
import "parser"
import "ast"
import "printer"
import "loader"
import "lower"
import "desugar"
import "checker"
import "iface"
import "diag"
import "analyzer"

@embed("std/**/*.sober")
const Std = map[string]string{}

// L0（3'' 第 2 段の 1.5 — std のプリビルド焼き込み・.pair/cache-draft.md の三層の L0）: std の各 package の .sobi（小分けの check の 1 周の値 —
// `l0/<path>.sobi`）。stage2.sh が 2 段で建てる（L0 なしの仮の stage2 に `check <std 全部> --split --l0-out` で書かせ、それを焼き込んで本番を建てる —
// 同じコードが計算した値）。中身はこのコンパイラ自身と std の焼き込み（Std）だけで決まるので鍵は要らず、stale は定義から起きない（パスで引く）。
// 木の l0/ には仮の 1 ファイル（l0/placeholder.sobi — @embed は一致 0 を拒否するため）だけ — stages の stage3 等、stage2.sh の外で建てたものは L0 が空
@embed("l0/**/*.sobi")
const L0 = map[string]string{}

func fail(msg string) int {
    _ = io.WriteStderr(bytes("sober: ${msg}\n"))
    return 1
}

func usage() int {
    return fail("usage: sober build <entry> [--emit=ll|ir|elf] [--passes] [--no-opt] [-o <out>] | sober check <entry> [--core-json] | sober lex <file> | sober parse (--ast-json <file> | --loader-json <entry>) | sober fmt <file>")
}

func writeStdout(out []byte) int {
    werr := io.WriteStdout(out)
    return if werr != nil { fail("cannot write the standard output") } else { 0 }
}

func writeFile(path string, out []byte) int {
    werr := io.WriteFile(path, out)
    return if werr != nil { fail("cannot write ${path}") } else { 0 }
}

// check は p を脱糖して検査する（判定 JSON。脱糖の拒否なら diag のラベル）。関数に割るのは脱糖器のヒープの region を分けるため（sobercheck と同じ）
func check(p loader.Program) ([]byte, error?) {
    // E2-S の逃げの周回込み（checker/e2s.sober — 周回ごとに脱糖器のヒープの region を捨てる）。L0 がプログラムの std を全部持てば std の Def は
    // 検査しない（受理印は焼き込みが運ぶ — 逃げは焼き込みの .sobi の `@expand`）
    l0 := L0
    if l0On() && l0Complete(p, l0) {
        return checker.CheckE2Trust(p, l0Excl(p, l0))
    }
    return checker.CheckE2(p)
}

// l0On は L0 が有効か（環境変数 SOBER_L0=0 で無効 — 照合用）
func l0On() bool {
    v, err := os.Getenv("SOBER_L0")
    if err != nil {
        return true
    }
    if v != nil {
        return v != "0"
    }
    return true
}

// l0Get は L0 の package path の .sobi（無ければ ok = false）
func l0Get(l0 map[string]string, path string) ([]byte, bool) {
    v := l0["l0/${path}.sobi"]
    if v != nil {
        return bytes(v), true
    }
    return []byte{}, false
}

// l0Complete は p の std の package が全部 L0 にあるか（std を使わないプログラムは false — 信頼の経路に入る理由が無い）
func l0Complete(p loader.Program, l0 map[string]string) bool {
    mut any := false
    for k <- iter.Range(0, len(p.pkg_path)) {
        if strings.HasPrefix(p.pkg_path[k], "std/") {
            _, ok := l0Get(l0, p.pkg_path[k])
            if !ok {
                return false
            }
            any = true
        }
    }
    return any
}

// l0Excl は焼き込みの std の .sobi の `@expand`（E2-S の逃げ）の関数の p の添字
func l0Excl(p loader.Program, l0 map[string]string) []int {
    mut out := mut []int{}
    for k <- iter.Range(0, len(p.fn_node)) {
        path := p.pkg_path[p.file_pkg[p.fn_file[k]]]
        if strings.HasPrefix(path, "std/") {
            src, ok := l0Get(l0, path)
            if ok && expandNamed(src, fnNameOf(p, k)) {
                out = append(out, k)
            }
        }
    }
    return freeze(out)
}

// fnNameOf は p の関数 k の名前
func fnNameOf(p loader.Program, k int) string {
    t := p.trees[p.fn_file[k]]
    return loader.Name(t, t.nodes[p.fn_node[k]].a)
}

// expandNamed は .sobi src に `@expand` の付いた func name があるか（字面 — `@expand` の次の行が `func <name>(` / `func <name>[`）
func expandNamed(src []byte, name string) bool {
    return hasBytes(src, bytes("@expand\nfunc ${name}(")) || hasBytes(src, bytes("@expand\nfunc ${name}["))
}

func hasBytes(src []byte, w []byte) bool {
    mut i := 0
    while i + len(w) <= len(src) {
        mut k := 0
        while k < len(w) && src[i + k] == w[k] {
            k += 1
        }
        if k == len(w) {
            return true
        }
        i += 1
    }
    return false
}

// analyze は analyzer 層（受理の定義に含む — language.md 30 節）の指摘を Zig 版と同じ形 `<位置>: error: <本文> (Analyzer)` で
// 標準エラーへ全部出す（指摘があれば 1 — 判定 JSON は出さない）。--core-json と開発用のフラグでは走らせない（Zig 版と同じ）
func analyze(p loader.Program, std map[string]string) int {
    fs := analyzer.Run(p)
    for i <- iter.Range(0, len(fs)) {
        werr := io.WriteStderr(bytes("${where(p, std, fs[i].at)}: error: ${fs[i].what} (Analyzer)\n"))
        if werr != nil {
            return 1
        }
    }
    return if len(fs) > 0 { 1 } else { 0 }
}

// defFail は p の検査の def error の Def の添字（[j] — 無ければ [-1]。region を分けるため関数に割る — check と同じ）
func defFail(p loader.Program) (checker.E2Out, error?) {
    return checker.DefFailE2(p)
}

// coreJson は p を脱糖したコア AST の JSON（脱糖の拒否なら diag のラベル）。region を分けるため関数に割る（check と同じ）。
// 判定と同じコア（E2-S の逃げの集合を検査器で決めてから）を出す — Lean の照合（selfhost_check --lean・leanbatch）の入力
func coreJson(p loader.Program) ([]byte, error?) {
    excl := checker.ExclE2(p)?
    out, err := desugar.Json(p, true, excl)
    return out, err
}

// coreJsonExpanded は E2-S で上げない（全部展開の）コアの JSON（開発用 `--core-json-expanded`）
func coreJsonExpanded(p loader.Program) ([]byte, error?) {
    out, err := desugar.Json(p, false, []int{})
    return out, err
}

// loadDiag は load の拒否の診断（diag.Format — `load error: <理由>`、位置があれば `load error at <path>:<行>:<列>: <理由>`）
func loadDiag(p loader.Program, std map[string]string, err error?) string {
    return diag.Format(err, where(p, std, diag.At(err)))
}

// errDiag は脱糖 / lower の拒否の診断（diag.Format — `desugar error at <path>:<行>:<列> (<種類>)` / `lower error at … (<種類>)`。
// 種類の綴りは Zig 版の error 名）
func errDiag(p loader.Program, std map[string]string, err error?) string {
    return diag.Format(err, where(p, std, diag.At(err)))
}

// srcPos はファイル file の字句の位置 tok の `<path>:<行>:<列>`（ファイルが引けなければ `token <tok>`）
func srcPos(p loader.Program, std map[string]string, file int, tok int) string {
    return where(p, std, diag.Pos{file: file, tok: tok})
}

// where は位置 at の `<path>:<行>:<列>`（diag.Where — ファイルが引けなければ `token <tok>`）
func where(p loader.Program, std map[string]string, at diag.Pos) string {
    if at.file >= 0 {
        src, ok := loader.SourceFs(p, at.file, std)
        if ok {
            return diag.Where(p.file_path[at.file], src, at.tok)
        }
    }
    return "token ${at.tok}"
}

// verdictOk は判定 JSON が受理（`{"ok":true` で始まる）か
func verdictOk(out []byte) bool {
    w := bytes("{\"ok\":true")
    if len(out) < len(w) {
        return false
    }
    for i <- iter.Range(0, len(w)) {
        if out[i] != w[i] {
            return false
        }
    }
    return true
}

// typerReport は表層型検査器の突き合わせ（lower.TyperDiff の [一致, 不一致, 表に無い, 比べない, n, (ファイル, 字句, 表層型の種類, lower の型の種類)…]）を印字する
func typerReport(p loader.Program, std map[string]string, r []int) int {
    mut msg := "typer match=${r[0]} mismatch=${r[1]} absent=${r[2]} skip=${r[3]}\n"
    for k <- iter.Range(0, 100) {
        if r[5 + k] > 0 {
            msg = msg + "  absent kind=${k} n=${r[5 + k]}\n"
        }
    }
    for i <- iter.Range(0, r[4]) {
        b := 105 + i * 4
        msg = msg + "  ${srcPos(p, std, r[b], r[b + 1])} y=${r[b + 2]} t=${r[b + 3]}\n"
    }
    return writeStdout(bytes(msg))
}

// emit は lower の結果を args[oi]（oi < 0 なら標準出力）へ（拒否なら位置つきの診断 — errDiag）
func emit(p loader.Program, std map[string]string, args []string, oi int, out []byte, err error?) int {
    if err != nil {
        return fail(errDiag(p, std, err))
    }
    if oi < 0 {
        return writeStdout(out)
    }
    return writeFile(args[oi], out)
}

// emitExe は emit の実行ファイル版: ファイルへ書いたら実行の bit（0o755）を付ける（標準出力へは付けない）
func emitExe(p loader.Program, std map[string]string, args []string, oi int, out []byte, err error?) int {
    r := emit(p, std, args, oi, out, err)
    if r != 0 || oi < 0 {
        return r
    }
    return if os.WriteMode(args[oi], 493) != nil { fail("cannot set the mode of ${args[oi]}") } else { 0 }
}

// loadEntry は build の entry を読む（test なら package のテストのビルド — loader.LoadTestFs）。名前付き関数型を通した呼び出しの名前付き実引数は
// ここで位置へ写す（desugar.NamedValueArgs — 型を知る層の写し。check・build・analyzer が同じ木を読む）
func loadEntry(entry string, test bool, std map[string]string) (loader.Program, error?) {
    p, lerr := loadRaw(entry, test, std)
    if lerr != nil {
        return p, lerr
    }
    return desugar.NamedValueArgs(p)
}

func loadRaw(entry string, test bool, std map[string]string) (loader.Program, error?) {
    if test {
        return loader.LoadTestFs(entry, std)
    }
    return loader.LoadFs(entry, std)
}

// cmdBuild の引数は添字で持つ（`mut entry := ""` に仮引数の string を代入する形は check が拒否する — F-36。値は最後に 1 度だけ引く）
func cmdBuild(args []string) int {
    mut ei := 0 - 1
    mut oi := 0 - 1
    mut ir := false
    mut elfOut := false
    mut noOpt := false
    mut passes := false
    mut typer := 0
    mut trace := false
    mut test := false
    mut i := 2
    while i < len(args) {
        a := args[i]
        if a == "-o" {
            if i + 1 >= len(args) {
                return usage()
            }
            oi = i + 1
            i += 2
        } else if a == "--emit=ll" {
            ir = false
            i += 1
        } else if a == "--emit=ir" {
            ir = true
            i += 1
        } else if a == "--emit=elf" {
            // 正規バックエンド（compiler/lower/x86.sober — B-1d。既定の切り替えは B-4）。ファイルの実行ビットは呼び手（bin/sober）が付ける
            elfOut = true
            i += 1
        } else if a == "--passes" {
            passes = true
            i += 1
        } else if a == "--no-opt" {
            // --emit=elf の IR パス（mem2reg — stage1 の `build x.ir` の既定）を外す
            noOpt = true
            i += 1
        } else if a == "--trace-errors" {
            trace = true
            i += 1
        } else if a == "--test" {
            // テストのビルド（`sober test` — entry は package のディレクトリ。loader.LoadTestFs が合成の main を足す）
            test = true
            i += 1
        } else if a == "--typer" {
            typer = 1
            i += 1
        } else if a == "--typer-diff" {
            typer = 2
            i += 1
        } else if ei < 0 {
            ei = i
            i += 1
        } else {
            return usage()
        }
    }
    if ei < 0 {
        return usage()
    }
    // 焼き込んだ表は参照点で展開される辞書 const なので、一度束縛して渡す（参照ごとに組み直さない）
    std := Std
    p, lerr := loadEntry(args[ei], test, std)
    if lerr != nil {
        return fail(loadDiag(p, std, lerr))
    }
    if typer == 2 {
        out, err := lower.TyperDiff(p)
        if err != nil {
            return fail(errDiag(p, std, err))
        }
        return typerReport(p, std, out)
    }
    if typer == 1 {
        out, berr := lower.LlTyper(p)
        return emit(p, std, args, oi, out, berr)
    }
    if trace {
        // 開発用: error を返す出口の計装つき IR（lower.IrTraceErrors — error 網羅 analyzer の動的オラクル scripts/errtrace.sh）
        out, berr := lower.IrTraceErrors(p, passes)
        return emit(p, std, args, oi, out, berr)
    }
    if elfOut && noOpt {
        out, berr := lower.ElfRaw(p)
        return emitExe(p, std, args, oi, out, berr)
    }
    if elfOut && passes {
        out, berr := lower.ElfPasses(p)
        return emitExe(p, std, args, oi, out, berr)
    }
    if elfOut {
        out, berr := lower.Elf(p)
        return emitExe(p, std, args, oi, out, berr)
    }
    if ir && passes {
        out, berr := lower.IrPasses(p)
        return emit(p, std, args, oi, out, berr)
    }
    if ir {
        out, berr := lower.Ir(p)
        return emit(p, std, args, oi, out, berr)
    }
    if passes {
        out, berr := lower.LlPasses(p)
        return emit(p, std, args, oi, out, berr)
    }
    out, berr := lower.Ll(p)
    return emit(p, std, args, oi, out, berr)
}

// cmdCheckPkg は `sober check <entry> --pkg <path> --iface <dir> [--sigs]`（--sigs = 視点の関数の署名表 — G-d。package 単位の部分検査 — 3'' M2）: <dir>（iface -o の書き出し）の link.txt の順に
// package <path> だけソースから・他は .sobi から読み（loader.LoadView）、その package の Def だけを本体つきで検査した判定 JSON（checker.CheckPkgE2）。
// stage1 の --pkg と同じく analyzer は走らせない（analyzer の小分けは M3）
func cmdCheckPkg(entry string, pkg string, dir string, sigs bool) int {
    std := Std
    p0, lerr := loader.LoadView(entry, pkg, dir, std)
    if lerr != nil {
        return fail(loadDiag(p0, std, lerr))
    }
    p, nerr := desugar.NamedValueArgs(p0)
    if nerr != nil {
        return fail(loadDiag(p, std, nerr))
    }
    if sigs {
        return writeStdout(iface.Sigs(p))
    }
    for k <- iter.Range(0, len(p.pkg_path)) {
        if p.pkg_path[k] == pkg {
            out, cerr := checker.CheckPkgE2(p, k)
            if cerr != nil {
                return fail(errDiag(p, std, cerr))
            }
            return writeStdout(out)
        }
    }
    return fail("no package ${pkg} in ${dir}/link.txt")
}

// 小分けの check（`sober check <entry> --split` — 3'' M3・.pair/iface-draft.md 3 節）: 全体を 1 回読んで analyzer を一括で走らせ（error の
// ラベル集合の導出 — cause の合併 C[L]・error 型の欄の合併 — は依存する側の package も含む閉世界の合併で、package の中で閉じない — 論点 F の対案）、
// 依存の順に package ごとの region で「依存の .sobi を読む（LoadViewMem）→ その package の Def だけ check（E2-S の周回込み）→ .sobi を外へ写す」を回す。
// 出力は一括の check と同じ（最初に落ちた package の判定か診断・全部受理なら main の判定）
// キャッシュ（3'' 第 2 段 C2 — .pair/cache-draft.md）: 置き場 = cacheDir（SOBER_CACHE — 空文字なら無効）。package ごとに鍵を計算し、当たりなら
// その package の検査を飛ばして値（main 以外 = .sobi・main = 判定 JSON）を使う。外れて受理なら値を書く（拒否は書かない）。
// 検証モード（SOBER_CACHE_VERIFY=1）は当たりでも検査し直して値をバイト比較し、違えば stale と名指して落ちる（ゲートの網）。
// trace = `--cache-trace`（鍵と当否を標準エラーへ）
func checkSplit(entry string, trace bool, l0out string) int {
    std := Std
    l0 := L0
    l0on := l0On() && l0out == ""
    dir := cacheDir()
    use := trace || dir != ""
    pl := splitPlan(entry, std, use)
    if pl.code >= 0 {
        return pl.code
    }
    self := if use { selfKey() } else { []byte{} }
    verify := use && envOn("SOBER_CACHE_VERIFY")
    mut sobis := mut []loader.Sobi{}
    for i <- iter.Range(0, len(pl.order)) {
        path := pl.order[i]
        // L0（std の焼き込み — 鍵は要らない・L1 より先）→ L1（置き場）
        lk := lookupL0(l0on, l0, path, lookup(use, dir, self, path, pl, i, freeze(sobis)))
        if trace && traceLine(path, lk.key, lk.hit) != 0 {
            return 1
        }
        if lk.hit && !verify {
            if path == "main" {
                return writeStdout(lk.val)
            }
            sobis = append(sobis, loader.MakeSobi(path, lk.val))
        } else {
            r := splitOne(entry, path, pl.links[i], freeze(sobis), std)
            if r.code > 0 {
                if lk.hit {
                    return fail("cache: stale entry for ${path} (${lk.key}) — the cached value says accepted, the check rejects")
                }
                if r.code == 2 {
                    return fail(r.msg)
                }
                if writeStdout(r.out) != 0 {
                    return 1
                }
                return r.code
            }
            val := if r.code == 0 { r.out } else { r.sobi }
            if lk.hit && !bytesEq(lk.val, val) {
                return fail("cache: stale entry for ${path} (${lk.key}) — the cached value differs from the check")
            }
            if use && !lk.hit && dir != "" {
                cachePut(dir, lk.key, val)
            }
            // --l0-out（stage2.sh の L0 の生成）: 計算した std の .sobi を <l0out>/<path>.sobi へ
            if l0out != "" && r.code < 0 && strings.HasPrefix(path, "std/") {
                op := "${l0out}/${path}.sobi"
                mkdirs(parentOf(op))
                if io.WriteFile(op, val) != nil {
                    return fail("cannot write ${op}")
                }
            }
            if r.code == 0 {
                return writeStdout(val)
            }
            sobis = append(sobis, loader.MakeSobi(path, val))
        }
    }
    return fail("no main package")
}

// Lookup は 1 package のキャッシュの引き当て（key = 鍵・hit = 置き場に正しい値があった・val = その値）
type Lookup struct {
    key string
    hit bool
    val []byte
}

// lookupL0 は std の package を L0 から引く（当たれば L1 の引き当て lk を置き換える — 鍵は印字用に残す）
func lookupL0(on bool, l0 map[string]string, path string, lk Lookup) Lookup {
    if !on || !strings.HasPrefix(path, "std/") {
        return lk
    }
    v, ok := l0Get(l0, path)
    if !ok {
        return lk
    }
    return Lookup{lk.key, true, v}
}

func lookup(use bool, dir string, self []byte, path string, pl SplitPlan, i int, sobis []loader.Sobi) Lookup {
    if !use {
        return Lookup{"", false, []byte{}}
    }
    key := pkgKey(self, path, pl.digests[i], pl.links[i], sobis)
    v := cacheGet(dir, key)
    return Lookup{key, v.ok, v.val}
}

// SplitPlan は小分けの順（依存が先）の package のパスと各々の視点のリンク集合。code >= 0 なら load / analyzer で終わった（その終了コード）
type SplitPlan struct {
    code int
    order []string
    links [][]string
    digests [][]byte   // package ごとの入力の要約（キャッシュの鍵の材料 — trace のときだけ。でなければ空）
}

// splitPlan は全体を読んで analyzer を走らせ、小分けの順を決める（全体の Program はここの region で捨てる）
func splitPlan(entry string, std map[string]string, trace bool) SplitPlan {
    p, lerr := loadEntry(entry, false, std)
    if lerr != nil {
        return SplitPlan{fail(loadDiag(p, std, lerr)), []string{}, [][]string{}, [][]byte{}}
    }
    if analyze(p, std) != 0 {
        return SplitPlan{1, []string{}, [][]string{}, [][]byte{}}
    }
    ks := loader.SplitOrder(p)
    mut order := mut []string{}
    mut links := mut [][]string{}
    for i <- iter.Range(0, len(ks)) {
        order = append(order, p.pkg_path[ks[i]])
        links = append(links, loader.SplitLink(p, ks[i]))
    }
    mut digests := mut [][]byte{}
    if trace {
        for i <- iter.Range(0, len(ks)) {
            digests = append(digests, pkgDigest(p, ks[i], std))
        }
    }
    return SplitPlan{0 - 1, freeze(order), freeze(links), freeze(digests)}
}

// SplitOne は 1 package の結果: code < 0 = 受理して続ける（sobi = その package の .sobi）・0 / 1 = 最後の判定 out で終わる（main の受理か拒否）・
// 2 = 診断 msg で終わる
type SplitOne struct {
    code int
    out []byte
    msg string
    sobi []byte
}

func splitOne(entry string, pkg string, link []string, sobis []loader.Sobi, std map[string]string) SplitOne {
    p0, raw, lerr := loader.LoadViewMemRaw(entry, pkg, link, sobis, std)
    if lerr != nil {
        return SplitOne{2, []byte{}, loadDiag(p0, std, lerr), []byte{}}
    }
    p, nerr := desugar.NamedValueArgs(p0)
    if nerr != nil {
        return SplitOne{2, []byte{}, loadDiag(p, std, nerr), []byte{}}
    }
    k := pkgIndex(p, pkg)
    r, cerr := checker.PkgE2(p, k)
    if cerr != nil {
        return SplitOne{2, []byte{}, errDiag(p, std, cerr), []byte{}}
    }
    out := checker.Out(r)
    if !verdictOk(out) {
        return SplitOne{1, out, "", []byte{}}
    }
    if pkg == "main" {
        return SplitOne{0, out, "", []byte{}}
    }
    // 生の木は視点の読み込みが parse したもの（ソースを読み直さない）
    return SplitOne{0 - 1, []byte{}, "", iface.Emit(p, k, checker.Excl(r), raw)}
}

func pkgIndex(p loader.Program, pkg string) int {
    for k <- iter.Range(0, len(p.pkg_path)) {
        if p.pkg_path[k] == pkg {
            return k
        }
    }
    return 0 - 1
}

func cmdCheck(args []string) int {
    if (len(args) == 7 || (len(args) == 8 && args[7] == "--sigs")) && args[3] == "--pkg" && args[5] == "--iface" {
        return cmdCheckPkg(args[2], args[4], args[6], len(args) == 8)
    }
    if len(args) == 4 && args[3] == "--split" {
        return checkSplit(args[2], false, "")
    }
    if len(args) == 6 && args[3] == "--split" && args[4] == "--l0-out" {
        return checkSplit(args[2], false, args[5])
    }
    if len(args) == 5 && args[3] == "--split" && args[4] == "--cache-trace" {
        return checkSplit(args[2], true, "")
    }
    // 開発用: 関数の署名表（scripts/sobi.sh の G-d — 全体の表）
    if len(args) == 4 && args[3] == "--sigs" {
        std := Std
        p, lerr := loadEntry(args[2], false, std)
        if lerr != nil {
            return fail(loadDiag(p, std, lerr))
        }
        return writeStdout(iface.Sigs(p))
    }
    core := len(args) == 4 && args[3] == "--core-json"
    // 開発用: E2-S で上げない（全部展開の）コア — regionbound（G2 — 脱糖器と lower〔パスなし = 全部展開〕の region 境界の数の照合）の入力
    corex := len(args) == 4 && args[3] == "--core-json-expanded"
    tdiff := len(args) == 4 && args[3] == "--typer-diff"
    nall := len(args) == 4 && args[3] == "--nominal-all"
    didx := len(args) == 4 && args[3] == "--def-index"
    edump := len(args) == 4 && args[3] == "--errors-dump"
    xrep := len(args) == 4 && args[3] == "--expansion-report"
    // テストのビルド（entry = package のディレクトリ — 合成の main と _test.sober ごと検査する。T12）
    tst := len(args) == 4 && args[3] == "--test"
    if len(args) != 3 && !core && !corex && !tdiff && !nall && !didx && !edump && !xrep && !tst {
        return usage()
    }
    std := Std
    p, lerr := loadEntry(args[2], tst, std)
    if lerr != nil {
        return fail(loadDiag(p, std, lerr))
    }
    if edump {
        // 開発用: error のラベル集合の導出（compiler/analyzer の errors.sober — error 網羅 analyzer A2 の影）
        fs := analyzer.ErrorsDump(p)
        mut msg := ""
        for i <- iter.Range(0, len(fs)) {
            msg = if fs[i].at.file < 0 { msg + "${fs[i].what}\n" } else { msg + "${where(p, std, fs[i].at)}: ${fs[i].what}\n" }
        }
        return writeStdout(bytes(msg))
    }
    if xrep {
        // 開発用: 関数ごとの展開の寄与（コア式の節の数）の上位 40（desugar.ExpansionReport — コスト可視化の口）
        r, xerr := desugar.ExpansionReport(p, 40)
        if xerr != nil {
            return fail(errDiag(p, std, xerr))
        }
        return writeStdout(r)
    }
    if nall {
        // 開発用: 表層型の照合の拒否を全部（desugar.NominalAll — 1 件で止めない）
        r, derr := desugar.NominalAll(p)
        if derr != nil {
            return fail(errDiag(p, std, derr))
        }
        mut msg := "nominal ${len(r) / 2}\n"
        for i <- iter.Range(0, len(r) / 2) {
            msg = msg + "  ${srcPos(p, std, r[i * 2], r[i * 2 + 1])}\n"
        }
        return writeStdout(bytes(msg))
    }
    if didx {
        // 開発用: 検査の判定が def error なら、何番目の Def か（名前付き関数 → 持ち上げた Def の順）とその出所の位置
        r, derr := defFail(p)
        if derr != nil {
            return fail(errDiag(p, std, derr))
        }
        j := checker.Def(r)
        // E2-S の逃げの周回（docs/formal.md「check の callM の段」の条件 6）の数と展開へ戻した関数の数
        e2 := " (e2s: rounds=${checker.Rounds(r)} back=${len(checker.Excl(r))})"
        if j == -2 {
            return writeStdout(bytes("checker: too deep${e2}\n"))
        }
        if j < 0 {
            return writeStdout(bytes("no def error${e2}\n"))
        }
        at, aerr := desugar.DefAt(p, checker.Excl(r), j)
        if aerr != nil {
            return fail(errDiag(p, std, aerr))
        }
        return writeStdout(bytes("def error: def ${j} at ${where(p, std, at)}${e2}\n"))
    }
    if tdiff {
        // 表層型検査器 × exprSty の突き合わせ（desugar.TyperDiff — C1 B3 の入口）
        r, derr := desugar.TyperDiff(p)
        if derr != nil {
            return fail(errDiag(p, std, derr))
        }
        mut msg := "typer-sty same=${r[0]} gain=${r[1]} loss=${r[2]} mismatch=${r[3]} skip=${r[4]} targs-same=${r[5]} targs-diff=${r[6]}\n"
        for i <- iter.Range(0, r[7]) {
            b := 8 + i * 4
            if r[b + 2] == 2 {
                msg = msg + "  ${srcPos(p, std, r[b], r[b + 1])} targs inferTs-ok=${r[b + 3] == 1}\n"
            } else {
                msg = msg + "  ${srcPos(p, std, r[b], r[b + 1])} lost=${r[b + 2] == 0} y=${r[b + 3]}\n"
            }
        }
        return writeStdout(bytes(msg))
    }
    if corex {
        cx, xerr := coreJsonExpanded(p)
        if xerr != nil {
            return fail(errDiag(p, std, xerr))
        }
        return writeStdout(cx)
    }
    if core {
        cj, cerr := coreJson(p)
        if cerr != nil {
            return fail(errDiag(p, std, cerr))
        }
        return writeStdout(cj)
    }
    if analyze(p, std) != 0 {
        return 1
    }
    out, cerr := check(p)
    if cerr != nil {
        return fail(errDiag(p, std, cerr))
    }
    if writeStdout(out) != 0 {
        return 1
    }
    return if verdictOk(out) { 0 } else { 1 }
}

// readSrc は args[i] のファイルの中身（読めなければ ok = false）
func readSrc(args []string, i int) ([]byte, bool) {
    src := io.ReadFile(args[i]) catch return []byte{}, false
    return src, true
}

func cmdLex(args []string) int {
    if len(args) != 3 {
        return usage()
    }
    src, ok := readSrc(args, 2)
    if !ok {
        return fail("cannot read ${args[2]}")
    }
    return writeStdout(lexer.Dump(src))
}

// cmdTree は args[i] を parse して、AST から整形したソース（pr）か AST JSON（!pr）を書く
func cmdTree(args []string, i int, pr bool) int {
    src, ok := readSrc(args, i)
    if !ok {
        return fail("cannot read ${args[i]}")
    }
    // .sobi（interface — language.md 29 節）は本体の無い func 宣言と `@expand` を許す読み方で
    t, pok := parseFile(args[i], src)
    if !pok {
        return fail("parse error")
    }
    if pr {
        return writeStdout(printer.Print(t))
    }
    return writeStdout(ast.Json(t))
}

// parseFile は path の拡張子で読み方を選ぶ（.sobi は parser.ParseIface）
func parseFile(path string, src []byte) (ast.Tree, bool) {
    if strings.HasSuffix(path, ".sobi") {
        return parser.ParseIface(src, lexer.Lex(src))
    }
    return parser.Parse(src, lexer.Lex(src))
}

func cmdLoaderJson(args []string) int {
    std := Std
    p, lerr := loader.LoadFs(args[3], std)
    if lerr != nil {
        return fail(loadDiag(p, std, lerr))
    }
    return writeStdout(loader.Json(p))
}

// cmdIface は `sober iface <entry> [--pkg <path> | --no-expand]`: package の interface（.sobi — compiler/iface）。--pkg なら その package の .sobi を、
// 無ければ全 package を束で（`== <path>.sobi` の行 + 本文・最後に `== link.txt` + リンク集合 — bin/sober の -o が書き分ける。std に mkdir の口が無いため）。
// E2-S の逃げ（`@expand` の印）は check の周回で決める（checker.ExclE2 — 脱糖の拒否ならその診断で失敗）
// rawTrees はファイルごとのソースを読み直して parse した生の木（loader の写しの前 — iface.Emit が原文の形で書く）。読み直せないファイル
// （loader が合成した `$layout/…`）は file = -1 の空の木
func rawTrees(p loader.Program, std map[string]string) []ast.Tree {
    mut out := mut []ast.Tree{}
    for f <- iter.Range(0, len(p.file_path)) {
        out = append(out, rawTree(p, f, std))
    }
    return freeze(out)
}

func rawTree(p loader.Program, f int, std map[string]string) ast.Tree {
    src, ok := loader.SourceFs(p, f, std)
    if !ok {
        return ast.Tree{[]ast.Node{}, []int{}, 0 - 1}
    }
    t, pok := parseFile(p.file_path[f], src)
    return if pok { t } else { ast.Tree{[]ast.Node{}, []int{}, 0 - 1} }
}

// cmdIfaceView は `sober iface <entry> --view <path> <dir>`（scripts/sobi.sh の G-a — .sobi の不動点）: <dir> の視点（package <path> だけソース・他は .sobi）で
// 読んだプログラムから、<path> 以外の全 package の .sobi を束で書く（`@expand` は読んだ .sobi の印のまま — E2-S は回さない）
func cmdIfaceView(entry string, pkg string, dir string) int {
    std := Std
    p, lerr := loader.LoadView(entry, pkg, dir, std)
    if lerr != nil {
        return fail(loadDiag(p, std, lerr))
    }
    raws := rawTrees(p, std)
    mut out := mut []byte{}
    for k <- iter.Range(0, len(p.pkg_path)) {
        if p.pkg_path[k] != pkg {
            appendBytes(mut out, bytes("== ${p.pkg_path[k]}.sobi\n"))
            appendBytes(mut out, iface.Emit(p, k, []int{}, raws))
        }
    }
    return writeStdout(freeze(out))
}

func cmdIface(args []string) int {
    if len(args) == 6 && args[3] == "--view" {
        return cmdIfaceView(args[2], args[4], args[5])
    }
    // --no-expand = E2-S の周回を走らせない（`@expand` の印なし — stage1 の .sobi との照合 scripts/sobi.sh が凍結コーパスに掛ける。
    // 凍結した例には今の脱糖器が拒否するものがある）
    noexp := len(args) == 4 && args[3] == "--no-expand"
    pkgOnly := len(args) == 5 && args[3] == "--pkg"
    if len(args) != 3 && !pkgOnly && !noexp {
        return usage()
    }
    std := Std
    p, lerr := loadEntry(args[2], false, std)
    if lerr != nil {
        return fail(loadDiag(p, std, lerr))
    }
    mut excl := []int{}
    if !noexp {
        x, xerr := checker.ExclE2(p)
        if xerr != nil {
            return fail(errDiag(p, std, xerr))
        }
        excl = x
    }
    raws := rawTrees(p, std)
    mut out := mut []byte{}
    for k <- iter.Range(0, len(p.pkg_path)) {
        if pkgOnly {
            if p.pkg_path[k] == args[4] {
                return writeStdout(iface.Emit(p, k, excl, rawTrees(p, std)))
            }
        } else {
            appendBytes(mut out, bytes("== ${p.pkg_path[k]}.sobi\n"))
            appendBytes(mut out, iface.Emit(p, k, excl, raws))
        }
    }
    if pkgOnly {
        return fail("no package ${args[4]} in the program")
    }
    appendBytes(mut out, bytes("== link.txt\n"))
    appendBytes(mut out, iface.Link(p))
    return writeStdout(freeze(out))
}

func appendBytes(out mut []byte, b []byte) {
    for i <- iter.Range(0, len(b)) {
        out = append(out, b[i])
    }
}

func cmdParse(args []string) int {
    if len(args) != 4 {
        return usage()
    }
    if args[2] == "--ast-json" {
        return cmdTree(args, 3, false)
    }
    if args[2] == "--loader-json" {
        return cmdLoaderJson(args)
    }
    return usage()
}

// cmdTest は `sober test <package>… --work <dir> [-run <接頭辞>] [-v]`（.pair/test-design-draft.md — T1・T8）: package ごとに
// テストのビルド（loader.LoadTestFs — 合成の main）を Sober の正規バックエンド（lower.ElfPasses — B-4）で <work>/t に書き、実行の bit を付けて
// （os.WriteMode）、TestXxx を 1 つずつ別プロセス（std/os.Run）で走らせて終了コードを集計する。子の出力は親の標準出力をそのまま継ぐ
// （捕まえない — os.Run は終了コードだけの最小面。-v は受けるが今は常に見せる形と同じ）。-run は名前の接頭辞で絞る。終了コード = 失敗があれば 1
func cmdTest(args []string) int {
    mut pkgs := mut []int{}
    mut wi := 0 - 1
    mut ri := 0 - 1
    mut i := 2
    while i < len(args) {
        a := args[i]
        if a == "--work" || a == "-run" {
            if i + 1 >= len(args) {
                return usage()
            }
            if a == "--work" {
                wi = i + 1
            } else {
                ri = i + 1
            }
            i += 2
        } else if a == "-v" {
            i += 1
        } else {
            pkgs = append(pkgs, i)
            i += 1
        }
    }
    if len(pkgs) == 0 || wi < 0 {
        return usage()
    }
    std := Std
    mut pass := 0
    mut failn := 0
    for k <- iter.Range(0, len(pkgs)) {
        r := testPkg(args[pkgs[k]], std, args[wi], if ri < 0 { "" } else { args[ri] })
        pass += r.pass
        failn += r.fail
    }
    println("${pass} passed, ${failn} failed")
    return if failn == 0 { 0 } else { 1 }
}

// TestTally は package 1 つ分の集計
type TestTally struct {
    pass int
    fail int
}

// testPkg は package pkg のテストを建てて走らせる（建たなければ FAIL 1 件として数える）
func testPkg(pkg string, std map[string]string, work string, prefix string) TestTally {
    p, lerr := loadEntry(pkg, true, std)
    if lerr != nil {
        println("FAIL ${pkg} (build)")
        // 診断は標準エラーへ（書けなくても集計は同じ — 失敗 1 件）
        if io.WriteStderr(bytes("sober: ${loadDiag(p, std, lerr)}\n")) != nil {
            return TestTally{pass: 0, fail: 1}
        }
        return TestTally{pass: 0, fail: 1}
    }
    names, nerr := loader.TestNames(p, pkg)
    exe, berr := lower.ElfPasses(p)
    if nerr != nil || berr != nil {
        println("FAIL ${pkg} (build)")
        return TestTally{pass: 0, fail: 1}
    }
    bin := work + "/t"
    if io.WriteFile(bin, exe) != nil || os.WriteMode(bin, 493) != nil {
        println("FAIL ${pkg} (build)")
        return TestTally{pass: 0, fail: 1}
    }
    mut pass := 0
    mut failn := 0
    for k <- iter.Range(0, len(names)) {
        if prefix == "" || strings.HasPrefix(names[k], prefix) {
            ec, eerr := os.Run(bin, []string{names[k]})
            if eerr == nil && ec == 0 {
                println("ok   ${pkg}.${names[k]}")
                pass += 1
            } else {
                println("FAIL ${pkg}.${names[k]} (exit ${ec})")
                failn += 1
            }
        }
    }
    return TestTally{pass: pass, fail: failn}
}

func main() int {
    args, err := os.Args()
    if err != nil || len(args) < 2 {
        return usage()
    }
    if args[1] == "build" {
        return cmdBuild(args)
    }
    if args[1] == "check" {
        return cmdCheck(args)
    }
    if args[1] == "test" {
        return cmdTest(args)
    }
    if args[1] == "lex" {
        return cmdLex(args)
    }
    if args[1] == "parse" {
        return cmdParse(args)
    }
    if args[1] == "iface" {
        return cmdIface(args)
    }
    if args[1] == "fmt" {
        if len(args) != 3 {
            return usage()
        }
        return cmdTree(args, 2, true)
    }
    return usage()
}

// ── 小分けの check のキャッシュの鍵（3'' 第 2 段 C1 — .pair/cache-draft.md 3 節）。C1 は鍵を計算して当否を印字するだけ（`check --split --cache-trace` —
// 置き場は読むだけで書かない。書くのは C2）。
//   key(P) = SHA-256("sobercache 1" ‖ コンパイラの鍵 ‖ P のパス ‖ P の入力の要約 ‖ 視点のリンク集合の各依存 D について D のパス ‖ SHA-256(sobi(D)))
//   P の入力の要約 = SHA-256(P の各ファイルの パス ‖ 長さ ‖ SHA-256(中身) ‖ その木の @embed の入力)
// 依存の項は鍵でなく .sobi の中身のハッシュ（早期打ち切り — 依存の本体だけの編集で .sobi が変わらなければ P は当たる）。
// 長さの前置きで連結するので、区切りの取り違えで別の入力が同じ列にならない


// cacheFormat はキャッシュの中身の形の版（形を変えたら上げる — 鍵の先頭に入る）
func cacheFormat() []byte {
    return bytes("sobercache 1")
}

// selfKey はコンパイラ自身の鍵: 環境変数 SOBER_SELF_KEY（bin/sober が stage2 の .key を渡す — compiler/ + std/ + boot の内容ハッシュ。
// 決定的ビルドなので同じ .key は同じバイナリ）。無ければ実行中のバイナリ（/proc/self/exe）の SHA-256。どちらも取れなければ空（鍵の材料が欠けた印 —
// 呼び手は当否を出さない）
func selfKey() []byte {
    v, err := os.Getenv("SOBER_SELF_KEY")
    if err == nil {
        if v != nil {
            if len(bytes(v)) > 0 {
                return bytes(v)
            }
        }
    }
    b := io.ReadFile("/proc/self/exe") catch return []byte{}
    return bytes(hex.Encode(hash.Sha256(b)))
}

// pkgDigest は package k の入力の要約（ソースのファイルの列と @embed の入力 — 全体の Program p から。ファイルの順は load の順 = パスの順）
func pkgDigest(p loader.Program, k int, std map[string]string) []byte {
    mut out := mut []byte{}
    for f <- iter.Range(0, len(p.file_path)) {
        if p.file_pkg[f] == k {
            src, ok := loader.SourceFs(p, f, std)
            lenPut(mut out, bytes(p.file_path[f]))
            lenPut(mut out, if ok { hash.Sha256(src) } else { bytes("!read") })
            // @embed の入力は字面に `@embed` を含むファイルだけ parse して取る（全ファイルの parse し直しは自己適用で約 2 s — 鍵の計算の上乗せの大半だった）
            if ok && hasEmbed(src) {
                t, pok := parseFile(p.file_path[f], src)
                lenPut(mut out, if pok { hash.Sha256(loader.EmbedInputs(t)) } else { bytes("!parse") })
            }
        }
    }
    return hash.Sha256(freeze(out))
}

// hasEmbed は src が字面 `@embed` を含むか（コメント・文字列の中も当たる — 余分に parse するだけで鍵は正しい）
func hasEmbed(src []byte) bool {
    w := bytes("@embed")
    mut i := 0
    while i + len(w) <= len(src) {
        mut k := 0
        while k < len(w) && src[i + k] == w[k] {
            k += 1
        }
        if k == len(w) {
            return true
        }
        i += 1
    }
    return false
}

// pkgKey は package path の鍵（16 進 64 桁）。digest = pkgDigest・link = 視点のリンク集合（ロード順 — path 自身を含む）・sobis = 依存の .sobi
func pkgKey(self []byte, path string, digest []byte, link []string, sobis []loader.Sobi) string {
    mut out := mut []byte{}
    lenPut(mut out, cacheFormat())
    lenPut(mut out, self)
    lenPut(mut out, bytes(path))
    lenPut(mut out, digest)
    for i <- iter.Range(0, len(link)) {
        if link[i] != path {
            lenPut(mut out, bytes(link[i]))
            lenPut(mut out, hash.Sha256(sobiOf(sobis, link[i])))
        }
    }
    return hex.Encode(hash.Sha256(freeze(out)))
}

// sobiOf は sobis の中の package path の .sobi（無ければ空 — 依存の順に回すので起きない）
func sobiOf(sobis []loader.Sobi, path string) []byte {
    for i <- iter.Range(0, len(sobis)) {
        if sobis[i].path == path {
            return sobis[i].src
        }
    }
    return []byte{}
}

// cachePath は置き場 dir の鍵 key のファイル（`<dir>/sobercache-1/<先頭 2 桁>/<64 桁>` — cache-draft 5.2）
func cachePath(dir string, key string) string {
    b := bytes(key)
    head := string(b[0:2]) catch "00"
    return "${dir}/sobercache-1/${head}/${key}"
}

// CacheVal は置き場から読んだ値（ok = 鍵の行と長さが合った）
type CacheVal struct {
    ok bool
    val []byte
}

// cacheGet は置き場 dir の鍵 key の値。ファイルの形 = `sobercache 1 <鍵> <長さ> <値の SHA-256>\n` + 値（cache-draft 5.2）— 先頭の行の鍵・長さ・
// 値のハッシュが合わなければ外れ（書きかけ・壊れ・手での改竄 — 計算し直して上書きされる）。dir が空なら外れ
func cacheGet(dir string, key string) CacheVal {
    if dir == "" {
        return CacheVal{false, []byte{}}
    }
    b := io.ReadFile(cachePath(dir, key)) catch return CacheVal{false, []byte{}}
    pre := bytes("sobercache 1 ${key} ")
    if len(b) < len(pre) {
        return CacheVal{false, []byte{}}
    }
    for k <- iter.Range(0, len(pre)) {
        if b[k] != pre[k] {
            return CacheVal{false, []byte{}}
        }
    }
    mut n := 0
    mut q := len(pre)
    while q < len(b) && b[q] >= '0' && b[q] <= '9' {
        n = n * 10 + int(b[q]) - 48
        q += 1
    }
    // 長さの後ろは ` <値の SHA-256 の 16 進 64 桁>\n`
    if q == len(pre) || q + 66 > len(b) || b[q] != ' ' || b[q + 65] != '\n' || len(b) - q - 66 != n {
        return CacheVal{false, []byte{}}
    }
    v := b[q + 66:len(b)]
    want := bytes(hex.Encode(hash.Sha256(v)))
    for k <- iter.Range(0, 64) {
        if b[q + 1 + k] != want[k] {
            return CacheVal{false, []byte{}}
        }
    }
    return CacheVal{true, v}
}

// cachePut は値 val を鍵 key で置き場に書く（一時ファイルに書いて Rename で公開 — 読み手は書きかけを見ない。失敗は黙って捨てる — キャッシュは
// 速さのためだけで、書けなくても結果は変わらない）。同じ鍵を 2 つのプロセスが同時に書いても値は同じバイト列（内容アドレス + 決定的）
func cachePut(dir string, key string, val []byte) {
    p := cachePath(dir, key)
    mkdirs(parentOf(p))
    mut out := mut []byte{}
    appendBytes(mut out, bytes("sobercache 1 ${key} ${len(val)} ${hex.Encode(hash.Sha256(val))}\n"))
    appendBytes(mut out, val)
    tmp := p + ".tmp"
    if io.WriteFile(tmp, freeze(out)) != nil {
        return
    }
    _ = os.Rename(tmp, p)
}

// mkdirs は path のディレクトリを親から順に作る（mkdir -p — 既にあるのは errno 17 で、どの失敗も無視する。作れなければ書き込みが失敗するだけ）
func mkdirs(path string) {
    b := bytes(path)
    for i <- iter.Range(1, len(b) + 1) {
        if i == len(b) || b[i] == '/' {
            d := string(b[0:i]) catch return
            _ = os.Mkdir(d)
        }
    }
}

// parentOf は path の最後の `/` より前（無ければ "."）
func parentOf(path string) string {
    b := bytes(path)
    mut k := len(b) - 1
    while k > 0 && b[k] != '/' {
        k -= 1
    }
    if k <= 0 {
        return "."
    }
    return string(b[0:k]) catch "."
}

// cacheDir は置き場: 環境変数 SOBER_CACHE（空文字なら無効 = ""）。無ければ $XDG_CACHE_HOME/sober・$HOME/.cache/sober（どれも無ければ無効）
func cacheDir() string {
    v, err := os.Getenv("SOBER_CACHE")
    if err != nil {
        return ""
    }
    // if 式の腕に「値」と「リテラル」を並べると腕の region が合わない（F-35 — loader の orDot と同じ）ので腕ごとに return する
    if v != nil {
        return v
    }
    x, xerr := os.Getenv("XDG_CACHE_HOME")
    if xerr == nil {
        if x != nil {
            if len(bytes(x)) > 0 {
                return x + "/sober"
            }
        }
    }
    h, herr := os.Getenv("HOME")
    if herr == nil {
        if h != nil {
            if len(bytes(h)) > 0 {
                return h + "/.cache/sober"
            }
        }
    }
    return ""
}

// envOn は環境変数 name が "1" か
func envOn(name string) bool {
    v, err := os.Getenv(name)
    if err != nil {
        return false
    }
    if v != nil {
        return v == "1"
    }
    return false
}

// bytesEq はバイト列の一致
func bytesEq(a []byte, b []byte) bool {
    if len(a) != len(b) {
        return false
    }
    for i <- iter.Range(0, len(a)) {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

// traceLine は `--cache-trace` の 1 行（標準エラーへ — `cache: <path> <鍵> hit|miss`）
func traceLine(path string, key string, hit bool) int {
    werr := io.WriteStderr(bytes("cache: ${path} ${key} ${if hit { "hit" } else { "miss" }}\n"))
    return if werr != nil { 1 } else { 0 }
}

// lenPut は b を「10 進の長さ + ':' + b」で out に積む
func lenPut(out mut []byte, b []byte) {
    n := bytes("${len(b)}:")
    for i <- iter.Range(0, len(n)) {
        out = append(out, n[i])
    }
    for i <- iter.Range(0, len(b)) {
        out = append(out, b[i])
    }
}
