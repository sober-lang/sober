package lower

// std/par の即時形（段 6 P3a-2b・language.md 11 節・docs/ir.md「罠」）: build の経路の par.Scope / Spawn / Join / Try。
// - Scope = region を 1 段開き（ブロック式と同じ — 出口で深度を戻す）、札の記録（SR_* — 死んだ子の数・scope の深度・全部の子の枠の鎖 …）をその region に置いて
//   本体のラムダを展開する（ラムダは inline — 本体は親の文脈を見てよい）。結果は (値, nil) か、死んだ子がいれば (ゼロ値, TaskDied{cause})
// - Spawn = 子の本体を持ち上げた関数 kid#N（閉包変換 — 捕獲は今の可視範囲の imm の局所）を罠を張って**その場で**呼ぶ（即時形 — 子は spawn の時点で決着する）。
//   handle の枠 [状態（1 = 完了・2 = 死）, 死因, 結果…, 捕獲…] は scope の region に置き、子の実引数 = 枠の結果の置き場（子は sret で結果を書く）。
//   子の死（panic / 102 / ゼロ除算）は罠で巻き戻り、深度と宛先 / anchor のレジスタを罠の前の値へ戻す
// - Join = 完了なら結果・死なら呼び手も死ぬ（PK_TASKDIED — この子の死は私の死）・Try = Outcome（Ok{v} / Died{cause}）
// 捕獲の集合は desugar.LamFree（ParCheck の捕獲の名指しと同じ走査）を今の可視範囲の局所で絞る — check の経路（desugar/par.sober — コアの自由変数）と
// 実装が 2 つになるので、網は obs（examples/par_* を実行して check の受理と照合）
// 死因の語 = 点 << 8 | 終了コード（rt.panic の点の番号 / rt.panic_mem の種類・ゼロ除算は -1）

import "ast"
import "desugar"
import "diag"
import "std/iter"
import "std/table"

// 札の記録（scope の region の語）
const SR_DEAD = 0
const SR_DEPTH = 1
const SR_ALL = 2     // 全部の子の枠の鎖（新しい順 — FR_ANEXT で繋ぐ。出口で死があれば歩いて生んだ順で最初の死の死因を取る — P4-2）
const SR_LIVE = 3    // まだ終わっていない子の数 × 2 + 出口で待っている印（P3b — 子は待てる・P4-4 — waitLive）
const SR_WAITER = 4  // 出口で子を待っている task（0 = 無し）
const SR_FHEAD = 5   // error を返す子の枠の列（生んだ順 — 出口で未回収の失敗を探す。P3b-4 1b'）
const SR_FTAIL = 6
const SR_KEEP = 7    // 預かりの欄の鎖（段 6 P4-4 (B1) — 0 = 無し）
const SR_UP = 8      // 同じ task の外側の開いている scope の記録（task の TC_SCOPE の鎖 — 段 6 P4-5: 死ぬ / 切られる task は開いている scope の子を待ってから終わる）
const SR_CUT = 9     // 打ち切りの印（段 6 P4-5 — 0 = 無し・c > 0 = 生んだ順の番号が c - 1 以上の子を切ってよい。立てるのは xchg / cas・検査は素の load）
const SR_NKID = 10   // 生んだ子の数（子の番号 = 生んだ順 — TC_IDX）
const SR_OTCB = 11   // scope を開いた task の塊（検査点の遅い道が祖先の打ち切りの印を辿る — 開いた task は子を待ってから終わるので生きている）
const SR_LED = 12    // 天井の節の台帳の語（budget: の scope だけ — 段 6 P5-3 admit.sober の LED_* と同じ形・task の数の欄は天井なし）
const SR_PNODE = 13  // 外の節（budget: の scope だけ）
const SRSZ = 14
// handle の枠（scope の region の語）: [状態（0 = 走っている・1 = 完了・2 = 死・3 = 切られた〔段 6 P4-5 — 死因の語 = 子の関数の番地 | 預かりの欄の位置 << 32〕）, 死因, scope の記録, 結果…, 捕獲…]。子の実引数 = 枠 + FR_RES
const FR_STATE = 0
const FR_CAUSE = 1
const FR_SREC = 2
const FR_JOINER = 3  // この子の終わりを待っている task（Join / Try — 0 = 無し）
const FR_COL = 4     // 回収済みの印（Join / Try が結果を受けた — P3b-4 1b'）
const FR_NEXT = 5    // scope の error を返す子の列の次（0 = 終わり）
const FR_EOFF = 6    // error を返す子の err の語の位置（FR_RES からの語数 — 0 = error を返さない子）
const FR_ANEXT = 7   // scope の全部の子の鎖の次（SR_ALL — 新しい順）
const FR_RES = 8
// 預かりのスロット（段 6 P4-4 (B1)）: 結果に region を持つ子は結果を自分の深度（入口 + 1）のスロットに置いたまま終わり、そのスロットを枠の後ろの
// 預かりの欄 [スロット, 使った量, 次] に書いて scope の記録の SR_KEEP の鎖へ積む（CAS — 子は並行に終わる）。Join / Try / 出口が持ち主として
// scope の region へ写し、出口が鎖を歩いて返す（region の書き手は常に 1 つ — 子は scope の region に書かない）。欄は結果が region を持つ子の枠だけ
const KP_SLOT = 0
const KP_USED = 1
const KP_NEXT = 2
const KP_WORDS = 3
// チャネルの記録（NewChan の region の語 — P3b）: [容量, 先頭, 個数, 送り端の持ち主, 受け端の持ち主, 待っている送り手, 待っている受け手, 1 要素の語数,
// 記録の深度, 作った task, 要素…]（記録の深度・作った task は P3b-4b — region を持つペイロードを送りで記録の region へ写す）
const CH_CAP = 0
const CH_HEAD = 1   // 受けた数（受け手だけが書く — Lamport の SPSC・段 6 P4-4）
const CH_TAIL = 2   // 送った数（送り手だけが書く）。個数 = TAIL - HEAD・枠の番号 = 数 mod 容量
const CH_OTX = 3
const CH_ORX = 4
const CH_WSEND = 5
const CH_WRECV = 6
const CH_ITEM = 7
const CH_RDEPTH = 8
const CH_MAKER = 9
const CH_CLOSED = 10 // 閉じた印（P3b-4 ③ — 0 / 1）
const CH_BUF = 11

// parCall は std/par の鍵 key（desugar.PAR_*）の呼び出し（関数表の fi・callee = 型引数の表を引く節）
func parCall(st mut St, key int, fi int, args desugar.ListRef, at desugar.NodeRef, callee0 desugar.NodeRef) (int, error?) {
    // 型引数 T: Scope = 本体の値の型（下ろした後）・Spawn = 呼び出しの型 Task[T]（表層型検査器の表）・Join / Try = handle の型 Task[T] のインスタンスの型引数
    pk := fnPkg(mut st, fi)
    if key == desugar.PAR_NEWCHAN {
        return parNewChan(mut st, pk, args, at, callee0)
    }
    if key == desugar.PAR_SEND || key == desugar.PAR_RECV {
        return parSendRecv(mut st, pk, key, args, at)
    }
    if key == desugar.PAR_CLOSE {
        return parClose(mut st, args, at)
    }
    if key == desugar.PAR_SPAWNGIVE {
        tt := parSpawnTy(mut st, at)?
        return parSpawn(mut st, pk, tt, args, at, true)
    }
    if key == desugar.PAR_SCOPE {
        return parScope(mut st, fi, pk, args, at)
    }
    if key == desugar.PAR_SPAWN {
        tt := parSpawnTy(mut st, at)?
        return parSpawn(mut st, pk, tt, args, at, false)
    }
    if key == desugar.PAR_SPAWNIN {
        return parSpawnIn(mut st, pk, args, at)
    }
    if lenL(mut st, args) != 1 {
        return 0, diag.Mismatch{at: posOf(mut st, at)}
    }
    hx := expr(mut st, latN(mut st, args, 0))?
    if isTag(mut st, hx.t, TNever) {
        return -1, nil
    }
    t := taskArg(mut st, hx.t, at)?
    frame := itop(mut st, load(mut st, hx.v, 0))
    // error を返す task（P3b-4 1b'）の err の型（表層型 Task[(T, error?)] の 2 つ目）
    ey := desugar.ParTaskTupleY(mut st.d, desugar.YTypeOf(mut st.d, latN(mut st, args, 0)), 1)
    eT := if ey >= 0 { yLower(mut st, ey, at)? } else { -1 }
    // 子がまだ終わっていなければ待つ（Join / Try — P3b）
    waitWhileZero(mut st, frame, FR_STATE, FR_JOINER)
    // 切られた子（状態 3 — 段 6 P4-5）: 値を求められたので切らない形で走らせ直して待つ（純な子だけが切られる — 走らせ直しは観測に出ない）
    bRr := newBlock(mut st)
    bRd := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, load(mut st, frame, FR_STATE), iconst(mut st, 3)), bRr, -1, bRd, -1)
    setCur(mut st, bRr)
    // Join / Try は検査点: 求めた task 自身が切られる側なら走らせ直さずに巻き戻る
    call(mut st, st.rtCancel, list0(mut st))
    call(mut st, st.rtTaskRerun, list1(mut st, frame))
    waitWhileZero(mut st, frame, FR_STATE, FR_JOINER)
    br(mut st, bRd, -1)
    setCur(mut st, bRd)
    if key == desugar.PAR_JOIN {
        bad := newBlock(mut st)
        ok := newBlock(mut st)
        condbr(mut st, cmp(mut st, CEq, load(mut st, frame, FR_STATE), iconst(mut st, 2)), bad, -1, ok, -1)
        setCur(mut st, bad)
        // 子の死因を @rt.trap の [1] / [2] へ（rt.panic の TaskDied の枝が印字する — 罠の中なら trapDie が自分の死因で上書きする）
        c := load(mut st, frame, FR_CAUSE)
        tg := globaladdr(mut st, st.trapG)
        store(mut st, tg, TW_CODE, bin(mut st, BAnd, c, iconst(mut st, 255)))
        store(mut st, tg, TW_SITE, bin(mut st, BSar, c, iconst(mut st, 8)))
        panicSite(mut st, PK_TASKDIED, at)
        setCur(mut st, ok)
        store(mut st, frame, FR_COL, iconst(mut st, 1))
        if eT < 0 {
            return parOne(mut st, t, joinCopy(mut st, frame, FR_RES, t)), nil
        }
        // error を返す task: (T, error?) の 2 値
        r := listN(mut st, 4)
        desugar.HeapSet(mut st.d, r, 2)
        desugar.HeapSet(mut st.d, r + 1, t)
        desugar.HeapSet(mut st.d, r + 2, joinCopy(mut st, frame, FR_RES, t))
        desugar.HeapSet(mut st.d, r + 3, eT)
        desugar.HeapSet(mut st.d, r + 4, joinCopy(mut st, frame, FR_RES + tWords(mut st, t), eT))
        return r, nil
    }
    // Try: Outcome[T]（variant 0 = Ok{v}・1 = Failed{e}・2 = Died{cause} — std/par の宣言順）
    oi := parInfo(mut st, pk, "Outcome", t, at)?
    ot := desugar.HeapGet(mut st.d, oi + SI_TY)
    vs := hgetL(mut st, oi + SI_FIELDS)
    vOk := latI(mut st, vs, 0)
    vFailed := latI(mut st, vs, 1)
    vDied := latI(mut st, vs, 2)
    p := newAgg(mut st, ot)
    zero := iconst(mut st, 0)
    for w <- iter.Range(0, tWords(mut st, ot)) {
        store(mut st, p, w, zero)
    }
    bDied := newBlock(mut st)
    bOk := newBlock(mut st)
    bEnd := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, load(mut st, frame, FR_STATE), iconst(mut st, 2)), bDied, -1, bOk, -1)
    setCur(mut st, bOk)
    store(mut st, frame, FR_COL, iconst(mut st, 1))
    if eT >= 0 {
        // error を返す task: err が nil でなければ Failed{e}
        bOk2 := newBlock(mut st)
        bFail := newBlock(mut st)
        eoff := FR_RES + tWords(mut st, t)
        condbr(mut st, cmp(mut st, CNe, load(mut st, frame, eoff), iconst(mut st, 0)), bFail, -1, bOk2, -1)
        setCur(mut st, bFail)
        store(mut st, p, 0, iconst(mut st, desugar.HeapGet(mut st.d, vFailed + 1)))
        // err の `error?` の中身（tag の後ろ）を Failed の欄 e（error）へ
        ef := latI(mut st, hgetL(mut st, vFailed + 2), 0)
        storeVal(mut st, p, 1 + desugar.HeapGet(mut st.d, ef + 2), desugar.HeapGet(mut st.d, ef + 1), loadVal(mut st, frame, eoff + 1, desugar.HeapGet(mut st.d, ef + 1)))
        br(mut st, bEnd, -1)
        setCur(mut st, bOk2)
    }
    store(mut st, p, 0, iconst(mut st, desugar.HeapGet(mut st.d, vOk + 1)))
    storeVal(mut st, p, 1 + desugar.HeapGet(mut st.d, latI(mut st, hgetL(mut st, vOk + 2), 0) + 2), t, loadVal(mut st, frame, FR_RES, t))
    br(mut st, bEnd, -1)
    setCur(mut st, bDied)
    store(mut st, p, 0, iconst(mut st, desugar.HeapGet(mut st.d, vDied + 1)))
    store(mut st, p, 1 + desugar.HeapGet(mut st.d, latI(mut st, hgetL(mut st, vDied + 2), 0) + 2), load(mut st, frame, FR_CAUSE))
    br(mut st, bEnd, -1)
    setCur(mut st, bEnd)
    if containsSlice(mut st, ot) {
        // (B1): Ok の値・Failed の e は子の預かりのスロットを指す — scope の region へ写す（持ち主 = 今の task が書く）
        relocateTo(mut st, p, 0, ot, load(mut st, itop(mut st, load(mut st, frame, FR_SREC)), SR_DEPTH))
    }
    return parOne(mut st, ot, p), nil
}

// joinCopy は枠の結果の語 off の型 t の値の写し（region を持てば子の預かりのスロットから scope の region へ写す — (B1)・段 6 P4-4）
func joinCopy(st mut St, frame int, off int, t int) int {
    v := copyVal(mut st, t, loadVal(mut st, frame, off, t))
    if containsSlice(mut st, t) {
        slot := newAgg(mut st, t)
        storeVal(mut st, slot, 0, t, v)
        relocateTo(mut st, slot, 0, t, load(mut st, itop(mut st, load(mut st, frame, FR_SREC)), SR_DEPTH))
        return loadVal(mut st, slot, 0, t)
    }
    return v
}

// SpawnTy は Spawn の結果の handle の型引数 T と err の型（error を返さない task は err = -1 — P3b-4 1b'）
type SpawnTy struct {
    t int
    e int
}

// parSpawnTy は Spawn の呼び出し at の型引数（表層型 Task[T] — T が多値 `(T, error?)` なら T と err の型）
func parSpawnTy(st mut St, at desugar.NodeRef) (SpawnTy, error?) {
    return parSpawnTyY(mut st, desugar.YTypeOf(mut st.d, at), at)
}

// parSpawnTyY は handle の表層型 y（Task[T]）の子の結果の型（parSpawnTy の本体 — SpawnIn は呼び出しの型の 1 つ目の中身）
func parSpawnTyY(st mut St, y int, at desugar.NodeRef) (SpawnTy, error?) {
    y0 := desugar.ParTaskTupleY(mut st.d, y, 0)
    if y0 >= 0 {
        t := yLower(mut st, y0, at)?
        e := yLower(mut st, desugar.ParTaskTupleY(mut st.d, y, 1), at)?
        return SpawnTy{t: t, e: e}, nil
    }
    ht := yLower(mut st, y, at)?
    if ht < 0 {
        return SpawnTy{}, diag.Mismatch{at: posOf(mut st, at)}
    }
    return SpawnTy{t: taskArg(mut st, ht, at)?, e: -1}, nil
}

// taskArg は handle の型 Task[T]（ジェネリック struct のインスタンス）の T
func taskArg(st mut St, ht int, at desugar.NodeRef) (int, error?) {
    if !isTag(mut st, ht, TStruct) || desugar.HeapGet(mut st.d, desugar.HeapGet(mut st.d, ht + 1) + SI_TARGS) < 0 {
        return 0, diag.Mismatch{at: posOf(mut st, at)}
    }
    return latI(mut st, hgetL(mut st, desugar.HeapGet(mut st.d, ht + 1) + SI_TARGS), 0), nil
}

// waitWhileZero は p[off] が 0 の間待つ（段 6 P4-4 — M:N の待ちの型: 待ち手の語 p[slot] へ今の task を xchg で置き、条件を見直してから眠る。
// 見直しで条件が立っていれば待ち手の語を xchg で外す — 外せなかった（0 が返った = 起こし手が先に取った）なら起こしが来るので task_wait で吸う。
// 起こし手は条件を書いてから xchg(待ち手, 0)。xchg は全順序の柵なので「置いてから見る」と「書いてから取る」のどちらかが相手を見る — 起こし損ねが無い）
func waitWhileZero(st mut St, p int, off int, slot int) {
    loop := newBlock(mut st)
    body := newBlock(mut st)
    late := newBlock(mut st)
    absorb := newBlock(mut st)
    sleep := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, -1)
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CEq, load(mut st, p, off), iconst(mut st, 0)), body, -1, done, -1)
    setCur(mut st, body)
    // 遅延注入の口（待ちの点 — schedfuzz: 見て から 置く までの窓を広げる）
    mnDelayPoint(mut st)
    if st.rtMut == 2 {
        // 変異 2: 待ち手を素の store で置き、見直さずに眠る（見てから置くまでに子が終わると起こし損ねる — デッドロックの死で鳴る）
        store(mut st, p, slot, load(mut st, globaladdr(mut st, st.taskG), TK_CUR))
        call(mut st, st.rtTaskWait, list0(mut st))
        br(mut st, loop, -1)
        setCur(mut st, late)
        br(mut st, done, -1)
        setCur(mut st, absorb)
        br(mut st, done, -1)
        setCur(mut st, sleep)
        br(mut st, done, -1)
        setCur(mut st, done)
        return
    }
    atomicXchg(mut st, p, slot, load(mut st, globaladdr(mut st, st.taskG), TK_CUR))
    condbr(mut st, cmp(mut st, CEq, load(mut st, p, off), iconst(mut st, 0)), sleep, -1, late, -1)
    setCur(mut st, late)
    w := atomicXchg(mut st, p, slot, iconst(mut st, 0))
    condbr(mut st, cmp(mut st, CEq, w, iconst(mut st, 0)), absorb, -1, done, -1)
    setCur(mut st, absorb)
    call(mut st, st.rtTaskWait, list0(mut st))
    br(mut st, done, -1)
    setCur(mut st, sleep)
    call(mut st, st.rtTaskWait, list0(mut st))
    br(mut st, loop, -1)
    setCur(mut st, done)
}

// waitLive は scope の出口の待ち（生きている子が 0 になるまで — 段 6 P4-4）: SR_LIVE = 生きている子の数 × 2 + 待っている印（1）。待ち手を SR_WAITER に
// 書いてから印を CAS で立て（数が変わっていれば見直し）、立ったら眠る。最後の子は xadd(-2) の結果が「数 0 + 印」のときだけ起こす（それ以外は
// 減らした後に記録へ触れない — 記録は出口の後に捨てられうる）。起こしは眠り 1 回にちょうど 1 回
func waitLive(st mut St, rec int) {
    loop := newBlock(mut st)
    body := newBlock(mut st)
    sleep := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, -1)
    setCur(mut st, loop)
    v := load(mut st, rec, SR_LIVE)
    condbr(mut st, cmp(mut st, CLt, v, iconst(mut st, 2)), done, -1, body, -1)
    setCur(mut st, body)
    store(mut st, rec, SR_WAITER, load(mut st, globaladdr(mut st, st.taskG), TK_CUR))
    o := atomicCas(mut st, rec, SR_LIVE, v, bin(mut st, BOr, v, iconst(mut st, 1)))
    condbr(mut st, cmp(mut st, CEq, o, v), sleep, -1, loop, -1)
    setCur(mut st, sleep)
    call(mut st, st.rtTaskWait, list0(mut st))
    br(mut st, loop, -1)
    setCur(mut st, done)
}

// parOne は結果 1 つの列
func parOne(st mut St, t int, v int) int {
    r := list2(mut st, t, v)
    desugar.HeapSet(mut st.d, r, 1)
    return r
}

// parInfo は std/par（package pk）の型 name の情報（targ >= 0 ならその型引数のインスタンス）。レイアウト済み
func parInfo(st mut St, pk int, name string, targ int, at desugar.NodeRef) (int, error?) {
    td := lookupTypeDecl(mut st, pk, strLit(mut st, name))
    if td == -1 {
        return 0, diag.UndefinedType{at: posOf(mut st, at)}
    }
    mut info := -1
    if targ < 0 {
        info = infoOf(mut st, int(td))
    } else {
        info = instStructTys(mut st, td, pk, desugar.ListRef(list1(mut st, targ)), at)?
    }
    layoutInfo(mut st, info)?
    return info, nil
}

// parScope は `par.Scope((s par.S) => 本体)`
func parScope(st mut St, fi int, pk int, args desugar.ListRef, at desugar.NodeRef) (int, error?) {
    // 実引数 = [本体のラムダ, budget]（段 6 P5-3 — 省略は loader が nil で埋める）
    if lenL(mut st, args) != 2 {
        return 0, diag.Mismatch{at: posOf(mut st, at)}
    }
    bx := latN(mut st, args, 1)
    budgeted := kindN(mut st, bx) != ast.ENil
    bud := if budgeted { budgetArg(mut st, bx)? } else { -1 }
    lam := latN(mut st, args, 0)
    if kindN(mut st, lam) != ast.ELambda || lenL(mut st, lA(nodeOf(mut st, lam))) != 1 {
        return 0, diag.Par{at: posOf(mut st, lam), kind: 3}
    }
    sT := desugar.HeapGet(mut st.d, parInfo(mut st, pk, "S", -1, at)? + SI_TY)
    cT := desugar.HeapGet(mut st.d, parInfo(mut st, pk, "Cause", -1, at)? + SI_TY)
    saved := regionDepth(mut st)
    keep0 := st.scopeKeep
    st.scopeKeep = false
    pushScope(mut st)
    regionEnter(mut st)
    sd := regionDepth(mut st)
    rPush(mut st, sd)
    // 変異 1（段 6 P4-4 の自己検査 — RtMutant）: 到着順で最初の失敗の枠を記録の後ろの 1 語に
    rec := regionAlloc(mut st, sd, iconst(mut st, SRSZ + (if st.rtMut == 1 { 1 } else { 0 })))
    if st.rtMut == 1 {
        store(mut st, rec, SRSZ, iconst(mut st, 0))
    }
    zero := iconst(mut st, 0)
    store(mut st, rec, SR_DEAD, zero)
    store(mut st, rec, SR_DEPTH, sd)
    store(mut st, rec, SR_ALL, zero)
    store(mut st, rec, SR_LIVE, zero)
    store(mut st, rec, SR_WAITER, zero)
    store(mut st, rec, SR_FHEAD, zero)
    store(mut st, rec, SR_FTAIL, zero)
    store(mut st, rec, SR_KEEP, zero)
    store(mut st, rec, SR_CUT, zero)
    store(mut st, rec, SR_NKID, zero)
    // 今の task の開いている scope の鎖へ（段 6 P4-5 — 死ぬ / 切られる task は task_start でこの鎖の子を待ってから終わる）
    tkS := itop(mut st, load(mut st, globaladdr(mut st, st.taskG), TK_CUR))
    store(mut st, rec, SR_UP, load(mut st, tkS, TC_SCOPE))
    store(mut st, rec, SR_OTCB, ptoi(mut st, tkS))
    store(mut st, tkS, TC_SCOPE, ptoi(mut st, rec))
    // 天井の節（段 6 P5-3 admit.sober — budget: の scope だけ。各段が上限・予約ではない）
    if budgeted {
        ledNodeOpen(mut st, rec, bud)
    }
    sv := newAgg(mut st, sT)
    store(mut st, sv, 0, ptoi(mut st, rec))
    tokName := sA(nodeOf(mut st, latN(mut st, lA(nodeOf(mut st, lam)), 0)))
    declareNew(mut st, tokName, LVal, sT, sv, at)?
    // 字面の scope の札の積み（spawn が外の札へ内の budget: の scope の中から生むかを見る — parRootOnly）
    toks0 := st.parToks
    st.parToks = rec4(mut st, st.parToks, int(tokName), if budgeted { 1 } else { 0 }, 0)
    body := nB(nodeOf(mut st, lam))
    mut x := Val{t: -1, v: 0}
    if kindN(mut st, body) == ast.EBlock {
        x = armValue(mut st, lA(nodeOf(mut st, body)))?
    } else {
        x = expr(mut st, body)?
    }
    st.rnest = st.rnest - 1
    st.parToks = toks0
    if isTag(mut st, x.t, TNever) {
        st.scopeKeep = keep0
        popScope(mut st)
        return -1, nil
    }
    runDefers(mut st, st.nscope - 1)?
    if cur(mut st) == -1 {
        st.scopeKeep = keep0
        popScope(mut st)
        return -1, nil
    }
    t := x.t
    // 出口: 子が全部終わるまで待つ（P3b — 待っている子がいれば scope を開いた task は止まる）
    waitLive(mut st, rec)
    store(mut st, itop(mut st, load(mut st, globaladdr(mut st, st.taskG), TK_CUR)), TC_SCOPE, load(mut st, rec, SR_UP))
    if budgeted {
        ledNodeClose(mut st, rec)
    }
    decl := fnNode(mut st, fi)
    sig := sigIn(mut st, decl, pk, bindsOf(mut st, lB(nodeOf(mut st, decl)), desugar.ListRef(list1(mut st, t))))?
    eT := latI(mut st, desugar.ListRef(sig.rs), 1)
    v := copyVal(mut st, t, x.v)
    // 本体の値の境界コピー（ブロックの出口の R5 と同じ — region を持つ値は scope の region から親の最内へ写す。写さないと出口の後に
    // 同じ深度で開き直した region が上書きする）
    if containsSlice(mut st, t) {
        relocateTo(mut st, v, 0, t, saved)
    }
    dead := load(mut st, rec, SR_DEAD)
    // 死因 = 死んだ子のうち生んだ順で最初の子の死因（P4-2 — 到着順を捨てる。死があるときだけ全部の子の鎖〔新しい順〕を歩き、最後に見た死を取る）
    causeS := newSlotAddr(mut st, 1)
    store(mut st, causeS, 0, zero)
    bCw := newBlock(mut st)
    bCwOut := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, dead, zero), bCw, -1, bCwOut, -1)
    setCur(mut st, bCw)
    cwLoop := newBlock(mut st)
    cwp := param(mut st, cwLoop, TyI64)
    cwBody := newBlock(mut st)
    br(mut st, cwLoop, list1(mut st, load(mut st, rec, SR_ALL)))
    setCur(mut st, cwLoop)
    condbr(mut st, cmp(mut st, CEq, cwp, zero), bCwOut, -1, cwBody, -1)
    setCur(mut st, cwBody)
    cwf := itop(mut st, cwp)
    isDead := cmp(mut st, CEq, load(mut st, cwf, FR_STATE), iconst(mut st, 2))
    oldC := load(mut st, causeS, 0)
    store(mut st, causeS, 0, bin(mut st, BAdd, oldC, bin(mut st, BMul, isDead, bin(mut st, BSub, load(mut st, cwf, FR_CAUSE), oldC))))
    br(mut st, cwLoop, list1(mut st, load(mut st, cwf, FR_ANEXT)))
    setCur(mut st, bCwOut)
    cause := load(mut st, causeS, 0)
    // 未回収の失敗（P3b-4 1b'）: error を返す子の列を生んだ順に見て、完了・未回収・err が nil でない最初の子の err（死が先 — 死があれば見ない）
    fe := newAgg(mut st, eT)
    for w <- iter.Range(0, tWords(mut st, eT)) {
        store(mut st, fe, w, zero)
    }
    cursor := newSlotAddr(mut st, 1)
    if st.rtMut == 1 {
        // 変異 1: 到着順で最初の失敗の枠から探す（正準順 = 生んだ順を壊す — schedfuzz が割れを捕まえること）
        f1 := load(mut st, rec, SRSZ)
        store(mut st, cursor, 0, bin(mut st, BAdd, f1, bin(mut st, BMul, cmp(mut st, CEq, f1, zero), load(mut st, rec, SR_FHEAD))))
    } else {
        store(mut st, cursor, 0, load(mut st, rec, SR_FHEAD))
    }
    bLoop := newBlock(mut st)
    bChk := newBlock(mut st)
    bHit := newBlock(mut st)
    bNext := newBlock(mut st)
    bOut := newBlock(mut st)
    br(mut st, bLoop, -1)
    setCur(mut st, bLoop)
    cf := load(mut st, cursor, 0)
    condbr(mut st, bin(mut st, BOr, cmp(mut st, CEq, cf, zero), cmp(mut st, CNe, dead, zero)), bOut, -1, bChk, -1)
    setCur(mut st, bChk)
    fr := itop(mut st, cf)
    eoff := load(mut st, fr, FR_EOFF)
    etag := load(mut st, gepWord(mut st, fr, bin(mut st, BAdd, iconst(mut st, FR_RES), eoff)), 0)
    hit := bin(mut st, BAnd, bin(mut st, BAnd, cmp(mut st, CEq, load(mut st, fr, FR_STATE), iconst(mut st, 1)), cmp(mut st, CEq, load(mut st, fr, FR_COL), zero)), cmp(mut st, CNe, etag, zero))
    condbr(mut st, hit, bHit, -1, bNext, -1)
    setCur(mut st, bHit)
    eslot := gepWord(mut st, fr, bin(mut st, BAdd, iconst(mut st, FR_RES), eoff))
    storeVal(mut st, fe, 0, eT, loadVal(mut st, eslot, 0, eT))
    relocateTo(mut st, fe, 0, eT, saved)
    br(mut st, bOut, -1)
    setCur(mut st, bNext)
    store(mut st, cursor, 0, load(mut st, fr, FR_NEXT))
    br(mut st, bLoop, -1)
    setCur(mut st, bOut)
    failed := load(mut st, fe, 0)
    if st.scopeKeep {
        // (B1): 子の預かりのスロットを返す（全部の子の鎖 — 写しは全部済んだ: Join / Try は値を scope の region へ写し、本体の値と未回収の err は上で親へ写した）
        keepRelease(mut st, rec)
    }
    // 子が全部終わった — 手元のプールの温かい分の超過を返す（rt.slot_trim — report-574 の T1）
    call(mut st, st.rtSlotTrim, list0(mut st))
    st.scopeKeep = keep0
    regionSetDepth(mut st, saved)
    popScope(mut st)
    // (値, nil) / (ゼロ値, TaskDied{cause})
    ts := newAgg(mut st, t)
    es := newAgg(mut st, eT)
    bDead := newBlock(mut st)
    bLive := newBlock(mut st)
    bEnd := newBlock(mut st)
    bFail := newBlock(mut st)
    bOk := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, dead, zero), bDead, -1, bLive, -1)
    setCur(mut st, bLive)
    condbr(mut st, cmp(mut st, CNe, failed, zero), bFail, -1, bOk, -1)
    setCur(mut st, bOk)
    storeVal(mut st, ts, 0, t, v)
    store(mut st, es, 0, zero)
    br(mut st, bEnd, -1)
    setCur(mut st, bFail)
    // 失敗: (ゼロ値, 子の err)
    for w <- iter.Range(0, tWords(mut st, t)) {
        store(mut st, ts, w, zero)
    }
    zeroFill(mut st, ts, 0, t)
    storeVal(mut st, es, 0, eT, loadVal(mut st, fe, 0, eT))
    br(mut st, bEnd, -1)
    setCur(mut st, bDead)
    for w <- iter.Range(0, tWords(mut st, t)) {
        store(mut st, ts, w, zero)
    }
    zeroFill(mut st, ts, 0, t)
    cv := newAgg(mut st, cT)
    store(mut st, cv, 0, cause)
    el := node(mut st, ast.KElem, at, int(strLit(mut st, "cause")), node(mut st, EVal, at, cT, cv, 0, 0), 0, 0)
    ce := node(mut st, ast.EComposite, at, int(strLit(mut st, "TaskDied")), list1(mut st, el), list0(mut st), 0)
    savedPk := st.curPkg
    st.curPkg = pk
    lv, lerr := composite(mut st, desugar.NodeRef(ce))
    st.curPkg = savedPk
    if lerr != nil {
        return 0, lerr
    }
    ev := coerce(mut st, lv.t, lv.v, eT, at)?
    storeVal(mut st, es, 0, eT, ev.v)
    br(mut st, bEnd, -1)
    setCur(mut st, bEnd)
    r := listN(mut st, 4)
    desugar.HeapSet(mut st.d, r, 2)
    desugar.HeapSet(mut st.d, r + 1, t)
    desugar.HeapSet(mut st.d, r + 2, loadVal(mut st, ts, 0, t))
    desugar.HeapSet(mut st.d, r + 3, eT)
    desugar.HeapSet(mut st.d, r + 4, es)
    return r, nil
}

// keepRelease は scope の記録 rec の預かりの鎖（SR_KEEP — (B1)）を全部返す（scope の出口と、開いたまま終わる task の後始末 — 段 6 P4-5）
func keepRelease(st mut St, rec int) {
    zero := iconst(mut st, 0)
    kl := newBlock(mut st)
    kp := param(mut st, kl, TyI64)
    kb := newBlock(mut st)
    kg := newBlock(mut st)
    kn := newBlock(mut st)
    kd := newBlock(mut st)
    br(mut st, kl, list1(mut st, load(mut st, rec, SR_KEEP)))
    setCur(mut st, kl)
    condbr(mut st, cmp(mut st, CEq, kp, zero), kd, -1, kb, -1)
    setCur(mut st, kb)
    kf := itop(mut st, kp)
    br(mut st, kg, -1)
    setCur(mut st, kg)
    // 預かり（rt.kid_keep）を手放す: 長さ 0 = 小さな塊 → 今のワーカーの塊の鎖へ・それ以外は munmap
    kln := load(mut st, kf, KP_USED)
    ksl := load(mut st, kf, KP_SLOT)
    kS := newBlock(mut st)
    kB := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, kln, zero), kS, -1, kB, -1)
    setCur(mut st, kS)
    kwk := globaladdr(mut st, st.wkG)
    store(mut st, itop(mut st, ksl), 0, load(mut st, kwk, WK_SLAB))
    store(mut st, kwk, WK_SLAB, ksl)
    br(mut st, kn, -1)
    setCur(mut st, kB)
    call(mut st, st.rtUnmap, list2(mut st, ksl, kln))
    br(mut st, kn, -1)
    setCur(mut st, kn)
    br(mut st, kl, list1(mut st, load(mut st, kf, KP_NEXT)))
    setCur(mut st, kd)
}

// drainScopes は task tcb の開いている scope（TC_SCOPE の鎖 — 内から外へ）の子を待って預かりを返す（段 6 P4-5）: 罠で巻き戻った task（死んだ・
// 切られた）は出口を通らないので、自分のスロットの上の記録・孫の枠を孫が使い終わるまで手放さない（P4-4 の穴 — M:N で孫が返したスロットへ書いた）。
// 印を立てるので切ってよい孫は検査点で止まる（死んだ task の孫の値は誰も見ない）。正常に戻った task の鎖は空（1 回の load と分岐だけ）
func drainScopes(st mut St, tcb int) {
    zero := iconst(mut st, 0)
    dl := newBlock(mut st)
    dp := param(mut st, dl, TyI64)
    db := newBlock(mut st)
    dd := newBlock(mut st)
    br(mut st, dl, list1(mut st, load(mut st, tcb, TC_SCOPE)))
    setCur(mut st, dl)
    condbr(mut st, cmp(mut st, CEq, dp, zero), dd, -1, db, -1)
    setCur(mut st, db)
    r := itop(mut st, dp)
    atomicXchg(mut st, r, SR_CUT, iconst(mut st, 1))
    cutRaise(mut st)
    waitLive(mut st, r)
    keepRelease(mut st, r)
    br(mut st, dl, list1(mut st, load(mut st, r, SR_UP)))
    setCur(mut st, dd)
    store(mut st, tcb, TC_SCOPE, zero)
}

// parSpawnIn は `par.SpawnIn(s, pool, () => 本体, budget: b)`（段 6 P5-4 — admit.sober の rt.task_new_in）: プールの天井に入れれば Spawn と同じ形で子を生んで
// (some handle, nil)・入れなければ (nil, Shed{})（縮退しない）。入場は枠を作る前（shed の子の枠を scope の鎖に残さない）
func parSpawnIn(st mut St, pk int, args desugar.ListRef, at desugar.NodeRef) (int, error?) {
    if lenL(mut st, args) != 4 {
        return 0, diag.Mismatch{at: posOf(mut st, at)}
    }
    // 呼び出しの型 = (Task[T]?, error?)
    y := desugar.YTypeOf(mut st.d, at)
    yh := desugar.ParSpawnInTaskY(mut st.d, y)
    if yh < 0 {
        return 0, diag.Mismatch{at: posOf(mut st, at)}
    }
    tt := parSpawnTyY(mut st, yh, at)?
    hoT := yLower(mut st, desugar.ParSpawnInY(mut st.d, y, 0), at)?
    eT := yLower(mut st, desugar.ParSpawnInY(mut st.d, y, 1), at)?
    needPoolRt(mut st)
    hs := newAgg(mut st, hoT)
    es := newAgg(mut st, eT)
    st.parIn = hs
    hv := parSpawn(mut st, pk, tt, args, at, false)?
    st.parIn = -1
    if hv == -1 {
        return -1, nil
    }
    // 入場できた道（parSpawn の最後 — 今のブロックは入場の道の終わり）: (some handle, nil)
    hT := desugar.HeapGet(mut st.d, hv + 1)
    hx := coerce(mut st, hT, desugar.HeapGet(mut st.d, hv + 2), hoT, at)?
    storeVal(mut st, hs, 0, hoT, hx.v)
    store(mut st, es, 0, iconst(mut st, 0))
    bEnd := newBlock(mut st)
    br(mut st, bEnd, -1)
    // shed の道（parSpawn が作った — st.parInShed）: (nil, Shed{})
    setCur(mut st, st.parInShed)
    store(mut st, hs, 0, iconst(mut st, 0))
    ce := node(mut st, ast.EComposite, at, int(strLit(mut st, "Shed")), list0(mut st), list0(mut st), 0)
    savedPk := st.curPkg
    st.curPkg = pk
    lv, lerr := composite(mut st, desugar.NodeRef(ce))
    st.curPkg = savedPk
    if lerr != nil {
        return 0, lerr
    }
    ev := coerce(mut st, lv.t, lv.v, eT, at)?
    storeVal(mut st, es, 0, eT, ev.v)
    br(mut st, bEnd, -1)
    setCur(mut st, bEnd)
    r := listN(mut st, 4)
    desugar.HeapSet(mut st.d, r, 2)
    desugar.HeapSet(mut st.d, r + 1, hoT)
    desugar.HeapSet(mut st.d, r + 2, loadVal(mut st, hs, 0, hoT))
    desugar.HeapSet(mut st.d, r + 3, eT)
    desugar.HeapSet(mut st.d, r + 4, es)
    return r, nil
}

// parSpawn は `par.Spawn(s, () => 本体)`: 枠を作って捕獲を写し、子の関数を罠を張って呼ぶ（st.parIn >= 0 なら par.SpawnIn の形 — 実引数 = [札, プール, ラムダ, budget]）
func parSpawn(st mut St, pk int, tt SpawnTy, args desugar.ListRef, at desugar.NodeRef, give bool) (int, error?) {
    t := tt.t
    // 枠の結果の語 = T（error を返す task は T の後ろに err）
    rw := tWords(mut st, t) + (if tt.e >= 0 { tWords(mut st, tt.e) } else { 0 })
    // 実引数 = [札, (give の端点 / SpawnIn のプール,) ラムダ, budget]（budget: の省略は loader が nil で埋める — 段 6 P5-3）
    inn := st.parIn >= 0
    na := if give || inn { 4 } else { 3 }
    if lenL(mut st, args) != na {
        return 0, diag.Mismatch{at: posOf(mut st, at)}
    }
    lam := latN(mut st, args, na - 2)
    if kindN(mut st, lam) != ast.ELambda || lenL(mut st, lA(nodeOf(mut st, lam))) != (if give { 1 } else { 0 }) {
        return 0, diag.Par{at: posOf(mut st, lam), kind: 3}
    }
    sx := expr(mut st, latN(mut st, args, 0))?
    if isTag(mut st, sx.t, TNever) {
        return -1, nil
    }
    rec := itop(mut st, load(mut st, sx.v, 0))
    // SpawnIn（段 6 P5-4）: 枠を作る前にプールの天井へ入場（rt.task_new_in — 入れなければ 0 = shed の道 st.parInShed へ）
    mut tcbIn := -1
    mut siteIn := -1
    if inn {
        px := expr(mut st, latN(mut st, args, 1))?
        if isTag(mut st, px.t, TNever) {
            return -1, nil
        }
        st.nsite += 1
        siteIn = st.nsite
        budIn := budgetArg(mut st, latN(mut st, args, na - 1))?
        tcbIn = call(mut st, st.rtTaskNewIn, list3(mut st, iconst(mut st, siteIn * 4), budIn, load(mut st, px.v, 0)))
        bGo := newBlock(mut st)
        st.parInShed = newBlock(mut st)
        condbr(mut st, cmp(mut st, CNe, ptoi(mut st, tcbIn), iconst(mut st, 0)), bGo, -1, st.parInShed, -1)
        setCur(mut st, bGo)
    }
    // give: の端点（SpawnGive — 子の仮引数に束ねる捕獲の先頭）。持ち主でなければ失効した別名（定義された panic）
    mut ex := Val{t: -1, v: 0}
    mut ch := 0
    mut chEnd := CH_OTX
    if give {
        cutMarkChan(mut st)
        ex = expr(mut st, latN(mut st, args, 1))?
        if isTag(mut st, ex.t, TNever) {
            return -1, nil
        }
        ch = itop(mut st, load(mut st, ex.v, 0))
        chEnd = if parIsTx(mut st, pk, ex.t, at)? { CH_OTX } else { CH_ORX }
        parOwnerCheck(mut st, ch, chEnd, at)
    }
    // 捕獲 = ラムダの中で束ねていない名前のうち今の可視範囲の局所（関数・const・package の名前は子の関数で引き直す）
    names := desugar.LamFree(mut st.d, lam)
    nn := lenL(mut st, names)
    cn := desugar.ListRef(listN(mut st, nn + 1))
    ct := desugar.ListRef(listN(mut st, nn + 1))
    cv := listN(mut st, nn + 1)
    mut m := 0
    mut words := FR_RES + rw
    if give {
        lput(mut st, cn, 0, int(sA(nodeOf(mut st, latN(mut st, lA(nodeOf(mut st, lam)), 0)))))
        lput(mut st, ct, 0, ex.t)
        desugar.HeapSet(mut st.d, cv + 1, ex.v)
        words += tWords(mut st, ex.t)
        m = 1
    }
    // 閉包の捕獲（std/par の展開される口の中 — par.Map の `() => f(x)`。P3b-5）: 閉包のラムダを子の本体へ展開する（β 簡約で持ち上げ）。
    // 閉包の自由変数（定義の可視範囲の imm の局所）を枠に写し、子の入口で閉包を組み直す — 記録 = [名前, 閉包, 名前の列, 型の列, 値の列, 束縛の型]
    cs := listN(mut st, nn * 6)
    mut ncl := 0
    for i <- iter.Range(0, nn) {
        name := desugar.StrRef(latI(mut st, names, i))
        l := lookup(mut st, name)
        if l >= 0 {
            if desugar.HeapGet(mut st.d, l + 2) == LClosure {
                c := desugar.HeapGet(mut st.d, l + 4)
                fr := closureFree(mut st, c, lam)?
                desugar.HeapSet(mut st.d, cs + 1 + ncl * 6, int(name))
                desugar.HeapSet(mut st.d, cs + 2 + ncl * 6, c)
                desugar.HeapSet(mut st.d, cs + 3 + ncl * 6, desugar.HeapGet(mut st.d, fr))
                desugar.HeapSet(mut st.d, cs + 4 + ncl * 6, desugar.HeapGet(mut st.d, fr + 1))
                desugar.HeapSet(mut st.d, cs + 5 + ncl * 6, desugar.HeapGet(mut st.d, fr + 2))
                desugar.HeapSet(mut st.d, cs + 6 + ncl * 6, desugar.HeapGet(mut st.d, l + 3))
                fns := desugar.ListRef(desugar.HeapGet(mut st.d, fr + 1))
                for q <- iter.Range(0, lenL(mut st, fns)) {
                    words += tWords(mut st, latI(mut st, fns, q))
                }
                ncl += 1
                continue
            }
            if desugar.HeapGet(mut st.d, l + 2) != LVal {
                // mut の束縛（セル）は子へ渡せない — ParCheck が名指し済み（kind 4 — ここへは来ない）
                return 0, diag.Par{at: posOf(mut st, lam), kind: 4}
            }
            lput(mut st, cn, m, int(name))
            lput(mut st, ct, m, desugar.HeapGet(mut st.d, l + 3))
            desugar.HeapSet(mut st.d, cv + 1 + m, desugar.HeapGet(mut st.d, l + 4))
            words += tWords(mut st, desugar.HeapGet(mut st.d, l + 3))
            m += 1
        }
    }
    desugar.HeapSet(mut st.d, int(cn), m)
    desugar.HeapSet(mut st.d, int(ct), m)
    // 結果が region を持つ子は枠の後ろに預かりの欄（rt.kid_keep が書く — TC_KOFF が位置）
    koff := words
    if containsSlice(mut st, t) || (tt.e >= 0 && containsSlice(mut st, tt.e)) {
        words += KP_WORDS
    }
    frame := regionAlloc(mut st, load(mut st, rec, SR_DEPTH), iconst(mut st, words))
    mut off := FR_RES + rw
    for i <- iter.Range(0, m) {
        ty := latI(mut st, ct, i)
        storeVal(mut st, frame, off, ty, desugar.HeapGet(mut st.d, cv + 1 + i))
        off += tWords(mut st, ty)
    }
    for k <- iter.Range(0, ncl) {
        fts := desugar.ListRef(desugar.HeapGet(mut st.d, cs + 4 + k * 6))
        fvs := desugar.HeapGet(mut st.d, cs + 5 + k * 6)
        for w <- iter.Range(0, lenL(mut st, fts)) {
            ty := latI(mut st, fts, w)
            storeVal(mut st, frame, off, ty, desugar.HeapGet(mut st.d, fvs + 1 + w))
            off += tWords(mut st, ty)
        }
    }
    desugar.HeapSet(mut st.d, cs, ncl * 6)
    kid := kidFunc(mut st, lam, tt, cn, ct, at, cs)
    store(mut st, frame, FR_STATE, iconst(mut st, 0))
    store(mut st, frame, FR_SREC, ptoi(mut st, rec))
    store(mut st, frame, FR_JOINER, iconst(mut st, 0))
    store(mut st, frame, FR_COL, iconst(mut st, 0))
    // FR_NEXT / FR_EOFF は error を返す子の列（SR_FHEAD）だけが読む — それ以外の子は書かない
    if tt.e >= 0 {
        store(mut st, frame, FR_NEXT, iconst(mut st, 0))
        store(mut st, frame, FR_EOFF, iconst(mut st, tWords(mut st, t)))
    } else if st.rtMut == 1 {
        store(mut st, frame, FR_EOFF, iconst(mut st, 0))
    }
    keepKid := containsSlice(mut st, t) || (tt.e >= 0 && containsSlice(mut st, tt.e))
    if keepKid {
        st.scopeKeep = true
    }
    // 全部の子の鎖の先頭へ（出口の死因の選び方 — 生んだ順で最初の死）
    store(mut st, frame, FR_ANEXT, load(mut st, rec, SR_ALL))
    store(mut st, rec, SR_ALL, ptoi(mut st, frame))
    if tt.e >= 0 {
        // scope の error を返す子の列の末尾へ（出口が生んだ順に未回収の失敗を探す）
        tail := load(mut st, rec, SR_FTAIL)
        bE := newBlock(mut st)
        bN := newBlock(mut st)
        bJ := newBlock(mut st)
        condbr(mut st, cmp(mut st, CEq, tail, iconst(mut st, 0)), bE, -1, bN, -1)
        setCur(mut st, bE)
        store(mut st, rec, SR_FHEAD, ptoi(mut st, frame))
        br(mut st, bJ, -1)
        setCur(mut st, bN)
        store(mut st, itop(mut st, tail), FR_NEXT, ptoi(mut st, frame))
        br(mut st, bJ, -1)
        setCur(mut st, bJ)
        store(mut st, rec, SR_FTAIL, ptoi(mut st, frame))
    }
    // 入場（段 6 P5-2 admit.sober）: 台帳に見積もりを積めれば task として生む・積めなければ縮退（その場で今の task の上で呼ぶ — P3a の即時形）。
    // give: の子は縮退しない（常に入場 — 超過は記帳）。生んだ順の番号は両方の道で数える
    mut site := siteIn
    if !inn {
        st.nsite += 1
        site = st.nsite
    }
    kidx := load(mut st, rec, SR_NKID)
    store(mut st, rec, SR_NKID, bin(mut st, BAdd, kidx, iconst(mut st, 1)))
    // 子の task（task.sober）: 塊を取る（入場を兼ねる — 入場できなければ 0）。SpawnIn は入場済みの塊
    mut tcb := tcbIn
    if !inn {
        bud := budgetArg(mut st, latN(mut st, args, na - 1))?
        tcb = call(mut st, st.rtTaskNew, list2(mut st, iconst(mut st, site * 4 + (if parRootOnly(mut st, latN(mut st, args, 0)) { 2 } else { 0 }) + (if give { 1 } else { 0 })), bud))
    }
    bJoin := newBlock(mut st)
    if !give && !inn {
        bTask := newBlock(mut st)
        bInl := newBlock(mut st)
        condbr(mut st, cmp(mut st, CNe, ptoi(mut st, tcb), iconst(mut st, 0)), bTask, -1, bInl, -1)
        setCur(mut st, bInl)
        call(mut st, st.rtTaskInline, list4(mut st, frame, funcaddr(mut st, kid), kidx, iconst(mut st, if keepKid { koff } else { 0 })))
        br(mut st, bJoin, -1)
        setCur(mut st, bTask)
    }
    // 生きている子の数（× 2 — 下の位は出口の待ちの印・子は別のワーカーで並行に減らす — 段 6 P4-4）
    atomicXadd(mut st, rec, SR_LIVE, iconst(mut st, 2))
    // 子を先に走らせる（rt.task_go — 子が終わると rt.task_start が状態・死因・scope の死の数を書いてここへ戻す。
    // 深度・宛先 / anchor のレジスタ・罠の記録は切替が退避 / 復元する）
    meta := globaladdr(mut st, st.meta)
    me := itop(mut st, load(mut st, globaladdr(mut st, st.taskG), TK_CUR))
    d := load(mut st, meta, W_DEPTH)
    zero := iconst(mut st, 0)
    store(mut st, tcb, TC_DEPTH, d)
    store(mut st, tcb, TC_BASE, d)
    store(mut st, tcb, TC_OWN, d)
    store(mut st, tcb, TC_DEST, zero)
    store(mut st, tcb, TC_ANCHOR, zero)
    store(mut st, tcb, TC_TRAP, zero)
    store(mut st, tcb, TC_WAKER, ptoi(mut st, me))
    store(mut st, tcb, TC_FRAME, ptoi(mut st, frame))
    store(mut st, tcb, TC_KID, funcaddr(mut st, kid))
    if keepKid {
        store(mut st, tcb, TC_KOFF, iconst(mut st, koff))
    }
    // 純な子か（段 6 P4-5 — cancel.sober: io もチャネルも持たない — build の最後に定数を決める）・生んだ順の番号（scope の子を生むのは本体を走らせる task だけ）
    store(mut st, tcb, TC_CUTOK, cutFlag(mut st, kid))
    store(mut st, tcb, TC_IDX, kidx)
    if give {
        // 端点の持ち主を子へ（親に残った別名は失効 — 使うと panic）
        store(mut st, ch, chEnd, ptoi(mut st, tcb))
    }
    // spawn の切替点（rt.task_go — 既定 = 子を先に: 親を走れる積みに載せて子へ。SOBER_SCHED で親を先にも選べる）
    store(mut st, tcb, TC_STARTED, iconst(mut st, 0))
    call(mut st, st.rtTaskGo, list2(mut st, me, tcb))
    br(mut st, bJoin, -1)
    setCur(mut st, bJoin)
    hT := desugar.HeapGet(mut st.d, parInfo(mut st, pk, "Task", t, at)? + SI_TY)
    hv := newAgg(mut st, hT)
    store(mut st, hv, 0, ptoi(mut st, frame))
    return parOne(mut st, hT, hv), nil
}

// parRootOnly は spawn の札の実引数 x が、字面で内側に budget: の scope がある外の scope の札か（その子は根だけに計上する — 今効いている節は内の
// scope の記録で、外の scope の子はそれより長く生きうる。値は不変・外の天井を見ないだけ）
func parRootOnly(st mut St, x desugar.NodeRef) bool {
    if kindN(mut st, x) != ast.EIdent {
        return false
    }
    nm := sA(nodeOf(mut st, x))
    mut inner := false
    mut p := st.parToks
    while p >= 0 {
        if strEq(mut st, desugar.StrRef(desugar.HeapGet(mut st.d, p + 1)), nm) {
            return inner
        }
        inner = inner || desugar.HeapGet(mut st.d, p + 2) == 1
        p = desugar.HeapGet(mut st.d, p)
    }
    return false
}

// budgetArg は budget: の実引数 x（int か int? — 呼び出しを含まない整数式〔ParCheck kind 20〕）の値（nil・0 以下は 0 = 宣言なし）
func budgetArg(st mut St, x desugar.NodeRef) (int, error?) {
    if kindN(mut st, x) == ast.ENil {
        return iconst(mut st, 0), nil
    }
    v := expr(mut st, x)?
    if isTag(mut st, v.t, TOpt) {
        return imax(mut st, bin(mut st, BMul, load(mut st, v.v, 0), load(mut st, v.v, 1)), iconst(mut st, 0)), nil
    }
    return imax(mut st, v.v, iconst(mut st, 0)), nil
}

// kidFunc は子の本体（ラムダ lam・結果の型 t・捕獲の名前 cn と型 ct）を持ち上げた関数 kid#N を作業列に積む（本体は funcBody が下ろす — 捕獲は kidParams）
func kidFunc(st mut St, lam desugar.NodeRef, tt SpawnTy, cn desugar.ListRef, ct desugar.ListRef, at desugar.NodeRef, cs int) FnRef {
    np := lenL(mut st, cn)
    params := listN(mut st, np)
    for i <- iter.Range(0, np) {
        desugar.HeapSet(mut st.d, params + 1 + i, node(mut st, ast.KParam, at, latI(mut st, cn, i), -1, 0, 0))
    }
    // 本体 = `return 本体の値`。本体がブロック `{ 文…; 値 }` なら文を関数の本体に並べて末尾の値を return（ブロックの region を開かない —
    // 子の region は関数の入口の 1 つ。コアの spawn の本体と同じ境界 — scripts/regionbound.sh）
    body := nB(nodeOf(mut st, lam))
    mut stmtsL := list1(mut st, node(mut st, ast.SRet, at, list1(mut st, int(body)), 0, 0, 0))
    if kindN(mut st, body) == ast.EBlock {
        l := lA(nodeOf(mut st, body))
        n := lenL(mut st, l)
        last := if n > 0 { latN(mut st, l, n - 1) } else { desugar.NodeRef(-1) }
        if n > 0 && kindN(mut st, last) == ast.SExpr {
            stmtsL = listN(mut st, n)
            for i <- iter.Range(0, n - 1) {
                desugar.HeapSet(mut st.d, stmtsL + 1 + i, int(latN(mut st, l, i)))
            }
            desugar.HeapSet(mut st.d, stmtsL + n, node(mut st, ast.SRet, last, list1(mut st, int(nA(nodeOf(mut st, last)))), 0, 0, 0))
        }
    }
    blk := node(mut st, ast.KBlock, at, stmtsL, 0, 0, 0)
    decl := desugar.NodeRef(desugar.SynNode(mut st.d, ast.Node{kind: ast.KFuncDecl, tok: tokN(mut st, at), a: int(strLit(mut st, "kid")), b: list0(mut st), c: params, d: list0(mut st), e: blk, f: -1}, at))
    key := strCat(mut st, strLit(mut st, "kid#"), decimal(mut st, st.nkid))
    st.nkid = st.nkid + 1
    irf := addFunc(mut st, int(key), desugar.ListRef(list1(mut st, TyPtr)), -1)
    fi := table.Len(mut st.infos)
    res := if tt.e >= 0 { list2(mut st, tt.t, tt.e) } else { list1(mut st, tt.t) }
    table.Push(mut st.infos, FnInfo{fn: -1, pkg: st.curPkg, ir: irf, params: ct, results: desugar.ListRef(res), next: st.work, decl: decl, env: st.tenv, transp: false})
    st.work = fi
    st.kids = rec4(mut st, st.kids, fi, cs, 0)
    return irf
}

// isKid は FnInfo fi が std/par の子の関数か
func isKid(st mut St, fi int) bool {
    mut k := st.kids
    while k >= 0 {
        if desugar.HeapGet(mut st.d, k + 1) == fi {
            return true
        }
        k = desugar.HeapGet(mut st.d, k)
    }
    return false
}

// kidParams は子の関数の入口: 捕獲（仮引数の節 ps・型 params）を枠の結果の語の後ろから読んで束縛する（実引数 0 = 枠の結果の置き場）。
// 閉包の捕獲（P3b-5）は自由変数を外の可視範囲に束ねてから閉包を組み直し（凍結した鎖はそこまで — 子の捕獲に隠されない）、
// 内の可視範囲に閉包の名前と普通の捕獲を束ねる
func kidParams(st mut St, ps desugar.ListRef, params desugar.ListRef) {
    rl := desugar.ListRef(infoAt(mut st, st.info).results)
    mut off := 0
    for j <- iter.Range(0, lenL(mut st, rl)) {
        off += tWords(mut st, latI(mut st, rl, j))
    }
    mut coff := off
    for j <- iter.Range(0, lenL(mut st, ps)) {
        coff += tWords(mut st, latI(mut st, params, j))
    }
    cs := kidClosures(mut st, st.info)
    ncl := if cs >= 0 { desugar.HeapGet(mut st.d, cs) / 6 } else { 0 }
    cl := listN(mut st, ncl)
    for k <- iter.Range(0, ncl) {
        fnm := desugar.ListRef(desugar.HeapGet(mut st.d, cs + 3 + k * 6))
        fts := desugar.ListRef(desugar.HeapGet(mut st.d, cs + 4 + k * 6))
        pushScope(mut st)
        for w <- iter.Range(0, lenL(mut st, fnm)) {
            t := latI(mut st, fts, w)
            kidBind(mut st, desugar.StrRef(latI(mut st, fnm, w)), t, coff)
            coff += tWords(mut st, t)
        }
        cr := cloAt(mut st, desugar.HeapGet(mut st.d, cs + 2 + k * 6))
        c := table.Len(mut st.closures)
        table.Push(mut st.closures, Closure{lambda: cr.lambda, ft: cr.ft, pkg: cr.pkg, chain: freezeChain(mut st), ret: desugar.HeapGet(mut st.d, st.rets + 1), inl: st.inlining, env: cr.env})
        desugar.HeapSet(mut st.d, cl + 1 + k, c)
    }
    pushScope(mut st)
    for k <- iter.Range(0, ncl) {
        declare(mut st, desugar.StrRef(desugar.HeapGet(mut st.d, cs + 1 + k * 6)), LClosure, desugar.HeapGet(mut st.d, cs + 6 + k * 6), desugar.HeapGet(mut st.d, cl + 1 + k))
    }
    for j <- iter.Range(0, lenL(mut st, ps)) {
        t := latI(mut st, params, j)
        kidBind(mut st, sA(nodeOf(mut st, latN(mut st, ps, j))), t, off)
        off += tWords(mut st, t)
    }
}

// kidBind は枠の語 off から型 t の捕獲を読んで名前 name に束ねる
func kidBind(st mut St, name desugar.StrRef, t int, off int) {
    if isScalar(mut st, t) {
        declare(mut st, name, LVal, t, load(mut st, 0, off))
    } else {
        slot := newAgg(mut st, t)
        for w <- iter.Range(0, tWords(mut st, t)) {
            store(mut st, slot, w, load(mut st, 0, off + w))
        }
        declare(mut st, name, LVal, t, slot)
    }
}

// kidClosures は子の関数 fi の閉包の捕獲の記録（無ければ -1）
func kidClosures(st mut St, fi int) int {
    mut k := st.kids
    while k >= 0 {
        if desugar.HeapGet(mut st.d, k + 1) == fi {
            return desugar.HeapGet(mut st.d, k + 2)
        }
        k = desugar.HeapGet(mut st.d, k)
    }
    return -1
}

// closureFree は閉包 c の自由変数（定義の可視範囲の局所 — 子へ写す）の [名前の列, 型の列, 値の列]。imm の値だけ（mut のセル・入れ子の閉包は拒否）
func closureFree(st mut St, c int, lam desugar.NodeRef) (int, error?) {
    cr := cloAt(mut st, c)
    names := desugar.LamFree(mut st.d, cr.lambda)
    nn := lenL(mut st, names)
    fn := desugar.ListRef(listN(mut st, nn))
    ft := desugar.ListRef(listN(mut st, nn))
    fv := listN(mut st, nn)
    saved := st.chain
    st.chain = cr.chain
    mut m := 0
    for i <- iter.Range(0, nn) {
        name := desugar.StrRef(latI(mut st, names, i))
        l := lookup(mut st, name)
        if l >= 0 {
            if desugar.HeapGet(mut st.d, l + 2) != LVal {
                st.chain = saved
                return 0, diag.Par{at: posOf(mut st, lam), kind: if desugar.HeapGet(mut st.d, l + 2) == LClosure { 11 } else { 4 }}
            }
            lput(mut st, fn, m, int(name))
            lput(mut st, ft, m, desugar.HeapGet(mut st.d, l + 3))
            desugar.HeapSet(mut st.d, fv + 1 + m, desugar.HeapGet(mut st.d, l + 4))
            m += 1
        }
    }
    st.chain = saved
    desugar.HeapSet(mut st.d, int(fn), m)
    desugar.HeapSet(mut st.d, int(ft), m)
    desugar.HeapSet(mut st.d, fv, m)
    return rec4(mut st, int(fn), int(ft), fv, 0), nil
}

// yType は節 e の表層型（表層型検査器の表）の lower の型（写せなければ型の不一致）
func yType(st mut St, e desugar.NodeRef) (int, error?) {
    t := yLower(mut st, desugar.YTypeOf(mut st.d, e), e)?
    if t < 0 {
        return 0, diag.Mismatch{at: posOf(mut st, e)}
    }
    return t, nil
}

// ── チャネル（段 6 P3b — language.md 11 節「チャネル」・コアの newch / send / recv）──
// 記録は NewChan の最内の region（scope の本体なら scope の region — 子が終わるまで生きる）。端点の値 = 記録の番地（1 語）。持ち主は記録に
// task ごと（送り端・受け端 — 作った task が両方を持ち、give: で子へ移る）。満杯の Send・空の Recv は待つ（起こすのは相手の Recv / Send）

// parIsTx は端点の型 t が送り端（Tx[T] のインスタンス）か
func parIsTx(st mut St, pk int, t int, at desugar.NodeRef) (bool, error?) {
    if !isTag(mut st, t, TStruct) {
        return false, diag.Mismatch{at: posOf(mut st, at)}
    }
    decl := desugar.NodeRef(desugar.HeapGet(mut st.d, desugar.HeapGet(mut st.d, t + 1) + SI_DECL))
    return strIs(mut st, sA(nodeOf(mut st, decl)), "Tx"), nil
}

// parOwnerCheck は端点の持ち主（記録 ch の欄 end）が今の task でなければ死ぬ（give: で子へ移した後の親の別名 — 定義された panic）
func parOwnerCheck(st mut St, ch int, end int, at desugar.NodeRef) {
    bad := newBlock(mut st)
    ok := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, load(mut st, ch, end), load(mut st, globaladdr(mut st, st.taskG), TK_CUR)), bad, -1, ok, -1)
    setCur(mut st, bad)
    panicSite(mut st, PK_STALE, at)
    setCur(mut st, ok)
}

// parNewChan は `par.NewChan[T](cap: n)`: 記録を確保して (Tx[T], Rx[T])
func parNewChan(st mut St, pk int, args desugar.ListRef, at desugar.NodeRef, callee0 desugar.NodeRef) (int, error?) {
    cutMarkChan(mut st)
    if lenL(mut st, args) != 1 || kindN(mut st, latN(mut st, args, 0)) != ast.EInt || kindN(mut st, callee0) != ast.EIndex {
        return 0, diag.Par{at: posOf(mut st, at), kind: 13}
    }
    capN := nodeOf(mut st, latN(mut st, args, 0)).a
    ix := nB(nodeOf(mut st, callee0))
    tn := node(mut st, ast.TName, ix, nodeOf(mut st, ix).a, 0, 0, 0)
    t := resolveType(mut st, st.curPkg, desugar.NodeRef(tn), false)?
    txT := desugar.HeapGet(mut st.d, parInfo(mut st, pk, "Tx", t, at)? + SI_TY)
    rxT := desugar.HeapGet(mut st.d, parInfo(mut st, pk, "Rx", t, at)? + SI_TY)
    tw := if tWords(mut st, t) < 1 { 1 } else { tWords(mut st, t) }
    // region を持つペイロードは枠ごとの小アリーナ [スロットの基底, 使った量] を記録の後ろに（段 6 P4-4 (B4) — 0 = まだ無い）
    aw := if containsSlice(mut st, t) { 2 * capN } else { 0 }
    chp := regionAlloc(mut st, regionDepth(mut st), iconst(mut st, CH_BUF + capN * tw + aw))
    for i <- iter.Range(0, aw) {
        store(mut st, chp, CH_BUF + capN * tw + i, iconst(mut st, 0))
    }
    me := load(mut st, globaladdr(mut st, st.taskG), TK_CUR)
    zero := iconst(mut st, 0)
    store(mut st, chp, CH_CAP, iconst(mut st, capN))
    store(mut st, chp, CH_HEAD, zero)
    store(mut st, chp, CH_TAIL, zero)
    store(mut st, chp, CH_OTX, me)
    store(mut st, chp, CH_ORX, me)
    store(mut st, chp, CH_WSEND, zero)
    store(mut st, chp, CH_WRECV, zero)
    store(mut st, chp, CH_ITEM, iconst(mut st, tw))
    store(mut st, chp, CH_RDEPTH, regionDepth(mut st))
    store(mut st, chp, CH_MAKER, me)
    store(mut st, chp, CH_CLOSED, zero)
    tx := newAgg(mut st, txT)
    store(mut st, tx, 0, ptoi(mut st, chp))
    rx := newAgg(mut st, rxT)
    store(mut st, rx, 0, ptoi(mut st, chp))
    r := listN(mut st, 4)
    desugar.HeapSet(mut st.d, r, 2)
    desugar.HeapSet(mut st.d, r + 1, txT)
    desugar.HeapSet(mut st.d, r + 2, tx)
    desugar.HeapSet(mut st.d, r + 3, rxT)
    desugar.HeapSet(mut st.d, r + 4, rx)
    return r, nil
}

// parClose は `par.Close(tx)`: 持ち主でなければ・閉じた後なら死ぬ。閉じた印を立て、待っている受け手を起こす（空なら nil を受ける）
func parClose(st mut St, args desugar.ListRef, at desugar.NodeRef) (int, error?) {
    cutMarkChan(mut st)
    if lenL(mut st, args) != 1 {
        return 0, diag.Mismatch{at: posOf(mut st, at)}
    }
    ep := expr(mut st, latN(mut st, args, 0))?
    if isTag(mut st, ep.t, TNever) {
        return -1, nil
    }
    chp := itop(mut st, load(mut st, ep.v, 0))
    parOwnerCheck(mut st, chp, CH_OTX, at)
    parClosedCheck(mut st, chp, PK_CLOSE2, at)
    store(mut st, chp, CH_CLOSED, iconst(mut st, 1))
    w := atomicXchg(mut st, chp, CH_WRECV, iconst(mut st, 0))
    bW := newBlock(mut st)
    bW2 := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, w, iconst(mut st, 0)), bW, -1, bW2, -1)
    setCur(mut st, bW)
    taskWakeAny(mut st, itop(mut st, w))
    br(mut st, bW2, -1)
    setCur(mut st, bW2)
    return list0(mut st), nil
}

// parClosedCheck は記録 ch が閉じていれば死ぬ（種類 kind — 閉じた後の Send・二度目の Close）
func parClosedCheck(st mut St, ch int, kind int, at desugar.NodeRef) {
    bad := newBlock(mut st)
    ok := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, load(mut st, ch, CH_CLOSED), iconst(mut st, 0)), bad, -1, ok, -1)
    setCur(mut st, bad)
    panicSite(mut st, kind, at)
    setCur(mut st, ok)
}

// parSendRecv は `par.Send(tx, v)` / `par.Recv(rx)`（Recv は T? — 閉じて空なら nil）
func parSendRecv(st mut St, pk int, key int, args desugar.ListRef, at desugar.NodeRef) (int, error?) {
    cutMarkChan(mut st)
    send := key == desugar.PAR_SEND
    if lenL(mut st, args) != (if send { 2 } else { 1 }) {
        return 0, diag.Mismatch{at: posOf(mut st, at)}
    }
    ep := expr(mut st, latN(mut st, args, 0))?
    if isTag(mut st, ep.t, TNever) {
        return -1, nil
    }
    t := taskArg(mut st, ep.t, at)?
    chp := itop(mut st, load(mut st, ep.v, 0))
    parOwnerCheck(mut st, chp, if send { CH_OTX } else { CH_ORX }, at)
    if send {
        parClosedCheck(mut st, chp, PK_SENDCLOSED, at)
    }
    mut vv := 0
    if send {
        x := expr(mut st, latN(mut st, args, 1))?
        if isTag(mut st, x.t, TNever) {
            return -1, nil
        }
        x2 := coerce(mut st, x.t, x.v, t, at)?
        vv = copyVal(mut st, t, x2.v)
    }
    // 待つ: Send は満杯の間・Recv は空で開いている間（waitWhileZero と同じ待ちの型 — 待ち手の語へ xchg・見直し・外せなければ起こしを吸う。段 6 P4-4）
    wmy := if send { CH_WSEND } else { CH_WRECV }
    loop := newBlock(mut st)
    body := newBlock(mut st)
    late := newBlock(mut st)
    absorb := newBlock(mut st)
    sleep := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, -1)
    setCur(mut st, loop)
    chanBlocked(mut st, chp, send, body, done)
    setCur(mut st, body)
    atomicXchg(mut st, chp, wmy, load(mut st, globaladdr(mut st, st.taskG), TK_CUR))
    chanBlocked(mut st, chp, send, sleep, late)
    setCur(mut st, late)
    wl := atomicXchg(mut st, chp, wmy, iconst(mut st, 0))
    condbr(mut st, cmp(mut st, CEq, wl, iconst(mut st, 0)), absorb, -1, done, -1)
    setCur(mut st, absorb)
    call(mut st, st.rtTaskWait, list0(mut st))
    br(mut st, done, -1)
    setCur(mut st, sleep)
    call(mut st, st.rtTaskWait, list0(mut st))
    br(mut st, loop, -1)
    setCur(mut st, done)
    // 受け: 空のまま抜けた（= 閉じて空）なら nil（全語 0）— 閉じた印を見た後に送った数を読み直す（送り手は最後の送りを閉じる前に書いた）
    mut p := 0
    mut ot := 0
    mut bEnd := BlkRef(-1)
    if !send {
        ot = yType(mut st, at)?
        p = newAgg(mut st, ot)
        bEnd = newBlock(mut st)
        bNil := newBlock(mut st)
        bVal := newBlock(mut st)
        condbr(mut st, cmp(mut st, CEq, load(mut st, chp, CH_TAIL), load(mut st, chp, CH_HEAD)), bNil, -1, bVal, -1)
        setCur(mut st, bNil)
        if containsSlice(mut st, t) {
            // 閉じて空 = もう送られない — 枠の小アリーナを返す（段 6 P4-4 (B4)）
            call(mut st, st.rtChanFree, list2(mut st, chanArena(mut st, chp, t, iconst(mut st, 0)), load(mut st, chp, CH_CAP)))
        }
        for i <- iter.Range(0, if tWords(mut st, ot) < 1 { 1 } else { tWords(mut st, ot) }) {
            store(mut st, p, i, iconst(mut st, 0))
        }
        br(mut st, bEnd, -1)
        setCur(mut st, bVal)
    }
    capV := load(mut st, chp, CH_CAP)
    n := load(mut st, chp, if send { CH_TAIL } else { CH_HEAD })
    idx := bin(mut st, BRem, n, capV)
    slot := gepWord(mut st, chp, bin(mut st, BAdd, iconst(mut st, CH_BUF), bin(mut st, BMul, idx, load(mut st, chp, CH_ITEM))))
    mut out := 0
    if send {
        storeVal(mut st, slot, 0, t, vv)
        if containsSlice(mut st, t) {
            chanSendCopy(mut st, chp, slot, t, idx)
        }
        // 枠の公開（Lamport — 中身を書いてから送った数を進める）
        mnDelayPoint(mut st)
        store(mut st, chp, CH_TAIL, bin(mut st, BAdd, n, iconst(mut st, 1)))
    } else {
        out = copyVal(mut st, t, loadVal(mut st, slot, 0, t))
        if containsSlice(mut st, t) {
            out = chanRecvCopy(mut st, chp, out, t, idx)
        }
        store(mut st, chp, CH_HEAD, bin(mut st, BAdd, n, iconst(mut st, 1)))
    }
    // 相手が待っていれば起こす（xchg で取る — 待ちの型の起こし手）
    w := atomicXchg(mut st, chp, if send { CH_WRECV } else { CH_WSEND }, iconst(mut st, 0))
    bW := newBlock(mut st)
    bW2 := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, w, iconst(mut st, 0)), bW, -1, bW2, -1)
    setCur(mut st, bW)
    taskWakeAny(mut st, itop(mut st, w))
    br(mut st, bW2, -1)
    setCur(mut st, bW2)
    if send {
        return list0(mut st), nil
    }
    store(mut st, p, 0, iconst(mut st, 1))
    storeVal(mut st, p, 1, t, out)
    br(mut st, bEnd, -1)
    setCur(mut st, bEnd)
    return parOne(mut st, ot, p), nil
}

// chanBlocked は Send（満杯）/ Recv（空で開いている）の待ちの条件で yes / no へ分岐する
func chanBlocked(st mut St, chp int, send bool, yes BlkRef, no BlkRef) {
    cnt := bin(mut st, BSub, load(mut st, chp, CH_TAIL), load(mut st, chp, CH_HEAD))
    if send {
        condbr(mut st, cmp(mut st, CEq, cnt, load(mut st, chp, CH_CAP)), yes, -1, no, -1)
        return
    }
    bEmpty := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, cnt, iconst(mut st, 0)), bEmpty, -1, no, -1)
    setCur(mut st, bEmpty)
    condbr(mut st, cmp(mut st, CNe, load(mut st, chp, CH_CLOSED), iconst(mut st, 0)), no, -1, yes, -1)
}

// chanArena は記録 chp の枠 idx の小アリーナの欄 [基底, 使った量] の番地（要素の語数 tw は型から — 段 6 P4-4 (B4)）
func chanArena(st mut St, chp int, t int, idx int) int {
    tw := if tWords(mut st, t) < 1 { 1 } else { tWords(mut st, t) }
    base := bin(mut st, BAdd, iconst(mut st, CH_BUF), bin(mut st, BMul, load(mut st, chp, CH_CAP), iconst(mut st, tw)))
    return gepWord(mut st, chp, bin(mut st, BAdd, base, bin(mut st, BMul, idx, iconst(mut st, 2))))
}

// chanSendCopy は region を持つペイロード（枠 slot に置いた値）を枠 idx の小アリーナへ写す（段 6 P4-4 (B4) — 書き手 = 送り端の持ち主だけ）:
// 深度 rd（記録の深度）のスロットと bump をアリーナへ付け替えて rd より深い部分を写し（印 = MAX_DEPTH — 受け手が必ず自分の region へ写す）、戻す。
// アリーナの前の中身は受け手が写し終えている（枠が空いた = 受けた数が進んだ後にだけ送り手はこの枠を書く）
func chanSendCopy(st mut St, chp int, slot int, t int, idx int) {
    meta := globaladdr(mut st, st.meta)
    sg := globaladdr(mut st, st.slotsG)
    wk := globaladdr(mut st, st.wkG)
    ar := chanArena(mut st, chp, t, idx)
    bNew := newBlock(mut st)
    bHave := newBlock(mut st)
    bGo := newBlock(mut st)
    a := param(mut st, bGo, TyI64)
    a0 := load(mut st, ar, 0)
    condbr(mut st, cmp(mut st, CEq, a0, iconst(mut st, 0)), bNew, -1, bHave, -1)
    setCur(mut st, bNew)
    a1 := call(mut st, st.rtSlotTake, list0(mut st))
    store(mut st, ar, 0, a1)
    br(mut st, bGo, list1(mut st, a1))
    setCur(mut st, bHave)
    br(mut st, bGo, list1(mut st, a0))
    setCur(mut st, bGo)
    rd := load(mut st, chp, CH_RDEPTH)
    sp := gepWord(mut st, sg, rd)
    bp := gepWord(mut st, meta, rd)
    oldS := load(mut st, sp, 0)
    oldB := load(mut st, bp, W_BUMP)
    store(mut st, sp, 0, a)
    store(mut st, bp, W_BUMP, a)
    store(mut st, wk, WK_RLAB, iconst(mut st, MAX_DEPTH))
    relocateTo(mut st, slot, 0, t, rd)
    store(mut st, wk, WK_RLAB, iconst(mut st, 0))
    store(mut st, ar, 1, bin(mut st, BSub, load(mut st, bp, W_BUMP), a))
    store(mut st, sp, 0, oldS)
    store(mut st, bp, W_BUMP, oldB)
}

// chanRecvCopy は受けた値 v（枠 idx のアリーナを指す部分は印 MAX_DEPTH）を受け手の最内の region へ写す（Lean の recv の型 = 受け手の最内）
func chanRecvCopy(st mut St, chp int, v int, t int, idx int) int {
    slot := newAgg(mut st, t)
    storeVal(mut st, slot, 0, t, v)
    relocateTo(mut st, slot, 0, t, regionDepth(mut st))
    return loadVal(mut st, slot, 0, t)
}
