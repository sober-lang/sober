// FS.FConvOp.dom（方程式 6 本）
func dom(st mut S, a0 int) int {
    // FS.FConvOp.dom.eq_1
    if a0 == W_FNEG {
        return st.tF64
    }
    // FS.FConvOp.dom.eq_2
    if a0 == W_FSQRT {
        return st.tF64
    }
    // FS.FConvOp.dom.eq_3
    if a0 == W_FTOINT {
        return st.tF64
    }
    // FS.FConvOp.dom.eq_4
    if a0 == W_FBITS {
        return st.tF64
    }
    // FS.FConvOp.dom.eq_5
    if a0 == W_TOFLOAT {
        return st.tInt
    }
    // FS.FConvOp.dom.eq_6（最後の腕 — 先行の腕が外れれば当たる: a0 == W_FFROMBITS）
    return st.tInt
}

