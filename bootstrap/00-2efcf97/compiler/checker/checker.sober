package checker

// 入口: コア AST JSON のバイト列 → 判定 JSON のバイト列（sober-check の stdout と同じ — Json.lean の checkInput + IO.println）。
// parse error の文言だけは写さない（Lean の Json.parse / fromJson の文言 — 差分オラクルは "parse error" までで比べる。仮決め R11-2）

// defRec は Def の記録 [param, ret, body, tparams, mask] を 1 つ組む（g = defs の要素の汎用の記録）。
// parts = 部分検査の封筒（body の無い Def は署名だけ — 本体 triv・mask 0）。組めなければ -1
func defRec(st mut S, g int, parts bool, triv int) int {
    fp := gField(mut st, g, W_PARAM)
    fr := gField(mut st, g, W_RET)
    fb := gField(mut st, g, W_BODY)
    ft := gField(mut st, g, W_TPARAMS)
    if fp < 0 || fr < 0 || st.h[fp] != V_TY || st.h[fr] != V_TY {
        return -1
    }
    // tparams は getObjValAs? Nat の失敗を 0 に読む（toOption.getD 0）
    tp := if ft >= 0 && st.h[ft] == V_NUM && st.h[ft + 1] >= 0 { st.h[ft + 1] } else { 0 }
    mut body := triv
    mut mask := 1
    if fb < 0 {
        if !parts {
            return -1
        }
        mask = 0
    } else if st.h[fb] != V_EXPR {
        return -1
    } else {
        body = st.h[fb + 1]
    }
    return rec5(mut st, st.h[fp + 1], st.h[fr + 1], body, tp, mask)
}

// program は根の値から関数表（G_DEFS）を組み、根の式を返す。-1 = 根の式なし（部分検査）、-2 = parse error
func program(st mut S, p Parsed) int {
    if !isObjTag(p.tag) || p.gen < 0 {
        return -2
    }
    g := p.gen
    fparts := gField(mut st, g, W_PARTS)
    parts := fparts >= 0 && st.h[fparts] == V_TRUE
    fd := gField(mut st, g, W_DEFS)
    if fd < 0 {
        if parts || p.tag != V_EXPR {
            return -2
        }
        st.h[G_DEFS] = rec4(mut st, 0, 0, 0, 0)
        return p.val
    }
    if st.h[fd] != V_ARR {
        return -2
    }
    triv := node(mut st, W_TRIV, 0, 0, 0, 0)
    arr := st.h[fd + 1]
    n := st.h[arr]
    ds := block(mut st, n + 1)
    st.h[ds] = n
    mut c := st.h[arr + 1]
    mut i := 0
    while c >= 0 {
        if !isObjTag(st.h[c]) || st.h[c + 2] < 0 {
            return -2
        }
        dr := defRec(mut st, st.h[c + 2], parts, triv)
        if dr < 0 {
            return -2
        }
        st.h[ds + 1 + i] = dr
        i += 1
        c = st.h[c + 3]
    }
    st.h[G_DEFS] = ds
    fe := gField(mut st, g, W_E)
    if fe < 0 {
        return if parts { -1 } else { -2 }
    }
    if st.h[fe] != V_EXPR {
        return -2
    }
    return st.h[fe + 1]
}

// Check は src（コア AST JSON）を検査し、判定 JSON（改行つき）を返す
func Check(src []int) []int {
    mut st := S{}
    hv0 := block(mut st, GLOBALS)
    st.h[0] = hv0
    hv1 := mk(mut st, TInt, 0, 0, 0)
    st.h[G_T_INT] = hv1
    hv2 := mk(mut st, TBool, 0, 0, 0)
    st.h[G_T_BOOL] = hv2
    hv3 := mk(mut st, TUnit, 0, 0, 0)
    st.h[G_T_UNIT] = hv3
    initWords(mut st)
    md := maxDepth(src)
    hv4 := block(mut st, (md + 1) * FS)
    st.h[G_PSTK] = hv4
    hv5 := block(mut st, (md + 2) * CF)
    st.h[G_CSTK] = hv5
    p := parseJson(mut st, src)
    mut root := -2
    if p.ok {
        root = program(mut st, p)
    }
    if root == -2 {
        return bytes("{\"errors\":[{\"msg\":\"parse error\"}],\"ok\":false}\n")
    }
    return verdict(mut st, root)
}

// verdict は checkAll の判定を JSON（改行つき）にする（Json.lean の checkToJson / checkPartsToJson の形）
func verdict(st mut S, root int) []int {
    mut out := mut []int{}
    r := checkAll(mut st, root)
    if r == R_TYPE {
        lit(mut out, "{\"errors\":[{\"msg\":\"type error\"}],\"ok\":false}")
    } else if r == R_DEF {
        lit(mut out, "{\"errors\":[{\"msg\":\"def error\"}],\"ok\":false}")
    } else if r == R_NOTY {
        lit(mut out, "{\"ok\":true}")
    } else {
        lit(mut out, "{\"ok\":true,\"ty\":")
        tyJson(mut st, mut out, r)
        out = append(out, 125)
    }
    out = append(out, 10)
    return freeze(out)
}
