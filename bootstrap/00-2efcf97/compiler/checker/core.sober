package checker

// 脱糖器の結果（desugar.Core — 脱糖器のヒープの読み出し専用の眺め）を JSON を経ずに検査する入口（Sober 版 `sober check` の直結）。
//
// 写し替え（仮決め R12-1）: 脱糖器のコア式・型の記録を、この検査器の記録へ 1 本ずつ写す。写し方は脱糖器の JSON 印字
// （compiler/desugar/json.sober の exprJson / tyJson / defJson）が吐く JSON を json.sober が読んだ結果と同じ記録になるように揃える:
// - 使われていないラベルは透過、使われたラベルは label t e（整形 WDiscard = let e triv、WAnn = ann e t を挟む）
// - jump の添字 = 写し中の囲む（使われた）ラベルのうち目標より内側にある数
// - map の型・mkmap はキー型 / 値型 → セル型 prod k (opt v)、string の印は落とす（JSON に出ない）
// 意味の判定は一切しない（検査は checkAll が JSON 経由と同じ記録の上で行う）

import "desugar"

// 写しの作業領域の大きさ（枠 = [脱糖器の式, 段]、値 = [記録, 入れ子の深さ]）。超えたら R_DEEP
const XSTK = 262144
const XLAB = 16384
const R_DEEP = -4

// ctyOf は脱糖器の型 t（desugar の T* — 5 語 [tag, a, b, c, d]）をこの検査器の型へ写す
func ctyOf(st mut S, h []int, t int) int {
    k := h[t]
    if k == desugar.TInt {
        return st.h[G_T_INT]
    }
    if k == desugar.TBool {
        return st.h[G_T_BOOL]
    }
    if k == desugar.TUnit {
        return st.h[G_T_UNIT]
    }
    if k == desugar.TVar {
        return mk(mut st, TVar, h[t + 1], 0, 0)
    }
    if k == desugar.TOpt {
        x := ctyOf(mut st, h, h[t + 1])
        return mk(mut st, TOpt, x, 0, 0)
    }
    if k == desugar.TUn || k == desugar.TPr || k == desugar.TFn {
        l := ctyOf(mut st, h, h[t + 1])
        r := ctyOf(mut st, h, h[t + 2])
        return mk(mut st, if k == desugar.TUn { TUn } else if k == desugar.TPr { TPr } else { TFn }, l, r, 0)
    }
    if k == desugar.TSl || k == desugar.TRef {
        x := ctyOf(mut st, h, h[t + 3])
        return mk(mut st, if k == desugar.TSl { TSl } else { TRef }, h[t + 1], h[t + 2], x)
    }
    if k == desugar.TMp {
        kt := ctyOf(mut st, h, h[t + 3])
        vt := ctyOf(mut st, h, h[t + 4])
        o := mk(mut st, TOpt, vt, 0, 0)
        cl := mk(mut st, TPr, kt, o, 0)
        return mk(mut st, TMp, h[t + 1], h[t + 2], cl)
    }
    // TChan（脱糖器は作らない）
    x := ctyOf(mut st, h, h[t + 2])
    return mk(mut st, TChan, h[t + 1], x, 0)
}

// ctsOf は型引数の列（desugar の [n, t…]、-1 = 無し）。空は -1（json.sober の tsOf と同じ）
func ctsOf(st mut S, h []int, l int) int {
    if l < 0 || h[l] == 0 {
        return -1
    }
    n := h[l]
    at := block(mut st, n + 1)
    st.h[at] = n
    mut i := 0
    while i < n {
        t := ctyOf(mut st, h, h[l + 1 + i])
        st.h[at + 1 + i] = t
        i += 1
    }
    return at
}

// binWord は arith / cmp の種類（desugar の B*）を語の番号へ
func binWord(b int) int {
    return switch b {
    case 1: W_SUB
    case 2: 39
    case 3: 40
    case 4: 41
    case 5: W_EQ
    case 6: 48
    case 7: 49
    case 8: 50
    case 9: W_GE
    case 10: 42
    case 11: 43
    case 12: 44
    case 13: 45
    default: W_SHR
    }
}

// kids は写し終えてから組む前に要る子の数（葉は 0）
func kids(k int) int {
    if k == desugar.CLet || k == desugar.CAdd || k == desugar.CLt || k == desugar.CPair || k == desugar.CAssign || k == desugar.CWhile || k == desugar.CAppend || k == desugar.CEqs || k == desugar.CConcat || k == desugar.CCallv || k == desugar.CBin || k == desugar.CIndex || k == desugar.CGetm || k == desugar.CDelm {
        return 2
    }
    if k == desugar.CIte || k == desugar.CIfnil || k == desugar.CCase || k == desugar.CSetidx || k == desugar.CSubslice || k == desugar.CSetm {
        return 3
    }
    if k == desugar.CSome || k == desugar.CFst || k == desugar.CSnd || k == desugar.CBlock || k == desugar.CDeref || k == desugar.CFreeze || k == desugar.CLen || k == desugar.CLenm || k == desugar.CKeysm || k == desugar.CAnn || k == desugar.CBlockR || k == desugar.CInl || k == desugar.CInr || k == desugar.CCall || k == desugar.CAlloc || k == desugar.CLabel || k == desugar.CJump {
        return 1
    }
    return 0
}

// kidAt は i 番目の子（写す順）
func kidAt(h []int, x int, i int) int {
    k := h[x]
    if k == desugar.CBin || k == desugar.CGetm || k == desugar.CDelm {
        return h[x + 2 + i]
    }
    if k == desugar.CBlockR || k == desugar.CInl || k == desugar.CInr || k == desugar.CCall || k == desugar.CAlloc {
        return h[x + 2]
    }
    if k == desugar.CLabel || k == desugar.CJump {
        return h[x + 3]
    }
    return h[x + 1 + i]
}

// convExpr は脱糖器の式 e0 を写す（明示スタック）。結果は記録、深すぎれば -1。G_MAXDEPTH を入れ子の深さの最大で更新する
func convExpr(st mut S, h []int, e0 int, fs int, vs int, ls int) int {
    mut fsp := 0
    mut vsp := 0
    mut lsp := 0
    st.h[fs] = e0
    st.h[fs + 1] = 0
    fsp = 1
    while fsp > 0 {
        fr := fs + (fsp - 1) * 2
        x := st.h[fr]
        ph := st.h[fr + 1]
        k := h[x]
        a := h[x + 1]
        b := h[x + 2]
        c := h[x + 3]
        d := h[x + 4]
        n := kids(k)
        // 使われていないラベルは透過（子をそのまま自分の位置に写す）
        if k == desugar.CLabel && h[a + desugar.LBUsed] == 0 {
            st.h[fr] = c
            continue
        }
        if ph == 0 && n > 0 {
            if fsp + n > XSTK {
                return -1
            }
            st.h[fr + 1] = 1
            if k == desugar.CLabel {
                if lsp >= XLAB {
                    return -1
                }
                st.h[ls + lsp] = h[a]
                lsp += 1
            }
            mut i := n - 1
            while i >= 0 {
                nf := fs + fsp * 2
                st.h[nf] = kidAt(h, x, i)
                st.h[nf + 1] = 0
                fsp += 1
                i -= 1
            }
            continue
        }
        // 子の値（写した順に vs に積まれている）
        vb := vs + (vsp - n) * 2
        v0 := if n > 0 { st.h[vb] } else { -1 }
        v1 := if n > 1 { st.h[vb + 2] } else { -1 }
        v2 := if n > 2 { st.h[vb + 4] } else { -1 }
        mut dep := 0
        mut j := 0
        while j < n {
            if st.h[vb + j * 2 + 1] > dep {
                dep = st.h[vb + j * 2 + 1]
            }
            j += 1
        }
        dep += 1
        vsp -= n
        mut r := -1
        if k == desugar.CLit {
            r = node(mut st, W_LIT, 0, 0, 0, 0)
        }
        if k == desugar.CTT {
            r = node(mut st, W_TRUE, 0, 0, 0, 0)
        }
        if k == desugar.CFF {
            r = node(mut st, W_FALSE, 0, 0, 0, 0)
        }
        if k == desugar.CTriv {
            r = node(mut st, W_TRIV, 0, 0, 0, 0)
        }
        if k == desugar.CVar {
            r = node(mut st, W_VAR, 0, a, 0, 0)
        }
        if k == desugar.CLet || k == desugar.CAdd || k == desugar.CLt || k == desugar.CPair || k == desugar.CAssign || k == desugar.CWhile || k == desugar.CAppend || k == desugar.CEqs || k == desugar.CConcat || k == desugar.CCallv {
            w := if k == desugar.CLet { W_LET } else if k == desugar.CAdd { W_ADD } else if k == desugar.CLt { W_LT } else if k == desugar.CPair { W_PAIR } else if k == desugar.CAssign { W_ASSIGN } else if k == desugar.CWhile { W_WHILE } else if k == desugar.CAppend { W_APPEND } else if k == desugar.CEqs { W_EQS } else if k == desugar.CConcat { W_CONCAT } else { W_CALLV }
            r = node(mut st, w, 0, v0, v1, 0)
        }
        if k == desugar.CBin {
            r = node(mut st, binWord(a), 0, v0, v1, 0)
        }
        if k == desugar.CIte || k == desugar.CIfnil || k == desugar.CCase || k == desugar.CSetidx || k == desugar.CSubslice || k == desugar.CSetm {
            w := if k == desugar.CIte { W_IF } else if k == desugar.CIfnil { W_IFNIL } else if k == desugar.CCase { W_CASE } else if k == desugar.CSetidx { W_SETIDX } else if k == desugar.CSubslice { W_SUBSLICE } else { W_SETM }
            r = node(mut st, w, 0, v0, v1, v2)
        }
        if k == desugar.CNil {
            t := ctyOf(mut st, h, a)
            r = node(mut st, W_NIL, 0, t, 0, 0)
        }
        if k == desugar.CSome || k == desugar.CFst || k == desugar.CSnd || k == desugar.CBlock || k == desugar.CDeref || k == desugar.CFreeze || k == desugar.CLen || k == desugar.CLenm || k == desugar.CKeysm {
            w := if k == desugar.CSome { W_SOME } else if k == desugar.CFst { W_FST } else if k == desugar.CSnd { W_SND } else if k == desugar.CBlock { W_BLOCK } else if k == desugar.CDeref { W_DEREF } else if k == desugar.CFreeze { W_FREEZE } else if k == desugar.CLen { W_LEN } else if k == desugar.CLenm { W_LENM } else { W_KEYSM }
            r = node(mut st, w, 0, v0, 0, 0)
        }
        if k == desugar.CAnn {
            t := ctyOf(mut st, h, b)
            r = node(mut st, W_ANN, 0, v0, t, 0)
        }
        if k == desugar.CBlockR {
            t := ctyOf(mut st, h, a)
            r = node(mut st, K_BLOCKR, 0, v0, t, 0)
        }
        if k == desugar.CInl || k == desugar.CInr {
            t := ctyOf(mut st, h, a)
            r = node(mut st, if k == desugar.CInl { W_INL } else { W_INR }, 0, t, v0, 0)
        }
        if k == desugar.CCall {
            ts := ctsOf(mut st, h, c)
            r = node(mut st, if d != 0 { W_CALLM } else { W_CALL }, 0, a, ts, v0)
        }
        if k == desugar.CFnref {
            ts := ctsOf(mut st, h, b)
            r = node(mut st, W_FNREF, 0, a, ts, 0)
        }
        if k == desugar.CAlloc {
            r = node(mut st, W_ALLOC, 0, a, v0, 0)
        }
        if k == desugar.CStrlit {
            r = node(mut st, W_STRLIT, 0, b, 0, 0)
        }
        if k == desugar.CMkslice {
            t := ctyOf(mut st, h, b)
            r = node(mut st, W_MKSLICE, 0, a, t, 0)
        }
        if k == desugar.CIndex {
            t := if c >= 0 { ctyOf(mut st, h, c) } else { -1 }
            r = node(mut st, W_INDEX, 0, v0, v1, t)
        }
        if k == desugar.CMkmap {
            kt := ctyOf(mut st, h, b)
            vt := ctyOf(mut st, h, c)
            o := mk(mut st, TOpt, vt, 0, 0)
            cl := mk(mut st, TPr, kt, o, 0)
            r = node(mut st, W_MKMAP, 0, a, cl, 0)
        }
        if k == desugar.CGetm || k == desugar.CDelm {
            t := ctyOf(mut st, h, a)
            r = node(mut st, if k == desugar.CGetm { W_GETM } else { W_DELM }, 0, t, v0, v1)
        }
        if k == desugar.CLabel {
            lsp -= 1
            t := ctyOf(mut st, h, b)
            mut inner := v0
            if d == desugar.WDiscard {
                tv := node(mut st, W_TRIV, 0, 0, 0, 0)
                inner = node(mut st, W_LET, 0, v0, tv, 0)
                dep += 1
            } else if d == desugar.WAnn {
                inner = node(mut st, W_ANN, 0, v0, t, 0)
                dep += 1
            }
            r = node(mut st, W_LABEL, 0, t, inner, 0)
        }
        if k == desugar.CJump {
            mut m := 0
            mut q := lsp - 1
            while q >= 0 && st.h[ls + q] != a {
                m += 1
                q -= 1
            }
            t := ctyOf(mut st, h, b)
            r = node(mut st, W_JUMP, 0, m, t, v0)
        }
        if dep > st.h[G_MAXDEPTH] {
            st.h[G_MAXDEPTH] = dep
        }
        fsp -= 1
        if fsp == 0 {
            return r
        }
        st.h[vs + vsp * 2] = r
        st.h[vs + vsp * 2 + 1] = dep
        vsp += 1
    }
    return -1
}

// CheckCore は脱糖の結果 c を検査し、判定 JSON（checkdump と同じバイト列。深すぎて写せなければ checker: too deep）を返す
func CheckCore(c desugar.Core) []int {
    h := c.H
    mut st := S{}
    hv0 := block(mut st, GLOBALS)
    st.h[0] = hv0
    hv1 := mk(mut st, TInt, 0, 0, 0)
    st.h[G_T_INT] = hv1
    hv2 := mk(mut st, TBool, 0, 0, 0)
    st.h[G_T_BOOL] = hv2
    hv3 := mk(mut st, TUnit, 0, 0, 0)
    st.h[G_T_UNIT] = hv3
    fs := block(mut st, XSTK * 2)
    vs := block(mut st, XSTK * 2)
    ls := block(mut st, XLAB)
    // 関数表: 名前付き関数（宣言順）→ 持ち上げたラムダ（持ち上げ順）— defJson の順
    nn := h[c.Defs]
    mut nl := 0
    mut q := c.Lifted
    while q >= 0 {
        nl += 1
        q = h[q + 4]
    }
    ds := block(mut st, nn + nl + 1)
    st.h[ds] = nn + nl
    st.h[G_DEFS] = ds
    // 写す仕事: 0..nn+nl-1 = Def の本体、nn+nl = 根の式（呼び出し点を 1 つにする — convExpr は展開される）
    mut root := -1
    q = c.Lifted
    mut j := 0
    while j <= nn + nl {
        mut src := -1
        if j < nn + nl {
            src = if j < nn { h[c.Defs + 1 + j] } else { q }
        }
        e0 := if j < nn + nl { h[src + 2] } else { c.Root }
        r := convExpr(mut st, h, e0, fs, vs, ls)
        if r < 0 {
            return bytes("checker: too deep\n")
        }
        if j < nn + nl {
            p := ctyOf(mut st, h, h[src])
            rt := ctyOf(mut st, h, h[src + 1])
            hv6 := rec5(mut st, p, rt, r, h[src + 3], 1)
            st.h[ds + 1 + j] = hv6
            if j >= nn {
                q = h[q + 4]
            }
        } else {
            root = r
        }
        j += 1
    }
    hv7 := block(mut st, (st.h[G_MAXDEPTH] + 4) * CF)
    st.h[G_CSTK] = hv7
    return verdict(mut st, root)
}
