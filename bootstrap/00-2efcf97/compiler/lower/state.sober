package lower

// Sober 版 lower（src/lower*.zig の写し — 表層 AST → 独自 SSA IR → IR テキスト。docs/ir.md が境界の正）の状態と土台。
//
// 表現（仮決め R24-1 — selfhost-drafts）: 状態は脱糖器と同じ desugar.S（int ヒープ 1 本 st.h）。表層 AST と表（package・関数・const）は
// desugar.Init が組んだものをそのまま読む（節 = 8 語 [kind, tok, a..f]、列 = [n, 要素…]、文字列 = [n, バイト…]）。
// lower 自身の状態のスカラーはヒープに取った固定の枠（番地 = st.h[0] + L_*）に置き、IR（モジュール・関数・ブロック・命令）と
// 型・スコープの記録もすべて同じヒープに積む（記録は添字で指し、無しは -1）。
// 再帰する関数は `st mut desugar.S` を持ち回る Def（R2 の callM）になる。渡す imm の値は int と string リテラルだけにする（F-6）

import "desugar"

// Fail は lower の拒否（Zig 版の error.Unsupported 等 — 文言は持たない。差分オラクルは拒否の有無だけを比べる）
type LowerFail error {
    k int
    tok int
}

const KUnsupported = 1
const KUndefined = 2
const KMismatch = 3
const KMissing = 4

// ── 状態のスカラー（st.h[0] + L_*）──
const LSIZE = 64
const L_FHEAD = 1       // 関数の記録の鎖（追加順 = 印字順）
const L_FTAIL = 2
const L_GHEAD = 3       // グローバルの鎖（追加順）
const L_GTAIL = 4
const L_FN = 5          // 組み立て中の関数
const L_CUR = 6         // 組み立て中のブロック（-1 = 到達しない）
const L_META = 7        // @rt.meta
const L_RT_FLUSH = 8
const L_RT_PCHAR = 9
const L_RT_PINT = 10
const L_RT_RENTER = 11
const L_RT_RALLOC = 12
const L_RT_RELOC = 13
const L_RT_COPY = 14
const L_RT_STREQ = 15
const L_RT_MAPFIND = 16
const L_RT_PSTR = 17
const L_RT_READ = 18
const L_RT_WRITE = 19
const L_IOBUF = 20
const L_NSTR = 21       // 文字列リテラルの rodata の数
const L_FNINFO = 22     // 関数表の添字 → FnInfo（列、無しは -1）
const L_WORK = 23       // 本体を下ろす作業列（FnInfo の鎖 — 積んだ順の逆に取る = Zig の work.pop）
const L_INFO = 24       // 下ろし中の FnInfo
const L_CUR_PKG = 25
const L_SCOPE = 26      // スコープの鎖の先頭（内側）
const L_NSCOPE = 27
const L_LOOP = 28       // ループの鎖の先頭
const L_NLOOP = 29
const L_ENTRY_DEPTH = 30
const L_SRET = 31
const L_T_NONE = 32     // 型の定数
const L_T_INT = 33
const L_T_BOOL = 34
const L_T_NEVER = 35
const L_T_NIL = 36
const L_TYPES = 37      // 型宣言の記録の鎖（StructInfo / UnionInfo）
const L_STRS = 38       // 文字列リテラルの rodata の鎖（[next, 綴り, global]）
const L_NINTERP = 39    // 補間の穴の合成名の通し番号
const L_ERRS = 40       // error ラベルの union の情報（errs.sober — 初出で作る）
const L_ERRSTRUCT = 41  // 組み込み error の struct の情報（初出で作る）
const L_CHAIN = 42      // 名前の可視範囲の鎖（[n, (lo, hi)…] — スコープ番号の区間。hi = VOPEN は先頭まで）
const L_RETS = 43       // return の行き先のスタック（[prev, ctx] — ctx = -1 は実体の関数、他は InlineCtx）
const L_FLOORS = 44     // break / continue が届くループの下限のスタック（[prev, 床]）
const L_INLINING = 45   // 展開中の inline 関数の名前の列（再帰の展開の拒否）
const L_NLAMBDA = 46    // 持ち上げたラムダの通し番号
const L_TENV = 47       // 型環境（generics.sober — [n, (名前, 型)…]、-1 = 空）
const L_INSTS = 48      // ジェネリック関数のインスタンスの鎖（[next, キー, FnInfo]）
const L_IN_DICT = 49    // 辞書 const の展開中か（0 / 1）
const L_DLIFTS = 50     // 辞書 const の中で持ち上げたラムダ（[next, ラムダの節, IR の関数]）— 参照点の間で共有する
const L_RT_ARGS = 51    // rt.read_args / rt.read_dir / rt.write_fd（std/os・std/io の sysArgs / sysReadDir / sysWriteFd — R31）
const L_RT_DIR = 52
const L_RT_WFD = 53

const VOPEN = 1099511627776

func gv(st mut desugar.S, k int) int {
    return st.h[st.h[0] + k]
}

func gs(st mut desugar.S, k int, v int) {
    st.h[st.h[0] + k] = v
}

// ── ヒープの小道具（展開される — 呼び出し点ごとに小さい）──

func put(st mut desugar.S, x int) {
    st.h = append(st.h, x)
}

func top(st mut desugar.S) int {
    return len(st.h)
}

// recN は n 語の記録を確保する（中身は -1 — 呼び手が埋める）
@noinline
func recN(st mut desugar.S, n int) int {
    at := len(st.h)
    mut i := 0
    while i < n {
        st.h = append(st.h, -1)
        i += 1
    }
    return at
}

@noinline
func rec4(st mut desugar.S, a int, b int, c int, d int) int {
    at := len(st.h)
    st.h = append(st.h, a)
    st.h = append(st.h, b)
    st.h = append(st.h, c)
    st.h = append(st.h, d)
    return at
}

// listN は長さ n の列（中身は 0）
@noinline
func listN(st mut desugar.S, n int) int {
    at := len(st.h)
    st.h = append(st.h, n)
    mut i := 0
    while i < n {
        st.h = append(st.h, 0)
        i += 1
    }
    return at
}

func list0(st mut desugar.S) int {
    at := len(st.h)
    st.h = append(st.h, 0)
    return at
}

@noinline
func list1(st mut desugar.S, x int) int {
    at := len(st.h)
    st.h = append(st.h, 1)
    st.h = append(st.h, x)
    return at
}

@noinline
func list2(st mut desugar.S, x int, y int) int {
    at := len(st.h)
    st.h = append(st.h, 2)
    st.h = append(st.h, x)
    st.h = append(st.h, y)
    return at
}

@noinline
func list3(st mut desugar.S, x int, y int, z int) int {
    at := len(st.h)
    st.h = append(st.h, 3)
    st.h = append(st.h, x)
    st.h = append(st.h, y)
    st.h = append(st.h, z)
    return at
}

@noinline
func list4(st mut desugar.S, x int, y int, z int, w int) int {
    at := len(st.h)
    st.h = append(st.h, 4)
    st.h = append(st.h, x)
    st.h = append(st.h, y)
    st.h = append(st.h, z)
    st.h = append(st.h, w)
    return at
}

func llen(st mut desugar.S, l int) int {
    return st.h[l]
}

func lat(st mut desugar.S, l int, i int) int {
    return st.h[l + 1 + i]
}

// ── 文字列（[n, バイト…]）──

@noinline
func strLit(st mut desugar.S, w string) int {
    b := bytes(w)
    at := len(st.h)
    st.h = append(st.h, len(b))
    mut i := 0
    while i < len(b) {
        st.h = append(st.h, b[i])
        i += 1
    }
    return at
}

// strCat は文字列 a + "." + b（関数・型のキー "pkg_path.Name"）
@noinline
func strDot(st mut desugar.S, a int, b int) int {
    na := st.h[a]
    nb := st.h[b]
    at := len(st.h)
    st.h = append(st.h, na + 1 + nb)
    mut i := 0
    while i < na {
        st.h = append(st.h, st.h[a + 1 + i])
        i += 1
    }
    st.h = append(st.h, 46)
    i = 0
    while i < nb {
        st.h = append(st.h, st.h[b + 1 + i])
        i += 1
    }
    return at
}

// strPart は文字列 s のバイト [lo, hi) を新しい文字列にする
@noinline
func strPart(st mut desugar.S, s int, lo int, hi int) int {
    at := len(st.h)
    st.h = append(st.h, hi - lo)
    mut i := lo
    while i < hi {
        st.h = append(st.h, st.h[s + 1 + i])
        i += 1
    }
    return at
}

func strEq(st mut desugar.S, a int, b int) bool {
    n := st.h[a]
    if st.h[b] != n {
        return false
    }
    mut i := 1
    while i <= n {
        if st.h[a + i] != st.h[b + i] {
            return false
        }
        i += 1
    }
    return true
}

func strIs(st mut desugar.S, a int, w string) bool {
    b := bytes(w)
    if st.h[a] != len(b) {
        return false
    }
    mut i := 0
    while i < len(b) {
        if st.h[a + 1 + i] != b[i] {
            return false
        }
        i += 1
    }
    return true
}

// strEqPart は文字列 a と、文字列 s のバイト [lo, hi) の一致
func strEqPart(st mut desugar.S, a int, s int, lo int, hi int) bool {
    if st.h[a] != hi - lo {
        return false
    }
    mut i := 0
    while i < hi - lo {
        if st.h[a + 1 + i] != st.h[s + 1 + lo + i] {
            return false
        }
        i += 1
    }
    return true
}

// dotAt は文字列 s の最初の '.' の位置（無ければ -1）
func dotAt(st mut desugar.S, s int) int {
    mut i := 0
    while i < st.h[s] {
        if st.h[s + 1 + i] == 46 {
            return i
        }
        i += 1
    }
    return -1
}

// ── 表層 AST の読み出し（節 = [kind, tok, a, b, c, d, e, f] — desugar と同じ）──

const NA = 2
const NB = 3
const NC = 4
const ND = 5
const NE = 6
const NF = 7

// EVal は評価済みの値の節（lower が合成する — Zig の ArgSrc.val。pipe の左辺を引数へ渡す）: a = 型, b = 値
const EVal = 90

// node は表層 AST の節を足す（lower が合成する — 補間の連結の連鎖・pipe の値）
func node(st mut desugar.S, k int, tok int, a int, b int, c int, d int) int {
    at := recN(mut st, 8)
    st.h[at] = k
    st.h[at + 1] = tok
    st.h[at + NA] = a
    st.h[at + NB] = b
    st.h[at + NC] = c
    st.h[at + ND] = d
    st.h[at + NE] = 0
    st.h[at + NF] = 0
    return at
}

func kindOf(st mut desugar.S, n int) int {
    return st.h[n]
}

func tokOf(st mut desugar.S, n int) int {
    return if n < 0 { 0 } else { st.h[n + 1] }
}

// ── 表: package（[path, name, flo, fhi, imports（[n, (ref, pkg)…]）, 0]）・ファイル（[根, package]）・関数・const ──

func pkgPath(st mut desugar.S, pk int) int {
    return st.h[st.h[desugar.G_PKGS] + pk * desugar.PKSZ]
}

func pkgFlo(st mut desugar.S, pk int) int {
    return st.h[st.h[desugar.G_PKGS] + pk * desugar.PKSZ + 2]
}

func pkgFhi(st mut desugar.S, pk int) int {
    return st.h[st.h[desugar.G_PKGS] + pk * desugar.PKSZ + 3]
}

func fileRoot(st mut desugar.S, f int) int {
    return st.h[st.h[desugar.G_FILES] + f * 2]
}

// importOf は package pk の import の参照名（文字列 s のバイト [lo, hi)）の行き先 package（無ければ -1）
func importOf(st mut desugar.S, pk int, s int, lo int, hi int) int {
    im := st.h[st.h[desugar.G_PKGS] + pk * desugar.PKSZ + 4]
    mut i := 0
    while i < st.h[im] {
        if strEqPart(mut st, st.h[im + 1 + i * 2], s, lo, hi) {
            return st.h[im + 2 + i * 2]
        }
        i += 1
    }
    return -1
}

func isStdPkg(st mut desugar.S, pk int) bool {
    p := pkgPath(mut st, pk)
    return st.h[p] >= 4 && st.h[p + 1] == 115 && st.h[p + 2] == 116 && st.h[p + 3] == 100 && st.h[p + 4] == 47
}

func nfn(st mut desugar.S) int {
    return st.h[desugar.G_NFN]
}

func fnNode(st mut desugar.S, i int) int {
    return st.h[st.h[desugar.G_FNS] + i * desugar.FNSZ]
}

func fnPkg(st mut desugar.S, i int) int {
    return st.h[st.h[desugar.G_FNS] + i * desugar.FNSZ + 1]
}

func fnExpands(st mut desugar.S, i int) bool {
    return st.h[st.h[desugar.G_FNS] + i * desugar.FNSZ + 2] != 0
}

func fnMutDef(st mut desugar.S, i int) bool {
    return st.h[st.h[desugar.G_FNS] + i * desugar.FNSZ + 3] != 0
}

// 関数宣言の欄（KFuncDecl: a = 名前, b = type_params, c = params, d = results, e = body, f = 付加 [bodiless, …]）
func fnName(st mut desugar.S, i int) int {
    return st.h[fnNode(mut st, i) + NA]
}

func fnTParams(st mut desugar.S, i int) int {
    return st.h[fnNode(mut st, i) + NB]
}

func fnParams(st mut desugar.S, i int) int {
    return st.h[fnNode(mut st, i) + NC]
}

func fnResults(st mut desugar.S, i int) int {
    return st.h[fnNode(mut st, i) + ND]
}

func fnBody(st mut desugar.S, i int) int {
    return st.h[fnNode(mut st, i) + NE]
}

func fnBodiless(st mut desugar.S, i int) bool {
    x := st.h[fnNode(mut st, i) + NF]
    return x >= 0 && st.h[x + 1] != 0
}

func ncon(st mut desugar.S) int {
    return st.h[desugar.G_NCON]
}

func conNode(st mut desugar.S, i int) int {
    return st.h[st.h[desugar.G_CONS] + i * desugar.CNSZ]
}

func conPkg(st mut desugar.S, i int) int {
    return st.h[st.h[desugar.G_CONS] + i * desugar.CNSZ + 1]
}

func conValue(st mut desugar.S, i int) int {
    return st.h[st.h[desugar.G_CONS] + i * desugar.CNSZ + 2]
}

func conHas(st mut desugar.S, i int) bool {
    return st.h[st.h[desugar.G_CONS] + i * desugar.CNSZ + 3] != 0
}

func conDict(st mut desugar.S, i int) bool {
    return st.h[st.h[desugar.G_CONS] + i * desugar.CNSZ + 4] != 0
}

// findFnIn は package pk の関数 name（文字列 s のバイト [lo, hi)）の関数表の添字（無ければ -1）
func findFnIn(st mut desugar.S, pk int, s int, lo int, hi int) int {
    mut i := 0
    while i < nfn(mut st) {
        if fnPkg(mut st, i) == pk && strEqPart(mut st, fnName(mut st, i), s, lo, hi) {
            return i
        }
        i += 1
    }
    return -1
}

// findConIn は package pk の const name の表の添字（無ければ -1）
func findConIn(st mut desugar.S, pk int, s int, lo int, hi int) int {
    mut i := 0
    while i < ncon(mut st) {
        if conPkg(mut st, i) == pk && strEqPart(mut st, st.h[conNode(mut st, i) + NA], s, lo, hi) {
            return i
        }
        i += 1
    }
    return -1
}
