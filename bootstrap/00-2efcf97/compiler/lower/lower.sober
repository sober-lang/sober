package lower

// 入口と関数の本体・文（src/lower.zig の program / funcBody / stmts / bind / assign / while / ret / defer の写し）。
// 値 = (型, IR の値) の対（スカラーは値、アグリゲートはアドレス）。到達しないのは型 never。多値の結果の列 = [n, (型, 値)…]（never は -1）

import "desugar"
import "ast"
import "lexer"
import "loader"

// FnInfo（下ろす関数 1 つ）
const FI_FN = 0       // 関数表の添字
const FI_PKG = 1
const FI_IR = 2       // IR の関数の記録
const FI_PARAMS = 3   // 型の列
const FI_RESULTS = 4
const FI_NEXT = 5     // 作業列の鎖
const FI_DECL = 6     // 関数宣言の節（持ち上げたラムダは合成の節）
const FI_ENV = 7      // 型環境（ジェネリックの単相コピー — 他は -1）
const FISZ = 8

// 名前の実体（スコープの鎖の項 [next, name, kind, 型, 値]）: 不変束縛は値、mut ローカルはスロット（値はそのアドレス）
const LVal = 0
const LCell = 1

// スコープ [prev, 名前の鎖, defer の鎖（新しい順）, 番号]・ループ [prev, head, exit, スコープ数]

// Ir は Program p の IR テキスト（Zig 版 `sober build --emit=ir` と同じバイト列）。拒否なら (空, 種類 k > 0, 位置 tok)
// （診断の文言は持たない — 差分オラクルは拒否の有無だけを比べる）
func Ir(p loader.Program) ([]int, int, int) {
    mut st := desugar.S{}
    k, tok := build(mut st, p)
    if k != 0 {
        return []int{}, k, tok
    }
    mut out := mut []int{}
    printModule(mut st, mut out)
    return freeze(out), 0, 0
}

// Ll は Program p の LLVM テキスト（Zig 版 `sober build --emit=ll` と同じバイト列 — rtlower → .ll の印字。IR パスは掛けない）
func Ll(p loader.Program) ([]int, int, int) {
    mut st := desugar.S{}
    k, tok := build(mut st, p)
    if k != 0 {
        return []int{}, k, tok
    }
    rtlower(mut st)
    llPrepare(mut st)
    mut out := mut []int{}
    llModule(mut st, mut out)
    return freeze(out), 0, 0
}

// build は Program p を IR のモジュールへ下ろす（st はモジュールを持ったまま返る）。拒否なら (種類, 位置)
func build(st mut desugar.S, p loader.Program) (int, int) {
    desugar.Init(mut st, p)
    b := recN(mut st, LSIZE)
    st.h[0] = b
    gs(mut st, L_NSTR, 0)
    gs(mut st, L_NINTERP, 0)
    gs(mut st, L_ERRS, -1)
    gs(mut st, L_ERRSTRUCT, -1)
    gs(mut st, L_NLAMBDA, 0)
    gs(mut st, L_TENV, -1)
    gs(mut st, L_INSTS, -1)
    gs(mut st, L_IN_DICT, 0)
    gs(mut st, L_DLIFTS, -1)
    gs(mut st, L_NSCOPE, 0)
    gs(mut st, L_NLOOP, 0)
    hv1 := rec4(mut st, TNone, 0, 0, 0)
    gs(mut st, L_T_NONE, hv1)
    hv2 := rec4(mut st, TInt, 0, 0, 0)
    gs(mut st, L_T_INT, hv2)
    hv3 := rec4(mut st, TBool, 0, 0, 0)
    gs(mut st, L_T_BOOL, hv3)
    hv4 := rec4(mut st, TNever, 0, 0, 0)
    gs(mut st, L_T_NEVER, hv4)
    hv5 := rec4(mut st, TNil, 0, 0, 0)
    gs(mut st, L_T_NIL, hv5)
    fis := recN(mut st, nfn(mut st) + 1)
    st.h[fis] = nfn(mut st)
    gs(mut st, L_FNINFO, fis)
    installRt(mut st)
    err := program(mut st)
    if err != nil {
        mut fk := KUnsupported
        mut ft := 0
        switch err {
        case LowerFail{k, tok}:
            fk = k
            ft = tok
        default:
            fk = KUnsupported
        }
        return fk, ft
    }
    return 0, 0
}

func program(st mut desugar.S) error? {
    registerTypes(mut st)
    m := strLit(mut st, "main")
    mi := findFnIn(mut st, st.h[desugar.G_MAIN_PKG], m, 0, 4)
    if mi < 0 {
        return LowerFail{k: KMissing, tok: 0}
    }
    main_fn := funcByKey(mut st, mi)?
    // `func main()` か `func main() int`（戻り値 = 終了コード — R31 の裁定）
    rs := st.h[main_fn + FI_RESULTS]
    main_int := llen(mut st, rs) == 1 && isTag(mut st, lat(mut st, rs, 0), TInt)
    if llen(mut st, st.h[main_fn + FI_PARAMS]) != 0 || (llen(mut st, rs) != 0 && !main_int) {
        return LowerFail{k: KUnsupported, tok: tokOf(mut st, fnNode(mut st, mi))}
    }
    buildEntry(mut st, st.h[main_fn + FI_IR], main_int)
    while gv(mut st, L_WORK) >= 0 {
        fi := gv(mut st, L_WORK)
        gs(mut st, L_WORK, st.h[fi + FI_NEXT])
        funcBody(mut st, fi)?
    }
    return nil
}

// ── 関数表 ──

// funcByKey は関数表の i 番の FnInfo（初出なら署名を作って本体を作業列に積む）。展開される関数・ジェネリック関数は呼び手が別経路へ回す
func funcByKey(st mut desugar.S, i int) (int, error?) {
    fis := gv(mut st, L_FNINFO)
    x := st.h[fis + 1 + i]
    if x >= 0 {
        return x, nil
    }
    if fnBodiless(mut st, i) {
        return 0, LowerFail{k: KUnsupported, tok: tokOf(mut st, fnNode(mut st, i))}
    }
    return newFunc(mut st, i)
}

// isMutParam は関数宣言の節 decl の j 番の仮引数が mut か（decl = -1 は関数値の呼び出し — mut 仮引数を持たない）
func isMutParam(st mut desugar.S, decl int, j int) bool {
    if decl < 0 {
        return false
    }
    ps := st.h[decl + NC]
    return j < llen(mut st, ps) && st.h[lat(mut st, ps, j) + NC] != 0
}

// sigOf は関数宣言 decl の署名を package pk の文脈で読む（(引数の型の列, 結果の型の列) — 関数型の引数は TFunc）
func sigOf(st mut desugar.S, decl int, pk int) (int, int, error?) {
    tok := tokOf(mut st, decl)
    ps := st.h[decl + NC]
    np := llen(mut st, ps)
    params := listN(mut st, np)
    mut j := 0
    while j < np {
        t := resolveType(mut st, pk, st.h[lat(mut st, ps, j) + NB], false)?
        st.h[params + 1 + j] = t
        j += 1
    }
    rs := st.h[decl + ND]
    nr := llen(mut st, rs)
    results := listN(mut st, nr)
    j = 0
    while j < nr {
        t := resolveType(mut st, pk, lat(mut st, rs, j), false)?
        if isTag(mut st, t, TFunc) {
            return 0, 0, LowerFail{k: KUnsupported, tok: tok}
        }
        st.h[results + 1 + j] = t
        j += 1
    }
    return params, results, nil
}

func newFunc(st mut desugar.S, i int) (int, error?) {
    pk := fnPkg(mut st, i)
    decl := fnNode(mut st, i)
    params, results := sigOf(mut st, decl, pk)?
    fi := newFuncSig(mut st, strDot(mut st, pkgPath(mut st, pk), fnName(mut st, i)), decl, pk, params, results)
    st.h[fi + FI_FN] = i
    st.h[gv(mut st, L_FNINFO) + 1 + i] = fi
    return fi, nil
}

// newFuncSig は名前 name・宣言 decl・署名の関数を足し、本体を作業列に積む
func newFuncSig(st mut desugar.S, name int, decl int, pk int, params int, results int) int {
    np := llen(mut st, params)
    nr := llen(mut st, results)
    sret := sretOf(mut st, results)
    // 引数は語に展開する（アグリゲートは語数ぶんの i64）。mut 仮引数は呼び手のセルのアドレス 1 語
    mut total := if sret { 1 } else { 0 }
    mut j := 0
    while j < np {
        total += if isMutParam(mut st, decl, j) { 1 } else { tWords(mut st, lat(mut st, params, j)) }
        j += 1
    }
    ptys := listN(mut st, total)
    mut k := 0
    if sret {
        st.h[ptys + 1] = TyPtr
        k = 1
    }
    j = 0
    while j < np {
        if isMutParam(mut st, decl, j) {
            st.h[ptys + 1 + k] = TyPtr
            k += 1
        } else {
            mut w := 0
            while w < tWords(mut st, lat(mut st, params, j)) {
                st.h[ptys + 1 + k] = TyI64
                k += 1
                w += 1
            }
        }
        j += 1
    }
    irf := addFunc(mut st, name, ptys, if sret || nr == 0 { -1 } else { TyI64 })
    fi := recN(mut st, FISZ)
    st.h[fi + FI_FN] = -1
    st.h[fi + FI_DECL] = decl
    st.h[fi + FI_ENV] = gv(mut st, L_TENV)
    st.h[fi + FI_PKG] = pk
    st.h[fi + FI_IR] = irf
    st.h[fi + FI_PARAMS] = params
    st.h[fi + FI_RESULTS] = results
    st.h[fi + FI_NEXT] = gv(mut st, L_WORK)
    gs(mut st, L_WORK, fi)
    return fi
}

func infoSret(st mut desugar.S) bool {
    return sretOf(mut st, st.h[gv(mut st, L_INFO) + FI_RESULTS])
}

// ── 値の置き場 ──

func newAgg(st mut desugar.S, t int) int {
    w := tWords(mut st, t)
    return slotaddr(mut st, newSlot(mut st, if w > 1 { w } else { 1 }))
}

// fieldPtr は p + off 語
func fieldPtr(st mut desugar.S, p int, off int) int {
    if off == 0 {
        return p
    }
    return gepWord(mut st, p, iconst(mut st, off))
}

// loadVal は p + off 語にある型 t の値（アグリゲートはアドレスのまま — コピーしない）
func loadVal(st mut desugar.S, p int, off int, t int) int {
    if isScalar(mut st, t) {
        return load(mut st, p, off)
    }
    return fieldPtr(mut st, p, off)
}

// storeVal は型 t の値 v を p + off 語へ書く（アグリゲートは語ごとにコピー）
func storeVal(st mut desugar.S, p int, off int, t int, v int) {
    if isScalar(mut st, t) {
        store(mut st, p, off, v)
        return
    }
    mut w := 0
    while w < tWords(mut st, t) {
        store(mut st, p, off + w, load(mut st, v, w))
        w += 1
    }
}

// copyVal はアグリゲートを新しいスロットへ写す（スカラーはそのまま）
func copyVal(st mut desugar.S, t int, v int) int {
    if !isAggregate(mut st, t) {
        return v
    }
    p := newAgg(mut st, t)
    storeVal(mut st, p, 0, t, v)
    return p
}

// ── スコープ ──

func pushScope(st mut desugar.S) {
    n := gv(mut st, L_NSCOPE)
    s := rec4(mut st, gv(mut st, L_SCOPE), -1, -1, n)
    gs(mut st, L_SCOPE, s)
    gs(mut st, L_NSCOPE, n + 1)
}

func popScope(st mut desugar.S) {
    s := gv(mut st, L_SCOPE)
    gs(mut st, L_SCOPE, st.h[s])
    gs(mut st, L_NSCOPE, gv(mut st, L_NSCOPE) - 1)
}

func declare(st mut desugar.S, name int, kind int, t int, v int) {
    if strIs(mut st, name, "_") {
        return
    }
    s := gv(mut st, L_SCOPE)
    en := recN(mut st, 5)
    st.h[en] = st.h[s + 1]
    st.h[en + 1] = name
    st.h[en + 2] = kind
    st.h[en + 3] = t
    st.h[en + 4] = v
    st.h[s + 1] = en
}

// declareNew は利用者の書いた束縛: 見えている名前の再束縛は拒否
func declareNew(st mut desugar.S, name int, kind int, t int, v int, tok int) error? {
    if strIs(mut st, name, "_") {
        return nil
    }
    if lookup(mut st, name) >= 0 {
        return LowerFail{k: KUnsupported, tok: tok}
    }
    declare(mut st, name, kind, t, v)
    return nil
}

// lookup は名前の項（無ければ -1）— 可視範囲の鎖を後ろから、各区間の中は内側のスコープから
func lookup(st mut desugar.S, name int) int {
    ch := gv(mut st, L_CHAIN)
    ns := gv(mut st, L_NSCOPE)
    mut v := st.h[ch] / 2
    while v > 0 {
        v -= 1
        lo := st.h[ch + 1 + v * 2]
        hi0 := st.h[ch + 2 + v * 2]
        hi := if hi0 < ns { hi0 } else { ns }
        mut s := gv(mut st, L_SCOPE)
        while s >= 0 {
            idx := st.h[s + 3]
            if idx >= lo && idx < hi {
                mut en := st.h[s + 1]
                while en >= 0 {
                    if strEq(mut st, st.h[en + 1], name) {
                        return en
                    }
                    en = st.h[en]
                }
            }
            s = st.h[s]
        }
    }
    return -1
}

// bindName は束縛 1 つ: スカラーの不変束縛は値そのもの、それ以外はスロットを取って書く（アグリゲートは束縛でコピー）
func bindName(st mut desugar.S, name int, t int, v int, mutable bool, tok int) error? {
    if isTag(mut st, t, TNone) || isTag(mut st, t, TNever) || isTag(mut st, t, TNil) {
        return LowerFail{k: KMismatch, tok: tok}
    }
    if strIs(mut st, name, "_") {
        return nil
    }
    if isAggregate(mut st, t) {
        c := copyVal(mut st, t, v)
        return declareNew(mut st, name, if mutable { LCell } else { LVal }, t, c, tok)
    }
    if !mutable {
        return declareNew(mut st, name, LVal, t, v, tok)
    }
    p := slotaddr(mut st, newSlot(mut st, 1))
    store(mut st, p, 0, v)
    return declareNew(mut st, name, LCell, t, p, tok)
}

// runDefers はスコープ番号 from 以上に積まれた defer を内側から逆順に展開する（各 defer は自分の新スコープで評価し、結果は捨てる）
func runDefers(st mut desugar.S, from int) error? {
    mut s := gv(mut st, L_SCOPE)
    while s >= 0 && st.h[s + 3] >= from {
        mut d := st.h[s + 2]
        while d >= 0 {
            pushScope(mut st)
            evalMulti(mut st, st.h[d + 1])?
            popScope(mut st)
            if cur(mut st) < 0 {
                return nil
            }
            d = st.h[d]
        }
        s = st.h[s]
    }
    return nil
}

// ── 本体 ──

func funcBody(st mut desugar.S, fi int) error? {
    gs(mut st, L_INFO, fi)
    pk := st.h[fi + FI_PKG]
    gs(mut st, L_CUR_PKG, pk)
    gs(mut st, L_SCOPE, -1)
    gs(mut st, L_NSCOPE, 0)
    gs(mut st, L_LOOP, -1)
    gs(mut st, L_NLOOP, 0)
    hv0 := list2(mut st, 0, VOPEN)
    gs(mut st, L_CHAIN, hv0)
    gs(mut st, L_RETS, rec4(mut st, -1, -1, 0, 0))
    gs(mut st, L_FLOORS, rec4(mut st, -1, 0, 0, 0))
    gs(mut st, L_INLINING, list0(mut st))
    decl := st.h[fi + FI_DECL]
    gs(mut st, L_TENV, st.h[fi + FI_ENV])
    irf := st.h[fi + FI_IR]
    begin(mut st, irf)
    pushScope(mut st)
    mut idx := 0
    if infoSret(mut st) {
        gs(mut st, L_SRET, 0)
        idx = 1
    }
    ps := st.h[decl + NC]
    params := st.h[fi + FI_PARAMS]
    mut j := 0
    while j < llen(mut st, ps) {
        prm := lat(mut st, ps, j)
        t := lat(mut st, params, j)
        if st.h[prm + NC] != 0 {
            // mut 仮引数は呼び手のセルそのもの（アドレス越しに読み書きする — R2）
            declare(mut st, st.h[prm + NA], LCell, t, idx)
            idx += 1
        } else {
            if isScalar(mut st, t) {
                declare(mut st, st.h[prm + NA], LVal, t, idx)
            } else {
                // 語で受けた引数を自分のスロットへ写す
                slot := newAgg(mut st, t)
                mut w := 0
                while w < tWords(mut st, t) {
                    store(mut st, slot, w, idx + w)
                    w += 1
                }
                declare(mut st, st.h[prm + NA], LVal, t, slot)
            }
            idx += tWords(mut st, t)
        }
        j += 1
    }
    // 関数本体は自分の region を開く（入口の深度を退避し、出口が復元する）
    hv1 := regionDepth(mut st)
    gs(mut st, L_ENTRY_DEPTH, hv1)
    regionEnter(mut st)
    stmts(mut st, st.h[st.h[decl + NE] + NA])?
    if cur(mut st) >= 0 {
        if llen(mut st, st.h[fi + FI_RESULTS]) != 0 {
            return LowerFail{k: KMissing, tok: tokOf(mut st, decl)}
        }
        runDefers(mut st, 0)?
        if cur(mut st) >= 0 {
            regionSetDepth(mut st, gv(mut st, L_ENTRY_DEPTH))
            ret(mut st, -1)
        }
    }
    popScope(mut st)
    // 到達しない位置で作って前任を持たないまま残ったブロックを閉じる（到達したら panic — 中身は死んでいる）
    mut b := st.h[irf + F_BHEAD]
    while b >= 0 {
        if st.h[b + B_TERM] == TmNone && st.h[b + B_PREDS] == 0 {
            st.h[b + B_TERM] = TmExit
            st.h[b + B_X1] = PANIC
        }
        b = st.h[b + B_NEXT]
    }
    return nil
}

// stmts は文の列。脱出の後の文は到達しないので下ろさない
func stmts(st mut desugar.S, l int) error? {
    mut i := 0
    while i < llen(mut st, l) {
        if cur(mut st) < 0 {
            return nil
        }
        stmt(mut st, lat(mut st, l, i))?
        i += 1
    }
    return nil
}

func stmt(st mut desugar.S, s int) error? {
    k := kindOf(mut st, s)
    tok := tokOf(mut st, s)
    if k == ast.SExpr {
        // 文位置は結果の個数を問わない（多値の呼び出しは捨てる）。文形の for は生成元の呼び出しに書き換えて下ろす
        e := st.h[s + NA]
        if isForStmt(mut st, e) {
            return forStmt(mut st, e)
        }
        evalMulti(mut st, e)?
        return nil
    }
    if k == ast.SRet {
        return retStmt(mut st, s)
    }
    if k == ast.SBind {
        return bindStmt(mut st, s)
    }
    if k == ast.SAssign {
        return assignStmt(mut st, s)
    }
    if k == ast.SWhile {
        return whileStmt(mut st, s)
    }
    if k == ast.SBreak || k == ast.SContinue {
        lp := gv(mut st, L_LOOP)
        if gv(mut st, L_NLOOP) <= st.h[gv(mut st, L_FLOORS) + 1] {
            return LowerFail{k: KUnsupported, tok: tok}
        }
        runDefers(mut st, if k == ast.SBreak { st.h[lp + 4] } else { st.h[lp + 3] })?
        if cur(mut st) < 0 {
            return nil
        }
        br(mut st, if k == ast.SBreak { st.h[lp + 2] } else { st.h[lp + 1] }, -1)
        return nil
    }
    if k == ast.SYield {
        // yield 文は束縛 `yield`（for 式を書き換えたラムダの引数）の呼び出し
        evalMulti(mut st, yieldCall(mut st, st.h[s + NA], tok))?
        return nil
    }
    if k == ast.SDefer {
        sc := gv(mut st, L_SCOPE)
        d := rec4(mut st, st.h[sc + 2], st.h[s + NA], 0, 0)
        st.h[sc + 2] = d
        return nil
    }
    return LowerFail{k: KUnsupported, tok: tok}
}

// bindStmt は `a := e` / `a, b := e1, e2` / `q, r := f()`
func bindStmt(st mut desugar.S, s int) error? {
    names := st.h[s + NA]
    mutable := st.h[s + NB] != 0
    values := st.h[s + NC]
    tok := tokOf(mut st, s)
    nn := llen(mut st, names)
    nv := llen(mut st, values)
    if nn != nv {
        r := multiValue(mut st, values, nn, tok)?
        if r < 0 {
            return nil
        }
        mut i := 0
        while i < nn {
            bindName(mut st, lat(mut st, names, i), st.h[r + 1 + i * 2], st.h[r + 2 + i * 2], mutable, tok)?
            i += 1
        }
        return nil
    }
    // 同数の式は右辺を全部評価してから束縛する（束縛がコピーするので右辺の一時は写さなくてよい）
    vs := listN(mut st, nv * 2)
    mut i := 0
    while i < nv {
        t, v0 := expr(mut st, lat(mut st, values, i))?
        if isTag(mut st, t, TNever) {
            return nil
        }
        v := if nv > 1 { copyVal(mut st, t, v0) } else { v0 }
        st.h[vs + 1 + i * 2] = t
        st.h[vs + 2 + i * 2] = v
        i += 1
    }
    i = 0
    while i < nn {
        bindName(mut st, lat(mut st, names, i), st.h[vs + 1 + i * 2], st.h[vs + 2 + i * 2], mutable, tok)?
        i += 1
    }
    return nil
}

// compoundOp は複合代入の演算子 → 二項演算子（無ければ -1）
func compoundOp(op int) int {
    if op == lexer.PlusEqual {
        return lexer.Plus
    }
    if op == lexer.MinusEqual {
        return lexer.Minus
    }
    if op == lexer.StarEqual {
        return lexer.Star
    }
    if op == lexer.SlashEqual {
        return lexer.Slash
    }
    if op == lexer.PercentEqual {
        return lexer.Percent
    }
    if op == lexer.AmpersandEqual {
        return lexer.Ampersand
    }
    if op == lexer.PipeEqual {
        return lexer.Pipe
    }
    if op == lexer.CaretEqual {
        return lexer.Caret
    }
    if op == lexer.ShlEqual {
        return lexer.Shl
    }
    if op == lexer.ShrEqual {
        return lexer.Shr
    }
    return -1
}

// assignStmt は `x = e` / `x, y = e1, e2`（並行）/ `a, b = f()` / `x op= e`。代入先は名前とフィールド
func assignStmt(st mut desugar.S, s int) error? {
    targets := st.h[s + NA]
    op := st.h[s + NB]
    values := st.h[s + NC]
    tok := tokOf(mut st, s)
    nt := llen(mut st, targets)
    nv := llen(mut st, values)
    if nt == 1 && kindOf(mut st, lat(mut st, targets, 0)) == ast.EIndex {
        if op != lexer.Equal || nv != 1 {
            return LowerFail{k: KUnsupported, tok: tok}
        }
        return setIndex(mut st, lat(mut st, targets, 0), lat(mut st, values, 0))
    }
    if op != lexer.Equal {
        if nt != 1 || nv != 1 {
            return LowerFail{k: KUnsupported, tok: tok}
        }
        // 右辺 → 対象の現在値 → 演算 → 書き戻し
        rt, rv := expr(mut st, lat(mut st, values, 0))?
        if isTag(mut st, rt, TNever) {
            return nil
        }
        want(mut st, rt, tInt(mut st), tok)?
        pt, pp := target(mut st, lat(mut st, targets, 0), tok)?
        if pt < 0 {
            return LowerFail{k: KUnsupported, tok: tok}
        }
        if !isTag(mut st, pt, TInt) {
            return LowerFail{k: KMismatch, tok: tok}
        }
        bop := compoundOp(op)
        if bop < 0 {
            return LowerFail{k: KUnsupported, tok: tok}
        }
        c := load(mut st, pp, 0)
        v := arith(mut st, bop, c, rv, tok)?
        store(mut st, pp, 0, v)
        return nil
    }
    mut vs := 0
    if nt != nv {
        vs = multiValue(mut st, values, nt, tok)?
        if vs < 0 {
            return nil
        }
    } else {
        // 右辺を全部評価してから左辺に書く（`x, y = y, x` の並行代入 — アグリゲートは一時へ写す）
        vs = listN(mut st, nv * 2)
        mut i := 0
        while i < nv {
            t, v0 := expr(mut st, lat(mut st, values, i))?
            if isTag(mut st, t, TNever) {
                return nil
            }
            v := if nv > 1 { copyVal(mut st, t, v0) } else { v0 }
            st.h[vs + 1 + i * 2] = t
            st.h[vs + 2 + i * 2] = v
            i += 1
        }
    }
    // 書く順は後ろから（同じ名前が 2 度出たら先頭が勝つ）
    mut i := nt
    while i > 0 {
        i -= 1
        pt, pp := target(mut st, lat(mut st, targets, i), tok)?
        if pt >= 0 {
            t, v := coerce(mut st, st.h[vs + 1 + i * 2], st.h[vs + 2 + i * 2], pt, tok)?
            storeVal(mut st, pp, 0, t, v)
        }
    }
    return nil
}

// target は代入先の場所 (型, アドレス)。`_` なら型 -1。フィールドは基底の場所から辿る（基底は mut ローカル）
func target(st mut desugar.S, t int, tok int) (int, int, error?) {
    k := kindOf(mut st, t)
    if k == ast.EIdent {
        name := st.h[t + NA]
        if strIs(mut st, name, "_") {
            return -1, 0, nil
        }
        l := lookup(mut st, name)
        if l < 0 {
            return 0, 0, LowerFail{k: KUndefined, tok: tokOf(mut st, t)}
        }
        if st.h[l + 2] != LCell {
            return 0, 0, LowerFail{k: KMismatch, tok: tokOf(mut st, t)}
        }
        return st.h[l + 3], st.h[l + 4], nil
    }
    if k == ast.ESelector {
        bt, bp := target(mut st, st.h[t + NA], tok)?
        if bt < 0 {
            return 0, 0, LowerFail{k: KMismatch, tok: tokOf(mut st, t)}
        }
        f := fieldOf(mut st, bt, st.h[t + NB], tokOf(mut st, t))?
        return st.h[f + 1], fieldPtr(mut st, bp, st.h[f + 2]), nil
    }
    return 0, 0, LowerFail{k: KMismatch, tok: tok}
}

// fieldOf は struct 型 t のフィールド name の記録
func fieldOf(st mut desugar.S, t int, name int, tok int) (int, error?) {
    if !isTag(mut st, t, TStruct) {
        return 0, LowerFail{k: KMismatch, tok: tok}
    }
    f := findField(mut st, st.h[st.h[t + 1] + SI_FIELDS], name)
    if f < 0 {
        return 0, LowerFail{k: KUndefined, tok: tok}
    }
    return f, nil
}

// whileStmt: 入口の深度を退避し、周回の頭と出口で復元する（break / continue が式ブロックの region を飛び越えるため）。本体は region を開かない
func whileStmt(st mut desugar.S, s int) error? {
    tok := tokOf(mut st, s)
    saved := regionDepth(mut st)
    head := newBlock(mut st)
    body := newBlock(mut st)
    ex := newBlock(mut st)
    br(mut st, head, -1)
    setCur(mut st, head)
    regionSetDepth(mut st, saved)
    ct, cv := expr(mut st, st.h[s + NA])?
    if isTag(mut st, ct, TNever) {
        return nil
    }
    want(mut st, ct, tBool(mut st), tok)?
    condbr(mut st, cv, body, -1, ex, -1)
    setCur(mut st, body)
    lp := loopRec(mut st, head, ex, gv(mut st, L_NSCOPE), gv(mut st, L_NSCOPE))
    gs(mut st, L_LOOP, lp)
    gs(mut st, L_NLOOP, gv(mut st, L_NLOOP) + 1)
    armValue(mut st, st.h[st.h[s + NB] + NA])?
    gs(mut st, L_NLOOP, gv(mut st, L_NLOOP) - 1)
    gs(mut st, L_LOOP, st.h[lp])
    if cur(mut st) >= 0 {
        br(mut st, head, -1)
    }
    setCur(mut st, ex)
    regionSetDepth(mut st, saved)
    return nil
}

// loopRec はループの記録 [prev, continue の行き先, break の行き先, continue の defer の床, break の defer の床]
// （while は両方の床が同じ。文形 for は break が生成元の展開ごと抜けるので床が浅い）
func loopRec(st mut desugar.S, head int, ex int, ncont int, nbrk int) int {
    lp := recN(mut st, 5)
    st.h[lp] = gv(mut st, L_LOOP)
    st.h[lp + 1] = head
    st.h[lp + 2] = ex
    st.h[lp + 3] = ncont
    st.h[lp + 4] = nbrk
    return lp
}

// forStmt は文形 for: 生成元の呼び出し `GEN(src, k)` を下ろし、その後ろに break の行き先を置く。k の節の c に
// [break の行き先, 入口の region 深度, 入口のスコープ数] の記録 + 1 を書いておき、lambdaCall が本体の周りにループを開く
func forStmt(st mut desugar.S, e int) error? {
    gen := forGen(mut st, e)?
    saved := regionDepth(mut st)
    ex := newBlock(mut st)
    ga := st.h[gen + NB]
    st.h[lat(mut st, ga, llen(mut st, ga) - 1) + NC] = rec4(mut st, ex, saved, gv(mut st, L_NSCOPE), 0) + 1
    evalMulti(mut st, gen)?
    if cur(mut st) >= 0 {
        br(mut st, ex, -1)
    }
    if st.h[ex + B_PREDS] == 0 {
        setCur(mut st, -1)
        return nil
    }
    setCur(mut st, ex)
    regionSetDepth(mut st, saved)
    return nil
}

func retStmt(st mut desugar.S, s int) error? {
    tok := tokOf(mut st, s)
    values := st.h[s + NA]
    ctx := st.h[gv(mut st, L_RETS) + 1]
    want_ts := if ctx >= 0 { st.h[ctx + IC_RESULTS] } else { st.h[gv(mut st, L_INFO) + FI_RESULTS] }
    nw := llen(mut st, want_ts)
    nv := llen(mut st, values)
    mut vs := 0
    if nw > 1 && nv == 1 {
        // `return g()` の転送: g の結果をそのまま自分の結果へ
        vs = multiValue(mut st, values, nw, tok)?
    } else {
        if nv != nw {
            return LowerFail{k: KMismatch, tok: tok}
        }
        vs = listN(mut st, nv * 2)
        st.h[vs] = nv
        mut i := 0
        while i < nv {
            t, v := exprExpecting(mut st, lat(mut st, values, i), lat(mut st, want_ts, i), tok)?
            if isTag(mut st, t, TNever) {
                return nil
            }
            st.h[vs + 1 + i * 2] = t
            st.h[vs + 2 + i * 2] = v
            i += 1
        }
    }
    if vs < 0 {
        return nil
    }
    mut i := 0
    while i < nw {
        if !tEql(mut st, st.h[vs + 1 + i * 2], lat(mut st, want_ts, i)) {
            return LowerFail{k: KMismatch, tok: tok}
        }
        i += 1
    }
    if ctx >= 0 {
        mut ioff := 0
        i = 0
        while i < nw {
            t := st.h[vs + 1 + i * 2]
            storeVal(mut st, st.h[ctx + IC_SLOT], ioff, t, st.h[vs + 2 + i * 2])
            ioff += tWords(mut st, t)
            i += 1
        }
        return inlineExit(mut st, ctx, tok)
    }
    // 結果スロットへ書いてから defer（値は defer より先に確定する）
    if infoSret(mut st) {
        mut off := 0
        i = 0
        while i < nw {
            t := st.h[vs + 1 + i * 2]
            storeVal(mut st, gv(mut st, L_SRET), off, t, st.h[vs + 2 + i * 2])
            off += tWords(mut st, t)
            i += 1
        }
    }
    return funcExit(mut st, if !infoSret(mut st) && nw == 1 { st.h[vs + 2] } else { -1 }, tok)
}

// funcExit は関数の出口の後半（結果は書き済み — sret でなければ v）: defer → 結果の relocate → 深度復元 → ret
func funcExit(st mut desugar.S, v int, tok int) error? {
    runDefers(mut st, 0)?
    if cur(mut st) < 0 {
        return nil
    }
    if infoSret(mut st) {
        // 結果の slice / map を呼び手の region へ写す（defer の後・深度復元の前）
        rs := st.h[gv(mut st, L_INFO) + FI_RESULTS]
        mut off := 0
        mut i := 0
        while i < llen(mut st, rs) {
            t := lat(mut st, rs, i)
            relocateTo(mut st, gv(mut st, L_SRET), off, t, gv(mut st, L_ENTRY_DEPTH))
            off += tWords(mut st, t)
            i += 1
        }
    }
    regionSetDepth(mut st, gv(mut st, L_ENTRY_DEPTH))
    ret(mut st, v)
    return nil
}

// containsSlice は slice / map を（入れ子含め）どこかに含むか
func containsSlice(st mut desugar.S, t int) bool {
    k := st.h[t]
    if k == TSlice || k == TMap {
        return true
    }
    if k == TOpt {
        return containsSlice(mut st, st.h[t + 1])
    }
    if k == TStruct {
        fs := st.h[st.h[t + 1] + SI_FIELDS]
        mut i := 0
        while i < llen(mut st, fs) {
            if containsSlice(mut st, st.h[lat(mut st, fs, i) + 1]) {
                return true
            }
            i += 1
        }
        return false
    }
    if k == TUnion {
        vs := st.h[st.h[t + 1] + SI_FIELDS]
        mut i := 0
        while i < llen(mut st, vs) {
            fs := st.h[lat(mut st, vs, i) + 2]
            mut j := 0
            while j < llen(mut st, fs) {
                if containsSlice(mut st, st.h[lat(mut st, fs, j) + 1]) {
                    return true
                }
                j += 1
            }
            i += 1
        }
    }
    return false
}

// blockTail は文の並びの値（末尾の式文）。スコープは呼び手が切る
func blockTail(st mut desugar.S, l int) (int, int, error?) {
    n := llen(mut st, l)
    mut tail := -1
    if n > 0 && kindOf(mut st, lat(mut st, l, n - 1)) == ast.SExpr {
        tail = st.h[lat(mut st, l, n - 1) + NA]
        if isForStmt(mut st, tail) {
            tail = -1
        }
    }
    m := if tail >= 0 { n - 1 } else { n }
    mut i := 0
    while i < m {
        if cur(mut st) < 0 {
            return tNever(mut st), 0, nil
        }
        stmt(mut st, lat(mut st, l, i))?
        i += 1
    }
    if cur(mut st) < 0 {
        return tNever(mut st), 0, nil
    }
    if tail >= 0 {
        r := evalMulti(mut st, tail)?
        if cur(mut st) < 0 || r < 0 {
            return tNever(mut st), 0, nil
        }
        if st.h[r] == 1 {
            return st.h[r + 1], st.h[r + 2], nil
        }
    }
    return tNone(mut st), 0, nil
}

// armValue は if / switch の腕・while 本体: 新スコープだけ開き、region は開かない。出口で defer を展開
func armValue(st mut desugar.S, l int) (int, int, error?) {
    pushScope(mut st)
    t, v := armTail(mut st, l)?
    popScope(mut st)
    return t, v, nil
}

func armTail(st mut desugar.S, l int) (int, int, error?) {
    t, v := blockTail(mut st, l)?
    if isTag(mut st, t, TNever) {
        return t, v, nil
    }
    runDefers(mut st, gv(mut st, L_NSCOPE) - 1)?
    if cur(mut st) < 0 {
        return tNever(mut st), 0, nil
    }
    return t, v, nil
}

// blockValue は式位置の `{ }`: 新スコープ + 新 region。出口で defer を展開してから region を閉じる（入口の深度へ戻す）
func blockValue(st mut desugar.S, l int, tok int) (int, int, error?) {
    pushScope(mut st)
    saved := regionDepth(mut st)
    regionEnter(mut st)
    t, v := blockTail(mut st, l)?
    if isTag(mut st, t, TNever) {
        popScope(mut st)
        return t, v, nil
    }
    runDefers(mut st, gv(mut st, L_NSCOPE) - 1)?
    if cur(mut st) < 0 {
        popScope(mut st)
        return tNever(mut st), 0, nil
    }
    // 普通の出口の境界コピー（R5 — Lean の regionKR）: 末尾値がコンテナを含むなら、ブロックの region にあるヘッダを親の最内 region へ中身ごと写す
    if containsSlice(mut st, t) {
        c := copyVal(mut st, t, v)
        relocateTo(mut st, c, 0, t, saved)
        regionSetDepth(mut st, saved)
        popScope(mut st)
        return t, c, nil
    }
    regionSetDepth(mut st, saved)
    popScope(mut st)
    return t, v, nil
}
