package lower

// 呼び出しの生成方式（src/lower_inline.zig の写し）: inline 展開（関数型か mut の仮引数を持つ関数 — 呼び出し点に本体を展開する。region は開かない）・
// 閉包（ラムダ — 定義時の可視範囲と return の行き先を閉じ込める）・関数値（funcaddr / call.indirect・持ち上げたラムダ）。
// 名前の可視範囲は鎖 L_CHAIN（スコープ番号の区間の列）。inline 展開は空の鎖 + 自分の区間で開き、ラムダは定義時の鎖（凍結）+ 自分の区間で開く。
// return の行き先は L_RETS の先頭（-1 = 実体の関数、他は InlineCtx）

import "desugar"
import "ast"

// InlineCtx（展開中の inline 関数）
const IC_RESULTS = 0  // 結果の型の列
const IC_SLOT = 1     // 全結果の語を並べたスロット（呼び手はここから読む）
const IC_BASE = 2     // 展開範囲の最外スコープの番号（return はここから内側の defer を展開する）
const IC_DEPTH = 3    // 展開入口の深度（return が戻す）
const IC_END = 4      // 末尾のブロック
const ICSZ = 5

// Closure（ラムダ引数）
const CL_LAMBDA = 0
const CL_FT = 1       // FnType [params, results]
const CL_PKG = 2
const CL_CHAIN = 3    // 定義時の可視範囲（凍結 — 開いた上限を定義時のスコープ数で閉じる）
const CL_RET = 4      // 定義時の return の行き先
const CL_INL = 5      // 定義時に展開中だった inline 関数の名前の列
const CL_ENV = 6      // 定義時の型環境
const CL_PROBE = 7    // 型だけを取る試し生成の番兵（forIterType）: yield の値の型を記録する 1 語の置き場（-1 = 番兵でない）
const CLSZ = 8

const LClosure = 2

// freezeChain は今の鎖を、開いた上限を現在のスコープ数で閉じて複製する
func freezeChain(st mut desugar.S) int {
    ch := gv(mut st, L_CHAIN)
    ns := gv(mut st, L_NSCOPE)
    n := st.h[ch]
    out := listN(mut st, n)
    mut i := 0
    while i < n / 2 {
        st.h[out + 1 + i * 2] = st.h[ch + 1 + i * 2]
        hi := st.h[ch + 2 + i * 2]
        st.h[out + 2 + i * 2] = if hi < ns { hi } else { ns }
        i += 1
    }
    return out
}

// enter は展開の文脈（鎖 = views + 自分の区間・package・return の行き先・ループの床・inline 列（-1 は据え置き））に差し替え、戻し先を返す
func enter(st mut desugar.S, views int, pk int, env int, ctx int, inl int) int {
    saved := rec4(mut st, gv(mut st, L_CHAIN), gv(mut st, L_CUR_PKG), gv(mut st, L_INLINING), gv(mut st, L_TENV))
    gs(mut st, L_TENV, env)
    n := st.h[views]
    ch := listN(mut st, n + 2)
    mut i := 0
    while i < n {
        st.h[ch + 1 + i] = st.h[views + 1 + i]
        i += 1
    }
    st.h[ch + 1 + n] = gv(mut st, L_NSCOPE)
    st.h[ch + 2 + n] = VOPEN
    gs(mut st, L_CHAIN, ch)
    gs(mut st, L_CUR_PKG, pk)
    hv1 := rec4(mut st, gv(mut st, L_RETS), ctx, 0, 0)
    gs(mut st, L_RETS, hv1)
    hv2 := rec4(mut st, gv(mut st, L_FLOORS), gv(mut st, L_NLOOP), 0, 0)
    gs(mut st, L_FLOORS, hv2)
    if inl >= 0 {
        gs(mut st, L_INLINING, inl)
    }
    return saved
}

func leave(st mut desugar.S, saved int) {
    gs(mut st, L_CHAIN, st.h[saved])
    gs(mut st, L_CUR_PKG, st.h[saved + 1])
    gs(mut st, L_INLINING, st.h[saved + 2])
    gs(mut st, L_TENV, st.h[saved + 3])
    gs(mut st, L_RETS, st.h[gv(mut st, L_RETS)])
    gs(mut st, L_FLOORS, st.h[gv(mut st, L_FLOORS)])
}

// strListHas / strListAdd は名前の列（[n, 文字列…]）
func strListHas(st mut desugar.S, l int, name int) bool {
    mut i := 0
    while i < st.h[l] {
        if strEq(mut st, st.h[l + 1 + i], name) {
            return true
        }
        i += 1
    }
    return false
}

func strListAdd(st mut desugar.S, l int, name int) int {
    n := st.h[l]
    out := listN(mut st, n + 1)
    mut i := 0
    while i < n {
        st.h[out + 1 + i] = st.h[l + 1 + i]
        i += 1
    }
    st.h[out + 1 + n] = name
    return out
}

// mutArgCell は mut 引数の実引数: 呼び手の mut ローカル `mut x` のスロットそのもの（名前の項）。欄の経路 `mut x.f.g`（F-17 案 2α で解禁）は
// 欄のアドレスを持つ合成の項 [0, 0, LCell, 欄の型, 欄のアドレス]（代入の行き先と同じ target で取る）
func mutArgCell(st mut desugar.S, a int, tok int) (int, error?) {
    if kindOf(mut st, a) != ast.EMutArg {
        return 0, LowerFail{k: KMismatch, tok: tok}
    }
    parts := desugar.DotParts(mut st, st.h[a + NA])
    if llen(mut st, parts) > 1 {
        at := tokOf(mut st, a)
        mut e := node(mut st, ast.EIdent, at, lat(mut st, parts, 0), 0, 0, 0)
        mut i := 1
        while i < llen(mut st, parts) {
            e = node(mut st, ast.ESelector, at, e, lat(mut st, parts, i), 0, 0)
            i += 1
        }
        t, ptr := target(mut st, e, at)?
        if t < 0 {
            return 0, LowerFail{k: KMismatch, tok: at}
        }
        c := recN(mut st, 5)
        st.h[c + 2] = LCell
        st.h[c + 3] = t
        st.h[c + 4] = ptr
        return c, nil
    }
    l := lookup(mut st, st.h[a + NA])
    if l < 0 {
        return 0, LowerFail{k: KUndefined, tok: tokOf(mut st, a)}
    }
    if st.h[l + 2] != LCell {
        return 0, LowerFail{k: KMismatch, tok: tokOf(mut st, a)}
    }
    return l, nil
}

// closureArg は関数型の引数位置に書ける形: ラムダ（閉包にする）・閉包に束縛された名前（転送。型は一致が要る）。for 式は未対応
func closureArg(st mut desugar.S, a int, ft int, tok int) (int, error?) {
    k := kindOf(mut st, a)
    if k == ast.ELambda {
        return makeClosure(mut st, a, ft)
    }
    if k == ast.EFor {
        lowered := lowerFor(mut st, a)?
        return makeClosure(mut st, lowered, ft)
    }
    if k == ast.EIdent {
        l := lookup(mut st, st.h[a + NA])
        if l >= 0 && st.h[l + 2] == LClosure {
            if !fnTypeEql(mut st, st.h[st.h[l + 4] + CL_FT], ft) {
                return 0, LowerFail{k: KMismatch, tok: tok}
            }
            return st.h[l + 4], nil
        }
    }
    return 0, LowerFail{k: KMismatch, tok: tok}
}

func makeClosure(st mut desugar.S, lam int, ft int) (int, error?) {
    tok := tokOf(mut st, lam)
    ps := st.h[lam + NA]
    fps := st.h[ft]
    if llen(mut st, ps) != llen(mut st, fps) {
        return 0, LowerFail{k: KMismatch, tok: tok}
    }
    mut i := 0
    while i < llen(mut st, ps) {
        te := st.h[lat(mut st, ps, i) + NB]
        if te >= 0 {
            t := resolveType(mut st, gv(mut st, L_CUR_PKG), te, false)?
            if !tEql(mut st, t, lat(mut st, fps, i)) {
                return 0, LowerFail{k: KMismatch, tok: tok}
            }
        }
        i += 1
    }
    c := recN(mut st, CLSZ)
    st.h[c + CL_LAMBDA] = lam
    st.h[c + CL_FT] = ft
    st.h[c + CL_PKG] = gv(mut st, L_CUR_PKG)
    hv1 := freezeChain(mut st)
    st.h[c + CL_CHAIN] = hv1
    st.h[c + CL_RET] = st.h[gv(mut st, L_RETS) + 1]
    st.h[c + CL_INL] = gv(mut st, L_INLINING)
    st.h[c + CL_ENV] = gv(mut st, L_TENV)
    st.h[c + CL_PROBE] = -1
    return c, nil
}

// bindArg は展開の引数 1 つを束縛の (種類, 型, 値) にする（mut は呼び手のセルの別名、関数型は閉包、他は評価してコピー）。到達しなければ種類 -1
func bindArg(st mut desugar.S, a int, pw int, mutable bool, tok int) (int, int, int, error?) {
    if mutable {
        l := mutArgCell(mut st, a, tok)?
        if !tEql(mut st, st.h[l + 3], pw) {
            return 0, 0, 0, LowerFail{k: KMismatch, tok: tok}
        }
        return LCell, st.h[l + 3], st.h[l + 4], nil
    }
    if isTag(mut st, pw, TFunc) {
        c := closureArg(mut st, a, st.h[pw + 1], tok)?
        return LClosure, pw, c, nil
    }
    t, v := exprExpecting(mut st, a, pw, tok)?
    if isTag(mut st, t, TNever) {
        return -1, 0, 0, nil
    }
    return LVal, t, copyVal(mut st, t, v), nil
}

// inlineCall は関数型か mut の仮引数を持つ関数（宣言 decl・package pk・署名）の呼び出し: 引数を呼び手の文脈で束縛し、callee の本体を新しい可視範囲で展開する
// body_env: ジェネリック inline の型環境（-2 なら呼び手の型環境のまま）
func inlineCall(st mut desugar.S, decl int, pk int, params int, results int, args int, tok int, body_env int) (int, error?) {
    name := st.h[decl + NA]
    if strListHas(mut st, gv(mut st, L_INLINING), name) {
        return 0, LowerFail{k: KUnsupported, tok: tok}
    }
    np := llen(mut st, params)
    if llen(mut st, args) != np {
        return 0, LowerFail{k: KMismatch, tok: tok}
    }
    ps := st.h[decl + NC]
    bs := listN(mut st, np * 3)
    mut i := 0
    while i < np {
        k, t, v := bindArg(mut st, lat(mut st, args, i), lat(mut st, params, i), st.h[lat(mut st, ps, i) + NC] != 0, tok)?
        if k < 0 {
            return -1, nil
        }
        st.h[bs + 1 + i * 3] = k
        st.h[bs + 2 + i * 3] = t
        st.h[bs + 3 + i * 3] = v
        i += 1
    }
    mut total := 0
    i = 0
    while i < llen(mut st, results) {
        total += tWords(mut st, lat(mut st, results, i))
        i += 1
    }
    ctx := recN(mut st, ICSZ)
    st.h[ctx + IC_RESULTS] = results
    hv1 := slotaddr(mut st, newSlot(mut st, if total > 1 { total } else { 1 }))
    st.h[ctx + IC_SLOT] = hv1
    st.h[ctx + IC_BASE] = gv(mut st, L_NSCOPE)
    hv2 := regionDepth(mut st)
    st.h[ctx + IC_DEPTH] = hv2
    hv3 := newBlock(mut st)
    st.h[ctx + IC_END] = hv3
    saved := enter(mut st, list0(mut st), pk, if body_env == -2 { gv(mut st, L_TENV) } else { body_env }, ctx, -1)
    hv4 := strListAdd(mut st, gv(mut st, L_INLINING), name)
    gs(mut st, L_INLINING, hv4)
    pushScope(mut st)
    i = 0
    while i < np {
        declareNew(mut st, st.h[lat(mut st, ps, i) + NA], st.h[bs + 1 + i * 3], st.h[bs + 2 + i * 3], st.h[bs + 3 + i * 3], tok)?
        i += 1
    }
    stmts(mut st, st.h[st.h[decl + NE] + NA])?
    if cur(mut st) >= 0 {
        if llen(mut st, results) != 0 {
            return 0, LowerFail{k: KMissing, tok: tokOf(mut st, decl)}
        }
        runDefers(mut st, st.h[ctx + IC_BASE])?
        if cur(mut st) >= 0 {
            br(mut st, st.h[ctx + IC_END], -1)
        }
    }
    popScope(mut st)
    leave(mut st, saved)
    end := st.h[ctx + IC_END]
    if st.h[end + B_PREDS] == 0 {
        setCur(mut st, -1)
        return -1, nil
    }
    setCur(mut st, end)
    nr := llen(mut st, results)
    out := listN(mut st, nr * 2)
    st.h[out] = nr
    mut off := 0
    i = 0
    while i < nr {
        t := lat(mut st, results, i)
        st.h[out + 1 + i * 2] = t
        hv5 := loadVal(mut st, st.h[ctx + IC_SLOT], off, t)
        st.h[out + 2 + i * 2] = hv5
        off += tWords(mut st, t)
        i += 1
    }
    return out, nil
}

// inlineExit は inline 展開中の return / `?` のエラー側の後半: 展開範囲の defer → 結果の境界コピー（呼び出し点の深度へ）→ 展開入口の深度 → 末尾へ（値は書き済み）
func inlineExit(st mut desugar.S, ctx int, tok int) error? {
    runDefers(mut st, st.h[ctx + IC_BASE])?
    if cur(mut st) < 0 {
        return nil
    }
    rs := st.h[ctx + IC_RESULTS]
    mut off := 0
    mut i := 0
    while i < llen(mut st, rs) {
        t := lat(mut st, rs, i)
        relocateTo(mut st, st.h[ctx + IC_SLOT], off, t, st.h[ctx + IC_DEPTH])
        off += tWords(mut st, t)
        i += 1
    }
    regionSetDepth(mut st, st.h[ctx + IC_DEPTH])
    br(mut st, st.h[ctx + IC_END], -1)
    return nil
}

// lambdaCall はラムダの呼び出し: 引数を評価して束縛し、定義時の可視範囲 + 引数スコープで本体を展開する
func lambdaCall(st mut desugar.S, c int, args int, tok int) (int, error?) {
    seen := st.h[c + CL_PROBE]
    if seen >= 0 {
        if llen(mut st, args) != 1 {
            return 0, LowerFail{k: KMismatch, tok: tok}
        }
        yt, yv := expr(mut st, lat(mut st, args, 0))?
        if isTag(mut st, yt, TNever) {
            return -1, nil
        }
        if st.h[seen] >= 0 {
            if !tEql(mut st, st.h[seen], yt) {
                return 0, LowerFail{k: KMismatch, tok: tok}
            }
        } else {
            st.h[seen] = yt
        }
        return list0(mut st), nil
    }
    ft := st.h[c + CL_FT]
    fps := st.h[ft]
    frs := st.h[ft + 1]
    np := llen(mut st, fps)
    if llen(mut st, args) != np {
        return 0, LowerFail{k: KMismatch, tok: tok}
    }
    if llen(mut st, frs) >= 2 {
        return 0, LowerFail{k: KUnsupported, tok: tok}
    }
    bs := listN(mut st, np * 3)
    mut i := 0
    while i < np {
        k, t, v := bindArg(mut st, lat(mut st, args, i), lat(mut st, fps, i), false, tok)?
        if k < 0 {
            return -1, nil
        }
        st.h[bs + 1 + i * 3] = k
        st.h[bs + 2 + i * 3] = t
        st.h[bs + 3 + i * 3] = v
        i += 1
    }
    lam := st.h[c + CL_LAMBDA]
    saved := enter(mut st, st.h[c + CL_CHAIN], st.h[c + CL_PKG], st.h[c + CL_ENV], st.h[c + CL_RET], st.h[c + CL_INL])
    pushScope(mut st)
    lps := st.h[lam + NA]
    i = 0
    while i < np {
        declareNew(mut st, st.h[lat(mut st, lps, i) + NA], st.h[bs + 1 + i * 3], st.h[bs + 2 + i * 3], st.h[bs + 3 + i * 3], tok)?
        i += 1
    }
    body := st.h[lam + NB]
    bk := kindOf(mut st, body)
    mut vt := -1
    mut vv := 0
    // 文形 for の本体（節の c = forStmt の記録 + 1）: 床の上にループを開く。continue → 本体の末尾（cb）、break → for の後ろ
    loop := st.h[lam + NC]
    mut cb := -1
    mut cdepth := 0
    if loop > 0 {
        lr := loop - 1
        cb = newBlock(mut st)
        cdepth = regionDepth(mut st)
        hv0 := loopRec(mut st, cb, st.h[lr], gv(mut st, L_NSCOPE), st.h[lr + 2])
        gs(mut st, L_LOOP, hv0)
        gs(mut st, L_NLOOP, gv(mut st, L_NLOOP) + 1)
    }
    // 本体が呼び出し / パイプなら値なしも許す
    if bk == ast.ECall || bk == ast.EPipe {
        r := evalMulti(mut st, body)?
        if r < 0 {
            vt = tNever(mut st)
        } else if st.h[r] > 1 {
            return 0, LowerFail{k: KMismatch, tok: tok}
        } else if st.h[r] == 0 {
            vt = tNone(mut st)
        } else {
            vt = st.h[r + 1]
            vv = st.h[r + 2]
        }
    } else {
        a1, b1 := expr(mut st, body)?
        vt = a1
        vv = b1
    }
    if loop > 0 {
        gs(mut st, L_NLOOP, gv(mut st, L_NLOOP) - 1)
        gs(mut st, L_LOOP, st.h[gv(mut st, L_LOOP)])
        if cur(mut st) >= 0 {
            br(mut st, cb, -1)
        }
        if st.h[cb + B_PREDS] == 0 {
            setCur(mut st, -1)
            vt = tNever(mut st)
        } else {
            setCur(mut st, cb)
            regionSetDepth(mut st, cdepth)
            vt = tNone(mut st)
        }
    }
    if !isTag(mut st, vt, TNever) {
        runDefers(mut st, gv(mut st, L_NSCOPE) - 1)?
        if cur(mut st) < 0 {
            vt = tNever(mut st)
        }
    }
    popScope(mut st)
    leave(mut st, saved)
    if isTag(mut st, vt, TNever) {
        return -1, nil
    }
    if llen(mut st, frs) == 0 {
        return list0(mut st), nil
    }
    if !tEql(mut st, vt, lat(mut st, frs, 0)) {
        return 0, LowerFail{k: KMismatch, tok: tokOf(mut st, lam)}
    }
    r := list2(mut st, vt, vv)
    st.h[r] = 1
    return r, nil
}

// ── 関数値 ──

// fnValue は名前付き関数の参照 = 関数値（コードアドレス 1 語）
func fnValue(st mut desugar.S, fi int) (int, int) {
    ft := rec4(mut st, st.h[fi + FI_PARAMS], st.h[fi + FI_RESULTS], 0, 0)
    t := rec4(mut st, TFnv, ft, 0, 0)
    return t, funcaddr(mut st, st.h[fi + FI_IR])
}

// liftLambda は関数値が期待される位置（struct の関数型フィールド）のラムダ → 匿名関数 lambda#N（作業列で下ろす）のコードアドレス。
// 本体の値は合成した return。外側のローカルは見えない（別の関数として下ろす）
func liftLambda(st mut desugar.S, lam int, ft int, tok int) (int, int, error?) {
    ps := st.h[lam + NA]
    fps := st.h[ft]
    np := llen(mut st, ps)
    if np != llen(mut st, fps) {
        return 0, 0, LowerFail{k: KMismatch, tok: tok}
    }
    mut i := 0
    while i < np {
        te := st.h[lat(mut st, ps, i) + NB]
        if te >= 0 {
            t := resolveType(mut st, gv(mut st, L_CUR_PKG), te, false)?
            if !tEql(mut st, t, lat(mut st, fps, i)) {
                return 0, 0, LowerFail{k: KMismatch, tok: tok}
            }
        }
        i += 1
    }
    // 辞書 const のラムダは単相・文脈固定なので、参照点が何箇所でも匿名関数は 1 本
    if gv(mut st, L_IN_DICT) != 0 {
        mut x := gv(mut st, L_DLIFTS)
        while x >= 0 {
            if st.h[x + 1] == lam {
                return rec4(mut st, TFnv, ft, 0, 0), funcaddr(mut st, st.h[x + 2]), nil
            }
            x = st.h[x]
        }
    }
    // 合成の宣言: 仮引数 KParam [name, 型（使わない）, mutable = 0]、本体 = 値の文 1 つ（結果があれば return）
    params := listN(mut st, np)
    i = 0
    while i < np {
        hv1 := node(mut st, ast.KParam, tok, st.h[lat(mut st, ps, i) + NA], -1, 0, 0)
        st.h[params + 1 + i] = hv1
        i += 1
    }
    body := st.h[lam + NB]
    s := if llen(mut st, st.h[ft + 1]) == 0 { node(mut st, ast.SExpr, tok, body, 0, 0, 0) } else { node(mut st, ast.SRet, tok, list1(mut st, body), 0, 0, 0) }
    blk := node(mut st, ast.KBlock, tok, list1(mut st, s), 0, 0, 0)
    decl := node(mut st, ast.KFuncDecl, tok, strLit(mut st, "lambda"), list0(mut st), params, list0(mut st))
    st.h[decl + NE] = blk
    st.h[decl + NF] = -1
    n := gv(mut st, L_NLAMBDA)
    gs(mut st, L_NLAMBDA, n + 1)
    key := strCat(mut st, strLit(mut st, "lambda#"), decimal(mut st, n))
    fi := newFuncSig(mut st, key, decl, gv(mut st, L_CUR_PKG), st.h[ft], st.h[ft + 1])
    if gv(mut st, L_IN_DICT) != 0 {
        hv9 := rec4(mut st, gv(mut st, L_DLIFTS), lam, st.h[fi + FI_IR], 0)
        gs(mut st, L_DLIFTS, hv9)
    }
    return rec4(mut st, TFnv, ft, 0, 0), funcaddr(mut st, st.h[fi + FI_IR]), nil
}

// ── for 式（src/forexpand.zig の F1 脱糖 — 消費点での融合展開）──

// lowerFor は for 式 → Iter[T] 型のラムダ `(yield) => { GEN(src, (x) => { if g { yield(e) } }) }`。
// GEN は生成元が slice なら std/iter.Slice（予約参照名 iter#）、Iter の閉包（関数型の引数に束縛された名前）なら src 自身の呼び出し
func lowerFor(st mut desugar.S, fe int) (int, error?) {
    gen := forGen(mut st, fe)?
    return forLambda(mut st, strLit(mut st, "yield"), gen, tokOf(mut st, fe)), nil
}

// isForStmt は文形の for か（文の位置に置いたブロック形 — language.md 7 節。desugar.isForStmt と同じ判定）
func isForStmt(st mut desugar.S, e int) bool {
    return kindOf(mut st, e) == ast.EFor && st.h[e + NB] == 1
}

// callGenFn は呼び出し形の生成元（`x <- iter.Range(0, n)`）の関数表の添字: 名前の付いた関数の呼び出しで、仮引数が実引数より
// 1 つ多く、最後の仮引数が関数型（desugar.isCallGen と同じ判定）。当たらなければ -1
func callGenFn(st mut desugar.S, src int) int {
    if kindOf(mut st, src) != ast.ECall {
        return -1
    }
    callee := st.h[src + NA]
    ck := kindOf(mut st, callee)
    mut fi := -1
    if ck == ast.EIdent {
        name := st.h[callee + NA]
        if lookup(mut st, name) >= 0 {
            return -1
        }
        fi = findFnIn(mut st, gv(mut st, L_CUR_PKG), name, 0, st.h[name])
    } else if ck == ast.ESelector {
        base := st.h[callee + NA]
        if kindOf(mut st, base) != ast.EIdent || lookup(mut st, st.h[base + NA]) >= 0 {
            return -1
        }
        bn := st.h[base + NA]
        ip := importOf(mut st, gv(mut st, L_CUR_PKG), bn, 0, st.h[bn])
        if ip < 0 {
            return -1
        }
        field := st.h[callee + NB]
        fi = findFnIn(mut st, ip, field, 0, st.h[field])
    }
    if fi < 0 {
        return -1
    }
    ps := fnParams(mut st, fi)
    np := llen(mut st, ps)
    if np != llen(mut st, st.h[src + NB]) + 1 || kindOf(mut st, st.h[lat(mut st, ps, np - 1) + NB]) != ast.TFunc {
        return -1
    }
    return fi
}

// forGen は for の生成元の呼び出し `GEN(src, (x) => { if g { 本体 } })`（文形 for はこれを文として下ろす）
func forGen(st mut desugar.S, fe int) (int, error?) {
    tok := tokOf(mut st, fe)
    gens := st.h[fe + NA]
    if llen(mut st, gens) != 1 {
        return 0, LowerFail{k: KUnsupported, tok: tok}
    }
    g := lat(mut st, gens, 0)
    if llen(mut st, st.h[g + NA]) != 1 {
        return 0, LowerFail{k: KUnsupported, tok: tok}
    }
    src := st.h[g + NB]
    mut is_closure := false
    if kindOf(mut st, src) == ast.EIdent {
        l := lookup(mut st, st.h[src + NA])
        is_closure = l >= 0 && st.h[l + 2] == LClosure
    }
    gtok := tokOf(mut st, g)
    // k の本体: ガードを外側から if で包む
    mut inner := 0
    if st.h[fe + NB] == 0 {
        inner = yieldCall(mut st, st.h[fe + NC], tok)
    } else {
        inner = node(mut st, ast.EBlock, tok, st.h[fe + NC], 0, 0, 0)
    }
    guards := st.h[g + NC]
    mut i := llen(mut st, guards)
    while i > 0 {
        i -= 1
        th := node(mut st, ast.KBlock, gtok, list1(mut st, node(mut st, ast.SExpr, gtok, inner, 0, 0, 0)), 0, 0, 0)
        inner = node(mut st, ast.EIf, gtok, lat(mut st, guards, i), th, -1, 0)
    }
    k := forLambda(mut st, lat(mut st, st.h[g + NA], 0), inner, gtok)
    mut gen := 0
    if is_closure {
        gen = node(mut st, ast.ECall, gtok, src, list1(mut st, k), 0, 0)
    } else if callGenFn(mut st, src) >= 0 {
        sargs := st.h[src + NB]
        na := llen(mut st, sargs)
        args := listN(mut st, na + 1)
        mut j := 0
        while j < na {
            st.h[args + 1 + j] = lat(mut st, sargs, j)
            j += 1
        }
        st.h[args + 1 + na] = k
        gen = node(mut st, ast.ECall, gtok, st.h[src + NA], args, 0, 0)
    } else {
        bs := node(mut st, ast.EIdent, gtok, strLit(mut st, "iter#"), 0, 0, 0)
        callee := node(mut st, ast.ESelector, gtok, bs, strLit(mut st, "Slice"), 0, 0)
        // map の生成元はキーを回す（keysm の段 — `iter#.Slice(keys(src), k)`）。型は試し生成で取り、IR は巻き戻す（forIterType と同じ方式）
        mk := mark(mut st)
        pt, pv := expr(mut st, src)?
        rollback(mut st, mk)
        mut gsrc := src
        if isTag(mut st, pt, TMap) {
            kc := node(mut st, ast.EIdent, gtok, strLit(mut st, "keys"), 0, 0, 0)
            gsrc = node(mut st, ast.ECall, gtok, kc, list1(mut st, src), 0, 0)
        }
        gen = node(mut st, ast.ECall, gtok, callee, list2(mut st, gsrc, k), 0, 0)
    }
    return gen, nil
}

// yieldCall は `yield(v)` の呼び出し式
func yieldCall(st mut desugar.S, v int, tok int) int {
    callee := node(mut st, ast.EIdent, tok, strLit(mut st, "yield"), 0, 0, 0)
    return node(mut st, ast.ECall, tok, callee, list1(mut st, v), 0, 0)
}

// forLambda は 1 引数・型注釈なし・本体ブロックのラムダ（本体が既にブロックならそのまま）
func forLambda(st mut desugar.S, pname int, body int, tok int) int {
    ps := list1(mut st, node(mut st, ast.KLParam, tok, pname, -1, 0, 0))
    blk := if kindOf(mut st, body) == ast.EBlock { body } else { node(mut st, ast.EBlock, tok, list1(mut st, node(mut st, ast.SExpr, tok, body, 0, 0, 0)), 0, 0, 0) }
    return node(mut st, ast.ELambda, tok, ps, blk, 0, 0)
}

// forIterType は for 式の型 = Iter[T]（func(func(T))）。T は yield の値の型で、書き換えたラムダの本体を試し生成して取る
// （`yield` を番兵の閉包に束縛し、生成した IR は rollback で巻き戻す）。生成元が閉包なら -1
func forIterType(st mut desugar.S, fe int) (int, error?) {
    g := lat(mut st, st.h[fe + NA], 0)
    src := st.h[g + NB]
    if kindOf(mut st, src) == ast.EIdent {
        l := lookup(mut st, st.h[src + NA])
        if l >= 0 && st.h[l + 2] == LClosure {
            return -1, nil
        }
    }
    lowered := lowerFor(mut st, fe)?
    seen := rec4(mut st, -1, 0, 0, 0)
    dummy := rec4(mut st, list0(mut st), list0(mut st), 0, 0)
    probe := recN(mut st, CLSZ)
    st.h[probe + CL_LAMBDA] = lowered
    st.h[probe + CL_FT] = dummy
    st.h[probe + CL_PKG] = gv(mut st, L_CUR_PKG)
    hv1 := list0(mut st)
    st.h[probe + CL_CHAIN] = hv1
    st.h[probe + CL_RET] = st.h[gv(mut st, L_RETS) + 1]
    hv2 := list0(mut st)
    st.h[probe + CL_INL] = hv2
    st.h[probe + CL_ENV] = gv(mut st, L_TENV)
    st.h[probe + CL_PROBE] = seen
    mk := mark(mut st)
    pushScope(mut st)
    declare(mut st, strLit(mut st, "yield"), LClosure, rec4(mut st, TFunc, dummy, 0, 0), probe)
    expr(mut st, st.h[lowered + NB])?
    popScope(mut st)
    rollback(mut st, mk)
    y := st.h[seen]
    if y < 0 {
        return -1, nil
    }
    k := rec4(mut st, list1(mut st, y), list0(mut st), 0, 0)
    it := rec4(mut st, list1(mut st, rec4(mut st, TFunc, k, 0, 0)), list0(mut st), 0, 0)
    return rec4(mut st, TFunc, it, 0, 0), nil
}
