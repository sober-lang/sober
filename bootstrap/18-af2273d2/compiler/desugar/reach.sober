package desugar

// 部分検査（check --pkg・小分けの check — st.onlySet）の表層型検査の対象を絞る（3'' 第 2 段 (c) — 視点の固定費）: 視点には依存の package の
// 本体つきの宣言（.sobi の whole — 展開される関数・mut 関数・総称・リンク可視）が全部入るが、P の脱糖が読むのは P の関数と、P から呼び出しで
// 推移的に届く本体（展開・インスタンスの持ち上げで P の Def の中に写る分）の表だけ。全部を型付けると、desugar の mut 関数の本体を全部持つ
// lower の視点では検査の量の大半が依存の本体の型付けになっていた。
// 印（YInstNeeded）は呼び先 → 呼び手へ伝わる（YPropagate）ので、届く集合（呼び先について閉じている）の中の印は全体で型付けたときと同じ。
// 脱糖テンプレートの暗黙の呼び出し（文字列の補間・string(b) 等 — 字面の呼び出しに出ない）は std の関数を呼ぶので、std の本体は常に入れる（保守的）

import "ast"
import "std/iter"

// yReach は表層型を付ける関数の印の列（1 = 付ける）: P の関数・std の関数・const の初期化式から呼ばれる関数を種に、本体の中の呼び出しを辿って閉じる
func yReach(st mut S) ListRef {
    mark := ListRef(listN(mut st, st.nfn))
    mut work := mut []int{}
    for i <- iter.Range(0, st.nfn) {
        if fnPkg(mut st, i) == st.only || IsStdPkg(mut st, fnPkg(mut st, i)) {
            lput(mut st, mark, i, 1)
            work = append(work, i)
        }
    }
    // 辺 [呼び手（-1 = 関数の外 — const の初期化式）, 呼び先] の平らな列
    mut edges := mut []int{}
    for f <- iter.Range(0, st.nfile) {
        t := st.trees[f]
        pk := FilePkg(mut st, f)
        // このファイルの関数と本体の字句の範囲 [関数, 始め, 終わり]…
        mut rs := mut []int{}
        for i <- iter.Range(0, st.nfn) {
            nd := fnNode(mut st, i)
            if fileOf(mut st, nd) == f {
                ext := nodeOf(mut st, nd).f
                if ext >= 0 {
                    rs = append(rs, i)
                    rs = append(rs, latI(mut st, ListRef(ext), 1))
                    rs = append(rs, latI(mut st, ListRef(ext), 2))
                }
            }
        }
        rr := freeze(rs)
        for n <- iter.Range(0, len(t.nodes)) {
            k := t.nodes[n].kind
            if k == ast.ECall || k == ast.EPipe {
                x := nodeOf(mut st, NodeRef(ABASE + f * FW + n))
                callee := if k == ast.ECall { NodeRef(x.a) } else { NodeRef(x.b) }
                ci := e2sCallee(mut st, pk, callee)
                if ci >= 0 && int(fnBody(mut st, ci)) >= 0 {
                    edges = append(edges, rangeOf(rr, t.nodes[n].tok))
                    edges = append(edges, ci)
                }
            }
        }
    }
    for e <- iter.Range(0, len(edges) / 2) {
        if edges[e * 2] < 0 && latI(mut st, mark, edges[e * 2 + 1]) == 0 {
            lput(mut st, mark, edges[e * 2 + 1], 1)
            work = append(work, edges[e * 2 + 1])
        }
    }
    mut h := 0
    while h < len(work) {
        g := work[h]
        h += 1
        for e <- iter.Range(0, len(edges) / 2) {
            if edges[e * 2] == g && latI(mut st, mark, edges[e * 2 + 1]) == 0 {
                lput(mut st, mark, edges[e * 2 + 1], 1)
                work = append(work, edges[e * 2 + 1])
            }
        }
    }
    return mark
}

// rangeOf は字句 tok を本体に含む関数（rs = [関数, 始め, 終わり]…・無ければ -1）
func rangeOf(rs []int, tok int) int {
    for i <- iter.Range(0, len(rs) / 3) {
        if tok >= rs[i * 3 + 1] && tok < rs[i * 3 + 2] {
            return rs[i * 3]
        }
    }
    return -1
}
