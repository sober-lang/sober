package builder

// Builder[T] はコピーせずに成長する可変長の列（language.md 21 節の緩和策 2）。
// 固定長チャンクの鎖に積み、Build で連続 slice へ 1 回だけコピーする — 同じ region で
// 他の割り当てと交錯して成長しても、成長のコピーによるゴミが出ない（総コスト O(n)）。
//
//     mut nb := builder.Builder[Node]{}
//     builder.Push(mut nb, n)
//     nodes := builder.Build(mut nb)
//
// 表現:
// - chunks は chunk ヘッダの列。初回の Push で空ヘッダ seed の写しを seeds 本まとめて積む
//   （連続した append なので先端一致 = コピーなし）
// - chunk k の容量は 8 << k。新しい chunk は seed へ容量ぶん連続 append して確保し
//   （seed は Builder の region にあるので、確保先は Push を呼んだ深さに依らない）、以降は添字で書く
// - seed を使い切ると（8 × (2^seeds − 1) 要素を超えると）範囲外で panic する
type Builder[T] struct {
    chunks mut []mut []T
    // 空の mut ヘッダ。ゼロ値リテラル `Builder[T]{}` が束縛の region に作る — chunk の seed はこの写しなので、
    // Push を束縛より深い位置（再帰の中・式ブロックの中）から呼んでも seed は Builder の region に乗る
    // （mut slice の append はヘッダの region へ書く。同じ空ヘッダからの 2 回目以降の append は必ずコピー — 21 節）
    seed mut []T
    cur int
    fill int
    cap int
    n int
}

const seeds = 24

// Push は x を末尾に積む
func Push[T](b mut Builder[T], x T) {
    if len(b.chunks) == 0 {
        b.cur = 0 - 1
        mut i := 0
        while i < seeds {
            b.chunks = append(b.chunks, b.seed)
            i += 1
        }
    }
    if b.fill == b.cap {
        b.cur = b.cur + 1
        b.cap = if b.cap == 0 { 8 } else { b.cap * 2 }
        mut c := b.chunks[b.cur]
        mut j := 0
        while j < b.cap {
            c = append(c, x)
            j += 1
        }
        b.chunks[b.cur] = c
        b.fill = 1
    } else {
        mut c := b.chunks[b.cur]
        c[b.fill] = x
        b.fill = b.fill + 1
    }
    b.n = b.n + 1
}

// Len は積んだ要素の個数
func Len[T](b mut Builder[T]) int {
    return b.n
}

// Get は i 番目（0 起点）に積んだ要素。i が範囲外（i < 0 か Len 以上）なら添字の境界検査で panic する
func Get[T](b mut Builder[T], i int) T {
    ok := i >= 0 && i < b.n
    // 範囲外は探索を 0 番で回し（巨大な i で容量の倍々が溢れないように）、chunk の列の外を指させて境界検査に落とす
    // （chunk の中身は確保時の写しで埋まっているので、fill 以降も読めてしまう）
    j := if ok { i } else { 0 }
    // chunk k は容量 8 << k、先頭の通し番号は 8 × (2^k − 1)
    mut k := 0
    mut base := 0
    mut cap := 8
    while base + cap <= j {
        base = base + cap
        cap = cap * 2
        k += 1
    }
    c := b.chunks[if ok { k } else { len(b.chunks) }]
    return c[j - base]
}

// Build は積んだ要素を連続した imm slice にして返す（現在の最内 region へ 1 回コピー）。
// Builder 自体は変えない（続けて Push できる）
func Build[T](b mut Builder[T]) []T {
    mut out := mut []T{}
    mut k := 0
    mut cap := 8
    // 一度も Push していない Builder は cur がゼロ値の 0 のまま（初期化は初回の Push）— n で空を見る
    last := if b.n == 0 { 0 - 1 } else { b.cur }
    while k <= last {
        c := b.chunks[k]
        m := if k == last { b.fill } else { cap }
        mut j := 0
        while j < m {
            out = append(out, c[j])
            j += 1
        }
        cap = cap * 2
        k += 1
    }
    return freeze(out)
}
