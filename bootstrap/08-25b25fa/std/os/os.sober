package os

import "std/utf8"
import "std/io"
import "std/iter"

// プロセスの属性（language.md 28 節の追記 — R31）。ファイルシステムの操作は std/io

// Args はプログラムの引数（0 番 = プログラム名 — Go の os.Args と同じ並び）。呼ぶたびに呼び手の region へ写す。
// string は UTF-8 検査済みなので、不正な UTF-8 の引数が 1 つでもあれば全体が utf8.InvalidUtf8（入力次第で起きる = error — 27 節）
@errors(utf8.InvalidUtf8)
func Args() ([]string, error?) {
    // 「各引数のバイト + 0」の連結（C 文字列は 0 を含まないので区切りは曖昧にならない）
    b := sysArgs()
    mut out := mut []string{}
    mut start := 0
    mut i := 0
    while i < len(b) {
        if b[i] == 0 {
            s := string(b[start:i])?
            out = append(out, s)
            start = i + 1
        }
        i += 1
    }
    return freeze(out), nil
}

// Run は path のプログラムを args（argv[1:] — argv[0] は path）で子プロセスとして走らせ、終了を待って終了コードを返す（シグナルで死んだら 128 + 番号 —
// シェルと同じ）。標準入出力と環境変数は親のまま継ぐ。PATH は探さない（path はそのまま execve に渡す）。exec に失敗した子は 127 で終わる
// （error でなく終了コード — 子の中の失敗は親から区別しない）。fork / wait の失敗は io の errno のラベル。引数に NUL を含めば io.Other{errno: 22}
// （テスト基盤のランナーの最小面 — .pair/test-design-draft.md T1。fork + execve + wait4 の同期の直呼び）
@errors(io.NotFound, io.Denied, io.Other)
func Run(path string, args []string) (int, error?) {
    mut b := mut []byte{}
    if !argz(mut b, path) {
        return 0, io.Other{errno: 22}
    }
    for i <- iter.Range(0, len(args)) {
        if !argz(mut b, args[i]) {
            return 0, io.Other{errno: 22}
        }
    }
    r := sysRun(freeze(b))
    if r < 0 {
        return 0, errOf(0 - r)
    }
    return r, nil
}

// argz は s のバイト + 0 を b に積む（s が NUL を含めば false）
func argz(b mut []byte, s string) bool {
    sb := bytes(s)
    for i <- iter.Range(0, len(sb)) {
        if sb[i] == 0 {
            return false
        }
        b = append(b, sb[i])
    }
    b = append(b, 0)
    return true
}

// errOf は errno → io のラベル（io.errOf と同じ分け方）
func errOf(e int) error {
    if e == 2 || e == 20 {
        return io.NotFound{}
    }
    if e == 13 || e == 1 || e == 30 {
        return io.Denied{}
    }
    return io.Other{errno: e}
}
