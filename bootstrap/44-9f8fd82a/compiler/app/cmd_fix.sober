package main

// `sober fix` の handler（導出した @effects / @errors の宣言を書き込む）

import "std/io"
import "std/iter"
import "std/cli"
import "lexer"
import "loader"
import "analyzer"

// `sober fix [--effects] [--errors] [--std <dir>] <entry>`（宣言の書き換え器 analyzer.FixPlan）: 導出から `@effects` / `@errors` の宣言の行を
// std の外のファイルの公開関数に書く（どちらのフラグも無ければ両方）。--std は std の強制の掛かる公開関数にも正規形を書き、焼き込みの std のファイルを
// <dir>/std/… へ書く（std の宣言を手で書かない道具）。書いたファイルごとに `fix: <path>: <件数>` を出す。漏れ（導出 ⊄ 宣言）は書き換えない —
// 続けて `sober check` が名指す
func cmdFix(cl cli.Parsed) int {
    mut effects := cli.Bool(cl, FEffects)
    mut errors := cli.Bool(cl, FErrors)
    entry := cli.Pos(cl, Entry)
    sd := cli.StrOpt(cl, FStd)
    stdDir := if sd == nil { "" } else { sd }
    if !effects && !errors {
        effects = true
        errors = true
    }
    std := Std
    p, lerr := loadEntry(entry, false, std)
    if lerr != nil {
        return fail(loadDiag(p, std, lerr))
    }
    fs := analyzer.FixPlan(p, effects, errors, stdDir != "")
    for f <- iter.Range(0, len(p.file_path)) {
        isStd := f < len(p.file_std) && p.file_std[f]
        if isStd && stdDir == "" {
            continue
        }
        mut n := 0
        for k <- iter.Range(0, len(fs)) {
            if fs[k].file == f {
                n += 1
            }
        }
        if n > 0 {
            path := if isStd { stdDir + "/" + p.file_path[f] } else { p.file_path[f] }
            src, ok := loader.SourceFs(p, f, std)
            if !ok {
                return fail("cannot read ${p.file_path[f]}")
            }
            out := fixApply(src, fs, f)
            if isStd {
                mkdirs(parentOf(path))
            }
            werr := io.WriteFile(path, out)
            if werr != nil {
                return fail("cannot write ${path}")
            }
            println("fix: ${path}: ${n}")
        }
    }
    return 0
}

// ファイル f の書き換え（字句の位置 — 足す行は字句の行の頭・置き換えは `@` から閉じ括弧まで）を src に当てた結果（同じ位置の足しは列の順）
func fixApply(src []byte, fs []analyzer.Fix, f int) []byte {
    toks := lexer.Lex(src)
    // [始め, 終わり, 書き換えの添字]（始めの順 — 同じ始めは列の順）
    mut ed := mut []int{}
    for k <- iter.Range(0, len(fs)) {
        if fs[k].file == f && fs[k].tok >= 0 && fs[k].tok < len(toks) {
            mut s := toks[fs[k].tok].start
            mut e := s
            if fs[k].replace {
                mut i := fs[k].tok
                mut depth := 0
                mut going := true
                while going && i < len(toks) {
                    t := toks[i].tag
                    if t == lexer.LParen {
                        depth += 1
                    } else if t == lexer.RParen {
                        depth -= 1
                        going = depth > 0
                    }
                    e = toks[i].end
                    i += 1
                }
            } else {
                while s > 0 && src[s - 1] != '\n' {
                    s -= 1
                }
                e = s
            }
            // 始めの順に差す（同じ始めは後ろへ — 列の順を保つ）
            mut at := len(ed) / 3
            while at > 0 && ed[(at - 1) * 3] > s {
                at -= 1
            }
            mut nx := mut []int{}
            for j <- iter.Range(0, at * 3) {
                nx = append(nx, ed[j])
            }
            nx = append(nx, s)
            nx = append(nx, e)
            nx = append(nx, k)
            for j <- iter.Range(at * 3, len(ed)) {
                nx = append(nx, ed[j])
            }
            ed = nx
        }
    }
    mut out := mut []byte{}
    mut pos := 0
    for j <- iter.Range(0, len(ed) / 3) {
        s := ed[j * 3]
        for i <- iter.Range(pos, s) {
            out = append(out, src[i])
        }
        fx := fs[ed[j * 3 + 2]]
        b := bytes(fx.text)
        for i <- iter.Range(0, len(b)) {
            out = append(out, b[i])
        }
        if !fx.replace {
            out = append(out, '\n')
        }
        pos = if ed[j * 3 + 1] > s { ed[j * 3 + 1] } else { s }
    }
    for i <- iter.Range(pos, len(src)) {
        out = append(out, src[i])
    }
    return freeze(out)
}
