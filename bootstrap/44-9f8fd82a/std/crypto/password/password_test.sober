package password

// 公開の口の網（white-box）: 書いて読む往復・x/crypto の格子から組んだ保存の文字列の照合（Argon2id・PBKDF2 は PHC 文字列に組み直し・bcrypt は $2a$ のまま）・
// 1 文字違いの pw・費用と pw の拒否・読めない文字列・NeedsRehash の方式と費用の差

import "std/convert"
import "std/hex"
import "std/iter"
import "std/strings"

func verifies(h string, pw string) bool {
    ok, e := Verify(h, pw)
    assert(e == nil)
    return ok
}

func TestRoundTrip() {
    a, ea := Argon2id("correct horse", memoryKiB: 64, passes: 1, lanes: 1)
    assert(ea == nil)
    assert(strings.HasPrefix(a, "$argon2id$v=19$m=64,t=1,p=1$"))
    assert(verifies(a, "correct horse"))
    assert(!verifies(a, "correct horsf"))
    b, eb := Bcrypt("correct horse", cost: 4)
    assert(eb == nil)
    assert(strings.HasPrefix(b, "$2b$04$") && len(bytes(b)) == 60)
    assert(verifies(b, "correct horse"))
    assert(!verifies(b, "correct horsf"))
    p, ep := Pbkdf2("correct horse", iters: 1000)
    assert(ep == nil)
    assert(strings.HasPrefix(p, "$pbkdf2-sha256$i=1000,l=32$"))
    assert(verifies(p, "correct horse"))
    assert(!verifies(p, ""))
    // 塩は毎回違う
    a2, _ := Argon2id("correct horse", memoryKiB: 64, passes: 1, lanes: 1)
    assert(a != a2)
}

func TestVerifyGrid() {
    al := strings.Split(strings.TrimSpace(embedded(argon2idGrid, "testdata/crypto/argon2id.txt")), "\n")
    for li <- iter.Range(0, len(al)) {
        f := strings.Fields(al[li])
        pl, _ := convert.ParseInt(f[0])
        sl, _ := convert.ParseInt(f[1])
        want, _ := hex.Parse(f[6])
        if sl >= 8 && len(want) >= 4 {
            h := strings.Join([]string{"", "argon2id", "v=19", "m=${f[3]},t=${f[2]},p=${f[4]}", b64(pat(sl, 2)), b64(want)}, "$")
            assert(verifies(h, bytesToString(pat(pl, 1))))
        }
    }
    bl := strings.Split(strings.TrimSpace(embedded(bcryptGrid, "testdata/crypto/bcrypt.txt")), "\n")
    for li <- iter.Range(0, len(bl)) {
        f := strings.Fields(bl[li])
        pl, _ := convert.ParseInt(f[0])
        assert(verifies(f[2], bytesToString(pat(pl, 1))))
    }
    pk := strings.Split(strings.TrimSpace(embedded(pbkdf2Grid, "testdata/crypto/pbkdf2_sha256.txt")), "\n")
    for li <- iter.Range(0, len(pk)) {
        f := strings.Fields(pk[li])
        pl, _ := convert.ParseInt(f[0])
        sl, _ := convert.ParseInt(f[1])
        n, _ := convert.ParseInt(f[3])
        want, _ := hex.Parse(f[4])
        if sl >= 8 {
            h := strings.Join([]string{"", "pbkdf2-sha256", "i=${f[2]},l=${n}", b64(pat(sl, 2)), b64(want)}, "$")
            assert(verifies(h, bytesToString(pat(pl, 1))))
        }
    }
    assert(verifies("$2a$10$XajjQvNhvvRt5GSeFk1xFeyqRrsxkhBkUiQeg0dt.wU1qD4aFDcga", "allmine"))
    assert(verifies("$2y$10$XajjQvNhvvRt5GSeFk1xFeyqRrsxkhBkUiQeg0dt.wU1qD4aFDcga", "allmine"))
    assert(!verifies("$2a$10$XajjQvNhvvRt5GSeFk1xFeyqRrsxkhBkUiQeg0dt.wU1qD4aFDcga", "allmind"))
}

func TestRejects() {
    _, e1 := Argon2id("x", memoryKiB: 7, passes: 1, lanes: 1)
    assert(label(e1) == "BadParams")
    _, e2 := Argon2id("x", memoryKiB: 64, passes: 0, lanes: 1)
    assert(label(e2) == "BadParams")
    _, e3 := Bcrypt("x", cost: 3)
    assert(label(e3) == "BadParams")
    _, e4 := Bcrypt("x", cost: 32)
    assert(label(e4) == "BadParams")
    _, e5 := Pbkdf2("x", iters: 0)
    assert(label(e5) == "BadParams")
    long := bytesToString(pat(73, 1))
    _, e6 := Bcrypt(long, cost: 4)
    assert(label(e6) == "TooLong")
    _, e7 := Bcrypt(bytesToString([]byte{97, 0, 98}), cost: 4)
    assert(label(e7) == "TooLong")
    ok72, e8 := Bcrypt(bytesToString(pat(72, 9)), cost: 4)
    assert(e8 == nil)
    assert(verifies(ok72, bytesToString(pat(72, 9))))
    // bcrypt に渡せない pw は照合で false（誤りにしない）
    assert(!verifies(ok72, long))
    bad := []string{"", "$", "argon2id$v=19$m=64,t=1,p=1$c2FsdHNhbHQ$aGFzaA", "$argon2i$v=19$m=64,t=1,p=1$c2FsdHNhbHQ$aGFzaGhhc2g",
        "$argon2id$v=16$m=64,t=1,p=1$c2FsdHNhbHQ$aGFzaGhhc2g", "$argon2id$v=19$t=1,m=64,p=1$c2FsdHNhbHQ$aGFzaGhhc2g",
        "$argon2id$v=19$m=064,t=1,p=1$c2FsdHNhbHQ$aGFzaGhhc2g", "$argon2id$v=19$m=7,t=1,p=1$c2FsdHNhbHQ$aGFzaGhhc2g",
        "$argon2id$v=19$m=64,t=1,p=1$c2FsdHNhbHQ=$aGFzaGhhc2g", "$argon2id$v=19$m=64,t=1,p=1$c2Fsd*NhbHQ$aGFzaGhhc2g",
        "$2x$10$XajjQvNhvvRt5GSeFk1xFeyqRrsxkhBkUiQeg0dt.wU1qD4aFDcga", "$2b$3$XajjQvNhvvRt5GSeFk1xFeyqRrsxkhBkUiQeg0dt.wU1qD4aFDcga",
        "$2b$10$XajjQvNhvvRt5GSeFk1xFeyqRrsxkhBkUiQeg0dt.wU1qD4aFDcg", "$pbkdf2-sha256$i=1000,l=31$c2FsdHNhbHQ$aGFzaGhhc2g",
        "$pbkdf2-sha256$i=0,l=8$c2FsdHNhbHQ$aGFzaGhhc2g", "$pbkdf2-sha1$i=1000,l=8$c2FsdHNhbHQ$aGFzaGhhc2g"}
    for i <- iter.Range(0, len(bad)) {
        _, e := Verify(bad[i], "x")
        assert(label(e) == "Bad")
        _, en := NeedsRehash(bad[i], UseBcrypt{cost: 10})
        assert(label(en) == "Bad")
    }
}

func needs(h string, p Policy) bool {
    r, e := NeedsRehash(h, p)
    assert(e == nil)
    return r
}

func TestNeedsRehash() {
    a, _ := Argon2id("pw", memoryKiB: 64, passes: 1, lanes: 1)
    assert(!needs(a, UseArgon2id{memoryKiB: 64, passes: 1, lanes: 1}))
    assert(needs(a, UseArgon2id{memoryKiB: 128, passes: 1, lanes: 1}))
    assert(needs(a, UseArgon2id{memoryKiB: 64, passes: 2, lanes: 1}))
    assert(needs(a, UseBcrypt{cost: 4}))
    b, _ := Bcrypt("pw", cost: 4)
    assert(!needs(b, UseBcrypt{cost: 4}))
    assert(needs(b, UseBcrypt{cost: 5}))
    assert(needs(b, UsePbkdf2{iters: 1000}))
    p, _ := Pbkdf2("pw", iters: 1000)
    assert(!needs(p, UsePbkdf2{iters: 1000}))
    assert(needs(p, UsePbkdf2{iters: 2000}))
    assert(needs(p, UseArgon2id{memoryKiB: 64, passes: 1, lanes: 1}))
    assert(needs("$2a$10$XajjQvNhvvRt5GSeFk1xFeyqRrsxkhBkUiQeg0dt.wU1qD4aFDcga", UseBcrypt{cost: 12}))
    assert(!needs("$2a$10$XajjQvNhvvRt5GSeFk1xFeyqRrsxkhBkUiQeg0dt.wU1qD4aFDcga", UseBcrypt{cost: 10}))
}

// 費用を省くと OWASP の下限の既定。既定より古い（軽い）費用で保存した値も照合でき、NeedsRehash は既定への作り直しを求める
func TestDefaults() {
    a, ea := Argon2id("correct horse")
    assert(ea == nil)
    assert(strings.HasPrefix(a, "$argon2id$v=19$m=19456,t=2,p=1$"))
    assert(verifies(a, "correct horse"))
    b, eb := Bcrypt("correct horse")
    assert(eb == nil)
    assert(strings.HasPrefix(b, "$2b$10$"))
    assert(verifies(b, "correct horse"))
    p, ep := Pbkdf2("correct horse")
    assert(ep == nil)
    assert(strings.HasPrefix(p, "$pbkdf2-sha256$i=600000,l=32$"))
    assert(verifies(p, "correct horse"))
    old, _ := Argon2id("pw", memoryKiB: 64, passes: 1, lanes: 1)
    assert(verifies(old, "pw"))
    assert(needs(old, UseArgon2id{memoryKiB: 19456, passes: 2, lanes: 1}))
    assert(!needs(a, UseArgon2id{memoryKiB: 19456, passes: 2, lanes: 1}))
    // UseDefault = 今の std の既定（Argon2id・既定の費用）との差
    assert(!needs(a, UseDefault{}))
    assert(needs(old, UseDefault{}))
    assert(needs(b, UseDefault{}))
    assert(needs(p, UseDefault{}))
    oldB, _ := Bcrypt("pw", cost: 4)
    assert(verifies(oldB, "pw"))
    assert(needs(oldB, UseBcrypt{cost: 10}))
    oldP, _ := Pbkdf2("pw", iters: 1000)
    assert(verifies(oldP, "pw"))
    assert(needs(oldP, UsePbkdf2{iters: 600000}))
    // 既定の費用の言明（塩と値の前まで — 準拠文書のパスワードハッシュの表へ）
    pa := strings.Split(a, "$")
    pb := strings.Split(b, "$")
    pp := strings.Split(p, "$")
    println("conf-item: password/default argon2id ${pa[2]} ${pa[3]}")
    println("conf-item: password/default bcrypt ${pb[1]} cost=${pb[2]}")
    println("conf-item: password/default pbkdf2-sha256 ${pp[2]}")
}

func label(e error?) string {
    return switch e {
    case nil: "nil"
    case BadParams{}: "BadParams"
    case TooLong{}: "TooLong"
    case Bad{}: "Bad"
    }
}
