package x86

// x86_64 の命令エンコーダ（legacy/zig/arch/x86_64.zig の写し — 正規バックエンドの Sober 化 B-1b）。IR を知らない。
// 書き先はバイトの表（table.Table[byte] — 追記と、call / jmp の rel32・番地の imm32 の後埋め）。
// 正しさは GNU as との照合（scripts/x86enc.sh — 全レジスタの組み合わせ）と、ELF のバイト一致（elfeq）で見る。
// ビットの詰め（REX・ModRM・SIB・opcode | reg）は int のシフトで書く — @layout のビット粒度（Y9）は入れない裁定（report-115 §1）。
// オペコードは 16 進のリテラル（`0x89` — 注釈の綴り `REX.W 89 /r` と同じ字面。n 進リテラルの導入 6658636 で 10 進から直した）

import "std/table"

// レジスタ（番号 = エンコードの値。r8〜r15 は REX の拡張 bit で届く）
const Rax = 0
const Rcx = 1
const Rdx = 2
const Rbx = 3
const Rsp = 4
const Rbp = 5
const Rsi = 6
const Rdi = 7
const R8 = 8
const R9 = 9
const R10 = 10
const R11 = 11
const R12 = 12
const R13 = 13
const R14 = 14
const R15 = 15

// 条件コード（jcc / setcc の下位 4 bit）
const CondE = 4
const CondNe = 5
const CondL = 12
const CondGe = 13
const CondLe = 14
const CondG = 15
const CondB = 2  // 符号なし <
const CondAe = 3 // 符号なし >=
const CondA = 7  // 符号なし >

// SIB の倍率（2 bit）
const Scale1 = 0
const Scale8 = 3

const rexW = 0x48

func lo(r int) int {
    return r & 7
}

func hi(r int) int {
    return r >> 3
}

func modrm(mod int, reg int, rm int) byte {
    return byte(mod << 6 | reg << 3 | rm)
}

func put(c mut table.Table[byte], b int) {
    table.Push(mut c, byte(b))
}

// Here は今のコードの位置（ラベル・後埋めの位置）
func Here(c mut table.Table[byte]) int {
    return table.Len(mut c)
}

// rex は REX 接頭辞（W = 64 bit、r = ModRM.reg の拡張、x = SIB.index の拡張、b = ModRM.rm / SIB.base / opcode の拡張）。
// 0x40 だけのとき（W も拡張も無い）は force のときだけ出す（spl / bpl / sil / dil のバイトレジスタ）
func rex(c mut table.Table[byte], w bool, r int, x int, b int, force bool) {
    v := 0x40 | (if w { 8 } else { 0 }) | r << 2 | x << 1 | b
    if v != 0x40 || force {
        put(mut c, v)
    }
}

func imm32(c mut table.Table[byte], v int) {
    put(mut c, v & 255)
    put(mut c, v >> 8 & 255)
    put(mut c, v >> 16 & 255)
    put(mut c, v >> 24 & 255)
}

// opRR は REX.W op /r のレジスタ形（reg = ModRM.reg、rm = ModRM.rm）。op2 は 2 バイト目（無ければ -1）
func opRR(c mut table.Table[byte], op1 int, op2 int, reg int, rm int) {
    rex(mut c, true, hi(reg), 0, hi(rm), false)
    put(mut c, op1)
    if op2 != -1 {
        put(mut c, op2)
    }
    table.Push(mut c, modrm(3, lo(reg), lo(rm)))
}

// opExt は REX.W op /ext のレジスタ形
func opExt(c mut table.Table[byte], op int, ext int, rm int) {
    rex(mut c, true, 0, 0, hi(rm), false)
    put(mut c, op)
    table.Push(mut c, modrm(3, ext, lo(rm)))
}

// memOperand は ModRM(+SIB)(+disp) のメモリオペランド [base + disp]。as と同じく disp は 0 / disp8 / disp32 の最短を選ぶ。
// 下位 3 bit が 5（rbp / r13）は mod=00 が RIP 相対になるので disp8 以上、4（rsp / r12）は SIB（0x24）が要る
func memOperand(c mut table.Table[byte], reg int, base int, disp int) {
    rm := lo(base)
    mod := if disp == 0 && rm != 5 { 0 } else if disp >= -128 && disp <= 127 { 1 } else { 2 }
    table.Push(mut c, modrm(mod, reg, rm))
    if rm == 4 {
        put(mut c, 0x24)
    }
    if mod == 1 {
        put(mut c, disp & 255)
    } else if mod == 2 {
        imm32(mut c, disp)
    }
}

// opMem は op のメモリ形 [base + disp]。w = REX.W、reg は ModRM.reg に入るレジスタ番号（/ext なら ext）。op2 は 2 バイト目（無ければ -1）
func opMem(c mut table.Table[byte], w bool, op1 int, op2 int, reg int, base int, disp int, force bool) {
    rex(mut c, w, hi(reg), 0, hi(base), force)
    put(mut c, op1)
    if op2 != -1 {
        put(mut c, op2)
    }
    memOperand(mut c, lo(reg), base, disp)
}

// ── mov ──────────────────────────────────────────────────────────

// MovRegImm32 は mov reg, imm32（64 bit に符号拡張）— REX.W C7 /0 id
func MovRegImm32(c mut table.Table[byte], reg int, imm int) {
    opExt(mut c, 0xc7, 0, reg)
    imm32(mut c, imm)
}

// MovRegImm64 は movabs reg, imm64 — REX.W B8+r io
func MovRegImm64(c mut table.Table[byte], reg int, imm int) {
    rex(mut c, true, 0, 0, hi(reg), false)
    put(mut c, 0xb8 | lo(reg))
    imm32(mut c, imm)
    imm32(mut c, imm >> 32)
}

// MovRegReg は mov dst, src — REX.W 89 /r（reg = src, rm = dst）
func MovRegReg(c mut table.Table[byte], dst int, src int) {
    opRR(mut c, 0x89, -1, src, dst)
}

// MovRegMem は mov dst, [base + disp] — REX.W 8B /r
func MovRegMem(c mut table.Table[byte], dst int, base int, disp int) {
    opMem(mut c, true, 0x8b, -1, dst, base, disp, false)
}

// LeaRegMem は lea dst, [base + disp] — REX.W 8D /r
func LeaRegMem(c mut table.Table[byte], dst int, base int, disp int) {
    opMem(mut c, true, 0x8d, -1, dst, base, disp, false)
}

// MovMemReg は mov [base + disp], src — REX.W 89 /r
func MovMemReg(c mut table.Table[byte], base int, disp int, src int) {
    opMem(mut c, true, 0x89, -1, src, base, disp, false)
}

// MovMemImm32 は mov qword ptr [base + disp], imm32（符号拡張）— REX.W C7 /0 id
func MovMemImm32(c mut table.Table[byte], base int, disp int, imm int) {
    opMem(mut c, true, 0xc7, -1, 0, base, disp, false)
    imm32(mut c, imm)
}

// LeaRegSib は lea dst, [base + index * scale] — REX.W 8D /r + SIB（gep）。index に rsp は置けない。
// base の下位 3 bit が 5（rbp / r13）は mod=00 が「base 無し + disp32」になるので disp8 = 0 を付ける
func LeaRegSib(c mut table.Table[byte], dst int, base int, index int, scale int) {
    rex(mut c, true, hi(dst), hi(index), hi(base), false)
    put(mut c, 0x8d)
    sib := scale << 6 | lo(index) << 3 | lo(base)
    if lo(base) == 5 {
        table.Push(mut c, modrm(1, lo(dst), 4))
        put(mut c, sib)
        put(mut c, 0)
    } else {
        table.Push(mut c, modrm(0, lo(dst), 4))
        put(mut c, sib)
    }
}

// MovMem8Reg は mov byte ptr [base + disp], src8 — 88 /r。spl / bpl / sil / dil と r8b〜 は REX 付き（as と同じ）
func MovMem8Reg(c mut table.Table[byte], base int, disp int, src int) {
    opMem(mut c, false, 0x88, -1, src, base, disp, src >= 4 && src < 8)
}

// MovzxRegMem8 は movzx dst, byte ptr [base + disp] — REX.W 0F B6 /r
func MovzxRegMem8(c mut table.Table[byte], dst int, base int, disp int) {
    opMem(mut c, true, 0x0f, 0xb6, dst, base, disp, false)
}

// RepStosq は rep stosq — F3 48 AB（rcx 語を rdi から rax で埋める。フレームスロットの入口ゼロ初期化）
func RepStosq(c mut table.Table[byte]) {
    put(mut c, 0xf3)
    put(mut c, rexW)
    put(mut c, 0xab)
}

// ── スタック ─────────────────────────────────────────────────────

// PushReg は push reg — 50+r
func PushReg(c mut table.Table[byte], reg int) {
    rex(mut c, false, 0, 0, hi(reg), false)
    put(mut c, 0x50 | lo(reg))
}

// PopReg は pop reg — 58+r
func PopReg(c mut table.Table[byte], reg int) {
    rex(mut c, false, 0, 0, hi(reg), false)
    put(mut c, 0x58 | lo(reg))
}

// ── 算術・論理（reg, reg。REX.W op /r、reg = src rm = dst） ──────

// AddRegReg は add dst, src — 01 /r
func AddRegReg(c mut table.Table[byte], dst int, src int) {
    opRR(mut c, 0x01, -1, src, dst)
}

// SubRegReg は sub dst, src — 29 /r
func SubRegReg(c mut table.Table[byte], dst int, src int) {
    opRR(mut c, 0x29, -1, src, dst)
}

// AndRegReg は and dst, src — 21 /r
func AndRegReg(c mut table.Table[byte], dst int, src int) {
    opRR(mut c, 0x21, -1, src, dst)
}

// OrRegReg は or dst, src — 09 /r
func OrRegReg(c mut table.Table[byte], dst int, src int) {
    opRR(mut c, 0x09, -1, src, dst)
}

// XorRegReg は xor dst, src — 31 /r
func XorRegReg(c mut table.Table[byte], dst int, src int) {
    opRR(mut c, 0x31, -1, src, dst)
}

// CmpRegReg は cmp dst, src — 39 /r
func CmpRegReg(c mut table.Table[byte], dst int, src int) {
    opRR(mut c, 0x39, -1, src, dst)
}

// ImulRegReg は imul dst, src — REX.W 0F AF /r（reg = dst, rm = src）
func ImulRegReg(c mut table.Table[byte], dst int, src int) {
    opRR(mut c, 0x0f, 0xaf, dst, src)
}

// aluRegImm は op reg, imm — as と同じ最短形を選ぶ:
// imm8 に収まれば 83 /ext ib、rax なら短縮形（ext × 8 + 5）id、それ以外は 81 /ext id
func aluRegImm(c mut table.Table[byte], ext int, reg int, imm int) {
    if imm >= -128 && imm <= 127 {
        opExt(mut c, 0x83, ext, reg)
        put(mut c, imm & 255)
    } else {
        if reg == Rax {
            put(mut c, rexW)
            put(mut c, ext * 8 + 5)
        } else {
            opExt(mut c, 0x81, ext, reg)
        }
        imm32(mut c, imm)
    }
}

// AddRegImm は add reg, imm
func AddRegImm(c mut table.Table[byte], reg int, imm int) {
    aluRegImm(mut c, 0, reg, imm)
}

// SubRegImm は sub reg, imm
func SubRegImm(c mut table.Table[byte], reg int, imm int) {
    aluRegImm(mut c, 5, reg, imm)
}

// CmpRegImm は cmp reg, imm
func CmpRegImm(c mut table.Table[byte], reg int, imm int) {
    aluRegImm(mut c, 7, reg, imm)
}

// AndRegImm は and reg, imm
func AndRegImm(c mut table.Table[byte], reg int, imm int) {
    aluRegImm(mut c, 4, reg, imm)
}

// NegReg は neg reg — REX.W F7 /3
func NegReg(c mut table.Table[byte], reg int) {
    opExt(mut c, 0xf7, 3, reg)
}

// ShlRegCl は shl reg, cl — REX.W D3 /4（量は cl の下位 6 bit — IR の shl と同じ意味）
func ShlRegCl(c mut table.Table[byte], reg int) {
    opExt(mut c, 0xd3, 4, reg)
}

// SarRegCl は sar reg, cl — REX.W D3 /7（算術右シフト）
func SarRegCl(c mut table.Table[byte], reg int) {
    opExt(mut c, 0xd3, 7, reg)
}

// Cqo は rax を rdx:rax に符号拡張（idiv の前）— 48 99
func Cqo(c mut table.Table[byte]) {
    put(mut c, rexW)
    put(mut c, 0x99)
}

// IdivReg は idiv reg — rdx:rax / reg → 商 rax、余り rdx — REX.W F7 /7
func IdivReg(c mut table.Table[byte], reg int) {
    opExt(mut c, 0xf7, 7, reg)
}

// SetccAl は setcc al — 0F 9x C0（比較結果を 0 / 1 に）
func SetccAl(c mut table.Table[byte], cond int) {
    put(mut c, 0x0f)
    put(mut c, 144 | cond)
    put(mut c, 0xc0)
}

// MovzxRaxAl は movzx rax, al — 48 0F B6 C0
func MovzxRaxAl(c mut table.Table[byte]) {
    put(mut c, rexW)
    put(mut c, 0x0f)
    put(mut c, 0xb6)
    put(mut c, 0xc0)
}

// ── 制御 ─────────────────────────────────────────────────────────

// JmpRel32 は jmp rel32 — E9 cd。rel32 の位置（後埋め用）を返す
func JmpRel32(c mut table.Table[byte]) int {
    put(mut c, 0xe9)
    imm32(mut c, 0)
    return Here(mut c) - 4
}

// JccRel32 は jcc rel32 — 0F 8x cd。rel32 の位置を返す
func JccRel32(c mut table.Table[byte], cond int) int {
    put(mut c, 0x0f)
    put(mut c, 128 | cond)
    imm32(mut c, 0)
    return Here(mut c) - 4
}

// CallRel32 は call rel32 — E8 cd。rel32 の位置を返す
func CallRel32(c mut table.Table[byte]) int {
    put(mut c, 0xe8)
    imm32(mut c, 0)
    return Here(mut c) - 4
}

// CallReg は call r64 — FF /2（間接呼び出し）
func CallReg(c mut table.Table[byte], reg int) {
    rex(mut c, false, 0, 0, hi(reg), false)
    put(mut c, 0xff)
    put(mut c, 0xd0 | lo(reg))
}

// Leave は leave — C9（mov rsp, rbp; pop rbp）
func Leave(c mut table.Table[byte]) {
    put(mut c, 0xc9)
}

// Ret は ret — C3
func Ret(c mut table.Table[byte]) {
    put(mut c, 0xc3)
}

// Syscall は syscall — 0F 05
func Syscall(c mut table.Table[byte]) {
    put(mut c, 0x0f)
    put(mut c, 0x05)
}

// Ud2 は ud2 — 0F 0B（到達しない印。_start の入口呼び出しの後ろ）
func Ud2(c mut table.Table[byte]) {
    put(mut c, 0x0f)
    put(mut c, 0x0b)
}

// PatchImm32 は位置 at の 4 バイトを v（下位 32 bit・リトルエンディアン）で書き換える
func PatchImm32(c mut table.Table[byte], at int, v int) {
    table.Set(mut c, at, byte(v & 255))
    table.Set(mut c, at + 1, byte(v >> 8 & 255))
    table.Set(mut c, at + 2, byte(v >> 16 & 255))
    table.Set(mut c, at + 3, byte(v >> 24 & 255))
}

// PatchRel32 は位置 at の rel32 を target への相対値（at + 4 からの差）で埋める
func PatchRel32(c mut table.Table[byte], at int, target int) {
    PatchImm32(mut c, at, target - (at + 4))
}
