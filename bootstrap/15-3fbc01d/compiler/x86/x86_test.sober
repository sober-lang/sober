package x86

// x86 エンコーダの単体テスト（`cd compiler && ../bin/sober test x86`）。全レジスタの網羅は GNU as の照合（scripts/x86enc.sh）が見る —
// ここは as を立てずに読める少数の黄金（16 進は GNU as の出力）と、後埋め（PatchRel32 / PatchImm32）

import "std/iter"
import "std/table"

// hex は c の中身の 16 進（小文字）
func hex(c mut table.Table[byte]) string {
    mut out := mut []byte{}
    for i <- iter.Range(0, table.Len(mut c)) {
        b := int(table.Get(mut c, i))
        out = append(out, digit(b >> 4))
        out = append(out, digit(b & 15))
    }
    s, err := string(freeze(out))
    if err != nil {
        panic()
    }
    return s
}

func digit(n int) byte {
    return byte(if n < 10 { 48 + n } else { 87 + n })
}

func TestMemOperand() {
    mut c := table.Table[byte]{}
    MovRegMem(mut c, Rax, Rbp, 0)     // mov rax, [rbp] = 48 8b 45 00（rbp は disp8 0）
    MovRegMem(mut c, R12, Rsp, -8)    // mov r12, [rsp-8] = 4c 8b 64 24 f8（rsp は SIB）
    MovMemReg(mut c, R13, 4096, Rdi)  // mov [r13+4096], rdi = 49 89 bd 00 10 00 00
    MovMem8Reg(mut c, Rax, 16, Rsi)   // mov byte [rax+16], sil = 40 88 70 10（REX 強制）
    assert(hex(mut c) == "488b45004c8b6424f84989bd0010000040887010")
}

func TestImm() {
    mut c := table.Table[byte]{}
    AddRegImm(mut c, Rax, 4096)   // add rax, 4096 = 48 05 00 10 00 00（rax の短縮形）
    SubRegImm(mut c, Rsp, 8)      // sub rsp, 8 = 48 83 ec 08
    CmpRegImm(mut c, R11, -129)   // cmp r11, -129 = 49 81 fb 7f ff ff ff
    MovRegImm64(mut c, R15, -2)   // movabs r15, -2 = 49 bf fe ff ff ff ff ff ff ff
    assert(hex(mut c) == "4805001000004883ec084981fb7fffffff49bffeffffffffffffff")
}

func TestPatch() {
    mut c := table.Table[byte]{}
    at := JmpRel32(mut c)
    Ret(mut c)
    PatchRel32(mut c, at, 0)      // 自分の先頭（0）への jmp = rel32 -5
    assert(hex(mut c) == "e9fbffffffc3")
    PatchImm32(mut c, at, 305419896)
    assert(hex(mut c) == "e978563412c3")
}
