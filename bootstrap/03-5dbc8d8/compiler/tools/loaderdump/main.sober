package main

// loaderdump: 標準入力の Manifest から Program を load し、loader 黄金の JSON（Zig 版 `sober parse --loader-json` と同じバイト列）を
// 標準出力に書く。selfhost の loader 差分オラクル（scripts/selfhost_load.sh）の Sober 側。
// Manifest の形（argv と readdir が無いための代役 — 仮決め R8-2 / R8-3）: 1 行目 = entry、2 行目 = std の置き場（`std/…` を読む根）、
// 3 行目以降 = ルート（cwd）相対のファイル一覧（ファイル名順。`std/…` は std の置き場の相対）

import "std/io"
import "loader"

// lines は b を改行で割った行の列（空行は捨てる）
func lines(b []int) [][]int {
    mut out := mut [][]int{}
    mut s := 0
    mut i := 0
    while i <= len(b) {
        if i == len(b) || b[i] == 10 {
            if i > s {
                out = append(out, b[s:i])
            }
            s = i + 1
        }
        i += 1
    }
    return freeze(out)
}

func main() {
    src, err := io.ReadFile("/dev/stdin")
    if err != nil {
        println("loaderdump: cannot read /dev/stdin")
        return
    }
    ls := lines(src)
    if len(ls) < 2 {
        println("loaderdump: bad manifest")
        return
    }
    p := loader.Load(loader.Manifest{ls[0], ls[1], ls[2:len(ls)]})
    if loader.Failed(p) {
        werr := io.WriteFile("/dev/stdout", loader.FailMsg(p))
        println("")
        println("loaderdump: load error")
        return
    }
    werr := io.WriteFile("/dev/stdout", loader.Json(p))
    if werr != nil {
        println("loaderdump: cannot write /dev/stdout")
    }
}
