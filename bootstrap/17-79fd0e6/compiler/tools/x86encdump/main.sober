package main

// x86 エンコーダの照合用の列（scripts/x86enc.sh — GNU as との照合）。1 行に 1 命令: 「hex<TAB>Intel 構文の asm」。
// エンコーダの公開関数を全レジスタ（と disp / imm の境界値）の組み合わせで吐く。rel32 の形（jmp / jcc / call）は as が短い形を選ぶので
// 照合しない（固定長の形 — ELF のバイト一致 elfeq が見る）

import "std/iter"
import "std/table"
import "x86"

func regName(r int) string {
    names := []string{"rax", "rcx", "rdx", "rbx", "rsp", "rbp", "rsi", "rdi", "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15"}
    return names[r]
}

func reg32Name(r int) string {
    names := []string{"eax", "ecx", "edx", "ebx", "esp", "ebp", "esi", "edi", "r8d", "r9d", "r10d", "r11d", "r12d", "r13d", "r14d", "r15d"}
    return names[r]
}

func reg8Name(r int) string {
    names := []string{"al", "cl", "dl", "bl", "spl", "bpl", "sil", "dil", "r8b", "r9b", "r10b", "r11b", "r12b", "r13b", "r14b", "r15b"}
    return names[r]
}

func condName(k int) string {
    conds := []int{x86.CondE, x86.CondNe, x86.CondL, x86.CondGe, x86.CondLe, x86.CondG, x86.CondB, x86.CondAe, x86.CondA, x86.CondP, x86.CondNp}
    names := []string{"e", "ne", "l", "ge", "le", "g", "b", "ae", "a", "p", "np"}
    mut i := 0
    while conds[i] != k {
        i += 1
    }
    return names[i]
}

func mem(base int, disp int) string {
    return if disp == 0 { "[${regName(base)}]" } else if disp < 0 { "[${regName(base)}-${0 - disp}]" } else { "[${regName(base)}+${disp}]" }
}

// sibMem は [base+index*倍率±disp] の Intel 構文
func sibMem(base int, index int, f int, disp int) string {
    d := if disp == 0 { "" } else if disp < 0 { "-${0 - disp}" } else { "+${disp}" }
    return "[${regName(base)}+${regName(index)}*${f}${d}]"
}

func hexDigit(n int) byte {
    return byte(if n < 10 { 48 + n } else { 87 + n })
}

// line は c の [from, 末尾) の hex と asm を 1 行に印字する
func line(c mut table.Table[byte], from int, asm string) {
    mut out := mut []byte{}
    for i <- iter.Range(from, table.Len(mut c)) {
        b := int(table.Get(mut c, i))
        out = append(out, hexDigit(b >> 4))
        out = append(out, hexDigit(b & 15))
    }
    h, err := string(freeze(out))
    if err == nil {
        println("${h}\t${asm}")
    }
}

func main() {
    mut c := table.Table[byte]{}
    disps := []int{0, -8, 127, 128, -128, -129, 4096}
    imms := []int{0, 1, -1, 127, -128, 128, -129, 65536, -2147483648, 2147483647}
    for a <- iter.Range(0, 16) {
        mut at := x86.Here(mut c)
        x86.PushReg(mut c, a)
        line(mut c, at, "push ${regName(a)}")
        at = x86.Here(mut c)
        x86.PopReg(mut c, a)
        line(mut c, at, "pop ${regName(a)}")
        at = x86.Here(mut c)
        x86.NegReg(mut c, a)
        line(mut c, at, "neg ${regName(a)}")
        at = x86.Here(mut c)
        x86.ShlRegCl(mut c, a)
        line(mut c, at, "shl ${regName(a)}, cl")
        at = x86.Here(mut c)
        x86.SarRegCl(mut c, a)
        line(mut c, at, "sar ${regName(a)}, cl")
        for k <- iter.Range(0, 4) {
            sh := if k == 0 { 1 } else if k == 1 { 13 } else if k == 2 { 31 } else { 63 }
            at = x86.Here(mut c)
            x86.SarRegImm(mut c, a, sh)
            line(mut c, at, "sar ${regName(a)}, ${sh}")
        }
        at = x86.Here(mut c)
        x86.IdivReg(mut c, a)
        line(mut c, at, "idiv ${regName(a)}")
        at = x86.Here(mut c)
        x86.CallReg(mut c, a)
        line(mut c, at, "call ${regName(a)}")
        for k <- iter.Range(0, len(imms)) {
            n := imms[k]
            at = x86.Here(mut c)
            x86.MovRegImm32(mut c, a, n)
            line(mut c, at, "mov ${regName(a)}, ${n}")
            at = x86.Here(mut c)
            x86.AddRegImm(mut c, a, n)
            line(mut c, at, "add ${regName(a)}, ${n}")
            at = x86.Here(mut c)
            x86.SubRegImm(mut c, a, n)
            line(mut c, at, "sub ${regName(a)}, ${n}")
            at = x86.Here(mut c)
            x86.CmpRegImm(mut c, a, n)
            line(mut c, at, "cmp ${regName(a)}, ${n}")
            at = x86.Here(mut c)
            x86.AndRegImm(mut c, a, n)
            line(mut c, at, "and ${regName(a)}, ${n}")
        }
        at = x86.Here(mut c)
        x86.MovRegImm64(mut c, a, 81985529216486895)
        line(mut c, at, "movabs ${regName(a)}, 81985529216486895")
        at = x86.Here(mut c)
        x86.MovRegImm64(mut c, a, -2)
        line(mut c, at, "movabs ${regName(a)}, -2")
        for b <- iter.Range(0, 16) {
            at = x86.Here(mut c)
            x86.MovRegReg(mut c, a, b)
            line(mut c, at, "mov ${regName(a)}, ${regName(b)}")
            at = x86.Here(mut c)
            x86.AddRegReg(mut c, a, b)
            line(mut c, at, "add ${regName(a)}, ${regName(b)}")
            at = x86.Here(mut c)
            x86.SubRegReg(mut c, a, b)
            line(mut c, at, "sub ${regName(a)}, ${regName(b)}")
            at = x86.Here(mut c)
            x86.AndRegReg(mut c, a, b)
            line(mut c, at, "and ${regName(a)}, ${regName(b)}")
            at = x86.Here(mut c)
            x86.OrRegReg(mut c, a, b)
            line(mut c, at, "or ${regName(a)}, ${regName(b)}")
            at = x86.Here(mut c)
            x86.XorRegReg(mut c, a, b)
            line(mut c, at, "xor ${regName(a)}, ${regName(b)}")
            at = x86.Here(mut c)
            x86.CmpRegReg(mut c, a, b)
            line(mut c, at, "cmp ${regName(a)}, ${regName(b)}")
            at = x86.Here(mut c)
            x86.ImulRegReg(mut c, a, b)
            line(mut c, at, "imul ${regName(a)}, ${regName(b)}")
            if b != x86.Rsp {
                at = x86.Here(mut c)
                x86.LeaRegSib(mut c, a, a, b, x86.Scale8)
                line(mut c, at, "lea ${regName(a)}, [${regName(a)}+${regName(b)}*8]")
            }
            if a != x86.Rsp {
                at = x86.Here(mut c)
                x86.LeaRegSib(mut c, b, b, a, x86.Scale1)
                line(mut c, at, "lea ${regName(b)}, [${regName(b)}+${regName(a)}*1]")
            }
            for k <- iter.Range(0, len(disps)) {
                d := disps[k]
                at = x86.Here(mut c)
                x86.MovRegMem(mut c, a, b, d)
                line(mut c, at, "mov ${regName(a)}, qword ptr ${mem(b, d)}")
                at = x86.Here(mut c)
                x86.LeaRegMem(mut c, a, b, d)
                line(mut c, at, "lea ${regName(a)}, ${mem(b, d)}")
                at = x86.Here(mut c)
                x86.MovMemReg(mut c, b, d, a)
                line(mut c, at, "mov qword ptr ${mem(b, d)}, ${regName(a)}")
                at = x86.Here(mut c)
                x86.MovMem8Reg(mut c, b, d, a)
                line(mut c, at, "mov byte ptr ${mem(b, d)}, ${reg8Name(a)}")
                at = x86.Here(mut c)
                x86.MovzxRegMem8(mut c, a, b, d)
                line(mut c, at, "movzx ${regName(a)}, byte ptr ${mem(b, d)}")
            }
        }
        // SIB の load / store（性能投資 第二便 M7）: reg × base × index（rsp を除く）× 倍率 1 / 8 × disp 0 / -8 / 4096
        for b <- iter.Range(0, 16) {
            for ix <- iter.Range(0, 16) {
                if ix != x86.Rsp {
                    for si <- iter.Range(0, 2) {
                        sc := if si == 0 { x86.Scale1 } else { x86.Scale8 }
                        f := if si == 0 { 1 } else { 8 }
                        for k <- iter.Range(0, 3) {
                            d := if k == 0 { 0 } else if k == 1 { -8 } else { 4096 }
                            m := sibMem(b, ix, f, d)
                            at = x86.Here(mut c)
                            x86.MovRegMemSib(mut c, a, b, ix, sc, d)
                            line(mut c, at, "mov ${regName(a)}, qword ptr ${m}")
                            at = x86.Here(mut c)
                            x86.MovMemRegSib(mut c, b, ix, sc, d, a)
                            line(mut c, at, "mov qword ptr ${m}, ${regName(a)}")
                            at = x86.Here(mut c)
                            x86.MovzxRegMem8Sib(mut c, a, b, ix, sc, d)
                            line(mut c, at, "movzx ${regName(a)}, byte ptr ${m}")
                            at = x86.Here(mut c)
                            x86.MovMem8RegSib(mut c, b, ix, sc, d, a)
                            line(mut c, at, "mov byte ptr ${m}, ${reg8Name(a)}")
                        }
                    }
                }
            }
        }
        for k <- iter.Range(0, len(disps)) {
            at = x86.Here(mut c)
            x86.MovMemImm32(mut c, a, disps[k], -5)
            line(mut c, at, "mov qword ptr ${mem(a, disps[k])}, -5")
        }
    }
    // SSE2（第三便のベクトル化スパイク）: xmm × xmm の 6 形・pmovmskb / movq の xmm × 汎用・movdqu の [base + index]・bsf
    for a <- iter.Range(0, 16) {
        for b <- iter.Range(0, 16) {
            mut at := x86.Here(mut c)
            x86.MovdqaXX(mut c, a, b)
            line(mut c, at, "movdqa xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.PcmpeqbXX(mut c, a, b)
            line(mut c, at, "pcmpeqb xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.PcmpgtbXX(mut c, a, b)
            line(mut c, at, "pcmpgtb xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.PxorXX(mut c, a, b)
            line(mut c, at, "pxor xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.PorXX(mut c, a, b)
            line(mut c, at, "por xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.PunpcklqdqXX(mut c, a, b)
            line(mut c, at, "punpcklqdq xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.PmovmskbRX(mut c, a, b)
            line(mut c, at, "pmovmskb ${reg32Name(a)}, xmm${b}")
            at = x86.Here(mut c)
            x86.MovqXR(mut c, a, b)
            line(mut c, at, "movq xmm${a}, ${regName(b)}")
            // float の段: scalar double の xmm × xmm・movq / cvt の xmm × 汎用
            at = x86.Here(mut c)
            x86.MovqRX(mut c, a, b)
            line(mut c, at, "movq ${regName(a)}, xmm${b}")
            at = x86.Here(mut c)
            x86.AddsdXX(mut c, a, b)
            line(mut c, at, "addsd xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.SubsdXX(mut c, a, b)
            line(mut c, at, "subsd xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.MulsdXX(mut c, a, b)
            line(mut c, at, "mulsd xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.DivsdXX(mut c, a, b)
            line(mut c, at, "divsd xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.SqrtsdXX(mut c, a, b)
            line(mut c, at, "sqrtsd xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.UcomisdXX(mut c, a, b)
            line(mut c, at, "ucomisd xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.Cvtsi2sdXR(mut c, a, b)
            line(mut c, at, "cvtsi2sd xmm${a}, ${regName(b)}")
            at = x86.Here(mut c)
            x86.Cvttsd2siRX(mut c, a, b)
            line(mut c, at, "cvttsd2si ${regName(a)}, xmm${b}")
            at = x86.Here(mut c)
            x86.BsfRR(mut c, a, b)
            line(mut c, at, "bsf ${regName(a)}, ${regName(b)}")
            for ix <- iter.Range(0, 16) {
                if ix != x86.Rsp {
                    at = x86.Here(mut c)
                    x86.MovdquXMemSib(mut c, a, b, ix)
                    line(mut c, at, "movdqu xmm${a}, xmmword ptr [${regName(b)}+${regName(ix)}*1]")
                }
            }
        }
    }
    conds := []int{x86.CondE, x86.CondNe, x86.CondL, x86.CondGe, x86.CondLe, x86.CondG, x86.CondB, x86.CondAe, x86.CondA, x86.CondP, x86.CondNp}
    for k <- iter.Range(0, len(conds)) {
        mut at := x86.Here(mut c)
        x86.SetccAl(mut c, conds[k])
        line(mut c, at, "set${condName(conds[k])} al")
        at = x86.Here(mut c)
        x86.SetccCl(mut c, conds[k])
        line(mut c, at, "set${condName(conds[k])} cl")
    }
    mut at0 := x86.Here(mut c)
    x86.AndAlCl(mut c)
    line(mut c, at0, "and al, cl")
    at0 = x86.Here(mut c)
    x86.OrAlCl(mut c)
    line(mut c, at0, "or al, cl")
    mut at := x86.Here(mut c)
    x86.MovzxRaxAl(mut c)
    line(mut c, at, "movzx rax, al")
    at = x86.Here(mut c)
    x86.RepStosq(mut c)
    line(mut c, at, "rep stosq")
    at = x86.Here(mut c)
    x86.Cqo(mut c)
    line(mut c, at, "cqo")
    at = x86.Here(mut c)
    x86.Leave(mut c)
    line(mut c, at, "leave")
    at = x86.Here(mut c)
    x86.Ret(mut c)
    line(mut c, at, "ret")
    at = x86.Here(mut c)
    x86.Syscall(mut c)
    line(mut c, at, "syscall")
    at = x86.Here(mut c)
    x86.Ud2(mut c)
    line(mut c, at, "ud2")
}
