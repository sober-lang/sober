package lexer

import "std/iter"

// 10 進の浮動小数リテラル → IEEE 754 binary64 のビット列（float の段 — language.md 37 節）。
// コンパイラは float の演算を使わない — 正確な値 D × 10^E を多倍長の整数（30 ビットの肢・下位から）で持ち、最近接・偶数への丸めを 1 回だけ掛ける。
// 算法: 値 = N / den（E ≥ 0 なら N = D × 10^E・den = 1、E < 0 なら N = D・den = 10^-E）。q = floor(N × 2^s / den) が [2^52, 2^53) に入る s を求め、
// 余りで丸める（余りの 2 倍と den の比較 — 同点は q を偶数へ）。指数が非正規の域なら s を 1074 に固定して q をそのまま仮数に（q = 2^52 に繰り上がれば
// 最小の正規数のビット列と一致する）。|値| が極端な入力は桁数で先に決める（D × 10^E < 10^-325 は 0・≥ 10^310 は Inf — 多倍長を巨大にしない）

const LIMB = 1073741824 // 2^30

// FloatBits は字句 FloatLiteral（b[s:e] — `数字+ ("." 数字+)? ([eE] [+-]? 数字+)?`）の値のビット列。溢れ（Inf に丸まる）は false
func FloatBits(b []byte, s int, e int) (int, bool) {
    mut ds := mut []int{}
    mut exp10 := 0
    mut i := s
    mut frac := false
    while i < e && (isDigit(int(b[i])) || b[i] == '.') {
        if b[i] == '.' {
            frac = true
        } else {
            // 先頭の 0 は桁に数えない（有効数字だけ）
            if len(ds) > 0 || b[i] != '0' {
                ds = append(ds, int(b[i]) - '0')
            }
            if frac {
                exp10 -= 1
            }
        }
        i += 1
    }
    if i < e {
        // 指数
        i += 1
        mut neg := false
        if b[i] == '+' || b[i] == '-' {
            neg = b[i] == '-'
            i += 1
        }
        mut x := 0
        while i < e {
            if x < 100000000 {
                x = x * 10 + int(b[i]) - '0'
            }
            i += 1
        }
        if neg {
            exp10 = exp10 - x
        } else {
            exp10 = exp10 + x
        }
    }
    return DecimalBits(freeze(ds), exp10)
}

// DecimalBits は 0.d1d2…dn ではなく整数 d1d2…dn × 10^exp10 の正確な値の binary64（ds = 有効数字の列・先頭は 0 でない）。溢れは false
func DecimalBits(ds []int, exp10 int) (int, bool) {
    if len(ds) == 0 {
        return 0, true
    }
    mag := len(ds) + exp10
    if mag < -324 {
        return 0, true
    }
    if mag > 310 {
        return 0, false
    }
    mut n := mut []int{0}
    for k <- iter.Range(0, len(ds)) {
        bnMulAdd(mut n, 10, ds[k])
    }
    mut den := mut []int{1}
    if exp10 >= 0 {
        for k <- iter.Range(0, exp10) {
            bnMulAdd(mut n, 10, 0)
        }
    } else {
        for k <- iter.Range(0, 0 - exp10) {
            bnMulAdd(mut den, 10, 0)
        }
    }
    // q = floor(N × 2^s / den) を [2^52, 2^53) に — s の見積もりは桁のビット長の差から
    mut s := 52 - (bnBitLen(mut n) - bnBitLen(mut den))
    mut q := 0
    mut r := mut []int{}
    mut d2 := mut []int{}
    mut tries := 0
    while tries < 4 {
        q = bnDivScaled(mut n, mut den, s, mut r, mut d2)
        if q < 4503599627370496 {
            s += 1
        } else if q >= 9007199254740992 {
            s -= 1
        } else {
            tries = 4
        }
        tries += 1
    }
    // 2 進の指数（値 ≈ q × 2^-s）。biased = -s + 52 + 1023
    mut biased := 0 - s + 1075
    if biased <= 0 {
        // 非正規: 仮数の位置を 2^-1074 に固定して取り直す
        s = 1074
        q = bnDivScaled(mut n, mut den, s, mut r, mut d2)
        biased = 0
    }
    // 丸め（最近接・偶数）: 余り r と除数 d2 の比較（2r ? d2）
    bnMulAdd(mut r, 2, 0)
    c := bnCmp(mut r, mut d2)
    if c > 0 || (c == 0 && q % 2 == 1) {
        q += 1
    }
    if biased == 0 {
        // 非正規（q = 2^52 なら最小の正規数 — ビット列はそのまま 1 << 52）
        return q, true
    }
    if q == 9007199254740992 {
        q = 4503599627370496
        biased += 1
    }
    if biased >= 2047 {
        return 0, false
    }
    return (biased << 52) | (q - 4503599627370496), true
}

// bnDivScaled は floor(N × 2^s / den)（s < 0 なら floor(N / (den × 2^-s))）。商は 2^54 未満の前提。r に余り・d2 に実際の除数を残す
func bnDivScaled(n mut []int, den mut []int, s int, r mut []int, d2 mut []int) int {
    bnSet(mut r, mut n)
    bnSet(mut d2, mut den)
    if s >= 0 {
        bnShl(mut r, s)
    } else {
        bnShl(mut d2, 0 - s)
    }
    // 2 進の長除法（商 55 ビットまで）
    mut q := 0
    mut sh := mut []int{}
    mut k := 55
    while k >= 0 {
        bnSet(mut sh, mut d2)
        bnShl(mut sh, k)
        if bnCmp(mut r, mut sh) >= 0 {
            bnSub(mut r, mut sh)
            q = q | (1 << k)
        }
        k -= 1
    }
    return q
}

func bnSet(a mut []int, b mut []int) {
    a = mut []int{}
    for k <- iter.Range(0, len(b)) {
        a = append(a, b[k])
    }
}

// bnMulAdd は a = a × m + c（m・c は小さい非負）
func bnMulAdd(a mut []int, m int, c int) {
    mut carry := c
    for k <- iter.Range(0, len(a)) {
        x := a[k] * m + carry
        a[k] = x % LIMB
        carry = x / LIMB
    }
    while carry > 0 {
        a = append(a, carry % LIMB)
        carry = carry / LIMB
    }
}

// bnShl は a = a × 2^n
func bnShl(a mut []int, n int) {
    mut w := n / 30
    bits := n % 30
    if bits > 0 {
        mut carry := 0
        for k <- iter.Range(0, len(a)) {
            x := (a[k] << bits) + carry
            a[k] = x % LIMB
            carry = x / LIMB
        }
        if carry > 0 {
            a = append(a, carry)
        }
    }
    if w > 0 {
        mut z := mut []int{}
        while w > 0 {
            z = append(z, 0)
            w -= 1
        }
        for k <- iter.Range(0, len(a)) {
            z = append(z, a[k])
        }
        a = z
    }
}

// bnTop は最上位の 0 でない肢の位置（0 なら -1）
func bnTop(a mut []int) int {
    mut k := len(a) - 1
    while k >= 0 && a[k] == 0 {
        k -= 1
    }
    return k
}

func bnBitLen(a mut []int) int {
    t := bnTop(mut a)
    if t < 0 {
        return 0
    }
    mut x := a[t]
    mut n := 0
    while x > 0 {
        x = x >> 1
        n += 1
    }
    return t * 30 + n
}

func bnCmp(a mut []int, b mut []int) int {
    ta := bnTop(mut a)
    tb := bnTop(mut b)
    if ta != tb {
        return if ta > tb { 1 } else { -1 }
    }
    mut k := ta
    while k >= 0 {
        if a[k] != b[k] {
            return if a[k] > b[k] { 1 } else { -1 }
        }
        k -= 1
    }
    return 0
}

// bnSub は a = a - b（a ≥ b）
func bnSub(a mut []int, b mut []int) {
    mut borrow := 0
    for k <- iter.Range(0, len(a)) {
        x := a[k] - (if k < len(b) { b[k] } else { 0 }) - borrow
        if x < 0 {
            a[k] = x + LIMB
            borrow = 1
        } else {
            a[k] = x
            borrow = 0
        }
    }
}
