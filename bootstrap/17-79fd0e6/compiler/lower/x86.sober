package lower

// IR → x86_64 機械語 → 静的 ELF（正規バックエンド — legacy/zig/ir_x86.zig・ir_x86_ra.zig・ir_live.zig・ir_cfg.zig の写し。B-1d）。
// 入力は rtlower を通した IR（region op を含まない）。ランタイムは IR の関数としてほかと同じに下ろす。
// 照合 = stage1 が同じ IR テキストから建てた ELF とのバイト一致（elfeq）— 中間成分（区間・置き場）の Zig との照合は無い（src/ 凍結）。
//
// 呼び出し規約（自前 — ABI は揃えない）: 引数は全部スタック（呼び手が後ろから push、callee は [rbp + 16 + 8k]、call の後に呼び手が add rsp, 8n）・
// 戻り値は rax・割り当て可能な 10 本はすべて callee-saved・一時は rax / rcx / rdx / r11（割り当てない）。
// フレーム: push rbp; mov rbp, rsp; sub rsp, F。[rbp - …] に IR スロット（入口で rep stosq のゼロ初期化）→ 退避域 → spill の順。
// 命令選択はオペランドを全部読んでから結果を書く（割り当て器が同じ位置で終わる区間のレジスタを始まる区間へ渡す前提）。
// 到達しないブロックは吐かない。ブロックは後続を後ろから辿る逆後順に並べる。番地は 0x400000 帯の imm32 の絶対値、call / jmp は rel32 — 配置の後で埋める。
//
// IR の読み口（xBlk 等）はこのファイルの先頭に集める — 記録の形（ir.sober の F_* / B_* / I_*）を知るのはここだけ（C7 の Table 化は読み口の中身の差し替えで済む）。
//
// 置き場 Loc は int に詰める: レジスタ r = r × 2 + 1（奇数）、フレームの変位 d = d × 2（偶数）

import "desugar"
import "elf"
import "std/iter"
import "std/table"
import "x86"

// ── IR の読み口 ──

func xFnNParam(st mut St, f FnRef) int { return hget(mut st, irFnPtys(mut st, f)) }
func xSlotNext(st mut St, s int) int { return hget(mut st, s) }
func xSlotWords(st mut St, s int) int { return hget(mut st, s + 1) }
func xParamNext(st mut St, p int) int { return hget(mut st, p) }
func xParamVal(st mut St, p int) int { return hget(mut st, p + 1) }
func xTermX(st mut St, b BlkRef, k int) int { return hget(mut st, int(b) + B_X1 + k - 1) }
func xGlobNext(st mut St, g int) int { return hget(mut st, g + G_NEXT) }
func xGlobWords(st mut St, g int) int { return hget(mut st, g + G_WORDS) }
func xGlobInit(st mut St, g int) int { return hget(mut st, g + G_INIT) }

// 値の列（-1 は空）
func xLen(st mut St, l int) int { return if l < 0 { 0 } else { hget(mut st, l) } }
func xAt(st mut St, l int, k int) int { return hget(mut st, l + 1 + k) }

// xIsEntry は関数の名前が sober_entry か
func xIsEntry(st mut St, f FnRef) bool {
    s := irFnName(mut st, f)
    w := bytes("sober_entry")
    if dat(mut st, s) != len(w) {
        return false
    }
    for i <- iter.Range(0, len(w)) {
        if dat(mut st, s + 1 + i) != int(w[i]) {
            return false
        }
    }
    return true
}

// 命令のオペランド（値）の数と k 番目（ir_live.operands と同じ集合 — region op の分は rtlower の前に掛ける mem2reg が使う）
func xNOps(st mut St, i InsRef) int {
    op := irInsOp(mut st, i)
    return if op == OpScanB { xLen(mut st, irInsA(mut st, i)) } else if op == OpBin || op == OpCmp || op == OpStore || op == OpStore8 || op == OpGepW || op == OpGepB { 2 } else if op == OpLoad || op == OpLoad8 || op == OpPtoi || op == OpItop || op == OpRSetDepth || op == OpRBump { 1 } else if op == OpRAlloc || op == OpRReloc { 2 } else if op == OpCall { xLen(mut st, irInsB(mut st, i)) } else if op == OpCallI { 1 + xLen(mut st, irInsB(mut st, i)) } else if op == OpSyscall { xLen(mut st, irInsA(mut st, i)) } else { 0 }
}

func xOpnd(st mut St, i InsRef, k int) int {
    op := irInsOp(mut st, i)
    return if op == OpScanB { xAt(mut st, irInsA(mut st, i), k) } else if op == OpBin || op == OpCmp { if k == 0 { irInsB(mut st, i) } else { irInsC(mut st, i) } } else if op == OpStore || op == OpStore8 { if k == 0 { irInsA(mut st, i) } else { irInsC(mut st, i) } } else if op == OpGepW || op == OpGepB || op == OpRAlloc { if k == 0 { irInsA(mut st, i) } else { irInsB(mut st, i) } } else if op == OpRReloc { if k == 0 { irInsA(mut st, i) } else { irInsC(mut st, i) } } else if op == OpCall { xAt(mut st, irInsB(mut st, i), k) } else if op == OpCallI { if k == 0 { irInsA(mut st, i) } else { xAt(mut st, irInsB(mut st, i), k - 1) } } else if op == OpSyscall { xAt(mut st, irInsA(mut st, i), k) } else { irInsA(mut st, i) }
}

// 終端のオペランド（条件・戻り値・辺の実引数）
func xNTermOps(st mut St, b BlkRef) int {
    t := irBlkTerm(mut st, b)
    return if t == TmBr { xLen(mut st, xTermX(mut st, b, 2)) } else if t == TmCondbr { 1 + xLen(mut st, xTermX(mut st, b, 3)) + xLen(mut st, xTermX(mut st, b, 5)) } else if t == TmRet { if xTermX(mut st, b, 1) >= 0 { 1 } else { 0 } } else { 0 }
}

func xTermOpnd(st mut St, b BlkRef, k int) int {
    t := irBlkTerm(mut st, b)
    if t == TmBr {
        return xAt(mut st, xTermX(mut st, b, 2), k)
    }
    if t == TmCondbr {
        if k == 0 {
            return xTermX(mut st, b, 1)
        }
        nt := xLen(mut st, xTermX(mut st, b, 3))
        return if k - 1 < nt { xAt(mut st, xTermX(mut st, b, 3), k - 1) } else { xAt(mut st, xTermX(mut st, b, 5), k - 1 - nt) }
    }
    return xTermX(mut st, b, 1)
}

// 後続（br は 1 本、condbr は then・else の 2 本 — 同じ先でも 2 本）: 記録 → 番号
func xNSucc(st mut St, b BlkRef) int {
    t := irBlkTerm(mut st, b)
    return if t == TmBr { 1 } else if t == TmCondbr { 2 } else { 0 }
}

func xSucc(st mut St, b BlkRef, k int) int {
    t := irBlkTerm(mut st, b)
    to := if t == TmBr { irBrTo(mut st, b) } else if k == 0 { irCondThen(mut st, b) } else { irCondElse(mut st, b) }
    return irBlkId(mut st, to)
}

// ── 置き場 ──

func xLocReg(r int) int { return r * 2 + 1 }
func xLocFrame(d int) int { return d * 2 }
func xIsReg(l int) bool { return l & 1 == 1 }
func xLocVal(l int) int { return l >> 1 }

const xNone = -1
const xSpill = 1099511627776 // 割り当て中の「spill の置き場（未定）」の印（偶数 — どの変位とも重ならない）
const xPanic = 101
const xRemat = 17592186044416 // 2^44: 並行コピーの読み元の「作り直す定数」の印の基点（xSrcLoc）

// 割り当て可能なレジスタ（割り当てる順 — syscall の引数に使う rsi / rdi / r8〜r10 は後ろ）
func xAllocReg(k int) int {
    regs := []int{x86.Rbx, x86.R12, x86.R13, x86.R14, x86.R15, x86.Rsi, x86.Rdi, x86.R8, x86.R9, x86.R10}
    return regs[k]
}

const xNAlloc = 10

func xParamDisp(k int) int { return 16 + 8 * k }

// xFill は a に v を n 個積む（作業域の確保 — 1 本ずつ連続に積むので先端一致でコピーしない）
func xFill(a mut []int, n int, v int) {
    for i <- iter.Range(0, n) {
        a = append(a, v)
    }
}

// ── モジュール ──

// 後埋め: 表に 3 語ずつ [位置, 種類, 相手の番号]（種類 0 = call rel32 → 関数・1 = 関数の番地 imm32・2 = global の番地 imm32）。
// struct の表（Table[xFix]）にしないのは、総称の Get の結果の欄読みを check が CoreFragment で拒否するため（F-d の形）
func xFixAdd(fx mut table.Table[int], at int, kind int, id int) {
    table.Push(mut fx, at)
    table.Push(mut fx, kind)
    table.Push(mut fx, id)
}

// xModule は rtlower を通したモジュールの ELF（syms = true なら ELF の代わりに関数の先頭番地の表 — `sober build --emit=syms` の
// プロファイルの口: 1 行 `<16 進の番地> <関数名>`・番地の昇順。Sober の ELF はシンボルを持たないので perf のサンプルをこれで関数へ振る — scripts/prof.ts）
func xModule(st mut St, syms bool) []byte {
    // 関数・global の記録 → 番号（鎖は追加順 = 記録の番地の昇順 — 二分探索で引く）
    mut frecs := mut []int{}
    mut f := st.fhead
    while f != -1 {
        frecs = append(frecs, int(f))
        f = irFnNext(mut st, f)
    }
    nf := len(frecs)
    mut grecs := mut []int{}
    mut g := st.ghead
    while g >= 0 {
        grecs = append(grecs, g)
        g = xGlobNext(mut st, g)
    }
    ng := len(grecs)
    fr := freeze(frecs)
    gr0 := freeze(grecs)
    // global の配置: init ありは rodata、無しは .bss（各 8 × 語数バイト）
    mut goff := mut []int{}
    xFill(mut goff, ng, 0)
    mut gro := mut []int{}
    xFill(mut gro, ng, 0)
    mut rodata := mut []byte{}
    mut bss := 0
    for i <- iter.Range(0, ng) {
        gr := gr0[i]
        init := xGlobInit(mut st, gr)
        words := xGlobWords(mut st, gr)
        if init >= 0 {
            goff[i] = len(rodata)
            gro[i] = 1
            n := xLen(mut st, init)
            for k <- iter.Range(0, words) {
                w := if k < n { xAt(mut st, init, k) } else { 0 }
                for j <- iter.Range(0, 8) {
                    rodata = append(rodata, byte(w >> (8 * j) & 255))
                }
            }
        } else {
            goff[i] = bss
            bss = bss + 8 * words
        }
    }
    mut entry := -1
    for i <- iter.Range(0, nf) {
        if entry < 0 && xIsEntry(mut st, FnRef(fr[i])) {
            entry = i
        }
    }
    if entry < 0 {
        panic(InvariantBroken{})
    }
    mut c := table.Table[byte]{}
    mut fx := table.Table[int]{}
    // _start: mov rax, rsp; and rsp, -16; sub rsp, 8; push rax; call sober_entry; ud2
    x86.MovRegReg(mut c, x86.Rax, x86.Rsp)
    x86.AndRegImm(mut c, x86.Rsp, -16)
    x86.SubRegImm(mut c, x86.Rsp, 8)
    x86.PushReg(mut c, x86.Rax)
    xFixAdd(mut fx, x86.CallRel32(mut c), 0, entry)
    x86.Ud2(mut c)
    mut fstart := mut []int{}
    xFill(mut fstart, nf, 0)
    for i <- iter.Range(0, nf) {
        fstart[i] = x86.Here(mut c)
        // 式ブロックで region を開いて関数ごとの作業域を捨てる（xFunc は mut 引数の関数 = region 透過〔26 節〕なので、包まないと
        // 全関数の作業域がこのループの region に積もる — 自己 build の RSS +145 MB だった。仕上げ便）
        _ = {
            xFunc(mut st, mut c, mut fx, FnRef(fr[i]), fr, gr0)
            0
        }
    }
    lay := elf.LayoutOf(x86.Here(mut c), len(rodata))
    if syms {
        mut out := mut []byte{}
        for i <- iter.Range(0, nf) {
            xHex(mut out, lay.Code + fstart[i])
            out = append(out, ' ')
            printName(mut st, mut out, irFnName(mut st, FnRef(fr[i])))
            out = append(out, '\n')
        }
        return freeze(out)
    }
    for k <- iter.Range(0, table.Len(mut fx) / 3) {
        at := table.Get(mut fx, 3 * k)
        kind := table.Get(mut fx, 3 * k + 1)
        id := table.Get(mut fx, 3 * k + 2)
        if kind == 0 {
            x86.PatchRel32(mut c, at, fstart[id])
        } else if kind == 1 {
            x86.PatchImm32(mut c, at, lay.Code + fstart[id])
        } else {
            x86.PatchImm32(mut c, at, (if gro[id] == 1 { lay.Rodata } else { lay.Bss }) + goff[id])
        }
    }
    return elf.Executable(mut c, freeze(rodata), if bss > 8 { bss } else { 8 })
}

// xIndex は昇順の recs で r の添字
func xIndex(recs []int, r int) int {
    mut lo := 0
    mut hi := len(recs) - 1
    while lo < hi {
        m := (lo + hi) / 2
        if recs[m] < r {
            lo = m + 1
        } else {
            hi = m
        }
    }
    if recs[lo] != r {
        panic(InvariantBroken{})
    }
    return lo
}

// ── 関数 ──

// 関数ごとの作業域（値・ブロックの番号で引く表）
type xF struct {
    f FnRef
    nv int
    np int
    nb int
    blk mut []int        // 番号 → 記録
    order mut []int      // 吐く順（到達するブロックだけ）
    norder int
    bpos mut []int       // ブロックの頭の位置（到達しないブロックは -1）
    ivS mut []int        // 値 → 区間の始まり（無しは -1）
    ivE mut []int
    loc mut []int        // 値 → 置き場
    slotDisp mut []int
    isConst mut []int
    constV mut []int
    saveReg mut []int
    saveDisp mut []int
    nsave int
    blockAt mut []int
    jAt mut []int        // ブロックへの jmp / jcc の rel32（関数の末尾で埋める）
    jTo mut []int
    nj int
    div0 mut []int       // ゼロ除算（exit 101）への jcc
    nd int
    pos int              // 今の命令の位置（syscall の周りで生きている値を引く）
    mvD mut []int        // 並行コピーの作業域
    mvS mut []int
    mvLive mut []int
    // 最適化のバックエンド（性能投資 M4 — st.xcopy = false。写しのバックエンドは opt = false で今までと 1 バイトも変わらない — elfeq / stages の cross が見る）
    opt bool
    fuse mut []int       // 値 → 1 なら比較の結果を値にせず、ブロックの condbr が flags をそのまま読む（比較がブロックの最後の命令・使い道がその condbr だけ）
    fcc int              // 融合した比較の条件コード
    next int             // 吐く順で次のブロックの番号（-1 = 無し）— 次へ落ちる jmp を省く
    // 割り当ての改良（性能投資 M5 — opt のときだけ）: ヒント（辺の実引数 → 仮引数・仮引数 → 入りの実引数 2 本・演算の結果 → 左の被演算子）と spill の重み
    hP mut []int
    hA1 mut []int
    hA2 mut []int
    hOp mut []int
    wt mut []int         // 値の重み（定義・使用ごとに 8^ループの深さ — 深さ 4 で頭打ち）
    remat mut []int      // 1 = imm32 の定数: 区間もレジスタも持たず、使う点で即値から作り直す（M5）
    // gep の番地の融合（第二便 M7）: fold[g] = 1 なら gep g を出さず、使う load / store が [p + ix * 倍率 + 変位]（SIB）で読む。fA / fB / fS = g の p・ix・倍率（8 / 1）
    fold mut []int
    fA mut []int
    fB mut []int
    fS mut []int
}

func xFunc(st mut St, c mut table.Table[byte], fx mut table.Table[int], f FnRef, frecs []int, grecs []int) {
    mut e := xF{f: f, nv: irFnNVal(mut st, f), np: xFnNParam(mut st, f), nb: irFnNBlk(mut st, f), blk: mut []int{}, order: mut []int{}, norder: 0, bpos: mut []int{},
        ivS: mut []int{}, ivE: mut []int{}, loc: mut []int{}, slotDisp: mut []int{}, isConst: mut []int{}, constV: mut []int{}, saveReg: mut []int{}, saveDisp: mut []int{},
        nsave: 0, blockAt: mut []int{}, jAt: mut []int{}, jTo: mut []int{}, nj: 0, div0: mut []int{}, nd: 0, pos: 0, mvD: mut []int{}, mvS: mut []int{}, mvLive: mut []int{},
        opt: !st.xcopy, fuse: mut []int{}, fcc: 0, next: -1, hP: mut []int{}, hA1: mut []int{}, hA2: mut []int{}, hOp: mut []int{}, wt: mut []int{}, remat: mut []int{}, fold: mut []int{}, fA: mut []int{}, fB: mut []int{}, fS: mut []int{}}
    xFill(mut e.blk, e.nb, -1)
    mut b := irFnBHead(mut st, f)
    mut ninst := 0
    mut maxArgs := 7
    while b != -1 {
        e.blk[irBlkId(mut st, b)] = int(b)
        mut np := 0
        mut p := irBlkPHead(mut st, b)
        while p >= 0 {
            np += 1
            p = xParamNext(mut st, p)
        }
        if np > maxArgs {
            maxArgs = np
        }
        mut i := irBlkIHead(mut st, b)
        while i != -1 {
            ninst += 1
            i = irInsNext(mut st, i)
        }
        b = irBlkNext(mut st, b)
    }
    // 定数（div / rem のガード省略）
    xFill(mut e.isConst, e.nv, 0)
    xFill(mut e.constV, e.nv, 0)
    xFill(mut e.remat, e.nv, 0)
    for k <- iter.Range(0, e.nb) {
        mut i := irBlkIHead(mut st, BlkRef(e.blk[k]))
        while i != -1 {
            if irInsOp(mut st, i) == OpConst {
                r := irInsRes(mut st, i)
                e.isConst[r] = 1
                e.constV[r] = irInsA(mut st, i)
                if e.opt && e.constV[r] >= -2147483648 && e.constV[r] <= 2147483647 {
                    e.remat[r] = 1
                }
            }
            i = irInsNext(mut st, i)
        }
    }
    // スロット → フレームの先頭側
    mut slotWords := 0
    mut s := irFnSHead(mut st, f)
    while s >= 0 {
        w := xSlotWords(mut st, s)
        slotWords = slotWords + (if w > 1 { w } else { 1 })
        e.slotDisp = append(e.slotDisp, -8 * slotWords)
        s = xSlotNext(mut st, s)
    }
    xFill(mut e.fold, e.nv, 0)
    xFill(mut e.fA, e.nv, 0)
    xFill(mut e.fB, e.nv, 0)
    xFill(mut e.fS, e.nv, 0)
    if e.opt {
        xFoldScan(mut st, mut e)
    }
    xOrder(mut st, mut e)
    xLive(mut st, mut e)
    if e.opt {
        xHints(mut st, mut e)
    }
    bottom := xAlloc(mut st, mut e, -8 * slotWords)
    frame := (0 - bottom + 15) / 16 * 16
    xFill(mut e.blockAt, e.nb, 0)
    xFill(mut e.jAt, 3 * e.nb, 0)
    xFill(mut e.jTo, 3 * e.nb, 0)
    xFill(mut e.div0, ninst, 0)
    xFill(mut e.mvD, maxArgs, 0)
    xFill(mut e.mvS, maxArgs, 0)
    xFill(mut e.mvLive, maxArgs, 0)
    xFill(mut e.fuse, e.nv, 0)
    if e.opt {
        xFuseScan(mut st, mut e)
    }

    // prologue: フレーム → 使う callee-saved の退避 → スロットのゼロ初期化（rdi / rcx / rax を壊す）→ レジスタに載る引数
    x86.PushReg(mut c, x86.Rbp)
    x86.MovRegReg(mut c, x86.Rbp, x86.Rsp)
    if frame > 0 {
        x86.SubRegImm(mut c, x86.Rsp, frame)
    }
    for k <- iter.Range(0, e.nsave) {
        x86.MovMemReg(mut c, x86.Rbp, e.saveDisp[k], e.saveReg[k])
    }
    if slotWords > 0 {
        x86.LeaRegMem(mut c, x86.Rdi, x86.Rbp, -8 * slotWords)
        x86.MovRegImm32(mut c, x86.Rcx, slotWords)
        x86.XorRegReg(mut c, x86.Rax, x86.Rax)
        x86.RepStosq(mut c)
    }
    for k <- iter.Range(0, e.np) {
        if xIsReg(e.loc[k]) {
            x86.MovRegMem(mut c, xLocVal(e.loc[k]), x86.Rbp, xParamDisp(k))
        }
    }
    for k <- iter.Range(0, e.norder) {
        bi := e.order[k]
        blk := BlkRef(e.blk[bi])
        e.blockAt[bi] = x86.Here(mut c)
        mut i := irBlkIHead(mut st, blk)
        mut n := 0
        while i != -1 {
            e.pos = e.bpos[bi] + 2 * (n + 1)
            xInst(mut st, mut e, mut c, mut fx, i, frecs, grecs)
            n += 1
            i = irInsNext(mut st, i)
        }
        e.next = if k + 1 < e.norder { e.order[k + 1] } else { -1 }
        if e.opt {
            xTermEmitOpt(mut st, mut e, mut c, blk)
        } else {
            xTermEmit(mut st, mut e, mut c, blk)
        }
    }
    if e.nd > 0 {
        at := x86.Here(mut c)
        for k <- iter.Range(0, e.nd) {
            x86.PatchRel32(mut c, e.div0[k], at)
        }
        xExit(mut c, xPanic)
    }
    for k <- iter.Range(0, e.nj) {
        x86.PatchRel32(mut c, e.jAt[k], e.blockAt[e.jTo[k]])
    }
}

// ── 並べる順（ir_live.linearOrder — 後続を後ろから辿る反復 DFS の逆後順）──

func xOrder(st mut St, e mut xF) {
    mut seen := mut []int{}
    xFill(mut seen, e.nb, 0)
    mut post := mut []int{}
    xFill(mut post, e.nb, 0)
    mut stB := mut []int{}
    xFill(mut stB, e.nb, 0)
    mut stN := mut []int{}
    xFill(mut stN, e.nb, 0)
    mut sp := 1
    mut np := 0
    stB[0] = 0
    stN[0] = 0
    seen[0] = 1
    while sp > 0 {
        topB := stB[sp - 1]
        ns := xNSucc(mut st, BlkRef(e.blk[topB]))
        if stN[sp - 1] < ns {
            s := xSucc(mut st, BlkRef(e.blk[topB]), ns - 1 - stN[sp - 1])
            stN[sp - 1] = stN[sp - 1] + 1
            if seen[s] == 0 {
                seen[s] = 1
                stB[sp] = s
                stN[sp] = 0
                sp += 1
            }
        } else {
            post[np] = topB
            np += 1
            sp -= 1
        }
    }
    for k <- iter.Range(0, np) {
        e.order = append(e.order, post[np - 1 - k])
    }
    if e.opt {
        // 冷たいブロック（exit で終わる — panic の点）を末尾へ（M5: 熱いループが連続し、区間が短くなる）。入口は動かさない
        // 1 本の列を 2 周で積む（2 本へ交互に append しない — 運用の地雷）
        mut ord := mut []int{}
        for pass <- iter.Range(0, 2) {
            for k <- iter.Range(0, np) {
                bi := e.order[k]
                cold := k > 0 && irBlkTerm(mut st, BlkRef(e.blk[bi])) == TmExit
                if cold == (pass == 1) {
                    ord = append(ord, bi)
                }
            }
        }
        e.order = ord
    }
    e.norder = np
    xFill(mut e.bpos, e.nb, -1)
    mut pos := 0
    for k <- iter.Range(0, np) {
        bi := e.order[k]
        e.bpos[bi] = pos
        mut n := 0
        mut i := irBlkIHead(mut st, BlkRef(e.blk[bi]))
        while i != -1 {
            n += 1
            i = irInsNext(mut st, i)
        }
        pos = pos + 2 * (n + 2)
    }
}

// ── 生存区間（ir_live.analyze と同じ区間 — 集合の不動点の代わりに、上向きに露出した使用から前任へ辿る（SSA の経路探索）。
// 到達するブロックの live-in / live-out は最小不動点と一致する）──

func xTouch(e mut xF, v int, p int) {
    if e.remat[v] == 1 {
        return
    }
    if e.ivS[v] < 0 {
        e.ivS[v] = p
        e.ivE[v] = p
    } else {
        if p < e.ivS[v] {
            e.ivS[v] = p
        }
        if p > e.ivE[v] {
            e.ivE[v] = p
        }
    }
}

// xBlkEnd は到達するブロック b の終端の位置
func xBlkEnd(st mut St, e mut xF, bi int) int {
    mut n := 0
    mut i := irBlkIHead(mut st, BlkRef(e.blk[bi]))
    while i != -1 {
        n += 1
        i = irInsNext(mut st, i)
    }
    return e.bpos[bi] + 2 * (n + 1)
}

func xLive(st mut St, e mut xF) {
    nv := e.nv
    nb := e.nb
    xFill(mut e.ivS, nv, -1)
    xFill(mut e.ivE, nv, -1)
    // 定義のブロック（関数の引数は入口）
    mut defB := mut []int{}
    xFill(mut defB, nv, -1)
    for v <- iter.Range(0, e.np) {
        defB[v] = 0
    }
    mut bend := mut []int{}
    xFill(mut bend, nb, -1)
    for bi <- iter.Range(0, nb) {
        b := BlkRef(e.blk[bi])
        mut p := irBlkPHead(mut st, b)
        while p >= 0 {
            defB[xParamVal(mut st, p)] = bi
            p = xParamNext(mut st, p)
        }
        mut i := irBlkIHead(mut st, b)
        while i != -1 {
            r := irInsRes(mut st, i)
            if r >= 0 {
                defB[r] = bi
            }
            i = irInsNext(mut st, i)
        }
        if e.bpos[bi] >= 0 {
            bend[bi] = xBlkEnd(mut st, mut e, bi)
        }
    }
    // 前任（到達するものだけ — CSR）
    mut pcnt := mut []int{}
    xFill(mut pcnt, nb + 1, 0)
    for bi <- iter.Range(0, nb) {
        if e.bpos[bi] >= 0 {
            for k <- iter.Range(0, xNSucc(mut st, BlkRef(e.blk[bi]))) {
                s := xSucc(mut st, BlkRef(e.blk[bi]), k)
                pcnt[s + 1] = pcnt[s + 1] + 1
            }
        }
    }
    for bi <- iter.Range(0, nb) {
        pcnt[bi + 1] = pcnt[bi + 1] + pcnt[bi]
    }
    mut preds := mut []int{}
    xFill(mut preds, pcnt[nb], 0)
    mut pfill := mut []int{}
    xFill(mut pfill, nb, 0)
    for bi <- iter.Range(0, nb) {
        if e.bpos[bi] >= 0 {
            for k <- iter.Range(0, xNSucc(mut st, BlkRef(e.blk[bi]))) {
                s := xSucc(mut st, BlkRef(e.blk[bi]), k)
                preds[pcnt[s] + pfill[s]] = bi
                pfill[s] = pfill[s] + 1
            }
        }
    }
    // 上向きに露出した使用 (値, ブロック) — 値ごとの CSR
    mut ucnt := mut []int{}
    xFill(mut ucnt, nv + 1, 0)
    for pass <- iter.Range(0, 2) {
        mut ufill := mut []int{}
        if pass == 1 {
            for v <- iter.Range(0, nv) {
                ucnt[v + 1] = ucnt[v + 1] + ucnt[v]
            }
            xFill(mut ufill, nv, 0)
        }
        mut uses := mut []int{}
        if pass == 1 {
            xFill(mut uses, ucnt[nv], 0)
        }
        for bi <- iter.Range(0, nb) {
            if e.bpos[bi] >= 0 {
                b := BlkRef(e.blk[bi])
                mut i := irBlkIHead(mut st, b)
                while i != -1 {
                    for k <- iter.Range(0, xNOps(mut st, i)) {
                        v0 := xOpnd(mut st, i, k)
                        // 融合した gep の番地は gep の被演算子 p・ix の使用（ブロックを跨いでも経路探索で生存が正しく伸びる — M8）
                        fd := e.fold[v0] == 1
                        for q <- iter.Range(0, if fd { 2 } else { 1 }) {
                            v := if !fd { v0 } else if q == 0 { e.fA[v0] } else { e.fB[v0] }
                            if defB[v] != bi {
                                if pass == 0 {
                                    ucnt[v + 1] = ucnt[v + 1] + 1
                                } else {
                                    uses[ucnt[v] + ufill[v]] = bi
                                    ufill[v] = ufill[v] + 1
                                }
                            }
                        }
                    }
                    i = irInsNext(mut st, i)
                }
                for k <- iter.Range(0, xNTermOps(mut st, b)) {
                    v := xTermOpnd(mut st, b, k)
                    if defB[v] != bi {
                        if pass == 0 {
                            ucnt[v + 1] = ucnt[v + 1] + 1
                        } else {
                            uses[ucnt[v] + ufill[v]] = bi
                            ufill[v] = ufill[v] + 1
                        }
                    }
                }
            }
        }
        if pass == 1 {
            // 値ごとに live-in を前任へ辿る（印 = v + 1）
            mut mark := mut []int{}
            xFill(mut mark, nb, 0)
            mut work := mut []int{}
            xFill(mut work, nb, 0)
            for v <- iter.Range(0, nv) {
                mut nw := 0
                for k <- iter.Range(ucnt[v], ucnt[v + 1]) {
                    bi := uses[k]
                    if mark[bi] != v + 1 {
                        mark[bi] = v + 1
                        xTouch(mut e, v, e.bpos[bi])
                        work[nw] = bi
                        nw += 1
                    }
                }
                while nw > 0 {
                    nw -= 1
                    bi := work[nw]
                    for k <- iter.Range(pcnt[bi], pcnt[bi + 1]) {
                        pb := preds[k]
                        xTouch(mut e, v, bend[pb])
                        if defB[v] != pb && mark[pb] != v + 1 {
                            mark[pb] = v + 1
                            xTouch(mut e, v, e.bpos[pb])
                            work[nw] = pb
                            nw += 1
                        }
                    }
                }
            }
        }
    }
    // 定義・使用の位置（opt は重みも — ブロックのループの深さで 8 倍ずつ）
    mut dep := mut []int{}
    if e.opt {
        xFill(mut e.wt, nv, 0)
        dep = xLoopDepth(mut st, mut e)
    }
    for k <- iter.Range(0, e.norder) {
        bi := e.order[k]
        b := BlkRef(e.blk[bi])
        bs := e.bpos[bi]
        be := bend[bi]
        if e.opt {
            xWeigh(mut st, mut e, b, dep[k])
        }
        if bi == 0 {
            for v <- iter.Range(0, e.np) {
                xTouch(mut e, v, bs)
            }
        }
        mut p := irBlkPHead(mut st, b)
        while p >= 0 {
            xTouch(mut e, xParamVal(mut st, p), bs)
            if e.opt {
                // 使われない仮引数でも入口の 1 点を越えて生かす（同じ入口で始まる値に置き場を譲らない — 辺の並行コピーが書く先）
                xTouch(mut e, xParamVal(mut st, p), bs + 1)
            }
            p = xParamNext(mut st, p)
        }
        mut i := irBlkIHead(mut st, b)
        mut n := 0
        while i != -1 {
            ip := bs + 2 * (n + 1)
            for j <- iter.Range(0, xNOps(mut st, i)) {
                v := xOpnd(mut st, i, j)
                if e.fold[v] == 1 {
                    // 融合した gep の番地: gep の被演算子がこの load / store の点まで生きる（gep 自身は区間を持たない — M7）
                    xTouch(mut e, e.fA[v], ip)
                    xTouch(mut e, e.fB[v], ip)
                } else {
                    xTouch(mut e, v, ip)
                }
            }
            r := irInsRes(mut st, i)
            if r >= 0 && e.fold[r] == 0 {
                xTouch(mut e, r, ip)
            }
            n += 1
            i = irInsNext(mut st, i)
        }
        for j <- iter.Range(0, xNTermOps(mut st, b)) {
            xTouch(mut e, xTermOpnd(mut st, b, j), be)
        }
        // 辺の並行コピーは前任の終端で後続の仮引数の置き場へ書く — 仮引数はそこでも生きている。
        // 最適化のバックエンド（M5）は数えない: 辺のコピーは分岐の後のその辺の経路だけで書き、そこで生きている値は後続の入口でも生きている
        // （後続の仮引数と区間が重なる）ので、仮引数の置き場を壊さない。実引数と仮引数が同じ置き場を取れる（ループの合流の mov が消える）
        for j <- iter.Range(0, if e.opt { 0 } else { xNSucc(mut st, b) }) {
            mut q := irBlkPHead(mut st, BlkRef(e.blk[xSucc(mut st, b, j)]))
            while q >= 0 {
                xTouch(mut e, xParamVal(mut st, q), be)
                q = xParamNext(mut st, q)
            }
        }
    }
}

// xLoopDepth は吐く順の k 番目のブロックのループの深さ（M5 — spill の重み用・第三便 M16 で自然ループに）: 頭 h ごとに、h へ戻る辺 t → h
// （t が順で h 以降 — 後ろの辺）の末尾 t から頭を越えずに前任を逆に辿れるブロックを h のループの体とし、体のブロックを 1 段深くする。
// 以前は「吐く順の [h, t] の区間を 1 段深く」の近似で、区間に混ざる出口のブロック（panic の点・append の成長の経路・ループの後ろの直線）まで深く
// 数え、熱いループの運搬値より冷えた経路の一時値が重く見えて、運搬値が spill された（revcomp — report-208）
func xLoopDepth(st mut St, e mut xF) mut []int {
    n := e.norder
    mut d := mut []int{}
    xFill(mut d, n + 1, 0)
    // 順の位置 ← ブロックの番号
    mut kOf := mut []int{}
    xFill(mut kOf, e.nb, -1)
    for k <- iter.Range(0, n) {
        kOf[e.order[k]] = k
    }
    // 前任の表（順の位置で — 詰めた列 + 先頭の添字）
    mut pc := mut []int{}
    xFill(mut pc, n + 1, 0)
    for k <- iter.Range(0, n) {
        b := BlkRef(e.blk[e.order[k]])
        for j <- iter.Range(0, xNSucc(mut st, b)) {
            ks := kOf[xSucc(mut st, b, j)]
            if ks >= 0 {
                pc[ks + 1] = pc[ks + 1] + 1
            }
        }
    }
    for k <- iter.Range(0, n) {
        pc[k + 1] = pc[k + 1] + pc[k]
    }
    mut fill := mut []int{}
    xFill(mut fill, n, 0)
    for k <- iter.Range(0, n) {
        fill[k] = pc[k]
    }
    mut pl := mut []int{}
    xFill(mut pl, pc[n] + 1, 0)
    for k <- iter.Range(0, n) {
        b := BlkRef(e.blk[e.order[k]])
        for j <- iter.Range(0, xNSucc(mut st, b)) {
            ks := kOf[xSucc(mut st, b, j)]
            if ks >= 0 {
                pl[fill[ks]] = k
                fill[ks] = fill[ks] + 1
            }
        }
    }
    // 頭ごとに体を印（印 = 頭の位置 + 1 — 頭ごとに一意）
    mut mark := mut []int{}
    xFill(mut mark, n, 0)
    mut stack := mut []int{}
    xFill(mut stack, n + 1, 0)
    for h <- iter.Range(0, n) {
        mut started := false
        for q <- iter.Range(pc[h], pc[h + 1]) {
            t := pl[q]
            if t >= h {
                if !started {
                    started = true
                    mark[h] = h + 1
                    d[h] = d[h] + 1
                }
                mut sp := 0
                if mark[t] != h + 1 {
                    mark[t] = h + 1
                    d[t] = d[t] + 1
                    stack[sp] = t
                    sp += 1
                }
                while sp > 0 {
                    sp -= 1
                    x := stack[sp]
                    for r <- iter.Range(pc[x], pc[x + 1]) {
                        p := pl[r]
                        if mark[p] != h + 1 {
                            mark[p] = h + 1
                            d[p] = d[p] + 1
                            stack[sp] = p
                            sp += 1
                        }
                    }
                }
            }
        }
    }
    return d
}

// xWeigh はブロック b の定義・使用を深さ dp の重みで数える
func xWeigh(st mut St, e mut xF, b BlkRef, dp int) {
    w := if dp <= 0 { 1 } else if dp == 1 { 8 } else if dp == 2 { 64 } else if dp == 3 { 512 } else { 4096 }
    mut p := irBlkPHead(mut st, b)
    while p >= 0 {
        v := xParamVal(mut st, p)
        e.wt[v] = e.wt[v] + w
        p = xParamNext(mut st, p)
    }
    mut i := irBlkIHead(mut st, b)
    while i != -1 {
        for j <- iter.Range(0, xNOps(mut st, i)) {
            v := xOpnd(mut st, i, j)
            e.wt[v] = e.wt[v] + w
        }
        r := irInsRes(mut st, i)
        if r >= 0 {
            e.wt[r] = e.wt[r] + w
        }
        i = irInsNext(mut st, i)
    }
    for j <- iter.Range(0, xNTermOps(mut st, b)) {
        v := xTermOpnd(mut st, b, j)
        e.wt[v] = e.wt[v] + w
    }
}

// xSpillCost は spill の費用（M5）: 重み ÷ 区間の長さ（長く生きて使われの疎な値ほど安い）。長さは 256 で頭打ち — 区間を割らない linear scan では、
// 関数の端から端まで生きてループの中で使われる値（slice の len・base）が長さで割ると安く見えて落とされる（M6 で関数が膨らむと fannkuch の
// 内側のループの len が spill された）。頭打ちなしの重みだけ（ループの中の短い一時値が落ちる）・64 / 1024 も試した（同じ結果）
func xSpillCost(e mut xF, v int) int {
    n := e.ivE[v] - e.ivS[v] + 2
    return e.wt[v] * 4096 / (if n > 256 { 256 } else { n })
}

// xPrioAlloc は区間を spill の費用（重み — ループの深さで 8 倍ずつ）の高い順に彩色する（第二便 M8）: レジスタごとに割り当て済みの区間の鎖を持ち、
// 重ならないレジスタに置く（ヒントのレジスタを先に試す）。置けなければ spill。linear scan は「その時点の active の中で最安を落とす」局所の選び方で、
// 内側のループで重く使う長命の値（slice の base）を短い一時値より先に落としていた（report-201）。重なり = s < e' かつ s' < e（end ≤ start は共有可 — linear scan と同じ）。
// spill した値の数を返す（spills の先頭に積む）
func xPrioAlloc(e mut xF, ivs mut []int, nivs int, used mut []int, spills mut []int) int {
    xPrioSort(mut e, mut ivs, nivs)
    mut head := mut []int{}
    xFill(mut head, 16, -1)
    mut nxt := mut []int{}
    xFill(mut nxt, e.nv, -1)
    mut free := mut []int{}
    xFill(mut free, 16, 0)
    mut nsp := 0
    for k <- iter.Range(0, nivs) {
        v := ivs[k]
        // 空きの判定は「重ならない」— xHintReg の free の口をこの値の区間で作る
        for j <- iter.Range(0, xNAlloc) {
            r := xAllocReg(j)
            free[r] = if xPrioFits(mut e, mut head, mut nxt, r, v) { 1 } else { 0 }
        }
        mut r := xHintReg(mut e, v, mut free)
        for j <- iter.Range(0, xNAlloc) {
            if r < 0 && free[xAllocReg(j)] == 1 {
                r = xAllocReg(j)
            }
        }
        if r >= 0 {
            e.loc[v] = xLocReg(r)
            used[r] = 1
            nxt[v] = head[r]
            head[r] = v
        } else {
            spills[nsp] = v
            nsp += 1
        }
    }
    return nsp
}

// xPrioFits はレジスタ r に割り当て済みの区間のどれとも v が重ならないか
func xPrioFits(e mut xF, head mut []int, nxt mut []int, r int, v int) bool {
    s := e.ivS[v]
    t := e.ivE[v]
    mut w := head[r]
    while w >= 0 {
        if s < e.ivE[w] && e.ivS[w] < t {
            return false
        }
        // 点の区間どうし・同じ点で始まる区間（使われない仮引数の入口など）も重なりとみなす
        if s == e.ivS[w] {
            return false
        }
        w = nxt[w]
    }
    return true
}

// xPrioSort は ivs の先頭 n 個を費用の高い順に（同点は区間の長い順・値の番号の小さい順 — 決定的）並べる（下からの併合ソート）
func xPrioSort(e mut xF, a mut []int, n int) {
    mut tmp := mut []int{}
    xFill(mut tmp, n, 0)
    mut w := 1
    while w < n {
        mut lo := 0
        while lo < n {
            mid := if lo + w < n { lo + w } else { n }
            hi := if lo + 2 * w < n { lo + 2 * w } else { n }
            mut i := lo
            mut j := mid
            mut k := lo
            while k < hi {
                takeLeft := j >= hi || (i < mid && !xPrioBefore(mut e, a[j], a[i]))
                if takeLeft {
                    tmp[k] = a[i]
                    i += 1
                } else {
                    tmp[k] = a[j]
                    j += 1
                }
                k += 1
            }
            lo = hi
        }
        for k <- iter.Range(0, n) {
            a[k] = tmp[k]
        }
        w = w * 2
    }
}

// xPrioBefore は x が y より先に彩色されるか
func xPrioBefore(e mut xF, x int, y int) bool {
    if e.wt[x] != e.wt[y] {
        return e.wt[x] > e.wt[y]
    }
    lx := e.ivE[x] - e.ivS[x]
    ly := e.ivE[y] - e.ivS[y]
    if lx != ly {
        return lx > ly
    }
    return x < y
}

// ── 割り当て（ir_x86_ra.allocate の linear scan）。フレームの最も低い変位を返す ──

func xAlloc(st mut St, e mut xF, frameTop int) int {
    nv := e.nv
    xFill(mut e.loc, nv, xSpill)
    // 区間を持つ値を (start, 番号) の順に（数え上げの安定な並べ替え）
    mut maxp := 0
    for v <- iter.Range(0, nv) {
        if e.ivS[v] >= 0 && e.ivS[v] > maxp {
            maxp = e.ivS[v]
        }
    }
    mut cnt := mut []int{}
    xFill(mut cnt, maxp + 2, 0)
    mut nivs := 0
    for v <- iter.Range(0, nv) {
        if e.ivS[v] >= 0 {
            cnt[e.ivS[v] + 1] = cnt[e.ivS[v] + 1] + 1
            nivs += 1
        }
    }
    for k <- iter.Range(0, maxp + 1) {
        cnt[k + 1] = cnt[k + 1] + cnt[k]
    }
    mut ivs := mut []int{}
    xFill(mut ivs, nivs, 0)
    for v <- iter.Range(0, nv) {
        if e.ivS[v] >= 0 {
            ivs[cnt[e.ivS[v]]] = v
            cnt[e.ivS[v]] = cnt[e.ivS[v]] + 1
        }
    }
    // 空き（割り当て順の添字）・使った・生きている区間
    mut free := mut []int{}
    xFill(mut free, 16, 0)
    for k <- iter.Range(0, xNAlloc) {
        free[xAllocReg(k)] = 1
    }
    mut used := mut []int{}
    xFill(mut used, 16, 0)
    mut active := mut []int{}
    xFill(mut active, xNAlloc + 1, 0)
    mut na := 0
    mut spills := mut []int{}
    xFill(mut spills, nivs, 0)
    mut nsp := 0
    if e.opt {
        // 最適化のバックエンド: 費用の高い順の彩色（第二便 M8 — xPrioAlloc）
        nsp = xPrioAlloc(mut e, mut ivs, nivs, mut used, mut spills)
    }
    for k <- iter.Range(0, if e.opt { 0 } else { nivs }) {
        v := ivs[k]
        cs := e.ivS[v]
        // 終わった区間のレジスタを返す（end ≤ start — 同じ位置の受け渡しを許す。swapRemove と同じ並びの変化）
        mut i := 0
        while i < na {
            w := active[i]
            if e.ivE[w] <= cs {
                free[xLocVal(e.loc[w])] = 1
                active[i] = active[na - 1]
                na -= 1
            } else {
                i += 1
            }
        }
        mut r := if e.opt { xHintReg(mut e, v, mut free) } else { -1 }
        for j <- iter.Range(0, xNAlloc) {
            if r < 0 && free[xAllocReg(j)] == 1 {
                r = xAllocReg(j)
            }
        }
        if r >= 0 {
            free[r] = 0
            used[r] = 1
            e.loc[v] = xLocReg(r)
            active[na] = v
            na += 1
        } else {
            // 空きが無い: end がいちばん遠い区間を落とす（同点は値の番号の大きい方）。opt は spill の費用の最も安い区間（同点は end の遠い方）
            mut far := v
            for j <- iter.Range(0, na) {
                w := active[j]
                if e.opt {
                    cw := xSpillCost(mut e, w)
                    cf := xSpillCost(mut e, far)
                    if cw < cf || (cw == cf && e.ivE[w] > e.ivE[far]) {
                        far = w
                    }
                } else if e.ivE[w] > e.ivE[far] || (e.ivE[w] == e.ivE[far] && w > far) {
                    far = w
                }
            }
            if far == v {
                e.loc[v] = xSpill
                spills[nsp] = v
                nsp += 1
            } else {
                e.loc[v] = e.loc[far]
                e.loc[far] = xSpill
                spills[nsp] = far
                nsp += 1
                for j <- iter.Range(0, na) {
                    if active[j] == far {
                        active[j] = v
                    }
                }
            }
        }
    }
    // 割り当てに使わなくても壊すレジスタも退避する: スロットのゼロ初期化の rdi と syscall の引数レジスタ（rdx は割り当てない）
    if irFnSHead(mut st, e.f) >= 0 {
        used[x86.Rdi] = 1
    }
    sysRegs := []int{x86.Rdi, x86.Rsi, x86.Rdx, x86.R10, x86.R8, x86.R9}
    for bi <- iter.Range(0, e.nb) {
        mut i := irBlkIHead(mut st, BlkRef(e.blk[bi]))
        while i != -1 {
            if irInsOp(mut st, i) == OpSyscall {
                for k <- iter.Range(0, xLen(mut st, irInsA(mut st, i)) - 1) {
                    if sysRegs[k] != x86.Rdx {
                        used[sysRegs[k]] = 1
                    }
                }
            }
            i = irInsNext(mut st, i)
        }
    }
    // フレーム: [frameTop) の下に退避域、その下に spill
    mut d := frameTop
    for k <- iter.Range(0, xNAlloc) {
        r := xAllocReg(k)
        if used[r] == 1 {
            d = d - 8
            e.saveReg = append(e.saveReg, r)
            e.saveDisp = append(e.saveDisp, d)
            e.nsave = e.nsave + 1
        }
    }
    for k <- iter.Range(0, nsp) {
        v := spills[k]
        if v < e.np {
            e.loc[v] = xLocFrame(xParamDisp(v))
        } else {
            d = d - 8
            e.loc[v] = xLocFrame(d)
        }
    }
    // 区間を持たない値（到達しないブロックでだけ定義）は使われない — 番地は有効にしておく
    for v <- iter.Range(0, nv) {
        if e.loc[v] == xSpill {
            e.loc[v] = if v < e.np { xLocFrame(xParamDisp(v)) } else { xLocFrame(frameTop - 8) }
        }
    }
    return if d < frameTop - 8 { d } else { frameTop - 8 }
}

// ── 値の出し入れ（置き場を問わない）──

// xGet は v をレジスタに載せる（置き場がレジスタならそれ、フレームなら scratch に読む）
func xGet(e mut xF, c mut table.Table[byte], v int, scratch int) int {
    if e.remat[v] == 1 {
        x86.MovRegImm32(mut c, scratch, e.constV[v])
        return scratch
    }
    l := e.loc[v]
    if xIsReg(l) {
        return xLocVal(l)
    }
    x86.MovRegMem(mut c, scratch, x86.Rbp, xLocVal(l))
    return scratch
}

// xGetInto は v を dst へ
func xGetInto(e mut xF, c mut table.Table[byte], v int, dst int) {
    if e.remat[v] == 1 {
        x86.MovRegImm32(mut c, dst, e.constV[v])
        return
    }
    l := e.loc[v]
    if xIsReg(l) {
        if xLocVal(l) != dst {
            x86.MovRegReg(mut c, dst, xLocVal(l))
        }
    } else {
        x86.MovRegMem(mut c, dst, x86.Rbp, xLocVal(l))
    }
}

// xPut は src にある結果を v の置き場へ
func xPut(e mut xF, c mut table.Table[byte], v int, src int) {
    l := e.loc[v]
    if xIsReg(l) {
        if xLocVal(l) != src {
            x86.MovRegReg(mut c, xLocVal(l), src)
        }
    } else {
        x86.MovMemReg(mut c, x86.Rbp, xLocVal(l), src)
    }
}

func xCond(op int) int {
    return if op == CEq { x86.CondE } else if op == CNe { x86.CondNe } else if op == CLt { x86.CondL } else if op == CLe { x86.CondLe } else if op == CGt { x86.CondG } else if op == CGe { x86.CondGe } else if op == CUlt { x86.CondB } else { x86.CondAe }
}

func xInst(st mut St, e mut xF, c mut table.Table[byte], fx mut table.Table[int], i InsRef, frecs []int, grecs []int) {
    op := irInsOp(mut st, i)
    res := irInsRes(mut st, i)
    a := irInsA(mut st, i)
    b := irInsB(mut st, i)
    cc := irInsC(mut st, i)
    if op == OpConst && e.remat[res] == 1 {
        // 使う点で作り直す（M5）
    } else if op == OpConst {
        if a >= -2147483648 && a <= 2147483647 {
            l := e.loc[res]
            if xIsReg(l) {
                x86.MovRegImm32(mut c, xLocVal(l), a)
            } else {
                x86.MovMemImm32(mut c, x86.Rbp, xLocVal(l), a)
            }
        } else {
            x86.MovRegImm64(mut c, x86.Rax, a)
            xPut(mut e, mut c, res, x86.Rax)
        }
    } else if op == OpBin && a >= BFAdd {
        xFloatBin(mut e, mut c, res, a, b, cc)
    } else if op == OpCmp && a >= CFEq {
        xFloatCmp(mut e, mut c, res, a, b, cc)
    } else if op == OpBin {
        if a == BDiv || a == BRem {
            xDivRem(mut e, mut c, res, a, b, cc)
        } else if a == BShl || a == BSar {
            xGetInto(mut e, mut c, b, x86.Rax)
            xGetInto(mut e, mut c, cc, x86.Rcx)
            if a == BShl {
                x86.ShlRegCl(mut c, x86.Rax)
            } else {
                x86.SarRegCl(mut c, x86.Rax)
            }
            xPut(mut e, mut c, res, x86.Rax)
        } else if e.opt && xDirectBin(mut e, mut c, res, a, b, cc) {
            // 結果のレジスタへ直に（rax を経由しない — 最適化のバックエンド）
        } else {
            xGetInto(mut e, mut c, b, x86.Rax)
            y := xGet(mut e, mut c, cc, x86.Rcx)
            if a == BAdd {
                x86.AddRegReg(mut c, x86.Rax, y)
            } else if a == BSub {
                x86.SubRegReg(mut c, x86.Rax, y)
            } else if a == BMul {
                x86.ImulRegReg(mut c, x86.Rax, y)
            } else if a == BAnd {
                x86.AndRegReg(mut c, x86.Rax, y)
            } else if a == BOr {
                x86.OrRegReg(mut c, x86.Rax, y)
            } else {
                x86.XorRegReg(mut c, x86.Rax, y)
            }
            xPut(mut e, mut c, res, x86.Rax)
        }
    } else if op == OpCmp && e.opt {
        x := xGet(mut e, mut c, b, x86.Rax)
        if e.isConst[cc] == 1 && e.constV[cc] >= -2147483648 && e.constV[cc] <= 2147483647 {
            x86.CmpRegImm(mut c, x, e.constV[cc])
        } else {
            y := xGet(mut e, mut c, cc, x86.Rcx)
            x86.CmpRegReg(mut c, x, y)
        }
        if e.fuse[res] == 1 {
            e.fcc = xCond(a)
        } else {
            x86.SetccAl(mut c, xCond(a))
            x86.MovzxRaxAl(mut c)
            xPut(mut e, mut c, res, x86.Rax)
        }
    } else if op == OpCmp {
        x := xGet(mut e, mut c, b, x86.Rax)
        y := xGet(mut e, mut c, cc, x86.Rcx)
        x86.CmpRegReg(mut c, x, y)
        x86.SetccAl(mut c, xCond(a))
        x86.MovzxRaxAl(mut c)
        xPut(mut e, mut c, res, x86.Rax)
    } else if (op == OpGepW || op == OpGepB) && e.fold[res] == 1 {
        // 使う load / store が番地を組む（M7）
    } else if (op == OpLoad || op == OpLoad8) && e.fold[a] == 1 {
        d := if xIsReg(e.loc[res]) { xLocVal(e.loc[res]) } else { x86.Rax }
        xMemSib(mut e, mut c, a, if op == OpLoad { 8 * b } else { b }, d, op == OpLoad8, true)
        xPut(mut e, mut c, res, d)
    } else if (op == OpStore || op == OpStore8) && e.fold[a] == 1 {
        v := xGet(mut e, mut c, cc, x86.Rdx)
        xMemSib(mut e, mut c, a, if op == OpStore { 8 * b } else { b }, v, op == OpStore8, false)
    } else if op == OpLoad && e.opt && xIsReg(e.loc[res]) {
        p := xGet(mut e, mut c, a, x86.Rax)
        x86.MovRegMem(mut c, xLocVal(e.loc[res]), p, 8 * b)
    } else if op == OpLoad {
        p := xGet(mut e, mut c, a, x86.Rax)
        x86.MovRegMem(mut c, x86.Rax, p, 8 * b)
        xPut(mut e, mut c, res, x86.Rax)
    } else if op == OpStore {
        p := xGet(mut e, mut c, a, x86.Rax)
        v := xGet(mut e, mut c, cc, x86.Rcx)
        x86.MovMemReg(mut c, p, 8 * b, v)
    } else if op == OpLoad8 {
        p := xGet(mut e, mut c, a, x86.Rax)
        x86.MovzxRegMem8(mut c, x86.Rax, p, b)
        xPut(mut e, mut c, res, x86.Rax)
    } else if op == OpStore8 {
        p := xGet(mut e, mut c, a, x86.Rax)
        v := xGet(mut e, mut c, cc, x86.Rcx)
        x86.MovMem8Reg(mut c, p, b, v)
    } else if (op == OpGepW || op == OpGepB) && e.opt && xIsReg(e.loc[res]) {
        p := xGet(mut e, mut c, a, x86.Rax)
        ix := xGet(mut e, mut c, b, x86.Rcx)
        x86.LeaRegSib(mut c, xLocVal(e.loc[res]), p, ix, if op == OpGepW { x86.Scale8 } else { x86.Scale1 })
    } else if op == OpGepW || op == OpGepB {
        p := xGet(mut e, mut c, a, x86.Rax)
        ix := xGet(mut e, mut c, b, x86.Rcx)
        x86.LeaRegSib(mut c, x86.Rax, p, ix, if op == OpGepW { x86.Scale8 } else { x86.Scale1 })
        xPut(mut e, mut c, res, x86.Rax)
    } else if op == OpPtoi || op == OpItop {
        x := xGet(mut e, mut c, a, x86.Rax)
        xPut(mut e, mut c, res, x)
    } else if op == OpSlotaddr {
        x86.LeaRegMem(mut c, x86.Rax, x86.Rbp, e.slotDisp[a])
        xPut(mut e, mut c, res, x86.Rax)
    } else if op == OpGlobal {
        xAbs(mut e, mut c, mut fx, res, 2, xIndex(grecs, a))
    } else if op == OpFuncaddr {
        xAbs(mut e, mut c, mut fx, res, 1, xIndex(frecs, a))
    } else if op == OpCall {
        xPushArgs(mut st, mut e, mut c, b, -1)
        xFixAdd(mut fx, x86.CallRel32(mut c), 0, xIndex(frecs, a))
        xAfterCall(mut e, mut c, res, xLen(mut st, b))
    } else if op == OpCallI {
        xPushArgs(mut st, mut e, mut c, b, -1)
        xGetInto(mut e, mut c, a, x86.R11)
        x86.CallReg(mut c, x86.R11)
        xAfterCall(mut e, mut c, res, xLen(mut st, b))
    } else if op == OpSyscall {
        xSyscall(mut st, mut e, mut c, res, a)
    } else if op == OpScanB {
        xScanB(mut st, mut e, mut c, res, a, b)
    } else {
        // region op は rtlower の後には無い
        panic(Unreachable{})
    }
}

// xAbs は番地の imm32（配置の後で埋める）
func xAbs(e mut xF, c mut table.Table[byte], fx mut table.Table[int], r int, kind int, id int) {
    l := e.loc[r]
    if xIsReg(l) {
        x86.MovRegImm32(mut c, xLocVal(l), 0)
    } else {
        x86.MovMemImm32(mut c, x86.Rbp, xLocVal(l), 0)
    }
    xFixAdd(mut fx, x86.Here(mut c) - 4, kind, id)
}

func xPushArgs(st mut St, e mut xF, c mut table.Table[byte], args int, unused int) {
    mut k := xLen(mut st, args)
    while k > 0 {
        k -= 1
        x := xGet(mut e, mut c, xAt(mut st, args, k), x86.Rax)
        x86.PushReg(mut c, x)
    }
}

func xAfterCall(e mut xF, c mut table.Table[byte], res int, nargs int) {
    if nargs > 0 {
        x86.AddRegImm(mut c, x86.Rsp, 8 * nargs)
    }
    if res >= 0 {
        xPut(mut e, mut c, res, x86.Rax)
    }
}

// xDivRem は div / rem（IR の全域の意味: b == 0 → exit 101、b == -1 → div は 0 - a・rem は 0、それ以外は idiv）
// xPow2 は n が 2^k（1 ≤ k ≤ 31）なら k、それ以外は 0（第二便 M10）
func xPow2(n int) int {
    mut k := 1
    while k <= 31 {
        if n == 1 << k {
            return k
        }
        k += 1
    }
    return 0
}

// xDivPow2 は 2^k での div / rem（IR の意味 = 0 への切り捨て — idiv と同じ）をシフト列で: bias = (x >> 63) & (2^k - 1)。
// div = (x + bias) >> k（算術）・rem = x - ((x + bias) & -2^k)。b は正の定数なのでゼロ除算・-1 の場合分けは無い（第二便 M10 — table.Get の chunk の番号）
func xDivPow2(e mut xF, c mut table.Table[byte], r int, op int, a int, k int) {
    xGetInto(mut e, mut c, a, x86.Rax)
    x86.MovRegReg(mut c, x86.Rdx, x86.Rax)
    x86.SarRegImm(mut c, x86.Rdx, 63)
    x86.AndRegImm(mut c, x86.Rdx, (1 << k) - 1)
    if op == BDiv {
        x86.AddRegReg(mut c, x86.Rax, x86.Rdx)
        x86.SarRegImm(mut c, x86.Rax, k)
    } else {
        x86.AddRegReg(mut c, x86.Rdx, x86.Rax)
        x86.AndRegImm(mut c, x86.Rdx, 0 - (1 << k))
        x86.SubRegReg(mut c, x86.Rax, x86.Rdx)
    }
    xPut(mut e, mut c, r, x86.Rax)
}

func xDivRem(e mut xF, c mut table.Table[byte], r int, op int, a int, b int) {
    if e.opt && e.isConst[b] == 1 && xPow2(e.constV[b]) > 0 {
        xDivPow2(mut e, mut c, r, op, a, xPow2(e.constV[b]))
        return
    }
    xGetInto(mut e, mut c, a, x86.Rax)
    xGetInto(mut e, mut c, b, x86.Rcx)
    known := e.isConst[b] == 1
    kb := e.constV[b]
    mut done := -1
    if !known || kb == 0 {
        x86.CmpRegImm(mut c, x86.Rcx, 0)
        e.div0[e.nd] = x86.JccRel32(mut c, x86.CondE)
        e.nd = e.nd + 1
    }
    if !known || kb == -1 {
        x86.CmpRegImm(mut c, x86.Rcx, -1)
        normal := x86.JccRel32(mut c, x86.CondNe)
        if op == BDiv {
            x86.NegReg(mut c, x86.Rax)
        } else {
            x86.XorRegReg(mut c, x86.Rax, x86.Rax)
        }
        done = x86.JmpRel32(mut c)
        x86.PatchRel32(mut c, normal, x86.Here(mut c))
    }
    x86.Cqo(mut c)
    x86.IdivReg(mut c, x86.Rcx)
    if op == BRem {
        x86.MovRegReg(mut c, x86.Rax, x86.Rdx)
    }
    if done >= 0 {
        x86.PatchRel32(mut c, done, x86.Here(mut c))
    }
    xPut(mut e, mut c, r, x86.Rax)
}

func xTermEmit(st mut St, e mut xF, c mut table.Table[byte], b BlkRef) {
    t := irBlkTerm(mut st, b)
    if t == TmBr {
        xJumpEdge(mut st, mut e, mut c, irBrTo(mut st, b), xTermX(mut st, b, 2))
    } else if t == TmCondbr {
        x := xGet(mut e, mut c, xTermX(mut st, b, 1), x86.Rax)
        x86.CmpRegImm(mut c, x, 0)
        toElse := x86.JccRel32(mut c, x86.CondE)
        xJumpEdge(mut st, mut e, mut c, irCondThen(mut st, b), xTermX(mut st, b, 3))
        x86.PatchRel32(mut c, toElse, x86.Here(mut c))
        xJumpEdge(mut st, mut e, mut c, irCondElse(mut st, b), xTermX(mut st, b, 5))
    } else if t == TmRet {
        v := xTermX(mut st, b, 1)
        if v >= 0 {
            xGetInto(mut e, mut c, v, x86.Rax)
        }
        for k <- iter.Range(0, e.nsave) {
            x86.MovRegMem(mut c, e.saveReg[k], x86.Rbp, e.saveDisp[k])
        }
        x86.Leave(mut c)
        x86.Ret(mut c)
    } else if t == TmExit {
        xExit(mut c, xTermX(mut st, b, 1))
    } else {
        panic(Unreachable{})
    }
}

// ── 最適化のバックエンド（性能投資 M4 — 写しのバックエンドは上の xTermEmit のまま）──

// xFuseScan は融合する比較を決める: ブロックの終端が condbr で、その条件がブロックの最後の命令の比較の結果、かつ使い道がその condbr だけ
func xFuseScan(st mut St, e mut xF) {
    mut uses := mut []int{}
    xFill(mut uses, e.nv, 0)
    for bi <- iter.Range(0, e.nb) {
        b := BlkRef(e.blk[bi])
        if int(b) < 0 {
            continue
        }
        mut i := irBlkIHead(mut st, b)
        while i != -1 {
            for k <- iter.Range(0, xNOps(mut st, i)) {
                v := xOpnd(mut st, i, k)
                uses[v] = uses[v] + 1
            }
            i = irInsNext(mut st, i)
        }
        for k <- iter.Range(0, xNTermOps(mut st, b)) {
            v := xTermOpnd(mut st, b, k)
            uses[v] = uses[v] + 1
        }
    }
    for bi <- iter.Range(0, e.nb) {
        b := BlkRef(e.blk[bi])
        if int(b) < 0 || irBlkTerm(mut st, b) != TmCondbr {
            continue
        }
        last := irBlkITail(mut st, b)
        cv := xTermX(mut st, b, 1)
        // float の比較（CFEq〜）は flags を 1 つの jcc にできない（NaN のパリティ）— 融合しない
        if last != -1 && irInsOp(mut st, last) == OpCmp && irInsA(mut st, last) < CFEq && irInsRes(mut st, last) == cv && uses[cv] == 1 {
            e.fuse[cv] = 1
        }
    }
}

// xFloatBin は float の二項・単項（language.md 37 節）: 値は汎用レジスタのビット列 — 被演算子を xmm0 / xmm1 へ movq し、scalar double の命令で
// 計算して rax へ戻す（xmm の割り当ては持たない — 最初の形）。単項（sqrt / ofInt / toInt）は c を読まない
func xFloatBin(e mut xF, c mut table.Table[byte], res int, a int, b int, cc int) {
    x := xGet(mut e, mut c, b, x86.Rax)
    if a == BFOfInt {
        x86.Cvtsi2sdXR(mut c, 0, x)
        x86.MovqRX(mut c, x86.Rax, 0)
        xPut(mut e, mut c, res, x86.Rax)
        return
    }
    x86.MovqXR(mut c, 0, x)
    if a == BFToInt {
        x86.Cvttsd2siRX(mut c, x86.Rax, 0)
        xPut(mut e, mut c, res, x86.Rax)
        return
    }
    if a == BFSqrt {
        x86.SqrtsdXX(mut c, 0, 0)
    } else {
        y := xGet(mut e, mut c, cc, x86.Rcx)
        x86.MovqXR(mut c, 1, y)
        if a == BFAdd {
            x86.AddsdXX(mut c, 0, 1)
        } else if a == BFSub {
            x86.SubsdXX(mut c, 0, 1)
        } else if a == BFMul {
            x86.MulsdXX(mut c, 0, 1)
        } else {
            x86.DivsdXX(mut c, 0, 1)
        }
    }
    x86.MovqRX(mut c, x86.Rax, 0)
    xPut(mut e, mut c, res, x86.Rax)
}

// xFloatCmp は float の比較（IEEE — unordered〔NaN〕は fne だけ真）: ucomisd の後の flags で。eq = ZF ∧ ¬PF・ne = ¬ZF ∨ PF・
// lt / le は被演算子を入れ替えて a / ae（CF = 1 の unordered は偽）・gt / ge はそのまま a / ae
func xFloatCmp(e mut xF, c mut table.Table[byte], res int, a int, b int, cc int) {
    x := xGet(mut e, mut c, b, x86.Rax)
    x86.MovqXR(mut c, 0, x)
    y := xGet(mut e, mut c, cc, x86.Rcx)
    x86.MovqXR(mut c, 1, y)
    if a == CFLt || a == CFLe {
        x86.UcomisdXX(mut c, 1, 0)
    } else {
        x86.UcomisdXX(mut c, 0, 1)
    }
    if a == CFEq {
        x86.SetccAl(mut c, x86.CondE)
        x86.SetccCl(mut c, x86.CondNp)
        x86.AndAlCl(mut c)
    } else if a == CFNe {
        x86.SetccAl(mut c, x86.CondNe)
        x86.SetccCl(mut c, x86.CondP)
        x86.OrAlCl(mut c)
    } else if a == CFLt || a == CFGt {
        x86.SetccAl(mut c, x86.CondA)
    } else {
        x86.SetccAl(mut c, x86.CondAe)
    }
    x86.MovzxRaxAl(mut c)
    xPut(mut e, mut c, res, x86.Rax)
}

// xDirectBin は add / sub / mul / and / or / xor を結果のレジスタへ直に計算する（結果がレジスタで、右の被演算子と同じレジスタでないとき）。できなければ false
func xDirectBin(e mut xF, c mut table.Table[byte], res int, a int, b int, cc int) bool {
    l := e.loc[res]
    if !xIsReg(l) {
        return false
    }
    d := xLocVal(l)
    yl := e.loc[cc]
    if xIsReg(yl) && xLocVal(yl) == d && b != cc {
        return false
    }
    xGetInto(mut e, mut c, b, d)
    imm := e.isConst[cc] == 1 && e.constV[cc] >= -2147483648 && e.constV[cc] <= 2147483647
    if imm && (a == BAdd || a == BSub || a == BAnd) {
        if a == BAdd {
            x86.AddRegImm(mut c, d, e.constV[cc])
        } else if a == BSub {
            x86.SubRegImm(mut c, d, e.constV[cc])
        } else {
            x86.AndRegImm(mut c, d, e.constV[cc])
        }
        return true
    }
    y := if b == cc { d } else { xGet(mut e, mut c, cc, x86.Rcx) }
    if a == BAdd {
        x86.AddRegReg(mut c, d, y)
    } else if a == BSub {
        x86.SubRegReg(mut c, d, y)
    } else if a == BMul {
        x86.ImulRegReg(mut c, d, y)
    } else if a == BAnd {
        x86.AndRegReg(mut c, d, y)
    } else if a == BOr {
        x86.OrRegReg(mut c, d, y)
    } else {
        x86.XorRegReg(mut c, d, y)
    }
    return true
}

// xTermEmitOpt は終端（最適化のバックエンド）: 融合した比較は flags の jcc で直に・移動の無い辺は行き先へ jcc で直に・次のブロックへの jmp は省く
func xTermEmitOpt(st mut St, e mut xF, c mut table.Table[byte], b BlkRef) {
    t := irBlkTerm(mut st, b)
    if t == TmBr {
        xEdge(mut st, mut e, mut c, irBrTo(mut st, b), xTermX(mut st, b, 2), true)
    } else if t == TmCondbr {
        cv := xTermX(mut st, b, 1)
        mut cc := 0
        if e.fuse[cv] == 1 {
            cc = e.fcc
        } else {
            x := xGet(mut e, mut c, cv, x86.Rax)
            x86.CmpRegImm(mut c, x, 0)
            cc = x86.CondNe
        }
        thenTo := irCondThen(mut st, b)
        elseTo := irCondElse(mut st, b)
        thenArgs := xTermX(mut st, b, 3)
        elseArgs := xTermX(mut st, b, 5)
        if irBlkId(mut st, thenTo) == e.next && !xEdgeMoves(mut st, mut e, elseTo, elseArgs) {
            // then が次のブロック: 条件を反転して else へ飛び、then へ落ちる
            xJcc(mut st, mut e, mut c, cc ^ 1, elseTo)
            xEdge(mut st, mut e, mut c, thenTo, thenArgs, true)
        } else if !xEdgeMoves(mut st, mut e, thenTo, thenArgs) {
            xJcc(mut st, mut e, mut c, cc, thenTo)
            xEdge(mut st, mut e, mut c, elseTo, elseArgs, true)
        } else if !xEdgeMoves(mut st, mut e, elseTo, elseArgs) {
            xJcc(mut st, mut e, mut c, cc ^ 1, elseTo)
            xEdge(mut st, mut e, mut c, thenTo, thenArgs, true)
        } else {
            toElse := x86.JccRel32(mut c, cc ^ 1)
            xEdge(mut st, mut e, mut c, thenTo, thenArgs, false)
            x86.PatchRel32(mut c, toElse, x86.Here(mut c))
            xEdge(mut st, mut e, mut c, elseTo, elseArgs, true)
        }
    } else {
        xTermEmit(mut st, mut e, mut c, b)
    }
}

// xFoldScan は番地を融合する gep を決める（M7）: 結果の使い道が全部 load / load8 / store / store8 の番地（被演算子 a）だけ。
// 使う点は別のブロックでもよい（M8 — 生存解析が融合した番地を gep の被演算子の使用として数える。SSA なので gep は使う点を支配する）
func xFoldScan(st mut St, e mut xF) {
    mut uses := mut []int{}
    xFill(mut uses, e.nv, 0)
    mut nAddr := mut []int{}
    xFill(mut nAddr, e.nv, 0)
    mut defb := mut []int{}
    xFill(mut defb, e.nv, -1)
    for bi <- iter.Range(0, e.nb) {
        b := BlkRef(e.blk[bi])
        if int(b) < 0 {
            continue
        }
        mut i := irBlkIHead(mut st, b)
        while i != -1 {
            op := irInsOp(mut st, i)
            for k <- iter.Range(0, xNOps(mut st, i)) {
                v := xOpnd(mut st, i, k)
                uses[v] = uses[v] + 1
            }
            if op == OpLoad || op == OpLoad8 || op == OpStore || op == OpStore8 {
                nAddr[irInsA(mut st, i)] = nAddr[irInsA(mut st, i)] + 1
            }
            r := irInsRes(mut st, i)
            if r >= 0 && (op == OpGepW || op == OpGepB) {
                defb[r] = bi
                e.fA[r] = irInsA(mut st, i)
                e.fB[r] = irInsB(mut st, i)
                e.fS[r] = if op == OpGepW { 8 } else { 1 }
            }
            i = irInsNext(mut st, i)
        }
        for k <- iter.Range(0, xNTermOps(mut st, b)) {
            v := xTermOpnd(mut st, b, k)
            uses[v] = uses[v] + 1
        }
    }
    for v <- iter.Range(0, e.nv) {
        if defb[v] >= 0 && uses[v] > 0 && uses[v] == nAddr[v] {
            e.fold[v] = 1
        }
    }
}

// xMemSib は融合した gep g の番地 [p + ix * 倍率 + off] で load（toReg = レジスタ r へ）/ store（r の値を）する（b8 = バイト幅）。
// ix が imm32 に収まる定数なら変位へ畳む（[p + 変位]）
func xMemSib(e mut xF, c mut table.Table[byte], g int, off int, r int, b8 bool, isLoad bool) {
    p := xGet(mut e, mut c, e.fA[g], x86.Rax)
    ixv := e.fB[g]
    if e.isConst[ixv] == 1 {
        dd := e.constV[ixv] * e.fS[g] + off
        if dd >= -2147483648 && dd <= 2147483647 && e.constV[ixv] >= -268435456 && e.constV[ixv] <= 268435455 {
            if isLoad {
                if b8 {
                    x86.MovzxRegMem8(mut c, r, p, dd)
                } else {
                    x86.MovRegMem(mut c, r, p, dd)
                }
            } else if b8 {
                x86.MovMem8Reg(mut c, p, dd, r)
            } else {
                x86.MovMemReg(mut c, p, dd, r)
            }
            return
        }
    }
    ix := xGet(mut e, mut c, ixv, x86.Rcx)
    sc := if e.fS[g] == 8 { x86.Scale8 } else { x86.Scale1 }
    if isLoad {
        if b8 {
            x86.MovzxRegMem8Sib(mut c, r, p, ix, sc, off)
        } else {
            x86.MovRegMemSib(mut c, r, p, ix, sc, off)
        }
    } else if b8 {
        x86.MovMem8RegSib(mut c, p, ix, sc, off, r)
    } else {
        x86.MovMemRegSib(mut c, p, ix, sc, off, r)
    }
}

// xScanB は scanb（第三便のベクトル化スパイク — vec.sober）: 16 バイトの塊ずつ、j + 16 ≤ 上限の間、出口のレーン（述語のどれかが成り立つバイト）が
// 無ければ j += 16・あれば j += そのレーンの番号で止める。結果 = j。使うレジスタ = rax（j）・rdx（上限）・r11（p）・rcx（作業）・xmm0〜7（外では使わない）。
// 述語の種類: 0 = x == K・1 = x != K・2 = x <u K・3 = x >=u K（K は 1〜255 — 2 / 3 は (x ^ 0x80) >s ((K - 1) ^ 0x80) で x >=u K）
func xScanB(st mut St, e mut xF, c mut table.Table[byte], res int, ops int, desc int) {
    xGetInto(mut e, mut c, xAt(mut st, ops, 0), x86.R11)
    xGetInto(mut e, mut c, xAt(mut st, ops, 1), x86.Rax)
    xGetInto(mut e, mut c, xAt(mut st, ops, 2), x86.Rdx)
    if xLen(mut st, ops) == 4 {
        // 上限 = 2 つの小さい方
        xGetInto(mut e, mut c, xAt(mut st, ops, 3), x86.Rcx)
        x86.CmpRegReg(mut c, x86.Rdx, x86.Rcx)
        skip := x86.JccRel32(mut c, x86.CondLe)
        x86.MovRegReg(mut c, x86.Rdx, x86.Rcx)
        x86.PatchRel32(mut c, skip, x86.Here(mut c))
    }
    np := xAt(mut st, desc, 1)
    // 出口 = x >=u 128（utf8 の検査）の語読み（SWAR）と端数の 8 バイトの SIMD の塊は試して不採用（第三便 M12 — 命令は減るが 1BRC の cycles が
    // それぞれ +5%: 名前 ≈ 9 バイトの区間ではバイトずつの分岐の当たるスカラーのループと同じかそれより遅い）
    // 最初の塊が上限を越えるなら定数の用意の前に抜ける（短い区間 — 名前・行の欄 — で固定費を払わない）
    x86.LeaRegMem(mut c, x86.Rcx, x86.Rax, 16)
    x86.CmpRegReg(mut c, x86.Rcx, x86.Rdx)
    early := x86.JccRel32(mut c, x86.CondG)
    // 定数のベクトル: xmm7 = 全 1・xmm6 = 0x80 の並び（符号なしの比較があるとき）・xmm1 / xmm2 = 述語の K（2 / 3 は (K - 1) ^ 0x80）
    x86.PcmpeqbXX(mut c, 7, 7)
    mut useX80 := false
    for k <- iter.Range(0, np) {
        kind := xAt(mut st, desc, 2 + 2 * k)
        kv := xAt(mut st, desc, 3 + 2 * k)
        bv := if kind >= 2 { (kv - 1) ^ 128 } else { kv }
        if kind >= 2 {
            useX80 = true
        }
        x86.MovRegImm64(mut c, x86.Rcx, (bv & 255) * 72340172838076673)
        x86.MovqXR(mut c, 1 + k, x86.Rcx)
        x86.PunpcklqdqXX(mut c, 1 + k, 1 + k)
    }
    if useX80 {
        x86.MovRegImm64(mut c, x86.Rcx, 128 * 72340172838076673)
        x86.MovqXR(mut c, 6, x86.Rcx)
        x86.PunpcklqdqXX(mut c, 6, 6)
    }
    // 16 バイトの塊の環
    topAt := x86.Here(mut c)
    x86.LeaRegMem(mut c, x86.Rcx, x86.Rax, 16)
    x86.CmpRegReg(mut c, x86.Rcx, x86.Rdx)
    outJ := x86.JccRel32(mut c, x86.CondG)
    x86.MovdquXMemSib(mut c, 0, x86.R11, x86.Rax)
    xScanLanes(mut st, mut c, desc, np, useX80)
    x86.PmovmskbRX(mut c, x86.Rcx, 5)
    x86.CmpRegImm(mut c, x86.Rcx, 0)
    foundJ := x86.JccRel32(mut c, x86.CondNe)
    x86.AddRegImm(mut c, x86.Rax, 16)
    backJ := x86.JmpRel32(mut c)
    x86.PatchRel32(mut c, backJ, topAt)
    x86.PatchRel32(mut c, foundJ, x86.Here(mut c))
    x86.BsfRR(mut c, x86.Rcx, x86.Rcx)
    x86.AddRegReg(mut c, x86.Rax, x86.Rcx)
    x86.PatchRel32(mut c, outJ, x86.Here(mut c))
    x86.PatchRel32(mut c, early, x86.Here(mut c))
    xPut(mut e, mut c, res, x86.Rax)
}

// xScanLanes は xmm0 の各バイトの出口のレーンを xmm5 に（xScanB の環の中身 — 述語ごとに比べて or）
func xScanLanes(st mut St, c mut table.Table[byte], desc int, np int, useX80 bool) {
    if useX80 {
        x86.MovdqaXX(mut c, 4, 0)
        x86.PxorXX(mut c, 4, 6)
    }
    for k <- iter.Range(0, np) {
        kind := xAt(mut st, desc, 2 + 2 * k)
        x86.MovdqaXX(mut c, 3, if kind >= 2 { 4 } else { 0 })
        if kind >= 2 {
            x86.PcmpgtbXX(mut c, 3, 1 + k)
        } else {
            x86.PcmpeqbXX(mut c, 3, 1 + k)
        }
        // 3 = 成り立つレーン（eq / >=u）。出口が「成り立たない」側の種類（1 = !=・2 = <u）は反転
        if kind == 1 || kind == 2 {
            x86.PxorXX(mut c, 3, 7)
        }
        if k == 0 {
            x86.MovdqaXX(mut c, 5, 3)
        } else {
            x86.PorXX(mut c, 5, 3)
        }
    }
}

// xHints は割り当てのヒントを集める（M5）: 辺の実引数 v → 仮引数 p（hP）・仮引数 p → 入りの実引数（hA1 / hA2）・
// 算術 / ptoi / itop の結果 → 左の被演算子（hOp — 被演算子がそこで死ねば同じレジスタで mov が要らない）
func xHints(st mut St, e mut xF) {
    xFill(mut e.hP, e.nv, -1)
    xFill(mut e.hA1, e.nv, -1)
    xFill(mut e.hA2, e.nv, -1)
    xFill(mut e.hOp, e.nv, -1)
    for k <- iter.Range(0, e.norder) {
        b := BlkRef(e.blk[e.order[k]])
        mut i := irBlkIHead(mut st, b)
        while i != -1 {
            op := irInsOp(mut st, i)
            r := irInsRes(mut st, i)
            if r >= 0 && (op == OpBin || op == OpPtoi || op == OpItop) {
                e.hOp[r] = xOpnd(mut st, i, 0)
            }
            i = irInsNext(mut st, i)
        }
        t := irBlkTerm(mut st, b)
        if t == TmBr {
            xHintEdge(mut st, mut e, irBrTo(mut st, b), xTermX(mut st, b, 2))
        } else if t == TmCondbr {
            xHintEdge(mut st, mut e, irCondThen(mut st, b), xTermX(mut st, b, 3))
            xHintEdge(mut st, mut e, irCondElse(mut st, b), xTermX(mut st, b, 5))
        }
    }
}

func xHintEdge(st mut St, e mut xF, to BlkRef, args int) {
    mut n := 0
    mut p := irBlkPHead(mut st, to)
    while p >= 0 {
        pv := xParamVal(mut st, p)
        a := xAt(mut st, args, n)
        if e.hP[a] < 0 {
            e.hP[a] = pv
        }
        if e.hA1[pv] < 0 {
            e.hA1[pv] = a
        } else if e.hA2[pv] < 0 && e.hA1[pv] != a {
            e.hA2[pv] = a
        }
        n += 1
        p = xParamNext(mut st, p)
    }
}

// xHintReg は v のヒントの値が今空いているレジスタに居ればそれ（無ければ -1）
func xHintReg(e mut xF, v int, free mut []int) int {
    for k <- iter.Range(0, 4) {
        h := if k == 0 { e.hP[v] } else if k == 1 { e.hA1[v] } else if k == 2 { e.hA2[v] } else { e.hOp[v] }
        if h >= 0 && xIsReg(e.loc[h]) && free[xLocVal(e.loc[h])] == 1 {
            return xLocVal(e.loc[h])
        }
    }
    return -1
}

// xEdgeMoves は辺の実引数の並行コピーに移動が要るか
func xEdgeMoves(st mut St, e mut xF, to BlkRef, args int) bool {
    mut n := 0
    mut p := irBlkPHead(mut st, to)
    while p >= 0 {
        if e.loc[xParamVal(mut st, p)] != xSrcLoc(e, xAt(mut st, args, n)) {
            return true
        }
        n += 1
        p = xParamNext(mut st, p)
    }
    return false
}

// xJcc は条件 cc で行き先のブロックへ直に飛ぶ（関数の末尾で埋める）
func xJcc(st mut St, e mut xF, c mut table.Table[byte], cc int, to BlkRef) {
    e.jAt[e.nj] = x86.JccRel32(mut c, cc)
    e.jTo[e.nj] = irBlkId(mut st, to)
    e.nj = e.nj + 1
}

// xEdge は辺の並行コピーをして飛ぶ（fall なら行き先が次のブロックのとき jmp を省く）
func xEdge(st mut St, e mut xF, c mut table.Table[byte], to BlkRef, args int, fall bool) {
    mut n := 0
    mut p := irBlkPHead(mut st, to)
    while p >= 0 {
        e.mvD[n] = e.loc[xParamVal(mut st, p)]
        e.mvS[n] = xSrcLoc(e, xAt(mut st, args, n))
        n += 1
        p = xParamNext(mut st, p)
    }
    xParallelMove(mut e, mut c, n)
    if fall && irBlkId(mut st, to) == e.next {
        return
    }
    e.jAt[e.nj] = x86.JmpRel32(mut c)
    e.jTo[e.nj] = irBlkId(mut st, to)
    e.nj = e.nj + 1
}

// xJumpEdge は辺の実引数を仮引数へ並行コピーして飛ぶ
func xJumpEdge(st mut St, e mut xF, c mut table.Table[byte], to BlkRef, args int) {
    mut n := 0
    mut p := irBlkPHead(mut st, to)
    while p >= 0 {
        e.mvD[n] = e.loc[xParamVal(mut st, p)]
        e.mvS[n] = e.loc[xAt(mut st, args, n)]
        n += 1
        p = xParamNext(mut st, p)
    }
    xParallelMove(mut e, mut c, n)
    e.jAt[e.nj] = x86.JmpRel32(mut c)
    e.jTo[e.nj] = irBlkId(mut st, to)
    e.nj = e.nj + 1
}

// xSyscall: 引数レジスタ（rdi / rsi / r8〜r10）に載っていて syscall の後も生きている値を積んで退避し、
// 引数を並行コピーで番号 + 6 本へ入れる（rcx / r11 は syscall が壊すが割り当てていない）
func xSyscall(st mut St, e mut xF, c mut table.Table[byte], res int, args int) {
    regs := []int{x86.Rax, x86.Rdi, x86.Rsi, x86.Rdx, x86.R10, x86.R8, x86.R9}
    mut saved := mut []int{}
    for v <- iter.Range(0, e.nv) {
        l := e.loc[v]
        if xIsReg(l) && e.ivS[v] >= 0 && e.ivS[v] < e.pos && e.ivE[v] > e.pos {
            r := xLocVal(l)
            mut isArg := false
            for k <- iter.Range(1, 7) {
                if regs[k] == r {
                    isArg = true
                }
            }
            mut dup := false
            for k <- iter.Range(0, len(saved)) {
                if saved[k] == r {
                    dup = true
                }
            }
            if isArg && !dup {
                saved = append(saved, r)
            }
        }
    }
    for k <- iter.Range(0, len(saved)) {
        x86.PushReg(mut c, saved[k])
    }
    n := xLen(mut st, args)
    for k <- iter.Range(0, n) {
        e.mvD[k] = xLocReg(regs[k])
        e.mvS[k] = xSrcLoc(e, xAt(mut st, args, k))
    }
    xParallelMove(mut e, mut c, n)
    x86.Syscall(mut c)
    mut k := len(saved)
    while k > 0 {
        k -= 1
        x86.PopReg(mut c, saved[k])
    }
    xPut(mut e, mut c, res, x86.Rax)
}

// xParallelMove は e.mvD / e.mvS の先頭 n 本の並行コピー: 書き先が他の移動の読み元でない移動から順に出す。全部が循環なら
// 先頭の書き先を r11 に逃がしてその読み元を付け替える。フレーム同士は rax を中継（並びは ir_x86 の orderedRemove と同じ）
func xParallelMove(e mut xF, c mut table.Table[byte], n int) {
    mut alive := 0
    for k <- iter.Range(0, n) {
        if e.mvD[k] == e.mvS[k] {
            e.mvLive[k] = 0
        } else {
            e.mvLive[k] = 1
            alive += 1
        }
    }
    r11 := xLocReg(x86.R11)
    while alive > 0 {
        mut ready := -1
        for k <- iter.Range(0, n) {
            if ready < 0 && e.mvLive[k] == 1 {
                mut blocked := false
                for j <- iter.Range(0, n) {
                    if j != k && e.mvLive[j] == 1 && e.mvS[j] == e.mvD[k] {
                        blocked = true
                    }
                }
                if !blocked {
                    ready = k
                }
            }
        }
        if ready >= 0 {
            if e.mvS[ready] >= xRemat {
                xMoveImm(mut c, e.mvD[ready], e.constV[(e.mvS[ready] - xRemat) / 2])
            } else {
                xMove(mut c, e.mvD[ready], e.mvS[ready])
            }
            e.mvLive[ready] = 0
            alive -= 1
        } else {
            mut first := -1
            for k <- iter.Range(0, n) {
                if first < 0 && e.mvLive[k] == 1 {
                    first = k
                }
            }
            d := e.mvD[first]
            xMove(mut c, r11, d)
            for k <- iter.Range(0, n) {
                if e.mvLive[k] == 1 && e.mvS[k] == d {
                    e.mvS[k] = r11
                }
            }
        }
    }
}

// xSrcLoc は並行コピーの読み元の置き場（作り直す定数は印 xRemat + 2 × 値 — 偶数で xSpill より上・どの書き先とも一致しない。M5）
func xSrcLoc(e xF, v int) int {
    return if e.remat[v] == 1 { xRemat + 2 * v } else { e.loc[v] }
}

// xMoveImm は即値を置き場へ
func xMoveImm(c mut table.Table[byte], dst int, imm int) {
    if xIsReg(dst) {
        x86.MovRegImm32(mut c, xLocVal(dst), imm)
    } else {
        x86.MovMemImm32(mut c, x86.Rbp, xLocVal(dst), imm)
    }
}

func xMove(c mut table.Table[byte], dst int, src int) {
    if xIsReg(dst) {
        if xIsReg(src) {
            x86.MovRegReg(mut c, xLocVal(dst), xLocVal(src))
        } else {
            x86.MovRegMem(mut c, xLocVal(dst), x86.Rbp, xLocVal(src))
        }
    } else if xIsReg(src) {
        x86.MovMemReg(mut c, x86.Rbp, xLocVal(dst), xLocVal(src))
    } else {
        x86.MovRegMem(mut c, x86.Rax, x86.Rbp, xLocVal(src))
        x86.MovMemReg(mut c, x86.Rbp, xLocVal(dst), x86.Rax)
    }
}

func xExit(c mut table.Table[byte], code int) {
    x86.MovRegImm32(mut c, x86.Rax, 60)
    x86.MovRegImm32(mut c, x86.Rdi, code)
    x86.Syscall(mut c)
}

// xHex は v の 16 桁の 16 進
func xHex(out mut []byte, v int) {
    for k <- iter.Range(0, 16) {
        d := (v >> (60 - 4 * k)) & 15
        out = append(out, byte(if d < 10 { '0' + d } else { 'a' + d - 10 }))
    }
}
