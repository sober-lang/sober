package loader

// shape[T] の loader の層（language.md 16 節 2 — 第一便・第二便〔Encode・rename〕）— 脱糖の固定テンプレート（@layout の合成ファイル方式 — layout.sober と同じ形）:
//
//     u := json.Decode[User](d, n)?          // → $jsonDecodeTop_<f>_<k>_0(d, n)?
//     s := json.Encode[User](u)              // → $jsonEncodeTop_<f>_<k>_0(u)
//     （DecodeWith / EncodeWith は最後の実引数に欄名 → JSON のキーの対応の辞書 map[string]string — 根の口 _1）
//
// struct T と、その欄から届く型（int・float・bool・string・`U?`・`[]U`・入れ子の struct）ごとに写しの関数（普通の Sober）を、呼び出すファイル f ごとの
// 合成ファイル `$json/<f のパス>`（同じ package）に書いて package の末尾に足す。写しの関数は std/json の部品（Object・Need・Get・Items・DecInt …）を呼ぶ。
// 欄の名前 = JSON のキー（Rename 辞書は第二便）・`U?` の欄だけ欠けと null を nil で受ける・余った欄は無視・欠けた欄は json.Missing。
// 範囲外（第二便以降）: 総称の struct・union の欄・map の欄・named scalar の欄 — 写す前に diag.JsonShape で名指して拒否。
// 以降の層（脱糖器・検査器・lower）は写した後の木だけを読む — コア / Lean は無変更

import "std/builder"
import "std/iter"
import "std/strings"
import "ast"
import "diag"
import "lexer"
import "parser"

// 写しの要求の種類
const jInt = 1
const jFloat = 2
const jBool = 3
const jString = 4
const jStruct = 5
const jSlice = 6
const jOpt = 7

// JReq は写しの要求（canon = 型の正準の綴り — 重複除き・file / node = struct の宣言・elem = []U / U? の中身の要求）
type JReq struct {
    kind int
    canon string
    pkg string
    name string
    file int
    node int
    elem int
}

// JsonPrefix は合成ファイルのパスの接頭辞
func JsonPrefix() string {
    return "$json/"
}

// jsonAll は全ファイルの `json.Decode[T](…)` を写し、合成ファイルを package の末尾に足す（layoutAll の 3 段目と同じ並べ方）
@errors(diag.JsonShape, diag.GrammarMismatch)
func jsonAll(ts []ast.Tree, fpkg []string, fpath []string, fstd []bool) (LOut, error?) {
    mut outT := mut []ast.Tree{}
    mut srcs := mut []string{}
    for i <- iter.Range(0, len(ts)) {
        t2, src, err := jsonFile(ts, fpkg, i)
        if err != nil {
            return LOut{}, err
        }
        outT = append(outT, t2)
        srcs = append(srcs, src)
    }
    rt := freeze(outT)
    ss := freeze(srcs)
    mut nt := mut []ast.Tree{}
    mut np := mut []string{}
    mut npath := mut []string{}
    mut nstd := mut []bool{}
    mut lo := 0
    for i <- iter.Range(0, len(rt)) {
        nt = append(nt, rt[i])
        np = append(np, fpkg[i])
        npath = append(npath, fpath[i])
        nstd = append(nstd, fstd[i])
        if i + 1 == len(rt) || fpkg[i + 1] != fpkg[i] {
            for j <- iter.Range(lo, i + 1) {
                if ss[j] != "" {
                    b := bytes(ss[j])
                    st, ok := parser.Parse(b, lexer.LexSynth(b))
                    if !ok {
                        return LOut{}, diag.GrammarMismatch{at: diag.None()}
                    }
                    nt = append(nt, st)
                    np = append(np, fpkg[j])
                    npath = append(npath, JsonPrefix() + fpath[j])
                    nstd = append(nstd, fstd[j])
                }
            }
            lo = i + 1
        }
    }
    return LOut{trees: freeze(nt), pkg: freeze(np), path: freeze(npath), std: freeze(nstd)}, nil
}

// isJsonDecode は節 x が `json.Decode` か `json.Encode`（std/json の参照名の写しの口）か
func isJsonDecode(t ast.Tree, x ast.Node) bool {
    return x.kind == ast.ESelector && t.nodes[x.a].kind == ast.EIdent && importPath(t, Name(t, t.nodes[x.a].a)) == "std/json" && isJsonOp(Name(t, x.b))
}

// isJsonOp は名前 op が std/json の写しの口か（With つきは欄名の対応の辞書を最後の実引数に取る）
func isJsonOp(op string) bool {
    return op == "Decode" || op == "Encode" || op == "DecodeWith" || op == "EncodeWith"
}

// jsonFile はファイル f の `json.Decode[T](…)` を写しの関数の呼び出しへ（結果は（写した木, 合成ソース — 要らなければ ""））
@errors(diag.JsonShape)
func jsonFile(ts []ast.Tree, fpkg []string, f int) (ast.Tree, string, error?) {
    t := ts[f]
    n0 := len(t.nodes)
    // std/json を import しないファイルに口は無い（isJsonDecode は常に偽 — 節ごとに名前の string と import の引きを作らない）
    if !importsPath(t, "std/json") {
        return t, "", nil
    }
    // 呼び出しの位置（節の番号）と型の式
    mut calls := mut []int{}
    mut done := mut []bool{}
    for i <- iter.Range(0, n0) {
        done = append(done, false)
    }
    for i <- iter.Range(0, n0) {
        x := t.nodes[i]
        if x.kind == ast.ECall && t.nodes[x.a].kind == ast.EIndex && isJsonDecode(t, t.nodes[t.nodes[x.a].a]) {
            calls = append(calls, i)
            done[t.nodes[x.a].a] = true
        }
    }
    for i <- iter.Range(0, n0) {
        if isJsonDecode(t, t.nodes[i]) && !done[i] {
            return t, "", diag.JsonShape{at: diag.Pos{file: f, tok: t.nodes[i].tok}, kind: 3}
        }
    }
    cs := freeze(calls)
    if len(cs) == 0 {
        return t, "", nil
    }
    // 要求の表（根 = 各呼び出しの T・続いて欄から届く型 — 待ち行列で）
    mut reqs := mut []JReq{}
    mut roots := mut []int{}
    for c <- iter.Range(0, len(cs)) {
        idx := t.nodes[t.nodes[cs[c]].a]
        r := jsonRoot(ts, fpkg, f, idx.b)
        if r.kind != jStruct {
            return t, "", diag.JsonShape{at: diag.Pos{file: f, tok: t.nodes[idx.b].tok}, kind: 1}
        }
        k := reqIndex(freeze(reqs), r.canon)
        if k < 0 {
            reqs = append(reqs, r)
            roots = append(roots, len(reqs) - 1)
        } else {
            roots = append(roots, k)
        }
    }
    mut q := 0
    while q < len(reqs) {
        r := reqs[q]
        if r.kind == jStruct {
            st := ts[r.file]
            body := st.nodes[st.nodes[r.node].c]
            for k <- iter.Range(0, ast.ListLen(st, body.a)) {
                fd := st.nodes[ast.ListAt(st, body.a, k)]
                e, bad := jsonType(ts, fpkg, r.file, fd.b)
                if bad >= 0 {
                    return t, "", diag.JsonShape{at: diag.Pos{file: r.file, tok: bad}, kind: 2}
                }
                if e.kind >= jStruct && reqIndex(freeze(reqs), e.canon) < 0 {
                    reqs = append(reqs, e)
                }
            }
        } else if r.kind == jSlice || r.kind == jOpt {
            e, bad := jsonType(ts, fpkg, r.file, r.node)
            if bad >= 0 {
                return t, "", diag.JsonShape{at: diag.Pos{file: r.file, tok: bad}, kind: 2}
            }
            if e.kind >= jStruct && reqIndex(freeze(reqs), e.canon) < 0 {
                reqs = append(reqs, e)
            }
        }
        q += 1
    }
    rs := freeze(reqs)
    rts := freeze(roots)
    // 呼び出しの差し替え（`json.Decode[T]` → 写しの関数の名前）
    mut ns := mut []ast.Node{}
    for i <- iter.Range(0, n0) {
        ns = append(ns, t.nodes[i])
    }
    mut db := builder.Builder[int]{}
    for j <- iter.Range(0, len(t.data)) {
        builder.Push(mut db, t.data[j])
    }
    for c <- iter.Range(0, len(cs)) {
        x := t.nodes[cs[c]]
        idx := t.nodes[x.a]
        on := Name(t, t.nodes[idx.a].b)
        op := if on == "Encode" || on == "EncodeWith" { "$jsonEncodeTop" } else { "$jsonDecodeTop" }
        // With なしは対応の辞書を省いた口（写しの根の口が空の map を渡す）
        sfx := if on == "Decode" || on == "Encode" { "_0" } else { "_1" }
        ns[x.a] = ast.Node{ast.EIdent, idx.tok, ast.PutLit(mut db, "${op}_${f}_${rts[c]}${sfx}"), 0, 0, 0, 0, 0}
    }
    src := jsonSource(ts, fpkg, f, rs)
    return ast.Tree{nodes: freeze(ns), data: builder.Build(mut db), file: t.file}, src, nil
}

// reqIndex は正準の綴り canon の要求の添字（無ければ -1）
func reqIndex(rs []JReq, canon string) int {
    for i <- iter.Range(0, len(rs)) {
        if rs[i].canon == canon {
            return i
        }
    }
    return -1
}

// jsonType はファイル f（package fpkg[f]）の型の式の節 e の要求（範囲外の型なら 2 つ目にその字句 — 範囲内は -1）。
// []U / U? の node は中身の型の式の節を指し、中身の要求は待ち行列で作る（jsonSource が canon で引く）。包み（[] と ?）は外から剥がすループで読む（再帰しない）
func jsonType(ts []ast.Tree, fpkg []string, f int, e int) (JReq, int) {
    t := ts[f]
    mut wraps := mut []int{}
    mut cur := e
    while t.nodes[cur].kind == ast.TSlice || t.nodes[cur].kind == ast.TOpt {
        x := t.nodes[cur]
        if x.kind == ast.TSlice && x.b != 0 {
            return JReq{}, x.tok
        }
        // `U??` は範囲外（`[]U?` は U? の slice — 型の文法では slice / map 自体の T? は書けないので TOpt の子が TSlice の形は来ない）
        if x.kind == ast.TOpt && (t.nodes[x.a].kind == ast.TOpt || t.nodes[x.a].kind == ast.TSlice) {
            return JReq{}, x.tok
        }
        wraps = append(wraps, x.kind)
        cur = x.a
    }
    base, bad := jsonBase(ts, fpkg, f, cur)
    if bad >= 0 || len(wraps) == 0 {
        return base, bad
    }
    mut c := base.canon
    mut w := len(wraps) - 1
    while w >= 0 {
        c = if wraps[w] == ast.TSlice { "[]" + c } else { c + "?" }
        w -= 1
    }
    k := if wraps[0] == ast.TSlice { jSlice } else { jOpt }
    return JReq{kind: k, canon: c, pkg: "", name: "", file: f, node: t.nodes[e].a, elem: -1}, -1
}

// jsonBase は包みを剥がした後の型の名前の節 e の要求（スカラーか struct）
func jsonBase(ts []ast.Tree, fpkg []string, f int, e int) (JReq, int) {
    t := ts[f]
    x := t.nodes[e]
    if x.kind != ast.TName {
        return JReq{}, x.tok
    }
    nm := Name(t, x.a)
    if nm == "int" || nm == "float" || nm == "bool" || nm == "string" {
        k := if nm == "int" { jInt } else if nm == "float" { jFloat } else if nm == "bool" { jBool } else { jString }
        return JReq{kind: k, canon: nm, pkg: "", name: "", file: -1, node: -1, elem: -1}, -1
    }
    // 名前の型: 同じ package か `q.Name`（mut 局所を仮引数の slice の要素で初期化して後から代入すると check が拒否 — F-af。空で初期化して両方の枝で代入）
    mut pkg := ""
    mut name := nm
    ref, n2, dotted := strings.Cut(nm, ".")
    if !dotted {
        pkg = fpkg[f]
    } else {
        pkg = importPath(t, ref)
        name = n2
    }
    df, dn := findStruct(ts, fpkg, pkg, name)
    if df < 0 {
        return JReq{}, x.tok
    }
    return JReq{kind: jStruct, canon: "${pkg}.${name}", pkg: pkg, name: name, file: df, node: dn, elem: -1}, -1
}

// jsonRoot は `json.Decode[T]` の型引数の式 e（`T` か `q.T` — 式として読まれている）の struct の要求（struct でなければ kind 0）
func jsonRoot(ts []ast.Tree, fpkg []string, f int, e int) JReq {
    t := ts[f]
    x := t.nodes[e]
    mut pkg := ""
    mut name := ""
    if x.kind == ast.EIdent {
        pkg = fpkg[f]
        name = Name(t, x.a)
    } else if x.kind == ast.ESelector && t.nodes[x.a].kind == ast.EIdent {
        pkg = importPath(t, Name(t, t.nodes[x.a].a))
        name = Name(t, x.b)
    }
    df, dn := findStruct(ts, fpkg, pkg, name)
    if df < 0 {
        return JReq{}
    }
    return JReq{kind: jStruct, canon: "${pkg}.${name}", pkg: pkg, name: name, file: df, node: dn, elem: -1}
}

// findStruct は package pkg の型パラメータなしの struct の宣言 name の（ファイル, 節）（無ければ -1）
func findStruct(ts []ast.Tree, fpkg []string, pkg string, name string) (int, int) {
    for f <- iter.Range(0, len(ts)) {
        if fpkg[f] == pkg {
            t := ts[f]
            tys := t.nodes[t.file].c
            for k <- iter.Range(0, ast.ListLen(t, tys)) {
                ti := ast.ListAt(t, tys, k)
                td := t.nodes[ti]
                if Name(t, td.a) == name && t.nodes[td.c].kind == ast.BStruct && t.data[td.b] == 0 {
                    return f, ti
                }
            }
        }
    }
    return -1, -1
}

// jsonSource はファイル f の写しの関数の合成ソース
func jsonSource(ts []ast.Tree, fpkg []string, f int, rs []JReq) string {
    t := ts[f]
    pkg := fpkg[f]
    mut s := "package ${Name(t, t.nodes[t.file].a)}\n\nimport $jj \"std/json\"\nimport $jb \"std/builder\"\n"
    mut paths := mut []string{}
    for k <- iter.Range(0, len(rs)) {
        p := rs[k].pkg
        if rs[k].kind == jStruct && p != pkg && pathIndex(freeze(paths), p) < 0 {
            s = s + "import $jt${len(paths)} \"${p}\"\n"
            paths = append(paths, p)
        }
    }
    ps := freeze(paths)
    for k <- iter.Range(0, len(rs)) {
        r := rs[k]
        sp := spell(ts, fpkg, rs, ps, pkg, k)
        fname := "$jsonDecode_${f}_${k}"
        if r.kind == jStruct {
            st := ts[r.file]
            body := st.nodes[st.nodes[r.node].c]
            s = s + "\n// ${r.canon} の写し（shape[T] — loader/jsonshape.sober の固定テンプレート）\n"
            s = s + "func ${fname}($d $jj.Doc, $n int, rename map[string]string) (${sp}, error?) {\n    $o := $jj.Object($d, $n)?\n"
            mut lit := ""
            for j <- iter.Range(0, ast.ListLen(st, body.a)) {
                fd := st.nodes[ast.ListAt(st, body.a, j)]
                fname2 := Name(st, fd.a)
                e, _ := jsonType(ts, fpkg, r.file, fd.b)
                if e.kind == jOpt {
                    s = s + "    $f${j} := $jsonField_${f}_${reqIndex(rs, e.canon)}($d, $jj.GetAt($d, $o, $jj.KeyOf(rename, \"${fname2}\"), ${j}), rename)?\n"
                } else {
                    // `?` は束縛ごとに 1 つ（実引数の中の `?` は lower が拒否 — F-ae）
                    s = s + "    $k${j} := $jj.NeedAt($d, $o, $jj.KeyOf(rename, \"${fname2}\"), ${j})?\n    $f${j} := ${decCall(rs, f, e)}($d, $k${j}${decTail(e)})?\n"
                }
                lit = if j == 0 { "${fname2}: $f${j}" } else { lit + ", ${fname2}: $f${j}" }
            }
            s = s + "    return ${sp}{${lit}}, nil\n}\n"
            s = s + "\nfunc $jsonDecodeTop_${f}_${k}_0($d $jj.Doc, $n int) (${sp}, error?) {\n    return ${fname}($d, $n, map[string]string{})\n}\n"
            s = s + "\nfunc $jsonDecodeTop_${f}_${k}_1($d $jj.Doc, $n int, rename map[string]string) (${sp}, error?) {\n    return ${fname}($d, $n, rename)\n}\n"
        } else if r.kind == jSlice {
            e, _ := jsonType(ts, fpkg, r.file, r.node)
            ei := reqIndex(rs, e.canon)
            esp := if ei >= 0 { spell(ts, fpkg, rs, ps, pkg, ei) } else { e.canon }
            s = s + "\nfunc ${fname}($d $jj.Doc, $n int, rename map[string]string) (${sp}, error?) {\n    $it := $jj.Items($d, $n)?\n"
            s = s + "    mut $xs := mut []${esp}{}\n    mut $i := 0\n    while $i < len($it) {\n"
            s = s + "        $v := ${decCall(rs, f, e)}($d, $it[$i]${decTail(e)})?\n        $xs = append($xs, $v)\n        $i += 1\n    }\n"
            s = s + "    return freeze($xs), nil\n}\n"
        } else if r.kind == jOpt {
            e, _ := jsonType(ts, fpkg, r.file, r.node)
            s = s + "\nfunc ${fname}($d $jj.Doc, $n int, rename map[string]string) (${sp}, error?) {\n    if $jj.IsNull($d, $n) {\n        return nil, nil\n    }\n"
            s = s + "    $v := ${decCall(rs, f, e)}($d, $n${decTail(e)})?\n    return $v, nil\n}\n"
            // 欄の位置（欠けも nil）
            // 絞りは肯定の形で（早期 return の後の絞り込みは check が拒否 — F-y の層）
            s = s + "\nfunc $jsonField_${f}_${k}($d $jj.Doc, $m int?, rename map[string]string) (${sp}, error?) {\n    if $m != nil {\n        return ${fname}($d, $m, rename)\n    }\n"
            s = s + "    return nil, nil\n}\n"
        }
        s = s + jsonEncodeFn(ts, fpkg, rs, ps, pkg, f, k, false) + jsonEncodeFn(ts, fpkg, rs, ps, pkg, f, k, true)
    }
    return s
}

// decTail は写しの関数（スカラー以外）の呼び出しの末尾の実引数（rename を引き回す）
func decTail(e JReq) string {
    return if e.kind >= jStruct { ", rename" } else { "" }
}

// jsonEncodeFn は要求 k の書きの写しの関数（mut の builder に積む — struct は根の口 $jsonEncodeTop も）。2 系統を合成する:
// rn = 偽 — rename なし（Encode）: 欄の頭は定数の断片（`{"name":` / `,"name":` — キーのエスケープは合成時に jsonKeyLit）を 1 回の PushStr・
// 根の口 _0 は空の rename の map を作らずに直に呼ぶ。rn = 真 — rename つき（EncodeWith の根の口 _1 から）: 欄ごとに KeyOf で引いて PutKey（旧の形）。
// 系統どうしは呼び合わない（rename つきの値の中の struct も rename つきで書く）。lower は届く関数しか下ろさないので、使わない系統は ELF に入らない
func jsonEncodeFn(ts []ast.Tree, fpkg []string, rs []JReq, ps []string, pkg string, f int, k int, rn bool) string {
    r := rs[k]
    sp := spell(ts, fpkg, rs, ps, pkg, k)
    fname := encName(f, k, rn)
    rp := if rn { ", rename map[string]string" } else { "" }
    mut s := ""
    if r.kind == jStruct {
        st := ts[r.file]
        body := st.nodes[st.nodes[r.node].c]
        n := ast.ListLen(st, body.a)
        s = s + "\nfunc ${fname}($o mut $jb.Builder[byte], $v ${sp}${rp}) {\n"
        if rn || n == 0 {
            s = s + "    $jb.Push(mut $o, '{')\n"
        }
        for j <- iter.Range(0, n) {
            fd := st.nodes[ast.ListAt(st, body.a, j)]
            nm := Name(st, fd.a)
            e, _ := jsonType(ts, fpkg, r.file, fd.b)
            if rn {
                s = s + "    $jj.PutKey(mut $o, $jj.KeyOf(rename, \"${nm}\"), ${if j == 0 { "true" } else { "false" }})\n"
            } else {
                s = s + "    $jb.PushStr(mut $o, \"${if j == 0 { "{" } else { "," }}${jsonKeyLit(nm)}:\")\n"
            }
            s = s + "    ${encCall(rs, f, e, "$v.${nm}", nm, rn)}\n"
        }
        s = s + "    $jb.Push(mut $o, '}')\n}\n"
        if rn {
            s = s + "\nfunc $jsonEncodeTop_${f}_${k}_1($v ${sp}, rename map[string]string) string {\n    mut $o := $jb.Builder[byte]{}\n    ${fname}(mut $o, $v, rename)\n    return $jj.Done(mut $o)\n}\n"
        } else {
            s = s + "\nfunc $jsonEncodeTop_${f}_${k}_0($v ${sp}) string {\n    mut $o := $jb.Builder[byte]{}\n    ${fname}(mut $o, $v)\n    return $jj.Done(mut $o)\n}\n"
        }
    } else if r.kind == jSlice {
        e, _ := jsonType(ts, fpkg, r.file, r.node)
        s = s + "\nfunc ${fname}($o mut $jb.Builder[byte], $v ${sp}${rp}) {\n    $jb.Push(mut $o, '[')\n    mut $i := 0\n    while $i < len($v) {\n"
        s = s + "        if $i > 0 {\n            $jb.Push(mut $o, ',')\n        }\n        ${encCall(rs, f, e, "$v[$i]", "", rn)}\n        $i += 1\n    }\n    $jb.Push(mut $o, ']')\n}\n"
    } else if r.kind == jOpt {
        e, _ := jsonType(ts, fpkg, r.file, r.node)
        s = s + "\nfunc ${fname}($o mut $jb.Builder[byte], $v ${sp}${rp}) {\n    if $v != nil {\n        ${encCall(rs, f, e, "$v", "", rn)}\n    } else {\n        $jj.Put(mut $o, \"null\")\n    }\n}\n"
    }
    return s
}

// encName は要求 k の書きの写しの関数の名前（rn = rename つきの系統）
func encName(f int, k int, rn bool) string {
    return if rn { "$jsonEncodeR_${f}_${k}" } else { "$jsonEncode_${f}_${k}" }
}

// jsonKeyLit は欄名 nm の JSON の文字列（'"' 込み・std/json の quote と同じエスケープ — '"' '\\' と制御文字）を、合成ファイルの string の字面の
// 中身として綴る（字面のエスケープを重ねる）。欄名は識別子なので普通はそのまま
func jsonKeyLit(nm string) string {
    h := bytes("0123456789abcdef")
    mut out := mut []byte{}
    for c <- bytes(nm) {
        if c == '"' || c == '\\' {
            // JSON の \" / \\ を字面の中で綴る（\\\" / \\\\）
            out = append(out, '\\')
            out = append(out, '\\')
            out = append(out, '\\')
            out = append(out, c)
        } else if c < 32 {
            // JSON の \u00XX を字面の中で綴る（\\u00XX）
            out = append(out, '\\')
            out = append(out, '\\')
            out = append(out, 'u')
            out = append(out, '0')
            out = append(out, '0')
            out = append(out, h[int(c) >> 4])
            out = append(out, h[int(c) & 15])
        } else {
            out = append(out, c)
        }
    }
    body := string(freeze(out)) catch nm
    return "\\\"" + body + "\\\""
}

// encCall は値 x（綴り）を要求 e で $o に書く文（nm = 欄名 — float の panic の名指し・rn = rename つきの系統）
func encCall(rs []JReq, f int, e JReq, x string, nm string, rn bool) string {
    return switch e.kind {
    case jInt: "$jj.PutInt(mut $o, ${x})"
    case jFloat: "$jj.PutFloat(mut $o, ${x}, \"${nm}\")"
    case jBool: "$jj.PutBool(mut $o, ${x})"
    case jString: "$jj.PutString(mut $o, ${x})"
    default: if rn { "${encName(f, reqIndex(rs, e.canon), true)}(mut $o, ${x}, rename)" } else { "${encName(f, reqIndex(rs, e.canon), false)}(mut $o, ${x})" }
    }
}

// decCall は要求 e（スカラーなら std/json の部品・それ以外は写しの関数）を節から読む関数の名前
func decCall(rs []JReq, f int, e JReq) string {
    return switch e.kind {
    case jInt: "$jj.DecInt"
    case jFloat: "$jj.DecFloat"
    case jBool: "$jj.DecBool"
    case jString: "$jj.DecString"
    default: "$jsonDecode_${f}_${reqIndex(rs, e.canon)}"
    }
}

// spell は要求 k の型の綴り（合成ファイルの中で — 他 package の struct は参照名 $jt<i>）
func spell(ts []ast.Tree, fpkg []string, rs []JReq, ps []string, pkg string, k0 int) string {
    // 包み（[] と ?）を外から辿って記録し、芯（struct かスカラー）の綴りに内から被せる（再帰しない）
    mut wraps := mut []int{}
    mut k := k0
    mut core := ""
    while core == "" {
        r := rs[k]
        if r.kind == jStruct {
            core = if r.pkg == pkg { r.name } else { "$jt${pathIndex(ps, r.pkg)}.${r.name}" }
        } else if r.kind == jSlice || r.kind == jOpt {
            wraps = append(wraps, r.kind)
            e, _ := jsonType(ts, fpkg, r.file, r.node)
            ei := reqIndex(rs, e.canon)
            if ei >= 0 {
                k = ei
            } else {
                core = e.canon
            }
        } else {
            core = r.canon
        }
    }
    mut s := core
    mut w := len(wraps) - 1
    while w >= 0 {
        s = if wraps[w] == jSlice { "[]" + s } else { s + "?" }
        w -= 1
    }
    return s
}
