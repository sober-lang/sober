package lower

// task の器（段 6 P3b-1・language.md 11 節 P3b の裁定・docs/ir.md 4.6）: std/par の子は自前の機械スタックで走る。
// - 記録（TCB）は 1 塊 [ガードページ | スタック 1 MiB | 頁: スタックの頂上 2 KiB + TCB | TC_SAVE の続き] の頁の途中（mmap — NORESERVE・ガードは
//   PROT_NONE・TC_TOP = TCB の番地 — スタックは TCB の直下から下へ伸びる）。毎回触るスタックの頂上と TCB の先頭の欄を 1 頁に乗せる（report-686 / 687 —
//   4096 接続の公平な一巡で dTLB −12%・cycles −9%。前の並び [TCB の頁 | ガード | スタック] ではスタックの頂上が TCB から 1 MiB 離れた別の頁）。終わった task の塊はプール
//   （@rt.task の空きの鎖）へ返して次の spawn が使う（mprotect は塊を作るときだけ）
// - 切替 = rt.task_switch(from, to) / 始める = rt.task_go(from, to): 今の task の深度・宛先 / anchor のレジスタ・最内の罠を from に退避し、
//   to のを戻して、OpTSwitch / OpTStart（今の文脈を from の記録の先頭語に積む）
// - 子の入口 = rt.task_start(tcb): 罠を張って子の関数を呼び（死は罠で受ける）、handle の枠に状態・死因を書き、scope の記録の死の数を数え、
//   塊をプールへ返して起こし手（waker — spawn した task）へ切り替える（戻らない）
// - 既定の方針 = 子を先に（spawn の時点で子へ切り替える — 子が終わるまで親は止まる。待つ形〔chan〕は P3b-2）
// region は P3a と同じ 1 本（子は中断しないので、親の死んだ深度のスロットをそのまま使う — 中断する task の region は P3b-2）

import "desugar"
import "std/iter"

// @rt.task の配置（語）: [今の task の TCB, 空きの塊の鎖]
const TK_CUR = 0
const TK_FREE = 1
const TK_READY = 2   // 走れる task の積み（TC_NEXT で繋ぐ — LIFO: spawn で親を積んで子を先に・子が終わるか待つと最後に積んだ task が走る）
const TK_INLE = 3    // 縮退の記帳（admit.sober — rt.task_new が入場できず縮退に回した子の計上量と天井の節の最内。直後の rt.task_inline が入口で読む・同じワーカーの間に切替は無い）
const TK_INLN = 4
const TK_WORDS = 5

// TCB の配置（語）
const TC_CTX = 0     // 退避した rsp（OpTSwitch / OpTStart が書く — 先頭語）
const TC_DEPTH = 1   // 退避した region の深度
const TC_BASE = 2    // spawn した時点の深度（自前の region はこれより深い）
const TC_DEST = 3    // 退避した W_DEST
const TC_ANCHOR = 4  // 退避した W_ANCHOR
const TC_TRAP = 5    // 退避した最内の罠（@rt.trap[0]）
const TC_WAKER = 6   // 終わったら切り替える task（spawn した task）
const TC_FRAME = 7   // handle の枠
const TC_KID = 8     // 子の関数の番地
const TC_NEXT = 9    // 空きの鎖
const TC_TOP = 10    // スタックの頂上（塊の末尾）
const TC_STARTED = 12 // 1 = 走り始めた（0 = spawn で積まれただけ — 最初の切替は OpTStart で始める）
const TC_OWN = 11    // 退避した「自前のスロットを持つ最深の深度」（(TC_BASE, TC_OWN] の深度のスロットはこの task のもの — R1'）
const TC_SEG = 13    // 今書いている出力の区間（段 6 P4-2 (O1) — out.sober）
const TC_WORKER = 14 // 固定されたワーカーの番号（M:N — 走り始めたときに決まる・段 6 P4-4 mn.sober）
const TC_INEXT = 15  // 受け箱の鎖（M:N）
const TC_ENTRY = 16  // 始めるときの入口（rt.task_start — M:N は rt.task_start_mn）
const TC_ID = 17     // 通し番号（M:N の trace）
const TC_KOFF = 18   // 枠の預かりの欄の位置（語 — 結果が region を持つ子だけ・(B1)）
const TC_SCOPE = 19  // 開いている最内の scope の記録（SR_UP で外へ — 段 6 P4-5。0 = 無し）
const TC_CUTOK = 20  // 1 = 純な子（切ってよい — 段 6 P4-5 cancel.sober。main・純でない子・走らせ直しは 0）
const TC_IDX = 21    // 生んだ scope の中の番号（生んだ順 — 打ち切りの印 SR_CUT と比べる）
const TC_SITE = 22   // spawn の点の番号（1 始まり — 0 = 走らせ直し。段 6 P5-1 の計測〔spawn の点ごとの使用量〕・P5-2 の見積もり）
const TC_ADM = 23    // 入場で台帳に積んだ量（段 6 P5-2 admit.sober — 見積もりのバイト | 1 << LED_TSHIFT。0 = 計上していない〔main・走らせ直し〕）
const TC_NODE = 24   // 入場で足した天井の節の最内（budget: の scope の記録 — 段 6 P5-3 admit.sober。0 = 根だけ）
const TC_DECL = 25   // 宣言の上界（budget: — 0 = 宣言なし。終わりで宣言超過を数える）
const TC_CNODE = 26  // 今効いている天井の節（spawn の子の入場が辿る入口 — 生まれたときは TC_NODE・budget: の scope の開閉で付け替える）
// 空きの鎖の長さ（M:N の手元の鎖 — この節から尾までの本数。tcb_free の push で頭の値 + 1・取りは触らない）
const TC_FLEN = 27
const TC_IORES = TC_FLEN + 1 // ring に出した io の結果（IO_PENDING = 完了をまだ取り込んでいない — IO 便 段 1 uring.sober）
const TC_WAIT = TC_FLEN + 2  // 1 = 今 wait の scope の中（段 3 の ③ admit.sober — 入場できない直接の子を待つ。scope の開閉で付け替える・子は 0 で生まれる）
const TC_AWNEXT = TC_FLEN + 3 // 入場の待ちの鎖（@rt.mn[MN_AWAIT] から — admit.sober）
const TC_SLOTSZ = TC_FLEN + 4 // この task の自前のスロットの大きさ（バイト — 宣言の無い子は W_SLOT_DEF・宣言の子はそれ以上の 2 の冪・main は起動の W_SLOT_SIZE。切替で meta の W_SLOT_SIZE へ）
const TC_WORDS = TC_FLEN + 5
// 自前の深度の [スロットの基底, bump] の退避（深度 k → TC_SAVE + 2k・+1）。2 × (MAX_DEPTH + 1) 語 = 16 KiB の列なので記録の末尾に置く —
// 毎回の io の欄（TC_FLEN〜TC_SLOTSZ・TC_FDS / TC_CHS / TC_DL = 語 27〜34）を TC_NEXT 等と同じ先頭の頁に収め、完了 1 本で TCB の 2 頁を
// 触らないため（report-678 T8 — 退避の列の後ろに置いていたときは io の欄が 5 頁目で、4096 接続の ring で dTLB の取りこぼし 12 / 要求のうち
// 3.6 が rt.uring_poll の TC_IORES）。TC_SAVE は TC_DL・TC_LEASE（語 35）・孤児の登録簿の TC_ORG（語 36 — orphan.sober）より後ろ・TC_END × 8 = 16,696 B < TASK_HEAD
const TC_SAVE = 37
const TC_END = TC_SAVE + 2 * (MAX_DEPTH + 1)
// 開いた fd の鎖の頭（fd + 1・0 = 空 — IO 便 段 2 の登録簿 rt.sober の needOpen）。sysOpen を使うプログラムでだけ使う語（TC_WORDS の外）。main の記録
// （rt.main_task）は退避の列の末尾まで（TC_END）なので、TC_FDS / TC_CHS / TC_DL はどのプログラムでも中にある。子の塊の記録は TASK_HEAD の頁の中
const TC_FDS = TC_WORDS

// 深度ごとのスロットの表（R1' — 裁定 2026-10-06）: @rt.slots[d] = 今の task の深度 d の region のスロットの基底・[MAX_DEPTH + 1] = 自前の
// スロットを持つ最深の深度（own）。main は予約のアリーナの d 番目（W_SLOTS + d × サイズ）・子はプール（@rt.slot_free — 空なら SLOT_CHUNK 本ぶんの VA を予約）から取る。
// スロットの大きさは task ごと（TC_SLOTSZ — main は起動の大きさ・子は既定 W_SLOT_DEF か budget: から導いた 2 の冪。今の task の値が meta の W_SLOT_SIZE）。
// プールは既定の大きさのスロットだけ — 既定より大きい子は深度ごとに mmap して終わりで munmap。子が終わるとスロットはプールへ返る（先頭から W_MADV を超えて使った頁は MADV_DONTNEED）
const SLOT_OWN = MAX_DEPTH + 1
const SLOT_FREE_CAP = 4096
// プールの冷えた水位（rt.slot_free の SLOT_WM 語 = 下から何本を先頭の W_MADV まで返し済みか・SLOT_WM + 1 語 = そのときの水位の位置のスロット — 番兵。
// pop / push の道では触らない〔熱い道 — report-575: pop ごとの min で skynet の命令 +1.7%〕。次の刈り込みで、数が水位を割ったか水位の位置の番地が
// 番兵と違えば水位を 0 に戻して刈り直す。水位は最適化だけ — 外しても madvise が余分に走るか返し漏れるだけで、意味は変わらない）
const SLOT_WM = 1 + SLOT_FREE_CAP
const SLOT_CHUNK = 16
// SOBER_SCHED（決定的な再生 — par-draft 8 節）: 切替点ごとの選択の列 `SOBER_SCHED=1,0,2`（spawn = 0 子を先に / 1 親を先に・待つ / 終わる =
// 走れる task の積みの上から何番目か）。列が尽きた後と選択肢が 1 つの点は 0（既定の方針）。SOBER_SCHED_TRACE=1 なら選択肢が 2 つ以上の点ごとに
// 標準エラーへ `#sched <選択肢の数> <選んだ番号>`（schedvec が全スケジュールを列挙するための足場）。@rt.sched = [列の長さ, 次の位置, trace, 列…]
const SCHED_CAP = 4096
const SCHED_SEED = 3 + SCHED_CAP   // @rt.sched の乱択の状態（0 = 使わない）
const SCHED_ACT = 4 + SCHED_CAP    // 選択の器を使うか（列・trace・種のどれか — 0 なら切替点は既定の選択 0 を rt.sched_pick を呼ばずに取る・段 6 P4-4）

const TASK_HEAD = 20480
const TASK_GUARD = 4096
// 機械スタックの大きさ: 1 MiB（NORESERVE — 実メモリは触った頁だけ）。子の region の深度の上限（1023）まで再帰しても溢れない大きさ —
// 102（depth_limit）の境目を P3a（親の 8 MB スタックの上で走った）と同じに保つ（裁定 ① — 64 KiB では深度 1000 程度の再帰で先にスタックが尽きる）
const TASK_STACK = 1048576
// SIGSEGV の口（ガードページに触れた = スタックの溢れ）: 代替スタック 64 KiB・@rt.sig = [stack_t 3 語, sigaction 4 語]
const SIG_ALT = 65536
const SIG_WORDS = 8
// rt.panic_mem の種類の続き（スタックの溢れ — 死因の印字は StackExceeded{}）
const PM_STACK = 4

// needTaskRt は task の器の宣言（std/par を使うプログラムだけ — installRt から。本体は program の最後に buildTaskRt）
func needTaskRt(st mut St) {
    st.taskG = addWorkerGlobal(mut st, int(strLit(mut st, "rt.task")), TK_WORDS)
    st.mainTcb = addGlobalInit(mut st, int(strLit(mut st, "rt.main_task")), TC_END, -1)
    st.rtTaskNew = addFunc(mut st, int(strLit(mut st, "rt.task_new")), desugar.ListRef(list2(mut st, TyI64, TyI64)), TyPtr)
    st.rtTaskGo = addFunc(mut st, int(strLit(mut st, "rt.task_go")), desugar.ListRef(list2(mut st, TyPtr, TyPtr)), -1)
    st.rtTaskStart = addFunc(mut st, int(strLit(mut st, "rt.task_start")), desugar.ListRef(list1(mut st, TyPtr)), -1)
    st.rtTaskSwitch = addFunc(mut st, int(strLit(mut st, "rt.task_switch")), desugar.ListRef(list2(mut st, TyPtr, TyPtr)), -1)
    st.sigG = addGlobalInit(mut st, int(strLit(mut st, "rt.sig")), SIG_WORDS, -1)
    st.slotsG = addWorkerGlobal(mut st, int(strLit(mut st, "rt.slots")), MAX_DEPTH + 2)
    st.slotFreeG = addWorkerGlobal(mut st, int(strLit(mut st, "rt.slot_free")), 3 + SLOT_FREE_CAP)
    st.rtSlotNew = addFunc(mut st, int(strLit(mut st, "rt.slot_new")), desugar.ListRef(list1(mut st, TyI64)), -1)
    st.rtTaskWait = addFunc(mut st, int(strLit(mut st, "rt.task_wait")), desugar.ListRef(list0(mut st)), -1)
    st.rtTaskPop = addFunc(mut st, int(strLit(mut st, "rt.task_pop")), desugar.ListRef(list0(mut st)), TyPtr)
    st.rtSchedPick = addFunc(mut st, int(strLit(mut st, "rt.sched_pick")), desugar.ListRef(list1(mut st, TyI64)), TyI64)
    st.schedG = addWorkerGlobal(mut st, int(strLit(mut st, "rt.sched")), 5 + SCHED_CAP)
    st.rtDeadlock = addFunc(mut st, int(strLit(mut st, "rt.deadlock")), desugar.ListRef(list0(mut st)), -1)
    st.rtSegv = addFunc(mut st, int(strLit(mut st, "rt.segv")), desugar.ListRef(list0(mut st)), -1)
    st.rtSlotGive = addFunc(mut st, int(strLit(mut st, "rt.slot_give")), desugar.ListRef(list2(mut st, TyI64, TyI64)), -1)
    st.rtSlotTrim = addFunc(mut st, int(strLit(mut st, "rt.slot_trim")), desugar.ListRef(list0(mut st)), -1)
    st.rtUnmap = addFunc(mut st, int(strLit(mut st, "rt.unmap")), desugar.ListRef(list2(mut st, TyI64, TyI64)), -1)
    st.rtKidKeep = addFunc(mut st, int(strLit(mut st, "rt.kid_keep")), desugar.ListRef(list1(mut st, TyI64)), TyPtr)
    st.rtSlotTake = addFunc(mut st, int(strLit(mut st, "rt.slot_take")), desugar.ListRef(list0(mut st)), TyI64)
    st.rtChanFree = addFunc(mut st, int(strLit(mut st, "rt.chan_free")), desugar.ListRef(list2(mut st, TyPtr, TyI64)), -1)
    st.cutGenG = addGlobalInit(mut st, int(strLit(mut st, "rt.cutgen")), 1, -1)
    st.rtCutWalk = addFunc(mut st, int(strLit(mut st, "rt.cut_walk")), desugar.ListRef(list1(mut st, TyPtr)), TyI64)
    st.rtCutEnd = addFunc(mut st, int(strLit(mut st, "rt.cut_end")), desugar.ListRef(list2(mut st, TyPtr, TyI64)), TyI64)
    st.rtCancel = addFunc(mut st, int(strLit(mut st, "rt.cancel_check")), desugar.ListRef(list0(mut st)), -1)
    st.rtTaskRerun = addFunc(mut st, int(strLit(mut st, "rt.task_rerun")), desugar.ListRef(list1(mut st, TyPtr)), -1)
    needMnRt(mut st)
    needOutRt(mut st)
    needPstatRt(mut st)
    needAdmitRt(mut st)
    // ワーカーの記録（段 6 P4-3 — 表の番地の列。語数は program の最後に表の数で決める — buildWorkerInit）
    st.workerG = addGlobalInit(mut st, int(strLit(mut st, "rt.worker")), 0, -1)
    st.rtWorkerInit = addFunc(mut st, int(strLit(mut st, "rt.worker_init")), desugar.ListRef(list0(mut st)), -1)
}

// fdDrainCall は子の入口の出口で task の鎖に残った fd を閉じる（死・切られた子は defer が走らない — rt.sober の needOpen。sysOpen を使うプログラムだけ）
func fdDrainCall(st mut St) {
    leaseDrainCall(mut st)
    chDrainCall(mut st)
    if st.rtFdDrain != -1 {
        call(mut st, st.rtFdDrain, list3(mut st, 0, iconst(mut st, 0), iconst(mut st, 1)))
    }
}

// buildWorkerInit は rt.worker_init(): ワーカー 0（main のスレッド）の記録 = 各表の大域の番地の列を組み、arch_prctl(ARCH_SET_FS) で %fs の基底に置く
// （入口の最初 — 以降の fsaddr の表 k は fs:[8k]。program の最後に組む: 表は lower の途中でも足される〔needStat 等〕）。P4-4 のワーカーは自分の表を
// 確保して同じ形の記録を作る
func buildWorkerInit(st mut St) {
    desugar.HeapSet(mut st.d, st.workerG + G_WORDS, if st.nwslot > 0 { st.nwslot } else { 1 })
    begin(mut st, st.rtWorkerInit)
    w := globaladdrRaw(mut st, st.workerG)
    mut g := st.ghead
    while g >= 0 {
        k := desugar.HeapGet(mut st.d, g + G_WSLOT)
        if k >= 0 {
            store(mut st, w, k, ptoi(mut st, globaladdrRaw(mut st, g)))
        }
        g = desugar.HeapGet(mut st.d, g + G_NEXT)
    }
    // arch_prctl(ARCH_SET_FS = 0x1002, 記録)
    syscall(mut st, list3(mut st, iconst(mut st, 158), iconst(mut st, 4098), ptoi(mut st, w)))
    ret(mut st, -1)
    buildMnStart(mut st)
}

// taskInitMain は入口で今の task を main の記録にする（buildEntry から）
func taskInitMain(st mut St, sp int) {
    // スロットの大きさ: main = 起動の W_SLOT_SIZE・子の既定 = min(SOBER_TASK_REGION_MB〔既定 256〕, main)（ワーカーの起動の塊を作る mnInit より先に — meta の写しに乗る）
    meta := globaladdr(mut st, st.meta)
    ms := load(mut st, meta, W_SLOT_SIZE)
    store(mut st, globaladdr(mut st, st.mainTcb), TC_SLOTSZ, ms)
    tmb := envMb(mut st, sp, "SOBER_TASK_REGION_MB=", DEFAULT_TASK_SLOT_MB, false)
    store(mut st, meta, W_SLOT_DEF, imin(mut st, bin(mut st, BShl, tmb, iconst(mut st, 20)), ms))
    if dlFn(st.rtD3) != 0 {
        vdsoInit(mut st, sp)
    }
    store(mut st, globaladdr(mut st, st.taskG), TK_CUR, ptoi(mut st, globaladdr(mut st, st.mainTcb)))
    store(mut st, globaladdr(mut st, st.mainTcb), TC_STARTED, iconst(mut st, 1))
    schedInit(mut st, sp)
    mnInit(mut st, sp)
    outInitMain(mut st)
    // main の深度 0 のスロット = アリーナの先頭・own = 0（深く入るたびに rt.slot_new がアリーナの d 番目を表に置く）
    store(mut st, globaladdr(mut st, st.slotsG), 0, load(mut st, globaladdr(mut st, st.meta), W_SLOTS))
    // SIGSEGV を代替スタックの rt.segv で受ける（task のガードページ = スタックの溢れ → 罠へ巻き戻る StackExceeded の死）。
    // sigaltstack(&stack_t, NULL)・rt_sigaction(SIGSEGV, &act, NULL, 8)。flags = SA_SIGINFO | SA_ONSTACK | SA_NODEFER（巻き戻りでハンドラから抜けても次の SIGSEGV を受ける）| SA_RESTORER
    sg := globaladdr(mut st, st.sigG)
    alt := sysMmap(mut st, iconst(mut st, SIG_ALT))
    store(mut st, sg, 0, alt)
    store(mut st, sg, 1, iconst(mut st, 0))
    store(mut st, sg, 2, iconst(mut st, SIG_ALT))
    syscall(mut st, list3(mut st, iconst(mut st, 131), ptoi(mut st, sg), iconst(mut st, 0)))
    h := funcaddr(mut st, st.rtSegv)
    store(mut st, sg, 3, h)
    store(mut st, sg, 4, iconst(mut st, 1275068420))
    store(mut st, sg, 5, h)
    store(mut st, sg, 6, iconst(mut st, 0))
    syscall(mut st, list5(mut st, iconst(mut st, 13), iconst(mut st, 11), ptoi(mut st, gepWord(mut st, sg, iconst(mut st, 3))), iconst(mut st, 0), iconst(mut st, 8)))
}

// buildSegv は rt.segv(): 罠が張られていれば死因（102・種類 PM_STACK）を書いて巻き戻る（task のスタックの溢れ）。張られていなければ
// `panic: StackExceeded{}` を印字して exit 102（main のスタックの外の SIGSEGV — std/par を使うプログラムだけがこの口を持つ）
func buildSegv(st mut St) {
    begin(mut st, st.rtSegv)
    trapDie(mut st, PANIC_MEM, iconst(mut st, PM_STACK))
    meta := globaladdr(mut st, st.meta)
    toStderr(mut st, meta)
    printLit(mut st, "panic: StackExceeded{}\n")
    call(mut st, st.rtFlush, list0(mut st))
    exit(mut st, PANIC_MEM)
}

func buildTaskRt(st mut St) {
    buildDeadlineRt(mut st)
    buildTaskNew(mut st)
    buildTaskGo(mut st)
    buildTaskSwitch(mut st)
    buildTaskStart(mut st)
    buildSegv(mut st)
    buildSlotNew(mut st)
    buildSlotGive(mut st)
    buildSlotTrim(mut st)
    buildKidKeep(mut st)
    if st.rtFrameNew != -1 {
        buildFrameNew(mut st)
    }
    begin(mut st, st.rtUnmap)
    syscall(mut st, list3(mut st, iconst(mut st, 11), 0, 1))
    ret(mut st, -1)
    buildSlotTake(mut st)
    buildChanFree(mut st)
    buildMnRt(mut st)
    buildTaskWait(mut st)
    buildCancelRt(mut st)
    buildDeadlock(mut st)
    buildSchedPick(mut st)
    buildTaskPop(mut st)
    buildOutRt(mut st)
    buildPstatRt(mut st)
    buildAdmitRt(mut st)
}

// taskWake は task t を走れる積みに載せる（切り替えない — 今の task が待つか終わったときに走る）
func taskWake(st mut St, t int) {
    tk := globaladdr(mut st, st.taskG)
    store(mut st, t, TC_NEXT, load(mut st, tk, TK_READY))
    store(mut st, tk, TK_READY, ptoi(mut st, t))
}

// taskWakeAny は task t を走れるようにする（M:N なら持ち主のワーカーへ — rt.mn_wake。協調形は taskWake）。待ちの起こし手（チャネル・Close）から
func taskWakeAny(st mut St, t int) {
    bMn := newBlock(mut st)
    bCo := newBlock(mut st)
    bE := newBlock(mut st)
    condbr(mut st, mnOn(mut st), bMn, -1, bCo, -1)
    setCur(mut st, bMn)
    call(mut st, st.rtMnWake, list1(mut st, t))
    br(mut st, bE, -1)
    setCur(mut st, bCo)
    taskWake(mut st, t)
    br(mut st, bE, -1)
    setCur(mut st, bE)
}

// taskNext は走れる積みから次の task を取る（無ければ rt.deadlock — 全 task が待っている = デッドロック。Kahn により有無はスケジュールに依らない）
func taskNext(st mut St) int {
    // 速い道（段 6 P4-6）: 選択の器を使わず走れる積みが空でなければ、一番上をその場で外す（rt.task_pop を呼ばない — 全レジスタの退避を踏まない）
    tk := globaladdr(mut st, st.taskG)
    // net の待ち手がいれば眠ってから取り直す（netpoll.sober — 協調形の眠りの席）
    retry := if netOn(mut st) { newBlock(mut st) } else { BlkRef(-1) }
    if netOn(mut st) {
        br(mut st, retry, -1)
        setCur(mut st, retry)
    }
    head := load(mut st, tk, TK_READY)
    bFast := newBlock(mut st)
    bSlow := newBlock(mut st)
    bGot := newBlock(mut st)
    got := param(mut st, bGot, TyPtr)
    fast := bin(mut st, BAnd, cmp(mut st, CEq, load(mut st, globaladdr(mut st, st.schedG), SCHED_ACT), iconst(mut st, 0)), cmp(mut st, CNe, head, iconst(mut st, 0)))
    condbr(mut st, fast, bFast, -1, bSlow, -1)
    setCur(mut st, bFast)
    hp := itop(mut st, head)
    store(mut st, tk, TK_READY, load(mut st, hp, TC_NEXT))
    br(mut st, bGot, list1(mut st, hp))
    setCur(mut st, bSlow)
    br(mut st, bGot, list1(mut st, call(mut st, st.rtTaskPop, list0(mut st))))
    setCur(mut st, bGot)
    rp := got
    none := newBlock(mut st)
    ok := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, ptoi(mut st, rp), iconst(mut st, 0)), none, -1, ok, -1)
    setCur(mut st, none)
    if netOn(mut st) {
        bDl := branchIf(mut st, cmp(mut st, CNe, load(mut st, globaladdr(mut st, st.wkG), WK_NETW), iconst(mut st, 0)))
        call(mut st, st.rtUpoll, list1(mut st, iconst(mut st, 1)))
        br(mut st, retry, -1)
        setCur(mut st, bDl)
    }
    call(mut st, st.rtDeadlock, list0(mut st))
    exit(mut st, PANIC)
    setCur(mut st, ok)
    return rp
}

// buildTaskWait は rt.task_wait(): 今の task を待たせて次の走れる task へ切り替える（起こされて順番が来たら返る — 呼び手は条件を見直す）
func buildTaskWait(st mut St) {
    begin(mut st, st.rtTaskWait)
    me := itop(mut st, load(mut st, globaladdr(mut st, st.taskG), TK_CUR))
    // M:N: 次の task（自分が起こされて積まれていれば自分 — 切り替えずに返る）
    bMn := newBlock(mut st)
    bCo := newBlock(mut st)
    condbr(mut st, mnOn(mut st), bMn, -1, bCo, -1)
    setCur(mut st, bMn)
    mx := call(mut st, st.rtMnNext, list0(mut st))
    bSw := newBlock(mut st)
    bRet := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, ptoi(mut st, mx), ptoi(mut st, me)), bRet, -1, bSw, -1)
    setCur(mut st, bSw)
    call(mut st, st.rtTaskSwitch, list2(mut st, me, mx))
    br(mut st, bRet, -1)
    setCur(mut st, bRet)
    ret(mut st, -1)
    setCur(mut st, bCo)
    nx := taskNext(mut st)
    call(mut st, st.rtTaskSwitch, list2(mut st, me, nx))
    ret(mut st, -1)
}

// buildDeadlock は rt.deadlock(): `panic: Deadlock{}` を印字して exit 101（全 task が待っている — 定義された死）
func buildDeadlock(st mut St) {
    begin(mut st, st.rtDeadlock)
    toStderr(mut st, globaladdr(mut st, st.meta))
    printLit(mut st, "panic: Deadlock{}\n")
    call(mut st, st.rtFlush, list0(mut st))
    exit(mut st, PANIC)
}

// slotBase は今の task の深度 d の region のスロットの基底（std/par を使わないプログラムは今までどおり アリーナ + d × サイズ — IR は不変）
func slotBase(st mut St, meta int, d int) int {
    if st.taskUse {
        return load(mut st, gepWord(mut st, globaladdr(mut st, st.slotsG), d), 0)
    }
    return bin(mut st, BAdd, load(mut st, meta, W_SLOTS), bin(mut st, BMul, d, load(mut st, meta, W_SLOT_SIZE)))
}

// slotEnter は深度 d へ入るときのスロットの基底（d が自前の範囲の外なら rt.slot_new が取って表に置く）
func slotEnter(st mut St, meta int, d int) int {
    if !st.taskUse {
        return slotBase(mut st, meta, d)
    }
    sg := globaladdr(mut st, st.slotsG)
    bNew := newBlock(mut st)
    bOk := newBlock(mut st)
    condbr(mut st, cmp(mut st, CGt, d, load(mut st, sg, SLOT_OWN)), bNew, -1, bOk, -1)
    setCur(mut st, bNew)
    call(mut st, st.rtSlotNew, list1(mut st, d))
    br(mut st, bOk, -1)
    setCur(mut st, bOk)
    return load(mut st, gepWord(mut st, sg, d), 0)
}

// buildSlotNew は rt.slot_new(d): 今の task の深度 d のスロットを取って表に置き、own = d（main はアリーナの d 番目・子はプール）
func buildSlotNew(st mut St) {
    begin(mut st, st.rtSlotNew)
    d := 0
    meta := globaladdr(mut st, st.meta)
    sg := globaladdr(mut st, st.slotsG)
    fg := globaladdr(mut st, st.slotFreeG)
    curT := load(mut st, globaladdr(mut st, st.taskG), TK_CUR)
    bMain := newBlock(mut st)
    bPool := newBlock(mut st)
    bRefill := newBlock(mut st)
    bPop := newBlock(mut st)
    bEnd := newBlock(mut st)
    base := param(mut st, bEnd, TyI64)
    condbr(mut st, cmp(mut st, CEq, curT, ptoi(mut st, globaladdr(mut st, st.mainTcb))), bMain, -1, bPool, -1)
    setCur(mut st, bMain)
    br(mut st, bEnd, list1(mut st, bin(mut st, BAdd, load(mut st, meta, W_SLOTS), bin(mut st, BMul, d, load(mut st, meta, W_SLOT_SIZE)))))
    setCur(mut st, bPool)
    // 既定より大きい子（budget: の宣言から）は深度ごとに自前の mmap（プールは既定の大きさだけ — 終わりで munmap・slotRelease）
    bOwn := newBlock(mut st)
    bShared := newBlock(mut st)
    sz := load(mut st, meta, W_SLOT_SIZE)
    condbr(mut st, cmp(mut st, CNe, sz, load(mut st, meta, W_SLOT_DEF)), bOwn, -1, bShared, -1)
    setCur(mut st, bOwn)
    a := sysMmap(mut st, sz)
    syscall(mut st, list4(mut st, iconst(mut st, 28), a, sz, iconst(mut st, 15)))
    pstatVa(mut st, 1)
    br(mut st, bEnd, list1(mut st, a))
    setCur(mut st, bShared)
    condbr(mut st, cmp(mut st, CEq, load(mut st, fg, 0), iconst(mut st, 0)), bRefill, -1, bPop, -1)
    setCur(mut st, bRefill)
    slotRefill(mut st, meta, fg)
    br(mut st, bPop, -1)
    setCur(mut st, bPop)
    n := load(mut st, fg, 0)
    s := load(mut st, gepWord(mut st, fg, n), 0)
    store(mut st, fg, 0, bin(mut st, BSub, n, iconst(mut st, 1)))
    br(mut st, bEnd, list1(mut st, s))
    setCur(mut st, bEnd)
    store(mut st, gepWord(mut st, sg, d), 0, base)
    store(mut st, sg, SLOT_OWN, d)
    ret(mut st, -1)
}

// buildSlotTake は rt.slot_take() i64: プールのスロットを 1 つ取る（空なら SLOT_CHUNK 本ぶんの VA を予約 — rt.slot_new の子の枝と同じ。
// チャネルのペイロードの小アリーナ — 段 6 P4-4 (B4)）
func buildSlotTake(st mut St) {
    begin(mut st, st.rtSlotTake)
    meta := globaladdr(mut st, st.meta)
    fg := globaladdr(mut st, st.slotFreeG)
    bRefill := newBlock(mut st)
    bPop := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, load(mut st, fg, 0), iconst(mut st, 0)), bRefill, -1, bPop, -1)
    setCur(mut st, bRefill)
    slotRefill(mut st, meta, fg)
    br(mut st, bPop, -1)
    setCur(mut st, bPop)
    n := load(mut st, fg, 0)
    s := load(mut st, gepWord(mut st, fg, n), 0)
    store(mut st, fg, 0, bin(mut st, BSub, n, iconst(mut st, 1)))
    ret(mut st, s)
}

// slotRefill はプール（空）に SLOT_CHUNK 本のスロットを積む（M:N なら共有の予備から先に — mnSlotRefill）
func slotRefill(st mut St, meta int, fg int) {
    bMn := newBlock(mut st)
    bMap := newBlock(mut st)
    bEnd := newBlock(mut st)
    condbr(mut st, mnOn(mut st), bMn, -1, bMap, -1)
    setCur(mut st, bMn)
    got := call(mut st, st.rtSresTake, list0(mut st))
    condbr(mut st, cmp(mut st, CNe, got, iconst(mut st, 0)), bEnd, -1, bMap, -1)
    setCur(mut st, bMap)
    size := load(mut st, meta, W_SLOT_DEF)
    total := bin(mut st, BMul, size, iconst(mut st, SLOT_CHUNK))
    a := sysMmap(mut st, total)
    syscall(mut st, list4(mut st, iconst(mut st, 28), a, total, iconst(mut st, 15)))
    pstatVa(mut st, SLOT_CHUNK)
    for i <- iter.Range(0, SLOT_CHUNK) {
        store(mut st, fg, 1 + i, bin(mut st, BAdd, a, bin(mut st, BMul, size, iconst(mut st, i))))
    }
    store(mut st, fg, 0, iconst(mut st, SLOT_CHUNK))
    br(mut st, bEnd, -1)
    setCur(mut st, bEnd)
}

// slotRange は深度 k が lo < k <= hi の範囲を回す（save = true なら表と bump を t の退避域へ・false なら t から戻す）
func slotRange(st mut St, t int, lo int, hi int, save bool) {
    meta := globaladdr(mut st, st.meta)
    sg := globaladdr(mut st, st.slotsG)
    loop := newBlock(mut st)
    k := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, lo, iconst(mut st, 1))))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLe, k, hi), body, -1, done, -1)
    setCur(mut st, body)
    sv := gepWord(mut st, t, bin(mut st, BMul, k, iconst(mut st, 2)))
    sp := gepWord(mut st, sg, k)
    bp := gepWord(mut st, meta, k)
    if save {
        store(mut st, sv, TC_SAVE, load(mut st, sp, 0))
        store(mut st, sv, TC_SAVE + 1, load(mut st, bp, W_BUMP))
    } else {
        store(mut st, sp, 0, load(mut st, sv, TC_SAVE))
        store(mut st, bp, W_BUMP, load(mut st, sv, TC_SAVE + 1))
    }
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, k, iconst(mut st, 1))))
    setCur(mut st, done)
}

// slotRelease は今の task（tcb — 終わった子）の自前のスロットをプールへ返す（先頭から W_MADV を超えて使った頁は MADV_DONTNEED・プールが満杯なら munmap）
func slotRelease(st mut St, tcb int) int {
    meta := globaladdr(mut st, st.meta)
    sg := globaladdr(mut st, st.slotsG)
    fg := globaladdr(mut st, st.slotFreeG)
    loop := newBlock(mut st)
    k := param(mut st, loop, TyI64)
    acc := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    adv := newBlock(mut st)
    bPush := newBlock(mut st)
    keep := newBlock(mut st)
    next := newBlock(mut st)
    done := newBlock(mut st)
    dacc := param(mut st, done, TyI64)
    hi := load(mut st, sg, SLOT_OWN)
    br(mut st, loop, list2(mut st, bin(mut st, BAdd, load(mut st, tcb, TC_BASE), iconst(mut st, 1)), iconst(mut st, 0)))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLe, k, hi), body, -1, done, list1(mut st, acc))
    setCur(mut st, body)
    s := load(mut st, gepWord(mut st, sg, k), 0)
    used := bin(mut st, BSub, load(mut st, gepWord(mut st, meta, k), W_BUMP), s)
    // 既定より大きいスロット（自前の mmap — slot_new）はプールへ返さず munmap
    bBig := newBlock(mut st)
    bDef := newBlock(mut st)
    sz := load(mut st, meta, W_SLOT_SIZE)
    condbr(mut st, cmp(mut st, CNe, sz, load(mut st, meta, W_SLOT_DEF)), bBig, -1, bDef, -1)
    setCur(mut st, bBig)
    syscall(mut st, list3(mut st, iconst(mut st, 11), s, sz))
    br(mut st, next, -1)
    setCur(mut st, bDef)
    // 返すのは先頭から W_MADV を超えた分だけ（region_enter と同じ規則 — task の終わりごとの madvise は M:N で TLB の撃ち落としになる）
    keepB := load(mut st, meta, W_MADV)
    condbr(mut st, cmp(mut st, CGt, used, keepB), adv, -1, bPush, -1)
    setCur(mut st, adv)
    // 変異 5（開発用）: スロットを返すときの MADV_DONTNEED を省く
    if st.rtMut != 5 {
        syscall(mut st, list4(mut st, iconst(mut st, 28), bin(mut st, BAdd, s, keepB), bin(mut st, BSub, used, keepB), iconst(mut st, 4)))
    }
    br(mut st, bPush, -1)
    setCur(mut st, bPush)
    n := load(mut st, fg, 0)
    bDrop := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, n, iconst(mut st, SLOT_FREE_CAP)), keep, -1, bDrop, -1)
    setCur(mut st, bDrop)
    syscall(mut st, list3(mut st, iconst(mut st, 11), s, load(mut st, meta, W_SLOT_DEF)))
    br(mut st, next, -1)
    setCur(mut st, keep)
    n1 := bin(mut st, BAdd, n, iconst(mut st, 1))
    store(mut st, gepWord(mut st, fg, n1), 0, s)
    store(mut st, fg, 0, n1)
    br(mut st, next, -1)
    setCur(mut st, next)
    br(mut st, loop, list2(mut st, bin(mut st, BAdd, k, iconst(mut st, 1)), bin(mut st, BAdd, acc, used)))
    setCur(mut st, done)
    return dacc
}

// buildSlotTrim は rt.slot_trim(): 今のワーカーの手元のプールのうち、上の SLOT_KEEP 本（次に取られる温かい分）を除いて冷えた水位より上のスロットの
// 先頭 W_MADV（返すときに残した頁 — slotRelease / slot_give）も MADV_DONTNEED で返し、水位を上げる（report-574 の T1）。M:N では加えて共有の予備の
// 水位より上の全部（手元は SLOT_KEEP 本までで、超過は予備へ行く — 予備は全部が超過）。呼ぶのは scope の出口で、刈るのは main の task の scope だけ
// （子の scope の出口ごとに刈ると、予備の鍵を握った madvise の間に他のワーカーが回る — skynet の W8 で cycles +4.8%・命令 +2.0%〔report-575〕）。
// task の終わりごとでない — 撃ち落としを根の scope の出口に束にする。意味は変わらない: プールのスロットの中身は死んでいて、取った task は
// bump の先頭から書き直す（返した頁はゼロの頁で戻る）
func buildSlotTrim(st mut St) {
    begin(mut st, st.rtSlotTrim)
    bTop := newBlock(mut st)
    bOut0 := newBlock(mut st)
    curT := load(mut st, globaladdr(mut st, st.taskG), TK_CUR)
    condbr(mut st, cmp(mut st, CEq, curT, ptoi(mut st, globaladdr(mut st, st.mainTcb))), bTop, -1, bOut0, -1)
    setCur(mut st, bOut0)
    ret(mut st, -1)
    setCur(mut st, bTop)
    fg := globaladdr(mut st, st.slotFreeG)
    keepB := load(mut st, globaladdr(mut st, st.meta), W_MADV)
    n := load(mut st, fg, 0)
    wm := wmCheck(mut st, fg, n, SLOT_WM)
    hi := bin(mut st, BSub, n, iconst(mut st, SLOT_KEEP))
    bRun := newBlock(mut st)
    loop := newBlock(mut st)
    k := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    fin := newBlock(mut st)
    done := newBlock(mut st)
    condbr(mut st, bin(mut st, BAnd, cmp(mut st, CGt, hi, wm), cmp(mut st, CGt, keepB, iconst(mut st, 0))), bRun, -1, done, -1)
    setCur(mut st, bRun)
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, wm, iconst(mut st, 1))))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLe, k, hi), body, -1, fin, -1)
    setCur(mut st, body)
    syscall(mut st, list4(mut st, iconst(mut st, 28), load(mut st, gepWord(mut st, fg, k), 0), keepB, iconst(mut st, 4)))
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, k, iconst(mut st, 1))))
    setCur(mut st, fin)
    store(mut st, fg, SLOT_WM, hi)
    store(mut st, fg, SLOT_WM + 1, load(mut st, gepWord(mut st, fg, hi), 0))
    br(mut st, done, -1)
    // M:N: 共有の予備（手元の SLOT_KEEP 本を越えた分の行き先 — slot_give）は全部が超過なので、水位より上を全部返す（鍵の下 — 返す間に他のワーカーが取らない）
    setCur(mut st, done)
    bMn := newBlock(mut st)
    bLk := newBlock(mut st)
    sl := newBlock(mut st)
    k2 := param(mut st, sl, TyI64)
    sb := newBlock(mut st)
    sfin := newBlock(mut st)
    out := newBlock(mut st)
    condbr(mut st, mnOn(mut st), bMn, -1, out, -1)
    setCur(mut st, bMn)
    mn := globaladdr(mut st, st.mnG)
    rs := globaladdr(mut st, st.sresG)
    condbr(mut st, bin(mut st, BAnd, cmp(mut st, CNe, load(mut st, rs, 0), load(mut st, rs, SRES_WM)), cmp(mut st, CGt, keepB, iconst(mut st, 0))), bLk, -1, out, -1)
    setCur(mut st, bLk)
    spinLock(mut st, mn, MN_RLOCK)
    c := load(mut st, rs, 0)
    br(mut st, sl, list1(mut st, bin(mut st, BAdd, wmCheck(mut st, rs, c, SRES_WM), iconst(mut st, 1))))
    setCur(mut st, sl)
    condbr(mut st, cmp(mut st, CLe, k2, c), sb, -1, sfin, -1)
    setCur(mut st, sb)
    syscall(mut st, list4(mut st, iconst(mut st, 28), load(mut st, gepWord(mut st, rs, k2), 0), keepB, iconst(mut st, 4)))
    br(mut st, sl, list1(mut st, bin(mut st, BAdd, k2, iconst(mut st, 1))))
    setCur(mut st, sfin)
    store(mut st, rs, SRES_WM, c)
    store(mut st, rs, SRES_WM + 1, load(mut st, gepWord(mut st, rs, c), 0))
    store(mut st, mn, MN_RLOCK, iconst(mut st, 0))
    br(mut st, out, -1)
    setCur(mut st, out)
    ret(mut st, -1)
}

// wmCheck はプール p（数 n・水位の語 w / 番兵の語 w + 1）の水位: 水位が数以下で、水位の位置の番地が番兵と同じなら水位・違えば 0（刈り直す）
func wmCheck(st mut St, p int, n int, w int) int {
    wm0 := load(mut st, p, w)
    le := cmp(mut st, CLe, wm0, n)
    same := cmp(mut st, CEq, load(mut st, gepWord(mut st, p, bin(mut st, BMul, wm0, le)), 0), load(mut st, p, w + 1))
    ok := bin(mut st, BAnd, le, bin(mut st, BOr, same, cmp(mut st, CEq, wm0, iconst(mut st, 0))))
    return bin(mut st, BMul, wm0, ok)
}

// buildSlotGive は rt.slot_give(s, used): スロット s（使った量 used バイト）をプールへ返す（先頭から W_MADV を超えて使った頁は MADV_DONTNEED・プールも予備も満杯なら munmap）
func buildSlotGive(st mut St) {
    begin(mut st, st.rtSlotGive)
    fg := globaladdr(mut st, st.slotFreeG)
    bAdv := newBlock(mut st)
    bPush := newBlock(mut st)
    keep := newBlock(mut st)
    done := newBlock(mut st)
    // 返すのは先頭から W_MADV を超えた分だけ（region_enter と同じ規則）
    keepB := load(mut st, globaladdr(mut st, st.meta), W_MADV)
    condbr(mut st, cmp(mut st, CGt, 1, keepB), bAdv, -1, bPush, -1)
    setCur(mut st, bAdv)
    if st.rtMut != 5 {
        syscall(mut st, list4(mut st, iconst(mut st, 28), bin(mut st, BAdd, 0, keepB), bin(mut st, BSub, 1, keepB), iconst(mut st, 4)))
    }
    br(mut st, bPush, -1)
    setCur(mut st, bPush)
    n := load(mut st, fg, 0)
    // 手元の上限: 協調形 = SLOT_FREE_CAP・M:N = SLOT_KEEP（越えた分は共有の予備へ — 他のワーカーの子が使う）
    capV := bin(mut st, BAdd, iconst(mut st, SLOT_FREE_CAP), bin(mut st, BMul, mnOn(mut st), iconst(mut st, SLOT_KEEP - SLOT_FREE_CAP)))
    bShare := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, n, capV), keep, -1, bShare, -1)
    setCur(mut st, keep)
    n1 := bin(mut st, BAdd, n, iconst(mut st, 1))
    store(mut st, gepWord(mut st, fg, n1), 0, 0)
    store(mut st, fg, 0, n1)
    br(mut st, done, -1)
    setCur(mut st, bShare)
    bSh := newBlock(mut st)
    bDrop := newBlock(mut st)
    condbr(mut st, mnOn(mut st), bSh, -1, bDrop, -1)
    setCur(mut st, bSh)
    mn := globaladdr(mut st, st.mnG)
    rs := globaladdr(mut st, st.sresG)
    spinLock(mut st, mn, MN_RLOCK)
    c := load(mut st, rs, 0)
    bPut := newBlock(mut st)
    bFull := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, c, iconst(mut st, SRES_CAP)), bPut, -1, bFull, -1)
    setCur(mut st, bPut)
    c1 := bin(mut st, BAdd, c, iconst(mut st, 1))
    store(mut st, gepWord(mut st, rs, c1), 0, 0)
    store(mut st, rs, 0, c1)
    store(mut st, mn, MN_RLOCK, iconst(mut st, 0))
    br(mut st, done, -1)
    setCur(mut st, bFull)
    store(mut st, mn, MN_RLOCK, iconst(mut st, 0))
    br(mut st, bDrop, -1)
    // 予備も満杯: munmap で VA と頁を返す（旧 = 捨てるだけ — 山のたびに VA が漏れて va_exhausted に届いた・report-656 3 節）
    setCur(mut st, bDrop)
    syscall(mut st, list3(mut st, iconst(mut st, 11), 0, load(mut st, globaladdr(mut st, st.meta), W_SLOT_DEF)))
    br(mut st, done, -1)
    setCur(mut st, done)
    ret(mut st, -1)
}

// needFrameRt は rt.frame_new の宣言（handle を捨てた子を生むプログラムだけ — 使わないプログラムの IR は不変・report-697）
func needFrameRt(st mut St) {
    if st.rtFrameNew == -1 {
        st.rtFrameNew = addFunc(mut st, int(strLit(mut st, "rt.frame_new")), desugar.ListRef(list0(mut st)), TyPtr)
    }
}

// buildFrameNew は rt.frame_new() ptr（report-697）: handle を捨てた子の枠 = 今のワーカーの小さな塊の鎖（rt.kid_keep の預かりの小さな塊と同じ鎖・
// KEEP_SMALL バイト）から 1 つ（空なら KEEP_SLAB を mmap して切り分ける）。返すのは子の終わり（frameDrop）か scope の出口（死んだ枠 — deadWalk）で、
// 返す側のワーカーの鎖へ
func buildFrameNew(st mut St) {
    begin(mut st, st.rtFrameNew)
    wk := globaladdr(mut st, st.wkG)
    zero := iconst(mut st, 0)
    bRem := newBlock(mut st)
    bFill := newBlock(mut st)
    bPop := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, load(mut st, wk, WK_SLAB), zero), bRem, -1, bPop, -1)
    // 自分の鎖が空: 他のワーカーが返した分を丸ごと取る（無ければ新しい塊）
    setCur(mut st, bRem)
    rf := atomicXchg(mut st, wk, WK_RFREE, zero)
    store(mut st, wk, WK_SLAB, rf)
    condbr(mut st, cmp(mut st, CEq, rf, zero), bFill, -1, bPop, -1)
    setCur(mut st, bFill)
    slabFill(mut st, wk)
    br(mut st, bPop, -1)
    setCur(mut st, bPop)
    c0 := load(mut st, wk, WK_SLAB)
    store(mut st, wk, WK_SLAB, load(mut st, itop(mut st, c0), 0))
    // 持ち主（返す先のワーカー）を枠の FR_NEXT へ（handle を捨てた子は error を返さないので FR_NEXT を使わない）
    store(mut st, itop(mut st, c0), FR_NEXT, ptoi(mut st, wk))
    ret(mut st, itop(mut st, c0))
}

// frameFree は handle を捨てた子の枠 f を持ち主のワーカーへ返す（今のワーカーが持ち主なら自分の鎖・それ以外は持ち主の WK_RFREE へ CAS — report-697）
func frameFree(st mut St, f int) {
    wk := globaladdr(mut st, st.wkG)
    own := load(mut st, f, FR_NEXT)
    bMine := newBlock(mut st)
    bRem := newBlock(mut st)
    bEnd := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, own, ptoi(mut st, wk)), bMine, -1, bRem, -1)
    setCur(mut st, bMine)
    store(mut st, f, 0, load(mut st, wk, WK_SLAB))
    store(mut st, wk, WK_SLAB, ptoi(mut st, f))
    br(mut st, bEnd, -1)
    setCur(mut st, bRem)
    ow := itop(mut st, own)
    pl := newBlock(mut st)
    br(mut st, pl, -1)
    setCur(mut st, pl)
    h := load(mut st, ow, WK_RFREE)
    store(mut st, f, 0, h)
    o := atomicCas(mut st, ow, WK_RFREE, h, ptoi(mut st, f))
    condbr(mut st, cmp(mut st, CEq, o, h), bEnd, -1, pl, -1)
    setCur(mut st, bEnd)
}

// slabFill は今のワーカーの小さな塊の鎖（空）に KEEP_SLAB を mmap して KEEP_SMALL ずつ切り分けて積む
func slabFill(st mut St, wk int) {
    sb := sysMmap(mut st, iconst(mut st, KEEP_SLAB))
    for i <- iter.Range(0, KEEP_SLAB / KEEP_SMALL) {
        cp := itop(mut st, bin(mut st, BAdd, sb, iconst(mut st, i * KEEP_SMALL)))
        store(mut st, cp, 0, if i + 1 < KEEP_SLAB / KEEP_SMALL { bin(mut st, BAdd, sb, iconst(mut st, (i + 1) * KEEP_SMALL)) } else { iconst(mut st, 0) })
    }
    store(mut st, wk, WK_SLAB, sb)
}

// frameDrop は終わる子（枠 frame・scope の記録 rec・死んだか dead）の枠が handle を捨てた子の枠（FR_COL = 2）なら持ち主のワーカーへ返す
// （frameFree — report-697）。死んでいれば先に scope の記録の鍵 SR_DLOCK の中で、自分の番号が SR_DMIN より小さければ (番号, 死因) を書く（report-705 —
// 子は並行に終わる。2 語の組を割らないための鍵・死の道だけ）。生きている子の数を減らす前に呼ぶ（出口は数 0 を見てから 2 語を読む）。handle を捨てた子を生まないプログラムでは何も出さない
func frameDrop(st mut St, frame int, rec int, dead int) {
    if st.rtFrameNew == -1 {
        return
    }
    bD := newBlock(mut st)
    bFree := newBlock(mut st)
    bGone := newBlock(mut st)
    bEnd := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, load(mut st, frame, FR_COL), iconst(mut st, 2)), bD, -1, bEnd, -1)
    setCur(mut st, bD)
    condbr(mut st, cmp(mut st, CNe, dead, iconst(mut st, 0)), bGone, -1, bFree, -1)
    setCur(mut st, bGone)
    spinLock(mut st, rec, SR_DLOCK)
    idx := load(mut st, frame, FR_IDX)
    best := load(mut st, rec, SR_DMIN)
    upd := cmp(mut st, CLt, idx, best)
    oldC := load(mut st, rec, SR_DCAUSE)
    store(mut st, rec, SR_DCAUSE, bin(mut st, BAdd, oldC, bin(mut st, BMul, upd, bin(mut st, BSub, load(mut st, frame, FR_CAUSE), oldC))))
    store(mut st, rec, SR_DMIN, bin(mut st, BAdd, best, bin(mut st, BMul, upd, bin(mut st, BSub, idx, best))))
    atomicXchg(mut st, rec, SR_DLOCK, iconst(mut st, 0))
    br(mut st, bFree, -1)
    setCur(mut st, bFree)
    frameFree(mut st, frame)
    br(mut st, bEnd, -1)
    setCur(mut st, bEnd)
}

// buildKidKeep は rt.kid_keep(d) ptr（段 6 P4-4 (B1) — 結果に region を持つ子の関数の出口から。結果は自前の深度 d に寄せ済み）: 結果の写し先 =
// 深度 d の使った量（頁に切り上げ・最小 1 頁）の小さな無名の領域を確保して枠の預かりの欄 [基底, 長さ, 次] に書き、scope の記録の SR_KEEP の鎖へ
// 積んで基底を返す（呼び手が深度 d - 1 をそこへ付け替えて写す — d のスロットはいつもどおり task の終わりにプールへ返る）。
// スロットごと預けると 4 GiB の VA × 子の数で尽きた（1 scope に 10 万の string の子で 102 — 切り詰め〔munmap の尻尾〕は VA を穴だらけにして同じく尽きた）
func buildKidKeep(st mut St) {
    begin(mut st, st.rtKidKeep)
    d := 0
    meta := globaladdr(mut st, st.meta)
    sg := globaladdr(mut st, st.slotsG)
    tcb := itop(mut st, load(mut st, globaladdr(mut st, st.taskG), TK_CUR))
    frame := itop(mut st, load(mut st, tcb, TC_FRAME))
    s0 := load(mut st, gepWord(mut st, sg, d), 0)
    kp := gepWord(mut st, frame, load(mut st, tcb, TC_KOFF))
    used := bin(mut st, BSub, load(mut st, gepWord(mut st, meta, d), W_BUMP), s0)
    // 小さい（使った量 ≤ KEEP_SMALL）なら今のワーカーの塊の鎖から（長さ 0 = 塊の印 — 返すのは返す側のワーカーの鎖へ）・大きければ頁に切り上げて mmap
    wk := globaladdr(mut st, st.wkG)
    bSmall := newBlock(mut st)
    bBig := newBlock(mut st)
    bGo := newBlock(mut st)
    a := param(mut st, bGo, TyI64)
    alen := param(mut st, bGo, TyI64)
    condbr(mut st, cmp(mut st, CLe, used, iconst(mut st, KEEP_SMALL)), bSmall, -1, bBig, -1)
    setCur(mut st, bSmall)
    bFill := newBlock(mut st)
    bPop := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, load(mut st, wk, WK_SLAB), iconst(mut st, 0)), bFill, -1, bPop, -1)
    setCur(mut st, bFill)
    slabFill(mut st, wk)
    br(mut st, bPop, -1)
    setCur(mut st, bPop)
    c0 := load(mut st, wk, WK_SLAB)
    store(mut st, wk, WK_SLAB, load(mut st, itop(mut st, c0), 0))
    br(mut st, bGo, list2(mut st, c0, iconst(mut st, 0)))
    setCur(mut st, bBig)
    klen := bin(mut st, BAnd, bin(mut st, BAdd, used, iconst(mut st, 4095)), iconst(mut st, -4096))
    br(mut st, bGo, list2(mut st, sysMmap(mut st, klen), klen))
    setCur(mut st, bGo)
    store(mut st, kp, KP_SLOT, a)
    store(mut st, kp, KP_USED, alen)
    // scope の記録の預かりの鎖へ積む（子は並行に終わる — CAS）
    rec := itop(mut st, load(mut st, frame, FR_SREC))
    pl := newBlock(mut st)
    pd := newBlock(mut st)
    br(mut st, pl, -1)
    setCur(mut st, pl)
    h := load(mut st, rec, SR_KEEP)
    store(mut st, kp, KP_NEXT, h)
    o := atomicCas(mut st, rec, SR_KEEP, h, ptoi(mut st, kp))
    condbr(mut st, cmp(mut st, CEq, o, h), pd, -1, pl, -1)
    setCur(mut st, pd)
    ret(mut st, itop(mut st, a))
}

// buildChanFree は rt.chan_free(ar, n): チャネルの枠の小アリーナ n 個（[基底, 使った量] の列 ar）をプールへ返す（段 6 P4-4 (B4)）
func buildChanFree(st mut St) {
    begin(mut st, st.rtChanFree)
    loop := newBlock(mut st)
    i := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    give := newBlock(mut st)
    next := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLt, i, 1), body, -1, done, -1)
    setCur(mut st, body)
    e := gepWord(mut st, 0, bin(mut st, BMul, i, iconst(mut st, 2)))
    a := load(mut st, e, 0)
    condbr(mut st, cmp(mut st, CNe, a, iconst(mut st, 0)), give, -1, next, -1)
    setCur(mut st, give)
    call(mut st, st.rtSlotGive, list2(mut st, a, load(mut st, e, 1)))
    store(mut st, e, 0, iconst(mut st, 0))
    br(mut st, next, -1)
    setCur(mut st, next)
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, i, iconst(mut st, 1))))
    setCur(mut st, done)
    ret(mut st, -1)
}

// Loan は regionBorrow の貸し借りの記録（IR の値: owner の退避の欄・今の表の欄・借りる前の今の表の値）
type Loan struct {
    sv int
    sp int
    bp int
    oldS int
    oldB int
}

// regionBorrow は止まっている task owner の自前の深度 d の region（スロットの基底と bump）を owner の退避（R1'）から今の表へ借りる
// （P3b-4 — 子の結果を scope の region へ・チャネルのペイロードを記録の region へ写す口。切替は owner の自前の深度を退避から戻すので、
// 今の表に書いただけでは消える — regionReturn が進んだ bump を退避へ書き戻す）。owner は今の task でないこと（今の task なら表が正）
func regionBorrow(st mut St, owner int, d int) Loan {
    meta := globaladdr(mut st, st.meta)
    sv := gepWord(mut st, owner, bin(mut st, BMul, d, iconst(mut st, 2)))
    sp := gepWord(mut st, globaladdr(mut st, st.slotsG), d)
    bp := gepWord(mut st, meta, d)
    oldS := load(mut st, sp, 0)
    oldB := load(mut st, bp, W_BUMP)
    store(mut st, sp, 0, load(mut st, sv, TC_SAVE))
    store(mut st, bp, W_BUMP, load(mut st, sv, TC_SAVE + 1))
    return Loan{sv: sv, sp: sp, bp: bp, oldS: oldS, oldB: oldB}
}

// regionReturn は借りた深度の進んだ bump を owner の退避へ書き戻し、今の表を借りる前へ戻す
func regionReturn(st mut St, l Loan) {
    store(mut st, l.sv, TC_SAVE + 1, load(mut st, l.bp, W_BUMP))
    store(mut st, l.sp, 0, l.oldS)
    store(mut st, l.bp, W_BUMP, l.oldB)
}

// taskHandover は今の task（from）の状態を退避し、to の状態を戻して今の task を to にする。region の自前の深度の範囲
// （(TC_BASE, own]）のスロットの基底と bump も退避 / 復元する（R1' — 中断した task の region に他の task が入らない）
func taskHandover(st mut St, from int, to int) {
    meta := globaladdr(mut st, st.meta)
    tg := globaladdr(mut st, st.trapG)
    sg := globaladdr(mut st, st.slotsG)
    ownF := load(mut st, sg, SLOT_OWN)
    store(mut st, from, TC_OWN, ownF)
    slotRange(mut st, from, load(mut st, from, TC_BASE), ownF, true)
    ownT := load(mut st, to, TC_OWN)
    slotRange(mut st, to, load(mut st, to, TC_BASE), ownT, false)
    store(mut st, sg, SLOT_OWN, ownT)
    store(mut st, meta, W_SLOT_SIZE, load(mut st, to, TC_SLOTSZ))
    store(mut st, meta, W_MAXD, load(mut st, to, TC_DEPTH))
    store(mut st, from, TC_DEPTH, load(mut st, meta, W_DEPTH))
    store(mut st, from, TC_DEST, load(mut st, meta, W_DEST))
    store(mut st, from, TC_ANCHOR, load(mut st, meta, W_ANCHOR))
    store(mut st, from, TC_TRAP, load(mut st, tg, TW_TOP))
    store(mut st, meta, W_DEPTH, load(mut st, to, TC_DEPTH))
    store(mut st, meta, W_DEST, load(mut st, to, TC_DEST))
    store(mut st, meta, W_ANCHOR, load(mut st, to, TC_ANCHOR))
    store(mut st, tg, TW_TOP, load(mut st, to, TC_TRAP))
    store(mut st, globaladdr(mut st, st.taskG), TK_CUR, ptoi(mut st, to))
    // 検査点の見直しの印は task ごと — 打ち切りの印が 1 度でも立ったプログラムなら、切り替えた先は次の検査点で見直す（段 6 P4-5）
    store(mut st, globaladdr(mut st, st.wkG), WK_CUT, load(mut st, globaladdr(mut st, st.cutGenG), 0))
}

// buildTaskNew は rt.task_new() ptr: プールの塊か、新しい塊（mmap + ガードページの mprotect）。予約の失敗は region の超過と同じ死（102）
func buildTaskNew(st mut St) {
    buildTaskNewFn(mut st, st.rtTaskNew, false)
    if st.poolOn {
        buildTaskNewFn(mut st, st.rtTaskNewIn, true)
    }
}

// buildTaskNewFn は rt.task_new（inPool = false）と rt.task_new_in（inPool = true — par.SpawnIn の入場: 第 3 実引数 = プールの節・節であふれたら 0 = shed）の本体
func buildTaskNewFn(st mut St, fnr FnRef, inPool bool) {
    begin(mut st, fnr)
    // 入場（段 6 P5-2 / P5-3 admit.sober — 実引数 = [spawn の点 × 4 + 根だけ × 2 + give（0 = 計上しない〔走らせ直し・ワーカーの起動の塊〕）, 宣言の上界（0 = 無し）]。
    // 根だけ = 外の scope の札へ内の budget: の scope の中から spawn する形〔節の寿命が子より短い〕）: 入場できなければ 0（縮退 / shed）
    adm := admitIn(mut st, 0, 1, if inPool { 2 } else { -1 })
    bGot := newBlock(mut st)
    got := param(mut st, bGot, TyPtr)
    tk := globaladdr(mut st, st.taskG)
    f := load(mut st, tk, TK_FREE)
    reuse := newBlock(mut st)
    fresh := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, f, iconst(mut st, 0)), reuse, -1, fresh, -1)
    setCur(mut st, reuse)
    fp := itop(mut st, f)
    store(mut st, tk, TK_FREE, load(mut st, fp, TC_NEXT))
    br(mut st, bGot, list1(mut st, fp))
    setCur(mut st, fresh)
    // M:N: 共有の予備の塊を先に（手元が尽きた — 他のワーカーで終わった塊が予備へ回る）
    bRes := newBlock(mut st)
    bMap := newBlock(mut st)
    condbr(mut st, mnOn(mut st), bRes, -1, bMap, -1)
    setCur(mut st, bRes)
    h := mnTcbReserve(mut st)
    bHit := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, h, iconst(mut st, 0)), bHit, -1, bMap, -1)
    setCur(mut st, bHit)
    br(mut st, bGot, list1(mut st, itop(mut st, h)))
    setCur(mut st, bMap)
    // 並び（頭の注）: TCB は スタックの終わり + 2 KiB（頁の途中）・その頁の下半分がスタックの頂上。TC_END × 8 は TCB の頁の残りと TASK_HEAD に収まる
    size := TASK_GUARD + TASK_STACK + 4096 + TASK_HEAD
    tcbOff := TASK_GUARD + TASK_STACK + 2048
    args := listN(mut st, 7)
    desugar.HeapSet(mut st.d, args + 1, iconst(mut st, 9))
    desugar.HeapSet(mut st.d, args + 2, iconst(mut st, 0))
    desugar.HeapSet(mut st.d, args + 3, iconst(mut st, size))
    desugar.HeapSet(mut st.d, args + 4, iconst(mut st, 3))
    desugar.HeapSet(mut st.d, args + 5, iconst(mut st, 16418))
    desugar.HeapSet(mut st.d, args + 6, iconst(mut st, -1))
    desugar.HeapSet(mut st.d, args + 7, iconst(mut st, 0))
    b := syscall(mut st, args)
    bad := newBlock(mut st)
    ok := newBlock(mut st)
    condbr(mut st, cmp(mut st, CUge, b, iconst(mut st, -4095)), bad, -1, ok, -1)
    setCur(mut st, bad)
    memPanic(mut st, PM_VA)
    setCur(mut st, ok)
    // mprotect(塊の先頭, TASK_GUARD, PROT_NONE)（失敗 = 写像の数の上限 vm.max_map_count — ガードなしで走らせず va_exhausted で死ぬ）
    pr := syscall(mut st, list4(mut st, iconst(mut st, 10), b, iconst(mut st, TASK_GUARD), iconst(mut st, 0)))
    bBadP := newBlock(mut st)
    okP := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, pr, iconst(mut st, 0)), bBadP, -1, okP, -1)
    setCur(mut st, bBadP)
    memPanic(mut st, PM_VA)
    setCur(mut st, okP)
    bp := itop(mut st, bin(mut st, BAdd, b, iconst(mut st, tcbOff)))
    // 計測口: 新しい塊の数（共有の予備・手元の鎖の取りこぼしは入力に比例して増える — 網）
    atomicXadd(mut st, globaladdr(mut st, st.pstatG), PS_TCBMAP, iconst(mut st, 1))
    store(mut st, bp, TC_TOP, ptoi(mut st, bp))
    store(mut st, bp, TC_ENTRY, funcaddr(mut st, st.rtTaskStart))
    br(mut st, bGot, list1(mut st, bp))
    setCur(mut st, bGot)
    store(mut st, got, TC_ADM, adm.e)
    store(mut st, got, TC_NODE, adm.node)
    store(mut st, got, TC_CNODE, adm.node)
    store(mut st, got, TC_DECL, 1)
    store(mut st, got, TC_SITE, bin(mut st, BSar, 0, iconst(mut st, 2)))
    store(mut st, got, TC_SLOTSZ, slotSizeFor(mut st, 1))
    if awFn(st.rtD3) != 0 {
        store(mut st, got, TC_WAIT, iconst(mut st, 0))
    }
    if dlFn(st.rtD3) != 0 {
        // 期限は親（spawn する今の task）の実効の値を継ぐ（deadline.sober）
        store(mut st, got, TC_DL, load(mut st, itop(mut st, load(mut st, tk, TK_CUR)), TC_DL))
    }
    ret(mut st, got)
}

// slotSizeFor は宣言の上界 decl（バイト — 0 = 無し）の子のスロットの大きさ: 既定 W_SLOT_DEF・decl が既定を超えれば decl 以上の 2 の冪（上限 MAX_SLOT_MB）
func slotSizeFor(st mut St, decl int) int {
    def := load(mut st, globaladdr(mut st, st.meta), W_SLOT_DEF)
    bUp := newBlock(mut st)
    loop := newBlock(mut st)
    s := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    done := newBlock(mut st)
    sz := param(mut st, done, TyI64)
    condbr(mut st, cmp(mut st, CGt, decl, def), bUp, -1, done, list1(mut st, def))
    setCur(mut st, bUp)
    br(mut st, loop, list1(mut st, def))
    setCur(mut st, loop)
    condbr(mut st, bin(mut st, BAnd, cmp(mut st, CLt, s, decl), cmp(mut st, CLt, s, iconst(mut st, MAX_SLOT_MB * 1048576))), body, -1, done, list1(mut st, s))
    setCur(mut st, body)
    br(mut st, loop, list1(mut st, bin(mut st, BShl, s, iconst(mut st, 1))))
    setCur(mut st, done)
    return sz
}

// buildTaskGo は rt.task_go(me, tcb)（spawn の切替点）: 選択 0 = 子を先に（親 me を積んで子へ切り替える — 既定）・1 = 親を先に（子を積むだけ）
func buildTaskGo(st mut St) {
    begin(mut st, st.rtTaskGo)
    pstatCall(mut st, st.rtPstatSpawn, list0(mut st))
    // M:N（ワーカー 2 以上 — 段 6 P4-4）: help-first の別の道
    bMn := newBlock(mut st)
    bCo := newBlock(mut st)
    condbr(mut st, mnOn(mut st), bMn, -1, bCo, -1)
    setCur(mut st, bMn)
    call(mut st, st.rtTaskGoMn, list2(mut st, 0, 1))
    ret(mut st, -1)
    setCur(mut st, bCo)
    // 出力の区間（P4-2 (O1)）: 子の区間を親の区間の直後へ — 切替の選択に依らず先に
    outFork(mut st, 0, 1)
    c := schedPickFast(mut st, iconst(mut st, 2))
    kid := newBlock(mut st)
    parB := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, c, iconst(mut st, 0)), kid, -1, parB, -1)
    setCur(mut st, kid)
    taskWake(mut st, 0)
    call(mut st, st.rtTaskSwitch, list2(mut st, 0, 1))
    ret(mut st, -1)
    setCur(mut st, parB)
    taskWake(mut st, 1)
    ret(mut st, -1)
}

// buildTaskSwitch は rt.task_switch(from, to): 引き継いで to を再開する（まだ走っていなければ to の塊のスタックで rt.task_start(to) を始める。
// from へ切り替えて戻ってきたら返る）
func buildTaskSwitch(st mut St) {
    begin(mut st, st.rtTaskSwitch)
    taskHandover(mut st, 0, 1)
    fresh := newBlock(mut st)
    resume := newBlock(mut st)
    done := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, load(mut st, 1, TC_STARTED), iconst(mut st, 0)), fresh, -1, resume, -1)
    setCur(mut st, fresh)
    store(mut st, 1, TC_STARTED, iconst(mut st, 1))
    tstart(mut st, 0, itop(mut st, load(mut st, 1, TC_TOP)), load(mut st, 1, TC_ENTRY), ptoi(mut st, 1))
    br(mut st, done, -1)
    setCur(mut st, resume)
    tswitch(mut st, 0, 1)
    br(mut st, done, -1)
    setCur(mut st, done)
    ret(mut st, -1)
}

// schedInit は SOBER_SCHED（数の列）と SOBER_SCHED_TRACE を @rt.sched へ（入口 — sp = 初期 rsp）
func schedInit(st mut St, sp int) {
    sg := globaladdr(mut st, st.schedG)
    store(mut st, sg, 2, envMb(mut st, sp, "SOBER_SCHED_TRACE=", 0, true))
    // SOBER_SCHED_SEED（schedfuzz — 段 6 P4-1）: 列が尽きた後の選択を乱択に（xorshift の状態 = 種。0 = 使わない — 既定のまま）
    store(mut st, sg, SCHED_SEED, envMb(mut st, sp, "SOBER_SCHED_SEED=", 0, false))
    argc := load(mut st, sp, 0)
    envp := gepWord(mut st, sp, bin(mut st, BAdd, argc, iconst(mut st, 2)))
    scan := newBlock(mut st)
    e := param(mut st, scan, TyPtr)
    chk := newBlock(mut st)
    next := newBlock(mut st)
    got := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, scan, list1(mut st, envp))
    setCur(mut st, scan)
    sv := load(mut st, e, 0)
    condbr(mut st, cmp(mut st, CEq, sv, iconst(mut st, 0)), done, -1, chk, -1)
    setCur(mut st, chk)
    s := itop(mut st, sv)
    key := bytes("SOBER_SCHED=")
    for i <- iter.Range(0, len(key)) {
        okc := newBlock(mut st)
        condbr(mut st, cmp(mut st, CEq, load8(mut st, gepByte(mut st, s, iconst(mut st, i)), 0), iconst(mut st, int(key[i]))), okc, -1, next, -1)
        setCur(mut st, okc)
    }
    br(mut st, got, -1)
    setCur(mut st, next)
    br(mut st, scan, list1(mut st, gepWord(mut st, e, iconst(mut st, 1))))
    // 値の読み: 数字は今の数に足し込み・それ以外（`,`）で区切り・NUL で終わり（列の長さ = 区切った数）
    setCur(mut st, got)
    lp := newBlock(mut st)
    iv := param(mut st, lp, TyI64)
    nv := param(mut st, lp, TyI64)
    cntv := param(mut st, lp, TyI64)
    br(mut st, lp, list3(mut st, iconst(mut st, len(key)), iconst(mut st, 0), iconst(mut st, 0)))
    setCur(mut st, lp)
    ch := load8(mut st, gepByte(mut st, s, iv), 0)
    isEnd := newBlock(mut st)
    notEnd := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, ch, iconst(mut st, 0)), isEnd, -1, notEnd, -1)
    setCur(mut st, isEnd)
    full := newBlock(mut st)
    stEnd := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, cntv, iconst(mut st, SCHED_CAP)), stEnd, -1, full, -1)
    setCur(mut st, stEnd)
    store(mut st, gepWord(mut st, sg, cntv), 3, nv)
    store(mut st, sg, 0, bin(mut st, BAdd, cntv, iconst(mut st, 1)))
    br(mut st, done, -1)
    setCur(mut st, full)
    store(mut st, sg, 0, cntv)
    br(mut st, done, -1)
    setCur(mut st, notEnd)
    isDig := newBlock(mut st)
    isSep := newBlock(mut st)
    condbr(mut st, bin(mut st, BAnd, cmp(mut st, CGe, ch, iconst(mut st, 48)), cmp(mut st, CLe, ch, iconst(mut st, 57))), isDig, -1, isSep, -1)
    setCur(mut st, isDig)
    br(mut st, lp, list3(mut st, bin(mut st, BAdd, iv, iconst(mut st, 1)), bin(mut st, BAdd, bin(mut st, BMul, nv, iconst(mut st, 10)), bin(mut st, BSub, ch, iconst(mut st, 48))), cntv))
    setCur(mut st, isSep)
    sepOk := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, cntv, iconst(mut st, SCHED_CAP)), sepOk, -1, done, -1)
    setCur(mut st, sepOk)
    store(mut st, gepWord(mut st, sg, cntv), 3, nv)
    br(mut st, lp, list3(mut st, bin(mut st, BAdd, iv, iconst(mut st, 1)), iconst(mut st, 0), bin(mut st, BAdd, cntv, iconst(mut st, 1))))
    setCur(mut st, done)
    // 選択の器を使うか（列がある・trace・種）
    act := bin(mut st, BOr, bin(mut st, BOr, cmp(mut st, CGt, load(mut st, sg, 0), iconst(mut st, 0)), cmp(mut st, CNe, load(mut st, sg, 2), iconst(mut st, 0))), cmp(mut st, CNe, load(mut st, sg, SCHED_SEED), iconst(mut st, 0)))
    store(mut st, sg, SCHED_ACT, act)
}

// schedPickFast は切替点の選択（選択の器を使わなければ rt.sched_pick を呼ばずに 0）
func schedPickFast(st mut St, n int) int {
    bCall := newBlock(mut st)
    bEnd := newBlock(mut st)
    v := param(mut st, bEnd, TyI64)
    condbr(mut st, cmp(mut st, CNe, load(mut st, globaladdr(mut st, st.schedG), SCHED_ACT), iconst(mut st, 0)), bCall, -1, bEnd, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, bCall)
    br(mut st, bEnd, list1(mut st, call(mut st, st.rtSchedPick, list1(mut st, n))))
    setCur(mut st, bEnd)
    return v
}

// buildSchedPick は rt.sched_pick(n): 選択肢 n（2 以上で切替点）の番号 — 列の次の値 mod n（尽きたら SOBER_SCHED_SEED の乱択か 0）。trace なら `#sched n v` を標準エラーへ
func buildSchedPick(st mut St) {
    begin(mut st, st.rtSchedPick)
    n := 0
    one := newBlock(mut st)
    many := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLe, n, iconst(mut st, 1)), one, -1, many, -1)
    setCur(mut st, one)
    ret(mut st, iconst(mut st, 0))
    setCur(mut st, many)
    sg := globaladdr(mut st, st.schedG)
    c := load(mut st, sg, 1)
    store(mut st, sg, 1, bin(mut st, BAdd, c, iconst(mut st, 1)))
    fromVec := newBlock(mut st)
    pick := newBlock(mut st)
    v := param(mut st, pick, TyI64)
    // 列が尽きたら: 種があれば乱択（schedfuzz — 段 6 P4-1）、無ければ 0（既定のスケジュール）
    afterVec := newBlock(mut st)
    rnd := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, c, load(mut st, sg, 0)), fromVec, -1, afterVec, -1)
    setCur(mut st, afterVec)
    seed := load(mut st, sg, SCHED_SEED)
    condbr(mut st, cmp(mut st, CEq, seed, iconst(mut st, 0)), pick, list1(mut st, iconst(mut st, 0)), rnd, -1)
    setCur(mut st, rnd)
    // xorshift64（13・7・17）の 1 歩
    x1 := bin(mut st, BXor, seed, bin(mut st, BShl, seed, iconst(mut st, 13)))
    x2 := bin(mut st, BXor, x1, bin(mut st, BAnd, bin(mut st, BSar, x1, iconst(mut st, 7)), iconst(mut st, 144115188075855871)))
    x3 := bin(mut st, BXor, x2, bin(mut st, BShl, x2, iconst(mut st, 17)))
    store(mut st, sg, SCHED_SEED, x3)
    // 遅延注入の口（出来事の点で 0〜63 回の空回し — ワーカー 1 では順を変えない。P4-4 で M:N の点へ同じ口を置く）
    spinN := bin(mut st, BAnd, bin(mut st, BSar, x3, iconst(mut st, 20)), iconst(mut st, 63))
    sl := newBlock(mut st)
    si := param(mut st, sl, TyI64)
    sb := newBlock(mut st)
    sd := newBlock(mut st)
    br(mut st, sl, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, sl)
    condbr(mut st, cmp(mut st, CLt, si, spinN), sb, -1, sd, -1)
    setCur(mut st, sb)
    br(mut st, sl, list1(mut st, bin(mut st, BAdd, si, iconst(mut st, 1))))
    setCur(mut st, sd)
    br(mut st, pick, list1(mut st, bin(mut st, BRem, bin(mut st, BAnd, x3, iconst(mut st, 2147483647)), n)))
    setCur(mut st, fromVec)
    br(mut st, pick, list1(mut st, bin(mut st, BRem, load(mut st, gepWord(mut st, sg, c), 3), n)))
    setCur(mut st, pick)
    tr := newBlock(mut st)
    out := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, load(mut st, sg, 2), iconst(mut st, 0)), tr, -1, out, -1)
    setCur(mut st, tr)
    meta := globaladdr(mut st, st.meta)
    fd0 := load(mut st, meta, W_FD)
    call(mut st, st.rtFlush, list0(mut st))
    store(mut st, meta, W_FD, iconst(mut st, 2))
    printLit(mut st, "#sched ")
    call(mut st, st.rtPint, list1(mut st, n))
    call(mut st, st.rtPchar, list1(mut st, iconst(mut st, ' ')))
    call(mut st, st.rtPint, list1(mut st, v))
    call(mut st, st.rtPchar, list1(mut st, iconst(mut st, '\n')))
    call(mut st, st.rtFlush, list0(mut st))
    store(mut st, meta, W_FD, fd0)
    br(mut st, out, -1)
    setCur(mut st, out)
    ret(mut st, v)
}

// buildTaskPop は rt.task_pop() ptr: 走れる積みから 1 つ外す（積みの上から rt.sched_pick(長さ) 番目 — 既定は一番上）。空なら 0
func buildTaskPop(st mut St) {
    begin(mut st, st.rtTaskPop)
    tk := globaladdr(mut st, st.taskG)
    head := load(mut st, tk, TK_READY)
    // 選択の器を使わない（既定のスケジュール）: 一番上を外すだけ（長さを数えない — 段 6 P4-4）
    bAct := newBlock(mut st)
    bTop := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, load(mut st, globaladdr(mut st, st.schedG), SCHED_ACT), iconst(mut st, 0)), bAct, -1, bTop, -1)
    setCur(mut st, bTop)
    bNone := newBlock(mut st)
    bHead := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, head, iconst(mut st, 0)), bNone, -1, bHead, -1)
    setCur(mut st, bNone)
    ret(mut st, itop(mut st, iconst(mut st, 0)))
    setCur(mut st, bHead)
    hp := itop(mut st, head)
    store(mut st, tk, TK_READY, load(mut st, hp, TC_NEXT))
    ret(mut st, hp)
    setCur(mut st, bAct)
    // 長さを数える
    cl := newBlock(mut st)
    p := param(mut st, cl, TyI64)
    nn := param(mut st, cl, TyI64)
    cb := newBlock(mut st)
    cd := newBlock(mut st)
    br(mut st, cl, list2(mut st, head, iconst(mut st, 0)))
    setCur(mut st, cl)
    condbr(mut st, cmp(mut st, CEq, p, iconst(mut st, 0)), cd, -1, cb, -1)
    setCur(mut st, cb)
    br(mut st, cl, list2(mut st, load(mut st, itop(mut st, p), TC_NEXT), bin(mut st, BAdd, nn, iconst(mut st, 1))))
    setCur(mut st, cd)
    empty := newBlock(mut st)
    some := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, nn, iconst(mut st, 0)), empty, -1, some, -1)
    setCur(mut st, empty)
    ret(mut st, itop(mut st, iconst(mut st, 0)))
    setCur(mut st, some)
    k := call(mut st, st.rtSchedPick, list1(mut st, nn))
    // k 番目を外す（prev = 一つ前・0 なら頭）
    wl := newBlock(mut st)
    q := param(mut st, wl, TyI64)
    prev := param(mut st, wl, TyI64)
    i := param(mut st, wl, TyI64)
    wb := newBlock(mut st)
    found := newBlock(mut st)
    br(mut st, wl, list3(mut st, head, iconst(mut st, 0), iconst(mut st, 0)))
    setCur(mut st, wl)
    condbr(mut st, cmp(mut st, CEq, i, k), found, -1, wb, -1)
    setCur(mut st, wb)
    br(mut st, wl, list3(mut st, load(mut st, itop(mut st, q), TC_NEXT), q, bin(mut st, BAdd, i, iconst(mut st, 1))))
    setCur(mut st, found)
    nxt := load(mut st, itop(mut st, q), TC_NEXT)
    atHead := newBlock(mut st)
    inMid := newBlock(mut st)
    fin := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, prev, iconst(mut st, 0)), atHead, -1, inMid, -1)
    setCur(mut st, atHead)
    store(mut st, tk, TK_READY, nxt)
    br(mut st, fin, -1)
    setCur(mut st, inMid)
    store(mut st, itop(mut st, prev), TC_NEXT, nxt)
    br(mut st, fin, -1)
    setCur(mut st, fin)
    ret(mut st, itop(mut st, q))
}

// buildTaskStart は rt.task_start(tcb): 罠を張って子を呼び、枠に状態（1 = 完了・2 = 死）と死因を書き、scope の記録の死の数を数え、
// 塊をプールへ返して起こし手へ切り替える（戻らない — .ll の経路だけは切替が無いので返る）
func buildTaskStart(st mut St) {
    begin(mut st, st.rtTaskStart)
    frame := itop(mut st, load(mut st, 0, TC_FRAME))
    r := trapCall(mut st, load(mut st, 0, TC_KID), fieldPtr(mut st, frame, FR_RES))
    fdDrainCall(mut st)
    orphEnd(mut st, 0)
    // 枠の公開（P4-2 — release / acquire の型: 結果〔子が sret で書き済み〕→ 死因 → 状態の順に書き、読み手は状態から読む。起こしは公開の後）
    tg := globaladdr(mut st, st.trapG)
    cause := bin(mut st, BOr, bin(mut st, BShl, load(mut st, tg, TW_SITE), iconst(mut st, 8)), load(mut st, tg, TW_CODE))
    store(mut st, frame, FR_CAUSE, cause)
    // 切られた（段 6 P4-5）か死んだか: 罠へ戻ったか打ち切りの印が 1 度でも立ったプログラムだけ遅い道（rt.cut_end — 判定・後ろの兄弟の印・開いている scope の子を待つ）
    cut := cutEnd(mut st, 0, frame, r)
    dead := bin(mut st, BMul, r, bin(mut st, BSub, iconst(mut st, 1), cut))
    store(mut st, frame, FR_STATE, bin(mut st, BAdd, bin(mut st, BAdd, r, iconst(mut st, 1)), bin(mut st, BMul, cut, bin(mut st, BSub, iconst(mut st, 2), r))))
    rec := itop(mut st, load(mut st, frame, FR_SREC))
    // 死の数は生存数より先に（出口は生存数 0 を見てから死の数を読む）。死因は数えない — 出口が生んだ順に枠を歩く（P4-2 — 到着順を捨てる）
    store(mut st, rec, SR_DEAD, bin(mut st, BAdd, load(mut st, rec, SR_DEAD), dead))
    poolDied(mut st, 0, dead)
    // 出力の区間を閉じる（頭なら溜めを出して進める — P4-2 (O1)）
    outClose(mut st, 0)
    // 入場で足した量を台帳へ返す（段 6 P5-2 — 起こした scope の出口より先に）
    admitReturn(mut st, 0)
    // 待っている親を起こす: Join / Try で待つ task（枠の FR_JOINER）・scope の出口で待つ task（生きている子が 0 になったら）
    jn := load(mut st, frame, FR_JOINER)
    bJ := newBlock(mut st)
    bJ2 := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, jn, iconst(mut st, 0)), bJ, -1, bJ2, -1)
    setCur(mut st, bJ)
    taskWake(mut st, itop(mut st, jn))
    store(mut st, frame, FR_JOINER, iconst(mut st, 0))
    br(mut st, bJ2, -1)
    setCur(mut st, bJ2)
    frameDrop(mut st, frame, rec, dead)
    // 生きている子の数を減らす（× 2 の符号 — 結果が 1 = 数 0 で出口が待っている印のときだけ起こす: waitLive）
    live := bin(mut st, BSub, load(mut st, rec, SR_LIVE), iconst(mut st, 2))
    store(mut st, rec, SR_LIVE, live)
    bW := newBlock(mut st)
    bW2 := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, live, iconst(mut st, 1)), bW, -1, bW2, -1)
    setCur(mut st, bW)
    taskWake(mut st, itop(mut st, load(mut st, rec, SR_WAITER)))
    br(mut st, bW2, -1)
    setCur(mut st, bW2)
    pstatCall(mut st, st.rtPstatEnd, list1(mut st, 0))
    admitEnd(mut st, 0, slotRelease(mut st, 0))
    nx := taskNext(mut st)
    tk := globaladdr(mut st, st.taskG)
    store(mut st, 0, TC_NEXT, load(mut st, tk, TK_FREE))
    store(mut st, tk, TK_FREE, ptoi(mut st, 0))
    call(mut st, st.rtTaskSwitch, list2(mut st, 0, nx))
    ret(mut st, -1)
}
