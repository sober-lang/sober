package lower

// 独自 SSA IR のモジュールと組み立て（src/ir.zig の Module / Builder の写し）。記録はヒープに積み、鎖で結ぶ:
// - 関数 [F_*]: 追加順の鎖（印字順）。値の番号は関数ごとの通し（関数引数が 0 から）
// - ブロック [B_*]: 関数ごとの追加順の鎖。番号 = 追加順（b0 が入口）。引数は [next, 値, 型] の鎖
// - 命令 [I_*]: ブロックごとの追加順の鎖。結果の値は I_RES（無しは -1）
// - スロット [next, 語数]・グローバル [G_*]
// 辺・呼び出し・syscall の引数は値の列（[n, 値…]、空は -1 でもよい）。関数・グローバル・ブロックは記録の番地で指す
// （印字は記録から名前・番号を引く — Zig 版の FuncId / GlobalId / BlockId の添字の代わり）。
// 値の型の表は持たない（印字に要るのは関数引数・ブロック引数の型だけで、それは記録に持つ）

import "desugar"

// 値の型
const TyI64 = 0
const TyPtr = 1

// 関数
const F_NEXT = 0
const F_NAME = 1
const F_PTYS = 2    // 引数の型の列（値 i = 引数 i）
const F_RET = 3     // -1 / TyI64 / TyPtr
const F_NVAL = 4
const F_BHEAD = 5
const F_BTAIL = 6
const F_NBLK = 7
const F_SHEAD = 8
const F_STAIL = 9
const F_NSLOT = 10
const F_EXPORT = 11
const F_TEXT = 12   // （空き — R24-2 のランタイムの IR テキストの番号だった。builder 版に戻して不要）
const F_LLVT = 13   // .ll の印字の表（llvm.sober の llPrepare が印字の前に作る）: 値の型
const F_LLINC = 14  // 入り辺
const F_LLCS = 15   // 定数の表（印字中に埋める — 伸ばさない）
const FSZ = 16

// ブロック
const B_NEXT = 0
const B_ID = 1
const B_PHEAD = 2
const B_PTAIL = 3
const B_IHEAD = 4
const B_ITAIL = 5
const B_TERM = 6
const B_X1 = 7
const B_X2 = 8
const B_X3 = 9
const B_X4 = 10
const B_X5 = 11
const B_PREDS = 12
const BSZ = 13

// 終端
const TmNone = 0
const TmBr = 1      // x1 = 行き先, x2 = 引数
const TmCondbr = 2  // x1 = 条件, x2 = then, x3 = then の引数, x4 = else, x5 = else の引数
const TmRet = 3     // x1 = 値（-1 = 無し）
const TmExit = 4    // x1 = code

// 命令
const I_NEXT = 0
const I_RES = 1
const I_OP = 2
const I_A = 3
const I_B = 4
const I_C = 5
const ISZ = 6

const OpConst = 1     // a = n
const OpBin = 2       // a = BinOp, b, c
const OpCmp = 3       // a = CmpOp, b, c
const OpLoad = 4      // a = p, b = off
const OpStore = 5     // a = p, b = off, c = v
const OpLoad8 = 6
const OpStore8 = 7
const OpGepW = 8      // a = p, b = idx
const OpGepB = 9
const OpPtoi = 10
const OpItop = 11
const OpSlotaddr = 12 // a = スロット番号
const OpGlobal = 13   // a = グローバルの記録
const OpCall = 14     // a = 関数の記録, b = 引数
const OpFuncaddr = 15 // a = 関数の記録
const OpCallI = 16    // a = callee, b = 引数, c = 結果の型（-1 / TyI64 / TyPtr）
const OpSyscall = 17  // a = 引数
const OpREnter = 18
const OpRDepth = 19
const OpRSetDepth = 20 // a = 値
const OpRAlloc = 21    // a = depth, b = words
const OpRBump = 22     // a = depth
const OpRReloc = 23    // a = hdr, b = cellw, c = floor

// BinOp / CmpOp（印字の綴りの順 — ir.zig の enum の順）
const BAdd = 0
const BSub = 1
const BMul = 2
const BDiv = 3
const BRem = 4
const BAnd = 5
const BOr = 6
const BXor = 7
const BShl = 8
const BSar = 9

const CEq = 0
const CNe = 1
const CLt = 2
const CLe = 3
const CGt = 4
const CGe = 5
const CUlt = 6
const CUge = 7

// グローバル
const G_NEXT = 0
const G_NAME = 1
const G_WORDS = 2
const G_INIT = 3  // 語の列（-1 = .bss）
const GSZ = 4

// ── モジュール ──

// addFunc は本体の無い関数を足す（本体は begin で後から組む — 前方参照の call に使う）。ptys は引数の型の列
@noinline
func addFunc(st mut St, name int, ptys int, rty int) int {
    f := recN(mut st, FSZ)
    st.d.h[f + F_NAME] = name
    st.d.h[f + F_PTYS] = ptys
    st.d.h[f + F_RET] = rty
    st.d.h[f + F_NVAL] = llen(mut st, ptys)
    st.d.h[f + F_NBLK] = 0
    st.d.h[f + F_NSLOT] = 0
    st.d.h[f + F_EXPORT] = 0
    st.d.h[f + F_TEXT] = -1
    tail := st.ftail
    if tail < 0 {
        st.fhead = f
    } else {
        st.d.h[tail + F_NEXT] = f
    }
    st.ftail = f
    return f
}

@noinline
func addGlobalInit(st mut St, name int, words int, init int) int {
    g := recN(mut st, GSZ)
    st.d.h[g + G_NAME] = name
    st.d.h[g + G_WORDS] = words
    st.d.h[g + G_INIT] = init
    tail := st.gtail
    if tail < 0 {
        st.ghead = g
    } else {
        st.d.h[tail + G_NEXT] = g
    }
    st.gtail = g
    return g
}

// ── 組み立て（cur = -1 は「到達しない」— 終端の直後。命令を足してはいけない）──

// begin は関数 f の入口ブロックを作って cur にする
@noinline
func begin(st mut St, f int) {
    st.fn = f
    b := newBlock(mut st)
    st.cur = b
}

@noinline
func newBlock(st mut St) int {
    f := st.fn
    b := recN(mut st, BSZ)
    st.d.h[b + B_ID] = st.d.h[f + F_NBLK]
    st.d.h[f + F_NBLK] = st.d.h[f + F_NBLK] + 1
    st.d.h[b + B_TERM] = TmNone
    st.d.h[b + B_PREDS] = 0
    tail := st.d.h[f + F_BTAIL]
    if tail < 0 {
        st.d.h[f + F_BHEAD] = b
    } else {
        st.d.h[tail + B_NEXT] = b
    }
    st.d.h[f + F_BTAIL] = b
    return b
}

func cur(st mut St) int {
    return st.cur
}

func setCur(st mut St, b int) {
    st.cur = b
}

func newValue(st mut St) int {
    f := st.fn
    v := st.d.h[f + F_NVAL]
    st.d.h[f + F_NVAL] = v + 1
    return v
}

// param はブロック blk に型 t の引数を足す
@noinline
func param(st mut St, blk int, t int) int {
    v := newValue(mut st)
    p := rec4(mut st, -1, v, t, 0)
    tail := st.d.h[blk + B_PTAIL]
    if tail < 0 {
        st.d.h[blk + B_PHEAD] = p
    } else {
        st.d.h[tail] = p
    }
    st.d.h[blk + B_PTAIL] = p
    return v
}

@noinline
func newSlot(st mut St, words int) int {
    f := st.fn
    s := rec4(mut st, -1, words, 0, 0)
    tail := st.d.h[f + F_STAIL]
    if tail < 0 {
        st.d.h[f + F_SHEAD] = s
    } else {
        st.d.h[tail] = s
    }
    st.d.h[f + F_STAIL] = s
    n := st.d.h[f + F_NSLOT]
    st.d.h[f + F_NSLOT] = n + 1
    return n
}

// push は cur に命令を足す（res: 結果の値を持つか）。結果の値（無しは -1）
@noinline
func push(st mut St, res bool, op int, a int, b int, c int) int {
    r := if res { newValue(mut st) } else { -1 }
    at := len(st.d.h)
    st.d.h = append(st.d.h, -1)
    st.d.h = append(st.d.h, r)
    st.d.h = append(st.d.h, op)
    st.d.h = append(st.d.h, a)
    st.d.h = append(st.d.h, b)
    st.d.h = append(st.d.h, c)
    blk := st.cur
    tail := st.d.h[blk + B_ITAIL]
    if tail < 0 {
        st.d.h[blk + B_IHEAD] = at
    } else {
        st.d.h[tail] = at
    }
    st.d.h[blk + B_ITAIL] = at
    return r
}

func iconst(st mut St, n int) int {
    return push(mut st, true, OpConst, n, 0, 0)
}

func bin(st mut St, op int, a int, b int) int {
    return push(mut st, true, OpBin, op, a, b)
}

func cmp(st mut St, op int, a int, b int) int {
    return push(mut st, true, OpCmp, op, a, b)
}

func load(st mut St, p int, off int) int {
    return push(mut st, true, OpLoad, p, off, 0)
}

func store(st mut St, p int, off int, v int) {
    push(mut st, false, OpStore, p, off, v)
}

func load8(st mut St, p int, off int) int {
    return push(mut st, true, OpLoad8, p, off, 0)
}

func store8(st mut St, p int, off int, v int) {
    push(mut st, false, OpStore8, p, off, v)
}

func gepWord(st mut St, p int, idx int) int {
    return push(mut st, true, OpGepW, p, idx, 0)
}

func gepByte(st mut St, p int, idx int) int {
    return push(mut st, true, OpGepB, p, idx, 0)
}

func ptoi(st mut St, p int) int {
    return push(mut st, true, OpPtoi, p, 0, 0)
}

func itop(st mut St, v int) int {
    return push(mut st, true, OpItop, v, 0, 0)
}

func slotaddr(st mut St, s int) int {
    return push(mut st, true, OpSlotaddr, s, 0, 0)
}

func globaladdr(st mut St, g int) int {
    return push(mut st, true, OpGlobal, g, 0, 0)
}

// call は関数 f を呼ぶ（結果は f の ret — 無ければ -1）
func call(st mut St, f int, args int) int {
    return push(mut st, st.d.h[f + F_RET] >= 0, OpCall, f, args, 0)
}

func funcaddr(st mut St, f int) int {
    return push(mut st, true, OpFuncaddr, f, 0, 0)
}

func callIndirect(st mut St, callee int, args int, rty int) int {
    return push(mut st, rty >= 0, OpCallI, callee, args, rty)
}

func syscall(st mut St, args int) int {
    return push(mut st, true, OpSyscall, args, 0, 0)
}

func regionEnter(st mut St) {
    push(mut st, false, OpREnter, 0, 0, 0)
}

func regionDepth(st mut St) int {
    return push(mut st, true, OpRDepth, 0, 0, 0)
}

func regionSetDepth(st mut St, v int) {
    push(mut st, false, OpRSetDepth, v, 0, 0)
}

func regionAlloc(st mut St, d int, w int) int {
    return push(mut st, true, OpRAlloc, d, w, 0)
}

func regionBump(st mut St, d int) int {
    return push(mut st, true, OpRBump, d, 0, 0)
}

func regionRelocate(st mut St, hdr int, cellw int, floor int) {
    push(mut st, false, OpRReloc, hdr, cellw, floor)
}

// ── 終端（cur を -1 にする）──

@noinline
func terminate(st mut St, t int, x1 int, x2 int, x3 int, x4 int, x5 int) {
    blk := st.cur
    st.d.h[blk + B_TERM] = t
    st.d.h[blk + B_X1] = x1
    st.d.h[blk + B_X2] = x2
    st.d.h[blk + B_X3] = x3
    st.d.h[blk + B_X4] = x4
    st.d.h[blk + B_X5] = x5
    st.cur = -1
}

// br は to へ（args = 値の列か -1）。行き先の前任数を数える（Zig の edge）
@noinline
func br(st mut St, to int, args int) {
    st.d.h[to + B_PREDS] = st.d.h[to + B_PREDS] + 1
    terminate(mut st, TmBr, to, args, 0, 0, 0)
}

@noinline
func condbr(st mut St, c int, t int, targs int, e int, eargs int) {
    st.d.h[t + B_PREDS] = st.d.h[t + B_PREDS] + 1
    st.d.h[e + B_PREDS] = st.d.h[e + B_PREDS] + 1
    terminate(mut st, TmCondbr, c, t, targs, e, eargs)
}

func ret(st mut St, v int) {
    terminate(mut st, TmRet, v, 0, 0, 0, 0)
}

func exit(st mut St, code int) {
    terminate(mut st, TmExit, code, 0, 0, 0, 0)
}

// ── 印字（src/ir.zig の print — テキスト形式の正）──

@noinline
func lit(out mut []int, w string) {
    b := bytes(w)
    mut i := 0
    while i < len(b) {
        out = append(out, b[i])
        i += 1
    }
}

// num は 10 進（負号あり。最小値でも符号反転しない — 剰余を負のまま使う）
@noinline
func num(out mut []int, n int) {
    if n < 0 {
        out = append(out, 45)
    }
    q := n / 10
    aq := if q < 0 { 0 - q } else { q }
    mut p := 1
    while p <= aq {
        p = p * 10
    }
    while p > 0 {
        d := n / p % 10
        out = append(out, 48 + (if d < 0 { 0 - d } else { d }))
        p = p / 10
    }
}

func val(out mut []int, v int) {
    out = append(out, 37)
    num(mut out, v)
}

func tyName(out mut []int, t int) {
    if t == TyPtr {
        lit(mut out, "ptr")
    } else {
        lit(mut out, "i64")
    }
}

// isNameChar は名前の素の文字（これ以外を含む名前は `@"..."` に引用する — ir.zig の isNameChar）
func isNameChar(c int) bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 || c == 46 || c == 35 || c == 47 || c == 36
}

func printName(st mut St, out mut []int, s int) {
    n := st.d.h[s]
    mut bare := n > 0
    mut i := 0
    while i < n {
        if !isNameChar(st.d.h[s + 1 + i]) {
            bare = false
        }
        i += 1
    }
    out = append(out, 64)
    if bare {
        i = 0
        while i < n {
            out = append(out, st.d.h[s + 1 + i])
            i += 1
        }
        return
    }
    out = append(out, 34)
    i = 0
    while i < n {
        c := st.d.h[s + 1 + i]
        if c == 34 || c == 92 {
            out = append(out, 92)
        }
        out = append(out, c)
        i += 1
    }
    out = append(out, 34)
}

// vals は値の列（-1 は空）を ", " 区切りで
func vals(st mut St, out mut []int, l int) {
    if l < 0 {
        return
    }
    mut i := 0
    while i < st.d.h[l] {
        if i > 0 {
            lit(mut out, ", ")
        }
        val(mut out, st.d.h[l + 1 + i])
        i += 1
    }
}

func binName(out mut []int, op int) {
    if op == BAdd {
        lit(mut out, "add")
    } else if op == BSub {
        lit(mut out, "sub")
    } else if op == BMul {
        lit(mut out, "mul")
    } else if op == BDiv {
        lit(mut out, "div")
    } else if op == BRem {
        lit(mut out, "rem")
    } else if op == BAnd {
        lit(mut out, "and_")
    } else if op == BOr {
        lit(mut out, "or_")
    } else if op == BXor {
        lit(mut out, "xor")
    } else if op == BShl {
        lit(mut out, "shl")
    } else {
        lit(mut out, "sar")
    }
}

func cmpName(out mut []int, op int) {
    if op == CEq {
        lit(mut out, "eq")
    } else if op == CNe {
        lit(mut out, "ne")
    } else if op == CLt {
        lit(mut out, "lt")
    } else if op == CLe {
        lit(mut out, "le")
    } else if op == CGt {
        lit(mut out, "gt")
    } else if op == CGe {
        lit(mut out, "ge")
    } else if op == CUlt {
        lit(mut out, "ult")
    } else {
        lit(mut out, "uge")
    }
}

// two は "%a, %b"
func two(out mut []int, a int, b int) {
    val(mut out, a)
    lit(mut out, ", ")
    val(mut out, b)
}

// mem は "%p[off]"
func mem(out mut []int, p int, off int) {
    val(mut out, p)
    out = append(out, 91)
    num(mut out, off)
    out = append(out, 93)
}

func printOp(st mut St, out mut []int, i int) {
    op := st.d.h[i + I_OP]
    a := st.d.h[i + I_A]
    b := st.d.h[i + I_B]
    c := st.d.h[i + I_C]
    if op == OpConst {
        lit(mut out, "const ")
        num(mut out, a)
        return
    }
    if op == OpBin {
        binName(mut out, a)
        out = append(out, 32)
        two(mut out, b, c)
        return
    }
    if op == OpCmp {
        cmpName(mut out, a)
        out = append(out, 32)
        two(mut out, b, c)
        return
    }
    if op == OpLoad {
        lit(mut out, "load.i64 ")
        mem(mut out, a, b)
        return
    }
    if op == OpStore || op == OpStore8 {
        lit(mut out, if op == OpStore { "store " } else { "store8 " })
        mem(mut out, a, b)
        lit(mut out, ", ")
        val(mut out, c)
        return
    }
    if op == OpLoad8 {
        lit(mut out, "load8 ")
        mem(mut out, a, b)
        return
    }
    if op == OpGepW || op == OpGepB {
        lit(mut out, if op == OpGepW { "gep.word " } else { "gep.byte " })
        two(mut out, a, b)
        return
    }
    if op == OpPtoi {
        lit(mut out, "ptoi ")
        val(mut out, a)
        return
    }
    if op == OpItop {
        lit(mut out, "itop ")
        val(mut out, a)
        return
    }
    if op == OpSlotaddr {
        lit(mut out, "slotaddr s")
        num(mut out, a)
        return
    }
    if op == OpGlobal {
        lit(mut out, "globaladdr ")
        printName(mut st, mut out, st.d.h[a + G_NAME])
        return
    }
    if op == OpCall {
        lit(mut out, "call ")
        printName(mut st, mut out, st.d.h[a + F_NAME])
        out = append(out, 40)
        vals(mut st, mut out, b)
        out = append(out, 41)
        return
    }
    if op == OpFuncaddr {
        lit(mut out, "funcaddr ")
        printName(mut st, mut out, st.d.h[a + F_NAME])
        return
    }
    if op == OpCallI {
        lit(mut out, "call.indirect")
        if c >= 0 {
            out = append(out, 46)
            tyName(mut out, c)
        }
        out = append(out, 32)
        val(mut out, a)
        out = append(out, 40)
        vals(mut st, mut out, b)
        out = append(out, 41)
        return
    }
    if op == OpSyscall {
        lit(mut out, "syscall(")
        vals(mut st, mut out, a)
        out = append(out, 41)
        return
    }
    if op == OpREnter {
        lit(mut out, "region.enter")
        return
    }
    if op == OpRDepth {
        lit(mut out, "region.depth")
        return
    }
    if op == OpRSetDepth {
        lit(mut out, "region.setdepth ")
        val(mut out, a)
        return
    }
    if op == OpRAlloc {
        lit(mut out, "region.alloc ")
        two(mut out, a, b)
        return
    }
    if op == OpRBump {
        lit(mut out, "region.bump ")
        val(mut out, a)
        return
    }
    lit(mut out, "region.relocate ")
    val(mut out, a)
    lit(mut out, ", ")
    num(mut out, b)
    lit(mut out, ", ")
    val(mut out, c)
}

func printEdge(st mut St, out mut []int, to int, args int) {
    out = append(out, 98)
    num(mut out, st.d.h[to + B_ID])
    if args >= 0 && st.d.h[args] > 0 {
        out = append(out, 40)
        vals(mut st, mut out, args)
        out = append(out, 41)
    }
}

func printTerm(st mut St, out mut []int, b int) {
    t := st.d.h[b + B_TERM]
    x1 := st.d.h[b + B_X1]
    if t == TmBr {
        lit(mut out, "br ")
        printEdge(mut st, mut out, x1, st.d.h[b + B_X2])
    } else if t == TmCondbr {
        lit(mut out, "condbr ")
        val(mut out, x1)
        lit(mut out, ", ")
        printEdge(mut st, mut out, st.d.h[b + B_X2], st.d.h[b + B_X3])
        lit(mut out, ", ")
        printEdge(mut st, mut out, st.d.h[b + B_X4], st.d.h[b + B_X5])
    } else if t == TmRet {
        if x1 >= 0 {
            lit(mut out, "ret ")
            val(mut out, x1)
        } else {
            lit(mut out, "ret")
        }
    } else if t == TmExit {
        lit(mut out, "exit ")
        num(mut out, x1)
    } else {
        lit(mut out, "<unterminated>")
    }
}

func printFunc(st mut St, out mut []int, f int) {
    lit(mut out, if st.d.h[f + F_EXPORT] != 0 { "\nexport func " } else { "\nfunc " })
    printName(mut st, mut out, st.d.h[f + F_NAME])
    out = append(out, 40)
    ptys := st.d.h[f + F_PTYS]
    mut i := 0
    while i < st.d.h[ptys] {
        if i > 0 {
            lit(mut out, ", ")
        }
        val(mut out, i)
        out = append(out, 32)
        tyName(mut out, st.d.h[ptys + 1 + i])
        i += 1
    }
    out = append(out, 41)
    if st.d.h[f + F_RET] >= 0 {
        out = append(out, 32)
        tyName(mut out, st.d.h[f + F_RET])
    }
    lit(mut out, " {\n")
    mut s := st.d.h[f + F_SHEAD]
    mut si := 0
    while s >= 0 {
        lit(mut out, "  slot s")
        num(mut out, si)
        lit(mut out, " [")
        num(mut out, st.d.h[s + 1])
        lit(mut out, "]\n")
        si += 1
        s = st.d.h[s]
    }
    mut b := st.d.h[f + F_BHEAD]
    while b >= 0 {
        out = append(out, 98)
        num(mut out, st.d.h[b + B_ID])
        mut p := st.d.h[b + B_PHEAD]
        if p >= 0 {
            out = append(out, 40)
            mut first := true
            while p >= 0 {
                if !first {
                    lit(mut out, ", ")
                }
                first = false
                val(mut out, st.d.h[p + 1])
                out = append(out, 32)
                tyName(mut out, st.d.h[p + 2])
                p = st.d.h[p]
            }
            out = append(out, 41)
        }
        lit(mut out, ":\n")
        mut ins := st.d.h[b + B_IHEAD]
        while ins >= 0 {
            lit(mut out, "  ")
            if st.d.h[ins + I_RES] >= 0 {
                val(mut out, st.d.h[ins + I_RES])
                lit(mut out, " = ")
            }
            printOp(mut st, mut out, ins)
            out = append(out, 10)
            ins = st.d.h[ins + I_NEXT]
        }
        lit(mut out, "  ")
        printTerm(mut st, mut out, b)
        out = append(out, 10)
        b = st.d.h[b + B_NEXT]
    }
    lit(mut out, "}\n")
}

// printModule はモジュール全体のテキスト（globals → 関数の順）
func printModule(st mut St, out mut []int) {
    mut g := st.ghead
    while g >= 0 {
        lit(mut out, "global ")
        printName(mut st, mut out, st.d.h[g + G_NAME])
        lit(mut out, " [")
        num(mut out, st.d.h[g + G_WORDS])
        out = append(out, 93)
        init := st.d.h[g + G_INIT]
        if init >= 0 {
            lit(mut out, " = {")
            mut i := 0
            while i < st.d.h[init] {
                if i > 0 {
                    lit(mut out, ", ")
                }
                num(mut out, st.d.h[init + 1 + i])
                i += 1
            }
            out = append(out, 125)
        }
        out = append(out, 10)
        g = st.d.h[g + G_NEXT]
    }
    mut f := st.fhead
    while f >= 0 {
        printFunc(mut st, mut out, f)
        f = st.d.h[f + F_NEXT]
    }
}
