package lower

// IR で書いたランタイム（src/ir_rt.zig・src/ir_rt_io.zig の写し — 同じ命令列を同じ順で組む。IR テキストと .ll が Zig 版とバイト一致する）。
// メタ領域 @rt.meta の配置（語）: [0] 深度、[1 + d] 深度 d の bump、FD、ERRNO、LINE_LEN、SLOTS、SLOT_SIZE、LINE（行バッファ）、ACC + d、ARGV（入口の初期 rsp）。
// --mem-trace（rt.memtrace）は写していない（Zig 版の既定の出力と同じ形だけ）。
// builder の小道具（ir.sober の push / newBlock 等）は @noinline — 呼び出し点ごとに展開されると、このファイルだけで lowerdump のビルドが
// 3 分・4GB を超えた（F-29。R24-2 の「IR テキストで持つ」回避はこれで解消）

import "desugar"

const MAX_DEPTH = 1024
const DEFAULT_SLOT_MB = 4096
const MAX_SLOT_MB = 65536
const LINE_CAP = 4096
const W_DEPTH = 0
const W_BUMP = 1
const W_FD = 1026
const W_ERRNO = 1027
const W_LINE_LEN = 1028
const W_SLOTS = 1029
const W_SLOT_SIZE = 1030
const W_LINE = 1031
const W_ARGV = 2568
const META_WORDS = 2569
const PANIC = 101
const PANIC_MEM = 102
const IO_BUF = 4096

// installRt はランタイムのグローバルと関数を足して本体を組む（ir_rt.install と同じ順）
func installRt(st mut St) {
    hv1 := addGlobalInit(mut st, strLit(mut st, "rt.meta"), META_WORDS, -1)
    st.meta = hv1
    hv2 := addFunc(mut st, strLit(mut st, "rt.flush"), list0(mut st), -1)
    st.rtFlush = hv2
    hv3 := addFunc(mut st, strLit(mut st, "rt.print_char"), list1(mut st, TyI64), -1)
    st.rtPchar = hv3
    hv4 := addFunc(mut st, strLit(mut st, "rt.print_int"), list1(mut st, TyI64), -1)
    st.rtPint = hv4
    hv5 := addFunc(mut st, strLit(mut st, "rt.region_enter"), list0(mut st), -1)
    st.rtRenter = hv5
    hv6 := addFunc(mut st, strLit(mut st, "rt.region_alloc"), list2(mut st, TyI64, TyI64), TyPtr)
    st.rtRalloc = hv6
    hv7 := addFunc(mut st, strLit(mut st, "rt.region_relocate"), list3(mut st, TyPtr, TyI64, TyI64), -1)
    st.rtReloc = hv7
    hv8 := addFunc(mut st, strLit(mut st, "rt.copy"), list3(mut st, TyPtr, TyPtr, TyI64), -1)
    st.rtCopy = hv8
    hv9 := addFunc(mut st, strLit(mut st, "rt.str_eq"), list2(mut st, TyPtr, TyPtr), TyI64)
    st.rtStreq = hv9
    hv10 := addFunc(mut st, strLit(mut st, "rt.map_find"), list4(mut st, TyPtr, TyPtr, TyI64, TyI64), TyI64)
    st.rtMapfind = hv10
    hv11 := addFunc(mut st, strLit(mut st, "rt.print_str"), list1(mut st, TyPtr), -1)
    st.rtPstr = hv11
    buildFlush(mut st)
    buildPrintChar(mut st)
    buildPrintInt(mut st)
    buildRegionEnter(mut st)
    buildRegionAlloc(mut st)
    buildCopy(mut st)
    buildRelocate(mut st)
    buildStrEq(mut st)
    buildMapFind(mut st)
    buildPrintStr(mut st)
    installIo(mut st)
}

// buildEntry は入口 sober_entry(sp): アリーナを予約し、深度 0・出力 fd 1 で main を呼び、exit(0)（ir_rt.buildEntry）。
// main_int（`func main() int`）なら戻り値が終了コード（0〜255 の外は panic 101 — exit_group(code)）。
// sp は _start の初期 rsp — 環境変数 SOBER_REGION_MB を読み、W_ARGV に置く（read_args が読む）。予約の失敗（1MiB でも断られる）は exit 102
func buildEntry(st mut St, main_fn int, main_int bool) {
    f := addFunc(mut st, strLit(mut st, "sober_entry"), list1(mut st, TyPtr), -1)
    st.d.h[f + F_EXPORT] = 1
    begin(mut st, f)
    sp := 0
    meta := globaladdr(mut st, st.meta)
    mb := envSlotMb(mut st, sp)
    // reserve(mb): mmap(NULL, mb MiB * MAX_DEPTH, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0)
    reserve := newBlock(mut st)
    c := param(mut st, reserve, TyI64)
    shrink := newBlock(mut st)
    fail := newBlock(mut st)
    ok := newBlock(mut st)
    br(mut st, reserve, list1(mut st, mb))
    setCur(mut st, reserve)
    slot := bin(mut st, BShl, c, iconst(mut st, 20))
    a0 := iconst(mut st, 9)
    a1 := iconst(mut st, 0)
    a2 := bin(mut st, BMul, slot, iconst(mut st, MAX_DEPTH))
    a3 := iconst(mut st, 3)
    a4 := iconst(mut st, 16418)
    a5 := iconst(mut st, -1)
    a6 := iconst(mut st, 0)
    args := listN(mut st, 7)
    st.d.h[args + 1] = a0
    st.d.h[args + 2] = a1
    st.d.h[args + 3] = a2
    st.d.h[args + 4] = a3
    st.d.h[args + 5] = a4
    st.d.h[args + 6] = a5
    st.d.h[args + 7] = a6
    bs := syscall(mut st, args)
    // 失敗は -4095..-1（符号なしで最上位の 4095 個）
    condbr(mut st, cmp(mut st, CUge, bs, iconst(mut st, -4095)), shrink, -1, ok, -1)
    setCur(mut st, shrink)
    condbr(mut st, cmp(mut st, CGt, c, iconst(mut st, 1)), reserve, list1(mut st, bin(mut st, BSar, c, iconst(mut st, 1))), fail, -1)
    setCur(mut st, fail)
    exit(mut st, PANIC_MEM)
    setCur(mut st, ok)
    store(mut st, meta, W_SLOTS, bs)
    store(mut st, meta, W_SLOT_SIZE, slot)
    store(mut st, meta, W_DEPTH, iconst(mut st, 0))
    store(mut st, meta, W_FD, iconst(mut st, 1))
    store(mut st, meta, W_ARGV, ptoi(mut st, sp))
    code := call(mut st, main_fn, list0(mut st))
    if main_int {
        bad := newBlock(mut st)
        good := newBlock(mut st)
        condbr(mut st, cmp(mut st, CUge, code, iconst(mut st, 256)), bad, -1, good, -1)
        setCur(mut st, bad)
        exit(mut st, PANIC)
        setCur(mut st, good)
        syscall(mut st, list2(mut st, iconst(mut st, 231), code))
    }
    exit(mut st, 0)
}

// envSlotMb は環境変数 SOBER_REGION_MB の値（MiB — 無い・空・0・数字以外・MAX_SLOT_MB 超なら既定）。戻ると cur は値が決まったブロック
func envSlotMb(st mut St, sp int) int {
    argc := load(mut st, sp, 0)
    envp := gepWord(mut st, sp, bin(mut st, BAdd, argc, iconst(mut st, 2)))
    scan := newBlock(mut st)
    e := param(mut st, scan, TyPtr)
    done := newBlock(mut st)
    res := param(mut st, done, TyI64)
    got := newBlock(mut st)
    next := newBlock(mut st)
    br(mut st, scan, list1(mut st, envp))
    // scan(e): *e == 0 なら既定、そうでなければ鍵の接頭辞を 1 バイトずつ照合（鍵は定数なので展開）
    setCur(mut st, scan)
    sv := load(mut st, e, 0)
    chk := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, sv, iconst(mut st, 0)), done, list1(mut st, iconst(mut st, DEFAULT_SLOT_MB)), chk, -1)
    setCur(mut st, chk)
    s := itop(mut st, sv)
    key := bytes("SOBER_REGION_MB=")
    mut i := 0
    while i < len(key) {
        c_ok := newBlock(mut st)
        ch := load8(mut st, gepByte(mut st, s, iconst(mut st, i)), 0)
        condbr(mut st, cmp(mut st, CEq, ch, iconst(mut st, key[i])), c_ok, -1, next, -1)
        setCur(mut st, c_ok)
        i += 1
    }
    br(mut st, got, -1)
    // next: 次の環境変数
    setCur(mut st, next)
    br(mut st, scan, list1(mut st, gepWord(mut st, e, iconst(mut st, 1))))
    // got: 値の 10 進（val(n, i)）。終わり（NUL）で n が 1〜MAX_SLOT_MB なら採用、それ以外は既定
    setCur(mut st, got)
    vb := newBlock(mut st)
    n := param(mut st, vb, TyI64)
    iv := param(mut st, vb, TyI64)
    br(mut st, vb, list2(mut st, iconst(mut st, 0), iconst(mut st, len(key))))
    setCur(mut st, vb)
    ch := load8(mut st, gepByte(mut st, s, iv), 0)
    end := newBlock(mut st)
    dig := newBlock(mut st)
    dig2 := newBlock(mut st)
    acc := newBlock(mut st)
    use := newBlock(mut st)
    dflt := iconst(mut st, DEFAULT_SLOT_MB)
    condbr(mut st, cmp(mut st, CEq, ch, iconst(mut st, 0)), end, -1, dig, -1)
    setCur(mut st, end)
    condbr(mut st, cmp(mut st, CGt, n, iconst(mut st, 0)), use, -1, done, list1(mut st, dflt))
    setCur(mut st, use)
    br(mut st, done, list1(mut st, n))
    setCur(mut st, dig)
    condbr(mut st, cmp(mut st, CGe, ch, iconst(mut st, 48)), dig2, -1, done, list1(mut st, dflt))
    setCur(mut st, dig2)
    condbr(mut st, cmp(mut st, CLe, ch, iconst(mut st, 57)), acc, -1, done, list1(mut st, dflt))
    setCur(mut st, acc)
    n2 := bin(mut st, BAdd, bin(mut st, BMul, n, iconst(mut st, 10)), bin(mut st, BSub, ch, iconst(mut st, 48)))
    more := newBlock(mut st)
    condbr(mut st, cmp(mut st, CGt, n2, iconst(mut st, MAX_SLOT_MB)), done, list1(mut st, dflt), more, -1)
    setCur(mut st, more)
    br(mut st, vb, list2(mut st, n2, bin(mut st, BAdd, iv, iconst(mut st, 1))))
    setCur(mut st, done)
    return res
}

// buildFlush は write(fd, LINE, len)。短い書き込みは続きから、EINTR は再試行、失敗は捨てる。最後に len = 0
func buildFlush(st mut St) {
    begin(mut st, st.rtFlush)
    meta := globaladdr(mut st, st.meta)
    loop := newBlock(mut st)
    done_w := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, loop)
    ln := load(mut st, meta, W_LINE_LEN)
    rest := bin(mut st, BSub, ln, done_w)
    condbr(mut st, cmp(mut st, CGt, rest, iconst(mut st, 0)), body, -1, done, -1)
    setCur(mut st, body)
    off := bin(mut st, BAdd, iconst(mut st, W_LINE * 8), done_w)
    buf := ptoi(mut st, gepByte(mut st, meta, off))
    fd := load(mut st, meta, W_FD)
    r := syscall(mut st, list4(mut st, iconst(mut st, 1), fd, buf, rest))
    retry := newBlock(mut st)
    not_intr := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, r, iconst(mut st, -4)), retry, -1, not_intr, -1)
    setCur(mut st, retry)
    br(mut st, loop, list1(mut st, done_w))
    setCur(mut st, not_intr)
    ok := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLe, r, iconst(mut st, 0)), done, -1, ok, -1)
    setCur(mut st, ok)
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, done_w, r)))
    setCur(mut st, done)
    store(mut st, meta, W_LINE_LEN, iconst(mut st, 0))
    ret(mut st, -1)
}

// buildPrintChar は行バッファへ 1 バイト積む。改行か満杯で flush
func buildPrintChar(st mut St) {
    begin(mut st, st.rtPchar)
    c := 0
    meta := globaladdr(mut st, st.meta)
    ln := load(mut st, meta, W_LINE_LEN)
    p := gepByte(mut st, meta, bin(mut st, BAdd, iconst(mut st, W_LINE * 8), ln))
    store8(mut st, p, 0, c)
    len1 := bin(mut st, BAdd, ln, iconst(mut st, 1))
    store(mut st, meta, W_LINE_LEN, len1)
    do_flush := newBlock(mut st)
    check_full := newBlock(mut st)
    done := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, c, iconst(mut st, 10)), do_flush, -1, check_full, -1)
    setCur(mut st, check_full)
    condbr(mut st, cmp(mut st, CGe, len1, iconst(mut st, LINE_CAP)), do_flush, -1, done, -1)
    setCur(mut st, do_flush)
    call(mut st, st.rtFlush, list0(mut st))
    br(mut st, done, -1)
    setCur(mut st, done)
    ret(mut st, -1)
}

// buildPrintInt は 10 進で書く。負数は剰余を負のまま扱う（|最小値| を作らない）
func buildPrintInt(st mut St) {
    begin(mut st, st.rtPint)
    v := 0
    buf := slotaddr(mut st, newSlot(mut st, 4))
    neg := cmp(mut st, CLt, v, iconst(mut st, 0))
    // sgn = 1 - 2*neg（剰余 d に掛けて桁の絶対値にする）
    sgn := bin(mut st, BSub, iconst(mut st, 1), bin(mut st, BMul, iconst(mut st, 2), neg))
    ten := iconst(mut st, 10)
    loop := newBlock(mut st)
    x := param(mut st, loop, TyI64)
    pos := param(mut st, loop, TyI64)
    br(mut st, loop, list2(mut st, v, iconst(mut st, 32)))
    setCur(mut st, loop)
    digit := bin(mut st, BAdd, iconst(mut st, 48), bin(mut st, BMul, bin(mut st, BRem, x, ten), sgn))
    pos1 := bin(mut st, BSub, pos, iconst(mut st, 1))
    store8(mut st, gepByte(mut st, buf, pos1), 0, digit)
    q := bin(mut st, BDiv, x, ten)
    after := newBlock(mut st)
    start := param(mut st, after, TyI64)
    condbr(mut st, cmp(mut st, CNe, q, iconst(mut st, 0)), loop, list2(mut st, q, pos1), after, list1(mut st, pos1))
    setCur(mut st, after)
    minus := newBlock(mut st)
    emit := newBlock(mut st)
    i := param(mut st, emit, TyI64)
    condbr(mut st, neg, minus, -1, emit, list1(mut st, start))
    setCur(mut st, minus)
    s1 := bin(mut st, BSub, start, iconst(mut st, 1))
    store8(mut st, gepByte(mut st, buf, s1), 0, iconst(mut st, 45))
    br(mut st, emit, list1(mut st, s1))
    setCur(mut st, emit)
    body := newBlock(mut st)
    done := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, i, iconst(mut st, 32)), body, -1, done, -1)
    setCur(mut st, body)
    call(mut st, st.rtPchar, list1(mut st, load8(mut st, gepByte(mut st, buf, i), 0)))
    br(mut st, emit, list1(mut st, bin(mut st, BAdd, i, iconst(mut st, 1))))
    setCur(mut st, done)
    ret(mut st, -1)
}

// buildRegionEnter は深度 + 1（上限で exit 102）、その深度の bump をスロット先頭へ
func buildRegionEnter(st mut St) {
    begin(mut st, st.rtRenter)
    meta := globaladdr(mut st, st.meta)
    d := bin(mut st, BAdd, load(mut st, meta, W_DEPTH), iconst(mut st, 1))
    over := newBlock(mut st)
    ok := newBlock(mut st)
    condbr(mut st, cmp(mut st, CGe, d, iconst(mut st, MAX_DEPTH)), over, -1, ok, -1)
    setCur(mut st, over)
    exit(mut st, PANIC_MEM)
    setCur(mut st, ok)
    store(mut st, meta, W_DEPTH, d)
    bs := load(mut st, meta, W_SLOTS)
    bump := bin(mut st, BAdd, bs, bin(mut st, BMul, d, load(mut st, meta, W_SLOT_SIZE)))
    dp := gepWord(mut st, meta, d)
    store(mut st, dp, W_BUMP, bump)
    ret(mut st, -1)
}

// buildRegionAlloc は region_alloc(d, n): 深度 d の bump を n 語進め、旧 bump を返す。スロット末尾を超えたら exit 102
func buildRegionAlloc(st mut St) {
    begin(mut st, st.rtRalloc)
    d := 0
    n := 1
    meta := globaladdr(mut st, st.meta)
    bp := gepWord(mut st, meta, d)
    old := load(mut st, bp, W_BUMP)
    nw := bin(mut st, BAdd, old, bin(mut st, BMul, n, iconst(mut st, 8)))
    limit := bin(mut st, BAdd, load(mut st, meta, W_SLOTS), bin(mut st, BMul, bin(mut st, BAdd, d, iconst(mut st, 1)), load(mut st, meta, W_SLOT_SIZE)))
    over := newBlock(mut st)
    ok := newBlock(mut st)
    condbr(mut st, cmp(mut st, CGt, nw, limit), over, -1, ok, -1)
    setCur(mut st, over)
    exit(mut st, PANIC_MEM)
    setCur(mut st, ok)
    store(mut st, bp, W_BUMP, nw)
    ret(mut st, itop(mut st, old))
}

func buildCopy(st mut St) {
    begin(mut st, st.rtCopy)
    loop := newBlock(mut st)
    i := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLt, i, 2), body, -1, done, -1)
    setCur(mut st, body)
    dst := gepWord(mut st, 0, i)
    store(mut st, dst, 0, load(mut st, gepWord(mut st, 1, i), 0))
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, i, iconst(mut st, 1))))
    setCur(mut st, done)
    ret(mut st, -1)
}

// buildRelocate は region_relocate(hdr, cellw, floor): ヘッダの depth が floor より深ければ、len * cellw 語を深度 floor の先端へ写して付け替える
func buildRelocate(st mut St) {
    begin(mut st, st.rtReloc)
    hdr := 0
    floor := 2
    move := newBlock(mut st)
    done := newBlock(mut st)
    condbr(mut st, cmp(mut st, CGt, load(mut st, hdr, 2), floor), move, -1, done, -1)
    setCur(mut st, move)
    n := bin(mut st, BMul, load(mut st, hdr, 1), 1)
    dst := call(mut st, st.rtRalloc, list2(mut st, floor, n))
    call(mut st, st.rtCopy, list3(mut st, dst, itop(mut st, load(mut st, hdr, 0)), n))
    store(mut st, hdr, 0, ptoi(mut st, dst))
    store(mut st, hdr, 2, floor)
    br(mut st, done, -1)
    setCur(mut st, done)
    ret(mut st, -1)
}

func buildStrEq(st mut St) {
    begin(mut st, st.rtStreq)
    n := load(mut st, 0, 1)
    pa := itop(mut st, load(mut st, 0, 0))
    pb := itop(mut st, load(mut st, 1, 0))
    ne := newBlock(mut st)
    loop := newBlock(mut st)
    i := param(mut st, loop, TyI64)
    condbr(mut st, cmp(mut st, CNe, n, load(mut st, 1, 1)), ne, -1, loop, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, ne)
    ret(mut st, iconst(mut st, 0))
    setCur(mut st, loop)
    body := newBlock(mut st)
    eq := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, i, n), body, -1, eq, -1)
    setCur(mut st, body)
    next := newBlock(mut st)
    x := load(mut st, gepWord(mut st, pa, i), 0)
    y := load(mut st, gepWord(mut st, pb, i), 0)
    condbr(mut st, cmp(mut st, CNe, x, y), ne, -1, next, -1)
    setCur(mut st, next)
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, i, iconst(mut st, 1))))
    setCur(mut st, eq)
    ret(mut st, iconst(mut st, 1))
}

// buildMapFind は挿入列を先頭から走査する（墓石のセルも一致する。値の有無はタグで見る）
func buildMapFind(st mut St) {
    begin(mut st, st.rtMapfind)
    hdr := 0
    key := 1
    cellw := 2
    bs := load(mut st, hdr, 0)
    step := bin(mut st, BMul, cellw, iconst(mut st, 8))
    end := bin(mut st, BAdd, bs, bin(mut st, BMul, load(mut st, hdr, 1), step))
    loop := newBlock(mut st)
    c := param(mut st, loop, TyI64)
    br(mut st, loop, list1(mut st, bs))
    setCur(mut st, loop)
    body := newBlock(mut st)
    absent := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, c, end), absent, -1, body, -1)
    setCur(mut st, absent)
    ret(mut st, iconst(mut st, 0))
    setCur(mut st, body)
    cp := itop(mut st, c)
    str_b := newBlock(mut st)
    int_b := newBlock(mut st)
    test_b := newBlock(mut st)
    hit := param(mut st, test_b, TyI64)
    condbr(mut st, 3, str_b, -1, int_b, -1)
    setCur(mut st, str_b)
    br(mut st, test_b, list1(mut st, call(mut st, st.rtStreq, list2(mut st, cp, key))))
    setCur(mut st, int_b)
    x := load(mut st, cp, 0)
    y := load(mut st, key, 0)
    br(mut st, test_b, list1(mut st, cmp(mut st, CEq, x, y)))
    setCur(mut st, test_b)
    found := newBlock(mut st)
    condbr(mut st, hit, found, -1, loop, list1(mut st, bin(mut st, BAdd, c, step)))
    setCur(mut st, found)
    ret(mut st, c)
}

func buildPrintStr(st mut St) {
    begin(mut st, st.rtPstr)
    p := itop(mut st, load(mut st, 0, 0))
    n := load(mut st, 0, 1)
    loop := newBlock(mut st)
    i := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLt, i, n), body, -1, done, -1)
    setCur(mut st, body)
    call(mut st, st.rtPchar, list1(mut st, load(mut st, gepWord(mut st, p, i), 0)))
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, i, iconst(mut st, 1))))
    setCur(mut st, done)
    ret(mut st, -1)
}

// ── io（ir_rt_io.zig — std/ の sys* 組み込みの下ろし先）──

func installIo(st mut St) {
    hv1 := addGlobalInit(mut st, strLit(mut st, "rt.iobuf"), IO_BUF / 8, -1)
    st.iobuf = hv1
    cstr := addFunc(mut st, strLit(mut st, "rt.cstr"), list2(mut st, TyPtr, TyPtr), TyI64)
    wall := addFunc(mut st, strLit(mut st, "rt.write_all"), list2(mut st, TyI64, TyPtr), TyI64)
    hv2 := addFunc(mut st, strLit(mut st, "rt.read_file"), list2(mut st, TyPtr, TyPtr), -1)
    st.rtRead = hv2
    hv3 := addFunc(mut st, strLit(mut st, "rt.write_file"), list2(mut st, TyPtr, TyPtr), TyI64)
    st.rtWrite = hv3
    hv4 := addFunc(mut st, strLit(mut st, "rt.read_args"), list1(mut st, TyPtr), -1)
    st.rtArgs = hv4
    hv5 := addFunc(mut st, strLit(mut st, "rt.read_dir"), list2(mut st, TyPtr, TyPtr), -1)
    st.rtDir = hv5
    hv6 := addFunc(mut st, strLit(mut st, "rt.write_fd"), list2(mut st, TyI64, TyPtr), TyI64)
    st.rtWfd = hv6
    buildCstr(mut st, cstr)
    buildWriteAll(mut st, wall)
    buildReadFile(mut st, cstr)
    buildWriteFile(mut st, cstr, wall)
    buildReadArgs(mut st)
    buildReadDir(mut st, cstr)
    buildWriteFd(mut st, wall)
}

// branchIf は条件 c が真なら新しいブロックへ分岐して cur にし、偽側のブロックを返す
func branchIf(st mut St, c int) int {
    t := newBlock(mut st)
    e := newBlock(mut st)
    condbr(mut st, c, t, -1, e, -1)
    setCur(mut st, t)
    return e
}

// buildCstr は cstr(hdr, buf) → 0 / ENAMETOOLONG / EINVAL: string ヘッダのセル列を NUL 終端のバイト列に詰める
func buildCstr(st mut St, f int) {
    begin(mut st, f)
    hdr := 0
    buf := 1
    n := load(mut st, hdr, 1)
    fits := branchIf(mut st, cmp(mut st, CUge, n, iconst(mut st, IO_BUF)))
    ret(mut st, iconst(mut st, 36))
    setCur(mut st, fits)
    p := itop(mut st, load(mut st, hdr, 0))
    loop := newBlock(mut st)
    i := param(mut st, loop, TyI64)
    br(mut st, loop, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, loop)
    more := branchIf(mut st, cmp(mut st, CGe, i, n))
    store8(mut st, gepByte(mut st, buf, i), 0, iconst(mut st, 0))
    ret(mut st, iconst(mut st, 0))
    setCur(mut st, more)
    c := load(mut st, gepWord(mut st, p, i), 0)
    not_nul := branchIf(mut st, cmp(mut st, CEq, c, iconst(mut st, 0)))
    ret(mut st, iconst(mut st, 22))
    setCur(mut st, not_nul)
    byte := branchIf(mut st, cmp(mut st, CUge, c, iconst(mut st, 256)))
    ret(mut st, iconst(mut st, 22))
    setCur(mut st, byte)
    store8(mut st, gepByte(mut st, buf, i), 0, c)
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, i, iconst(mut st, 1))))
}

func setErrno(st mut St, e int) {
    store(mut st, globaladdr(mut st, st.meta), W_ERRNO, e)
}

// buildReadFile は read_file(path, out): out に現在深度の region 先端から 1 バイト 1 語で積んだ中身を置く（失敗は空）
func buildReadFile(st mut St, cstr int) {
    begin(mut st, st.rtRead)
    path := 0
    out := 1
    meta := globaladdr(mut st, st.meta)
    buf := globaladdr(mut st, st.iobuf)
    depth := load(mut st, meta, W_DEPTH)
    store(mut st, out, 0, ptoi(mut st, regionBump(mut st, depth)))
    store(mut st, out, 1, iconst(mut st, 0))
    store(mut st, out, 2, depth)
    e := call(mut st, cstr, list2(mut st, path, buf))
    named := branchIf(mut st, cmp(mut st, CNe, e, iconst(mut st, 0)))
    setErrno(mut st, e)
    ret(mut st, -1)
    setCur(mut st, named)
    o0 := iconst(mut st, 257)
    o1 := iconst(mut st, -100)
    o2 := ptoi(mut st, buf)
    o3 := iconst(mut st, 524288)
    o4 := iconst(mut st, 0)
    oargs := listN(mut st, 5)
    st.d.h[oargs + 1] = o0
    st.d.h[oargs + 2] = o1
    st.d.h[oargs + 3] = o2
    st.d.h[oargs + 4] = o3
    st.d.h[oargs + 5] = o4
    fd := syscall(mut st, oargs)
    opened := branchIf(mut st, cmp(mut st, CLt, fd, iconst(mut st, 0)))
    setErrno(mut st, bin(mut st, BSub, iconst(mut st, 0), fd))
    ret(mut st, -1)
    setCur(mut st, opened)
    loop := newBlock(mut st)
    close := newBlock(mut st)
    err := param(mut st, close, TyI64)
    br(mut st, loop, -1)
    setCur(mut st, loop)
    n := syscall(mut st, list4(mut st, iconst(mut st, 0), fd, ptoi(mut st, buf), iconst(mut st, IO_BUF)))
    not_intr := branchIf(mut st, cmp(mut st, CEq, n, iconst(mut st, -4)))
    br(mut st, loop, -1)
    setCur(mut st, not_intr)
    not_eof := branchIf(mut st, cmp(mut st, CEq, n, iconst(mut st, 0)))
    br(mut st, close, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, not_eof)
    got := branchIf(mut st, cmp(mut st, CLt, n, iconst(mut st, 0)))
    br(mut st, close, list1(mut st, bin(mut st, BSub, iconst(mut st, 0), n)))
    setCur(mut st, got)
    dst := regionAlloc(mut st, depth, n)
    wl := newBlock(mut st)
    i := param(mut st, wl, TyI64)
    wdone := newBlock(mut st)
    br(mut st, wl, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, wl)
    wbody := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, i, n), wbody, -1, wdone, -1)
    setCur(mut st, wbody)
    wp := gepWord(mut st, dst, i)
    store(mut st, wp, 0, load8(mut st, gepByte(mut st, buf, i), 0))
    br(mut st, wl, list1(mut st, bin(mut st, BAdd, i, iconst(mut st, 1))))
    setCur(mut st, wdone)
    store(mut st, out, 1, bin(mut st, BAdd, load(mut st, out, 1), n))
    br(mut st, loop, -1)
    setCur(mut st, close)
    syscall(mut st, list2(mut st, iconst(mut st, 3), fd))
    setErrno(mut st, err)
    ret(mut st, -1)
}

// buildWriteAll は write_all(fd, data) → errno（0 = 成功）: data を IO_BUF バイトずつ詰めて書く（各要素 0〜255、外れたら panic 101）。
// 短い書き込みは続きから、EINTR は再試行
func buildWriteAll(st mut St, f int) {
    begin(mut st, f)
    fd := 0
    data := 1
    buf := globaladdr(mut st, st.iobuf)
    src := itop(mut st, load(mut st, data, 0))
    ln := load(mut st, data, 1)
    // チャンクのループ: n = min(len - pos, IO_BUF)
    chunk := newBlock(mut st)
    pos := param(mut st, chunk, TyI64)
    br(mut st, chunk, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, chunk)
    rest := bin(mut st, BSub, ln, pos)
    has := branchIf(mut st, cmp(mut st, CEq, rest, iconst(mut st, 0)))
    ret(mut st, iconst(mut st, 0))
    setCur(mut st, has)
    small := newBlock(mut st)
    pick := newBlock(mut st)
    n := param(mut st, pick, TyI64)
    condbr(mut st, cmp(mut st, CLe, rest, iconst(mut st, IO_BUF)), small, -1, pick, list1(mut st, iconst(mut st, IO_BUF)))
    setCur(mut st, small)
    br(mut st, pick, list1(mut st, rest))
    setCur(mut st, pick)
    bs := gepWord(mut st, src, pos)
    pl := newBlock(mut st)
    i := param(mut st, pl, TyI64)
    pdone := newBlock(mut st)
    br(mut st, pl, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, pl)
    pbody := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, i, n), pbody, -1, pdone, -1)
    setCur(mut st, pbody)
    c := load(mut st, gepWord(mut st, bs, i), 0)
    // 符号なし: 負も 255 超も（到達 = バグ類の panic — 27 節）
    in_byte := branchIf(mut st, cmp(mut st, CUge, c, iconst(mut st, 256)))
    exit(mut st, PANIC)
    setCur(mut st, in_byte)
    store8(mut st, gepByte(mut st, buf, i), 0, c)
    br(mut st, pl, list1(mut st, bin(mut st, BAdd, i, iconst(mut st, 1))))
    // write ループ（短い書き込みは続きから）
    setCur(mut st, pdone)
    xl := newBlock(mut st)
    done_w := param(mut st, xl, TyI64)
    br(mut st, xl, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, xl)
    left := bin(mut st, BSub, n, done_w)
    next_chunk := newBlock(mut st)
    xbody := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, left, iconst(mut st, 0)), next_chunk, -1, xbody, -1)
    setCur(mut st, next_chunk)
    br(mut st, chunk, list1(mut st, bin(mut st, BAdd, pos, n)))
    setCur(mut st, xbody)
    r := syscall(mut st, list4(mut st, iconst(mut st, 1), fd, ptoi(mut st, gepByte(mut st, buf, done_w)), left))
    not_intr := branchIf(mut st, cmp(mut st, CEq, r, iconst(mut st, -4)))
    br(mut st, xl, list1(mut st, done_w))
    setCur(mut st, not_intr)
    wrote := branchIf(mut st, cmp(mut st, CLt, r, iconst(mut st, 0)))
    ret(mut st, bin(mut st, BSub, iconst(mut st, 0), r))
    setCur(mut st, wrote)
    br(mut st, xl, list1(mut st, bin(mut st, BAdd, done_w, r)))
}

// buildWriteFile は write_file(path, data) → errno: 作成 / 切り詰めで開いて write_all。close のエラーは返す（先のエラーが優先）
func buildWriteFile(st mut St, cstr int, wall int) {
    begin(mut st, st.rtWrite)
    path := 0
    data := 1
    buf := globaladdr(mut st, st.iobuf)
    e := call(mut st, cstr, list2(mut st, path, buf))
    named := branchIf(mut st, cmp(mut st, CNe, e, iconst(mut st, 0)))
    setErrno(mut st, e)
    ret(mut st, e)
    setCur(mut st, named)
    o0 := iconst(mut st, 257)
    o1 := iconst(mut st, -100)
    o2 := ptoi(mut st, buf)
    o3 := iconst(mut st, 524865)
    o4 := iconst(mut st, 420)
    oargs := listN(mut st, 5)
    st.d.h[oargs + 1] = o0
    st.d.h[oargs + 2] = o1
    st.d.h[oargs + 3] = o2
    st.d.h[oargs + 4] = o3
    st.d.h[oargs + 5] = o4
    fd := syscall(mut st, oargs)
    opened := branchIf(mut st, cmp(mut st, CLt, fd, iconst(mut st, 0)))
    oe := bin(mut st, BSub, iconst(mut st, 0), fd)
    setErrno(mut st, oe)
    ret(mut st, oe)
    setCur(mut st, opened)
    err := call(mut st, wall, list2(mut st, fd, data))
    // close(fd)
    cr := syscall(mut st, list2(mut st, iconst(mut st, 3), fd))
    final := newBlock(mut st)
    fe := param(mut st, final, TyI64)
    cl_bad := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, cr, iconst(mut st, 0)), cl_bad, -1, final, list1(mut st, err))
    setCur(mut st, cl_bad)
    keep := cmp(mut st, CNe, err, iconst(mut st, 0))
    take := newBlock(mut st)
    condbr(mut st, keep, final, list1(mut st, err), take, -1)
    setCur(mut st, take)
    br(mut st, final, list1(mut st, bin(mut st, BSub, iconst(mut st, 0), cr)))
    setCur(mut st, final)
    setErrno(mut st, fe)
    ret(mut st, fe)
}

// initOut は out（3 語ヘッダ）を現在深度の region 先端・長さ 0 で初期化し、深度を返す（read_args / read_dir の共通の冒頭）
func initOut(st mut St, out int) int {
    meta := globaladdr(mut st, st.meta)
    depth := load(mut st, meta, W_DEPTH)
    store(mut st, out, 0, ptoi(mut st, regionBump(mut st, depth)))
    store(mut st, out, 1, iconst(mut st, 0))
    store(mut st, out, 2, depth)
    return depth
}

// strLen は C 文字列 s（NUL 終端）の長さ
func strLen(st mut St, s int) int {
    loop := newBlock(mut st)
    j := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    done := newBlock(mut st)
    res := param(mut st, done, TyI64)
    br(mut st, loop, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CEq, load8(mut st, gepByte(mut st, s, j), 0), iconst(mut st, 0)), done, list1(mut st, j), body, -1)
    setCur(mut st, body)
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, j, iconst(mut st, 1))))
    setCur(mut st, done)
    return res
}

// widen はバイト列 src[0..n] を 1 バイト 1 語で dst[0..n] へ写す
func widen(st mut St, dst int, src int, n int) {
    loop := newBlock(mut st)
    i := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLt, i, n), body, -1, done, -1)
    setCur(mut st, body)
    store(mut st, gepWord(mut st, dst, i), 0, load8(mut st, gepByte(mut st, src, i), 0))
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, i, iconst(mut st, 1))))
    setCur(mut st, done)
}

// buildReadArgs は read_args(out): argv を「各引数のバイト + 0」の連結で out に置く（原本は W_ARGV の初期 rsp — [argc, argv…]）
func buildReadArgs(st mut St) {
    begin(mut st, st.rtArgs)
    out := 0
    depth := initOut(mut st, out)
    sp := itop(mut st, load(mut st, globaladdr(mut st, st.meta), W_ARGV))
    argc := load(mut st, sp, 0)
    loop := newBlock(mut st)
    k := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLt, k, argc), body, -1, done, -1)
    setCur(mut st, body)
    s := itop(mut st, load(mut st, gepWord(mut st, sp, bin(mut st, BAdd, k, iconst(mut st, 1))), 0))
    n := strLen(mut st, s)
    dst := regionAlloc(mut st, depth, bin(mut st, BAdd, n, iconst(mut st, 1)))
    widen(mut st, dst, s, n)
    store(mut st, gepWord(mut st, dst, n), 0, iconst(mut st, 0))
    store(mut st, out, 1, bin(mut st, BAdd, load(mut st, out, 1), bin(mut st, BAdd, n, iconst(mut st, 1))))
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, k, iconst(mut st, 1))))
    setCur(mut st, done)
    ret(mut st, -1)
}

// buildReadDir は read_dir(path, out): 項目を「d_type 1 語 + 名前のバイト + 0」の連結で out に置く（失敗は空 + errno。getdents64 の順のまま・
// `.` / `..` も含む — 除外・ソート・種類の解釈は std/io）。linux_dirent64: d_reclen @16（2B LE）・d_type @18・d_name @19
func buildReadDir(st mut St, cstr int) {
    begin(mut st, st.rtDir)
    path := 0
    out := 1
    buf := globaladdr(mut st, st.iobuf)
    depth := initOut(mut st, out)
    e := call(mut st, cstr, list2(mut st, path, buf))
    named := branchIf(mut st, cmp(mut st, CNe, e, iconst(mut st, 0)))
    setErrno(mut st, e)
    ret(mut st, -1)
    setCur(mut st, named)
    o0 := iconst(mut st, 257)
    o1 := iconst(mut st, -100)
    o2 := ptoi(mut st, buf)
    o3 := iconst(mut st, 589824)
    o4 := iconst(mut st, 0)
    oargs := listN(mut st, 5)
    st.d.h[oargs + 1] = o0
    st.d.h[oargs + 2] = o1
    st.d.h[oargs + 3] = o2
    st.d.h[oargs + 4] = o3
    st.d.h[oargs + 5] = o4
    fd := syscall(mut st, oargs)
    opened := branchIf(mut st, cmp(mut st, CLt, fd, iconst(mut st, 0)))
    setErrno(mut st, bin(mut st, BSub, iconst(mut st, 0), fd))
    ret(mut st, -1)
    setCur(mut st, opened)
    loop := newBlock(mut st)
    close := newBlock(mut st)
    err := param(mut st, close, TyI64)
    br(mut st, loop, -1)
    setCur(mut st, loop)
    n := syscall(mut st, list4(mut st, iconst(mut st, 217), fd, ptoi(mut st, buf), iconst(mut st, IO_BUF)))
    not_intr := branchIf(mut st, cmp(mut st, CEq, n, iconst(mut st, -4)))
    br(mut st, loop, -1)
    setCur(mut st, not_intr)
    not_end := branchIf(mut st, cmp(mut st, CEq, n, iconst(mut st, 0)))
    br(mut st, close, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, not_end)
    got := branchIf(mut st, cmp(mut st, CLt, n, iconst(mut st, 0)))
    br(mut st, close, list1(mut st, bin(mut st, BSub, iconst(mut st, 0), n)))
    setCur(mut st, got)
    // レコードの走査（pos < n）
    rl := newBlock(mut st)
    pos := param(mut st, rl, TyI64)
    rbody := newBlock(mut st)
    br(mut st, rl, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, rl)
    condbr(mut st, cmp(mut st, CLt, pos, n), rbody, -1, loop, -1)
    setCur(mut st, rbody)
    rec := gepByte(mut st, buf, pos)
    reclen := bin(mut st, BOr, load8(mut st, rec, 16), bin(mut st, BShl, load8(mut st, rec, 17), iconst(mut st, 8)))
    name := gepByte(mut st, rec, iconst(mut st, 19))
    ln := strLen(mut st, name)
    dst := regionAlloc(mut st, depth, bin(mut st, BAdd, ln, iconst(mut st, 2)))
    store(mut st, dst, 0, load8(mut st, rec, 18))
    widen(mut st, gepWord(mut st, dst, iconst(mut st, 1)), name, ln)
    store(mut st, gepWord(mut st, dst, bin(mut st, BAdd, ln, iconst(mut st, 1))), 0, iconst(mut st, 0))
    store(mut st, out, 1, bin(mut st, BAdd, load(mut st, out, 1), bin(mut st, BAdd, ln, iconst(mut st, 2))))
    br(mut st, rl, list1(mut st, bin(mut st, BAdd, pos, reclen)))
    setCur(mut st, close)
    syscall(mut st, list2(mut st, iconst(mut st, 3), fd))
    setErrno(mut st, err)
    ret(mut st, -1)
}

// buildWriteFd は write_fd(fd, data) → errno: 開いている fd へ直接書く（open しない — 切り詰めない）。先に println の行バッファを flush
func buildWriteFd(st mut St, wall int) {
    begin(mut st, st.rtWfd)
    call(mut st, st.rtFlush, list0(mut st))
    e := call(mut st, wall, list2(mut st, 0, 1))
    setErrno(mut st, e)
    ret(mut st, e)
}
