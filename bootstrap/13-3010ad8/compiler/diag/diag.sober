package diag

// 診断（C4 — reaudit 第 2 弾）: 位置 Pos と拒否の種類ごとの error ラベル（language.md 13 節 — 種類 = ラベルのタグ）、印字 Format。
// 層（loader / desugar / lower）は拒否をここのラベルで返し、app が Format で 1 行にする。位置は各層が手元の節（desugar の NodeRef・
// loader の字句）から raise の時点で Pos に落とす（ファイルは推測しない — 引けなければ -1）。
// ラベルは位置だけを持つ（文言は Format の腕 — string の欄を持たせると error? の全値が中身つきの境界コピーを背負う）。
// 溜める形（loader の NameHit・desugar の nomLog）は Pos か (ファイル, 字句) の組を別に持つ

import "lexer"
import "std/iter"

// Pos はファイル file（loader の Program のファイルの番号 — 無ければ -1）の字句 tok
type Pos struct {
    file int
    tok int
}

// None は位置の無い拒否の Pos
func None() Pos {
    return Pos{file: -1, tok: 0}
}

// ── desugar（脱糖器）の拒否 — 綴りは Zig 版の error 名 ──

// CoreFragment はコアの断片の外（型検査器が扱わない形）
type CoreFragment error {
    at Pos
}

// UnknownName は名前が引けない
type UnknownName error {
    at Pos
}

// Malformed は形が不正
type Malformed error {
    at Pos
}

// TypeMismatch は型宣言の区別の違反（language.md 32 節 — 表層型の照合）
type TypeMismatch error {
    at Pos
}

// ── lower の拒否（種類の綴りは Zig 版の error 名 — Undefined* は引けなかったものの種類ごと）──

type Unsupported error {
    at Pos
}

type UndefinedName error {
    at Pos
}

type UndefinedFunction error {
    at Pos
}

type UndefinedType error {
    at Pos
}

type UndefinedField error {
    at Pos
}

type Mismatch error {
    at Pos
}

type Missing error {
    at Pos
}

// ── loader の拒否（1 ラベル 1 文言 — 文言は Format）──

type ReadFail error {
    at Pos
}

type GrammarMismatch error {
    at Pos
}

type NoPkgDir error {
    at Pos
}

type NoStd error {
    at Pos
}

type EmbedReceiver error {
    at Pos
}

type EmbedPattern error {
    at Pos
}

type EmbedNoMatch error {
    at Pos
}

type EmbedPathUtf8 error {
    at Pos
}

type EmbedRead error {
    at Pos
}

type EmbedFileUtf8 error {
    at Pos
}

type PkgName error {
    at Pos
}

type RefCollide error {
    at Pos
}

// NotImported は修飾名の参照名をそのファイルが import していない（import はファイルごと — language.md 20 節）
type NotImported error {
    at Pos
}

type ImportCycle error {
    at Pos
}

type Noinline error {
    at Pos
}

type ErrorHoldsError error {
    at Pos
}

type ConstExpr error {
    at Pos
}

type LocalBuiltin error {
    at Pos
}

type LocalImport error {
    at Pos
}

type LocalTop error {
    at Pos
}

type TParamBuiltin error {
    at Pos
}

type TParamTop error {
    at Pos
}

type DeclBuiltin error {
    at Pos
}

type VariantDup error {
    at Pos
}

type Shadow error {
    at Pos
}

type PureExprStmt error {
    at Pos
}

// NilCase は `case nil:` の腕を写せない形（loader/nilcase.sober — D1）。kind = 1 nil の腕が 2 つ以上・2 `nil | …`・3 前に名前のパターン・4 nil の腕しか無い・5〜8 は 2 位置の `case P, nil:`（loader/mvcase.sober の mvBad）
type NilCase error {
    at Pos
    kind int
}

// LeadingZero は先頭が 0 の 10 進の整数リテラル（`010` — Go の旧来の 8 進と読み違える。syntax.md 決定 18 — 8 進は `0o755` だけ）
type LeadingZero error {
    at Pos
}

// NamedArg は名前付き実引数（syntax.md 決定 7）を位置へ写せない形（loader/namedargs.sober）。kind = 1 func 宣言の直接呼び出しでない・2 その名前の仮引数が無い・
// 3 宣言の順でない（重複を含む）・4 位置で渡した仮引数を名前でも渡した・5 省略できない（`T?` でない）仮引数が無い・6 パイプ段で穴 `_` が無い
type NamedArg error {
    at Pos
    kind int
}

// AssertOutsideTest は `_test.sober` の外の `assert(…)`（T7 — assert はテストの語彙）
type AssertOutsideTest error {
    at Pos
}

// Layout は @layout（language.md 36 節）の拒否（loader/layout.sober）。kind = 1 `[N]T` の欄が @layout の struct の外・2 @layout が struct でない型宣言に付いている・
// 3 @layout の欄の型が幅の語（か幅の語の `[N]`・N ≥ 1）でない・4 幅の語が @layout の欄の外・5 @layout の struct に欄が無いか型パラメータがある・
// 6 `layout.X[T]` の T が @layout の struct でない・7 std/layout の口の形（Decode / DecodeAt / Encode は `[T]` をつけて呼ぶ・Size は `[T]` をつけて呼ばない）・
// 8 @layout の struct のリテラルの欄の整数リテラルが幅に収まらない
type Layout error {
    at Pos
    kind int
}

// TestSignature は `_test.sober` の `TestXxx` が引数・戻り・型パラメータを持つ（テストのビルド — loader/testmain.sober。T3）
type TestSignature error {
    at Pos
}

// At は拒否 err の位置（ここのラベルでなければ None）
func At(err error?) Pos {
    return switch err {
    case nil: None()
    case CoreFragment{at}: at
    case UnknownName{at}: at
    case Malformed{at}: at
    case TypeMismatch{at}: at
    case Unsupported{at}: at
    case UndefinedName{at}: at
    case UndefinedFunction{at}: at
    case UndefinedType{at}: at
    case UndefinedField{at}: at
    case Mismatch{at}: at
    case Missing{at}: at
    case ReadFail{at}: at
    case GrammarMismatch{at}: at
    case NoPkgDir{at}: at
    case NoStd{at}: at
    case EmbedReceiver{at}: at
    case EmbedPattern{at}: at
    case EmbedNoMatch{at}: at
    case EmbedPathUtf8{at}: at
    case EmbedRead{at}: at
    case EmbedFileUtf8{at}: at
    case PkgName{at}: at
    case RefCollide{at}: at
    case NotImported{at}: at
    case ImportCycle{at}: at
    case Noinline{at}: at
    case ErrorHoldsError{at}: at
    case ConstExpr{at}: at
    case LocalBuiltin{at}: at
    case LocalImport{at}: at
    case LocalTop{at}: at
    case TParamBuiltin{at}: at
    case TParamTop{at}: at
    case DeclBuiltin{at}: at
    case VariantDup{at}: at
    case Shadow{at}: at
    case PureExprStmt{at}: at
    case TestSignature{at}: at
    case NilCase{at}: at
    case NamedArg{at}: at
    case LeadingZero{at}: at
    case AssertOutsideTest{at}: at
    case Layout{at}: at
    default: None()
    }
}

// Format は拒否 err の 1 行（where = At(err) の `<path>:<行>:<列>` — Where）:
// `desugar error at <where> (<種類>)`・`lower error at <where> (<種類>)`・`load error: <理由>`（位置があれば `load error at <where>: <理由>`）
func Format(err error?, where string) string {
    return switch err {
    case nil: "error"
    case CoreFragment{at}: "desugar error at ${where} (CoreFragment)"
    case UnknownName{at}: "desugar error at ${where} (UnknownName)"
    case Malformed{at}: "desugar error at ${where} (Malformed)"
    case TypeMismatch{at}: "desugar error at ${where} (TypeMismatch)"
    case Unsupported{at}: "lower error at ${where} (Unsupported)"
    case UndefinedName{at}: "lower error at ${where} (UndefinedName)"
    case UndefinedFunction{at}: "lower error at ${where} (UndefinedFunction)"
    case UndefinedType{at}: "lower error at ${where} (UndefinedType)"
    case UndefinedField{at}: "lower error at ${where} (UndefinedField)"
    case Mismatch{at}: "lower error at ${where} (Mismatch)"
    case Missing{at}: "lower error at ${where} (Missing)"
    case ReadFail{at}: loadLine(err, where, "cannot read file")
    case GrammarMismatch{at}: loadLine(err, where, "source does not match the grammar")
    case NoPkgDir{at}: loadLine(err, where, "cannot open package directory")
    case NoStd{at}: loadLine(err, where, "no such std package")
    case EmbedReceiver{at}: loadLine(err, where, "@embed needs the receiver `map[string]string{}` (empty, imm)")
    case EmbedPattern{at}: loadLine(err, where, "invalid @embed pattern")
    case EmbedNoMatch{at}: loadLine(err, where, "@embed pattern matches no file")
    case EmbedPathUtf8{at}: loadLine(err, where, "@embed path is not valid UTF-8")
    case EmbedRead{at}: loadLine(err, where, "@embed cannot read file")
    case EmbedFileUtf8{at}: loadLine(err, where, "@embed file is not valid UTF-8")
    case PkgName{at}: loadLine(err, where, "package name must match the directory name")
    case RefCollide{at}: loadLine(err, where, "import reference name collides (use an alias)")
    case NotImported{at}: loadLine(err, where, "this file does not import the package it names (imports are per file — add the import to this file)")
    case ImportCycle{at}: loadLine(err, where, "import cycle")
    case Noinline{at}: loadLine(err, where, "@noinline applies to a function with mut parameters and no function-typed parameters")
    case ErrorHoldsError{at}: loadLine(err, where, "an error label cannot hold an error")
    case ConstExpr{at}: loadLine(err, where, "const expression")
    case LocalBuiltin{at}: loadLine(err, where, "a local binding cannot reuse a builtin name (len, shape, println, await, freeze, keys, bytes, true, false, append, delete)")
    case LocalImport{at}: loadLine(err, where, "a local binding cannot reuse an import reference name")
    case LocalTop{at}: loadLine(err, where, "a local binding cannot reuse a top-level name (const, func or type)")
    case TParamBuiltin{at}: loadLine(err, where, "a type parameter cannot reuse a builtin name")
    case TParamTop{at}: loadLine(err, where, "a type parameter cannot reuse a top-level type name")
    case DeclBuiltin{at}: loadLine(err, where, "a top-level declaration cannot reuse a builtin name")
    case VariantDup{at}: loadLine(err, where, "a variant name must be unique among the package's top-level names")
    case Shadow{at}: loadLine(err, where, "a local binding cannot shadow or redeclare another local binding")
    case PureExprStmt{at}: loadLine(err, where, "an expression statement must be a call: the value of a pure expression is unused (bind or assign it, or remove it)")
    case TestSignature{at}: loadLine(err, where, "a test function (Test… in a _test.sober file) takes no parameters, type parameters or results")
    case AssertOutsideTest{at}: loadLine(err, where, "assert is only available in _test.sober files")
    case Layout{at, kind}: loadLine(err, where, switch kind {
        case 1: "a fixed-length array field ([N]T) is only allowed in a @layout struct"
        case 2: "@layout applies only to a struct type declaration"
        case 3: "a @layout field has a width type (u8, i8, u16le, u32be, …) or a fixed-length array [N] of one (N ≥ 1)"
        case 4: "width types (u8, u16le, …) are only allowed as @layout struct field types"
        case 5: "a @layout struct needs at least one field and no type parameters"
        case 6: "the type argument of layout.Decode / DecodeAt / Encode / Size must be a @layout struct"
        case 7: "layout.Decode / DecodeAt / Encode are called with a type argument (layout.Decode[T](…)); layout.Size[T] is a constant"
        default: "an integer literal does not fit the width of its @layout field"
    })
    case LeadingZero{at}: loadLine(err, where, "a decimal literal cannot start with 0 — write 0o for octal (0o755), or drop the leading zeros")
    case NamedArg{at, kind}: loadLine(err, where, switch kind {
        case 1: "named arguments can only be passed in a direct call of a func declaration"
        case 2: "the function has no parameter with this name"
        case 3: "named arguments must follow the order of the parameters"
        case 4: "this parameter is already given by position"
        case 5: "a parameter that is not optional (T?) is missing — only T? parameters can be left out"
        default: "a pipe stage with named arguments marks the piped value with _"
    })
    case NilCase{at, kind}: loadLine(err, where, switch kind {
        case 1: "case nil appears more than once in the switch"
        case 2: "case nil cannot be combined with other alternatives (nil | …)"
        case 3: "case nil must come before name patterns (_ or a binding also matches nil)"
        case 4: "a switch with case nil needs another case or a default"
        case 5: "in a (value, error?) switch, a case for a non-nil error takes _ as its value pattern (case _, e:)"
        case 6: "case _, e also matches a nil error: the nil cases must cover every value (case v, nil:)"
        case 7: "a default here would be needed for both a nil and a non-nil error: cover every value in the nil cases (case v, nil:)"
        default: "a non-nil error has no case: add case _, e: or a default"
    })
    default: "error"
    }
}

// loadLine は loader の拒否の 1 行（位置があれば `load error at <where>: <理由>`）
func loadLine(err error?, where string, why string) string {
    return if At(err).file >= 0 { "load error at ${where}: ${why}" } else { "load error: ${why}" }
}

// Where はファイル path（ソース src）の字句 tok の `<path>:<行>:<列>`（tok が字句の範囲外なら `token <tok>`）
func Where(path string, src []byte, tok int) string {
    toks := lexer.Lex(src)
    if tok < 0 || tok >= len(toks) {
        return "token ${tok}"
    }
    at := toks[tok].start
    mut line := 1
    mut col := 1
    for i <- iter.Range(0, at) {
        if src[i] == '\n' {
            line += 1
            col = 1
        } else {
            col += 1
        }
    }
    return "${path}:${line}:${col}"
}
