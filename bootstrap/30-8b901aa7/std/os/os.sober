package os

import "std/utf8"
import "std/io"
import "std/iter"

// 組み込みの宣言（息継ぎ ③ — 本体なし。鍵の実装はコンパイラの表: loader/intrinsic.sober・desugar / lower の SysKey）
@intrinsic("args")
func sysArgs() []byte

@intrinsic("run")
func sysRun(argv []byte) int

@intrinsic("write_mode")
func sysWriteMode(path string, mode int) int

@intrinsic("mkdir")
func sysMkdir(path string) int

@intrinsic("rename")
func sysRename(from string, to string) int

@intrinsic("stat")
func sysStat(path string) int

@intrinsic("sleep")
func sysSleep(ms int) int

@intrinsic("environ")
func sysEnviron() []byte

// プロセスの属性（language.md 28 節の追記 — R31）。ファイルシステムの操作は std/io

// Args はプログラムの引数（0 番 = プログラム名 — Go の os.Args と同じ並び）。呼ぶたびに呼び手の region へ写す。
// string は UTF-8 検査済みなので、不正な UTF-8 の引数が 1 つでもあれば全体が utf8.InvalidUtf8（入力次第で起きる = error — 27 節）
@errors(utf8.InvalidUtf8)
func Args() ([]string, error?) {
    // 「各引数のバイト + 0」の連結（C 文字列は 0 を含まないので区切りは曖昧にならない）
    b := sysArgs()
    mut out := mut []string{}
    mut start := 0
    mut i := 0
    while i < len(b) {
        if b[i] == 0 {
            s := string(b[start:i])?
            out = append(out, s)
            start = i + 1
        }
        i += 1
    }
    return freeze(out), nil
}

// Run は path のプログラムを args（argv[1:] — argv[0] は path）で子プロセスとして走らせ、終了を待って終了コードを返す（シグナルで死んだら 128 + 番号 —
// シェルと同じ）。標準入出力と環境変数は親のまま継ぐ。PATH は探さない（path はそのまま execve に渡す）。exec に失敗した子は 127 で終わる
// （error でなく終了コード — 子の中の失敗は親から区別しない）。fork / wait の失敗は io の errno のラベル。引数に NUL を含めば io.Other{errno: 22}
// （テスト基盤のランナーの最小面。fork + execve + wait4 の同期の直呼び）
@errors(io.NotFound, io.Denied, io.Other)
func Run(path string, args []string) (int, error?) {
    mut b := mut []byte{}
    if !argz(mut b, path) {
        return 0, io.Other{errno: 22}
    }
    for i <- iter.Range(0, len(args)) {
        if !argz(mut b, args[i]) {
            return 0, io.Other{errno: 22}
        }
    }
    r := sysRun(freeze(b))
    if r < 0 {
        return 0, errOf(0 - r)
    }
    return r, nil
}

// WriteMode は path のファイルの許可の bit（mode — chmod(2) の 12 bit: 0o755 = 493 等）を書く（対の ReadMode は実需まで足さない — 34 節の規則 2）。
// 失敗は io の errno のラベル（無い・権限・その他）。path は std/io と同じく C 文字列に写す（NUL を含む・長すぎる path は io.Other）
@errors(io.NotFound, io.Denied, io.Other)
func WriteMode(path string, mode int) error? {
    e := sysWriteMode(path, mode)
    if e != 0 {
        return errOf(e)
    }
    return nil
}

// Mkdir は path のディレクトリを作る（mkdir(2) — 許可の bit は 0o755。親は作らない — mkdir -p は呼び手が親から順に）。既にあれば io.Other{errno: 17}
// （EEXIST — ラベルは足さない: 呼び手が「あってもよい」を errno で見る）。他の失敗は io の errno のラベル（3'' 第 2 段 C0 — キャッシュの置き場）
@errors(io.NotFound, io.Denied, io.Other)
func Mkdir(path string) error? {
    e := sysMkdir(path)
    if e != 0 {
        return errOf(e)
    }
    return nil
}

// Rename は from を to へ付け替える（rename(2) — 同じファイルシステムの中では原子的で、to が既にあれば置き換える）。一時ファイルに書いてから
// Rename で公開すると、読み手は書きかけを見ない（キャッシュの置き場の書き込みの形）。失敗は io の errno のラベル
@errors(io.NotFound, io.Denied, io.Other)
func Rename(from string, to string) error? {
    e := sysRename(from, to)
    if e != 0 {
        return errOf(e)
    }
    return nil
}

// ModTime は path の更新時刻（stat(2) の st_mtim — エポックからの ns。シンボリックリンクは辿る）。失敗は io の errno のラベル
// （sober watch の mtime ポーリング — 時刻の値は比べるためだけに使う: 単位や起点に意味を持たせない）
@errors(io.NotFound, io.Denied, io.Other)
func ModTime(path string) (int, error?) {
    t := sysStat(path)
    if t < 0 {
        return 0, errOf(0 - t)
    }
    return t, nil
}

// Sleep は ms ミリ秒眠る（nanosleep(2) — シグナルで早く起きても再開しない。負の値は 0 と同じ）
func Sleep(ms int) {
    _ = sysSleep(if ms < 0 { 0 } else { ms })
}

// Getenv は環境変数 name の値（無ければ nil — 空の値 `NAME=` は "" で、無いのと区別する）。値が不正な UTF-8 なら utf8.InvalidUtf8
// （Args と同じ — 入力次第で起きる = error）。同名が複数あれば最初の 1 つ（getenv(3) と同じ）
@errors(utf8.InvalidUtf8)
func Getenv(name string) (string?, error?) {
    b := sysEnviron()
    nb := bytes(name)
    mut start := 0
    mut i := 0
    while i < len(b) {
        if b[i] == 0 {
            if keyIs(b, start, i, nb) {
                v := string(b[start + len(nb) + 1:i])?
                return v, nil
            }
            start = i + 1
        }
        i += 1
    }
    return nil, nil
}

// keyIs は b[start:end] が「nb + '='」で始まるか
func keyIs(b []byte, start int, end int, nb []byte) bool {
    if end - start < len(nb) + 1 || b[start + len(nb)] != '=' {
        return false
    }
    for k <- iter.Range(0, len(nb)) {
        if b[start + k] != nb[k] {
            return false
        }
    }
    return true
}

// argz は s のバイト + 0 を b に積む（s が NUL を含めば false）
func argz(b mut []byte, s string) bool {
    sb := bytes(s)
    for i <- iter.Range(0, len(sb)) {
        if sb[i] == 0 {
            return false
        }
        b = append(b, sb[i])
    }
    b = append(b, 0)
    return true
}

// errOf は errno → io のラベル（io.errOf と同じ分け方）
func errOf(e int) error {
    if e == 2 || e == 20 {
        return io.NotFound{}
    }
    if e == 13 || e == 1 || e == 30 {
        return io.Denied{}
    }
    return io.Other{errno: e}
}
