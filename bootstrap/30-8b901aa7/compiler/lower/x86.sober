package lower

// IR → x86_64 機械語 → 静的 ELF（正規バックエンド — src/stage1/ir_x86.zig・ir_x86_ra.zig・ir_live.zig・ir_cfg.zig の写し。B-1d）。
// 入力は rtlower を通した IR（region op を含まない）。ランタイムは IR の関数としてほかと同じに下ろす。
// 照合 = stage1 が同じ IR テキストから建てた ELF とのバイト一致（elfeq）— 中間成分（区間・置き場）の Zig との照合は無い（src/ 凍結）。
//
// 呼び出し規約（自前 — ABI は揃えない）: 引数は全部スタック（呼び手が後ろから push、callee は [rbp + 16 + 8k]、call の後に呼び手が add rsp, 8n）・
// 戻り値は rax・割り当て可能な 10 本はすべて callee-saved・一時は rax / rcx / rdx / r11（割り当てない）。
// 最適化のバックエンド（!st.xcopy — 呼び出し規約の段 1）は 10 本を callee-saved 5 本（rbx・r12〜r15）と caller-saved 5 本（rsi・rdi・r8〜r10）に割る:
// 呼び出し（xIsCallOp）を跨ぐ区間は callee-saved だけ・入口は使った callee-saved だけを退避・罠と切替の記録も callee-saved だけ（xCtxRegs）。
// 段 2: スロット・spill・退避・呼び出しの無い関数はフレームを立てない（e.nofr）。
// 段 3: 番地を取られない関数（st.xAddr — OpFuncaddr の行き先でない）への直の call は、先頭 4 引数を rsi・r8・r9・r10 で渡し（xArgReg）、
// 5 本目以降を今までどおり後ろから push（呼ばれ側は [rbp + 16 + 8(k − 4)]）。番地を取られる関数（task の入口・par の子・罠の行き先・比較関数・
// シグナルの口）と間接の道（OpCallI・罠・開始・clone の子）は旧規約。関数の番地の即値を作るのは OpFuncaddr だけ（xAbs kind 1）なので、
// 間接に呼ばれうる関数は必ず印を持つ。手書きの呼び手を持つ sober_entry（_start が初期の rsp を push）も印あり。並びに rdi を入れないのは、入口のスロットのゼロ初期化（rep stosq）が rdi を壊すため（逃がしの mov が要らない）。
// 冷たい呼び出し（xColdCall — 成長の rt への呼び出し）は跨ぎの集合に入れない: それだけを跨ぐ区間は 10 本ぜんぶ（callee-saved を先に）
// に置け、呼び手がその呼び出しの前後で跨ぐ caller-saved を退避・復元する（xColdSave / xColdLoad — 熱い道の命令は増えない・report-462 (c)）。
// 写しのバックエンドは旧規約のまま（elfeq の照合と optdiff の参照）。
// フレーム: push rbp; mov rbp, rsp; sub rsp, F。[rbp - …] に IR スロット（入口で rep stosq のゼロ初期化）→ 退避域 → spill の順。
// 命令選択はオペランドを全部読んでから結果を書く（割り当て器が同じ位置で終わる区間のレジスタを始まる区間へ渡す前提）。
// 到達しないブロックは吐かない。ブロックは後続を後ろから辿る逆後順に並べる。番地は 0x400000 帯の imm32 の絶対値、call / jmp は rel32 — 配置の後で埋める。
//
// IR の読み口（xBlk 等）はこのファイルの先頭に集める — 記録の形（ir.sober の F_* / B_* / I_*）を知るのはここだけ（C7 の Table 化は読み口の中身の差し替えで済む）。
//
// 置き場 Loc は int に詰める: レジスタ r = r × 2 + 1（奇数）、フレームの変位 d = d × 2（偶数）

import "desugar"
import "elf"
import "std/iter"
import "std/par"
import "std/table"
import "x86"

// ── IR の読み口 ──

func xFnNParam(st mut St, f FnRef) int { return xg(mut st, xfPtys(mut st, f)) }
func xSlotNext(st mut St, s int) int { return xg(mut st, s) }
func xSlotWords(st mut St, s int) int { return xg(mut st, s + 1) }
func xParamNext(st mut St, p int) int { return xg(mut st, p) }
func xParamVal(st mut St, p int) int { return xg(mut st, p + 1) }
func xTermX(st mut St, b BlkRef, k int) int { return xg(mut st, int(b) + B_X1 + k - 1) }
func xGlobNext(st mut St, g int) int { return xg(mut st, g + G_NEXT) }
func xGlobWords(st mut St, g int) int { return xg(mut st, g + G_WORDS) }
func xGlobInit(st mut St, g int) int { return xg(mut st, g + G_INIT) }

// 値の列（-1 は空）
func xLen(st mut St, l int) int { return if l < 0 { 0 } else { xg(mut st, l) } }
func xAt(st mut St, l int, k int) int { return xg(mut st, l + 1 + k) }

// xIsEntry は関数の名前が sober_entry か
func xIsEntry(st mut St, f FnRef) bool {
    s := xfName(mut st, f)
    w := bytes("sober_entry")
    if dat(mut st, s) != len(w) {
        return false
    }
    for i <- iter.Range(0, len(w)) {
        if dat(mut st, s + 1 + i) != int(w[i]) {
            return false
        }
    }
    return true
}

// 命令のオペランド（値）の数と k 番目（ir_live.operands と同じ集合 — region op の分は rtlower の前に掛ける mem2reg が使う）。
// 欄の種別の表（ir.sober の opRow / termRow）の専用形: 熱い読み口なので if の列のまま（表を走査する形は自己 build で +0.52 G 命令）。
// 表との一致は lower の単体テスト（kinds_test.sober — 全 op × 全終端）が見る
func xNOps(st mut St, i InsRef) int {
    op := xiOp(mut st, i)
    return if op == OpScanB { xLen(mut st, xiA(mut st, i)) } else if op == OpBin || op == OpCmp || op == OpStore || op == OpStore8 || op == OpGepW || op == OpGepB { 2 } else if op == OpLoad || op == OpLoad8 || op == OpPtoi || op == OpItop || op == OpRSetDepth || op == OpRBump { 1 } else if op == OpRAlloc || op == OpRReloc { 2 } else if op == OpCall { xLen(mut st, xiB(mut st, i)) } else if op == OpCallI || op == OpTrapI || op == OpTSwitch || op == OpTStart || op == OpAtomic || op == OpClone { 1 + xLen(mut st, xiB(mut st, i)) } else if op == OpSyscall { xLen(mut st, xiA(mut st, i)) } else { 0 }
}

func xOpnd(st mut St, i InsRef, k int) int {
    op := xiOp(mut st, i)
    return if op == OpScanB { xAt(mut st, xiA(mut st, i), k) } else if op == OpBin || op == OpCmp { if k == 0 { xiB(mut st, i) } else { xiC(mut st, i) } } else if op == OpStore || op == OpStore8 { if k == 0 { xiA(mut st, i) } else { xiC(mut st, i) } } else if op == OpGepW || op == OpGepB || op == OpRAlloc { if k == 0 { xiA(mut st, i) } else { xiB(mut st, i) } } else if op == OpRReloc { if k == 0 { xiA(mut st, i) } else { xiC(mut st, i) } } else if op == OpCall { xAt(mut st, xiB(mut st, i), k) } else if op == OpCallI || op == OpTrapI || op == OpTSwitch || op == OpTStart || op == OpAtomic || op == OpClone { if k == 0 { xiA(mut st, i) } else { xAt(mut st, xiB(mut st, i), k - 1) } } else if op == OpSyscall { xAt(mut st, xiA(mut st, i), k) } else { xiA(mut st, i) }
}

// 終端のオペランド（条件・戻り値・辺の実引数）
func xNTermOps(st mut St, b BlkRef) int {
    t := xbTerm(mut st, b)
    return if t == TmBr { xLen(mut st, xTermX(mut st, b, 2)) } else if t == TmCondbr { 1 + xLen(mut st, xTermX(mut st, b, 3)) + xLen(mut st, xTermX(mut st, b, 5)) } else if t == TmRet { if xTermX(mut st, b, 1) >= 0 { 1 } else { 0 } } else { 0 }
}

func xTermOpnd(st mut St, b BlkRef, k int) int {
    t := xbTerm(mut st, b)
    if t == TmBr {
        return xAt(mut st, xTermX(mut st, b, 2), k)
    }
    if t == TmCondbr {
        if k == 0 {
            return xTermX(mut st, b, 1)
        }
        nt := xLen(mut st, xTermX(mut st, b, 3))
        return if k - 1 < nt { xAt(mut st, xTermX(mut st, b, 3), k - 1) } else { xAt(mut st, xTermX(mut st, b, 5), k - 1 - nt) }
    }
    return xTermX(mut st, b, 1)
}

// 後続（br は 1 本、condbr は then・else の 2 本 — 同じ先でも 2 本）: 記録 → 番号
func xNSucc(st mut St, b BlkRef) int {
    t := xbTerm(mut st, b)
    return if t == TmBr { 1 } else if t == TmCondbr { 2 } else { 0 }
}

func xSucc(st mut St, b BlkRef, k int) int {
    t := xbTerm(mut st, b)
    to := if t == TmBr { xbBrTo(mut st, b) } else if k == 0 { xbThen(mut st, b) } else { xbElse(mut st, b) }
    return xbId(mut st, to)
}

// ── 置き場 ──

func xLocReg(r int) int { return r * 2 + 1 }
func xLocFrame(d int) int { return d * 2 }
func xIsReg(l int) bool { return l & 1 == 1 }
func xLocVal(l int) int { return l >> 1 }

const xNone = -1
const xSpill = 1099511627776 // 割り当て中の「spill の置き場（未定）」の印（偶数 — どの変位とも重ならない）
const xPanic = 101
const xRemat = 17592186044416 // 2^44: 並行コピーの読み元の「作り直す定数」の印の基点（xSrcLoc）

// 割り当て可能なレジスタ（割り当てる順 — syscall の引数に使う rsi / rdi / r8〜r10 は後ろ）
func xAllocReg(k int) int {
    regs := []int{x86.Rbx, x86.R12, x86.R13, x86.R14, x86.R15, x86.Rsi, x86.Rdi, x86.R8, x86.R9, x86.R10}
    return regs[k]
}

const xNAlloc = 10
// 最適化のバックエンドの規約（呼び出し規約の段 1）: xAllocReg の前 5 本（rbx・r12〜r15）が callee-saved・後ろ 5 本（rsi・rdi・r8〜r10）が caller-saved
const xNCallee = 5

// float のクラス（第二便 float の段 — opt のバックエンドだけ）: xmm k は置き場の番号 xX0 + k（xLocReg(xX0 + k)）。割り当ての組は xmm8〜15
// （xmm0〜7 は scanb の作業と float の演算の scratch〔xmm0 / xmm1〕）。callee-saved（汎用レジスタと同じ規約 — 使った xmm を入口で退避・出口で戻す）
const xX0 = 16
const xNXmm = 8
// scanb を含まない関数は xmm2〜7 も割り当てに使う（1.0× アタック便 — mandelbrot の最内ループが 8 本では足りず定数と ci を毎反復作り直し・読み直していた）
const xNXmmWide = 14

// xXmmReg は割り当ての k 番目の xmm（xmm8〜15 を先に・広い組では続けて xmm2〜7）
func xXmmReg(k int) int { return if k < 8 { xX0 + 8 + k } else { xX0 + 2 + (k - 8) } }
// xHasScanB は関数に scanb があるか（xmm0〜7 を作業に使う）
func xHasScanB(st mut St, e mut xF) bool {
    for k <- iter.Range(0, e.nb) {
        b := BlkRef(e.blk[k])
        if int(b) >= 0 {
            mut i := xbIHead(mut st, b)
            while i != -1 {
                if xiOp(mut st, i) == OpScanB {
                    return true
                }
                i = xiNext(mut st, i)
            }
        }
    }
    return false
}

func xIsXmm(l int) bool { return xIsReg(l) && xLocVal(l) >= xX0 }
func xIsGpr(l int) bool { return xIsReg(l) && xLocVal(l) < xX0 }

func xParamDisp(k int) int { return 16 + 8 * k }

// 呼び出し規約の段 3: 引数レジスタ（k < xNArgReg）
const xNArgReg = 4
func xArgReg(k int) int {
    regs := []int{x86.Rsi, x86.R8, x86.R9, x86.R10}
    return regs[k]
}

// xRegCc は関数 f が段 3 の規約（先頭 4 引数をレジスタで）で呼ばれるか — 呼び手と呼ばれ側が同じ述語を引く
func xRegCc(st mut St, f FnRef, frecs []int) bool {
    return !st.xcopy && st.xAddr[xIndex(frecs, int(f))] == 0
}

// xParamHome は仮引数 k の呼び手が積んだ置き場（[rbp + 返り値]）・レジスタで来る仮引数は -1
func xParamHome(e mut xF, k int) int { return if k < e.nreg { -1 } else { xParamDisp(k - e.nreg) } }

// xAddrTaken は fr の添字ごとに「OpFuncaddr の行き先か」（段 3 の例外の印）。sober_entry も印あり（_start が初期の rsp を push して呼ぶ — 手書きの呼び手）
func xAddrTaken(st mut St, fr []int, entryRec int) []int {
    mut out := mut []int{}
    xFill(mut out, len(fr), 0)
    out[xIndex(fr, entryRec)] = 1
    for k <- iter.Range(0, len(fr)) {
        mut b := xfBHead(mut st, FnRef(fr[k]))
        while int(b) != -1 {
            mut i := xbIHead(mut st, b)
            while i != -1 {
                if xiOp(mut st, i) == OpFuncaddr {
                    out[xIndex(fr, xiA(mut st, i))] = 1
                }
                i = xiNext(mut st, i)
            }
            b = xbNext(mut st, b)
        }
    }
    return freeze(out)
}

// xFill は a に v を n 個積む（作業域の確保 — 1 本ずつ連続に積むので先端一致でコピーしない）
func xFill(a mut []int, n int, v int) {
    for i <- iter.Range(0, n) {
        a = append(a, v)
    }
}

// ── モジュール ──

// 後埋め: 表に 3 語ずつ [位置, 種類, 相手の番号]（種類 0 = call rel32 → 関数・1 = 関数の番地 imm32・2 = global の番地 imm32）。
// struct の表（Table[xFix]）にしないのは、総称の Get の結果の欄読みを check が CoreFragment で拒否するため（F-d の形）
func xFixAdd(fx mut table.Table[int], at int, kind int, id int) {
    table.Push(mut fx, at)
    table.Push(mut fx, kind)
    table.Push(mut fx, id)
}

// xModule は rtlower を通したモジュールの ELF（syms = true なら ELF の代わりに関数の先頭番地の表 — `sober build --emit=syms` の
// プロファイルの口: 1 行 `<16 進の番地> <関数名>`・番地の昇順。Sober の ELF はシンボルを持たないので perf のサンプルをこれで関数へ振る — scripts/prof.ts）
func xModule(st mut St, syms bool) []byte {
    // 名前で引くもの（入口の関数・syms の名前 — 名前の文字列はヒープにもある）は凍結の前に引く
    mut entryRec := -1
    mut names := mut [][]byte{}
    mut f0 := st.fhead
    while f0 != -1 {
        if entryRec < 0 && xIsEntry(mut st, f0) {
            entryRec = int(f0)
        }
        if syms {
            mut nm := mut []byte{}
            printName(mut st, mut nm, irFnName(mut st, f0))
            names = append(names, freeze(nm))
        }
        f0 = irFnNext(mut st, f0)
    }
    // ヒープを凍らせる（以後 x86 の段はヒープを書かない — 読みは xg が凍らせた表から。凍結の口 — 仮裁定 2026-10-07 夜間）
    st.hf = desugar.HeapFreeze(mut st.d)
    st.hfOn = true
    return xModuleFrozen(mut st, syms, entryRec, freeze(names))
}

// xModuleFrozen は凍結の後の xModule の本体（呼び出しの閉包がヒープ〔st.d.h・hget / hset / hpush・dat〕に届かないことを scripts/lparcfg.ts の網が見る）
func xModuleFrozen(st mut St, syms bool, entryRec int, names [][]byte) []byte {
    // 関数・global の記録 → 番号（鎖は追加順 = 記録の番地の昇順 — 二分探索で引く）
    mut frecs := mut []int{}
    mut f := st.fhead
    while f != -1 {
        frecs = append(frecs, int(f))
        f = xfNext(mut st, f)
    }
    nf := len(frecs)
    st.xAddr = xAddrTaken(mut st, freeze(frecs), entryRec)
    mut grecs := mut []int{}
    mut g := st.ghead
    while g >= 0 {
        grecs = append(grecs, g)
        g = xGlobNext(mut st, g)
    }
    ng := len(grecs)
    fr := freeze(frecs)
    gr0 := freeze(grecs)
    // global の配置: init ありは rodata、無しは .bss（各 8 × 語数バイト）
    mut goff := mut []int{}
    xFill(mut goff, ng, 0)
    mut gro := mut []int{}
    xFill(mut gro, ng, 0)
    mut rodata := mut []byte{}
    mut bss := 0
    for i <- iter.Range(0, ng) {
        gr := gr0[i]
        init := xGlobInit(mut st, gr)
        words := xGlobWords(mut st, gr)
        if init >= 0 {
            goff[i] = len(rodata)
            gro[i] = 1
            n := xLen(mut st, init)
            for k <- iter.Range(0, words) {
                w := if k < n { xAt(mut st, init, k) } else { 0 }
                for j <- iter.Range(0, 8) {
                    rodata = append(rodata, byte(w >> (8 * j) & 255))
                }
            }
        } else {
            goff[i] = bss
            bss = bss + 8 * words
        }
    }
    mut entry := -1
    for i <- iter.Range(0, nf) {
        if fr[i] == entryRec {
            entry = i
        }
    }
    if entry < 0 {
        panic(InvariantBroken{})
    }
    mut c := table.Table[byte]{}
    mut fx := table.Table[int]{}
    // _start: mov rax, rsp; and rsp, -16; sub rsp, 8; push rax; call sober_entry; ud2
    x86.MovRegReg(mut c, x86.Rax, x86.Rsp)
    x86.AndRegImm(mut c, x86.Rsp, -16)
    x86.SubRegImm(mut c, x86.Rsp, 8)
    x86.PushReg(mut c, x86.Rax)
    xFixAdd(mut fx, x86.CallRel32(mut c), 0, entry)
    x86.Ud2(mut c)
    mut fstart := mut []int{}
    xFill(mut fstart, nf, 0)
    // 切替 / 罠を持つ関数は最後に（段 6 P4-6）: それらが積む xmm の組 = 全関数の割り当てが使う xmm の和（st.xXmm — 値は float でなくても
    // xmm に載りうる）。自分たちの使う分も和に入れるため、先に下書き（割り当てまで — 吐かない）を走らせてから本番を吐く（xFunc は st を書かない — 同じ機械語）
    st.xXmm = 0
    mut ctx := mut []int{}
    xFill(mut ctx, nf, 0)
    for i <- iter.Range(0, nf) {
        if xCtxFn(mut st, FnRef(fr[i])) {
            ctx[i] = 1
        }
    }
    // 線の跨ぎの詰め物の窓の表（xFunc — モジュールで 1 組を積み増して使う。窓ごとに新しい表を作ると最初の Push の chunk の確保〔8192 要素〕が
    // 窓の数だけ掛かった — 自己 build +0.45 G）
    mut wb := table.Table[byte]{}
    mut wf := table.Table[int]{}
    // 切替 / 罠を持たない関数は群の子で（段 6 P6-4 — xParEmit。写しのバックエンドと 1 本の経路〔st.xseq〕・群が 1 つ以下は逐次）
    // 吐く周は 3 つ（0 = 切替 / 罠を持たない関数の逐次・1 = 切替 / 罠を持つ関数の下書き〔割り当てで xmm の和を集めるだけ — 吐かない〕・2 = その本番）。
    // xFunc の呼び出し点は 1 か所に保つ: check は mut 引数の関数を呼び出し点ごとに展開して型付けするので、呼び出し点が増えると x86 の全体が
    // その数だけ写される（自己 check の作業域 — report-510）
    seq := st.xcopy || st.xseq || !xParEmit(mut st, mut c, mut fx, mut fstart, freeze(ctx), fr, gr0)
    for pass <- iter.Range(0, 3) {
        for i <- iter.Range(0, nf) {
            if (pass == 0 && ctx[i] == 0 && seq) || (pass > 0 && ctx[i] == 1) {
                if pass != 1 {
                    xAlignFn(mut st, mut c)
                    xLayPad(mut st, mut c, fr[i])
                }
                s := xFunc(mut st, mut c, mut fx, mut wb, mut wf, FnRef(fr[i]), fr, gr0, elf.CodeOffset, pass == 1)
                if pass != 1 {
                    fstart[i] = s
                }
            }
        }
    }
    lay := elf.LayoutOf(x86.Here(mut c), len(rodata))
    if syms {
        mut out := mut []byte{}
        for i <- iter.Range(0, nf) {
            xHex(mut out, lay.Code + fstart[i])
            out = append(out, ' ')
            for b <- names[i] {
                out = append(out, b)
            }
            out = append(out, '\n')
        }
        return freeze(out)
    }
    for k <- iter.Range(0, table.Len(mut fx) / 3) {
        at := table.Get(mut fx, 3 * k)
        kind := table.Get(mut fx, 3 * k + 1)
        id := table.Get(mut fx, 3 * k + 2)
        if kind == 0 {
            x86.PatchRel32(mut c, at, fstart[id])
        } else if kind == 1 {
            x86.PatchImm32(mut c, at, lay.Code + fstart[id])
        } else {
            x86.PatchImm32(mut c, at, (if gro[id] == 1 { lay.Rodata } else { lay.Bss }) + goff[id])
        }
    }
    return elf.Executable(mut c, freeze(rodata), if bss > 8 { bss } else { 8 })
}

// ── 関数の並列（段 6 P6-4 / 7 節）──
//
// 切替 / 罠を持たない関数を、吐く順（鎖の順）に連続した群に割り（命令の数でおよそ XG_COST ずつ — ワーカー数を読まない）、群ごとに par.Map の子が
// 自前の St で xFunc を回す。子はヒープを親が凍らせた表（st.hf — xModule の入口の table.Freeze: 写さない。凍結の口 — 仮裁定 2026-10-07 夜間・
//）から同じ番地で読む: このファイルの IR の読み口は xg を通す（st.hfOn なら凍らせた表を直に、でなければ st.d.h を読む — 記録の番号の
// 付け替えが要らない）。xFunc はヒープを書かない。xModule の呼び出しの閉包が凍結の後にヒープへ届かないことは scripts/lparcfg.ts の網が見る。
// 子は機械語のバイト列・群の中の関数の先頭位置・後埋めの表（位置は群の頭から）・割り当てが使った xmm の和を返し、親が群の順（= 吐く順）に連結する
// （関数の先頭番地 = 累積和。後埋めは全関数の後で一括 — 今のまま）。切替 / 罠の関数（xmm の和が要る 2 段目）は親が今までどおり後で吐く。
// **xFunc が読む St の欄は xParCfg の 12 語とヒープだけ** — このファイルで st.〈欄〉を新しく読む・lower の他のファイルの関数を新しく呼ぶときは
// 子の St に写すこと（足し忘れは子がゼロ値を読む — selfpar の 1 本の経路 ≡ W8 の ELF の照合が網）。
// ワーカー 1 では逐次（写しはヒープの全体 — 純粋な上乗せ・自己 build の RSS のラチェット〔W1〕を越える）。出力はどちらでも同じバイト

const XG_COST = 25000  // 群の目標の太さ（命令の数）

// xg はヒープの i 語目（子は親の写しを読む）
func xg(st mut St, i int) int {
    if st.hfOn {
        // 凍結した表を直に読む（範囲の検査は table.Get / At と同じ形 — 呼び出しを挟まない）
        k := if (i | (st.hf.n - 1 - i)) < 0 { -1 } else { i / table.CHUNK }
        return st.hf.chunks[k][i & (table.CHUNK - 1)]
    }
    return desugar.HeapGet(mut st.d, i)
}

// IR の読み口（ir.sober の irXxx の xg 版 — 子でも読める）
func xbIHead(st mut St, b BlkRef) InsRef { return InsRef(xg(mut st, int(b) + B_IHEAD)) }
func xbITail(st mut St, b BlkRef) InsRef { return InsRef(xg(mut st, int(b) + B_ITAIL)) }
func xbId(st mut St, b BlkRef) int { return xg(mut st, int(b) + B_ID) }
func xbNext(st mut St, b BlkRef) BlkRef { return BlkRef(xg(mut st, int(b) + B_NEXT)) }
func xbPHead(st mut St, b BlkRef) int { return xg(mut st, int(b) + B_PHEAD) }
func xbTerm(st mut St, b BlkRef) int { return xg(mut st, int(b) + B_TERM) }
func xbBrTo(st mut St, b BlkRef) BlkRef { return BlkRef(xg(mut st, int(b) + B_X1)) }
func xbThen(st mut St, b BlkRef) BlkRef { return BlkRef(xg(mut st, int(b) + B_X2)) }
func xbElse(st mut St, b BlkRef) BlkRef { return BlkRef(xg(mut st, int(b) + B_X4)) }
func xfBHead(st mut St, f FnRef) BlkRef { return BlkRef(xg(mut st, int(f) + F_BHEAD)) }
func xfNBlk(st mut St, f FnRef) int { return xg(mut st, int(f) + F_NBLK) }
func xfNVal(st mut St, f FnRef) int { return xg(mut st, int(f) + F_NVAL) }
func xfName(st mut St, f FnRef) int { return xg(mut st, int(f) + F_NAME) }
func xfNext(st mut St, f FnRef) FnRef { return FnRef(xg(mut st, int(f) + F_NEXT)) }
func xfPtys(st mut St, f FnRef) int { return xg(mut st, int(f) + F_PTYS) }
func xfSHead(st mut St, f FnRef) int { return xg(mut st, int(f) + F_SHEAD) }
func xiA(st mut St, i InsRef) int { return xg(mut st, int(i) + I_A) }
func xiB(st mut St, i InsRef) int { return xg(mut st, int(i) + I_B) }
func xiC(st mut St, i InsRef) int { return xg(mut st, int(i) + I_C) }
func xiNext(st mut St, i InsRef) InsRef { return InsRef(xg(mut st, int(i) + I_NEXT)) }
func xiOp(st mut St, i InsRef) int { return xg(mut st, int(i) + I_OP) }
func xiRes(st mut St, i InsRef) int { return xg(mut st, int(i) + I_RES) }

// XPar は 1 つの群の子の結果
type XPar struct {
    code []byte
    starts []int   // 群の中の関数ごとの先頭位置（群の頭から）
    fix []int      // 後埋め [位置, 種類, 相手] — 位置は群の頭から
    xmm int
}

// XGroup は 1 つの群（関数の記録の列・命令の数）
type XGroup struct {
    fns []int
    cost int
}

// xParCfg は子の St に写す欄（xFunc が読む St の欄の全部 — 上の注意）
func xParCfg(st mut St) []int {
    return []int{int(st.rtCopy), int(st.rtCopy8), int(st.rtGrow), int(st.rtGrow8), int(st.rtGrowTry), int(st.rtMapGrow), int(st.rtReloc), int(st.rtReloc8),
        st.trapG, if st.trapUse { 1 } else { 0 }, if st.taskUse { 1 } else { 0 }, if st.xcopy { 1 } else { 0 }, st.xLay, int(st.rtPanic), int(st.rtPanicMem), if st.slotPoison { 1 } else { 0 }}
}

// 整列（配置の土台）: 関数の先頭とループの頭を XA_* バイトの境界へ nop で詰める（最適化のバックエンドだけ — 写しのバックエンドは
// stage1 とバイト一致のまま）。番地は lay.Code（= 基底 + elf.CodeOffset）からなので、整列は CodeOffset を足した位置で測る。ループの頭は関数の先頭からの
// 相対で詰める（関数の先頭が整列しているので絶対でも揃う）。同じ機械語のループが 32 B の取り込みの窓を 2 つまたぐか 3 つまたぐかで cycles が
// 1.4 倍動いた（粒度の葉 — 命令は同じ）。
// 関数の先頭は 64 B（取り込みの線の幅）: 関数の中の線の上の配置（分岐の線の中の位置・ループの跨ぎ）がその関数自身の機械語だけで
// 決まり、ほかの関数の大きさの変化で動かない。32 B では上流が 16 B 伸びるたびに mod 64 が 0 / 16 / 32 / 48 を行き来し、fannkuch の予測ミスが
// 148 / 161 M の二峰を渡った（64 B の倍数のずらしでは 4 KB 回しても 145〜149 M）。関数の間の nop は ret / jmp の後で実行されない
const XA_FN = 64
const XA_LOOP = 32

func xAlignFn(st mut St, c mut table.Table[byte]) {
    if !st.xcopy {
        x86.AlignTo(mut c, elf.CodeOffset, XA_FN)
    }
}

// xLayPad は配置の計器のずらし（開発用 — xLay = 0 なら何もしない）。同じ形の配置を振って cycles の分布を取る:
//   v2（`--layout=S` — xLay = S）: 整列した関数の先頭の後ろに 0 / 64 / 128 / 192 B（上位の bit だけ — 関数の 64 B 整列の後に起こりうる、ほかの関数の変化）。
//     関数の中の変化は xLayInner（最初の落ちない点に 0〜48 B — その関数の手前のコードの大きさの変化を模す）
//   v1（`--layout-v1=S` — xLay = 1000 + S）: 整列した関数の先頭の後ろに 0 / 16 / 32 / 48 B（32 B 整列の時代の「上流の関数の伸び」）
func xLayPad(st mut St, c mut table.Table[byte], f int) {
    if st.xLay > 0 && !st.xcopy {
        v1 := st.xLay > 1000
        h := xLayHash(st.xLay, f)
        x86.Nop(mut c, if v1 { (h & 3) * 16 } else { ((h >> 2) & 3) * 64 })
    }
}

func xLayHash(lay int, f int) int {
    s := if lay > 1000 { lay - 1000 } else { lay }
    return ((f + 1) * (s * 2 + 1) * 2654435761) >> 16
}

// xLayInner は計器 v2 の関数の中のずらし: 最初の落ちない点（手前のブロックが jmp / ret で終わる — 詰め物は実行されない）に 0 / 16 / 32 / 48 B
func xLayInner(st mut St, c mut table.Table[byte], f int) {
    if st.xLay > 0 && st.xLay < 1000 && !st.xcopy {
        x86.Nop(mut c, (xLayHash(st.xLay, f) & 3) * 16)
    }
}

// xParEmit は切替 / 罠を持たない関数（ctx[i] = 0）を群の子で吐いて c / fx へ吐く順に連結する（fstart を埋め st.xXmm に和を足す）。
// 群が 1 つ以下かワーカー 1 なら何もせず false（呼び手が今までの逐次で吐く）
func xParEmit(st mut St, c mut table.Table[byte], fx mut table.Table[int], fstart mut []int, ctx []int, fr []int, gr []int) bool {
    if par.Ledger().workers <= 1 {
        return false
    }
    mut gs := mut []XGroup{}
    mut order := mut []int{}   // 群に入れた関数の fr の添字（吐く順）
    mut cg := mut []int{}
    mut acc := 0
    for i <- iter.Range(0, len(fr)) {
        if ctx[i] == 0 {
            order = append(order, i)
            cg = append(cg, fr[i])
            acc += xFnCost(mut st, FnRef(fr[i]))
            if acc >= XG_COST {
                gs = append(gs, XGroup{freeze(cg), acc})
                cg = mut []int{}
                acc = 0
            }
        }
    }
    if len(cg) > 0 {
        gs = append(gs, XGroup{freeze(cg), acc})
    }
    if len(gs) <= 1 {
        return false
    }
    mut big := 0
    for k <- iter.Range(0, len(gs)) {
        if gs[k].cost > big {
            big = gs[k].cost
        }
    }
    // budget: = 群の命令の数の最大 × 128 B + 4 MiB（子の作業域 = xF の表と機械語 — 写しは親の分で子は数えない。校正: 自己 build の群〔2.5 万命令〕の子の peak 2.4 MB）
    bud := big * 128 + 4 * par.MB
    hf := st.hf
    cfg := xParCfg(mut st)
    addr := st.xAddr
    outs, serr := par.Map(freeze(gs), (g) => xParGroup(g, hf, cfg, addr, fr, gr), budget: bud)
    if serr != nil {
        return panic(InvariantBroken{})
    }
    mut j := 0
    of := freeze(order)
    for k <- iter.Range(0, len(outs)) {
        xParMerge(mut st, mut c, mut fx, mut fstart, outs[k], of, j)
        j += len(outs[k].starts)
    }
    return true
}

// xParMerge は群の子の結果を c / fx の末尾へ（関数の先頭番地 = 今の末尾 + 群の中の位置）
func xParMerge(st mut St, c mut table.Table[byte], fx mut table.Table[int], fstart mut []int, o XPar, order []int, j0 int) {
    xAlignFn(mut st, mut c)
    base := x86.Here(mut c)
    for k <- iter.Range(0, len(o.starts)) {
        fstart[order[j0 + k]] = base + o.starts[k]
    }
    for k <- iter.Range(0, len(o.code)) {
        table.Push(mut c, o.code[k])
    }
    for k <- iter.Range(0, len(o.fix) / 3) {
        xFixAdd(mut fx, base + o.fix[3 * k], o.fix[3 * k + 1], o.fix[3 * k + 2])
    }
    st.xXmm = st.xXmm | o.xmm
}

// xFnCost は関数の命令の数（群の太さの物差し）
func xFnCost(st mut St, f FnRef) int {
    mut ni := 0
    mut b := xfBHead(mut st, f)
    while int(b) != -1 {
        mut i := xbIHead(mut st, b)
        while i != -1 {
            ni += 1
            i = xiNext(mut st, i)
        }
        b = xbNext(mut st, b)
    }
    return ni
}

// xParGroup は子の本体: 凍らせた表を読む St を組み、群の関数を吐く
func xParGroup(g XGroup, hf table.Frozen[int], cfg []int, addr []int, fr []int, gr []int) XPar {
    mut st := St{}
    kindsInit(mut st)
    st.hfOn = true
    st.hf = hf
    st.rtCopy = FnRef(cfg[0])
    st.rtCopy8 = FnRef(cfg[1])
    st.rtGrow = FnRef(cfg[2])
    st.rtGrow8 = FnRef(cfg[3])
    st.rtGrowTry = FnRef(cfg[4])
    st.rtMapGrow = FnRef(cfg[5])
    st.rtReloc = FnRef(cfg[6])
    st.rtReloc8 = FnRef(cfg[7])
    st.trapG = cfg[8]
    st.trapUse = cfg[9] == 1
    st.taskUse = cfg[10] == 1
    st.xcopy = cfg[11] == 1
    st.xLay = cfg[12]
    // 呼び出し規約の段 1 / 段 2（xIsCallOp・xNoCall）が戻らない panic の call を見分ける — 無いと群の中だけ St{} の 0 を panic とみなし、W1 と ELF が食い違う
    st.rtPanic = FnRef(cfg[13])
    st.rtPanicMem = FnRef(cfg[14])
    st.slotPoison = cfg[15] == 1
    // 段 3 の例外の印（xRegCc）
    st.xAddr = addr
    st.xXmm = 0
    mut c := table.Table[byte]{}
    mut fx := table.Table[int]{}
    mut wb := table.Table[byte]{}
    mut wf := table.Table[int]{}
    mut starts := mut []int{}
    for k <- iter.Range(0, len(g.fns)) {
        // 群の中の位置で整列（群は親の末尾の整列した位置へ連結する — xParMerge）
        x86.AlignTo(mut c, 0, XA_FN)
        xLayPad(mut st, mut c, g.fns[k])
        starts = append(starts, xFunc(mut st, mut c, mut fx, mut wb, mut wf, FnRef(g.fns[k]), fr, gr, 0, false))
    }
    mut code := mut []byte{}
    for k <- iter.Range(0, x86.Here(mut c)) {
        code = append(code, table.Get(mut c, k))
    }
    mut fix := mut []int{}
    for k <- iter.Range(0, table.Len(mut fx)) {
        fix = append(fix, table.Get(mut fx, k))
    }
    return XPar{freeze(code), freeze(starts), freeze(fix), st.xXmm}
}

// xCtxFn は関数に task の切替 / 罠（OpTSwitch・OpTStart・OpTrapI）があるか（段 6 P4-6 — 積む xmm の組をプログラム全体の和で決めるので最後に吐く）
func xCtxFn(st mut St, f FnRef) bool {
    mut b := xfBHead(mut st, f)
    while int(b) != -1 {
        mut i := xbIHead(mut st, b)
        while i != -1 {
            op := xiOp(mut st, i)
            if op == OpTSwitch || op == OpTStart || op == OpTrapI {
                return true
            }
            i = xiNext(mut st, i)
        }
        b = xbNext(mut st, b)
    }
    return false
}

// xIndex は昇順の recs で r の添字
func xIndex(recs []int, r int) int {
    mut lo := 0
    mut hi := len(recs) - 1
    while lo < hi {
        m := (lo + hi) / 2
        if recs[m] < r {
            lo = m + 1
        } else {
            hi = m
        }
    }
    if recs[lo] != r {
        panic(InvariantBroken{})
    }
    return lo
}

// ── 関数 ──

// 関数ごとの作業域（値・ブロックの番号で引く表）
type xF struct {
    f FnRef
    nv int
    np int
    nb int
    blk mut []int        // 番号 → 記録
    order mut []int      // 吐く順（到達するブロックだけ）
    norder int
    bpos mut []int       // ブロックの頭の位置（到達しないブロックは -1）
    // 区間（区間分割レーン S1b — 部分区間の表現）: 割り当ての単位は「部分区間」。値 v の最初の部分区間の番号は v 自身・続きは pnx の鎖で
    // 番号 nv 以降（開始の昇順・重ならない）。pv = 部分区間 → 値。区間が 1 本の値は pnx[v] = -1 で、今までの「値ごとに 1 本」と同じ
    ivS mut []int        // 部分区間 → 始まり（無しは -1）
    ivE mut []int
    loc mut []int        // 部分区間 → 置き場（読みは xLocAt — 位置つき）
    pnx mut []int        // 部分区間 → 同じ値の次の部分区間（-1 = 最後）
    pv mut []int         // 部分区間 → 値
    npc int              // 部分区間の数（≥ nv）
    spd mut []int        // 値 → spill 先の変位（部分区間で共有 — 0 = 未定）
    // 区間の分割（S2 — opt のときだけ）: ループの範囲（吐く順の [頭, 体の最後] の組）・割る点（奇数の位置 = ブロックの頭 − 1・昇順）・
    // 割れた値の列・部分区間の重み・吐く順のループの深さ
    lpR mut []int
    cuts mut []int
    sv mut []int
    pwt mut []int
    ldep mut []int
    pfix mut []int       // 二段目の固定（部分区間 → 一段目のレジスタ・-1 = 固定しない — 割った値の真ん中と一段目で spill した値・-2 = spill に固定 — spill した値の外側・
                         // -3 = spill した値のループの中の部分区間 — 一段目で spill した残りの後に余りの枠だけを取る）
    // 辺の写しの外置き（6.5 第 1 便 T1）: 条件分岐の写しの要る側を関数の末尾へ出した辺の [jcc の位置, 分岐の位置 e.pos, 行き先, 実引数]
    eoA mut []int
    eoP mut []int
    eoT mut []int
    eoX mut []int
    bdep mut []int       // ブロックの番号 → ループの深さ（外置きの判定 — 深さの下がる辺 = ループの出口）
    // 運搬値の穴（6.5 第 1 便 T2）: ループの頭の仮引数の [値, live-in のブロック] の組（xLive が集め xPieces が部分区間に組む）・値 → 頭のブロック（-1 = 候補でない）
    hvV mut []int
    hvB mut []int
    hdB mut []int
    // xPrioAlloc のレジスタごとの割り当て済みの区間（開始の昇順・平らな枠 — 二段目へ持ち越す）: レジスタ r の列は aL[aB[r] 〜] の aN[r] 個（枠 aC[r]）
    aL mut []int
    aB mut []int
    aC mut []int
    aN mut []int
    // 一段目の追い出し（区間の便 段 2 — D2）の作業域 1 本（欄を足すと mut xF を受ける関数の展開ごとに核の節が増える — 6 欄で +60k）:
    // 部分区間 c ごとに 4 語 [4c] = 追い出された回数・[4c + 1] = 処理済みの印・[4c + 2] = 中の触れの重み・[4c + 3] = 中の使用の数（xPcInit）、
    // 続けて [4 npc] = 中の触れを数えたか・[4 npc + 1] = ヒープの個数・[4 npc + 2 〜] = 追い出して列へ戻した部分区間のヒープ（xPrioBefore の順）
    ev mut []int
    slotDisp mut []int
    isConst mut []int
    constV mut []int
    saveReg mut []int
    saveDisp mut []int
    nsave int
    blockAt mut []int
    jAt mut []int        // ブロックへの jmp / jcc の rel32（関数の末尾で埋める）
    jTo mut []int
    nj int
    div0 mut []int       // ゼロ除算（exit 101）への jcc
    nd int
    pos int              // 今の命令の位置（syscall の周りで生きている値を引く）
    mvD mut []int        // 並行コピーの作業域
    mvS mut []int
    mvLive mut []int
    // 最適化のバックエンド（性能投資 M4 — st.xcopy = false。写しのバックエンドは opt = false で今までと 1 バイトも変わらない — elfeq / stages の cross が見る）
    opt bool
    fuse mut []int       // 値 → 1 なら比較の結果を値にせず、ブロックの condbr が flags をそのまま読む（比較がブロックの最後の命令・使い道がその condbr だけ）
    fcc int              // 融合した比較の条件コード
    flg mut []int        // 値 → 1 なら add / sub の立てた flags をすぐ後の condbr が読む（fuse 2）— lea にしない（lea は flags を立てない）
    next int             // 吐く順で次のブロックの番号（-1 = 無し）— 次へ落ちる jmp を省く
    fell bool            // 今吐いた終端が次のブロックへ落ちた（jmp を省いた）— ループの頭の整列を決める
    // 割り当ての改良（性能投資 M5 — opt のときだけ）: ヒント（辺の実引数 → 仮引数・仮引数 → 入りの実引数 2 本・演算の結果 → 左の被演算子）と spill の重み
    hP mut []int
    hA1 mut []int
    hA2 mut []int
    hOp mut []int
    wt mut []int         // 値の重み（定義・使用ごとに 8^ループの深さ — 深さ 4 で頭打ち）
    wc mut []int         // 冷たいブロックを深さ 0 で数えた重み（区間分割 S3a — 熱いブロックに使用の無い値はこちらを重みに）
    hu mut []int         // ループの中の熱いブロックの使用の数（定義・恒等の辺の実引数・ループの外の使用は数えない）
    cold mut []int       // 吐く順のブロックが冷たいか（xColdBlocks）
    // 冷たい領域の末尾配置（区間分割 S3b）: 末尾の区画の始まりの位置（無ければ大きな値）・末尾の外包（値ごと — 本体と別の部分区間に）
    c0 int
    tS mut []int
    tE mut []int
    npc0 int             // xSplitLoops の前の部分区間の数（二段目の差分の起点）
    porig mut []int      // 部分区間 → 割る前の部分区間（二段目の固定のレジスタの出所）
    remat mut []int      // 1 = imm32 の定数: 区間もレジスタも持たず、使う点で即値から作り直す（M5）
    // gep の番地の融合（第二便 M7）: fold[g] = 1 なら gep g を出さず、使う load / store が [p + ix * 倍率 + 変位]（SIB）で読む。fA / fB / fS = g の p・ix・倍率（8 / 1）
    fold mut []int
    fA mut []int
    fB mut []int
    fS mut []int
    // float のクラス（第二便 float の段）: fcls[v] = 1 なら xmm の組から割り当てる（xFloatClass）
    fcls mut []int
    // 割り当てに使う xmm の数（xNXmm か、scanb を含まない関数は xNXmmWide）
    nx int
    // 割れた値の spill 先が正しいか（第 1 便 (d) ③）: svOk[j × nb + ブロックの番号] = 1 なら、割れた値 e.sv[j] の spill 先は
    // そのブロックの終わりで値を持っている（xSlotValid）。reg → mem の境目の写し（store）はそこでは要らない
    svOk mut []int
    // 呼び出し規約の段 1（opt のときだけ）: 呼び出しの位置（昇順 — xLive）。区間がどれかを跨ぐ部分区間は callee-saved の組だけ（xPrioPick）
    cp mut []int
    // 冷たい呼び出しの局所 caller-save（report-462 (c)）: 冷たい呼び出しの位置（昇順 — 跨ぎの集合 cp には入れない）・その位置で真に生きる
    // caller-saved のレジスタの組（ビット — xAllocFrame）・レジスタごとの退避の枠の変位（0 = 無し）
    cpc mut []int
    cpm mut []int
    csd mut []int
    // 段 2（葉のフレームの省略 — opt）: スロット・spill・退避・呼び出しの無い関数は rbp を立てない（xNoFrame）。引数は [rsp + 8 + 8k]・出口は ret だけ
    nofr bool
    // 入口の零初期化の区間（rep stosq 便 段 1 — zeroinit.sober）: 位置 zTop（rbp - 8 × zTop）から上へ zCnt 語。0 語なら零初期化を出さない
    zTop int
    zCnt int
    // 段 3（引数のレジスタ渡し — opt）: この関数が段 3 の規約で呼ばれるか・レジスタで来る仮引数の数・値ごとのレジスタのヒント（-1 = 無し）
    rc bool
    nreg int
    hR mut []int
    // 定義直後の読み直しの省略（置き場の往復レーン 段 4a — opt）: 最後に xPut がフレームへ store した値・その読み元のレジスタ・store の直後の
    // 表の位置（-1 = 無し）。xGet / xGetInto が同じ値を表の位置が動く前に読むなら、レジスタに残っている値を使い load を省く。ブロックの頭で消す
    putV int
    putR int
    putAt int
    // 零初期化の沈め（置き場の往復レーン 段 4b (b1-z) — opt）: zAt[ブロックの番号] = 1 なら、そのブロックの頭で零初期化を吐く（入口では吐かない）。
    // 空 = 沈めない（入口で吐く）
    zAt mut []int
    // 吐くときの scratch の中身の覚え書き（place の覗き穴便 段 B — D1・opt）: mA / mC / mD = rax / rcx / rdx が今持つ値（-1 = 無し）。
    // memOn = 白名簿の命令（定数・load / store・番地を出さない gep / slotaddr — xMemoOp）を吐いている間。覚え書きはその間だけ引き・書き、
    // 名簿の外の命令の頭とブロックの頭で全部消す（名簿の外の吐き方が scratch を書くのを 1 つずつ追わない — 漏れが誤コンパイルになるので）
    mA int
    mC int
    mD int
    memOn bool
}

// xFunc は関数 f を c / fx へ吐く（ab = c の位置 0 の絶対の番地 — 親は elf.CodeOffset・群の子は 0〔子の表は親の 64 B に整列した位置へ
// 連結されるので、子の中の位置の mod 64 が絶対と同じ — xParMerge〕。線の跨ぎの詰め物と整列が読む）。返り値 = 関数の入口の位置（入口の手前に
// 線の跨ぎの詰め物を置くことがあるので、呼び手は吐く前の位置でなくこれを関数の先頭にする）
func xFunc(st mut St, c mut table.Table[byte], fx mut table.Table[int], wb mut table.Table[byte], wf mut table.Table[int], f FnRef, frecs []int, grecs []int, ab int, draft bool) int {
    mut e := xF{f: f, nv: xfNVal(mut st, f), np: xFnNParam(mut st, f), nb: xfNBlk(mut st, f), blk: mut []int{}, order: mut []int{}, norder: 0, bpos: mut []int{},
        ivS: mut []int{}, ivE: mut []int{}, loc: mut []int{}, pnx: mut []int{}, pv: mut []int{}, npc: 0, spd: mut []int{}, lpR: mut []int{}, cuts: mut []int{}, sv: mut []int{}, pwt: mut []int{}, ldep: mut []int{}, pfix: mut []int{}, aL: mut []int{}, aB: mut []int{}, aC: mut []int{}, aN: mut []int{}, ev: mut []int{}, slotDisp: mut []int{}, isConst: mut []int{}, constV: mut []int{}, saveReg: mut []int{}, saveDisp: mut []int{},
        nsave: 0, blockAt: mut []int{}, jAt: mut []int{}, jTo: mut []int{}, nj: 0, eoA: mut []int{}, eoP: mut []int{}, eoT: mut []int{}, eoX: mut []int{}, bdep: mut []int{}, hvV: mut []int{}, hvB: mut []int{}, hdB: mut []int{}, div0: mut []int{}, nd: 0, pos: 0, mvD: mut []int{}, mvS: mut []int{}, mvLive: mut []int{},
        opt: !st.xcopy, fuse: mut []int{}, flg: mut []int{}, fcc: 0, next: -1, fell: false, hP: mut []int{}, hA1: mut []int{}, hA2: mut []int{}, hOp: mut []int{}, wt: mut []int{}, wc: mut []int{}, hu: mut []int{}, cold: mut []int{}, c0: 9223372036854775807, tS: mut []int{}, tE: mut []int{}, npc0: 0, porig: mut []int{}, remat: mut []int{}, fold: mut []int{}, fA: mut []int{}, fB: mut []int{}, fS: mut []int{}, fcls: mut []int{}, nx: xNXmm, svOk: mut []int{}, cp: mut []int{}, cpc: mut []int{}, cpm: mut []int{}, csd: mut []int{}, nofr: false, zTop: 0, zCnt: 0, rc: false, nreg: 0, hR: mut []int{}, putV: -1, putR: -1, putAt: -1, zAt: mut []int{}, mA: -1, mC: -1, mD: -1, memOn: false}
    xFill(mut e.blk, e.nb, -1)
    e.rc = xRegCc(mut st, f, frecs)
    e.nreg = if !e.rc { 0 } else if e.np < xNArgReg { e.np } else { xNArgReg }
    mut b := xfBHead(mut st, f)
    mut ninst := 0
    mut maxArgs := 7
    while b != -1 {
        e.blk[xbId(mut st, b)] = int(b)
        mut np := 0
        mut p := xbPHead(mut st, b)
        while p >= 0 {
            np += 1
            p = xParamNext(mut st, p)
        }
        if np > maxArgs {
            maxArgs = np
        }
        mut i := xbIHead(mut st, b)
        while i != -1 {
            ninst += 1
            i = xiNext(mut st, i)
        }
        b = xbNext(mut st, b)
    }
    // 定数（div / rem のガード省略）
    xFill(mut e.isConst, e.nv, 0)
    xFill(mut e.constV, e.nv, 0)
    xFill(mut e.remat, e.nv, 0)
    for k <- iter.Range(0, e.nb) {
        mut i := xbIHead(mut st, BlkRef(e.blk[k]))
        while i != -1 {
            if xiOp(mut st, i) == OpConst {
                r := xiRes(mut st, i)
                e.isConst[r] = 1
                e.constV[r] = xiA(mut st, i)
                if e.opt && e.constV[r] >= -2147483648 && e.constV[r] <= 2147483647 {
                    e.remat[r] = 1
                }
            } else if e.opt && xiOp(mut st, i) == OpSlotaddr && xiRes(mut st, i) >= 0 {
                // スロットの番地も使う点で作り直す（remat 2 — lea rbp + 変位。constV = スロットの番号。1.0× アタック便: 番地が spill され、
                // 多値の結果の写しのたびにフレームから番地を読み直していた — 1BRC の main）
                r := xiRes(mut st, i)
                e.constV[r] = xiA(mut st, i)
                e.remat[r] = 2
            }
            i = xiNext(mut st, i)
        }
    }
    // スロット → フレームの先頭側
    mut slotWords := 0
    mut sws := mut []int{}
    mut s := xfSHead(mut st, f)
    while s >= 0 {
        w := xSlotWords(mut st, s)
        slotWords = slotWords + (if w > 1 { w } else { 1 })
        sws = append(sws, if w > 1 { w } else { 1 })
        e.slotDisp = append(e.slotDisp, -8 * slotWords)
        s = xSlotNext(mut st, s)
    }
    // 入口の零初期化の区間: 写しのバックエンドは全語（stage1 と同じ — elfeq）・最適化のバックエンドは要零の語を覆う最小の区間だけ（zeroinit.sober）
    e.zTop = slotWords
    e.zCnt = slotWords
    if e.opt && slotWords > 0 {
        zn := xZeroNeed(mut st, f, freeze(sws))
        mut lo := 0
        mut hi := 0
        for p <- iter.Range(1, slotWords + 1) {
            if zn[p] == 1 {
                if lo == 0 {
                    lo = p
                }
                hi = p
            }
        }
        e.zTop = hi
        e.zCnt = if lo == 0 { 0 } else { hi - lo + 1 }
    }
    xFill(mut e.fold, e.nv, 0)
    xFill(mut e.fA, e.nv, 0)
    xFill(mut e.fB, e.nv, 0)
    xFill(mut e.fS, e.nv, 0)
    if e.opt {
        xFoldScan(mut st, mut e)
    }
    xOrder(mut st, mut e)
    if e.opt && e.zCnt > 0 && e.zCnt <= XZ_T {
        xZeroSink(mut st, mut e, freeze(sws))
    }
    xLive(mut st, mut e)
    xPieces(mut st, mut e)
    if e.opt {
        xHints(mut st, mut e)
        xFloatClass(mut st, mut e)
        if !xHasScanB(mut st, mut e) {
            e.nx = xNXmmWide
        }
    } else {
        xFill(mut e.fcls, e.nv, 0)
    }
    // 割り当て（区間分割レーン S2 — 二段）: 一段目は割らずに割り当て、spill がループの中に出たループ（圧のあるループ）を素通りする値だけ割って
    // 割り当て直す（二段で打ち切り）。割らない関数は一段目の結果がそのまま最終
    mut used := mut []int{}
    xFill(mut used, 32, 0)
    mut spills := mut []int{}
    xFill(mut spills, e.npc, 0)
    mut nsp := xAllocRegs(mut st, mut e, mut used, mut spills)
    if e.opt && nsp > 0 && xSplitLoops(mut st, mut e, mut spills, nsp) {
        xFill(mut spills, e.npc - len(spills), 0)
        nsp = xPrioRealloc(mut e, mut used, mut spills, nsp)
        xUnsplitSpilled(mut e)
    }
    bottom := xAllocFrame(mut st, mut e, -8 * slotWords, mut used, mut spills, nsp)
    // 下書き（xModuleFrozen の周 1）は割り当てが使う xmm の和（xAllocFrame が st.xXmm に足す）だけが要る — 吐かずに返る
    if draft {
        return 0
    }
    if e.opt && len(e.sv) > 0 {
        xSlotValid(mut st, mut e)
    }
    frame := (0 - bottom + 15) / 16 * 16
    e.nofr = e.opt && slotWords == 0 && e.nsave == 0 && nsp == 0 && xNoCall(mut st, mut e)
    xFill(mut e.blockAt, e.nb, 0)
    xFill(mut e.jAt, 4 * e.nb, 0)
    xFill(mut e.jTo, 4 * e.nb, 0)
    xFill(mut e.div0, ninst, 0)
    xFill(mut e.mvD, maxArgs + len(e.sv), 0)
    xFill(mut e.mvS, maxArgs + len(e.sv), 0)
    xFill(mut e.mvLive, maxArgs + len(e.sv), 0)
    xFill(mut e.fuse, e.nv, 0)
    xFill(mut e.flg, e.nv, 0)
    if e.opt {
        xFuseScan(mut st, mut e)
    }

    mut hdr := mut []int{}
    xFill(mut hdr, e.norder, 0)
    if e.opt {
        for j <- iter.Range(0, len(e.lpR) / 2) {
            if e.lpR[2 * j] >= 0 && e.lpR[2 * j] < e.norder {
                hdr[e.lpR[2 * j]] = 1
            }
        }
    }
    // ループの頭の整列は、手前のブロックが頭へ落ちてこないときだけ（落ちてくる頭の前の nop はループに入るたびに実行される — fannkuch で
    // 命令 +4.2%）。先頭のブロックは prologue から落ちる。棄てた案: 落ちてくる頭の詰め物の前に `jmp 頭`（入るたびに taken の 1 命令）
    mut fell := true
    xFill(mut e.bdep, e.nb, 0)
    for k <- iter.Range(0, if len(e.ldep) < e.norder { len(e.ldep) } else { e.norder }) {
        e.bdep[e.order[k]] = e.ldep[k]
    }
    // 回転するループの頭は整列しない（ラッチは頭でなく本体の先頭へ戻り、頭は入口で 1 回通るだけ。本体の先頭は頭から落ちてくるので
    // 整列もしない — 線の跨ぎは下の詰め物が受ける）。回すかは吐く前に決まる（xRotOk は並べる順・融合・深さだけを読む）
    mut rot := mut []int{}
    xFill(mut rot, e.nb, 0)
    // 線の跨ぎの詰め物の候補（xFitCand — 吐く順の位置ごと: 行き先 T なら最内ループの体の最後の位置・でなければ -1）
    mut cand := mut []int{}
    mut candB := mut []int{}
    mut pre := mut []int{}
    if e.opt {
        for k <- iter.Range(0, e.norder) {
            lb := BlkRef(e.blk[e.order[k]])
            if xbTerm(mut st, lb) == TmBr && xRotOk(mut st, mut e, lb, xbBrTo(mut st, lb)) {
                rot[xbId(mut st, xbBrTo(mut st, lb))] = 1
            }
        }
    }
    rotF := freeze(rot)
    if e.opt {
        xFitCand(mut st, mut e, rotF, mut cand, mut candB, mut pre)
    }
    candF := freeze(cand)
    candBF := freeze(candB)
    preF := freeze(pre)
    // `--fit-check`（xLay = -1）: 窓は作るが詰めない（窓なし = `--fit-off`〔xLay = -2〕と ELF がバイト一致するはず — 継ぎの網 scripts/fitcheck.sh）
    chk := st.xLay == -1
    fitOn := e.opt && st.xLay != -2
    // 関数の先頭から最初の候補まで落ちない点が無ければ、関数の入口の手前（前の関数の ret の後 — 実行されない）に詰める（粒度の葉 — 葉が inline
    // された先の熱いループは入口から落ちて流れる）。入口は 64 B の整列からずれるが、ずれの量はこの関数自身の機械語だけで決まる（案 B の性質は保つ）
    mut entry := x86.Here(mut c)
    mut inner := true
    // 戻しの詰め物: 線の跨ぎの詰め物 P を置いたら、次の落ちない点に (64 − P) mod 64 を置き、その先のコードの線の中の位置を詰め物なしと同じに保つ
    // （詰め物の影響をそのループの周りに閉じる — 1BRC の map_find で、前半の小ループの詰め物が後ろの長い熱い区間をずらして cycles +2%）
    mut back := 0
    mut kb := 0
    while kb < e.norder {
        if kb > 0 && !fell && back > 0 {
            x86.Nop(mut c, back)
            back = 0
        }
        if inner && kb > 0 && !fell {
            xLayInner(mut st, mut c, int(e.f))
            inner = false
        }
        if hdr[kb] == 1 && rotF[e.order[kb]] == 0 && !fell {
            x86.AlignTo(mut c, ab, XA_LOOP)
        }
        if fitOn && (kb == 0 || !fell) && xFitWant(mut e, kb, candF, preF) {
            // 窓（線の跨ぎの詰め物 — xFitWant）: 本番として別の表 w へ吐き進め、詰め物の量が決まったら本物の表へ「詰め物 + 窓」を写して継ぐ
            nj0 := e.nj
            nd0 := e.nd
            ne0 := len(e.eoA)
            w0 := x86.Here(mut wb)
            wf0 := table.Len(mut wf)
            if kb == 0 {
                xProlog(mut st, mut e, mut wb, frame, slotWords)
            }
            mut hiMax := xFitHiMax(mut e, kb, candF, preF)
            mut kk := kb
            mut pad := -1
            mut stop := false
            while pad < 0 && !stop && kk < e.norder && kk <= hiMax {
                if kk > kb && !e.fell {
                    // 実際の落ちない点 — ここから先は本番の続きに任せる（窓には整列も関数の中のずらしも入らない）
                    stop = true
                } else {
                    _ = xEmitBlk(mut st, mut e, mut wb, mut wf, kk, frecs, grecs)
                    // 体の最後まで吐いた候補を判定（頭の位置 h で cand[h] == kk）
                    for h <- iter.Range(kb, kk + 1) {
                        if pad < 0 && candF[h] == kk {
                            pad = xFitJudge(mut e, nj0, h, candF, candBF, ab + x86.Here(mut c) - w0)
                        }
                    }
                    kk += 1
                }
            }
            // 落ちない点で切れた: 頭を通った候補を、そこまでに積んだ後ろの辺で判定する（粒度の葉 — 熱いラッチは切れ目の手前・体の最後は先の検査点の道）
            if pad < 0 {
                for h <- iter.Range(kb, kk) {
                    if pad < 0 && candF[h] >= kk {
                        pad = xFitJudge(mut e, nj0, h, candF, candBF, ab + x86.Here(mut c) - w0)
                    }
                }
            }
            x86.Nop(mut c, if pad > 0 && !chk { pad } else { 0 })
            if pad > 0 && !chk && kb > 0 {
                back = XFIT_LINE - pad
            }
            if kb == 0 {
                entry = x86.Here(mut c)
            }
            xFitSplice(mut e, mut c, mut fx, mut wb, mut wf, w0, wf0, kb, kk, nj0, nd0, ne0)
            fell = e.fell
            kb = kk
        } else {
            if kb == 0 {
                entry = x86.Here(mut c)
                xProlog(mut st, mut e, mut c, frame, slotWords)
            }
            fell = xEmitBlk(mut st, mut e, mut c, mut fx, kb, frecs, grecs)
            kb += 1
        }
    }
    if e.nd > 0 {
        at := x86.Here(mut c)
        for k <- iter.Range(0, e.nd) {
            x86.PatchRel32(mut c, e.div0[k], at)
        }
        // 罠を使うモジュール: ゼロ除算の死も最内の罠へ（死因 = 101・点 -1）
        if st.trapUse {
            xUnwind(mut c, mut fx, xIndex(grecs, st.trapG), xTrapFs(mut st), xPanic)
        }
        xExit(mut c, xPanic, st.taskUse)
    }
    // 外置きした辺の写し（分岐の位置の置き場で読む）
    for k <- iter.Range(0, len(e.eoA)) {
        x86.PatchRel32(mut c, e.eoA[k], x86.Here(mut c))
        e.pos = e.eoP[k]
        xEdge(mut st, mut e, mut c, BlkRef(e.eoT[k]), e.eoX[k], false)
    }
    for k <- iter.Range(0, e.nj) {
        x86.PatchRel32(mut c, e.jAt[k], e.blockAt[e.jTo[k]])
    }
    return entry
}

// xProlog は関数の入口（フレーム・callee-saved の退避・スロットのゼロ初期化・レジスタに載る引数）。本番と、線の跨ぎの詰め物の窓（xFunc）の両方
// 入口の零初期化の store の列（rep stosq 便 段 2 — report-488 (b)・report-495）: 最適化のバックエンドは要零の区間が XZ_T 語以下なら rep stosq
// （起動に数十 cycles）でなく xor eax + mov [rbp - …], rax の列で 0 にする。T と形は値札で選んだ（T = 8 / 16 / 32 × rax / xmm — report-495:
// コンパイラ自身の自己 build の cycles は T = 16 で −1.8%）。棄てた案: pxor xmm0 + movdqu の 2 語ずつ（命令は少ないが knucleotide / logagg の cycles が
// 両順で + — 16 B の store を 8 B で読み戻す形の疑い）・T = 32（binarytrees が両順で +1.8%）
const XZ_T = 16

func xZeroStores(c mut table.Table[byte], ztop int, cnt int) {
    x86.XorRegReg(mut c, x86.Rax, x86.Rax)
    pl := xZeroPlan(ztop, cnt)
    for q <- iter.Range(0, len(pl)) {
        x86.MovMemReg(mut c, x86.Rbp, pl[q], x86.Rax)
    }
}

// xZeroSink は入口の零初期化を、入口から始まる領域 E の出口へ沈める（置き場の往復レーン 段 4b (b1-z) — report-505 3.2）: E = 入口から、零初期化の区間に
// 重なるスロットの番地（slotaddr）を持たないブロックだけを辿った集合。E の中では区間の語を指す番地が作られないので、区間の語は読まれも書かれも
// しない（呼び出しも区間の語には届かない — 番地が渡らない）。番地は定義が使用を支配するので、定義のブロックだけを見ればよい。
// 零初期化は E の外のブロックのうち E から入るもの（前線）の頭で吐く — 前線の前任が全部 E で、E の外から E へ戻る辺が無いとき（どの道でも
// 前線をちょうど 1 回通ってから区間の語に触れる）。E の中の ret（早期 return）は零初期化を払わない。条件を満たさない・E に ret が無い・
// 前線が 4 つを超えるなら沈めない。毒の口（SOBER_SLOT_POISON）は入口に残る（毒 → 前線の 0）
func xZeroSink(st mut St, e mut xF, sws []int) {
    nb := e.nb
    lo := -8 * e.zTop
    hi := -8 * (e.zTop - e.zCnt)
    mut ok := mut []int{}
    mut isRet := mut []int{}
    mut sc := mut []int{}
    mut sx := mut []int{}
    for bi <- iter.Range(0, nb) {
        b := BlkRef(e.blk[bi])
        sc = append(sc, len(sx))
        mut good := e.bpos[bi] >= 0
        if good {
            mut i := xbIHead(mut st, b)
            while i != -1 {
                if xiOp(mut st, i) == OpSlotaddr {
                    k := xiA(mut st, i)
                    a := e.slotDisp[k]
                    if a < hi && lo < a + 8 * sws[k] {
                        good = false
                    }
                }
                i = xiNext(mut st, i)
            }
            for j <- iter.Range(0, xNSucc(mut st, b)) {
                sx = append(sx, xSucc(mut st, b, j))
            }
        }
        ok = append(ok, if good { 1 } else { 0 })
        isRet = append(isRet, if e.bpos[bi] >= 0 && xbTerm(mut st, b) == TmRet { 1 } else { 0 })
    }
    sc = append(sc, len(sx))
    mut live := mut []int{}
    for bi <- iter.Range(0, nb) {
        live = append(live, if e.bpos[bi] >= 0 { 1 } else { 0 })
    }
    e.zAt = mut []int{}
    zs := xZeroSinkCalc(freeze(sc), freeze(sx), freeze(ok), freeze(isRet), freeze(live))
    for bi <- iter.Range(0, len(zs)) {
        e.zAt = append(e.zAt, zs[bi])
    }
}

// xZeroSinkCalc は xZeroSink の判定（ブロックの番号 0 = 入口・後続は CSR〔sc / sx〕・ok = 区間に重なるスロットの番地を持たない・isRet = ret で終わる・
// live = 到達する）: 前線の印の列（ブロックの番号ごと 1 / 0）か、沈めないなら空
func xZeroSinkCalc(sc []int, sx []int, ok []int, isRet []int, live []int) []int {
    nb := len(ok)
    if nb == 0 || ok[0] == 0 {
        return []int{}
    }
    // E = 入口から ok のブロックだけを辿った集合
    mut inE := mut []int{}
    xFill(mut inE, nb, 0)
    mut work := mut []int{}
    xFill(mut work, nb, 0)
    inE[0] = 1
    work[0] = 0
    mut nw := 1
    while nw > 0 {
        nw -= 1
        b := work[nw]
        for j <- iter.Range(sc[b], sc[b + 1]) {
            t := sx[j]
            if inE[t] == 0 && ok[t] == 1 {
                inE[t] = 1
                work[nw] = t
                nw += 1
            }
        }
    }
    mut anyRet := false
    mut fr := mut []int{}
    xFill(mut fr, nb, 0)
    mut nfr := 0
    for b <- iter.Range(0, nb) {
        if inE[b] == 1 && isRet[b] == 1 {
            anyRet = true
        }
        for j <- iter.Range(sc[b], if live[b] == 1 { sc[b + 1] } else { sc[b] }) {
            t := sx[j]
            if inE[b] == 0 && inE[t] == 1 {
                // E の外から E へ戻る辺
                return []int{}
            }
            if inE[b] == 1 && inE[t] == 0 && fr[t] == 0 {
                fr[t] = 1
                nfr += 1
            }
        }
    }
    if !anyRet || nfr == 0 || nfr > 4 {
        return []int{}
    }
    // 前線の前任は全部 E
    for b <- iter.Range(0, nb) {
        for j <- iter.Range(sc[b], if live[b] == 1 { sc[b + 1] } else { sc[b] }) {
            if inE[b] == 0 && fr[sx[j]] == 1 {
                return []int{}
            }
        }
    }
    return freeze(fr)
}

// xZeroPlan は store の列の変位（rbp から — 区間 [rbp - 8 × ztop, rbp - 8 × (ztop - cnt)) を 1 語ずつちょうど覆う — zeroinit_test）
func xZeroPlan(ztop int, cnt int) []int {
    mut pl := mut []int{}
    mut d := -8 * ztop
    zend := -8 * (ztop - cnt)
    while d < zend {
        pl = append(pl, d)
        d += 8
    }
    return freeze(pl)
}

func xProlog(st mut St, e mut xF, c mut table.Table[byte], frame int, slotWords int) {
    if e.nofr {
        // 段 2: フレームなし — 引数は呼び手の積んだ [rsp + 8 + 8k]（戻り番地の上）。段 3: レジスタで来る引数を先に並行コピー
        xArgMoves(mut e, mut c)
        for k <- iter.Range(e.nreg, e.np) {
            l := xLocAt(mut e, k, e.bpos[0])
            if xIsReg(l) {
                x86.MovRegMem(mut c, xLocVal(l), x86.Rsp, xParamHome(mut e, k) - 8)
            }
        }
        return
    }
    // フレーム → フレーム → 使う callee-saved の退避 → スロットのゼロ初期化（rdi / rcx / rax を壊す）→ レジスタに載る引数
    x86.PushReg(mut c, x86.Rbp)
    x86.MovRegReg(mut c, x86.Rbp, x86.Rsp)
    if frame > 0 {
        x86.SubRegImm(mut c, x86.Rsp, frame)
    }
    for k <- iter.Range(0, e.nsave) {
        if e.saveReg[k] >= xX0 {
            // xmm（callee-saved — float のクラス）: rax を中継（引数は [rbp + …] にあり rax はまだ空き）
            x86.MovqRX(mut c, x86.Rax, e.saveReg[k] - xX0)
            x86.MovMemReg(mut c, x86.Rbp, e.saveDisp[k], x86.Rax)
        } else {
            x86.MovMemReg(mut c, x86.Rbp, e.saveDisp[k], e.saveReg[k])
        }
    }
    if e.opt && st.slotPoison && slotWords > 0 {
        // 毒の口（SOBER_SLOT_POISON — 開発用・最適化のバックエンドだけ）: 全語を 0x5a… で埋めてから要零の区間を 0 に — 要零でないと判定した語を
        // 読む IR があれば、落ちるか出力が変わる（判定の誤りを観測できる形にする網 — report-488 2.4）
        x86.LeaRegMem(mut c, x86.Rdi, x86.Rbp, -8 * slotWords)
        x86.MovRegImm32(mut c, x86.Rcx, slotWords)
        x86.MovRegImm64(mut c, x86.Rax, 6510615555426900570)
        x86.RepStosq(mut c)
    }
    if len(e.zAt) > 0 {
        // 沈めた（xZeroSink — 前線のブロックの頭で吐く）
    } else if e.zCnt > 0 && e.opt && e.zCnt <= XZ_T {
        xZeroStores(mut c, e.zTop, e.zCnt)
    } else if e.zCnt > 0 {
        x86.LeaRegMem(mut c, x86.Rdi, x86.Rbp, -8 * e.zTop)
        x86.MovRegImm32(mut c, x86.Rcx, e.zCnt)
        x86.XorRegReg(mut c, x86.Rax, x86.Rax)
        x86.RepStosq(mut c)
    }
    // 段 3: レジスタで来る引数（rsi・r8〜r10 — rep stosq は壊さない）の並行コピーを先に（スタックで来る引数の書き先が引数レジスタでありうる）
    xArgMoves(mut e, mut c)
    for k <- iter.Range(e.nreg, e.np) {
        l := xLocAt(mut e, k, e.bpos[0])
        if xIsReg(l) {
            x86.MovRegMem(mut c, xLocVal(l), x86.Rbp, xParamHome(mut e, k))
        }
    }
}

// xArgMoves はレジスタで来た仮引数（段 3）を入口の置き場（レジスタか spill 先）へ並行コピーする。使われない仮引数（区間が入口の 1 点）は写さない
func xArgMoves(e mut xF, c mut table.Table[byte]) {
    mut n := 0
    for k <- iter.Range(0, e.nreg) {
        if e.pnx[k] >= 0 || e.ivE[k] > e.ivS[k] {
            e.mvD[n] = xLocAt(mut e, k, e.bpos[0])
            e.mvS[n] = xLocReg(xArgReg(k))
            n += 1
        }
    }
    xParallelMove(mut e, mut c, n)
}

// xEmitBlk は吐く順の k 番目のブロック（命令と終端）を吐き、終端が次のブロックへ落ちたかを返す（本表と、線の跨ぎの詰め物の窓の表の両方）
func xEmitBlk(st mut St, e mut xF, c mut table.Table[byte], fx mut table.Table[int], k int, frecs []int, grecs []int) bool {
    bi := e.order[k]
    blk := BlkRef(e.blk[bi])
    e.blockAt[bi] = x86.Here(mut c)
    e.putAt = -1
    xMemoClear(mut e)
    if len(e.zAt) > 0 && e.zAt[bi] == 1 {
        xZeroStores(mut c, e.zTop, e.zCnt)
    }
    mut i := xbIHead(mut st, blk)
    mut n := 0
    while i != -1 {
        e.pos = e.bpos[bi] + 2 * (n + 1)
        e.memOn = e.opt && xMemoOp(mut st, mut e, i)
        if !e.memOn {
            xMemoClear(mut e)
        }
        xInst(mut st, mut e, mut c, mut fx, i, frecs, grecs)
        n += 1
        i = xiNext(mut st, i)
    }
    // 終端（と辺の並行コピーの読み元）の位置 = ブロックの終わり
    e.pos = e.bpos[bi] + 2 * (n + 1)
    e.memOn = false
    e.next = if k + 1 < e.norder { e.order[k + 1] } else { -1 }
    e.fell = false
    if e.opt {
        xTermEmitOpt(mut st, mut e, mut c, blk)
    } else {
        xTermEmit(mut st, mut e, mut c, blk)
    }
    return e.fell
}

// ── 線の跨ぎの詰め物（配置の便 案 A）──
// 最内ループの熱い区間（後ろの辺の行き先 T 〜 T へ戻るラッチの分岐の末尾）が 64 B 以下なら、64 B の線を跨がせない。取り込みに律速される短い
// ループ（粒度の葉 — 分岐 2 本 / 32 B）は跨ぐと反復が 1.25 → 2.1 cycle（op cache のミス 19 倍・FE の空き 4 → 63%）。依存の鎖で律速される
// ループには中立（同じ機械語を 64 通りに置いて cycles が平ら）。
// 詰め物は T の手前の最も近い「落ちない点」（手前のブロックが jmp / ret で終わる境目）か関数の入口の手前（前の関数の ret の後）に置き、実行されない
// （落ちてくる頭の前に置くと、ループに入るたびに実行される — fannkuch 命令 +4.0%・knucleotide +3.4%）。区間の大きさは吐くまで
// 分からないので、落ちない点に着いたら、そこからの窓（次の落ちない点か候補の体の最後まで）を本番として別の表へ吐き、詰め物の量が決まってから
// 本物の表へ継ぐ（xFitSplice — 吐き直しは無い）。棄てた案: 関数を丸ごと 2 回吐く（自己 build +19.5%）/ 吐く部分を全部 2 周
// （詰め物の要る関数だけでも +2.3%）/ 窓を捨てる表へ下見して本番を吐き直す（+1.0%・空振りの下見が半分）/
// 関数を吐き終えた後に挿してずらす（整列の再計算まで要る — 窓は落ちない点で切れるので整列を含まない）
const XFIT_LINE = 64
// 窓を作るのは、落ちない点から XFIT_AHEAD ブロック以内に候補があるときだけ（間に実際の落ちない点があれば窓はそこで切れ、先はその点に任せる。
// 落ちない点を吐く前に見込む形〔後続に次のブロックが無い〕は、空の中継の飛び越し等で外れて候補を取り逃した）
const XFIT_AHEAD = 12
// 窓の上限（IR の命令の数）: 候補のループ（頭 〜 体の最後）が XFIT_MAXI を超えるなら熱い区間が 64 B に収まる見込みが薄いので候補にしない・
// 落ちない点から頭までが XFIT_REACH を超えるなら窓を作らない（どちらも正しさには関わらない — 取り逃しが増えるだけ）
const XFIT_MAXI = 40
const XFIT_REACH = 64

// xFitPad は番地 a に大きさ s の区間を置くとき線を跨がせない詰め物の大きさ（跨がなければ 0）
func xFitPad(a int, s int) int {
    o := a % XFIT_LINE
    return if o + s > XFIT_LINE { XFIT_LINE - o } else { 0 }
}

// xFitCand は吐く前の候補: cand[k] = 吐く順の位置 k のブロックが最内ループの頭なら、そのループの体の最後の位置（でなければ -1）。
// 最内 = lpR の範囲 [頭, 体の最後] の中に別の頭を持たない。candB[k] = 回転するラッチを持つループの本体の先頭の位置（xRotLatch と同じ選び方・
// でなければ -1）。後ろの辺の行き先 T は窓で決める（頭へ戻る辺が範囲の中にあれば頭 — 粒度の葉は数え口の jne が頭へ・検査点の続きの jl が
// 本体へ戻る 2 本のラッチを持ち、熱いのは頭のほう。無ければ回転の本体）
func xFitCand(st mut St, e mut xF, rot []int, cand mut []int, candB mut []int, pre mut []int) {
    xFill(mut cand, e.norder, -1)
    xFill(mut candB, e.norder, -1)
    // pre[k] = 吐く順で k より手前のブロックの IR の命令の数の和（窓の大きさの見積もりの物差し）
    xFill(mut pre, e.norder + 1, 0)
    for k <- iter.Range(0, e.norder) {
        mut n := 0
        mut i := xbIHead(mut st, BlkRef(e.blk[e.order[k]]))
        while i != -1 {
            n += 1
            i = xiNext(mut st, i)
        }
        pre[k + 1] = pre[k] + n
    }
    mut ko := mut []int{}
    xFill(mut ko, e.nb, -1)
    for k <- iter.Range(0, e.norder) {
        ko[e.order[k]] = k
    }
    nl := len(e.lpR) / 2
    for j <- iter.Range(0, nl) {
        h := e.lpR[2 * j]
        hi := e.lpR[2 * j + 1]
        mut innermost := h >= 0 && hi < e.norder && h <= hi
        for j2 <- iter.Range(0, nl) {
            if j2 != j && e.lpR[2 * j2] > h && e.lpR[2 * j2] <= hi {
                innermost = false
            }
        }
        if innermost && pre[hi + 1] - pre[h] <= XFIT_MAXI {
            hb := e.order[h]
            cand[h] = hi
            if rot[hb] == 1 {
                hr := BlkRef(e.blk[hb])
                th := xbId(mut st, xbThen(mut st, hr))
                kb := ko[if e.bdep[th] >= e.bdep[hb] { th } else { xbId(mut st, xbElse(mut st, hr)) }]
                if kb > h && kb <= hi {
                    candB[h] = kb
                }
            }
        }
    }
}

// xFitWant は落ちない点（吐く順の位置 k の手前）で窓を作るか: XFIT_AHEAD ブロック・IR XFIT_REACH 命令以内に候補の頭がある
func xFitWant(e mut xF, k int, cand []int, pre []int) bool {
    mut kt := k
    while kt < e.norder && kt - k <= XFIT_AHEAD && pre[kt] - pre[k] <= XFIT_REACH {
        if cand[kt] >= 0 {
            return true
        }
        kt += 1
    }
    return false
}

// xFitHiMax は窓の終わりの上限（窓の中の候補の体の最後の最大）
func xFitHiMax(e mut xF, k int, cand []int, pre []int) int {
    mut hi := -1
    mut kt := k
    while kt < e.norder && kt - k <= XFIT_AHEAD && pre[kt] - pre[k] <= XFIT_REACH {
        if cand[kt] > hi {
            hi = cand[kt]
        }
        kt += 1
    }
    return hi
}

// xFitSplice は窓の表 w / wfx のこの窓の区間（w0 / wf0 以降）を本物の表 c / fx の末尾へ継ぐ: バイトを写し、窓の中で積んだ位置の記録（ブロックの番地・飛び・ゼロ除算・外置きの辺・
// fx）に継いだ位置を足す。窓は落ちない点で切れるので中に整列は無く、足し直すのはこの 5 種だけ（漏れは `--fit-check` ≡ `--fit-off` の ELF の
// バイト一致が鳴らす — scripts/fitcheck.sh）
func xFitSplice(e mut xF, c mut table.Table[byte], fx mut table.Table[int], w mut table.Table[byte], wfx mut table.Table[int], w0 int, wf0 int, k int, kk int, nj0 int, nd0 int, ne0 int) {
    p := x86.Here(mut c) - w0
    for i <- iter.Range(w0, table.Len(mut w)) {
        table.Push(mut c, table.Get(mut w, i))
    }
    for i <- iter.Range(wf0 / 3, table.Len(mut wfx) / 3) {
        xFixAdd(mut fx, p + table.Get(mut wfx, 3 * i), table.Get(mut wfx, 3 * i + 1), table.Get(mut wfx, 3 * i + 2))
    }
    for q <- iter.Range(k, kk) {
        e.blockAt[e.order[q]] = e.blockAt[e.order[q]] + p
    }
    for j <- iter.Range(nj0, e.nj) {
        e.jAt[j] = e.jAt[j] + p
    }
    for j <- iter.Range(nd0, e.nd) {
        e.div0[j] = e.div0[j] + p
    }
    for j <- iter.Range(ne0, len(e.eoA)) {
        e.eoA[j] = e.eoA[j] + p
    }
}

// xFitJudge は頭の位置 h の候補の詰め物（区間が 64 B 以下で後ろの辺が窓の中にあれば詰め物の大きさ ≥ 0・でなければ -1）。的は頭へ戻る辺が
// あれば頭・無ければ回転の本体（candB）
func xFitJudge(e mut xF, nj0 int, h int, cand []int, candB []int, a int) int {
    mut tb := e.order[h]
    mut end := xFitEnd(mut e, nj0, tb)
    if end < 0 && candB[h] >= 0 {
        tb = e.order[candB[h]]
        end = xFitEnd(mut e, nj0, tb)
    }
    pt := e.blockAt[tb]
    return if end > 0 && end - pt <= XFIT_LINE { xFitPad(a + pt, end - pt) } else { -1 }
}

// xFitEnd は窓で積んだ飛び（nj0 以降）のうち、ブロック tb へ戻る後ろの辺の末尾の最大（無ければ -1）
func xFitEnd(e mut xF, nj0 int, tb int) int {
    pt := e.blockAt[tb]
    mut end := -1
    for j <- iter.Range(nj0, e.nj) {
        if e.jTo[j] == tb && e.jAt[j] >= pt && e.jAt[j] + 4 > end {
            end = e.jAt[j] + 4
        }
    }
    return end
}

// ── 並べる順（ir_live.linearOrder — 後続を後ろから辿る反復 DFS の逆後順）──

func xOrder(st mut St, e mut xF) {
    mut seen := mut []int{}
    xFill(mut seen, e.nb, 0)
    mut post := mut []int{}
    xFill(mut post, e.nb, 0)
    mut stB := mut []int{}
    xFill(mut stB, e.nb, 0)
    mut stN := mut []int{}
    xFill(mut stN, e.nb, 0)
    mut sp := 1
    mut np := 0
    stB[0] = 0
    stN[0] = 0
    seen[0] = 1
    while sp > 0 {
        topB := stB[sp - 1]
        ns := xNSucc(mut st, BlkRef(e.blk[topB]))
        if stN[sp - 1] < ns {
            s := xSucc(mut st, BlkRef(e.blk[topB]), ns - 1 - stN[sp - 1])
            stN[sp - 1] = stN[sp - 1] + 1
            if seen[s] == 0 {
                seen[s] = 1
                stB[sp] = s
                stN[sp] = 0
                sp += 1
            }
        } else {
            post[np] = topB
            np += 1
            sp -= 1
        }
    }
    for k <- iter.Range(0, np) {
        e.order = append(e.order, post[np - 1 - k])
    }
    e.norder = np
    mut nHot := np
    if e.opt {
        // 冷たいブロックを末尾の 1 区画へ（M5 / 区間分割 S3b: 熱いコードが連続し、区間が短くなる）: exit で終わる panic の点と、ループの外の冷たい領域（xColdBlocks）。
        // 合流して戻る冷たいブロックで使う値は、末尾の分を本体と別の外包（部分区間）にする（xTouch）— 1 本の区間のまま末尾へ寄せると外包が関数の終わりまで
        // 伸びて熱い値と全部重なった（fannkuch 23.2 → 56.5 G）。
        // ループの中の冷たい領域は寄せない（印は重みにだけ使う）: 寄せると合流の仮引数の合体が崩れ、revcomp の 1 文字ごとの後ろの辺に 3 命令の入れ替えが入った
        // （命令 +3.3%）。入口は動かさない。1 本の列を 2 周で積む（2 本へ交互に append しない — 運用の地雷）
        xFill(mut e.cold, np, 0)
        xColdBlocks(mut st, mut e)
        // ループ（深さ・範囲）も並べ替えの前の逆後順で（後ろの辺 = 順で後ろから前 — 並べ替えの後は末尾から本体へ戻る合流の辺が偽の後ろの辺になる）
        dep0 := xLoopDepth(mut st, mut e)
        mut coldB := mut []int{}
        xFill(mut coldB, e.nb, 0)
        mut depB := mut []int{}
        xFill(mut depB, e.nb, 0)
        mut tailB := mut []int{}
        xFill(mut tailB, e.nb, 0)
        for k <- iter.Range(0, np) {
            bi := e.order[k]
            coldB[bi] = e.cold[k]
            depB[bi] = dep0[k]
            tailB[bi] = if e.cold[k] == 1 && (dep0[k] == 0 || xbTerm(mut st, BlkRef(e.blk[bi])) == TmExit) { 1 } else { 0 }
        }
        for j <- iter.Range(0, len(e.lpR)) {
            e.lpR[j] = e.order[e.lpR[j]]
        }
        mut ord := mut []int{}
        for pass <- iter.Range(0, 2) {
            for k <- iter.Range(0, np) {
                bi := e.order[k]
                if (tailB[bi] == 1) == (pass == 1) {
                    ord = append(ord, bi)
                }
            }
        }
        e.order = ord
        nHot = 0
        for k <- iter.Range(0, np) {
            if tailB[ord[k]] == 0 {
                nHot += 1
            }
        }
        mut kNew := mut []int{}
        xFill(mut kNew, e.nb, -1)
        for k <- iter.Range(0, np) {
            e.cold[k] = coldB[ord[k]]
            e.ldep = append(e.ldep, depB[ord[k]])
            kNew[ord[k]] = k
        }
        // ループの範囲を新しい順の位置へ（範囲の終わりは体の熱いブロックの最後 — 冷たいブロックは xLoopDepth が数えない。熱いブロックの相対順は不変）
        for j <- iter.Range(0, len(e.lpR)) {
            e.lpR[j] = kNew[e.lpR[j]]
        }
    }
    xFill(mut e.bpos, e.nb, -1)
    mut pos := 0
    for k <- iter.Range(0, np) {
        bi := e.order[k]
        e.bpos[bi] = pos
        if e.opt && k == nHot {
            e.c0 = pos
        }
        mut n := 0
        mut i := xbIHead(mut st, BlkRef(e.blk[bi]))
        while i != -1 {
            n += 1
            i = xiNext(mut st, i)
        }
        pos = pos + 2 * (n + 2)
    }
}

// ── 生存区間（ir_live.analyze と同じ区間 — 集合の不動点の代わりに、上向きに露出した使用から前任へ辿る（SSA の経路探索）。
// 到達するブロックの live-in / live-out は最小不動点と一致する）──

func xTouch(e mut xF, v int, p int) {
    if e.remat[v] != 0 {
        return
    }
    if p >= e.c0 {
        // 末尾の区画（冷たいブロック — 区間分割 S3b）の触れは別の外包に
        if e.tS[v] < 0 {
            e.tS[v] = p
            e.tE[v] = p
        } else {
            if p < e.tS[v] {
                e.tS[v] = p
            }
            if p > e.tE[v] {
                e.tE[v] = p
            }
        }
        return
    }
    if e.ivS[v] < 0 {
        e.ivS[v] = p
        e.ivE[v] = p
    } else {
        if p < e.ivS[v] {
            e.ivS[v] = p
        }
        if p > e.ivE[v] {
            e.ivE[v] = p
        }
    }
}

// xBlkEnd は到達するブロック b の終端の位置
func xBlkEnd(st mut St, e mut xF, bi int) int {
    mut n := 0
    mut i := xbIHead(mut st, BlkRef(e.blk[bi]))
    while i != -1 {
        n += 1
        i = xiNext(mut st, i)
    }
    return e.bpos[bi] + 2 * (n + 1)
}

func xLive(st mut St, e mut xF) {
    nv := e.nv
    nb := e.nb
    xFill(mut e.ivS, nv, -1)
    xFill(mut e.tS, nv, -1)
    xFill(mut e.tE, nv, -1)
    xFill(mut e.ivE, nv, -1)
    // 定義のブロック（関数の引数は入口）
    mut defB := mut []int{}
    xFill(mut defB, nv, -1)
    for v <- iter.Range(0, e.np) {
        defB[v] = 0
    }
    mut bend := mut []int{}
    xFill(mut bend, nb, -1)
    for bi <- iter.Range(0, nb) {
        b := BlkRef(e.blk[bi])
        mut p := xbPHead(mut st, b)
        while p >= 0 {
            defB[xParamVal(mut st, p)] = bi
            p = xParamNext(mut st, p)
        }
        mut i := xbIHead(mut st, b)
        while i != -1 {
            r := xiRes(mut st, i)
            if r >= 0 {
                defB[r] = bi
            }
            i = xiNext(mut st, i)
        }
        if e.bpos[bi] >= 0 {
            bend[bi] = xBlkEnd(mut st, mut e, bi)
        }
    }
    // 前任（到達するものだけ — CSR）
    mut pcnt := mut []int{}
    xFill(mut pcnt, nb + 1, 0)
    for bi <- iter.Range(0, nb) {
        if e.bpos[bi] >= 0 {
            for k <- iter.Range(0, xNSucc(mut st, BlkRef(e.blk[bi]))) {
                s := xSucc(mut st, BlkRef(e.blk[bi]), k)
                pcnt[s + 1] = pcnt[s + 1] + 1
            }
        }
    }
    for bi <- iter.Range(0, nb) {
        pcnt[bi + 1] = pcnt[bi + 1] + pcnt[bi]
    }
    mut preds := mut []int{}
    xFill(mut preds, pcnt[nb], 0)
    mut pfill := mut []int{}
    xFill(mut pfill, nb, 0)
    for bi <- iter.Range(0, nb) {
        if e.bpos[bi] >= 0 {
            for k <- iter.Range(0, xNSucc(mut st, BlkRef(e.blk[bi]))) {
                s := xSucc(mut st, BlkRef(e.blk[bi]), k)
                preds[pcnt[s] + pfill[s]] = bi
                pfill[s] = pfill[s] + 1
            }
        }
    }
    // 運搬値の穴の候補（opt）: ループの頭（入口でない）の仮引数
    xFill(mut e.hdB, nv, -1)
    if e.opt {
        for j <- iter.Range(0, len(e.lpR) / 2) {
            h := e.lpR[2 * j]
            if h > 0 && h < e.norder {
                hb := e.order[h]
                mut p := xbPHead(mut st, BlkRef(e.blk[hb]))
                while p >= 0 {
                    e.hdB[xParamVal(mut st, p)] = hb
                    p = xParamNext(mut st, p)
                }
            }
        }
    }
    // 上向きに露出した使用 (値, ブロック) — 値ごとの CSR
    mut ucnt := mut []int{}
    xFill(mut ucnt, nv + 1, 0)
    for pass <- iter.Range(0, 2) {
        mut ufill := mut []int{}
        if pass == 1 {
            for v <- iter.Range(0, nv) {
                ucnt[v + 1] = ucnt[v + 1] + ucnt[v]
            }
            xFill(mut ufill, nv, 0)
        }
        mut uses := mut []int{}
        if pass == 1 {
            xFill(mut uses, ucnt[nv], 0)
        }
        for bi <- iter.Range(0, nb) {
            if e.bpos[bi] >= 0 {
                b := BlkRef(e.blk[bi])
                mut i := xbIHead(mut st, b)
                while i != -1 {
                    for k <- iter.Range(0, xNOps(mut st, i)) {
                        v0 := xOpnd(mut st, i, k)
                        // 融合した gep の番地は gep の被演算子 p・ix の使用（ブロックを跨いでも経路探索で生存が正しく伸びる — M8）
                        fd := e.fold[v0] == 1
                        for q <- iter.Range(0, if fd { 2 } else { 1 }) {
                            v := if !fd { v0 } else if q == 0 { e.fA[v0] } else { e.fB[v0] }
                            if defB[v] != bi {
                                if pass == 0 {
                                    ucnt[v + 1] = ucnt[v + 1] + 1
                                } else {
                                    uses[ucnt[v] + ufill[v]] = bi
                                    ufill[v] = ufill[v] + 1
                                }
                            }
                        }
                    }
                    i = xiNext(mut st, i)
                }
                for k <- iter.Range(0, xNTermOps(mut st, b)) {
                    v := xTermOpnd(mut st, b, k)
                    if defB[v] != bi {
                        if pass == 0 {
                            ucnt[v + 1] = ucnt[v + 1] + 1
                        } else {
                            uses[ucnt[v] + ufill[v]] = bi
                            ufill[v] = ufill[v] + 1
                        }
                    }
                }
            }
        }
        if pass == 1 {
            // 値ごとに live-in を前任へ辿る（印 = v + 1）
            mut mark := mut []int{}
            xFill(mut mark, nb, 0)
            mut work := mut []int{}
            xFill(mut work, nb, 0)
            for v <- iter.Range(0, nv) {
                mut nw := 0
                for k <- iter.Range(ucnt[v], ucnt[v + 1]) {
                    bi := uses[k]
                    if mark[bi] != v + 1 {
                        mark[bi] = v + 1
                        xTouch(mut e, v, e.bpos[bi])
                        work[nw] = bi
                        nw += 1
                        if e.hdB[v] >= 0 {
                            e.hvV = append(e.hvV, v)
                            e.hvB = append(e.hvB, bi)
                        }
                    }
                }
                while nw > 0 {
                    nw -= 1
                    bi := work[nw]
                    for k <- iter.Range(pcnt[bi], pcnt[bi + 1]) {
                        pb := preds[k]
                        xTouch(mut e, v, bend[pb])
                        if defB[v] != pb && mark[pb] != v + 1 {
                            mark[pb] = v + 1
                            xTouch(mut e, v, e.bpos[pb])
                            work[nw] = pb
                            nw += 1
                            if e.hdB[v] >= 0 {
                                e.hvV = append(e.hvV, v)
                                e.hvB = append(e.hvB, pb)
                            }
                        }
                    }
                }
            }
        }
    }
    // 定義・使用の位置（opt は重みも — ブロックのループの深さで 8 倍ずつ）
    mut dep := mut []int{}
    if e.opt {
        xFill(mut e.wt, nv, 0)
        xFill(mut e.wc, nv, 0)
        xFill(mut e.hu, nv, 0)
        for k <- iter.Range(0, e.norder) {
            dep = append(dep, e.ldep[k])
        }
    }
    for k <- iter.Range(0, e.norder) {
        bi := e.order[k]
        b := BlkRef(e.blk[bi])
        bs := e.bpos[bi]
        be := bend[bi]
        if e.opt {
            xWeigh(mut st, mut e, b, dep[k], e.cold[k] == 1)
        }
        if bi == 0 {
            for v <- iter.Range(0, e.np) {
                xTouch(mut e, v, bs)
            }
        }
        mut p := xbPHead(mut st, b)
        while p >= 0 {
            xTouch(mut e, xParamVal(mut st, p), bs)
            if e.opt {
                // 使われない仮引数でも入口の 1 点を越えて生かす（同じ入口で始まる値に置き場を譲らない — 辺の並行コピーが書く先）
                xTouch(mut e, xParamVal(mut st, p), bs + 1)
            }
            p = xParamNext(mut st, p)
        }
        mut i := xbIHead(mut st, b)
        mut n := 0
        while i != -1 {
            ip := bs + 2 * (n + 1)
            for j <- iter.Range(0, xNOps(mut st, i)) {
                v := xOpnd(mut st, i, j)
                if e.fold[v] == 1 {
                    // 融合した gep の番地: gep の被演算子がこの load / store の点まで生きる（gep 自身は区間を持たない — M7）
                    xTouch(mut e, e.fA[v], ip)
                    xTouch(mut e, e.fB[v], ip)
                } else {
                    xTouch(mut e, v, ip)
                }
            }
            r := xiRes(mut st, i)
            if r >= 0 && e.fold[r] == 0 {
                xTouch(mut e, r, ip)
            }
            if e.opt && xIsCallOp(mut st, i) {
                if xColdCall(mut st, i) {
                    e.cpc = append(e.cpc, ip)
                } else {
                    e.cp = append(e.cp, ip)
                }
            }
            n += 1
            i = xiNext(mut st, i)
        }
        for j <- iter.Range(0, xNTermOps(mut st, b)) {
            xTouch(mut e, xTermOpnd(mut st, b, j), be)
        }
        // 辺の並行コピーは前任の終端で後続の仮引数の置き場へ書く — 仮引数はそこでも生きている。
        // 最適化のバックエンド（M5）は数えない: 辺のコピーは分岐の後のその辺の経路だけで書き、そこで生きている値は後続の入口でも生きている
        // （後続の仮引数と区間が重なる）ので、仮引数の置き場を壊さない。実引数と仮引数が同じ置き場を取れる（ループの合流の mov が消える）
        for j <- iter.Range(0, if e.opt { 0 } else { xNSucc(mut st, b) }) {
            mut q := xbPHead(mut st, BlkRef(e.blk[xSucc(mut st, b, j)]))
            while q >= 0 {
                xTouch(mut e, xParamVal(mut st, q), be)
                q = xParamNext(mut st, q)
            }
        }
    }
    if e.opt {
        xSortInts(mut e.cp)
        xSortInts(mut e.cpc)
        // 熱いブロックに使用の無い値（冷たい道でだけ働く — 熱い部分では定義と恒等の辺の実引数だけ）は冷たいブロックを深さ 0 で数えた重みに（S3a）
        for v <- iter.Range(0, nv) {
            if e.hu[v] == 0 {
                e.wt[v] = e.wc[v]
            }
        }
    }
}

// xIsCallOp は命令 i が呼び出し（呼び出し規約の段 1 — 呼ばれ側が caller-saved の組を壊す）か: call・間接 call・罠・task の切替と開始・clone。
// 除くもの: rep movs に置き換える rt.copy / rt.copy8（xInst — rsi / rdi を自分で積む）・戻らない rt.panic / rt.panic_mem（後ろで生きる値が無い —
// 罠への巻き戻りは罠の記録が callee-saved を戻す）・syscall（rcx / r11 しか壊さない — 引数レジスタに載って跨ぐ値は xSyscall が積む）
func xIsCallOp(st mut St, i InsRef) bool {
    op := xiOp(mut st, i)
    if op == OpCall {
        g := FnRef(xiA(mut st, i))
        return g != st.rtCopy && g != st.rtCopy8 && g != st.rtPanic && g != st.rtPanicMem
    }
    return op == OpCallI || op == OpTrapI || op == OpTSwitch || op == OpTStart || op == OpClone
}

// xColdCall は呼び出し i（xIsCallOp）が冷たい呼び出しか（report-462 (c) — 跨ぎの集合から外し、呼び手が前後で caller-saved を退避・復元する）:
// 成長の rt（slice_grow・slice_grow8・grow_try・map_grow — 容器ごとの償却 O(1)）への直の call。根拠は「まれ」ではなく「退避の往復〔最大 5 語〕の
// 費用が呼び出しそのものの費用で抑えられる」こと（要求ごとの容器の成長は反復に比例して走る — routing の map_grow 16 万回）。
// region_relocate(8) は入れない（反復ごとの境界のコピー — logagg 395 万回 — xColdBlocks の種とは別）。棄てた案: 死ぬブロック（exit でしか
// 終わらない道 — panic の文言の印字の rt.flush）の呼び出しも入れる形 — 題材 8 本の命令が同じで cycles にも符号一致の差が無く、判定の分だけ
// 自己 build の仕事が増えた（report-464）。ループの運搬値だけに caller-saved を許す形 — routing の予測ミスの悪化は消えず fasta の回収が半分（report-464）
func xColdCall(st mut St, i InsRef) bool {
    if xiOp(mut st, i) != OpCall {
        return false
    }
    g := FnRef(xiA(mut st, i))
    return g == st.rtGrow || g == st.rtGrow8 || g == st.rtGrowTry || g == st.rtMapGrow
}

// xCrossCold は部分区間 v が冷たい呼び出しを跨ぐか（xCrossCall と同じ判定 — 列は cpc）
func xCrossCold(e mut xF, v int) bool {
    j := xFirstAfter(mut e.cpc, len(e.cpc), e.ivS[v])
    return j < len(e.cpc) && e.cpc[j] < e.ivE[v]
}

// xColdMask は位置 p の冷たい呼び出しで退避する caller-saved の組（p が冷たい呼び出しでなければ 0）
func xColdMask(e mut xF, p int) int {
    if len(e.cpc) == 0 {
        return 0
    }
    mut lo := 0
    mut hi := len(e.cpc)
    while lo < hi {
        m := (lo + hi) / 2
        if e.cpc[m] < p {
            lo = m + 1
        } else {
            hi = m
        }
    }
    return if lo < len(e.cpc) && e.cpc[lo] == p { e.cpm[lo] } else { 0 }
}

// xColdSave は冷たい呼び出しの前（実引数の前）に組 m のレジスタを枠へ・xColdLoad は呼び出しと結果の写しの後で戻す
func xColdSave(e mut xF, c mut table.Table[byte], m int) {
    for r <- iter.Range(0, if m == 0 { 0 } else { 16 }) {
        if (m >> r & 1) == 1 {
            x86.MovMemReg(mut c, x86.Rbp, e.csd[r], r)
        }
    }
}

func xColdLoad(e mut xF, c mut table.Table[byte], m int) {
    for r <- iter.Range(0, if m == 0 { 0 } else { 16 }) {
        if (m >> r & 1) == 1 {
            x86.MovRegMem(mut c, r, x86.Rbp, e.csd[r])
        }
    }
}

// xCrossCall は部分区間 v が呼び出しを跨ぐか（始まり < 呼び出しの位置 < 終わり — 呼び出しの結果は位置で始まり、最後の実引数は位置で終わる）
func xCrossCall(e mut xF, v int) bool {
    s := e.ivS[v]
    t := e.ivE[v]
    mut lo := 0
    mut hi := len(e.cp)
    while lo < hi {
        m := (lo + hi) / 2
        if e.cp[m] <= s {
            lo = m + 1
        } else {
            hi = m
        }
    }
    return lo < len(e.cp) && e.cp[lo] < t
}

// xNoCall は関数に呼び出しが無いか（段 2 — フレームを省いてよい形の一部）: rep movs に置き換える rt.copy / rt.copy8 と戻らない rt.panic /
// rt.panic_mem の call は許す（panic は rsp の 16 B の揃いを読まない — 揃えを要る命令〔aligned の load / store〕をメモリに使わない）。
// 罠・切替・開始・clone・間接 call・ほかの call があれば偽
func xNoCall(st mut St, e mut xF) bool {
    for k <- iter.Range(0, e.norder) {
        mut i := xbIHead(mut st, BlkRef(e.blk[e.order[k]]))
        while i != -1 {
            op := xiOp(mut st, i)
            if op == OpCall {
                g := FnRef(xiA(mut st, i))
                if g != st.rtCopy && g != st.rtCopy8 && g != st.rtPanic && g != st.rtPanicMem {
                    return false
                }
            } else if op == OpCallI || op == OpTrapI || op == OpTSwitch || op == OpTStart || op == OpClone {
                return false
            }
            i = xiNext(mut st, i)
        }
    }
    return true
}

// xCalleeSaved は汎用レジスタ r が callee-saved の組（rbx・r12〜r15）か — opt の規約（呼び出し規約の段 1）。写しのバックエンドは 10 本すべて
func xCalleeSaved(r int) bool {
    return r == x86.Rbx || r == x86.R12 || r == x86.R13 || r == x86.R14 || r == x86.R15
}

// xPieces は区間を部分区間の表に（S1b — 値ごとに 1 本: 部分区間の番号 = 値の番号）。割るのは一段目の割り当ての後（xSplitLoops）
func xPieces(st mut St, e mut xF) {
    e.npc = e.nv
    xFill(mut e.pnx, e.nv, -1)
    for v <- iter.Range(0, e.nv) {
        e.pv = append(e.pv, v)
    }
    if e.opt {
        for v <- iter.Range(0, e.nv) {
            e.pwt = append(e.pwt, e.wt[v])
        }
        xHolePieces(mut st, mut e)
        // 末尾の区画（冷たいブロック — S3b）の外包: 本体の触れが無ければそれが区間・あれば 2 本目の部分区間（重み 1 — 冷たい。本体と末尾の間は穴 —
        // 値はそこで死んでいる）。本体 ⇄ 末尾の辺の写しは xSplitMoves（割る点 = 末尾の始まり − 1）。運搬値の穴で割れた値は鎖の最後へ足す
        mut anyTail := false
        for v <- iter.Range(0, e.nv) {
            if e.tS[v] >= 0 {
                if e.ivS[v] < 0 {
                    e.ivS[v] = e.tS[v]
                    e.ivE[v] = e.tE[v]
                } else {
                    k := e.npc
                    e.ivS = append(e.ivS, e.tS[v])
                    e.ivE = append(e.ivE, e.tE[v])
                    e.pnx = append(e.pnx, -1)
                    e.pv = append(e.pv, v)
                    e.pwt = append(e.pwt, 1)
                    mut last := v
                    while e.pnx[last] >= 0 {
                        last = e.pnx[last]
                    }
                    if last == v {
                        e.sv = append(e.sv, v)
                    }
                    e.pnx[last] = k
                    e.npc = k + 1
                    anyTail = true
                }
            }
        }
        if anyTail {
            e.cuts = append(e.cuts, e.c0 - 1)
        }
        xSortInts(mut e.cuts)
        mut cu := mut []int{}
        for i <- iter.Range(0, len(e.cuts)) {
            if i == 0 || e.cuts[i - 1] != e.cuts[i] {
                cu = append(cu, e.cuts[i])
            }
        }
        e.cuts = cu
    }
}

// xHolePieces はループの頭の仮引数（運搬値）の本体の区間を、生きているブロック（live-in・頭）の吐く順の連なりごとの部分区間に割る（間は穴 — 値はそこで死んでいる）
// （6.5 第 1 便 T2）。運搬値がループの後ろで使われると、線形の区間がラッチまで伸びて戻り辺の実引数と重なり、同じレジスタを取れず戻り辺に写しが残った
// （葉の `mov r14, rbx`）。連なりの終わりは、出ていく辺で生きていればブロックの終わり・でなければブロックの中の最後の使用。部分区間の重みは値の重み（どれも同じ）。
// 連なりは吐く順で続くブロックの列で、値がブロックから出ていかない（終わりがブロックの終わりより前）ところでも切る（区間の便 段 1 R1 — 運搬値が
// ラッチの手前で死ぬと戻り辺の実引数〔更新値〕が仮引数と同じレジスタを取れる: logagg の `lea r8,[rbx+1]; mov rbx,r8`・fasta・spectralnorm）。
// 穴をまたぐ辺の写しは xSplitMoves（割る点 = 2 本目以降の連なりの始まり − 1）
func xHolePieces(st mut St, e mut xF) {
    nh := len(e.hvV)
    if nh == 0 {
        return
    }
    mut kOf := mut []int{}
    xFill(mut kOf, e.nb, -1)
    for k <- iter.Range(0, e.norder) {
        kOf[e.order[k]] = k
    }
    mut live := mut []int{}
    xFill(mut live, e.nb, -1)
    mut i := 0
    while i < nh {
        v := e.hvV[i]
        mut j := i
        while j < nh && e.hvV[j] == v {
            j += 1
        }
        if e.tS[v] < 0 || e.ivS[v] >= 0 {
            // 本体のブロックの吐く順の位置（頭 + live-in）
            mut ks := mut []int{}
            hk := kOf[e.hdB[v]]
            if hk >= 0 && e.bpos[e.hdB[v]] < e.c0 {
                ks = append(ks, hk)
                live[e.hdB[v]] = v
            }
            for q <- iter.Range(i, j) {
                b := e.hvB[q]
                // 末尾の区画のブロックも live の印は付ける（そこへ出ていく辺の読み元 = 本体の連なりの終わり）— 連なりには入れない
                live[b] = v
                if kOf[b] >= 0 && e.bpos[b] >= 0 && e.bpos[b] < e.c0 {
                    ks = append(ks, kOf[b])
                }
            }
            xSortInts(mut ks)
            // 連なりの終わり（ks の添字 rq・位置 re）を 1 回の走査で: 吐く順で次のブロックが続かないか、値がブロックから出ていかない（終わりが
            // ブロックの終わりより前 — 区間の便 段 1 R1）なら切る
            mut rq := mut []int{}
            mut re := mut []int{}
            if len(ks) >= 2 && e.ivS[v] >= 0 {
                for q <- iter.Range(0, len(ks)) {
                    bq := e.order[ks[q]]
                    e0 := xHoleEnd(mut st, mut e, v, bq, mut live)
                    if q + 1 == len(ks) || ks[q + 1] != ks[q] + 1 || e0 < xBlkEnd(mut st, mut e, bq) {
                        rq = append(rq, q)
                        re = append(re, e0)
                    }
                }
            }
            if len(rq) >= 2 {
                mut prev := -1
                mut q := 0
                for r <- iter.Range(0, len(rq)) {
                    s0 := e.bpos[e.order[ks[q]]]
                    e0 := re[r]
                    if prev < 0 {
                        e.ivE[v] = if e0 < e.ivE[v] { e0 } else { e.ivE[v] }
                        prev = v
                    } else {
                        k := e.npc
                        e.ivS = append(e.ivS, s0)
                        e.ivE = append(e.ivE, e0)
                        e.pnx = append(e.pnx, -1)
                        e.pv = append(e.pv, v)
                        e.pwt = append(e.pwt, e.wt[v])
                        e.pnx[prev] = k
                        e.npc = k + 1
                        prev = k
                        e.cuts = append(e.cuts, s0 - 1)
                    }
                    q = rq[r] + 1
                }
                e.sv = append(e.sv, v)
            }
        }
        i = j
    }
}

// xHoleEnd は運搬値 v の連なりの最後のブロック b での終わり: 後続のどれかで生きていれば（live の印・頭への戻り辺は仮引数の写しなので数えない）ブロックの終わり、
// でなければブロックの中の最後の使用（命令の被演算子・融合した gep の被演算子・終端の被演算子）。使用が無ければブロックの頭
func xHoleEnd(st mut St, e mut xF, v int, bi int, live mut []int) int {
    b := BlkRef(e.blk[bi])
    be := xBlkEnd(mut st, mut e, bi)
    for k <- iter.Range(0, xNSucc(mut st, b)) {
        s := xSucc(mut st, b, k)
        if live[s] == v && s != e.hdB[v] {
            return be
        }
    }
    for k <- iter.Range(0, xNTermOps(mut st, b)) {
        if xTermOpnd(mut st, b, k) == v {
            return be
        }
    }
    bs := e.bpos[bi]
    mut last := bs + 1
    mut i := xbIHead(mut st, b)
    mut n := 0
    while i != -1 {
        ip := bs + 2 * (n + 1)
        for j <- iter.Range(0, xNOps(mut st, i)) {
            v0 := xOpnd(mut st, i, j)
            if v0 == v || (e.fold[v0] == 1 && (e.fA[v0] == v || e.fB[v0] == v)) {
                last = ip
            }
        }
        n += 1
        i = xiNext(mut st, i)
    }
    return last
}

// xSplitLoops は一段目の割り当て（割らない）の spill を見て、**圧のあるループ**を素通りする値だけをループの範囲の境界で割る（区間分割レーン S2 —
// split-draft (a) の二段方式）。割ったら true（呼び手が割り当て直す）。
// - 圧のあるループ = 一段目で spill した値の定義・使用がループの範囲（吐く順の [頭, 体の最後]）の中にあるループ。組（int / xmm）ごとに spill した値の数を数える
// - 素通りの値 = 外包が範囲を丸ごと含み、範囲の中に定義も使用も無い値（の部分区間 — 値の 1 本目と運搬値の穴の本体の部分区間）。範囲の手前と後ろ（どちらも「次のブロックの頭 − 1」の奇数の位置 — 問い合わせの
//   位置は偶数なので境界で迷わない）で割る。真ん中の部分区間は重み 0（最後に割り当てる — ループの中だけ spill するか兄弟のヒントで同じレジスタ）
// - 本数の上限: ループ・組ごとに spill した値の数まで。素通りの値を優先度の低い順（一段目で先にどかされる側）に先着で枠を取る
// - 入れ子は使用の間の隙間ごとに、隙間に丸ごと入る最も外の圧のあるループで割る。境界の写しは辺ごと（xSplitMoves）
// 棄てた形: ループの中で使う値も割る（内側のループの出入りごとにレジスタ間の写し — fannkuch の命令 23.2 → 32.9 G）・
// 素通りの値を圧と無関係に全部割る（ループの中の値が素通りの値のレジスタを先に取り、得るもの無しの写しが出入りごとに — fannkuch +16%・knucleotide +8%）
func xSplitLoops(st mut St, e mut xF, spills mut []int, nsp int) bool {
    e.npc0 = e.npc
    for k <- iter.Range(0, e.npc) {
        e.porig = append(e.porig, k)
    }
    // 割れるループ（頭が入口でなく最後のブロックで終わらない）の [手前の点, 後ろの点]（頭の順 = 手前の点の昇順）と後ろの点の後ろからの最小
    mut la := mut []int{}
    mut lb := mut []int{}
    for j <- iter.Range(0, len(e.lpR) / 2) {
        h := e.lpR[2 * j]
        t := e.lpR[2 * j + 1]
        if h > 0 && t + 1 < e.norder {
            la = append(la, e.bpos[e.order[h]] - 1)
            lb = append(lb, e.bpos[e.order[t + 1]] - 1)
        }
    }
    nl := len(la)
    if nl == 0 {
        return false
    }
    mut sufMin := mut []int{}
    xFill(mut sufMin, nl + 1, 0)
    sufMin[nl] = 9223372036854775807
    mut j0 := nl
    while j0 > 0 {
        j0 -= 1
        sufMin[j0] = if lb[j0] < sufMin[j0 + 1] { lb[j0] } else { sufMin[j0 + 1] }
    }
    // 候補 = 外包がどれかのループの範囲を丸ごと含む部分区間（値の 1 本目と、運搬値の穴で割れた値の本体の部分区間 — 区間の便 段 1 R1:
    // 穴の 2 本目以降が内側のループを素通りすると、値の 1 本目しか見ない割り方ではその部分区間が割れずに内側のループの枠を塞いだ —
    // revcomp の外側の運搬値・report-528）。cand は値ごと（使用の列を集める印）・cp は部分区間の列
    mut cand := mut []int{}
    xFill(mut cand, e.nv, 0)
    mut cp := mut []int{}
    for k <- iter.Range(0, e.npc) {
        v := e.pv[k]
        if e.ivS[k] >= 0 && (k == v || (e.hdB[v] >= 0 && e.ivS[k] < e.c0)) && xIsReg(e.loc[k]) {
            j := xFirstAfter(mut la, nl, e.ivS[k])
            if sufMin[j] < e.ivE[k] {
                cand[v] = 1
                cp = append(cp, k)
            }
        }
    }
    nCand := len(cp)
    // 一段目で spill した値（部分区間 = 値 — 一段目は割っていない）
    // spill した部分区間（末尾の区画の部分区間 — S3b — は spill しても本体の圧ではない: 使用の位置ごとに覆う部分区間で見る — xSpillAt）
    mut sp := mut []int{}
    xFill(mut sp, e.nv, 0)
    mut spP := mut []int{}
    xFill(mut spP, e.npc, 0)
    for k <- iter.Range(0, nsp) {
        sp[e.pv[spills[k]]] = 1
        spP[spills[k]] = 1
    }
    // 割る候補は一段目でレジスタを持っていた部分区間だけ（上の xIsReg — spill していた値は割ってもレジスタを明け渡さない — 真ん中がほかのループで
    // レジスタを取り写しが増えるだけだった: fannkuch の main で優先度の低い spill 済みの素通りの値が枠を先に取った）
    // spill した値の候補（6.5 第 1 便 T1）: 一段目で丸ごと spill した値（末尾の区画の部分区間を持たない）を、使用のあるループの境界で割り、
    // ループの中の部分区間だけを二段目に回す（外側の部分区間は spill に固定 — 外側が二段目でほかの値の枠を取ると 1brc / knucleotide が退行した: 形 (2)）。
    // 内側の部分区間はレジスタの空き（一段目の固定と、それより重い残り）に収まるときだけレジスタへ — 追い出しはしない
    // 候補は区間が範囲の外へはみ出す形でどれかのループと重なる値だけ（la の昇順の前置の lb の最大で二分探索 — 重ならない値に使用の列を作らない）
    mut pmax := mut []int{}
    mut mx := -1
    for j <- iter.Range(0, nl) {
        mx = if lb[j] > mx { lb[j] } else { mx }
        pmax = append(pmax, mx)
    }
    mut scand := mut []int{}
    xFill(mut scand, e.nv, 0)
    mut nS := 0
    for k <- iter.Range(0, nsp) {
        v := e.pv[spills[k]]
        if spills[k] == v && e.pnx[v] < 0 && e.ivS[v] >= 0 {
            // la < t のループの数 → その中の lb の最大が s を越えれば重なる（はみ出しは割る段で見る）
            jt := xFirstAfter(mut la, nl, e.ivE[v] - 1)
            if jt > 0 && pmax[jt - 1] > e.ivS[v] {
                scand[v] = 1
                nS += 1
            }
        }
    }
    if nCand == 0 && nS == 0 {
        return false
    }
    // 候補の定義・使用の位置と重み（吐く順に辿るので値ごとに昇順 — 値ごとの連結の列）+ spill した値の定義・使用の位置（全体で昇順の列）
    mut uHead := mut []int{}
    xFill(mut uHead, e.nv, -1)
    mut uTail := mut []int{}
    xFill(mut uTail, e.nv, -1)
    mut uPos := mut []int{}
    mut uW := mut []int{}
    mut uNext := mut []int{}
    mut gPos := mut []int{}
    mut gVal := mut []int{}
    for k <- iter.Range(0, e.norder) {
        bi := e.order[k]
        dp := e.ldep[k]
        w := if dp <= 0 { 1 } else if dp == 1 { 8 } else if dp == 2 { 64 } else if dp == 3 { 512 } else { 4096 }
        b := BlkRef(e.blk[bi])
        bs := e.bpos[bi]
        mut p := xbPHead(mut st, b)
        while p >= 0 {
            v := xParamVal(mut st, p)
            if cand[v] == 1 || scand[v] == 1 {
                xUse(mut uHead, mut uTail, mut uPos, mut uW, mut uNext, v, bs, w)
            }
            if sp[v] == 1 && xSpillAt(mut e, mut spP, v, bs) {
                gPos = append(gPos, bs)
                gVal = append(gVal, v)
            }
            p = xParamNext(mut st, p)
        }
        mut i := xbIHead(mut st, b)
        mut n := 0
        while i != -1 {
            ip := bs + 2 * (n + 1)
            for j <- iter.Range(0, xNOps(mut st, i)) {
                v0 := xOpnd(mut st, i, j)
                // 融合した gep の番地は gep の被演算子 p・ix の使用（xLive と同じ）— 重みは xWeigh と同じく gep の値に数える
                if e.fold[v0] == 1 {
                    a0 := e.fA[v0]
                    b0 := e.fB[v0]
                    if cand[a0] == 1 || scand[a0] == 1 {
                        xUse(mut uHead, mut uTail, mut uPos, mut uW, mut uNext, a0, ip, 0)
                    }
                    if cand[b0] == 1 || scand[b0] == 1 {
                        xUse(mut uHead, mut uTail, mut uPos, mut uW, mut uNext, b0, ip, 0)
                    }
                    if sp[a0] == 1 && xSpillAt(mut e, mut spP, a0, ip) {
                        gPos = append(gPos, ip)
                        gVal = append(gVal, a0)
                    }
                    if sp[b0] == 1 && xSpillAt(mut e, mut spP, b0, ip) {
                        gPos = append(gPos, ip)
                        gVal = append(gVal, b0)
                    }
                }
                if cand[v0] == 1 || scand[v0] == 1 {
                    xUse(mut uHead, mut uTail, mut uPos, mut uW, mut uNext, v0, ip, w)
                }
                if sp[v0] == 1 && xSpillAt(mut e, mut spP, v0, ip) {
                    gPos = append(gPos, ip)
                    gVal = append(gVal, v0)
                }
            }
            r := xiRes(mut st, i)
            if r >= 0 {
                if cand[r] == 1 || scand[r] == 1 {
                    xUse(mut uHead, mut uTail, mut uPos, mut uW, mut uNext, r, ip, w)
                }
                if sp[r] == 1 && xSpillAt(mut e, mut spP, r, ip) {
                    gPos = append(gPos, ip)
                    gVal = append(gVal, r)
                }
            }
            n += 1
            i = xiNext(mut st, i)
        }
        be := bs + 2 * (n + 1)
        for j <- iter.Range(0, xNTermOps(mut st, b)) {
            v := xTermOpnd(mut st, b, j)
            if cand[v] == 1 || scand[v] == 1 {
                xUse(mut uHead, mut uTail, mut uPos, mut uW, mut uNext, v, be, w)
            }
            if sp[v] == 1 && xSpillAt(mut e, mut spP, v, be) {
                gPos = append(gPos, be)
                gVal = append(gVal, v)
            }
        }
    }
    // 圧: ループ j・組 c（0 = int・1 = xmm）の範囲の中に定義・使用のある spill した値の数
    ng := len(gPos)
    mut pres := mut []int{}
    xFill(mut pres, 2 * nl, 0)
    mut seen := mut []int{}
    xFill(mut seen, e.nv, -1)
    mut anyP := false
    for j <- iter.Range(0, nl) {
        mut g := xFirstAfter(mut gPos, ng, la[j])
        while g < ng && gPos[g] < lb[j] {
            s := gVal[g]
            if seen[s] != j {
                seen[s] = j
                c := if e.fcls[s] == 1 { 1 } else { 0 }
                pres[2 * j + c] = pres[2 * j + c] + 1
                anyP = true
            }
            g += 1
        }
    }
    if !anyP && nS == 0 {
        return false
    }
    // 候補を優先度の低い順に（xPrioSort の逆順 — 一段目で先にどかされる側から枠を取る）
    xPrioSort(mut e, mut cp, nCand)
    // 使用の間の隙間（外包の両端を含む）ごとに、隙間に丸ごと入る最も外の圧のある（枠の残る）ループで割る
    mut taken := mut []int{}
    xFill(mut taken, 2 * nl, 0)
    mut mids := mut []int{}
    mut lused := mut []int{}
    xFill(mut lused, nl, 0)
    mut ci := nCand
    while ci > 0 {
        ci -= 1
        pk := cp[ci]
        v := e.pv[pk]
        c := if e.fcls[v] == 1 { 1 } else { 0 }
        mut prev := pk
        a0 := e.ivS[pk]
        mut a := a0
        mut u := uHead[v]
        while u >= 0 && uPos[u] < a0 {
            u = uNext[u]
        }
        fin := e.ivE[pk]
        // 割るのは本体の部分区間だけ（末尾の区画の部分区間 — S3b — の使用は見ない）
        hadTail := e.pnx[v] >= 0
        mut done := false
        while !done {
            bnd := if u >= 0 && uPos[u] <= fin { uPos[u] } else { fin }
            mut j := xFirstAfter(mut la, nl, a)
            while j < nl && la[j] < bnd {
                if lb[j] < bnd && pres[2 * j + c] > taken[2 * j + c] {
                    // [.., la] / [la + 1, lb] / [lb + 1, ..]
                    prev = xCut(mut e, prev, v, la[j])
                    mids = append(mids, prev)
                    prev = xCut(mut e, prev, v, lb[j])
                    lused[j] = 1
                    taken[2 * j + c] = taken[2 * j + c] + 1
                    // 入れ子（手前の点が lb より前）は飛ばす
                    lbj := lb[j]
                    while j < nl && la[j] < lbj {
                        j += 1
                    }
                } else {
                    j += 1
                }
            }
            if u < 0 || uPos[u] > fin {
                done = true
            } else {
                a = uPos[u]
                u = uNext[u]
            }
        }
        if prev != pk {
            if !hadTail {
                e.sv = append(e.sv, v)
            }
            // 部分区間の重み = その中の定義・使用（真ん中は 0 — 割った部分区間の分だけ）
            mut k := pk
            e.pwt[pk] = 0
            mut u2 := uHead[v]
            while u2 >= 0 && uPos[u2] < a0 {
                u2 = uNext[u2]
            }
            while u2 >= 0 && uPos[u2] <= fin {
                while e.ivE[k] < uPos[u2] {
                    k = e.pnx[k]
                }
                e.pwt[k] = e.pwt[k] + uW[u2]
                u2 = uNext[u2]
            }
        }
    }
    // spill した値: 使用を中に持つループのうち、入れ子に使用を持たない最も内側のループ（値の区間が範囲の外へはみ出すもの）で割る。
    // 外側のループで割ると内側の部分区間が長くなり枠に入らない（fannkuch の n — 外側の while 全体）。外側の部分区間は souter に（二段目で spill に固定）
    mut souter := mut []int{}
    mut sinner := mut []int{}
    for v <- iter.Range(0, e.nv) {
        if scand[v] == 1 {
            s := e.ivS[v]
            t := e.ivE[v]
            mut prev := v
            mut cut := false
            mut j := 0
            while j < nl && la[j] < t {
                if lb[j] > s && (s <= la[j] || t > lb[j]) && xHasUseIn(mut uHead, mut uPos, mut uNext, v, la[j], lb[j]) && !xNestedUse(mut uHead, mut uPos, mut uNext, v, mut la, mut lb, nl, j) && xAnyFree(mut e, v, if s > la[j] { s } else { la[j] + 1 }, if t < lb[j] { t } else { lb[j] }) {
                    if s <= la[j] {
                        souter = append(souter, prev)
                        prev = xCut(mut e, prev, v, la[j])
                    }
                    if t > lb[j] {
                        inner := prev
                        prev = xCut(mut e, prev, v, lb[j])
                        souter = append(souter, prev)
                        sinner = append(sinner, inner)
                    } else {
                        sinner = append(sinner, prev)
                    }
                    lused[j] = 1
                    cut = true
                    lbj := lb[j]
                    while j < nl && la[j] < lbj {
                        j += 1
                    }
                } else {
                    j += 1
                }
            }
            if cut {
                e.sv = append(e.sv, v)
                mut k := v
                while k >= 0 {
                    e.pwt[k] = 0
                    k = e.pnx[k]
                }
                k = v
                mut u2 := uHead[v]
                while u2 >= 0 && uPos[u2] <= t {
                    while e.ivE[k] < uPos[u2] {
                        k = e.pnx[k]
                    }
                    e.pwt[k] = e.pwt[k] + uW[u2]
                    u2 = uNext[u2]
                }
            }
        }
    }
    if len(mids) == 0 && len(sinner) == 0 {
        return false
    }
    // 割った点の昇順・重複なし（xSplitMoves の素通りの判定）
    mut cl := mut []int{}
    for j <- iter.Range(0, nl) {
        if lused[j] == 1 {
            cl = append(cl, la[j])
            cl = append(cl, lb[j])
        }
    }
    for i <- iter.Range(0, len(e.cuts)) {
        cl = append(cl, e.cuts[i])
    }
    xSortInts(mut cl)
    // 作り直す（重複を除いた数が前の列より短いと末尾に古い点が残り、昇順が崩れて xSplitMoves の二分探索が割る点を見落とす — 前の列が
    // 2 点以上で重複を含むと発火する。運搬値の穴〔T2〕で辺の写しが抜け parser.parametersN を誤コンパイルした実例）
    mut cu := mut []int{}
    for i <- iter.Range(0, len(cl)) {
        if i == 0 || cl[i - 1] != cl[i] {
            cu = append(cu, cl[i])
        }
    }
    e.cuts = cu
    // 二段目の固定: 一段目でレジスタだった部分区間から割った部分区間（真ん中を除く）はそのレジスタ（e.loc はまだ一段目の部分区間ごとの置き場 — 出所は porig）
    for k <- iter.Range(0, e.npc) {
        l := e.loc[e.porig[k]]
        e.pfix = append(e.pfix, if xIsReg(l) { xLocVal(l) } else { -1 })
    }
    for i <- iter.Range(0, len(mids)) {
        e.pfix[mids[i]] = -1
    }
    for i <- iter.Range(0, len(souter)) {
        e.pfix[souter[i]] = -2
    }
    for i <- iter.Range(0, len(sinner)) {
        e.pfix[sinner[i]] = -3
    }
    return true
}

// xUnsplitSpilled は二段目の後、部分区間が全部 spill のままの割った値（spill した値の内側の部分区間が枠を得なかったもの）を 1 本に畳み戻し、
// 割れた値の列から外す（写しは要らない — spill 先は値ごとに 1 つ。残すと辺ごとの xSplitMoves と置き場の読みが鎖をなめ続け、自己 build の仕事 +0.5%）。
// 畳んだ部分区間は区間なし（ivS = -1）にする
func xUnsplitSpilled(e mut xF) {
    mut keep := mut []int{}
    for j <- iter.Range(0, len(e.sv)) {
        v := e.sv[j]
        mut allSp := e.pnx[v] >= 0
        mut k := v
        while k >= 0 && allSp {
            if xIsReg(e.loc[k]) || e.pfix[k] >= -1 {
                allSp = false
            }
            k = e.pnx[k]
        }
        if allSp {
            mut last := v
            k = e.pnx[v]
            while k >= 0 {
                last = k
                nx := e.pnx[k]
                e.ivS[k] = -1
                k = nx
            }
            e.ivE[v] = e.ivE[last]
            e.pnx[v] = -1
        } else {
            keep = append(keep, v)
        }
    }
    e.sv = keep
}

// xAnyFree は値 v の組（int / xmm）のどれかのレジスタで、一段目の割り当て（割った値の最初の部分区間は縮めた後）が [s, t] と重ならないか —
// 楽観（割った値の外側の部分区間はまだ列に無い）。どこにも入らない内側の部分区間は割らない（二段目の仕事を増やすだけ — 自己 build +0.6%）
func xAnyFree(e mut xF, v int, s int, t int) bool {
    fl := e.fcls[v] == 1
    n := if fl { e.nx } else { xNAlloc }
    for j <- iter.Range(0, n) {
        r := if fl { xXmmReg(j) } else { xAllocReg(j) }
        if xFitsIv(mut e, r, s, t) {
            return true
        }
    }
    return false
}

// xFitsIv は xPrioFits の区間版（[s, t] がレジスタ r の列のどれとも重ならないか）
func xFitsIv(e mut xF, r int, s int, t int) bool {
    n := e.aN[r]
    base := e.aB[r]
    mut lo := 0
    mut hi := n
    while lo < hi {
        m := (lo + hi) / 2
        if e.ivS[e.aL[base + m]] <= s {
            lo = m + 1
        } else {
            hi = m
        }
    }
    if lo > 0 {
        w := e.aL[base + lo - 1]
        if e.ivS[w] == s || s < e.ivE[w] {
            return false
        }
    }
    if lo < n {
        w := e.aL[base + lo]
        if e.ivS[w] < t {
            return false
        }
    }
    return true
}

// xNestedUse はループ j の入れ子のループのどれかに値 v の定義・使用があるか
func xNestedUse(uHead mut []int, uPos mut []int, uNext mut []int, v int, la mut []int, lb mut []int, nl int, j int) bool {
    mut k := j + 1
    while k < nl && la[k] < lb[j] {
        if xHasUseIn(mut uHead, mut uPos, mut uNext, v, la[k], lb[k]) {
            return true
        }
        k += 1
    }
    return false
}

// xHasUseIn は値 v の定義・使用（昇順の列）に (a, b) の中の位置があるか
func xHasUseIn(uHead mut []int, uPos mut []int, uNext mut []int, v int, a int, b int) bool {
    mut u := uHead[v]
    while u >= 0 && uPos[u] <= a {
        u = uNext[u]
    }
    return u >= 0 && uPos[u] < b
}

// xSpillAt は値 v の位置 p を覆う部分区間が一段目で spill したか
func xSpillAt(e mut xF, spP mut []int, v int, p int) bool {
    k := xPieceAt(mut e, v, p)
    return k >= 0 && spP[k] == 1
}

// xFirstAfter は昇順の a[0..n) で x より大きい最初の添字
func xFirstAfter(a mut []int, n int, x int) int {
    mut lo := 0
    mut hi := n
    while lo < hi {
        m := (lo + hi) / 2
        if a[m] <= x {
            lo = m + 1
        } else {
            hi = m
        }
    }
    return lo
}

// xCut は値 v の最後の部分区間 prev を点 q で割り、後ろの部分区間を返す（[.., q] / [q + 1, ..]）
func xCut(e mut xF, prev int, v int, q int) int {
    k := e.npc
    e.ivS = append(e.ivS, q + 1)
    e.ivE = append(e.ivE, e.ivE[prev])
    e.pnx = append(e.pnx, e.pnx[prev])
    e.pv = append(e.pv, v)
    e.pwt = append(e.pwt, 0)
    e.porig = append(e.porig, e.porig[prev])
    e.ivE[prev] = q
    e.pnx[prev] = k
    e.npc = k + 1
    return k
}

func xUse(head mut []int, tail mut []int, pos mut []int, wt mut []int, next mut []int, v int, p int, w int) {
    k := len(pos)
    pos = append(pos, p)
    wt = append(wt, w)
    next = append(next, -1)
    if tail[v] < 0 {
        head[v] = k
    } else {
        next[tail[v]] = k
    }
    tail[v] = k
}

// xSortInts は昇順に並べる（挿入 — 割る点は少ない）
func xSortInts(a mut []int) {
    for i <- iter.Range(1, len(a)) {
        x := a[i]
        mut j := i
        while j > 0 && a[j - 1] > x {
            a[j] = a[j - 1]
            j -= 1
        }
        a[j] = x
    }
}

// xPieceAt は値 v の部分区間のうち位置 p を覆うもの（無ければ -1）
func xPieceAt(e mut xF, v int, p int) int {
    mut k := v
    while k >= 0 {
        if e.ivS[k] > p || e.ivS[k] < 0 {
            return -1
        }
        if p <= e.ivE[k] {
            return k
        }
        k = e.pnx[k]
    }
    return -1
}

// xSlotValid は割れた値ごとに、spill 先が値を持っているかをブロックの終わりで求める（第 1 便 (d) ③）。前向きの「すべての道で」の不動点:
// 入り(b) = 前任すべての出(p) の論理積（入口は偽）・出(b) = b の終わりで値が spill 先にいる ∨（入り(b) ∧ b で定義しない）。spill 先にいる点では必ず正しい
// （定義が spill 先へ書いたか、reg → mem の境目で書いたか — 書かなかった境目はそこで既に正しかった）。値が死んでいる点は偽（安全側 — 生きている点の
// 前任はみな生きているので結果に効かない）。定義のブロックの入りは偽（仮引数は頭のブロック — 後ろの辺の写しが書き直すので定義と同じ扱い）。
// 関数の引数は使わない（xSplitMoves が呼び手の積んだ番地への写しを別に外している）
func xSlotValid(st mut St, e mut xF) {
    nb := e.nb
    ns := len(e.sv)
    // 対象（レジスタの部分区間と spill 先の部分区間の両方を持つ割れた値）が無ければ何もしない（svOk は空 — xSplitMoves は今までどおり）
    mut any := false
    for j <- iter.Range(0, ns) {
        mut anyR := false
        mut anyM := false
        mut q := e.sv[j]
        while q >= 0 {
            if e.ivS[q] >= 0 {
                if xIsReg(e.loc[q]) {
                    anyR = true
                } else {
                    anyM = true
                }
            }
            q = e.pnx[q]
        }
        if anyR && anyM {
            any = true
        }
    }
    if !any {
        return
    }
    xFill(mut e.svOk, ns * nb, 0)
    // ブロックの終わり（吐く順 — 位置は xOrder が 1 ブロック 2 × (命令の数 + 2) ずつ進めるので、次のブロックの頭 − 2。最後だけ命令を歩く）
    mut bend := mut []int{}
    xFill(mut bend, e.norder, 0)
    for k <- iter.Range(0, e.norder) {
        bend[k] = if k + 1 < e.norder { e.bpos[e.order[k + 1]] - 2 } else { xBlkEnd(mut st, mut e, e.order[k]) }
    }
    mut kOf := mut []int{}
    xFill(mut kOf, nb, -1)
    for k <- iter.Range(0, e.norder) {
        kOf[e.order[k]] = k
    }
    // 後続の表（吐く順の位置で — 詰めた列 + 先頭の添字）
    mut sh := mut []int{}
    mut sl := mut []int{}
    for k <- iter.Range(0, e.norder) {
        sh = append(sh, len(sl))
        b := BlkRef(e.blk[e.order[k]])
        for t <- iter.Range(0, xNSucc(mut st, b)) {
            sl = append(sl, kOf[xSucc(mut st, b, t)])
        }
    }
    sh = append(sh, len(sl))
    // 定義のブロック（吐く順の位置 — 仮引数は頭のブロック・関数の引数は入口）。外包の始まりのブロックでは代用できない: 吐く順で定義より前に置かれた
    // ブロックが外包に入ることがある（そこでは値は死んでいて、出の偽りの真が定義のブロックの入りを 1 にしてしまう — json_decode で実発）
    mut defK := mut []int{}
    xFill(mut defK, e.nv, 0)
    for k <- iter.Range(0, e.norder) {
        b := BlkRef(e.blk[e.order[k]])
        mut p := xbPHead(mut st, b)
        while p >= 0 {
            defK[xParamVal(mut st, p)] = k
            p = xParamNext(mut st, p)
        }
        mut i := xbIHead(mut st, b)
        while i != -1 {
            r := xiRes(mut st, i)
            if r >= 0 {
                defK[r] = k
            }
            i = xiNext(mut st, i)
        }
    }
    mut vin := mut []int{}
    xFill(mut vin, e.norder, 0)
    mut vout := mut []int{}
    xFill(mut vout, e.norder, 0)
    for j <- iter.Range(0, ns) {
        v := e.sv[j]
        // 値の外包 [lo, hi]（最初の部分区間の始まり 〜 最後の部分区間の終わり）と交わるブロックだけを見る — 外では死んでいる（出 = 偽）。
        // 生きて入るブロックの前任は生きて出るので外包と交わる（範囲の外の前任は考えなくてよい）
        // 置き場がレジスタの部分区間と spill 先の部分区間の両方を持つ値だけ（どちらか一方なら reg → mem の境目は無い）
        lo := e.ivS[v]
        mut hi := e.ivE[v]
        mut anyR := false
        mut anyM := false
        mut q := v
        while q >= 0 {
            if e.ivS[q] >= 0 {
                if e.ivE[q] > hi {
                    hi = e.ivE[q]
                }
                if xIsReg(e.loc[q]) {
                    anyR = true
                } else {
                    anyM = true
                }
            }
            q = e.pnx[q]
        }
        if lo >= 0 && anyR && anyM {
            mut k0 := 0
            while k0 < e.norder && bend[k0] < lo {
                k0 += 1
            }
            mut k1 := k0
            while k1 < e.norder && e.bpos[e.order[k1]] <= hi {
                k1 += 1
            }
            db := defK[v]
            for k <- iter.Range(k0, k1) {
                vin[k] = if k == 0 { 0 } else { 1 }
            }
            // 吐く順に 1 回なめて出を作り、偽の出は後続の入りへすぐ配る（前へ進む辺は同じ周で効く）。後ろの辺で入りが落ちたら周を繰り返す
            mut changed := true
            while changed {
                changed = false
                // 部分区間は開始の昇順・ブロックの終わりも吐く順に昇順 — 鎖を先頭から 1 回なめる
                mut pk := v
                for k <- iter.Range(k0, k1) {
                    while pk >= 0 && e.ivE[pk] < bend[k] {
                        pk = e.pnx[pk]
                    }
                    cov := pk >= 0 && e.ivS[pk] >= 0 && e.ivS[pk] <= bend[k]
                    vout[k] = if cov && (!xIsReg(e.loc[pk]) || (vin[k] == 1 && k != db)) { 1 } else { 0 }
                    if vout[k] == 0 {
                        for t <- iter.Range(sh[k], sh[k + 1]) {
                            ks := sl[t]
                            if ks > 0 && ks >= k0 && ks < k1 && vin[ks] == 1 {
                                vin[ks] = 0
                                if ks <= k {
                                    changed = true
                                }
                            }
                        }
                    }
                }
            }
            for k <- iter.Range(k0, k1) {
                e.svOk[j * nb + e.order[k]] = vout[k]
            }
        }
    }
}

// xBlkOfPos は位置 p を含む吐く順のブロックの番号（bpos は吐く順に昇順）
func xBlkOfPos(e mut xF, p int) int {
    mut lo := 0
    mut hi := e.norder - 1
    while lo < hi {
        m := (lo + hi + 1) / 2
        if e.bpos[e.order[m]] <= p {
            lo = m
        } else {
            hi = m - 1
        }
    }
    return e.order[lo]
}

// xIsParamOf は v が行き先 to の仮引数か（辺の仮引数の写しが書くので、割れた値の写しからは外す）
func xIsParamOf(st mut St, to BlkRef, v int) bool {
    mut p := xbPHead(mut st, to)
    while p >= 0 {
        if xParamVal(mut st, p) == v {
            return true
        }
        p = xParamNext(mut st, p)
    }
    return false
}

// xSplitMoves は辺（今のブロックの終わり → 行き先 to の頭）の割れた値の写しを e.mvD / e.mvS の n 番目から足し、新しい本数を返す:
// 両端を覆う部分区間の置き場が違う値だけ（両端の間に割る点が無ければ何もしない）。覆う部分区間があれば値は死んでいても写してよい —
// 書き先の置き場は外包の中でその値に取ってある（同じ辺で生きている値は行き先の頭を覆うので重ならない）。
// 例外 = 行き先の仮引数（最初の部分区間が行き先の頭で始まる値 — 入口以外ではそれだけ）: この辺が仮引数の写しで書くので外す
// （ループの頭の仮引数は外包が後ろの辺の元まで届き、古い値を写すと仮引数の写しと同じ置き場へ二重に書く）
func xSplitMoves(st mut St, e mut xF, to BlkRef, n0 int) int {
    mut n := n0
    nc := len(e.cuts)
    if nc == 0 {
        return n
    }
    a := e.pos
    b := e.bpos[xbId(mut st, to)]
    lo0 := if a < b { a } else { b }
    hi0 := if a < b { b } else { a }
    mut lo := 0
    mut hi := nc
    while lo < hi {
        m := (lo + hi) / 2
        if e.cuts[m] < lo0 {
            lo = m + 1
        } else {
            hi = m
        }
    }
    if lo >= nc || e.cuts[lo] >= hi0 {
        return n
    }
    for j <- iter.Range(0, len(e.sv)) {
        v := e.sv[j]
        ka := if xIsParamOf(mut st, to, v) { -1 } else { xPieceAt(mut e, v, a) }
        if ka >= 0 {
            kb := xPieceAt(mut e, v, b)
            // 関数の引数の置き場（呼び手が積んだ番地 — スタックで来た引数だけ）へ書く写しは要らない — そこは入口からずっとその値を持つ（ほかの値は置かれない）
            // reg → spill 先の写しは、spill 先がこの辺の元のブロックの終わりで既に値を持っていれば要らない（SSA の値は変わらない — xSlotValid）
            if kb >= 0 && e.loc[ka] != e.loc[kb] && !(v < e.np && v >= e.nreg && e.loc[kb] == xLocFrame(xParamHome(mut e, v))) && !(xIsReg(e.loc[ka]) && !xIsReg(e.loc[kb]) && len(e.svOk) > 0 && e.svOk[j * e.nb + xBlkOfPos(mut e, a)] == 1) {
                e.mvD[n] = e.loc[kb]
                e.mvS[n] = e.loc[ka]
                n += 1
            }
        }
    }
    return n
}

// xLoopDepth は吐く順の k 番目のブロックのループの深さ（M5 — spill の重み用・第三便 M16 で自然ループに）: 頭 h ごとに、h へ戻る辺 t → h
// （t が順で h 以降 — 後ろの辺）の末尾 t から頭を越えずに前任を逆に辿れるブロックを h のループの体とし、体のブロックを 1 段深くする。
// 以前は「吐く順の [h, t] の区間を 1 段深く」の近似で、区間に混ざる出口のブロック（panic の点・append の成長の経路・ループの後ろの直線）まで深く
// 数え、熱いループの運搬値より冷えた経路の一時値が重く見えて、運搬値が spill された（revcomp）
func xLoopDepth(st mut St, e mut xF) mut []int {
    n := e.norder
    mut d := mut []int{}
    xFill(mut d, n + 1, 0)
    // 順の位置 ← ブロックの番号
    mut kOf := mut []int{}
    xFill(mut kOf, e.nb, -1)
    for k <- iter.Range(0, n) {
        kOf[e.order[k]] = k
    }
    // 前任の表（順の位置で — 詰めた列 + 先頭の添字）
    mut pc := mut []int{}
    xFill(mut pc, n + 1, 0)
    for k <- iter.Range(0, n) {
        b := BlkRef(e.blk[e.order[k]])
        for j <- iter.Range(0, xNSucc(mut st, b)) {
            ks := kOf[xSucc(mut st, b, j)]
            if ks >= 0 {
                pc[ks + 1] = pc[ks + 1] + 1
            }
        }
    }
    for k <- iter.Range(0, n) {
        pc[k + 1] = pc[k + 1] + pc[k]
    }
    mut fill := mut []int{}
    xFill(mut fill, n, 0)
    for k <- iter.Range(0, n) {
        fill[k] = pc[k]
    }
    mut pl := mut []int{}
    xFill(mut pl, pc[n] + 1, 0)
    for k <- iter.Range(0, n) {
        b := BlkRef(e.blk[e.order[k]])
        for j <- iter.Range(0, xNSucc(mut st, b)) {
            ks := kOf[xSucc(mut st, b, j)]
            if ks >= 0 {
                pl[fill[ks]] = k
                fill[ks] = fill[ks] + 1
            }
        }
    }
    // 頭ごとに体を印（印 = 頭の位置 + 1 — 頭ごとに一意）
    mut mark := mut []int{}
    xFill(mut mark, n, 0)
    mut stack := mut []int{}
    xFill(mut stack, n + 1, 0)
    for h <- iter.Range(0, n) {
        mut started := false
        mut hi := h
        for q <- iter.Range(pc[h], pc[h + 1]) {
            t := pl[q]
            if t >= h {
                if !started {
                    started = true
                    mark[h] = h + 1
                    d[h] = d[h] + 1
                }
                mut sp := 0
                if mark[t] != h + 1 {
                    mark[t] = h + 1
                    d[t] = d[t] + 1
                    stack[sp] = t
                    sp += 1
                    if t > hi && e.cold[t] == 0 {
                        hi = t
                    }
                }
                while sp > 0 {
                    sp -= 1
                    x := stack[sp]
                    for r <- iter.Range(pc[x], pc[x + 1]) {
                        p := pl[r]
                        if mark[p] != h + 1 {
                            mark[p] = h + 1
                            d[p] = d[p] + 1
                            stack[sp] = p
                            sp += 1
                            if p > hi && e.cold[p] == 0 {
                                hi = p
                            }
                        }
                    }
                }
            }
        }
        if started {
            // ループの範囲（区間の分割 S2 — 体は頭以降に並ぶ: 頭が体を支配し順は逆後順・冷たいブロックは体に入らない）
            e.lpR = append(e.lpR, h)
            e.lpR = append(e.lpR, hi)
        }
    }
    return d
}

// xWeigh はブロック b の定義・使用を深さ dp の重みで数える
func xWeigh(st mut St, e mut xF, b BlkRef, dp int, cold bool) {
    w := if dp <= 0 { 1 } else if dp == 1 { 8 } else if dp == 2 { 64 } else if dp == 3 { 512 } else { 4096 }
    wc := if cold { 1 } else { w }
    h := if cold || dp <= 0 { 0 } else { 1 }
    mut p := xbPHead(mut st, b)
    while p >= 0 {
        v := xParamVal(mut st, p)
        e.wt[v] = e.wt[v] + w
        e.wc[v] = e.wc[v] + wc
        p = xParamNext(mut st, p)
    }
    mut i := xbIHead(mut st, b)
    while i != -1 {
        for j <- iter.Range(0, xNOps(mut st, i)) {
            v := xOpnd(mut st, i, j)
            e.wt[v] = e.wt[v] + w
            e.wc[v] = e.wc[v] + wc
            e.hu[v] = e.hu[v] + h
        }
        r := xiRes(mut st, i)
        if r >= 0 {
            e.wt[r] = e.wt[r] + w
            e.wc[r] = e.wc[r] + wc
        }
        i = xiNext(mut st, i)
    }
    // 辺の実引数は、行き先の仮引数がその値自身（後ろの辺で変わらない変数 — 置き場が同じなら写しは 0 命令）なら数えない（区間分割 S3a）
    t := xbTerm(mut st, b)
    if t == TmBr {
        xWeighArgs(mut st, mut e, xbBrTo(mut st, b), xTermX(mut st, b, 2), w, wc, h)
    } else if t == TmCondbr {
        c := xTermX(mut st, b, 1)
        e.wt[c] = e.wt[c] + w
        e.wc[c] = e.wc[c] + wc
        e.hu[c] = e.hu[c] + h
        xWeighArgs(mut st, mut e, xbThen(mut st, b), xTermX(mut st, b, 3), w, wc, h)
        xWeighArgs(mut st, mut e, xbElse(mut st, b), xTermX(mut st, b, 5), w, wc, h)
    } else {
        for j <- iter.Range(0, xNTermOps(mut st, b)) {
            v := xTermOpnd(mut st, b, j)
            e.wt[v] = e.wt[v] + w
            e.wc[v] = e.wc[v] + wc
            e.hu[v] = e.hu[v] + h
        }
    }
}

func xWeighArgs(st mut St, e mut xF, to BlkRef, args int, w int, wc int, h int) {
    mut n := 0
    mut p := xbPHead(mut st, to)
    while p >= 0 {
        a := xAt(mut st, args, n)
        if a != xParamVal(mut st, p) {
            e.wt[a] = e.wt[a] + w
            e.wc[a] = e.wc[a] + wc
            e.hu[a] = e.hu[a] + h
        }
        n += 1
        p = xParamNext(mut st, p)
    }
}

// xColdBlocks は冷たい領域のブロックに印を付ける（e.cold — 区間分割 S3a）。印は重みの補正にだけ使う: ループの中の熱いブロックに
// 使用の無い値（冷たい道でだけ働く — 熱い部分では定義と恒等の辺の実引数だけ）は、冷たいブロックを深さ 0 で数えた重み（xLive の末尾）。
// 冷たいブロックの重みを全部の値で深さ 0 にする形は棄却: 熱い道と遅い道の両方で使う値の重みが下がり、長い区間が短い熱い一時値を追い越して
// revcomp の内側のループで spill が増えた（cycles +18%）。優先度を密度（重み ÷ 長さ）にする形も全題材で +5〜20% で棄却
// 冷たい = exit で終わるブロック（panic の点）と、冷たい辺の行き先から前向きに「前任（後ろの辺を除く）が全部冷たい」で広がる領域。
// 冷たい辺 = 条件分岐の片側だけが、単一入口・単一出口の鎖を辿って遅い道の rt（幾何成長・map の成長・境界コピー）を呼ぶブロックへ届くとき、その側。
// 種を遅い道の rt に限るのは、ユーザーの呼び出し（再帰など）を冷たいと誤らないため。rt.region_alloc は確保の本道でもあるので種にしない。
// 判定をブロック単位（遅い道の rt を呼ぶブロックだけ）にした試みは無効果だった — 冷たい道の中の速い道のブロック（先端での append のインライン）の
// 使用が深さの重みのまま残る（1BRC の main で、挿入の道でだけ働くループの頭の仮引数が重み 129 で熱い部分のレジスタを占めていた）
func xColdBlocks(st mut St, e mut xF) {
    n := e.norder
    mut kOf := mut []int{}
    xFill(mut kOf, e.nb, -1)
    for k <- iter.Range(0, n) {
        kOf[e.order[k]] = k
    }
    // 種（遅い道の rt を呼ぶ）と前任の数（後ろの辺 = 吐く順で後ろから前へ — を除く）
    mut seed := mut []int{}
    xFill(mut seed, n, 0)
    mut npred := mut []int{}
    xFill(mut npred, n, 0)
    mut anySeed := false
    for k <- iter.Range(0, n) {
        b := BlkRef(e.blk[e.order[k]])
        mut i := xbIHead(mut st, b)
        while i != -1 {
            if xiOp(mut st, i) == OpCall && xSlowRt(mut st, xiA(mut st, i)) {
                seed[k] = 1
                anySeed = true
            }
            i = xiNext(mut st, i)
        }
        for j <- iter.Range(0, xNSucc(mut st, b)) {
            ks := kOf[xSucc(mut st, b, j)]
            if ks > k {
                npred[ks] = npred[ks] + 1
            }
        }
    }
    if !anySeed {
        for k <- iter.Range(1, n) {
            if xbTerm(mut st, BlkRef(e.blk[e.order[k]])) == TmExit {
                e.cold[k] = 1
            }
        }
        return
    }
    mut cold := mut []int{}
    xFill(mut cold, n, 0)
    mut ncold := mut []int{}
    xFill(mut ncold, n, 0)
    for k <- iter.Range(0, n) {
        b := BlkRef(e.blk[e.order[k]])
        if k > 0 && (xbTerm(mut st, b) == TmExit || (npred[k] > 0 && ncold[k] == npred[k])) {
            cold[k] = 1
        }
        if xbTerm(mut st, b) == TmCondbr {
            k0 := kOf[xSucc(mut st, b, 0)]
            k1 := kOf[xSucc(mut st, b, 1)]
            c0 := xColdChain(mut st, mut e, mut kOf, mut seed, mut npred, k0, k)
            c1 := xColdChain(mut st, mut e, mut kOf, mut seed, mut npred, k1, k)
            if c0 != c1 {
                xColdMark(mut st, mut e, mut kOf, mut npred, mut cold, if c0 { k0 } else { k1 })
            }
        }
        if cold[k] == 1 {
            for j <- iter.Range(0, xNSucc(mut st, b)) {
                ks := kOf[xSucc(mut st, b, j)]
                if ks > k {
                    ncold[ks] = ncold[ks] + 1
                }
            }
        }
    }
    for k <- iter.Range(0, n) {
        e.cold[k] = cold[k]
    }
}

// xColdChain は吐く順の k0 から単一入口・単一出口の鎖（前へ進む辺だけ）を辿って種に届くか（k0 の前任は分岐 kb だけであること）
func xColdChain(st mut St, e mut xF, kOf mut []int, seed mut []int, npred mut []int, k0 int, kb int) bool {
    if k0 <= kb || npred[k0] != 1 {
        return false
    }
    mut k := k0
    while true {
        if seed[k] == 1 {
            return true
        }
        b := BlkRef(e.blk[e.order[k]])
        if xbTerm(mut st, b) != TmBr {
            return false
        }
        ks := kOf[xSucc(mut st, b, 0)]
        if ks <= k || npred[ks] != 1 {
            return false
        }
        k = ks
    }
    return false
}

// xColdMark は鎖（xColdChain が種に届いた k0 から種まで）を冷たくする
func xColdMark(st mut St, e mut xF, kOf mut []int, npred mut []int, cold mut []int, k0 int) {
    mut k := k0
    while k >= 0 {
        cold[k] = 1
        b := BlkRef(e.blk[e.order[k]])
        if xbTerm(mut st, b) != TmBr {
            return
        }
        ks := kOf[xSucc(mut st, b, 0)]
        k = if ks > k && npred[ks] == 1 { ks } else { -1 }
    }
}

// xSlowRt は遅い道の rt か（冷たい領域の種 — xColdBlocks）
func xSlowRt(st mut St, f int) bool {
    return f >= 0 && (f == int(st.rtGrow) || f == int(st.rtGrow8) || f == int(st.rtGrowTry) || f == int(st.rtMapGrow) || f == int(st.rtReloc) || f == int(st.rtReloc8))
}

// xSpillCost は spill の費用（M5）: 重み ÷ 区間の長さ（長く生きて使われの疎な値ほど安い）。長さは 256 で頭打ち — 区間を割らない linear scan では、
// 関数の端から端まで生きてループの中で使われる値（slice の len・base）が長さで割ると安く見えて落とされる（M6 で関数が膨らむと fannkuch の
// 内側のループの len が spill された）。頭打ちなしの重みだけ（ループの中の短い一時値が落ちる）・64 / 1024 も試した（同じ結果）
func xSpillCost(e mut xF, v int) int {
    n := e.ivE[v] - e.ivS[v] + 2
    return e.wt[e.pv[v]] * 4096 / (if n > 256 { 256 } else { n })
}

// xPrioAlloc は区間を spill の費用（重み — ループの深さで 8 倍ずつ）の高い順に彩色する（第二便 M8）: レジスタごとに割り当て済みの区間の鎖を持ち、
// 重ならないレジスタに置く（ヒントのレジスタを先に試す）。置けなければ spill。linear scan は「その時点の active の中で最安を落とす」局所の選び方で、
// 内側のループで重く使う長命の値（slice の base）を短い一時値より先に落としていた。重なり = s < e' かつ s' < e（end ≤ start は共有可 — linear scan と同じ）。
// 置けない部分区間は、運搬値の穴で割れた値の「中に使用の無い」部分区間（素通り — 定義と境目だけ）を、その費用が自分の費用の半分以下なら追い出す
// （xPrioEvict — 区間の便 段 2 D2。追い出した先客は列へ戻して優先度の順に置き直す）。spill した値の数を返す（spills の先頭に積む）
func xPrioAlloc(st mut St, e mut xF, ivs mut []int, nivs int, used mut []int, spills mut []int) int {
    xPrioSort(mut e, mut ivs, nivs)
    // レジスタごとの割り当て済みの区間（開始の昇順 — 区間分割レーン S1a: 重なりの判定を二分探索で O(log n) に。割り当て済みの区間どうしは
    // 重ならず開始も違うので、開始で並べると終わり ≤ 次の開始。重なりうるのは「開始 ≤ s の最後」と「開始 > s の最初」の 2 つだけ）
    // 平らな枠: レジスタ r の列は aL[aB[r] 〜] の aN[r] 個（枠の大きさ aC[r] — 満杯なら 1 本の配列の末尾へ倍の枠を取り直して移す。
    // 区間の数 × 32 の枠を関数ごとにゼロ埋めすると自己 build で +0.6 G だった）
    for j <- iter.Range(0, 32) {
        e.aB = append(e.aB, j * 8)
        e.aC = append(e.aC, 8)
        e.aN = append(e.aN, 0)
    }
    xFill(mut e.aL, 32 * 8, 0)
    // free の [32, 64) は予約（xPrioPick — レジスタ r に置いた戻り辺の実引数の行き先の運搬値の仮引数 q が未処理なら q + 1）・[64] は予約のあるレジスタのビット
    mut free := mut []int{}
    xFill(mut free, 65, 0)
    mut nsp := 0
    evn := XEV_N
    if len(e.ev) == 0 {
        xFill(mut e.ev, 4 * e.npc + 2, 0)
    }
    hb := 4 * e.npc
    mut k := 0
    while k < nivs || e.ev[hb + 1] > 0 {
        mut v := 0
        if e.ev[hb + 1] > 0 && (k >= nivs || xPrioBefore(mut e, e.ev[hb + 2], ivs[k])) {
            v = xHeapPop(mut e)
        } else {
            v = ivs[k]
            k += 1
        }
        mut r := xPrioPick(mut e, mut free, v)
        // 先客がどれも割れた値（部分区間 2 本以上 — 1 本だけの値は中に使用があるので追い出さない）のレジスタがあるときだけ、中の触れを数えて追い出しを試す
        if r < 0 && len(e.sv) > 0 && xEvictMaybe(mut e, v, evn) {
            if e.ev[hb] == 0 {
                xPcInit(mut st, mut e)
            }
            r = xPrioEvict(mut e, v, evn)
        }
        e.ev[4 * v + 1] = 1
        if free[64] != 0 && v < e.nv && e.hdB[v] >= 0 {
            // 運搬値の仮引数の 1 本目を処理した — その予約を解く
            for j <- iter.Range(0, 32) {
                if free[32 + j] == v + 1 {
                    free[32 + j] = 0
                    free[64] = free[64] - (1 << j)
                }
            }
        }
        if r >= 0 {
            xPrioPlace(mut e, mut used, r, v)
            q := e.hP[e.pv[v]]
            if q >= 0 && e.hdB[q] >= 0 && e.ev[4 * q + 1] == 0 {
                if free[32 + r] == 0 {
                    free[64] = free[64] + (1 << r)
                }
                free[32 + r] = q + 1
            }
        } else {
            spills[nsp] = v
            nsp += 1
        }
    }
    return nsp
}

// 追い出しの連鎖の上限（1 つの部分区間が追い出されるのは XEV_N 回まで — 判定の仕事と不動点を縛る）
const XEV_N = 1

// xPcInit は運搬値の穴で割れた値（xHolePieces — e.hdB[v] ≥ 0 で部分区間 2 本以上）の部分区間ごとの中の触れの重みと使用の数（e.ev の [4c + 2]・[4c + 3]）を、
// 関数を 1 回走査して数える（置けない部分区間が初めて出たとき — ほかの部分区間は追い出さないので数えない）。数え方は xWeigh と同じ（仮引数・結果は定義・
// 被演算子・条件・恒等でない辺の実引数・終端の被演算子は使用）を触れの位置を覆う部分区間へ。融合した gep の被演算子も使用に数える（load / store の番地の読みは
// その基底・添字の使用）。冷たいブロックは、熱いブロックに使用の無い値だけ 1。棄てた案: 部分区間ごとに覆うブロックだけを遅延で走査する形 — 長い部分区間を
// 何度も舐めて自己 build の判定の仕事 +3.1 G（全関数 1 回の走査は +0.4 G）
func xPcInit(st mut St, e mut xF) {
    e.ev[4 * e.npc] = 1
    for k <- iter.Range(0, e.norder) {
        bi := e.order[k]
        b := BlkRef(e.blk[bi])
        bs := e.bpos[bi]
        mut p := xbPHead(mut st, b)
        while p >= 0 {
            xPcAdd(mut e, xParamVal(mut st, p), bs, k, 0)
            p = xParamNext(mut st, p)
        }
        mut i := xbIHead(mut st, b)
        mut n := 0
        while i != -1 {
            ip := bs + 2 * (n + 1)
            for j <- iter.Range(0, xNOps(mut st, i)) {
                o := xOpnd(mut st, i, j)
                if e.fold[o] == 1 {
                    xPcAdd(mut e, e.fA[o], ip, k, 1)
                    xPcAdd(mut e, e.fB[o], ip, k, 1)
                } else {
                    xPcAdd(mut e, o, ip, k, 1)
                }
            }
            r := xiRes(mut st, i)
            if r >= 0 && e.fold[r] == 0 {
                xPcAdd(mut e, r, ip, k, 0)
            }
            n += 1
            i = xiNext(mut st, i)
        }
        be := bs + 2 * (n + 1)
        tm := xbTerm(mut st, b)
        if tm == TmBr {
            xPcArgs(mut st, mut e, xbBrTo(mut st, b), xTermX(mut st, b, 2), be, k)
        } else if tm == TmCondbr {
            xPcAdd(mut e, xTermX(mut st, b, 1), be, k, 1)
            xPcArgs(mut st, mut e, xbThen(mut st, b), xTermX(mut st, b, 3), be, k)
            xPcArgs(mut st, mut e, xbElse(mut st, b), xTermX(mut st, b, 5), be, k)
        } else {
            for j <- iter.Range(0, xNTermOps(mut st, b)) {
                xPcAdd(mut e, xTermOpnd(mut st, b, j), be, k, 1)
            }
        }
    }
}

// xPcAdd は値 v の位置 p（吐く順のブロック k）の触れ（u = 1 なら使用）を、p を覆う部分区間へ足す（運搬値の穴で割れた値だけ）
func xPcAdd(e mut xF, v int, p int, k int, u int) {
    if v < 0 || v >= e.nv || e.hdB[v] < 0 || e.pnx[v] < 0 {
        return
    }
    c := xPieceAt(mut e, v, p)
    if c >= 0 {
        e.ev[4 * c + 2] = e.ev[4 * c + 2] + (if e.cold[k] == 1 && e.hu[v] == 0 { 1 } else { xDepW(e.ldep[k]) })
        e.ev[4 * c + 3] = e.ev[4 * c + 3] + u
    }
}

// xPcArgs は辺の実引数のうち、行き先の仮引数がその値自身でないものを使用に数える
func xPcArgs(st mut St, e mut xF, to BlkRef, args int, be int, k int) {
    mut n := 0
    mut p := xbPHead(mut st, to)
    while p >= 0 {
        a := xAt(mut st, args, n)
        if a != xParamVal(mut st, p) {
            xPcAdd(mut e, a, be, k, 1)
        }
        n += 1
        p = xParamNext(mut st, p)
    }
}

func xDepW(dp int) int {
    return if dp <= 0 { 1 } else if dp == 1 { 8 } else if dp == 2 { 64 } else if dp == 3 { 512 } else { 4096 }
}

// xPosK は位置 p のブロックの吐く順の番号（p 以下で始まる最後のブロック）
func xPosK(e mut xF, p int) int {
    mut lo := 0
    mut hi := e.norder
    while lo < hi {
        m := (lo + hi) / 2
        if e.bpos[e.order[m]] <= p {
            lo = m + 1
        } else {
            hi = m
        }
    }
    return if lo > 0 { lo - 1 } else { 0 }
}

// xPosW は位置 p のブロックの深さの重み（冷たいブロックは 1）
func xPosW(e mut xF, p int) int {
    k := xPosK(mut e, p)
    return if e.cold[k] == 1 { 1 } else { xDepW(e.ldep[k]) }
}

// xPcCost は部分区間 c を mem に置いたときの費用: 中の触れ（使用は load・定義は store）+ 隣の部分区間がレジスタ（か未処理）なら境目の写し 1 本
// （隣が mem なら写しは無い）。重みは静的（深さの 8 倍）— 中に触れの無い素通りの部分区間（運搬値の穴で割れた区間）は境目だけの値段になる
func xPcCost(e mut xF, c int) int {
    mut cost := e.ev[4 * c + 2]
    v := e.pv[c]
    if c != v {
        mut pr := v
        while e.pnx[pr] != c {
            pr = e.pnx[pr]
        }
        if e.ev[4 * pr + 1] == 0 || xIsReg(e.loc[pr]) {
            cost = cost + xPosW(mut e, e.ivS[c])
        }
    }
    nx := e.pnx[c]
    if nx >= 0 && (e.ev[4 * nx + 1] == 0 || xIsReg(e.loc[nx])) {
        cost = cost + xPosW(mut e, e.ivS[nx])
    }
    return cost
}

// xPrioEvict は置けない部分区間 v のために、重なる先客の費用の和が v の費用より安いレジスタを探し、先客を列から外して（追い出された回数 +1・
// ヒープへ戻す）そのレジスタを返す（無ければ -1）。追い出せるのは追い出された回数が n 未満の先客だけ（連鎖の上限）。候補の組は xPrioPick と同じ
func xPrioEvict(e mut xF, v int, n int) int {
    // 先客の費用の和が v の費用の半分以下のときだけ（2 倍の余裕 — 費用のモデルの外の写し〔ヒントで合体していた辺の写しのずれ〕の分）
    // v の費用: 運搬値の穴の部分区間は中の触れ + 境目・ほかは部分区間の重み（値の重み — 融合した gep の使用は数えない xWeigh の規則）
    cv := (if xHoleP(mut e, v) { xPcCost(mut e, v) } else { e.pwt[v] }) / 2 + 1
    fl := e.fcls[e.pv[v]] == 1
    cross := !fl && xCrossCall(mut e, v)
    nr := if fl { e.nx } else if cross { xNCallee } else { xNAlloc }
    s := e.ivS[v]
    t := e.ivE[v]
    mut best := -1
    mut bestC := cv
    for j <- iter.Range(0, nr) {
        r := if fl { xXmmReg(j) } else { xAllocReg(j) }
        c := xEvictCost(mut e, r, s, t, n, bestC)
        if c < bestC {
            best = r
            bestC = c
        }
    }
    if best < 0 {
        return -1
    }
    // 先客を外す（開始の順の列から詰める）
    base := e.aB[best]
    mut m := 0
    for q <- iter.Range(0, e.aN[best]) {
        w := e.aL[base + q]
        if xOverlap(mut e, w, s, t) {
            e.loc[w] = xSpill
            e.ev[4 * w] = e.ev[4 * w] + 1
            xHeapPush(mut e, w)
        } else {
            e.aL[base + m] = w
            m += 1
        }
    }
    e.aN[best] = m
    return best
}

// xOverlap は部分区間 w が [s, t] の部分区間と重なるか（xPrioFits と同じ規則）
func xOverlap(e mut xF, w int, s int, t int) bool {
    return e.ivS[w] == s || (e.ivS[w] < s && s < e.ivE[w]) || (e.ivS[w] > s && e.ivS[w] < t)
}

// xConf0 はレジスタ r の列で [s, …] と重なりうる最初の添字（開始 ≤ s の最後 — 無ければ 0。列は開始の昇順で重ならない）
func xConf0(e mut xF, r int, s int) int {
    base := e.aB[r]
    mut lo := 0
    mut hi := e.aN[r]
    while lo < hi {
        m := (lo + hi) / 2
        if e.ivS[e.aL[base + m]] <= s {
            lo = m + 1
        } else {
            hi = m
        }
    }
    return if lo > 0 { lo - 1 } else { 0 }
}

// xEvictCost はレジスタ r で [s, t] と重なる先客の費用の和（追い出せない先客がいるか、和が lim 以上なら lim）
func xEvictCost(e mut xF, r int, s int, t int, n int, lim int) int {
    base := e.aB[r]
    mut c := 0
    for q <- iter.Range(xConf0(mut e, r, s), e.aN[r]) {
        w := e.aL[base + q]
        if e.ivS[w] >= t && e.ivS[w] != s {
            return c
        }
        if xOverlap(mut e, w, s, t) {
            if e.ev[4 * w] >= n || !xHoleP(mut e, w) || e.ev[4 * w + 3] > 0 {
                return lim
            }
            c = c + xPcCost(mut e, w)
            if c >= lim {
                return lim
            }
        }
    }
    return c
}

// xHeapPush / xHeapPop は追い出した部分区間のヒープ（e.ev の [4 npc + 2 〜] の [4 npc + 1] 個 — 先頭 = xPrioBefore で最も先）
func xHeapPush(e mut xF, v int) {
    hb := 4 * e.npc + 2
    n := e.ev[hb - 1]
    if hb + n < len(e.ev) {
        e.ev[hb + n] = v
    } else {
        e.ev = append(e.ev, v)
    }
    e.ev[hb - 1] = n + 1
    mut i := n
    while i > 0 {
        p := (i - 1) / 2
        if !xPrioBefore(mut e, e.ev[hb + i], e.ev[hb + p]) {
            return
        }
        x := e.ev[hb + p]
        e.ev[hb + p] = e.ev[hb + i]
        e.ev[hb + i] = x
        i = p
    }
}

func xHeapPop(e mut xF) int {
    hb := 4 * e.npc + 2
    h0 := e.ev[hb]
    n := e.ev[hb - 1] - 1
    e.ev[hb - 1] = n
    e.ev[hb] = e.ev[hb + n]
    mut i := 0
    while true {
        l := 2 * i + 1
        if l >= n {
            return h0
        }
        mut c := l
        if l + 1 < n && xPrioBefore(mut e, e.ev[hb + l + 1], e.ev[hb + l]) {
            c = l + 1
        }
        if !xPrioBefore(mut e, e.ev[hb + c], e.ev[hb + i]) {
            return h0
        }
        x := e.ev[hb + c]
        e.ev[hb + c] = e.ev[hb + i]
        e.ev[hb + i] = x
        i = c
    }
    return h0
}

// xHoleP は部分区間 w が運搬値の穴で割れた値の部分区間か（追い出しの対象 — 中の触れを数えるのはこの値だけ）
func xHoleP(e mut xF, w int) bool {
    v := e.pv[w]
    return e.hdB[v] >= 0 && e.pnx[v] >= 0
}

// xEvictMaybe は部分区間 v の組のレジスタのどれかで、重なる先客がどれも割れた値の部分区間（追い出された回数 n 未満）か — 中の触れを数える前の門
func xEvictMaybe(e mut xF, v int, n int) bool {
    fl := e.fcls[e.pv[v]] == 1
    cross := !fl && xCrossCall(mut e, v)
    nr := if fl { e.nx } else if cross { xNCallee } else { xNAlloc }
    s := e.ivS[v]
    t := e.ivE[v]
    for j <- iter.Range(0, nr) {
        r := if fl { xXmmReg(j) } else { xAllocReg(j) }
        base := e.aB[r]
        mut ok := true
        mut q := xConf0(mut e, r, s)
        while ok && q < e.aN[r] && (e.ivS[e.aL[base + q]] < t || e.ivS[e.aL[base + q]] == s) {
            w := e.aL[base + q]
            if xOverlap(mut e, w, s, t) && (e.ev[4 * w] >= n || !xHoleP(mut e, w)) {
                ok = false
            }
            q += 1
        }
        if ok {
            return true
        }
    }
    return false
}

// xPrioRealloc は二段目の割り当て（区間分割 S2 — 一段目の結果からの差分）: 一段目の列（aL）はそのまま — 割った値の最初の部分区間は列の中で
// 縮むだけ。外側の部分区間を一段目のレジスタに足し（一段目の区間の部分集合なので重ならない）、残り（真ん中・一段目で spill した部分区間 —
// spill した部分区間は割る候補にならない）だけを優先度の順に割り当てる。新しい部分区間は npc0 以降（末尾の区画の部分区間 — S3b — は一段目からある）。
// 一段目のレジスタを固定するのは、割った値の外側の部分区間は重みが分かれて優先度が下がり、全部を割り当て直すと一段目でレジスタだった値が
// 熱いループごと spill したため（knucleotide の rt.map_find で spill 14 → 23・cycles +5〜8%）。全部を割り当て直す形（固定を先に）と結果は同じで、
// 仕事は割った関数の割り当ての 2 回目ぶん（自己 build +1 G）を残りの数ぶんへ
func xPrioRealloc(e mut xF, used mut []int, spills mut []int, nsp1 int) int {
    xFill(mut e.loc, e.npc - len(e.loc), xSpill)
    // pfix = -2: spill した値の外側の部分区間（xSplitLoops — 二段目でも spill のまま）
    // -3（spill した値のループの中の部分区間）と割った値の真ん中（重み 0）は、一段目で spill した残りの後に余りの枠だけを取る — 中の部分区間が重みで先に枠を取ると、
    // 一段目で spill して二段目で枠を得ていたループの運搬値を押し出し、毎反復 store → load の鎖になった（revcomp の cycles +10.6%）
    mut rest := mut []int{}
    mut rest2 := mut []int{}
    mut fixed := mut []int{}
    for k <- iter.Range(0, nsp1) {
        if e.pfix[spills[k]] == -2 {
            fixed = append(fixed, spills[k])
        } else if e.pfix[spills[k]] == -3 {
            rest2 = append(rest2, spills[k])
        } else {
            rest = append(rest, spills[k])
        }
    }
    for k <- iter.Range(e.npc0, e.npc) {
        if e.pfix[k] >= 0 {
            xPrioPlace(mut e, mut used, e.pfix[k], k)
        } else if e.pfix[k] == -2 {
            fixed = append(fixed, k)
        } else {
            rest2 = append(rest2, k)
        }
    }
    nr1 := len(rest)
    xPrioSort(mut e, mut rest, nr1)
    nr2 := len(rest2)
    xPrioSort(mut e, mut rest2, nr2)
    for k <- iter.Range(0, nr2) {
        rest = append(rest, rest2[k])
    }
    nr := len(rest)
    mut free := mut []int{}
    xFill(mut free, 32, 0)
    mut nsp := 0
    for k <- iter.Range(0, len(fixed)) {
        spills[nsp] = fixed[k]
        nsp += 1
    }
    for k <- iter.Range(0, nr) {
        v := rest[k]
        r := xPrioPick(mut e, mut free, v)
        if r >= 0 {
            xPrioPlace(mut e, mut used, r, v)
        } else {
            spills[nsp] = v
            nsp += 1
        }
    }
    return nsp
}

// xPrioPlace は部分区間 v をレジスタ r に置き、r の列へ入れる
func xPrioPlace(e mut xF, used mut []int, r int, v int) {
    e.loc[v] = xLocReg(r)
    used[r] = 1
    if e.aN[r] == e.aC[r] {
        // 満杯: 末尾へ倍の枠を取り、写して付け替える（古い枠は捨てる — 総量は O(区間の数)）
        nb := len(e.aL)
        for j <- iter.Range(0, 2 * e.aC[r]) {
            e.aL = append(e.aL, 0)
        }
        for j <- iter.Range(0, e.aN[r]) {
            e.aL[nb + j] = e.aL[e.aB[r] + j]
        }
        e.aB[r] = nb
        e.aC[r] = 2 * e.aC[r]
    }
    xPrioInsert(mut e, r, v)
}

// xPrioPick は部分区間 v のレジスタ（無ければ -1）: 空きの判定は「重ならない」— xHintReg の free の口をこの部分区間で作り、ヒント → 空きの最初。
// float のクラスは xmm の組・他は汎用の組（組をまたがない）
// 汎用の組（呼び出し規約の段 1）: 呼び出しを跨ぐ部分区間は callee-saved の 5 本だけ・跨がない部分区間は caller-saved の 5 本を先に
// （xAllocReg の後ろ 5 本 → 前 5 本。入口で退避しなくて済む）
func xPrioPick(e mut xF, free mut []int, v int) int {
    fl := e.fcls[e.pv[v]] == 1
    cross := !fl && xCrossCall(mut e, v)
    // 冷たい呼び出しだけを跨ぐ部分区間は 10 本ぜんぶ（callee-saved を先に — 冷たい呼び出しが毎反復走る形で退避の往復を払わないように）
    ccold := !fl && !cross && xCrossCold(mut e, v)
    n := if fl { e.nx } else if cross { xNCallee } else { xNAlloc }
    for j <- iter.Range(0, 32) {
        free[j] = 0
    }
    for j <- iter.Range(0, n) {
        r := if fl { xXmmReg(j) } else { xAllocReg(j) }
        free[r] = if xPrioFits(mut e, r, v) { 1 } else { 0 }
    }
    mut r := xHintReg(mut e, v, mut free)
    // 段 3: ヒントの無い部分区間は、まだ割り当てていないレジスタ引数が重なる区間で待っている引数レジスタを後回しにする
    // （先に取ると引数が入口で写される — スタックで来た引数が r8 / r9 を先に取っていた）
    mut wait := if r < 0 && !fl { xArgWait(mut e, v) } else { 0 }
    // 予約（一段目だけ — 区間の便 段 1 R1）: 辺の実引数を先に置いたレジスタは、行き先の仮引数がまだ置かれていなければその仮引数のために後回しにする。
    // 運搬値の更新値（重い）が仮引数より先に置かれ、穴で縮んだ別の仮引数がヒントの無いまま空きの最初として取ると、仮引数どうしの置き場が
    // 辺で 1 つずつずれて戻り辺の並行コピーが環になる（mandelbrot の xmm の φ 4 本 — report-522 2.2 (S-a)）
    if r < 0 && len(free) > 32 && free[64] != 0 {
        for j <- iter.Range(0, 32) {
            if (free[64] >> j & 1) == 1 && free[32 + j] - 1 != e.pv[v] {
                wait = wait | (1 << j)
            }
        }
    }
    for pass <- iter.Range(0, if wait == 0 { 1 } else { 2 }) {
        for j <- iter.Range(0, n) {
            rj := if fl { xXmmReg(j) } else if cross || ccold { xAllocReg(j) } else { xAllocReg((j + xNCallee) % xNAlloc) }
            if r < 0 && free[rj] == 1 && (pass == 1 || (wait >> rj & 1) == 0) {
                r = rj
            }
        }
    }
    return r
}

// xArgWait は部分区間 v と重なる未割り当てのレジスタ引数（入口の部分区間）がヒントにしている引数レジスタの組（ビット = レジスタの番号）
func xArgWait(e mut xF, v int) int {
    mut m := 0
    for k <- iter.Range(0, e.nreg) {
        if k != v && e.loc[k] == xSpill && e.ivS[k] >= 0 && (e.ivS[v] == e.ivS[k] || (e.ivS[v] < e.ivE[k] && e.ivS[k] < e.ivE[v])) {
            m = m | (1 << xArgReg(k))
        }
    }
    return m
}

// xPrioFits はレジスタ r に割り当て済みの区間のどれとも v が重ならないか（重なり = s < 終わり かつ 開始 < t・または同じ点で始まる —
// 点の区間どうし・使われない仮引数の入口など）。開始で並んだ列の二分探索で、開始 ≤ s の最後と開始 > s の最初だけを見る
func xPrioFits(e mut xF, r int, v int) bool {
    s := e.ivS[v]
    t := e.ivE[v]
    n := e.aN[r]
    base := e.aB[r]
    // lo = 開始 > s の最初の添字
    mut lo := 0
    mut hi := n
    while lo < hi {
        m := (lo + hi) / 2
        if e.ivS[e.aL[base + m]] <= s {
            lo = m + 1
        } else {
            hi = m
        }
    }
    if lo > 0 {
        w := e.aL[base + lo - 1]
        if e.ivS[w] == s || s < e.ivE[w] {
            return false
        }
    }
    if lo < n {
        w := e.aL[base + lo]
        if e.ivS[w] < t {
            return false
        }
    }
    return true
}

// xPrioInsert はレジスタ r の列へ v を開始の順に入れる
func xPrioInsert(e mut xF, r int, v int) {
    base := e.aB[r]
    mut k := e.aN[r]
    while k > 0 && e.ivS[e.aL[base + k - 1]] > e.ivS[v] {
        e.aL[base + k] = e.aL[base + k - 1]
        k -= 1
    }
    e.aL[base + k] = v
    e.aN[r] = e.aN[r] + 1
}

// xPrioSort は ivs の先頭 n 個を費用の高い順に（同点は区間の長い順・値の番号の小さい順 — 決定的）並べる（下からの併合ソート）
func xPrioSort(e mut xF, a mut []int, n int) {
    mut tmp := mut []int{}
    xFill(mut tmp, n, 0)
    mut w := 1
    while w < n {
        mut lo := 0
        while lo < n {
            mid := if lo + w < n { lo + w } else { n }
            hi := if lo + 2 * w < n { lo + 2 * w } else { n }
            mut i := lo
            mut j := mid
            mut k := lo
            while k < hi {
                takeLeft := j >= hi || (i < mid && !xPrioBefore(mut e, a[j], a[i]))
                if takeLeft {
                    tmp[k] = a[i]
                    i += 1
                } else {
                    tmp[k] = a[j]
                    j += 1
                }
                k += 1
            }
            lo = hi
        }
        for k <- iter.Range(0, n) {
            a[k] = tmp[k]
        }
        w = w * 2
    }
}

// xPrioBefore は x が y より先に彩色されるか
func xPrioBefore(e mut xF, x int, y int) bool {
    wx := e.pwt[x]
    wy := e.pwt[y]
    if wx != wy {
        return wx > wy
    }
    lx := e.ivE[x] - e.ivS[x]
    ly := e.ivE[y] - e.ivS[y]
    if lx != ly {
        return lx > ly
    }
    return x < y
}

// ── 割り当て（ir_x86_ra.allocate の linear scan）。フレームの最も低い変位を返す ──

// xAllocRegs は部分区間をレジスタへ割り当てる（spill した部分区間を spills へ・使ったレジスタを used へ — 一段目。二段目は xPrioRealloc）
func xAllocRegs(st mut St, e mut xF, used mut []int, spills mut []int) int {
    nv := e.npc
    xFill(mut e.loc, nv, xSpill)
    // 区間を持つ部分区間を (start, 番号) の順に（数え上げの安定な並べ替え）
    mut maxp := 0
    for v <- iter.Range(0, nv) {
        if e.ivS[v] >= 0 && e.ivS[v] > maxp {
            maxp = e.ivS[v]
        }
    }
    mut cnt := mut []int{}
    xFill(mut cnt, maxp + 2, 0)
    mut nivs := 0
    for v <- iter.Range(0, nv) {
        if e.ivS[v] >= 0 {
            cnt[e.ivS[v] + 1] = cnt[e.ivS[v] + 1] + 1
            nivs += 1
        }
    }
    for k <- iter.Range(0, maxp + 1) {
        cnt[k + 1] = cnt[k + 1] + cnt[k]
    }
    mut ivs := mut []int{}
    xFill(mut ivs, nivs, 0)
    for v <- iter.Range(0, nv) {
        if e.ivS[v] >= 0 {
            ivs[cnt[e.ivS[v]]] = v
            cnt[e.ivS[v]] = cnt[e.ivS[v]] + 1
        }
    }
    // 空き（割り当て順の添字）・使った・生きている区間
    mut free := mut []int{}
    xFill(mut free, 16, 0)
    for k <- iter.Range(0, xNAlloc) {
        free[xAllocReg(k)] = 1
    }
    mut active := mut []int{}
    xFill(mut active, xNAlloc + 1, 0)
    mut na := 0
    mut nsp := 0
    if e.opt {
        // 最適化のバックエンド: 費用の高い順の彩色（第二便 M8 — xPrioAlloc）
        nsp = xPrioAlloc(mut st, mut e, mut ivs, nivs, mut used, mut spills)
    }
    for k <- iter.Range(0, if e.opt { 0 } else { nivs }) {
        v := ivs[k]
        cs := e.ivS[v]
        // 終わった区間のレジスタを返す（end ≤ start — 同じ位置の受け渡しを許す。swapRemove と同じ並びの変化）
        mut i := 0
        while i < na {
            w := active[i]
            if e.ivE[w] <= cs {
                free[xLocVal(e.loc[w])] = 1
                active[i] = active[na - 1]
                na -= 1
            } else {
                i += 1
            }
        }
        mut r := if e.opt { xHintReg(mut e, v, mut free) } else { -1 }
        for j <- iter.Range(0, xNAlloc) {
            if r < 0 && free[xAllocReg(j)] == 1 {
                r = xAllocReg(j)
            }
        }
        if r >= 0 {
            free[r] = 0
            used[r] = 1
            e.loc[v] = xLocReg(r)
            active[na] = v
            na += 1
        } else {
            // 空きが無い: end がいちばん遠い区間を落とす（同点は値の番号の大きい方）。opt は spill の費用の最も安い区間（同点は end の遠い方）
            mut far := v
            for j <- iter.Range(0, na) {
                w := active[j]
                if e.opt {
                    cw := xSpillCost(mut e, w)
                    cf := xSpillCost(mut e, far)
                    if cw < cf || (cw == cf && e.ivE[w] > e.ivE[far]) {
                        far = w
                    }
                } else if e.ivE[w] > e.ivE[far] || (e.ivE[w] == e.ivE[far] && w > far) {
                    far = w
                }
            }
            if far == v {
                e.loc[v] = xSpill
                spills[nsp] = v
                nsp += 1
            } else {
                e.loc[v] = e.loc[far]
                e.loc[far] = xSpill
                spills[nsp] = far
                nsp += 1
                for j <- iter.Range(0, na) {
                    if active[j] == far {
                        active[j] = v
                    }
                }
            }
        }
    }
    return nsp
}

// xAllocFrame は割り当ての結果からフレームを組む（退避するレジスタ・spill 先の変位・区間を持たない値の番地 — 1 回だけ）
func xAllocFrame(st mut St, e mut xF, frameTop int, used mut []int, spills mut []int, nsp int) int {
    nv := e.npc
    // 値を載せる xmm の和（段 6 P4-6 — 切替と罠が積む組。下の scanb の作業の退避は値を載せないので入れない）
    for k <- iter.Range(2, 16) {
        if used[xX0 + k] == 1 {
            st.xXmm = st.xXmm | (1 << k)
        }
    }
    // 割り当てに使わなくても壊すレジスタも退避する: スロットのゼロ初期化の rdi と syscall の引数レジスタ（rdx は割り当てない）。
    // opt の規約（呼び出し規約の段 1）ではどちらも caller-saved なので退避しない
    if !e.opt && xfSHead(mut st, e.f) >= 0 {
        used[x86.Rdi] = 1
    }
    // scanb は xmm0〜7 を作業に使う — 呼び手が xmm2〜7 に値を置く（scanb を含まない関数の広い組 — xNXmmWide）ので、壊す分を退避する
    if e.opt && e.nx == xNXmm && xHasScanB(mut st, mut e) {
        for k <- iter.Range(2, 8) {
            used[xX0 + k] = 1
        }
    }
    sysRegs := []int{x86.Rdi, x86.Rsi, x86.Rdx, x86.R10, x86.R8, x86.R9}
    for bi <- iter.Range(0, if e.opt { 0 } else { e.nb }) {
        mut i := xbIHead(mut st, BlkRef(e.blk[bi]))
        while i != -1 {
            if xiOp(mut st, i) == OpSyscall {
                for k <- iter.Range(0, xLen(mut st, xiA(mut st, i)) - 1) {
                    if sysRegs[k] != x86.Rdx {
                        used[sysRegs[k]] = 1
                    }
                }
            }
            i = xiNext(mut st, i)
        }
    }
    // フレーム: [frameTop) の下に退避域、その下に spill
    mut d := frameTop
    for k <- iter.Range(0, xNAlloc + xNXmmWide) {
        r := if k < xNAlloc { xAllocReg(k) } else { xXmmReg(k - xNAlloc) }
        if used[r] == 1 && (!e.opt || k >= xNAlloc || xCalleeSaved(r)) {
            d = d - 8
            e.saveReg = append(e.saveReg, r)
            e.saveDisp = append(e.saveDisp, d)
            e.nsave = e.nsave + 1
        }
    }
    // 冷たい呼び出しの退避（report-462 (c)）: 位置ごとに、割り当てた部分区間が真に含む（s < 位置 < t）caller-saved の組。枠はレジスタごとに 1 つ
    xFill(mut e.cpm, len(e.cpc), 0)
    xFill(mut e.csd, 16, 0)
    for k <- iter.Range(0, if len(e.cpc) > 0 { nv } else { 0 }) {
        l := e.loc[k]
        if e.ivS[k] >= 0 && xIsReg(l) && xLocVal(l) < 16 && !xCalleeSaved(xLocVal(l)) {
            r := xLocVal(l)
            mut j := xFirstAfter(mut e.cpc, len(e.cpc), e.ivS[k])
            while j < len(e.cpc) && e.cpc[j] < e.ivE[k] {
                e.cpm[j] = e.cpm[j] | (1 << r)
                if e.csd[r] == 0 {
                    d = d - 8
                    e.csd[r] = d
                }
                j += 1
            }
        }
    }
    // spill 先は値ごとに 1 つ（同じ値の部分区間で共有 — 最初に spill された部分区間の順に変位を配る）。opt は合流した値の組で 1 つ（xSpillJoin）
    xFill(mut e.spd, e.nv, 0)
    if e.opt && nsp > 0 {
        xSpillJoin(mut st, mut e)
    }
    for k <- iter.Range(0, nsp) {
        u := e.pv[spills[k]]
        if u < e.np && u >= e.nreg {
            e.loc[spills[k]] = xLocFrame(xParamHome(mut e, u))
        } else {
            // 正の spd = 合流の群の代表の値 + 1（xSpillJoin — 変位は代表の欄に配る）
            g := if e.spd[u] > 0 { e.spd[u] - 1 } else { u }
            if e.spd[g] == 0 {
                d = d - 8
                e.spd[g] = d
            }
            e.loc[spills[k]] = xLocFrame(e.spd[g])
        }
    }
    // 区間を持たない値（到達しないブロックでだけ定義）は使われない — 番地は有効にしておく
    for v <- iter.Range(0, nv) {
        if e.loc[v] == xSpill {
            u := e.pv[v]
            e.loc[v] = if u < e.np && u >= e.nreg { xLocFrame(xParamHome(mut e, u)) } else { xLocFrame(frameTop - 8) }
        }
    }
    return if d < frameTop - 8 { d } else { frameTop - 8 }
}

// xSpillJoin は spill 先の合流（置き場の往復レーン 段 4a — opt）: 辺の実引数と行き先の仮引数がどちらも spill 先を持ち、区間（全部の部分区間 —
// レジスタに置いたものも）が重ならないなら同じ spill 先を配る — 辺の写しが「同じ置き場」になり xParallelMove が出さない。
// 結果は e.spd に書く: 代表でない群の値 v は spd[v] = 代表の値 + 1（正 — 変位は負なので混ざらない。xAllocFrame が代表の欄に変位を配る）。
// 作業域は組に出る値だけ（関数の値の数に比例する表を作らない — 自己 build の仕事）。レジスタの部分区間も数えるのは、割れた値の spill 先がそこでも値を持つ
// 前提（xSlotValid — 覆われたブロックの終わりだけで引き継ぐ）があるから。部分区間の間の穴（運搬値の穴・本体と末尾の区画の間）は値が死んで
// いるので数えない。辺の写しが仮引数の置き場へ書く点（前任の終わり）は仮引数の区間の外だが、そこで値が要る別の値は行き先の入口で生きている
// （仮引数と区間が重なる）ので群に入らない — レジスタの共有（xLive の opt の注）と同じ理屈。同じ辺の読み元と書き先が同じ置き場になる組は
// xParallelMove が置き場の単位で順序を付ける。割り当て（どの値がレジスタに載るか）は変えない
func xSpillJoin(st mut St, e mut xF) {
    // 候補の組（辺の実引数, 仮引数）— 深いループの辺から併せる
    mut pa := mut []int{}
    mut pb := mut []int{}
    mut pd := mut []int{}
    mut maxd := 0
    for k <- iter.Range(0, e.norder) {
        b := BlkRef(e.blk[e.order[k]])
        t := xbTerm(mut st, b)
        dk := if k < len(e.ldep) { e.ldep[k] } else { 0 }
        for j <- iter.Range(0, xNSucc(mut st, b)) {
            to := if t == TmBr { xbBrTo(mut st, b) } else if j == 0 { xbThen(mut st, b) } else { xbElse(mut st, b) }
            args := if t == TmBr { xTermX(mut st, b, 2) } else if j == 0 { xTermX(mut st, b, 3) } else { xTermX(mut st, b, 5) }
            mut n := 0
            mut p := xbPHead(mut st, to)
            while p >= 0 {
                pv := xParamVal(mut st, p)
                a := xAt(mut st, args, n)
                if a != pv && a >= e.np && pv >= e.np && e.remat[a] == 0 && xHasSpill(mut e, a) && xHasSpill(mut e, pv) {
                    pa = append(pa, a)
                    pb = append(pb, pv)
                    pd = append(pd, dk)
                    if dk > maxd {
                        maxd = dk
                    }
                }
                n += 1
                p = xParamNext(mut st, p)
            }
        }
    }
    if len(pa) == 0 {
        return
    }
    // 組に出る値を詰めた番号へ（spd を作業域に — 0 = 未登録・i + 1 = 番号 i）
    mut vs := mut []int{}
    for k <- iter.Range(0, len(pa)) {
        for q <- iter.Range(0, 2) {
            x := if q == 0 { pa[k] } else { pb[k] }
            if e.spd[x] == 0 {
                vs = append(vs, x)
                e.spd[x] = len(vs)
            }
        }
    }
    mut oa := mut []int{}
    mut ob := mut []int{}
    mut d := maxd
    while d >= 0 {
        for k <- iter.Range(0, len(pa)) {
            if pd[k] == d {
                oa = append(oa, e.spd[pa[k]] - 1)
                ob = append(ob, e.spd[pb[k]] - 1)
            }
        }
        d -= 1
    }
    vsF := freeze(vs)
    rep := xJoinSlots(mut e.ivS, mut e.ivE, mut e.pnx, vsF, freeze(oa), freeze(ob))
    for i <- iter.Range(0, len(vsF)) {
        e.spd[vsF[i]] = if rep[i] != i { vsF[rep[i]] + 1 } else { 0 }
    }
}

// xHasSpill は値 v の部分区間のどれかが spill されたか（xAllocFrame が変位を配る前 — 置き場が xSpill のまま）
func xHasSpill(e mut xF, v int) bool {
    mut q := v
    while q >= 0 {
        if e.ivS[q] >= 0 && e.loc[q] == xSpill {
            return true
        }
        q = e.pnx[q]
    }
    return false
}

// xJoinSlots は組 (pa[k], pb[k])（詰めた番号 — 番号 i の値は vs[i]）を順に併せる: 両方の群のどの 2 値の区間も重ならないときだけ。値 v の
// 区間 = 部分区間の鎖（v から pnx を辿る・始まり ivS / 終わり ivE・始まりが負なら無し）。重なり = xPrioFits と同じ（始まり < 相手の終わり
// かつ 相手の始まり < 終わり・または同じ点で始まる）。群は 16 値まで（判定の仕事を抑える）。返り値 = 番号 → 群の代表の番号（併せない値は自身）
func xJoinSlots(ivS mut []int, ivE mut []int, pnx mut []int, vs []int, pa []int, pb []int) []int {
    n := len(vs)
    mut rep := mut []int{}
    mut nxt := mut []int{}
    mut sz := mut []int{}
    for i <- iter.Range(0, n) {
        rep = append(rep, i)
        nxt = append(nxt, -1)
        sz = append(sz, 1)
    }
    for k <- iter.Range(0, len(pa)) {
        ra := rep[pa[k]]
        rb := rep[pb[k]]
        if ra != rb && sz[ra] + sz[rb] <= 16 {
            mut ok := true
            mut x := ra
            while ok && x >= 0 {
                mut y := rb
                while ok && y >= 0 {
                    if xIvMeet(mut ivS, mut ivE, mut pnx, vs[x], vs[y]) {
                        ok = false
                    }
                    y = nxt[y]
                }
                x = nxt[x]
            }
            if ok {
                // rb の群を ra の群の後ろへ（代表は ra）
                mut last := ra
                while nxt[last] >= 0 {
                    last = nxt[last]
                }
                nxt[last] = rb
                mut y := rb
                while y >= 0 {
                    rep[y] = ra
                    y = nxt[y]
                }
                sz[ra] = sz[ra] + sz[rb]
            }
        }
    }
    return freeze(rep)
}

// xIvMeet は値 x と y の部分区間のどれかが重なるか（xJoinSlots）
func xIvMeet(ivS mut []int, ivE mut []int, pnx mut []int, x int, y int) bool {
    mut p := x
    while p >= 0 {
        if ivS[p] >= 0 {
            mut q := y
            while q >= 0 {
                if ivS[q] >= 0 && (ivS[p] == ivS[q] || (ivS[p] < ivE[q] && ivS[q] < ivE[p])) {
                    return true
                }
                q = pnx[q]
            }
        }
        p = pnx[p]
    }
    return false
}

// ── 値の出し入れ（置き場を問わない）──

// xLocAt は位置 p での v の置き場（v の部分区間のうち p で生きているもの — 鎖を開始の順に辿り、終わり ≥ p の最初）。
// 命令の被演算子と結果は e.pos・終端と辺の読み元はブロックの終わり・辺の書き先は行き先のブロックの頭で引く
func xLocAt(e mut xF, v int, p int) int {
    return if e.pnx[v] < 0 { e.loc[v] } else { xLocWalk(mut e, v, p) }
}

func xLocWalk(e mut xF, v int, p int) int {
    mut k := v
    while e.pnx[k] >= 0 && e.ivE[k] < p {
        k = e.pnx[k]
    }
    return e.loc[k]
}

// xGet は v をレジスタに載せる（置き場がレジスタならそれ、フレームなら scratch に読む）
func xGet(e mut xF, c mut table.Table[byte], v int, scratch int) int {
    l := if e.remat[v] == 0 { xLocAt(mut e, v, e.pos) } else { 0 }
    if xIsGpr(l) {
        return xLocVal(l)
    }
    // ここから先は scratch へ書く。scratch がまだ v を持つなら書かない（直前の xPut の読み元 — 段 4a の E・白名簿の間の覚え書き — 段 B の D1）
    if xMemoHit(mut e, scratch, v, x86.Here(mut c)) {
        return scratch
    }
    if e.remat[v] == 1 {
        x86.MovRegImm32(mut c, scratch, e.constV[v])
    } else if e.remat[v] == 2 {
        x86.LeaRegMem(mut c, scratch, x86.Rbp, e.slotDisp[e.constV[v]])
    } else if xIsXmm(l) {
        // float のクラスの値を汎用の口で読む（ビット列 — movq）
        x86.MovqRX(mut c, scratch, xLocVal(l) - xX0)
    } else {
        x86.MovRegMem(mut c, scratch, x86.Rbp, xLocVal(l))
    }
    return scratch
}

// xMemoHit は scratch の r がまだ v を持つか（直前の xPut の読み元が r で、表の位置 at から何も吐いていない・白名簿の命令の間の覚え書き）。
// r は以後 v を持つ（呼び手が書く）と記す
func xMemoHit(e mut xF, r int, v int, at int) bool {
    hit := xPutLive(mut e, v, at) && e.putR == r || e.memOn && xMemoOf(mut e, r) == v
    xMemoSet(mut e, r, v)
    return hit
}

// xMemoOf は scratch の r（rax / rcx / rdx）が持つ値（-1 = 無し・覚え書きの外のレジスタも -1）
func xMemoOf(e mut xF, r int) int {
    return if r == x86.Rax { e.mA } else if r == x86.Rcx { e.mC } else if r == x86.Rdx { e.mD } else { -1 }
}

// xMemoSet は r が v を持つと記す（白名簿の命令の外では -1 — 外の吐き方の書き込みは追わない）
func xMemoSet(e mut xF, r int, v int) {
    w := if e.memOn { v } else { -1 }
    if r == x86.Rax {
        e.mA = w
    } else if r == x86.Rcx {
        e.mC = w
    } else if r == x86.Rdx {
        e.mD = w
    }
}

func xMemoClear(e mut xF) {
    e.mA = -1
    e.mC = -1
    e.mD = -1
}

// xMemoOp は命令 i が覚え書きの白名簿にあるか: 定数・load / store（番地の融合も含む）・番地を出さない gep / slotaddr。
// これらの吐き方が scratch を書くのは xGet（覚え書きを更新する）と、結果を xPut へ渡す直前の書き先（xPut が覚え書きを更新する）だけ
func xMemoOp(st mut St, e mut xF, i InsRef) bool {
    op := xiOp(mut st, i)
    res := xiRes(mut st, i)
    return op == OpConst || op == OpLoad || op == OpLoad8 || op == OpStore || op == OpStore8 || (op == OpGepW || op == OpGepB) && e.fold[res] == 1 || op == OpSlotaddr && e.remat[res] == 2
}

// xPutLive は v が直前の xPut でフレームへ store したばかりで、その後に何も吐いていない（読み元のレジスタに v が残っている）か
func xPutLive(e mut xF, v int, at int) bool {
    return e.putAt >= 0 && e.putV == v && e.putAt == at
}

// xGetInto は v を dst へ
func xGetInto(e mut xF, c mut table.Table[byte], v int, dst int) {
    if e.remat[v] == 1 {
        x86.MovRegImm32(mut c, dst, e.constV[v])
        return
    }
    if e.remat[v] == 2 {
        x86.LeaRegMem(mut c, dst, x86.Rbp, e.slotDisp[e.constV[v]])
        return
    }
    l := xLocAt(mut e, v, e.pos)
    if xIsXmm(l) {
        x86.MovqRX(mut c, dst, xLocVal(l) - xX0)
    } else if xIsReg(l) {
        // xPut がレジスタへ写した直後で、写しの読み元が dst なら dst はまだ v を持つ（段 A — report-508 R2）
        if xLocVal(l) != dst && !(xPutLive(mut e, v, x86.Here(mut c)) && e.putR == dst) {
            x86.MovRegReg(mut c, dst, xLocVal(l))
        }
    } else if xPutLive(mut e, v, x86.Here(mut c)) {
        if e.putR != dst {
            x86.MovRegReg(mut c, dst, e.putR)
        }
    } else {
        x86.MovRegMem(mut c, dst, x86.Rbp, xLocVal(l))
    }
}

// xPut は src にある結果を v の置き場へ
func xPut(e mut xF, c mut table.Table[byte], v int, src int) {
    xMemoSet(mut e, src, v)
    l := xLocAt(mut e, v, e.pos)
    if xIsXmm(l) {
        x86.MovqXR(mut c, xLocVal(l) - xX0, src)
        return
    }
    if !xIsReg(l) {
        x86.MovMemReg(mut c, x86.Rbp, xLocVal(l), src)
    } else if xLocVal(l) != src {
        x86.MovRegReg(mut c, xLocVal(l), src)
    } else {
        return
    }
    // 直後の読みは src を使える（フレーム — 段 4a の E・レジスタ — 段 A の R2）
    if e.opt && src < 16 {
        e.putV = v
        e.putR = src
        e.putAt = x86.Here(mut c)
    }
}

func xCond(op int) int {
    return if op == CEq { x86.CondE } else if op == CNe { x86.CondNe } else if op == CLt { x86.CondL } else if op == CLe { x86.CondLe } else if op == CGt { x86.CondG } else if op == CGe { x86.CondGe } else if op == CUlt { x86.CondB } else { x86.CondAe }
}

func xInst(st mut St, e mut xF, c mut table.Table[byte], fx mut table.Table[int], i InsRef, frecs []int, grecs []int) {
    op := xiOp(mut st, i)
    res := xiRes(mut st, i)
    a := xiA(mut st, i)
    b := xiB(mut st, i)
    cc := xiC(mut st, i)
    if op == OpConst && e.remat[res] == 1 {
        // 使う点で作り直す（M5）
    } else if op == OpConst {
        if a >= -2147483648 && a <= 2147483647 {
            l := xLocAt(mut e, res, e.pos)
            if xIsXmm(l) {
                x86.MovRegImm32(mut c, x86.Rax, a)
                xPut(mut e, mut c, res, x86.Rax)
            } else if xIsReg(l) {
                x86.MovRegImm32(mut c, xLocVal(l), a)
            } else {
                x86.MovMemImm32(mut c, x86.Rbp, xLocVal(l), a)
            }
        } else {
            x86.MovRegImm64(mut c, x86.Rax, a)
            xPut(mut e, mut c, res, x86.Rax)
        }
    } else if op == OpBin && e.fuse[res] == 3 {
        // and の結果は比較にしか使われない — test で flags だけ立てる（xFuseScan）
        x86.TestRegImm(mut c, xGet(mut e, mut c, b, x86.Rax), e.constV[cc])
    } else if op == OpBin && a >= BFAdd && a <= BFToInt {
        xFloatBin(mut e, mut c, res, a, b, cc)
    } else if op == OpCmp && a >= CFEq {
        xFloatCmp(mut e, mut c, res, a, b, cc)
    } else if op == OpBin {
        if a == BDiv || a == BRem {
            xDivRem(mut e, mut c, res, a, b, cc)
        } else if a == BMulHi {
            // mul r64（rdx:rax = rax × r — 符号なし）の上位 = rdx（rax / rcx / rdx は割り当てない scratch — xDivRem と同じ）
            xGetInto(mut e, mut c, b, x86.Rax)
            xGetInto(mut e, mut c, cc, x86.Rcx)
            x86.MulReg(mut c, x86.Rcx)
            xPut(mut e, mut c, res, x86.Rdx)
        } else if a == BShl || a == BSar {
            xGetInto(mut e, mut c, b, x86.Rax)
            xGetInto(mut e, mut c, cc, x86.Rcx)
            if a == BShl {
                x86.ShlRegCl(mut c, x86.Rax)
            } else {
                x86.SarRegCl(mut c, x86.Rax)
            }
            xPut(mut e, mut c, res, x86.Rax)
        } else if e.opt && xDirectBin(mut e, mut c, res, a, b, cc) {
            // 結果のレジスタへ直に（rax を経由しない — 最適化のバックエンド）
        } else {
            xGetInto(mut e, mut c, b, x86.Rax)
            y := xGet(mut e, mut c, cc, x86.Rcx)
            if a == BAdd {
                x86.AddRegReg(mut c, x86.Rax, y)
            } else if a == BSub {
                x86.SubRegReg(mut c, x86.Rax, y)
            } else if a == BMul {
                x86.ImulRegReg(mut c, x86.Rax, y)
            } else if a == BAnd {
                x86.AndRegReg(mut c, x86.Rax, y)
            } else if a == BOr {
                x86.OrRegReg(mut c, x86.Rax, y)
            } else {
                x86.XorRegReg(mut c, x86.Rax, y)
            }
            xPut(mut e, mut c, res, x86.Rax)
        }
    } else if op == OpCmp && e.opt && e.fuse[res] == 2 {
        // flags は手前の add / sub / and（test）が立てた（xFuseScan）
        e.fcc = xCond(a)
    } else if op == OpCmp && e.opt {
        x := xGet(mut e, mut c, b, x86.Rax)
        if e.isConst[cc] == 1 && e.constV[cc] >= -2147483648 && e.constV[cc] <= 2147483647 {
            x86.CmpRegImm(mut c, x, e.constV[cc])
        } else {
            y := xGet(mut e, mut c, cc, x86.Rcx)
            x86.CmpRegReg(mut c, x, y)
        }
        if e.fuse[res] == 1 {
            e.fcc = xCond(a)
        } else {
            x86.SetccAl(mut c, xCond(a))
            x86.MovzxRaxAl(mut c)
            xPut(mut e, mut c, res, x86.Rax)
        }
    } else if op == OpCmp {
        x := xGet(mut e, mut c, b, x86.Rax)
        y := xGet(mut e, mut c, cc, x86.Rcx)
        x86.CmpRegReg(mut c, x, y)
        x86.SetccAl(mut c, xCond(a))
        x86.MovzxRaxAl(mut c)
        xPut(mut e, mut c, res, x86.Rax)
    } else if (op == OpGepW || op == OpGepB) && e.fold[res] == 1 {
        // 使う load / store が番地を組む（M7）
    } else if op == OpLoad && e.opt && xIsXmm(xLocAt(mut e, res, e.pos)) && e.fold[a] == 1 {
        // float の値は xmm へ直に（1.0× アタック便 — movq の往復を省く）
        xMemSibX(mut e, mut c, a, 8 * b, xLocVal(xLocAt(mut e, res, e.pos)) - xX0, true)
    } else if op == OpLoad && e.opt && xIsXmm(xLocAt(mut e, res, e.pos)) {
        p := xGet(mut e, mut c, a, x86.Rax)
        x86.MovsdXMem(mut c, xLocVal(xLocAt(mut e, res, e.pos)) - xX0, p, 8 * b)
    } else if op == OpStore && e.opt && e.remat[cc] == 0 && xIsXmm(xLocAt(mut e, cc, e.pos)) && e.fold[a] == 1 {
        xMemSibX(mut e, mut c, a, 8 * b, xLocVal(xLocAt(mut e, cc, e.pos)) - xX0, false)
    } else if op == OpStore && e.opt && e.remat[cc] == 0 && xIsXmm(xLocAt(mut e, cc, e.pos)) {
        p := xGet(mut e, mut c, a, x86.Rax)
        x86.MovsdMemX(mut c, p, 8 * b, xLocVal(xLocAt(mut e, cc, e.pos)) - xX0)
    } else if (op == OpLoad || op == OpLoad8) && e.fold[a] == 1 {
        d := if xIsGpr(xLocAt(mut e, res, e.pos)) { xLocVal(xLocAt(mut e, res, e.pos)) } else { x86.Rax }
        xMemSib(mut e, mut c, a, if op == OpLoad { 8 * b } else { b }, d, op == OpLoad8, true)
        xPut(mut e, mut c, res, d)
    } else if (op == OpStore || op == OpStore8) && e.fold[a] == 1 {
        v := xGet(mut e, mut c, cc, x86.Rdx)
        xMemSib(mut e, mut c, a, if op == OpStore { 8 * b } else { b }, v, op == OpStore8, false)
    } else if (op == OpLoad || op == OpStore) && e.opt && (e.remat[a] == 2 || (op == OpStore && e.remat[cc] == 1)) {
        // 番地がスロット（remat 2）なら [rbp + 変位] を直に・値が imm32 の定数（remat 1）なら mov [番地], imm32（段 6 P4-6 — lea / mov imm の往復を省く）
        mut base := x86.Rbp
        mut disp := 8 * b
        if e.remat[a] == 2 {
            disp = e.slotDisp[e.constV[a]] + 8 * b
        } else {
            base = xGet(mut e, mut c, a, x86.Rax)
        }
        if op == OpLoad {
            l := xLocAt(mut e, res, e.pos)
            d := if xIsGpr(l) { xLocVal(l) } else { x86.Rax }
            x86.MovRegMem(mut c, d, base, disp)
            xPut(mut e, mut c, res, d)
        } else if e.remat[cc] == 1 {
            x86.MovMemImm32(mut c, base, disp, e.constV[cc])
        } else {
            v := xGet(mut e, mut c, cc, x86.Rcx)
            x86.MovMemReg(mut c, base, disp, v)
        }
    } else if op == OpLoad && e.opt && xIsGpr(xLocAt(mut e, res, e.pos)) {
        p := xGet(mut e, mut c, a, x86.Rax)
        x86.MovRegMem(mut c, xLocVal(xLocAt(mut e, res, e.pos)), p, 8 * b)
    } else if op == OpLoad {
        p := xGet(mut e, mut c, a, x86.Rax)
        x86.MovRegMem(mut c, x86.Rax, p, 8 * b)
        xPut(mut e, mut c, res, x86.Rax)
    } else if op == OpStore {
        p := xGet(mut e, mut c, a, x86.Rax)
        v := xGet(mut e, mut c, cc, x86.Rcx)
        x86.MovMemReg(mut c, p, 8 * b, v)
    } else if op == OpLoad8 {
        p := xGet(mut e, mut c, a, x86.Rax)
        x86.MovzxRegMem8(mut c, x86.Rax, p, b)
        xPut(mut e, mut c, res, x86.Rax)
    } else if op == OpStore8 {
        p := xGet(mut e, mut c, a, x86.Rax)
        v := xGet(mut e, mut c, cc, x86.Rcx)
        x86.MovMem8Reg(mut c, p, b, v)
    } else if (op == OpGepW || op == OpGepB) && e.opt && xIsReg(xLocAt(mut e, res, e.pos)) {
        p := xGet(mut e, mut c, a, x86.Rax)
        ix := xGet(mut e, mut c, b, x86.Rcx)
        x86.LeaRegSib(mut c, xLocVal(xLocAt(mut e, res, e.pos)), p, ix, if op == OpGepW { x86.Scale8 } else { x86.Scale1 })
    } else if op == OpGepW || op == OpGepB {
        p := xGet(mut e, mut c, a, x86.Rax)
        ix := xGet(mut e, mut c, b, x86.Rcx)
        x86.LeaRegSib(mut c, x86.Rax, p, ix, if op == OpGepW { x86.Scale8 } else { x86.Scale1 })
        xPut(mut e, mut c, res, x86.Rax)
    } else if op == OpPtoi || op == OpItop {
        x := xGet(mut e, mut c, a, x86.Rax)
        xPut(mut e, mut c, res, x)
    } else if op == OpSlotaddr && e.remat[res] == 2 {
        // 使う点で作り直す（remat 2）
    } else if op == OpSlotaddr {
        x86.LeaRegMem(mut c, x86.Rax, x86.Rbp, e.slotDisp[a])
        xPut(mut e, mut c, res, x86.Rax)
    } else if op == OpGlobal {
        xAbs(mut e, mut c, mut fx, res, 2, xIndex(grecs, a))
    } else if op == OpFsAddr {
        // ワーカーの記録の表 k の番地 = fs:[8k]（段 6 P4-3）
        l := xLocAt(mut e, res, e.pos)
        r := if xIsReg(l) { xLocVal(l) } else { x86.Rax }
        x86.MovRegFs(mut c, r, 8 * xg(mut st, a + G_WSLOT))
        if !xIsReg(l) {
            xPut(mut e, mut c, res, x86.Rax)
        }
    } else if op == OpFuncaddr {
        xAbs(mut e, mut c, mut fx, res, 1, xIndex(frecs, a))
    } else if op == OpCall && e.opt && (FnRef(a) == st.rtCopy || FnRef(a) == st.rtCopy8) {
        // rt.copy（語）/ rt.copy8（バイト）の呼び出しは rep movsq / rep movsb で（1.0× アタック便 — 1 要素ずつの写しのループが ReadFile の戻り値の
        // 境界コピー〔140 MB〕等で支配的だった）。引数は scratch（rax / rdx / rcx）へ集めてから rdi / rsi へ — 割り当てに使う rdi / rsi は退避
        xGetInto(mut e, mut c, xAt(mut st, b, 0), x86.Rax)
        xGetInto(mut e, mut c, xAt(mut st, b, 1), x86.Rdx)
        xGetInto(mut e, mut c, xAt(mut st, b, 2), x86.Rcx)
        x86.PushReg(mut c, x86.Rsi)
        x86.PushReg(mut c, x86.Rdi)
        x86.MovRegReg(mut c, x86.Rdi, x86.Rax)
        x86.MovRegReg(mut c, x86.Rsi, x86.Rdx)
        if FnRef(a) == st.rtCopy {
            x86.RepMovsq(mut c)
        } else {
            x86.RepMovsb(mut c)
        }
        x86.PopReg(mut c, x86.Rdi)
        x86.PopReg(mut c, x86.Rsi)
    } else if op == OpCall && xRegCc(mut st, FnRef(a), frecs) {
        // 段 3: 5 本目以降を後ろから push・先頭 4 本は引数レジスタへ並行コピー（ここで caller-saved に載るのはこの呼び出しの実引数と結果だけ — 段 1。
        // 冷たい呼び出しは跨ぐ caller-saved を実引数の前に退避し、結果の写しの後で戻す — xColdCall）
        cm := xColdMask(mut e, e.pos)
        xColdSave(mut e, mut c, cm)
        n := xLen(mut st, b)
        nr := if n < xNArgReg { n } else { xNArgReg }
        xPushArgs(mut st, mut e, mut c, b, nr)
        for k <- iter.Range(0, nr) {
            e.mvD[k] = xLocReg(xArgReg(k))
            e.mvS[k] = xSrcLoc(mut e, xAt(mut st, b, k))
        }
        xParallelMove(mut e, mut c, nr)
        xFixAdd(mut fx, x86.CallRel32(mut c), 0, xIndex(frecs, a))
        xAfterCall(mut e, mut c, res, n - nr)
        xColdLoad(mut e, mut c, cm)
    } else if op == OpCall {
        cm := xColdMask(mut e, e.pos)
        xColdSave(mut e, mut c, cm)
        xPushArgs(mut st, mut e, mut c, b, 0)
        xFixAdd(mut fx, x86.CallRel32(mut c), 0, xIndex(frecs, a))
        xAfterCall(mut e, mut c, res, xLen(mut st, b))
        xColdLoad(mut e, mut c, cm)
    } else if op == OpCallI {
        xPushArgs(mut st, mut e, mut c, b, 0)
        xGetInto(mut e, mut c, a, x86.R11)
        x86.CallReg(mut c, x86.R11)
        xAfterCall(mut e, mut c, res, xLen(mut st, b))
    } else if op == OpTSwitch {
        xTSwitch(mut e, mut c, a, xAt(mut st, b, 0), xSaveXmm(mut st), xCtxRegs(mut e, e.pos, st.xXmm))
    } else if op == OpTStart {
        xTStart(mut e, mut c, a, xAt(mut st, b, 0), xAt(mut st, b, 1), xAt(mut st, b, 2), xSaveXmm(mut st), xCtxRegs(mut e, e.pos, st.xXmm))
    } else if op == OpTrapI {
        xTrap(mut e, mut c, mut fx, res, a, xAt(mut st, b, 0), xIndex(grecs, st.trapG), xTrapFs(mut st), xSaveXmm(mut st), xCtxRegs(mut e, e.pos, st.xXmm))
    } else if op == OpUnwind {
        xUnwind(mut c, mut fx, xIndex(grecs, st.trapG), xTrapFs(mut st), 0)
    } else if op == OpAtomic {
        xAtomic(mut st, mut e, mut c, res, a, b, xiC(mut st, i))
    } else if op == OpClone {
        xClone(mut st, mut e, mut c, res, a, b)
    } else if op == OpSyscall {
        xSyscall(mut st, mut e, mut c, res, a)
    } else if op == OpScanB {
        xScanB(mut st, mut e, mut c, res, a, b)
    } else {
        // region op は rtlower の後には無い
        panic(Unreachable{})
    }
}

// xAbs は番地の imm32（配置の後で埋める）
func xAbs(e mut xF, c mut table.Table[byte], fx mut table.Table[int], r int, kind int, id int) {
    l := xLocAt(mut e, r, e.pos)
    if xIsReg(l) {
        x86.MovRegImm32(mut c, xLocVal(l), 0)
    } else {
        x86.MovMemImm32(mut c, x86.Rbp, xLocVal(l), 0)
    }
    xFixAdd(mut fx, x86.Here(mut c) - 4, kind, id)
}

// xPushArgs は実引数 lo 本目以降を後ろから積む（段 3 の規約では lo = レジスタで渡す本数）
func xPushArgs(st mut St, e mut xF, c mut table.Table[byte], args int, lo int) {
    mut k := xLen(mut st, args)
    while k > lo {
        k -= 1
        x := xGet(mut e, mut c, xAt(mut st, args, k), x86.Rax)
        x86.PushReg(mut c, x)
    }
}

func xAfterCall(e mut xF, c mut table.Table[byte], res int, nargs int) {
    if nargs > 0 {
        x86.AddRegImm(mut c, x86.Rsp, 8 * nargs)
    }
    if res >= 0 {
        xPut(mut e, mut c, res, x86.Rax)
    }
}

// xDivRem は div / rem（IR の全域の意味: b == 0 → exit 101、b == -1 → div は 0 - a・rem は 0、それ以外は idiv）
// xPow2 は n が 2^k（1 ≤ k ≤ 31）なら k、それ以外は 0（第二便 M10）
func xPow2(n int) int {
    mut k := 1
    while k <= 31 {
        if n == 1 << k {
            return k
        }
        k += 1
    }
    return 0
}

// xDivPow2 は 2^k での div / rem（IR の意味 = 0 への切り捨て — idiv と同じ）をシフト列で: bias = (x >> 63) & (2^k - 1)。
// div = (x + bias) >> k（算術）・rem = x - ((x + bias) & -2^k)。b は正の定数なのでゼロ除算・-1 の場合分けは無い（第二便 M10 — table.Get の chunk の番号）
func xDivPow2(e mut xF, c mut table.Table[byte], r int, op int, a int, k int) {
    xGetInto(mut e, mut c, a, x86.Rax)
    x86.MovRegReg(mut c, x86.Rdx, x86.Rax)
    x86.SarRegImm(mut c, x86.Rdx, 63)
    x86.AndRegImm(mut c, x86.Rdx, (1 << k) - 1)
    if op == BDiv {
        x86.AddRegReg(mut c, x86.Rax, x86.Rdx)
        x86.SarRegImm(mut c, x86.Rax, k)
    } else {
        x86.AddRegReg(mut c, x86.Rdx, x86.Rax)
        x86.AndRegImm(mut c, x86.Rdx, 0 - (1 << k))
        x86.SubRegReg(mut c, x86.Rax, x86.Rdx)
    }
    xPut(mut e, mut c, r, x86.Rax)
}

func xDivRem(e mut xF, c mut table.Table[byte], r int, op int, a int, b int) {
    if e.opt && e.isConst[b] == 1 && xPow2(e.constV[b]) > 0 {
        xDivPow2(mut e, mut c, r, op, a, xPow2(e.constV[b]))
        return
    }
    xGetInto(mut e, mut c, a, x86.Rax)
    xGetInto(mut e, mut c, b, x86.Rcx)
    known := e.isConst[b] == 1
    kb := e.constV[b]
    mut done := -1
    if !known || kb == 0 {
        x86.CmpRegImm(mut c, x86.Rcx, 0)
        e.div0[e.nd] = x86.JccRel32(mut c, x86.CondE)
        e.nd = e.nd + 1
    }
    if !known || kb == -1 {
        x86.CmpRegImm(mut c, x86.Rcx, -1)
        normal := x86.JccRel32(mut c, x86.CondNe)
        if op == BDiv {
            x86.NegReg(mut c, x86.Rax)
        } else {
            x86.XorRegReg(mut c, x86.Rax, x86.Rax)
        }
        done = x86.JmpRel32(mut c)
        x86.PatchRel32(mut c, normal, x86.Here(mut c))
    }
    x86.Cqo(mut c)
    x86.IdivReg(mut c, x86.Rcx)
    if op == BRem {
        x86.MovRegReg(mut c, x86.Rax, x86.Rdx)
    }
    if done >= 0 {
        x86.PatchRel32(mut c, done, x86.Here(mut c))
    }
    xPut(mut e, mut c, r, x86.Rax)
}

func xTermEmit(st mut St, e mut xF, c mut table.Table[byte], b BlkRef) {
    t := xbTerm(mut st, b)
    if t == TmBr {
        xJumpEdge(mut st, mut e, mut c, xbBrTo(mut st, b), xTermX(mut st, b, 2))
    } else if t == TmCondbr {
        x := xGet(mut e, mut c, xTermX(mut st, b, 1), x86.Rax)
        x86.CmpRegImm(mut c, x, 0)
        toElse := x86.JccRel32(mut c, x86.CondE)
        xJumpEdge(mut st, mut e, mut c, xbThen(mut st, b), xTermX(mut st, b, 3))
        x86.PatchRel32(mut c, toElse, x86.Here(mut c))
        xJumpEdge(mut st, mut e, mut c, xbElse(mut st, b), xTermX(mut st, b, 5))
    } else if t == TmRet {
        v := xTermX(mut st, b, 1)
        if v >= 0 {
            xGetInto(mut e, mut c, v, x86.Rax)
        }
        for k <- iter.Range(0, e.nsave) {
            if e.saveReg[k] >= xX0 {
                // xmm: r11 を中継（rax は戻り値）
                x86.MovRegMem(mut c, x86.R11, x86.Rbp, e.saveDisp[k])
                x86.MovqXR(mut c, e.saveReg[k] - xX0, x86.R11)
            } else {
                x86.MovRegMem(mut c, e.saveReg[k], x86.Rbp, e.saveDisp[k])
            }
        }
        if !e.nofr {
            x86.Leave(mut c)
        }
        x86.Ret(mut c)
    } else if t == TmExit {
        xExit(mut c, xTermX(mut st, b, 1), st.taskUse)
    } else {
        panic(Unreachable{})
    }
}

// ── 最適化のバックエンド（性能投資 M4 — 写しのバックエンドは上の xTermEmit のまま）──

// xFuseScan は融合する比較を決める: ブロックの終端が condbr で、その条件がブロックの最後の命令の比較の結果、かつ使い道がその condbr だけ
func xFuseScan(st mut St, e mut xF) {
    mut uses := mut []int{}
    xFill(mut uses, e.nv, 0)
    for bi <- iter.Range(0, e.nb) {
        b := BlkRef(e.blk[bi])
        if int(b) < 0 {
            continue
        }
        mut i := xbIHead(mut st, b)
        while i != -1 {
            for k <- iter.Range(0, xNOps(mut st, i)) {
                v := xOpnd(mut st, i, k)
                uses[v] = uses[v] + 1
            }
            i = xiNext(mut st, i)
        }
        for k <- iter.Range(0, xNTermOps(mut st, b)) {
            v := xTermOpnd(mut st, b, k)
            uses[v] = uses[v] + 1
        }
    }
    for bi <- iter.Range(0, e.nb) {
        b := BlkRef(e.blk[bi])
        if int(b) < 0 || xbTerm(mut st, b) != TmCondbr {
            continue
        }
        last := xbITail(mut st, b)
        cv := xTermX(mut st, b, 1)
        // float の eq / ne は flags を 1 つの jcc にできない（NaN のパリティ）— 融合しない。lt〜ge は a / ae の 1 つで決まる（unordered は CF = 1 で偽 —
        // 反転した be / b も「成り立たない」側として正しい）
        lk := if last != -1 && xiOp(mut st, last) == OpCmp { xiA(mut st, last) } else { -1 }
        if last != -1 && xiOp(mut st, last) == OpCmp && lk != CFEq && lk != CFNe && xiRes(mut st, last) == cv && uses[cv] == 1 {
            e.fuse[cv] = 1
            // flags の流用（検査点の間引き — cancel.sober）: `eq / ne x, 0` の x がすぐ手前の add / sub / and の結果なら、その演算が立てた ZF を
            // そのまま読む（比較を吐かない — 2）。and の結果の使い道がこの比較だけで右が imm32 なら、and の代わりに test を吐く（3 — 結果を作らない）。
            // 間に挟まりうる写し・再読み込みは mov だけで flags を壊さない
            if lk == CEq || lk == CNe {
                x := xiB(mut st, last)
                z := xiC(mut st, last)
                pv := xPrevIns(mut st, b, last)
                if e.isConst[z] == 1 && e.constV[z] == 0 && pv != -1 && xiOp(mut st, pv) == OpBin && xiRes(mut st, pv) == x {
                    k := xiA(mut st, pv)
                    if k == BAdd || k == BSub || k == BAnd {
                        e.fuse[cv] = 2
                        e.flg[x] = 1
                        r := xiC(mut st, pv)
                        if k == BAnd && uses[x] == 1 && e.isConst[r] == 1 && e.constV[r] >= -2147483648 && e.constV[r] <= 2147483647 {
                            e.fuse[x] = 3
                        }
                    }
                }
            }
        }
    }
}

// xPrevIns はブロック b の命令 i のすぐ手前の命令（無ければ -1）
func xPrevIns(st mut St, b BlkRef, i InsRef) InsRef {
    mut p := InsRef(-1)
    mut q := xbIHead(mut st, b)
    while q != -1 && q != i {
        p = q
        q = xiNext(mut st, q)
    }
    return p
}

// xGetX は float の値 v の入った xmm の番号（xmm にあればそれ・なければ xmm の scratch へ写して scratch — 汎用・フレームはビット列を movq）
func xGetX(e mut xF, c mut table.Table[byte], v int, scratch int) int {
    l := xLocAt(mut e, v, e.pos)
    if e.remat[v] == 0 && xIsXmm(l) {
        return xLocVal(l) - xX0
    }
    xIntoX(mut e, mut c, v, scratch)
    return scratch
}

// xIntoX は v を xmm d へ
func xIntoX(e mut xF, c mut table.Table[byte], v int, d int) {
    l := xLocAt(mut e, v, e.pos)
    if e.remat[v] == 1 {
        x86.MovRegImm32(mut c, x86.Rax, e.constV[v])
        x86.MovqXR(mut c, d, x86.Rax)
    } else if xIsXmm(l) {
        if xLocVal(l) - xX0 != d {
            x86.MovapdXX(mut c, d, xLocVal(l) - xX0)
        }
    } else if xIsReg(l) {
        x86.MovqXR(mut c, d, xLocVal(l))
    } else {
        x86.MovRegMem(mut c, x86.Rax, x86.Rbp, xLocVal(l))
        x86.MovqXR(mut c, d, x86.Rax)
    }
}

// xPutX は xmm s にある結果を v の置き場へ（xmm なら movapd・汎用は movq・フレームは rax を中継）
func xPutX(e mut xF, c mut table.Table[byte], v int, s int) {
    l := xLocAt(mut e, v, e.pos)
    if xIsXmm(l) {
        if xLocVal(l) - xX0 != s {
            x86.MovapdXX(mut c, xLocVal(l) - xX0, s)
        }
    } else if xIsReg(l) {
        x86.MovqRX(mut c, xLocVal(l), s)
    } else {
        x86.MovqRX(mut c, x86.Rax, s)
        x86.MovMemReg(mut c, x86.Rbp, xLocVal(l), x86.Rax)
    }
}

// xFloatBin は float の二項・単項（language.md 37 節）: 結果が xmm に置かれていればそこで直に計算する（float のクラス — opt）。
// 置き場が汎用・フレームなら xmm0 で計算して戻す（写しのバックエンドは常にこちら — 値は汎用レジスタのビット列）。scratch は xmm0 / xmm1。
// 単項（sqrt / ofInt / toInt）は c を読まない
func xFloatBin(e mut xF, c mut table.Table[byte], res int, a int, b int, cc int) {
    rl := xLocAt(mut e, res, e.pos)
    d := if xIsXmm(rl) { xLocVal(rl) - xX0 } else { 0 }
    if a == BFOfInt {
        x := xGet(mut e, mut c, b, x86.Rax)
        // cvtsi2sd / sqrtsd は書き先の上位 64 bit を残す（書き先の前の値への偽の依存）— pxor で切る（ループの運搬値の鎖のレジスタに当たると
        // 反復が直列になる: imm64 の定数の巻き上げで spectral-norm の evalA の cvtsi2sd が運搬値の xmm に乗って 5.3 倍）
        if e.opt {
            x86.PxorXX(mut c, d, d)
        }
        x86.Cvtsi2sdXR(mut c, d, x)
        xPutX(mut e, mut c, res, d)
        return
    }
    if a == BFToInt {
        xr := xGetX(mut e, mut c, b, 0)
        x86.Cvttsd2siRX(mut c, x86.Rax, xr)
        xPut(mut e, mut c, res, x86.Rax)
        return
    }
    if a == BFSqrt {
        xr := xGetX(mut e, mut c, b, 0)
        if e.opt && xr != d {
            x86.PxorXX(mut c, d, d)
        }
        x86.SqrtsdXX(mut c, d, xr)
        xPutX(mut e, mut c, res, d)
        return
    }
    // 可換（add / mul）で y が既に d にあるなら d = d op x（1.0× アタック便 — 2 番地形の都合の movapd 2 本を省く）
    if (a == BFAdd || a == BFMul) && b != cc && e.remat[cc] == 0 && xIsXmm(xLocAt(mut e, cc, e.pos)) && xLocVal(xLocAt(mut e, cc, e.pos)) - xX0 == d {
        xr := xGetX(mut e, mut c, b, 1)
        if a == BFAdd {
            x86.AddsdXX(mut c, d, xr)
        } else {
            x86.MulsdXX(mut c, d, xr)
        }
        xPutX(mut e, mut c, res, d)
        return
    }
    // d = d op y: y が d と同じ xmm で x と違う値なら y を xmm1 へ逃がしてから x を d へ
    mut yr := xGetX(mut e, mut c, cc, 1)
    if yr == d && b != cc {
        x86.MovapdXX(mut c, 1, yr)
        yr = 1
    }
    xIntoX(mut e, mut c, b, d)
    if b == cc {
        yr = d
    }
    if a == BFAdd {
        x86.AddsdXX(mut c, d, yr)
    } else if a == BFSub {
        x86.SubsdXX(mut c, d, yr)
    } else if a == BFMul {
        x86.MulsdXX(mut c, d, yr)
    } else {
        x86.DivsdXX(mut c, d, yr)
    }
    xPutX(mut e, mut c, res, d)
}

// xFloatCmp は float の比較（IEEE — unordered〔NaN〕は fne だけ真）: ucomisd の後の flags で。eq = ZF ∧ ¬PF・ne = ¬ZF ∨ PF・
// lt / le は被演算子を入れ替えて a / ae（CF = 1 の unordered は偽）・gt / ge はそのまま a / ae
func xFloatCmp(e mut xF, c mut table.Table[byte], res int, a int, b int, cc int) {
    x := xGetX(mut e, mut c, b, 0)
    y := xGetX(mut e, mut c, cc, 1)
    if a == CFLt || a == CFLe {
        x86.UcomisdXX(mut c, y, x)
    } else {
        x86.UcomisdXX(mut c, x, y)
    }
    if e.fuse[res] == 1 {
        // 融合: 終端の condbr が flags を読む（lt / gt = a・le / ge = ae）
        e.fcc = if a == CFLt || a == CFGt { x86.CondA } else { x86.CondAe }
        return
    }
    if a == CFEq {
        x86.SetccAl(mut c, x86.CondE)
        x86.SetccCl(mut c, x86.CondNp)
        x86.AndAlCl(mut c)
    } else if a == CFNe {
        x86.SetccAl(mut c, x86.CondNe)
        x86.SetccCl(mut c, x86.CondP)
        x86.OrAlCl(mut c)
    } else if a == CFLt || a == CFGt {
        x86.SetccAl(mut c, x86.CondA)
    } else {
        x86.SetccAl(mut c, x86.CondAe)
    }
    x86.MovzxRaxAl(mut c)
    xPut(mut e, mut c, res, x86.Rax)
}

// xFloatClass は float のクラス（xmm の組から割り当てる値）を決める（第二便 float の段 — opt のバックエンドだけ）:
// ①定義が float の演算（fadd〜fdiv・fsqrt・fofint）の値は常に ②定数（imm32 で作り直す定数は除く）・load・ブロックの仮引数は、使い道が全部 float を
// 読む口（float の演算・比較の被演算子・float のクラスの仮引数への辺の実引数）なら。仮引数は入りの実引数が全部 float のクラスであること。
// 楽観的に始めて、条件を破る値を外していく不動点（単調に減る）。関数の仮引数は汎用のまま（入口の規約）。cand: 1 = float の演算・2 = 使い道しだい・3 = ブロックの仮引数
func xFloatClass(st mut St, e mut xF) {
    xFill(mut e.fcls, e.nv, 0)
    mut cand := mut []int{}
    xFill(mut cand, e.nv, 0)
    for k <- iter.Range(0, e.norder) {
        b := BlkRef(e.blk[e.order[k]])
        mut p := xbPHead(mut st, b)
        while p >= 0 {
            cand[xParamVal(mut st, p)] = 3
            p = xParamNext(mut st, p)
        }
        mut i := xbIHead(mut st, b)
        while i != -1 {
            op := xiOp(mut st, i)
            r := xiRes(mut st, i)
            if r >= 0 {
                if op == OpBin && xiA(mut st, i) >= BFAdd && xiA(mut st, i) < BFToInt {
                    cand[r] = 1
                } else if (op == OpConst && e.remat[r] == 0) || (op == OpLoad && e.fold[r] == 0) {
                    cand[r] = 2
                }
            }
            i = xiNext(mut st, i)
        }
    }
    // float の演算が 1 つも無い関数は xmm のクラスを立てない（段 6 P4-6）: 楽観の不動点は store / 呼び出しの実引数 / ret にしか使われない
    // int のブロックの仮引数の環も xmm に置いていた（使うたび movq で汎用へ — 切替と罠が積む xmm の組も広げる）
    mut anyF := false
    for v <- iter.Range(0, e.nv) {
        if cand[v] == 1 {
            anyF = true
        }
    }
    if !anyF {
        return
    }
    for v <- iter.Range(0, e.nv) {
        e.fcls[v] = if v >= e.np && cand[v] > 0 && e.ivS[v] >= 0 { 1 } else { 0 }
    }
    mut bad := mut []int{}
    xFill(mut bad, e.nv, 0)
    // ibad = int の演算・比較・番地・分岐の条件に使われる（ブロックの仮引数を外す判定 — 64 bit の store の値・ret は xmm のままでよい）
    mut ibad := mut []int{}
    xFill(mut ibad, e.nv, 0)
    mut changed := true
    while changed {
        changed = false
        for v <- iter.Range(0, e.nv) {
            bad[v] = 0
            ibad[v] = 0
        }
        for k <- iter.Range(0, e.norder) {
            b := BlkRef(e.blk[e.order[k]])
            mut i := xbIHead(mut st, b)
            while i != -1 {
                op := xiOp(mut st, i)
                fa := xiA(mut st, i)
                fuse := (op == OpBin && fa >= BFAdd && fa <= BFToInt && fa != BFOfInt) || (op == OpCmp && fa >= CFEq)
                for j <- iter.Range(0, xNOps(mut st, i)) {
                    v := xOpnd(mut st, i, j)
                    if !fuse && v >= 0 && v < e.nv {
                        bad[v] = 1
                        if !(op == OpStore && j == 1) && op != OpCall && op != OpCallI && op != OpTrapI && op != OpTSwitch && op != OpTStart {
                            ibad[v] = 1
                        }
                    }
                }
                i = xiNext(mut st, i)
            }
            t := xbTerm(mut st, b)
            if t == TmCondbr || t == TmRet {
                v := xTermX(mut st, b, 1)
                if v >= 0 {
                    bad[v] = 1
                    if t == TmCondbr {
                        ibad[v] = 1
                    }
                }
            }
            // 辺: 実引数 → 仮引数（仮引数が float のクラスでなければ実引数は汎用の使い道・実引数が float でなければ仮引数は外す）
            for s <- iter.Range(0, xNSucc(mut st, b)) {
                to := BlkRef(e.blk[xSucc(mut st, b, s)])
                args := if t == TmBr { xTermX(mut st, b, 2) } else if s == 0 { xTermX(mut st, b, 3) } else { xTermX(mut st, b, 5) }
                mut n := 0
                mut p := xbPHead(mut st, to)
                while p >= 0 {
                    pv := xParamVal(mut st, p)
                    av := xAt(mut st, args, n)
                    // imm32 で作り直す定数（0.0 など）は xmm へ直に作れる — 仮引数を外す理由にしない
                    if e.fcls[pv] == 0 {
                        bad[av] = 1
                    } else if e.fcls[av] == 0 && e.remat[av] == 0 {
                        e.fcls[pv] = 0
                        changed = true
                    }
                    n += 1
                    p = xParamNext(mut st, p)
                }
            }
        }
        for v <- iter.Range(0, e.nv) {
            // ブロックの仮引数（cand 3）も int の演算・比較・番地・条件に使われれば外す（1.0× アタック便 — fannkuch の k〔perm[0]〕と slice の長さが
            // xmm に置かれ、比較のたびに movq で汎用へ戻していた。store の値・呼び出しの実引数・ret は外す理由にしない — float の累積が落ちて
            // spectral-norm が 2.7 倍遅くなった）
            if e.fcls[v] == 1 && ((cand[v] == 2 && bad[v] == 1) || (cand[v] == 3 && ibad[v] == 1)) {
                e.fcls[v] = 0
                changed = true
            }
        }
    }
}

// xDirectBin は add / sub / mul / and / or / xor を結果のレジスタへ直に計算する（結果がレジスタで、右の被演算子と同じレジスタでないとき）。できなければ false
func xDirectBin(e mut xF, c mut table.Table[byte], res int, a int, b int, cc int) bool {
    l := xLocAt(mut e, res, e.pos)
    if !xIsGpr(l) {
        return false
    }
    d := xLocVal(l)
    yl := xLocAt(mut e, cc, e.pos)
    imm := e.isConst[cc] == 1 && e.constV[cc] >= -2147483648 && e.constV[cc] <= 2147483647
    // 3 番地形（6.5 第 2 便 ③）: 左が d と別のレジスタにある add / sub imm は lea で（`mov d, x; add d, y` の写しを省く・右が d にある add も
    // rax を経由しない）。flags を後ろの condbr が読む演算（fuse 2）は lea にしない
    bl := xLocAt(mut e, b, e.pos)
    if e.flg[res] == 0 && e.isConst[b] == 0 && e.remat[b] == 0 && xIsGpr(bl) && xLocVal(bl) != d && (a == BAdd || (a == BSub && imm && e.constV[cc] != -2147483648)) {
        if imm {
            x86.LeaRegMem(mut c, d, xLocVal(bl), if a == BAdd { e.constV[cc] } else { 0 - e.constV[cc] })
            return true
        }
        if e.isConst[cc] == 0 {
            y := xGet(mut e, mut c, cc, x86.Rcx)
            x86.LeaRegSib(mut c, d, xLocVal(bl), y, x86.Scale1)
            return true
        }
    }
    // 定数倍は 3 番地形の imul d, x, imm（置き場どうしの段 A — report-508 R4a）: `mov rcx, imm; imul d, rcx` の即値の読みと、左がレジスタなら d への写しも省く
    if imm && a == BMul {
        x := if e.isConst[b] == 0 && e.remat[b] == 0 && xIsGpr(bl) { xLocVal(bl) } else { xGet(mut e, mut c, b, d) }
        x86.ImulRegRegImm(mut c, d, x, e.constV[cc])
        return true
    }
    // 右が d にある可換の演算は op d, 左（rax を経由しない — report-508 R4b）。sub は rax 経由の形へ
    if xIsReg(yl) && xLocVal(yl) == d && b != cc && a == BSub {
        return false
    }
    mut y := d
    if xIsReg(yl) && xLocVal(yl) == d && b != cc {
        y = xGet(mut e, mut c, b, x86.Rcx)
    } else {
        xGetInto(mut e, mut c, b, d)
        if imm && (a == BAdd || a == BSub || a == BAnd) {
            if a == BAdd {
                x86.AddRegImm(mut c, d, e.constV[cc])
            } else if a == BSub {
                x86.SubRegImm(mut c, d, e.constV[cc])
            } else {
                x86.AndRegImm(mut c, d, e.constV[cc])
            }
            return true
        }
        if b != cc {
            y = xGet(mut e, mut c, cc, x86.Rcx)
        }
    }
    if a == BAdd {
        x86.AddRegReg(mut c, d, y)
    } else if a == BSub {
        x86.SubRegReg(mut c, d, y)
    } else if a == BMul {
        x86.ImulRegReg(mut c, d, y)
    } else if a == BAnd {
        x86.AndRegReg(mut c, d, y)
    } else if a == BOr {
        x86.OrRegReg(mut c, d, y)
    } else {
        x86.XorRegReg(mut c, d, y)
    }
    return true
}

// ── ループの回転（6.5 第 2 便 ①）──
// 後ろへ戻る `br 頭` のラッチで、頭の判定（int の比較 1 本 + condbr — 比較は融合）をラッチの末尾に複製し、ループの中の行き先へ jcc で直に戻る
// （`jmp 頭; 頭: cmp; jge 出口` → `cmp; jl 本体` — 反復ごとに jmp 1 本と分岐 1 本が消える）。並べる順・区間・割り当ては変えない（頭のブロックも
// そのまま残り、入口からはそこを通る）: 辺の写しで頭の入りの状態を作ってから、頭の位置の置き場で比較と頭の終端を吐くだけ。
// 棄てた案: 頭のブロックを本体の後ろへ並べ替える（Go の looprotate — 並べる順は割り当ての線形の順そのもので、ループの範囲〔頭が先頭〕・運搬値の穴・
// 冷たいブロックの末尾寄せの前提を全部崩す）。
// 代価: 反復の短い最内ループ（fannkuch の swap — 回数はデータで決まる）では、抜けの判定が頭の jge（taken）からラッチの jl（不成立）へ移り、
// 予測ミスが +5% 増える（swap だけ回さない対照で基準に戻る）。Go の双子も同じ水準の予測ミスを払っている（Go と同じ形の構造的な代価）ので、形で除外はしない

// xRotOk はラッチ b の `br h` を回転できるか: h が順で手前（後ろの辺）・b が末尾の冷たい区画の外・h が融合した int の比較 1 本 + condbr で、
// 行き先の片方がループの中（深さが h 以上）・もう片方が出口（深さが h より浅い）、ループの中への辺に写しが要らない
func xRotOk(st mut St, e mut xF, b BlkRef, h BlkRef) bool {
    if !e.opt {
        return false
    }
    hb := xbId(mut st, h)
    bb := xbId(mut st, b)
    if e.bpos[hb] >= e.bpos[bb] || e.bpos[bb] >= e.c0 || xbTerm(mut st, h) != TmCondbr {
        return false
    }
    i := xRotCmp(mut st, mut e, h)
    if i == -1 || xiOp(mut st, i) != OpCmp || xiA(mut st, i) >= CFEq {
        return false
    }
    r := xiRes(mut st, i)
    if r < 0 || e.fuse[r] != 1 || xTermX(mut st, h, 1) != r {
        return false
    }
    th := xbId(mut st, xbThen(mut st, h))
    el := xbId(mut st, xbElse(mut st, h))
    inT := e.bdep[th] >= e.bdep[hb] && e.bdep[el] < e.bdep[hb]
    inE := e.bdep[el] >= e.bdep[hb] && e.bdep[th] < e.bdep[hb]
    if !inT && !inE {
        return false
    }
    // 頭の判定が 2 段（`while i < 50 && tr + ti <= 4.0` — ループの中の行き先が、頭と同じ出口へ分かれる条件分岐）なら回さない:
    // 回すとラッチが 2 段目へ直に戻る形になり、mandelbrot で命令 −4.2% のまま cycles +7%・nbody +1.8%（layvar 8 配置で一様 — FE 空きも予測ミスも
    // 変わらない）。同じ番地でループを差し替える対照で、mandelbrot の鎖で律速されるループは、出口の判定の手前の uop の
    // 並びで ±6% 揺れる当たり外れの族と分かった（定数の常駐でも +5.9%・使わない int → xmm の転送 1 本で戻る — FP のスケジューラの満杯と連動）。
    // 回転の 2 段目はこの族の外れ側（単独で +6.9%）。これは 1 題材の当たり外れに合わせた除外で、一般の法則ではない（形の良し悪しの言い伝えにしない —
    // 並びの当たり外れを割り当て・命令選択で制御できるようになったら外す）。
    // 境界検査（panic の点へ分かれる）で始まる本体は回す
    ib := if inT { xbThen(mut st, h) } else { xbElse(mut st, h) }
    ex := if inT { xbElse(mut st, h) } else { xbThen(mut st, h) }
    if xbTerm(mut st, ib) == TmCondbr && (int(xbThen(mut st, ib)) == int(ex) || int(xbElse(mut st, ib)) == int(ex)) {
        return false
    }
    p0 := e.pos
    e.pos = e.bpos[hb] + 2 * (xRotN(mut st, h) + 1)
    mv := if inT { xEdgeMoves(mut st, mut e, xbThen(mut st, h), xTermX(mut st, h, 3)) } else { xEdgeMoves(mut st, mut e, xbElse(mut st, h), xTermX(mut st, h, 5)) }
    e.pos = p0
    return !mv
}

// xRotCmp は頭 h の最後の命令が比較で、それより前が全部「使う点で作り直す定数」（remat 1 — 命令を吐かない）ならその比較（でなければ -1）
func xRotCmp(st mut St, e mut xF, h BlkRef) InsRef {
    mut i := xbIHead(mut st, h)
    while i != -1 {
        nx := xiNext(mut st, i)
        if nx == -1 {
            return i
        }
        if xiOp(mut st, i) != OpConst || e.remat[xiRes(mut st, i)] != 1 {
            return InsRef(-1)
        }
        i = nx
    }
    return InsRef(-1)
}

// xRotN は頭 h の命令の数
func xRotN(st mut St, h BlkRef) int {
    mut n := 0
    mut i := xbIHead(mut st, h)
    while i != -1 {
        n += 1
        i = xiNext(mut st, i)
    }
    return n
}

// xRotLatch はラッチ b の終端を回転の形で吐く（xRotOk が真のとき）
func xRotLatch(st mut St, e mut xF, c mut table.Table[byte], b BlkRef) {
    h := xbBrTo(mut st, b)
    hb := xbId(mut st, h)
    // 頭の入りの状態（仮引数・割れた値の写し）— 飛ばない
    xEdgeMv(mut st, mut e, mut c, h, xTermX(mut st, b, 2))
    p0 := e.pos
    // 頭の比較（頭の比較の位置の置き場で）
    i := xRotCmp(mut st, mut e, h)
    e.pos = e.bpos[hb] + 2 * (xRotN(mut st, h) - 1 + 1)
    x := xGet(mut e, mut c, xiB(mut st, i), x86.Rax)
    cc := xiC(mut st, i)
    if e.isConst[cc] == 1 && e.constV[cc] >= -2147483648 && e.constV[cc] <= 2147483647 {
        x86.CmpRegImm(mut c, x, e.constV[cc])
    } else {
        x86.CmpRegReg(mut c, x, xGet(mut e, mut c, cc, x86.Rcx))
    }
    k := xCond(xiA(mut st, i))
    // 頭の終端（頭の終わりの位置の置き場で）: ループの中へ jcc・出口へは辺の写しをして飛ぶ（次のブロックなら落ちる）
    e.pos = e.bpos[hb] + 2 * (xRotN(mut st, h) + 1)
    th := xbThen(mut st, h)
    if e.bdep[xbId(mut st, th)] >= e.bdep[hb] {
        xJcc(mut st, mut e, mut c, k, th)
        xEdge(mut st, mut e, mut c, xbElse(mut st, h), xTermX(mut st, h, 5), true)
    } else {
        xJcc(mut st, mut e, mut c, k ^ 1, xbElse(mut st, h))
        xEdge(mut st, mut e, mut c, th, xTermX(mut st, h, 3), true)
    }
    e.pos = p0
}

// xTermEmitOpt は終端（最適化のバックエンド）: 融合した比較は flags の jcc で直に・移動の無い辺は行き先へ jcc で直に・次のブロックへの jmp は省く
func xTermEmitOpt(st mut St, e mut xF, c mut table.Table[byte], b BlkRef) {
    t := xbTerm(mut st, b)
    if t == TmBr && xRotOk(mut st, mut e, b, xbBrTo(mut st, b)) {
        xRotLatch(mut st, mut e, mut c, b)
    } else if t == TmBr {
        xEdge(mut st, mut e, mut c, xbBrTo(mut st, b), xTermX(mut st, b, 2), true)
    } else if t == TmCondbr {
        cv := xTermX(mut st, b, 1)
        mut cc := 0
        if e.fuse[cv] != 0 {
            cc = e.fcc
        } else {
            x := xGet(mut e, mut c, cv, x86.Rax)
            x86.CmpRegImm(mut c, x, 0)
            cc = x86.CondNe
        }
        thenTo := xbThen(mut st, b)
        elseTo := xbElse(mut st, b)
        thenArgs := xTermX(mut st, b, 3)
        elseArgs := xTermX(mut st, b, 5)
        thenNext := xbId(mut st, thenTo) == e.next
        fwd := if thenNext { xFwdTo(mut st, mut e, thenTo) } else { -1 }
        if fwd >= 0 && !xEdgeMoves(mut st, mut e, thenTo, thenArgs) {
            // then が次のブロックで、写しの無い空の中継（`br X` だけ — 検査点の間引きの続き cont 等）: X へ直に飛び、else へは jmp（熱い道の飛びを 1 本に —
            // 写しが消えたラッチで `je 検査; jmp 頭` だった）
            xJcc(mut st, mut e, mut c, cc, BlkRef(fwd))
            xEdge(mut st, mut e, mut c, elseTo, elseArgs, true)
        } else if thenNext && !xEdgeMoves(mut st, mut e, elseTo, elseArgs) {
            // then が次のブロック: 条件を反転して else へ飛び、then へ落ちる
            xJcc(mut st, mut e, mut c, cc ^ 1, elseTo)
            xEdge(mut st, mut e, mut c, thenTo, thenArgs, true)
        } else if thenNext && e.bdep[xbId(mut st, elseTo)] < e.bdep[xbId(mut st, b)] && !xEdgeMoves(mut st, mut e, thenTo, thenArgs) {
            // then が次のブロックで、写しが要るのはループの出口（深さの下がる辺）の else だけ（区間分割の写し等）: else の写しを関数の末尾へ出し、then へ落ちる
            // （写しをその場に置くと条件が反転して then へ毎回 taken の分岐 + 出口の jmp になる — gran の葉で予測ミス 8 倍）。
            // ループの中の辺（revcomp のラッチ）は熱い側なので外置きしない（末尾へ出すと毎回 jmp が 2 本）
            e.eoA = append(e.eoA, x86.JccRel32(mut c, cc ^ 1))
            e.eoP = append(e.eoP, e.pos)
            e.eoT = append(e.eoT, int(elseTo))
            e.eoX = append(e.eoX, elseArgs)
            xEdge(mut st, mut e, mut c, thenTo, thenArgs, true)
        } else if !xEdgeMoves(mut st, mut e, thenTo, thenArgs) {
            xJcc(mut st, mut e, mut c, cc, thenTo)
            xEdge(mut st, mut e, mut c, elseTo, elseArgs, true)
        } else if !xEdgeMoves(mut st, mut e, elseTo, elseArgs) {
            xJcc(mut st, mut e, mut c, cc ^ 1, elseTo)
            xEdge(mut st, mut e, mut c, thenTo, thenArgs, true)
        } else {
            toElse := x86.JccRel32(mut c, cc ^ 1)
            xEdge(mut st, mut e, mut c, thenTo, thenArgs, false)
            x86.PatchRel32(mut c, toElse, x86.Here(mut c))
            xEdge(mut st, mut e, mut c, elseTo, elseArgs, true)
        }
    } else {
        xTermEmit(mut st, mut e, mut c, b)
    }
}

// xFoldScan は番地を融合する gep を決める（M7）: 結果の使い道が全部 load / load8 / store / store8 の番地（被演算子 a）だけ。
// 使う点は別のブロックでもよい（M8 — 生存解析が融合した番地を gep の被演算子の使用として数える。SSA なので gep は使う点を支配する）
func xFoldScan(st mut St, e mut xF) {
    mut uses := mut []int{}
    xFill(mut uses, e.nv, 0)
    mut nAddr := mut []int{}
    xFill(mut nAddr, e.nv, 0)
    mut defb := mut []int{}
    xFill(mut defb, e.nv, -1)
    for bi <- iter.Range(0, e.nb) {
        b := BlkRef(e.blk[bi])
        if int(b) < 0 {
            continue
        }
        mut i := xbIHead(mut st, b)
        while i != -1 {
            op := xiOp(mut st, i)
            for k <- iter.Range(0, xNOps(mut st, i)) {
                v := xOpnd(mut st, i, k)
                uses[v] = uses[v] + 1
            }
            if op == OpLoad || op == OpLoad8 || op == OpStore || op == OpStore8 {
                nAddr[xiA(mut st, i)] = nAddr[xiA(mut st, i)] + 1
            }
            r := xiRes(mut st, i)
            if r >= 0 && (op == OpGepW || op == OpGepB) {
                defb[r] = bi
                e.fA[r] = xiA(mut st, i)
                e.fB[r] = xiB(mut st, i)
                e.fS[r] = if op == OpGepW { 8 } else { 1 }
            }
            i = xiNext(mut st, i)
        }
        for k <- iter.Range(0, xNTermOps(mut st, b)) {
            v := xTermOpnd(mut st, b, k)
            uses[v] = uses[v] + 1
        }
    }
    for v <- iter.Range(0, e.nv) {
        if defb[v] >= 0 && uses[v] > 0 && uses[v] == nAddr[v] {
            e.fold[v] = 1
        }
    }
}

// xMemSibX は xMemSib の xmm 版（movsd — 値は xmm x）
func xMemSibX(e mut xF, c mut table.Table[byte], g int, off int, x int, isLoad bool) {
    p := xGet(mut e, mut c, e.fA[g], x86.Rax)
    ixv := e.fB[g]
    if e.isConst[ixv] == 1 {
        dd := e.constV[ixv] * e.fS[g] + off
        if dd >= -2147483648 && dd <= 2147483647 && e.constV[ixv] >= -268435456 && e.constV[ixv] <= 268435455 {
            if isLoad {
                x86.MovsdXMem(mut c, x, p, dd)
            } else {
                x86.MovsdMemX(mut c, p, dd, x)
            }
            return
        }
    }
    ix := xGet(mut e, mut c, ixv, x86.Rcx)
    sc := if e.fS[g] == 8 { x86.Scale8 } else { x86.Scale1 }
    if isLoad {
        x86.MovsdXMemSib(mut c, x, p, ix, sc, off)
    } else {
        x86.MovsdMemXSib(mut c, p, ix, sc, off, x)
    }
}

// xMemSib は融合した gep g の番地 [p + ix * 倍率 + off] で load（toReg = レジスタ r へ）/ store（r の値を）する（b8 = バイト幅）。
// ix が imm32 に収まる定数なら変位へ畳む（[p + 変位]）
func xMemSib(e mut xF, c mut table.Table[byte], g int, off int, r int, b8 bool, isLoad bool) {
    p := xGet(mut e, mut c, e.fA[g], x86.Rax)
    ixv := e.fB[g]
    if e.isConst[ixv] == 1 {
        dd := e.constV[ixv] * e.fS[g] + off
        if dd >= -2147483648 && dd <= 2147483647 && e.constV[ixv] >= -268435456 && e.constV[ixv] <= 268435455 {
            if isLoad {
                if b8 {
                    x86.MovzxRegMem8(mut c, r, p, dd)
                } else {
                    x86.MovRegMem(mut c, r, p, dd)
                }
            } else if b8 {
                x86.MovMem8Reg(mut c, p, dd, r)
            } else {
                x86.MovMemReg(mut c, p, dd, r)
            }
            return
        }
    }
    ix := xGet(mut e, mut c, ixv, x86.Rcx)
    sc := if e.fS[g] == 8 { x86.Scale8 } else { x86.Scale1 }
    if isLoad {
        if b8 {
            x86.MovzxRegMem8Sib(mut c, r, p, ix, sc, off)
        } else {
            x86.MovRegMemSib(mut c, r, p, ix, sc, off)
        }
    } else if b8 {
        x86.MovMem8RegSib(mut c, p, ix, sc, off, r)
    } else {
        x86.MovMemRegSib(mut c, p, ix, sc, off, r)
    }
}

// xScanB は scanb（第三便のベクトル化スパイク — vec.sober）: 16 バイトの塊ずつ、j + 16 ≤ 上限の間、出口のレーン（述語のどれかが成り立つバイト）が
// 無ければ j += 16・あれば j += そのレーンの番号で止める。結果 = j。使うレジスタ = rax（j）・rdx（上限）・r11（p）・rcx（作業）・xmm0〜7（外では使わない）。
// 述語の種類: 0 = x == K・1 = x != K・2 = x <u K・3 = x >=u K（K は 1〜255 — 2 / 3 は (x ^ 0x80) >s ((K - 1) ^ 0x80) で x >=u K）
func xScanB(st mut St, e mut xF, c mut table.Table[byte], res int, ops int, desc int) {
    if xAt(mut st, desc, 0) == -1 {
        xUtf8Pre(mut st, mut e, mut c, res, ops)
        return
    }
    xGetInto(mut e, mut c, xAt(mut st, ops, 0), x86.R11)
    xGetInto(mut e, mut c, xAt(mut st, ops, 1), x86.Rax)
    xGetInto(mut e, mut c, xAt(mut st, ops, 2), x86.Rdx)
    if xLen(mut st, ops) == 4 {
        // 上限 = 2 つの小さい方
        xGetInto(mut e, mut c, xAt(mut st, ops, 3), x86.Rcx)
        x86.CmpRegReg(mut c, x86.Rdx, x86.Rcx)
        skip := x86.JccRel32(mut c, x86.CondLe)
        x86.MovRegReg(mut c, x86.Rdx, x86.Rcx)
        x86.PatchRel32(mut c, skip, x86.Here(mut c))
    }
    np := xAt(mut st, desc, 1)
    // 出口 = x >=u 128（utf8 の検査）の語読み（SWAR）と端数の 8 バイトの SIMD の塊は試して不採用（第三便 M12 — 命令は減るが 1BRC の cycles が
    // それぞれ +5%: 名前 ≈ 9 バイトの区間ではバイトずつの分岐の当たるスカラーのループと同じかそれより遅い）
    // 最初の塊が上限を越えるなら定数の用意の前に抜ける（短い区間 — 名前・行の欄 — で固定費を払わない）
    x86.LeaRegMem(mut c, x86.Rcx, x86.Rax, 16)
    x86.CmpRegReg(mut c, x86.Rcx, x86.Rdx)
    early := x86.JccRel32(mut c, x86.CondG)
    // 出口が「x >=u 128」だけ（ASCII の区間の読み飛ばし — utf8 の検査・`b[i] < 128` の走査）なら出口のレーン = 上位ビットなので、
    // pmovmskb がそのまま出口の印になる: 定数の用意も比較も要らない（並列 1.0× 段 2。utf8.Check は非 ASCII のたびに抜けて入り直すので、
    // 入るたびの定数の用意 7 命令と塊ごとの比較 5 命令が検査の大半だった）
    hb := np == 1 && xAt(mut st, desc, 2) == VK_GE && xAt(mut st, desc, 3) == 128
    // 定数のベクトル: xmm7 = 全 1・xmm6 = 0x80 の並び（符号なしの比較があるとき）・xmm1 / xmm2 = 述語の K（2 / 3 は (K - 1) ^ 0x80）
    if !hb {
        x86.PcmpeqbXX(mut c, 7, 7)
    }
    mut useX80 := false
    for k <- iter.Range(0, if hb { 0 } else { np }) {
        kind := xAt(mut st, desc, 2 + 2 * k)
        kv := xAt(mut st, desc, 3 + 2 * k)
        bv := if kind >= 2 { (kv - 1) ^ 128 } else { kv }
        if kind >= 2 {
            useX80 = true
        }
        x86.MovRegImm64(mut c, x86.Rcx, (bv & 255) * 72340172838076673)
        x86.MovqXR(mut c, 1 + k, x86.Rcx)
        x86.PunpcklqdqXX(mut c, 1 + k, 1 + k)
    }
    if useX80 {
        x86.MovRegImm64(mut c, x86.Rcx, 128 * 72340172838076673)
        x86.MovqXR(mut c, 6, x86.Rcx)
        x86.PunpcklqdqXX(mut c, 6, 6)
    }
    // 16 バイトの塊の環
    topAt := x86.Here(mut c)
    x86.LeaRegMem(mut c, x86.Rcx, x86.Rax, 16)
    x86.CmpRegReg(mut c, x86.Rcx, x86.Rdx)
    outJ := x86.JccRel32(mut c, x86.CondG)
    x86.MovdquXMemSib(mut c, 0, x86.R11, x86.Rax)
    if hb {
        x86.PmovmskbRX(mut c, x86.Rcx, 0)
    } else {
        xScanLanes(mut st, mut c, desc, np, useX80)
        x86.PmovmskbRX(mut c, x86.Rcx, 5)
    }
    x86.CmpRegImm(mut c, x86.Rcx, 0)
    foundJ := x86.JccRel32(mut c, x86.CondNe)
    x86.AddRegImm(mut c, x86.Rax, 16)
    backJ := x86.JmpRel32(mut c)
    x86.PatchRel32(mut c, backJ, topAt)
    x86.PatchRel32(mut c, foundJ, x86.Here(mut c))
    x86.BsfRR(mut c, x86.Rcx, x86.Rcx)
    x86.AddRegReg(mut c, x86.Rax, x86.Rcx)
    x86.PatchRel32(mut c, outJ, x86.Here(mut c))
    x86.PatchRel32(mut c, early, x86.Here(mut c))
    xPut(mut e, mut c, res, x86.Rax)
}

// xUtf8Pre は UTF-8 の検査器（scanb の記述の列の先頭 = -1 — irinl の ilUtf8 が std/utf8.validPrefix から作る）: ops = [p, i, 上限 n]。
// 16 バイトの塊ずつ妥当な UTF-8 の列の並びを読み進め、結果 = j（b[i:j] は妥当・j は列の頭 — 最初の不正の位置以下。0 進んでも契約どおり）。
// SSE2 だけ（pshufb / palignr なし）: y = x ^ 0x80（符号つき）で a = 頭（≥ C0）・b3 = 3 バイト頭（≥ E0）の印、要る継続 = a を 1・b3 を 2 バイト右へ
// ずらした列（前の塊の末尾を pslldq / psrldq の or で継ぐ）、誤り = (継続 xor 要る継続) | C0 / C1 | 特別な頭（E0・ED・≥ F0 — 2 番目のバイトの
// 狭い範囲と 4 バイト列はスカラーに任せる）。誤りの塊で止め、最後に読み終えた列の頭まで戻る（継続バイトを読み戻す）。ASCII の塊は前の塊からの
// 持ち越し（rsi）が無ければ pmovmskb 1 本で飛ばす。使うレジスタ = rax（j）・rdx（n）・r11（p）・rcx（作業）・rsi / rdi（退避）・xmm0〜7・
// スタックの 96 バイト（定数 6 本）
func xUtf8Pre(st mut St, e mut xF, c mut table.Table[byte], res int, ops int) {
    xGetInto(mut e, mut c, xAt(mut st, ops, 0), x86.R11)
    xGetInto(mut e, mut c, xAt(mut st, ops, 1), x86.Rax)
    xGetInto(mut e, mut c, xAt(mut st, ops, 2), x86.Rdx)
    x86.LeaRegMem(mut c, x86.Rcx, x86.Rax, 16)
    x86.CmpRegReg(mut c, x86.Rcx, x86.Rdx)
    early := x86.JccRel32(mut c, x86.CondG)
    x86.PushReg(mut c, x86.Rsi)
    x86.PushReg(mut c, x86.Rdi)
    x86.MovRegReg(mut c, x86.Rdi, x86.Rax)
    x86.SubRegImm(mut c, x86.Rsp, 96)
    // 定数（y と比べる値）: [rsp + 0] 0x3F（≥ C0）・16 0x5F（≥ E0）・32 0x41（≥ C2）・48 0x60（= E0）・64 0x6D（= ED）・80 0x6F（≥ F0）
    ks := []int{63, 95, 65, 96, 109, 111}
    for k <- iter.Range(0, len(ks)) {
        x86.MovRegImm64(mut c, x86.Rcx, ks[k] * 72340172838076673)
        x86.MovqXR(mut c, 4, x86.Rcx)
        x86.PunpcklqdqXX(mut c, 4, 4)
        x86.MovdquMemX(mut c, x86.Rsp, 16 * k, 4)
    }
    x86.MovRegImm64(mut c, x86.Rcx, 128 * 72340172838076673)
    x86.MovqXR(mut c, 7, x86.Rcx)
    x86.PunpcklqdqXX(mut c, 7, 7)
    x86.PxorXX(mut c, 5, 5)
    x86.PxorXX(mut c, 6, 6)
    x86.XorRegReg(mut c, x86.Rsi, x86.Rsi)
    topAt := x86.Here(mut c)
    x86.LeaRegMem(mut c, x86.Rcx, x86.Rax, 16)
    x86.CmpRegReg(mut c, x86.Rcx, x86.Rdx)
    endJ := x86.JccRel32(mut c, x86.CondG)
    x86.MovdquXMemSib(mut c, 0, x86.R11, x86.Rax)
    x86.PmovmskbRX(mut c, x86.Rcx, 0)
    x86.OrRegReg(mut c, x86.Rcx, x86.Rsi)
    slowJ := x86.JccRel32(mut c, x86.CondNe)
    x86.AddRegImm(mut c, x86.Rax, 16)
    back1 := x86.JmpRel32(mut c)
    x86.PatchRel32(mut c, back1, topAt)
    x86.PatchRel32(mut c, slowJ, x86.Here(mut c))
    // y・a（xmm2）・b3（xmm3）
    x86.MovdqaXX(mut c, 1, 0)
    x86.PxorXX(mut c, 1, 7)
    x86.MovdqaXX(mut c, 2, 1)
    x86.MovdquXMem(mut c, 4, x86.Rsp, 0)
    x86.PcmpgtbXX(mut c, 2, 4)
    x86.MovdqaXX(mut c, 3, 1)
    x86.MovdquXMem(mut c, 4, x86.Rsp, 16)
    x86.PcmpgtbXX(mut c, 3, 4)
    // 要る継続（xmm5）= a を 1 バイト・b3 を 2 バイト右へ（前の塊の末尾を継ぐ）
    x86.PsrldqXI(mut c, 5, 15)
    x86.MovdqaXX(mut c, 4, 2)
    x86.PslldqXI(mut c, 4, 1)
    x86.PorXX(mut c, 5, 4)
    x86.PsrldqXI(mut c, 6, 14)
    x86.MovdqaXX(mut c, 4, 3)
    x86.PslldqXI(mut c, 4, 2)
    x86.PorXX(mut c, 6, 4)
    x86.PorXX(mut c, 5, 6)
    // 継続（xmm6）= 非 ASCII（y > -1）かつ a でない → 誤り = 継続 xor 要る継続
    x86.PcmpeqbXX(mut c, 6, 6)
    x86.MovdqaXX(mut c, 4, 1)
    x86.PcmpgtbXX(mut c, 4, 6)
    x86.MovdqaXX(mut c, 6, 2)
    x86.PandnXX(mut c, 6, 4)
    x86.PxorXX(mut c, 6, 5)
    // C0 / C1（a かつ y ≤ 0x41）
    x86.MovdqaXX(mut c, 4, 1)
    x86.MovdquXMem(mut c, 5, x86.Rsp, 32)
    x86.PcmpgtbXX(mut c, 4, 5)
    x86.MovdqaXX(mut c, 5, 4)
    x86.PandnXX(mut c, 5, 2)
    x86.PorXX(mut c, 6, 5)
    // 特別な頭（E0・ED・≥ F0）はスカラーへ
    x86.MovdquXMem(mut c, 5, x86.Rsp, 48)
    x86.PcmpeqbXX(mut c, 5, 1)
    x86.PorXX(mut c, 6, 5)
    x86.MovdquXMem(mut c, 5, x86.Rsp, 64)
    x86.PcmpeqbXX(mut c, 5, 1)
    x86.PorXX(mut c, 6, 5)
    x86.MovdqaXX(mut c, 5, 1)
    x86.MovdquXMem(mut c, 4, x86.Rsp, 80)
    x86.PcmpgtbXX(mut c, 5, 4)
    x86.PorXX(mut c, 6, 5)
    x86.PmovmskbRX(mut c, x86.Rcx, 6)
    x86.CmpRegImm(mut c, x86.Rcx, 0)
    stopJ := x86.JccRel32(mut c, x86.CondNe)
    // 次の塊への持ち越し（rsi）= 末尾の頭（a の 15・b3 の 14 / 15）。前の塊 = xmm5 / xmm6
    x86.PmovmskbRX(mut c, x86.Rcx, 2)
    x86.AndRegImm(mut c, x86.Rcx, 32768)
    x86.PmovmskbRX(mut c, x86.Rsi, 3)
    x86.AndRegImm(mut c, x86.Rsi, 49152)
    x86.OrRegReg(mut c, x86.Rsi, x86.Rcx)
    x86.MovdqaXX(mut c, 5, 2)
    x86.MovdqaXX(mut c, 6, 3)
    x86.AddRegImm(mut c, x86.Rax, 16)
    back2 := x86.JmpRel32(mut c)
    x86.PatchRel32(mut c, back2, topAt)
    // 止め: 最後に読み終えた列の頭まで戻る（j − 1 から継続バイトを読み戻す・i より手前へは行かない）
    x86.PatchRel32(mut c, endJ, x86.Here(mut c))
    x86.PatchRel32(mut c, stopJ, x86.Here(mut c))
    x86.AddRegImm(mut c, x86.Rsp, 96)
    x86.CmpRegReg(mut c, x86.Rax, x86.Rdi)
    noneJ := x86.JccRel32(mut c, x86.CondE)
    x86.SubRegImm(mut c, x86.Rax, 1)
    bkAt := x86.Here(mut c)
    x86.CmpRegReg(mut c, x86.Rax, x86.Rdi)
    bk1 := x86.JccRel32(mut c, x86.CondLe)
    x86.MovzxRegMem8Sib(mut c, x86.Rcx, x86.R11, x86.Rax, x86.Scale1, 0)
    x86.AndRegImm(mut c, x86.Rcx, 192)
    x86.CmpRegImm(mut c, x86.Rcx, 128)
    bk2 := x86.JccRel32(mut c, x86.CondNe)
    x86.SubRegImm(mut c, x86.Rax, 1)
    bkJ := x86.JmpRel32(mut c)
    x86.PatchRel32(mut c, bkJ, bkAt)
    x86.PatchRel32(mut c, noneJ, x86.Here(mut c))
    x86.PatchRel32(mut c, bk1, x86.Here(mut c))
    x86.PatchRel32(mut c, bk2, x86.Here(mut c))
    x86.PopReg(mut c, x86.Rdi)
    x86.PopReg(mut c, x86.Rsi)
    x86.PatchRel32(mut c, early, x86.Here(mut c))
    xPut(mut e, mut c, res, x86.Rax)
}

// xScanLanes は xmm0 の各バイトの出口のレーンを xmm5 に（xScanB の環の中身 — 述語ごとに比べて or）
func xScanLanes(st mut St, c mut table.Table[byte], desc int, np int, useX80 bool) {
    if useX80 {
        x86.MovdqaXX(mut c, 4, 0)
        x86.PxorXX(mut c, 4, 6)
    }
    for k <- iter.Range(0, np) {
        kind := xAt(mut st, desc, 2 + 2 * k)
        x86.MovdqaXX(mut c, 3, if kind >= 2 { 4 } else { 0 })
        if kind >= 2 {
            x86.PcmpgtbXX(mut c, 3, 1 + k)
        } else {
            x86.PcmpeqbXX(mut c, 3, 1 + k)
        }
        // 3 = 成り立つレーン（eq / >=u）。出口が「成り立たない」側の種類（1 = !=・2 = <u）は反転
        if kind == 1 || kind == 2 {
            x86.PxorXX(mut c, 3, 7)
        }
        if k == 0 {
            x86.MovdqaXX(mut c, 5, 3)
        } else {
            x86.PorXX(mut c, 5, 3)
        }
    }
}

// xHints は割り当てのヒントを集める（M5）: 辺の実引数 v → 仮引数 p（hP）・仮引数 p → 入りの実引数（hA1 / hA2）・
// 算術 / ptoi / itop の結果 → 左の被演算子（hOp — 被演算子がそこで死ねば同じレジスタで mov が要らない）
// 棄てた案（段 3 — report-459）: 呼び手側のヒント（呼び出しで区間が終わる実引数を引数レジスタへ）。命令は −0.1〜−0.6 ポイント得だが、
// cycles（8 配置の中央）は routing が呼ばれ側だけの形より +5.3%（最小〜最大で符号一致・予測ミス +17%）・ほかは揺れの幅
func xHints(st mut St, e mut xF) {
    xFill(mut e.hP, e.nv, -1)
    xFill(mut e.hA1, e.nv, -1)
    xFill(mut e.hA2, e.nv, -1)
    xFill(mut e.hOp, e.nv, -1)
    // 段 3: レジスタで来る仮引数は引数レジスタへ（合えば入口の写しが 0 本）
    xFill(mut e.hR, e.nv, -1)
    for k <- iter.Range(0, e.nreg) {
        e.hR[k] = xArgReg(k)
    }
    for k <- iter.Range(0, e.norder) {
        b := BlkRef(e.blk[e.order[k]])
        mut i := xbIHead(mut st, b)
        while i != -1 {
            op := xiOp(mut st, i)
            r := xiRes(mut st, i)
            if r >= 0 && (op == OpBin || op == OpPtoi || op == OpItop) {
                e.hOp[r] = xOpnd(mut st, i, 0)
            }
            i = xiNext(mut st, i)
        }
        t := xbTerm(mut st, b)
        if t == TmBr {
            xHintEdge(mut st, mut e, xbBrTo(mut st, b), xTermX(mut st, b, 2))
        } else if t == TmCondbr {
            xHintEdge(mut st, mut e, xbThen(mut st, b), xTermX(mut st, b, 3))
            xHintEdge(mut st, mut e, xbElse(mut st, b), xTermX(mut st, b, 5))
        }
    }
}

func xHintEdge(st mut St, e mut xF, to BlkRef, args int) {
    mut n := 0
    mut p := xbPHead(mut st, to)
    while p >= 0 {
        pv := xParamVal(mut st, p)
        a := xAt(mut st, args, n)
        if e.hP[a] < 0 {
            e.hP[a] = pv
        }
        if e.hA1[pv] < 0 {
            e.hA1[pv] = a
        } else if e.hA2[pv] < 0 && e.hA1[pv] != a {
            e.hA2[pv] = a
        }
        n += 1
        p = xParamNext(mut st, p)
    }
}

// xHintReg は部分区間 k のヒントのレジスタ（今空いているもの・無ければ -1）: 同じ値の割り当て済みの部分区間（隣を先に — 境界の写しを消す）→
// 値のヒント（辺の実引数 → 仮引数・仮引数 → 入りの実引数 2 本・演算の結果 → 左の被演算子）の値の、k の始まりでの置き場
func xHintReg(e mut xF, k int, free mut []int) int {
    v := e.pv[k]
    fl := e.fcls[v] == 1
    if e.pnx[v] >= 0 || k != v {
        // 隣（前・後）→ ほかの兄弟
        mut prev := -1
        mut q := v
        while q >= 0 {
            if e.pnx[q] == k {
                prev = q
            }
            q = e.pnx[q]
        }
        for j <- iter.Range(0, 2) {
            q2 := if j == 0 { prev } else { e.pnx[k] }
            if q2 >= 0 {
                r := xHintLoc(e.loc[q2], mut free, fl)
                if r >= 0 {
                    return r
                }
            }
        }
        q = v
        while q >= 0 {
            if q != k {
                r := xHintLoc(e.loc[q], mut free, fl)
                if r >= 0 {
                    return r
                }
            }
            q = e.pnx[q]
        }
    }
    if e.hR[v] >= 0 && free[e.hR[v]] == 1 && !fl {
        return e.hR[v]
    }
    for j <- iter.Range(0, 4) {
        h := if j == 0 { e.hP[v] } else if j == 1 { e.hA1[v] } else if j == 2 { e.hA2[v] } else { e.hOp[v] }
        if h >= 0 {
            r := xHintLoc(xLocAt(mut e, h, e.ivS[k]), mut free, fl)
            if r >= 0 {
                return r
            }
        }
    }
    return -1
}

// xHintLoc は置き場 l が空いているレジスタで組（float か）が合えばそのレジスタ
func xHintLoc(l int, free mut []int, fl bool) int {
    return if xIsReg(l) && free[xLocVal(l)] == 1 && xIsXmm(l) == fl { xLocVal(l) } else { -1 }
}

// xEdgeMoves は辺の実引数の並行コピーに移動が要るか
func xEdgeMoves(st mut St, e mut xF, to BlkRef, args int) bool {
    mut n := 0
    mut p := xbPHead(mut st, to)
    while p >= 0 {
        if xLocAt(mut e, xParamVal(mut st, p), e.bpos[xbId(mut st, to)]) != xSrcLoc(mut e, xAt(mut st, args, n)) {
            return true
        }
        n += 1
        p = xParamNext(mut st, p)
    }
    // 割れた値の写しは書き先 = 読み元のもの（xParallelMove が出さない）を数えない — 数えると写しの無い辺で条件が反転し `je 次; jmp 頭` になる（T2 の葉のラッチ）
    nm := xSplitMoves(mut st, mut e, to, 0)
    for k <- iter.Range(0, nm) {
        if e.mvD[k] != e.mvS[k] {
            return true
        }
    }
    return false
}

// xFwdTo は b が写しの無い空の中継（命令なし・`br X` で X への辺に写しが無い）なら X（BlkRef の番号）・でなければ -1
func xFwdTo(st mut St, e mut xF, b BlkRef) int {
    if xbIHead(mut st, b) != -1 || xbTerm(mut st, b) != TmBr || xbPHead(mut st, b) >= 0 || (len(e.zAt) > 0 && e.zAt[xbId(mut st, b)] == 1) {
        return -1
    }
    x := xbBrTo(mut st, b)
    if int(x) == int(b) {
        return -1
    }
    p0 := e.pos
    e.pos = e.bpos[xbId(mut st, b)] + 2
    mv := xEdgeMoves(mut st, mut e, x, xTermX(mut st, b, 2))
    e.pos = p0
    return if mv { -1 } else { int(x) }
}

// xJcc は条件 cc で行き先のブロックへ直に飛ぶ（関数の末尾で埋める）
func xJcc(st mut St, e mut xF, c mut table.Table[byte], cc int, to BlkRef) {
    e.jAt[e.nj] = x86.JccRel32(mut c, cc)
    e.jTo[e.nj] = xbId(mut st, to)
    e.nj = e.nj + 1
}

// xEdge は辺の並行コピーをして飛ぶ（fall なら行き先が次のブロックのとき jmp を省く）
func xEdge(st mut St, e mut xF, c mut table.Table[byte], to BlkRef, args int, fall bool) {
    xEdgeMv(mut st, mut e, mut c, to, args)
    if fall && xbId(mut st, to) == e.next {
        e.fell = true
        return
    }
    e.jAt[e.nj] = x86.JmpRel32(mut c)
    e.jTo[e.nj] = xbId(mut st, to)
    e.nj = e.nj + 1
}

// xEdgeMv は辺の並行コピー（実引数 → 仮引数・割れた値の写し）だけをする
func xEdgeMv(st mut St, e mut xF, c mut table.Table[byte], to BlkRef, args int) {
    mut n := 0
    mut p := xbPHead(mut st, to)
    while p >= 0 {
        e.mvD[n] = xLocAt(mut e, xParamVal(mut st, p), e.bpos[xbId(mut st, to)])
        e.mvS[n] = xSrcLoc(mut e, xAt(mut st, args, n))
        n += 1
        p = xParamNext(mut st, p)
    }
    nm := xSplitMoves(mut st, mut e, to, n)
    xParallelMove(mut e, mut c, nm)
}

// xJumpEdge は辺の実引数を仮引数へ並行コピーして飛ぶ
func xJumpEdge(st mut St, e mut xF, c mut table.Table[byte], to BlkRef, args int) {
    mut n := 0
    mut p := xbPHead(mut st, to)
    while p >= 0 {
        e.mvD[n] = xLocAt(mut e, xParamVal(mut st, p), e.bpos[xbId(mut st, to)])
        e.mvS[n] = xLocAt(mut e, xAt(mut st, args, n), e.pos)
        n += 1
        p = xParamNext(mut st, p)
    }
    xParallelMove(mut e, mut c, n)
    e.jAt[e.nj] = x86.JmpRel32(mut c)
    e.jTo[e.nj] = xbId(mut st, to)
    e.nj = e.nj + 1
}

// xSyscall: 引数レジスタ（rdi / rsi / r8〜r10）に載っていて syscall の後も生きている値を積んで退避し、
// 引数を並行コピーで番号 + 6 本へ入れる（rcx / r11 は syscall が壊すが割り当てていない）
func xSyscall(st mut St, e mut xF, c mut table.Table[byte], res int, args int) {
    regs := []int{x86.Rax, x86.Rdi, x86.Rsi, x86.Rdx, x86.R10, x86.R8, x86.R9}
    mut saved := mut []int{}
    for v <- iter.Range(0, e.npc) {
        l := e.loc[v]
        if xIsReg(l) && e.ivS[v] >= 0 && e.ivS[v] < e.pos && e.ivE[v] > e.pos {
            r := xLocVal(l)
            mut isArg := false
            for k <- iter.Range(1, 7) {
                if regs[k] == r {
                    isArg = true
                }
            }
            mut dup := false
            for k <- iter.Range(0, len(saved)) {
                if saved[k] == r {
                    dup = true
                }
            }
            if isArg && !dup {
                saved = append(saved, r)
            }
        }
    }
    for k <- iter.Range(0, len(saved)) {
        x86.PushReg(mut c, saved[k])
    }
    n := xLen(mut st, args)
    for k <- iter.Range(0, n) {
        e.mvD[k] = xLocReg(regs[k])
        e.mvS[k] = xSrcLoc(mut e, xAt(mut st, args, k))
    }
    xParallelMove(mut e, mut c, n)
    x86.Syscall(mut c)
    mut k := len(saved)
    while k > 0 {
        k -= 1
        x86.PopReg(mut c, saved[k])
    }
    xPut(mut e, mut c, res, x86.Rax)
}

// xParallelMove は e.mvD / e.mvS の先頭 n 本の並行コピー: 書き先が他の移動の読み元でない移動から順に出す。全部が循環なら
// 先頭の書き先を r11 に逃がしてその読み元を付け替える。フレーム同士は rax を中継（並びは ir_x86 の orderedRemove と同じ）
func xParallelMove(e mut xF, c mut table.Table[byte], n int) {
    mut alive := 0
    for k <- iter.Range(0, n) {
        if e.mvD[k] == e.mvS[k] {
            e.mvLive[k] = 0
        } else {
            e.mvLive[k] = 1
            alive += 1
        }
    }
    r11 := xLocReg(x86.R11)
    while alive > 0 {
        mut ready := -1
        for k <- iter.Range(0, n) {
            if ready < 0 && e.mvLive[k] == 1 {
                mut blocked := false
                for j <- iter.Range(0, n) {
                    if j != k && e.mvLive[j] == 1 && e.mvS[j] == e.mvD[k] {
                        blocked = true
                    }
                }
                if !blocked {
                    ready = k
                }
            }
        }
        if ready >= 0 {
            if e.mvS[ready] >= xRemat && e.remat[(e.mvS[ready] - xRemat) / 2] == 2 {
                // スロットの番地（remat 2）: lea を書き先へ（フレームなら rax を中継）
                disp := e.slotDisp[e.constV[(e.mvS[ready] - xRemat) / 2]]
                dst := e.mvD[ready]
                if xIsReg(dst) && !xIsXmm(dst) {
                    x86.LeaRegMem(mut c, xLocVal(dst), x86.Rbp, disp)
                } else {
                    x86.LeaRegMem(mut c, x86.Rax, x86.Rbp, disp)
                    xMove(mut c, dst, xLocReg(x86.Rax))
                }
            } else if e.mvS[ready] >= xRemat {
                xMoveImm(mut c, e.mvD[ready], e.constV[(e.mvS[ready] - xRemat) / 2])
            } else {
                xMove(mut c, e.mvD[ready], e.mvS[ready])
            }
            e.mvLive[ready] = 0
            alive -= 1
        } else {
            mut first := -1
            for k <- iter.Range(0, n) {
                if first < 0 && e.mvLive[k] == 1 {
                    first = k
                }
            }
            d := e.mvD[first]
            xMove(mut c, r11, d)
            for k <- iter.Range(0, n) {
                if e.mvLive[k] == 1 && e.mvS[k] == d {
                    e.mvS[k] = r11
                }
            }
        }
    }
}

// xSrcLoc は並行コピーの読み元の置き場（作り直す定数は印 xRemat + 2 × 値 — 偶数で xSpill より上・どの書き先とも一致しない。M5）
func xSrcLoc(e mut xF, v int) int {
    return if e.remat[v] != 0 { xRemat + 2 * v } else { xLocAt(mut e, v, e.pos) }
}

// xMoveImm は即値を置き場へ
func xMoveImm(c mut table.Table[byte], dst int, imm int) {
    if xIsXmm(dst) {
        x86.MovRegImm32(mut c, x86.Rax, imm)
        x86.MovqXR(mut c, xLocVal(dst) - xX0, x86.Rax)
    } else if xIsReg(dst) {
        x86.MovRegImm32(mut c, xLocVal(dst), imm)
    } else {
        x86.MovMemImm32(mut c, x86.Rbp, xLocVal(dst), imm)
    }
}

func xMove(c mut table.Table[byte], dst int, src int) {
    // float のクラス（xmm）を含む移動: xmm 同士は movapd・汎用とは movq・フレームとは rax を中継
    if xIsXmm(dst) || xIsXmm(src) {
        if xIsXmm(dst) && xIsXmm(src) {
            x86.MovapdXX(mut c, xLocVal(dst) - xX0, xLocVal(src) - xX0)
        } else if xIsXmm(dst) {
            if xIsReg(src) {
                x86.MovqXR(mut c, xLocVal(dst) - xX0, xLocVal(src))
            } else {
                x86.MovRegMem(mut c, x86.Rax, x86.Rbp, xLocVal(src))
                x86.MovqXR(mut c, xLocVal(dst) - xX0, x86.Rax)
            }
        } else if xIsReg(dst) {
            x86.MovqRX(mut c, xLocVal(dst), xLocVal(src) - xX0)
        } else {
            x86.MovqRX(mut c, x86.Rax, xLocVal(src) - xX0)
            x86.MovMemReg(mut c, x86.Rbp, xLocVal(dst), x86.Rax)
        }
        return
    }
    if xIsReg(dst) {
        if xIsReg(src) {
            x86.MovRegReg(mut c, xLocVal(dst), xLocVal(src))
        } else {
            x86.MovRegMem(mut c, xLocVal(dst), x86.Rbp, xLocVal(src))
        }
    } else if xIsReg(src) {
        x86.MovMemReg(mut c, x86.Rbp, xLocVal(dst), xLocVal(src))
    } else {
        x86.MovRegMem(mut c, x86.Rax, x86.Rbp, xLocVal(src))
        x86.MovMemReg(mut c, x86.Rbp, xLocVal(dst), x86.Rax)
    }
}

// ── task の罠（段 6 P3a-2a — trap.sober）──

// xTrapRegs は罠が退避する汎用レジスタ（呼び手の callee-saved 全部 — 割り当て可能な 10 本 + rbp。積む順）
func xTrapRegs() []int {
    return []int{x86.Rbp, x86.Rbx, x86.R12, x86.R13, x86.R14, x86.R15, x86.Rsi, x86.Rdi, x86.R8, x86.R9, x86.R10}
}

// xCtxRegs は位置 p の切替 / 罠が積む汎用レジスタ（xTrapRegs の順の部分列 — 段 6 P4-6）: rbp・この関数の入口が退避していないもの
// （呼び手の値が載っている — 相手の task / 死んだ子が壊す）・p を跨いで生きる値の載るもの。入口が退避していて跨ぐ値の無いレジスタは、
// 戻った後に読む者がいない（この関数の出口は入口の退避から戻す）ので積まない
func xCtxRegs(e mut xF, p int, xm int) []int {
    mut keep := mut []int{}
    xFill(mut keep, 16, 1)
    // opt の規約（呼び出し規約の段 1）: caller-saved の組には呼び手の値が載らず、切替 / 罠を跨ぐ値も載らない（xPrioPick）— 積まない
    for k <- iter.Range(0, if e.opt { xNAlloc } else { 0 }) {
        if !xCalleeSaved(xAllocReg(k)) {
            keep[xAllocReg(k)] = 0
        }
    }
    for k <- iter.Range(0, e.nsave) {
        if e.saveReg[k] < xX0 {
            keep[e.saveReg[k]] = 0
        }
    }
    for v <- iter.Range(0, e.nv) {
        mut k := v
        while k >= 0 {
            if e.ivS[k] >= 0 && e.ivS[k] < p && e.ivE[k] > p && xIsGpr(e.loc[k]) {
                keep[xLocVal(e.loc[k])] = 1
            }
            k = e.pnx[k]
        }
    }
    rs := xTrapRegs()
    mut n := 0
    for k <- iter.Range(0, len(rs)) {
        if rs[k] == x86.Rbp || keep[rs[k]] == 1 {
            n += 1
        }
    }
    // 積む語数の偶奇を全部積む形（11 本 + xmm 14 本 = 奇数）と揃える（rsp の 16 B の揃いを変えない）: 偶数なら 1 本足す
    mut nx := 0
    for k <- iter.Range(2, 16) {
        nx += xm >> k & 1
    }
    mut pad := (n + nx) % 2 == 0
    mut out := mut []int{}
    for k <- iter.Range(0, len(rs)) {
        if rs[k] == x86.Rbp || keep[rs[k]] == 1 {
            out = append(out, rs[k])
        } else if pad {
            out = append(out, rs[k])
            pad = false
        }
    }
    return freeze(out)
}

// xTrapXmm は罠と切替が退避する xmm の数（xmm2〜15 — 割り当てに使う広い組の全部。プログラムに float の演算が無ければ 0 — xHasFloat）
const xTrapXmm = 14
func xSaveXmm(st mut St) []int {
    mut out := mut []int{}
    for k <- iter.Range(2, 16) {
        if st.xXmm >> k & 1 == 1 {
            out = append(out, k)
        }
    }
    return freeze(out)
}

// xTrap は `r = trap callee(arg)`: 呼び手の callee-saved と xmm2〜15 を積み、call で再開番地を積んで内側へ。内側は [前の罠, 再開番地] を
// @rt.trap[0] に張って callee(arg) を呼ぶ（引数はスタック — 自前の規約）。戻れば前の罠を戻して結果 0。巻き戻り（xUnwind の ret）は再開番地に着いて結果 1。
// どちらも積んだ callee-saved と xmm を戻してから結果を置く（巻き戻りでは子の epilogue が飛ばされるので、ここで戻すのが唯一の復元）
func xTrap(e mut xF, c mut table.Table[byte], fx mut table.Table[int], res int, callee int, arg int, g int, fsd int, xs []int, rs []int) {
    xGetInto(mut e, mut c, arg, x86.Rdx)
    xGetInto(mut e, mut c, callee, x86.R11)
    for k <- iter.Range(0, len(rs)) {
        x86.PushReg(mut c, rs[k])
    }
    if len(xs) > 0 {
        x86.SubRegImm(mut c, x86.Rsp, 8 * len(xs))
    }
    for k <- iter.Range(0, len(xs)) {
        x86.MovsdMemX(mut c, x86.Rsp, 8 * k, xs[k])
    }
    inner := x86.CallRel32(mut c)
    // 再開番地（巻き戻りの着地）: 結果 1
    x86.MovRegImm32(mut c, x86.Rcx, 1)
    rest := x86.JmpRel32(mut c)
    x86.PatchRel32(mut c, inner, x86.Here(mut c))
    xTrapBase(mut c, mut fx, g, fsd)
    x86.MovRegMem(mut c, x86.Rcx, x86.Rax, 0)
    x86.PushReg(mut c, x86.Rcx)
    x86.MovMemReg(mut c, x86.Rax, 0, x86.Rsp)
    x86.PushReg(mut c, x86.Rdx)
    x86.CallReg(mut c, x86.R11)
    x86.AddRegImm(mut c, x86.Rsp, 8)
    // 戻った: 前の罠を戻し、再開番地を捨てて結果 0
    xTrapBase(mut c, mut fx, g, fsd)
    x86.PopReg(mut c, x86.Rcx)
    x86.MovMemReg(mut c, x86.Rax, 0, x86.Rcx)
    x86.AddRegImm(mut c, x86.Rsp, 8)
    x86.MovRegImm32(mut c, x86.Rcx, 0)
    x86.PatchRel32(mut c, rest, x86.Here(mut c))
    for k <- iter.Range(0, len(xs)) {
        x86.MovsdXMem(mut c, xs[k], x86.Rsp, 8 * k)
    }
    if len(xs) > 0 {
        x86.AddRegImm(mut c, x86.Rsp, 8 * len(xs))
    }
    mut k := len(rs)
    while k > 0 {
        k -= 1
        x86.PopReg(mut c, rs[k])
    }
    if res >= 0 {
        xPut(mut e, mut c, res, x86.Rcx)
    }
}

// xTSave は切替の前半: callee-saved と xmm2〜15 を積み、call で再開番地を積んで内側（返す番地 = 内側の先頭）へ。再開番地は jmp で後半へ跳ぶ。
// 呼び手は内側で rsp を退避先へ書いてから相手へ移る。戻る道 = 誰かが退避した rsp を戻して ret → 再開番地 → xTRestore
func xTSave(c mut table.Table[byte], xs []int, rs []int) (int, int) {
    for k <- iter.Range(0, len(rs)) {
        x86.PushReg(mut c, rs[k])
    }
    if len(xs) > 0 {
        x86.SubRegImm(mut c, x86.Rsp, 8 * len(xs))
    }
    for k <- iter.Range(0, len(xs)) {
        x86.MovsdMemX(mut c, x86.Rsp, 8 * k, xs[k])
    }
    inner := x86.CallRel32(mut c)
    rest := x86.JmpRel32(mut c)
    x86.PatchRel32(mut c, inner, x86.Here(mut c))
    return inner, rest
}

// xTRestore は切替の後半（再開番地からの着地）: 積んだ xmm と callee-saved を戻す
func xTRestore(c mut table.Table[byte], rest int, xs []int, rs []int) {
    x86.PatchRel32(mut c, rest, x86.Here(mut c))
    for k <- iter.Range(0, len(xs)) {
        x86.MovsdXMem(mut c, xs[k], x86.Rsp, 8 * k)
    }
    if len(xs) > 0 {
        x86.AddRegImm(mut c, x86.Rsp, 8 * len(xs))
    }
    mut k := len(rs)
    while k > 0 {
        k -= 1
        x86.PopReg(mut c, rs[k])
    }
}

// xTSwitch は `tswitch save(load)`（段 6 P3b — ir.md 4.6）: 今の文脈を積んで rsp を [save] へ、[load] の rsp へ移って ret（相手の再開番地）
func xTSwitch(e mut xF, c mut table.Table[byte], save int, other int, xs []int, rs []int) {
    xGetInto(mut e, mut c, other, x86.R11)
    xGetInto(mut e, mut c, save, x86.Rdx)
    _, rest := xTSave(mut c, xs, rs)
    x86.MovMemReg(mut c, x86.Rdx, 0, x86.Rsp)
    x86.MovRegMem(mut c, x86.Rsp, x86.R11, 0)
    x86.Ret(mut c)
    xTRestore(mut c, rest, xs, rs)
}

// xTStart は `tstart save(sp, fn, arg)`: 今の文脈を積んで rsp を [save] へ、rsp を sp に付け替えて fn(arg) を呼ぶ（引数はスタック — 自前の規約。fn は戻らない）
func xTStart(e mut xF, c mut table.Table[byte], save int, sp int, fn int, arg int, xs []int, rs []int) {
    xGetInto(mut e, mut c, sp, x86.Rcx)
    xGetInto(mut e, mut c, fn, x86.R11)
    xGetInto(mut e, mut c, arg, x86.Rdx)
    xGetInto(mut e, mut c, save, x86.Rax)
    _, rest := xTSave(mut c, xs, rs)
    x86.MovMemReg(mut c, x86.Rax, 0, x86.Rsp)
    x86.MovRegReg(mut c, x86.Rsp, x86.Rcx)
    x86.PushReg(mut c, x86.Rdx)
    x86.CallReg(mut c, x86.R11)
    // fn は戻らない（戻ったら死 — exit 101）
    xExit(mut c, 101, true)
    xTRestore(mut c, rest, xs, rs)
}

// xUnwind は `unwind`: @rt.trap[0] が 0 でなければ rsp を罠の記録へ戻し、前の罠を戻して再開番地へ ret。0 なら何もしない。
// code > 0（x86 の死の口 — ゼロ除算）なら巻き戻る前に死因（@rt.trap[1] = code・[2] = -1）を書く
func xUnwind(c mut table.Table[byte], fx mut table.Table[int], g int, fsd int, code int) {
    xTrapBase(mut c, mut fx, g, fsd)
    x86.MovRegMem(mut c, x86.Rcx, x86.Rax, 0)
    x86.CmpRegImm(mut c, x86.Rcx, 0)
    skip := x86.JccRel32(mut c, x86.CondE)
    if code > 0 {
        x86.MovMemImm32(mut c, x86.Rax, 8, code)
        x86.MovMemImm32(mut c, x86.Rax, 16, -1)
    }
    x86.MovRegReg(mut c, x86.Rsp, x86.Rcx)
    x86.PopReg(mut c, x86.Rdx)
    x86.MovMemReg(mut c, x86.Rax, 0, x86.Rdx)
    x86.Ret(mut c)
    x86.PatchRel32(mut c, skip, x86.Here(mut c))
}

// xAtomic は原子の op（段 6 P4-4）: 番地 → rcx・値 → rax（cas は期待 → rax・新 → rdx）・結果 = rax（古い値）
func xAtomic(st mut St, e mut xF, c mut table.Table[byte], res int, p int, vs int, kc int) {
    k := kc & 7
    d := 8 * (kc >> 3)
    if k == AT_FENCE {
        x86.Mfence(mut c)
        return
    }
    if k == AT_PAUSE {
        x86.Pause(mut c)
        return
    }
    xGetInto(mut e, mut c, p, x86.Rcx)
    if k == AT_CAS {
        xGetInto(mut e, mut c, xAt(mut st, vs, 1), x86.Rdx)
        xGetInto(mut e, mut c, xAt(mut st, vs, 0), x86.Rax)
        x86.LockCmpxchgMemReg(mut c, x86.Rcx, d, x86.Rdx)
    } else {
        xGetInto(mut e, mut c, xAt(mut st, vs, 0), x86.Rax)
        if k == AT_XADD {
            x86.LockXaddMemReg(mut c, x86.Rcx, d, x86.Rax)
        } else {
            x86.XchgMemReg(mut c, x86.Rcx, d, x86.Rax)
        }
    }
    if res >= 0 {
        xPut(mut e, mut c, res, x86.Rax)
    }
}

// xClone は `clone sp(fn, arg, tls)`（段 6 P4-4）: 子のスタックの頂上の下に [fn, arg] を置いて clone(CLONE_VM | FS | FILES | SIGHAND | THREAD | SYSVSEM |
// SETTLS)。子の道は syscall の直後に fn を pop して call する（引数はスタック — xTStart と同じ自前の規約）— 親のスタックの番地を一切読まない
// （生の clone の子は親と同じ命令列を別の rsp で続けるため、割り当て器の退避の読み戻しを通らない短い道だけにする）。fn が戻ったらスレッドだけ終わる（exit 60）
func xClone(st mut St, e mut xF, c mut table.Table[byte], res int, sp int, ops int) {
    // syscall の引数に使う rdi / rsi / r8 / r10 は割り当ての組（callee-saved の規約）— 積んで戻す
    saved := []int{x86.Rdi, x86.Rsi, x86.R8, x86.R10}
    for k <- iter.Range(0, len(saved)) {
        x86.PushReg(mut c, saved[k])
    }
    xGetInto(mut e, mut c, sp, x86.Rax)
    x86.SubRegImm(mut c, x86.Rax, 16)
    xGetInto(mut e, mut c, xAt(mut st, ops, 0), x86.Rcx)
    x86.MovMemReg(mut c, x86.Rax, 0, x86.Rcx)
    xGetInto(mut e, mut c, xAt(mut st, ops, 1), x86.Rcx)
    x86.MovMemReg(mut c, x86.Rax, 8, x86.Rcx)
    xGetInto(mut e, mut c, xAt(mut st, ops, 2), x86.Rdx)
    x86.MovRegReg(mut c, x86.R8, x86.Rdx)
    x86.MovRegReg(mut c, x86.Rsi, x86.Rax)
    x86.MovRegImm32(mut c, x86.Rdi, 855808)
    x86.MovRegImm32(mut c, x86.Rdx, 0)
    x86.MovRegImm32(mut c, x86.R10, 0)
    x86.MovRegImm32(mut c, x86.Rax, 56)
    x86.Syscall(mut c)
    x86.CmpRegImm(mut c, x86.Rax, 0)
    parent := x86.JccRel32(mut c, x86.CondNe)
    // 子: [rsp] = fn・[rsp + 8] = arg
    x86.PopReg(mut c, x86.R11)
    x86.CallReg(mut c, x86.R11)
    x86.MovRegImm32(mut c, x86.Rax, 60)
    x86.MovRegImm32(mut c, x86.Rdi, 0)
    x86.Syscall(mut c)
    x86.PatchRel32(mut c, parent, x86.Here(mut c))
    mut k := len(saved)
    while k > 0 {
        k -= 1
        x86.PopReg(mut c, saved[k])
    }
    if res >= 0 {
        xPut(mut e, mut c, res, x86.Rax)
    }
}

// xTrapFs は罠の表の fs の変位（std/par を使うプログラムではワーカーの表 — 段 6 P4-4。それ以外は -1 = 大域の番地）
func xTrapFs(st mut St) int {
    return if st.taskUse && xg(mut st, st.trapG + G_WSLOT) >= 0 { 8 * xg(mut st, st.trapG + G_WSLOT) } else { -1 }
}

// xTrapBase は rax = 罠の表の番地（ワーカーの表なら fs:[fsd] の 1 命令・大域なら mov imm32 + fixup）
func xTrapBase(c mut table.Table[byte], fx mut table.Table[int], g int, fsd int) {
    if fsd >= 0 {
        x86.MovRegFs(mut c, x86.Rax, fsd)
    } else {
        x86.MovRegImm32(mut c, x86.Rax, 0)
        xFixAdd(mut fx, x86.Here(mut c) - 4, 2, g)
    }
}

// xExit はプロセスの終わり（grp = スレッドを持ちうるプログラム〔std/par〕は exit_group 231 — 全ワーカーを終える。それ以外は今までどおり exit 60）
func xExit(c mut table.Table[byte], code int, grp bool) {
    x86.MovRegImm32(mut c, x86.Rax, if grp { 231 } else { 60 })
    x86.MovRegImm32(mut c, x86.Rdi, code)
    x86.Syscall(mut c)
}

// xHex は v の 16 桁の 16 進
func xHex(out mut []byte, v int) {
    for k <- iter.Range(0, 16) {
        d := (v >> (60 - 4 * k)) & 15
        out = append(out, byte(if d < 10 { '0' + d } else { 'a' + d - 10 }))
    }
}
