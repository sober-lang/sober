package analyzer

// error のラベル集合の導出（language.md 13 節。今は影: 消費者は開発用の `check --errors-dump` だけ）。
// 抽象値 = ラベル集合（2 語のビット集合 LSet — flow.sober。添字 = リンク時のタグ = loader のラベル表の順。TOP = 不明）。値は「その式の error の成分」だけを見る:
// error の成分を持たない式の集合は、error の位置（戻りの error の成分・error の仮引数・error の欄）へ流れないので、過大（TOP）でも結果を汚さない —
// 分からない名前・添字の読み・関数値の呼び出しは TOP に倒す（健全の側）。
// 集合の置き場（スロット — az.er の解き手 — flow.sober）: 関数 fi の戻り R[fi] = スロット fi・ラベル L の cause C[L] = nfn + L（wrap の地点の内側の合併 — 裁定 C-b）・
// 関数の仮引数 P[fi][j]（呼び手の実引数の合併 — 裁定 P-b。公開関数の error の仮引数は TOP）・error 型の struct の欄（欄の名前ごとの合併 — 閉世界）。
// package をまたぐ呼び出しは呼び先の `@errors` の宣言を読む（裁定 E2 — 無ければ導出。公開関数に宣言が無いことは declare.sober が拒否する）。
// 展開される関数 F の匿名の関数型の仮引数 r（結果が error?）の呼び出しの値は擬ラベル FLOW（符号のビット — ラベルの容量を食わない）で、呼んだ r を Cand[F] に記す。
// FLOW が F の戻り R[F] に届けば Flow[F] = Cand[F]（ビット j = 仮引数 j — 呼んだ r のどれかの失敗が漏れうるなら呼んだ r 全部の過大近似）、
// 他の置き場（cause・仮引数・欄・switch の subject）に届いた FLOW は TOP（呼び出し点ごとに違う集合 — 関数の中では言えない）。包み替え `r()? L{}`・握って返さない形は漏れない。
// F の呼び出し点ごとに、Flow の位置の実引数のラベルが合流する（ラムダ = 本体の値・名前つき関数 = その集合・呼び手自身の仮引数 = 呼び手の FLOW へ —
// language.md 13 節「仮引数の名前の @errors」）。
// 解き方: スロットを読んだ関数を読み手として登録し、スロットが広がったら読み手を作業の列へ（不動点 — 格子の高さはラベル数）。
// 関数の中は流れに鈍感（局所の名前ごとの合併 — シャドーイング禁止なので名前で引ける）で、局所が広がらなくなるまで本体を歩き直す

import "ast"
import "desugar"
import "std/iter"
import "std/table"

// ── 型式・名前の小道具 ──

// 型式 te が error か error?
func isErrTy(az mut Az, te desugar.NodeRef) bool {
    t := if te != -1 && kind(mut az, te) == ast.TOpt { desugar.NodeRef(node(mut az, te).a) } else { te }
    return t != -1 && kind(mut az, t) == ast.TName && desugar.StrIs(mut az.d, desugar.StrRef(node(mut az, t).a), "error")
}

// 名前が大文字で始まるか
func isPublic(az mut Az, s desugar.StrRef) bool {
    c := desugar.Dat(mut az.d, int(s) + 1)
    return desugar.Dat(mut az.d, int(s)) > 0 && c >= 'A' && c <= 'Z'
}

func fnDecl(az mut Az, fi int) ast.Node {
    return node(mut az, desugar.FnAt(mut az.d, fi).node)
}

// 型パターン / リテラルの名前（"N" か "ref.N"）の error ラベルのタグ（無ければ -1）
func labelOf(az mut Az, name desugar.StrRef) int {
    r := desugar.ResolveVariant(mut az.d, az.pk, name)
    return if r.kind == desugar.TopVariant && r.idx == desugar.ERRS { r.sub } else { -1 }
}

// error 型の欄の名前 name のスロット（無ければ -1）
func fieldSlot(az mut Az, name desugar.StrRef) int {
    for i <- iter.Range(0, table.Len(mut az.ffield) / 2) {
        if desugar.StrEq(mut az.d, desugar.StrRef(table.Get(mut az.ffield, i * 2)), name) {
            return table.Get(mut az.ffield, i * 2 + 1)
        }
    }
    return -1
}

// 今の関数の仮引数 name の添字（無ければ -1）
func paramIdx(az mut Az, name desugar.StrRef) int {
    ps := desugar.ListRef(fnDecl(mut az, az.cur).c)
    for j <- iter.Range(0, desugar.LenL(mut az.d, ps)) {
        if desugar.StrEq(mut az.d, desugar.StrRef(node(mut az, nat(mut az, ps, j)).a), name) {
            return j
        }
    }
    return -1
}

// 名前の集合: 局所 → 仮引数（error 型なら P のスロット）→ トップレベル（関数・const — error の値でない）
func ident(az mut Az, name desugar.StrRef) LSet {
    i := envFind(mut az, name)
    if i != -1 {
        return envGet(mut az, i)
    }
    j := paramIdx(mut az, name)
    if j != -1 {
        p := nat(mut az, desugar.ListRef(fnDecl(mut az, az.cur).c), j)
        return if isErrTy(mut az, desugar.NodeRef(node(mut az, p).b)) { readSlot(mut az, table.Get(mut az.pbase, az.cur) + j) } else { lsNone() }
    }
    return lsNone()
}

// 関数 fi の仮引数 name の添字（無ければ -1）
func paramOf(az mut Az, fi int, name desugar.StrRef) int {
    ps := desugar.ListRef(fnDecl(mut az, fi).c)
    for j <- iter.Range(0, desugar.LenL(mut az.d, ps)) {
        if desugar.StrEq(mut az.d, desugar.StrRef(node(mut az, nat(mut az, ps, j)).a), name) {
            return j
        }
    }
    return -1
}

// 関数 fi の仮引数 j が匿名の関数型で結果に error を持つか（Flow の対象 — 名前つき関数型の仮引数は対象外）
func flowParam(az mut Az, fi int, j int) bool {
    t := desugar.NodeRef(node(mut az, nat(mut az, desugar.ListRef(fnDecl(mut az, fi).c), j)).b)
    if j >= PBITS || t == -1 || kind(mut az, t) != ast.TFunc {
        return false
    }
    rs := desugar.ListRef(node(mut az, t).b)
    for i <- iter.Range(0, desugar.LenL(mut az.d, rs)) {
        if isErrTy(mut az, nat(mut az, rs, i)) {
            return true
        }
    }
    return false
}

// 式 e が今の関数の Flow の対象の仮引数の名前ならその添字（でなければ -1）
func curFlowParam(az mut Az, e desugar.NodeRef) int {
    if kind(mut az, e) != ast.EIdent {
        return -1
    }
    name := desugar.StrRef(node(mut az, e).a)
    j := if envFind(mut az, name) == -1 { paramIdx(mut az, name) } else { -1 }
    return if j != -1 && flowParam(mut az, az.cur, j) { j } else { -1 }
}

// 名前が局所か仮引数か（関数値の呼び出しの判定）
func isLocal(az mut Az, name desugar.StrRef) bool {
    return envFind(mut az, name) != -1 || paramIdx(mut az, name) != -1
}

// ── 準備と不動点 ──

// 表を立てる（スロット R・C・P と error 型の欄の名前）
func errInit(az mut Az) {
    az.nfn = desugar.Nfn(mut az.d)
    az.nerr = desugar.NErr(mut az.d)
    for fi <- iter.Range(0, az.nfn) {
        newSlot(mut az, lsNone())
        table.Push(mut az.er.inq, 0)
        fd := fnDecl(mut az, fi)
        rs := desugar.ListRef(fd.d)
        mut ef := 0
        for i <- iter.Range(0, desugar.LenL(mut az.d, rs)) {
            if isErrTy(mut az, nat(mut az, rs, i)) {
                ef = 1
            }
        }
        table.Push(mut az.errfn, ef)
    }
    for L <- iter.Range(0, az.nerr) {
        newSlot(mut az, lsNone())
        table.Push(mut az.lit, 0)
    }
    for fi <- iter.Range(0, az.nfn) {
        declPush(mut az, fi)
        table.Push(mut az.dflow, declaredFlow(mut az, fi))
    }
    az.flowBase = table.Len(mut az.er.rhead)
    for fi <- iter.Range(0, az.nfn) {
        newSlot(mut az, lsNone())
        table.Push(mut az.cand, 0)
    }
    for fi <- iter.Range(0, az.nfn) {
        fd := fnDecl(mut az, fi)
        table.Push(mut az.pbase, table.Len(mut az.er.rhead))
        pub := isPublic(mut az, desugar.StrRef(fd.a))
        ps := desugar.ListRef(fd.c)
        for j <- iter.Range(0, desugar.LenL(mut az.d, ps)) {
            e := isErrTy(mut az, desugar.NodeRef(node(mut az, nat(mut az, ps, j)).b))
            newSlot(mut az, if e && pub { lsTop() } else { lsNone() })
        }
    }
    for f <- iter.Range(0, desugar.Nfile(mut az.d)) {
        ts := desugar.ListRef(desugar.NodeOf(mut az.d, desugar.FileRoot(mut az.d, f)).c)
        for i <- iter.Range(0, desugar.LenL(mut az.d, ts)) {
            body := desugar.NodeRef(node(mut az, nat(mut az, ts, i)).c)
            if body != -1 && kind(mut az, body) == ast.BStruct {
                fs := desugar.ListRef(node(mut az, body).a)
                for k <- iter.Range(0, desugar.LenL(mut az.d, fs)) {
                    fl := node(mut az, nat(mut az, fs, k))
                    if isErrTy(mut az, desugar.NodeRef(fl.b)) && fieldSlot(mut az, desugar.StrRef(fl.a)) == -1 {
                        table.Push(mut az.ffield, fl.a)
                        table.Push(mut az.ffield, newSlot(mut az, lsNone()))
                    }
                }
            }
        }
    }
}

// 全関数を作業の列に積み、スロットが広がらなくなるまで歩く。最後に 1 周、switch を記録しながら歩く
func errSolve(az mut Az) {
    for fi <- iter.Range(0, az.nfn) {
        enqueue(mut az, fi)
    }
    mut h := 0
    while h < table.Len(mut az.er.work) {
        fi := table.Get(mut az.er.work, h)
        h += 1
        table.Set(mut az.er.inq, fi, 0)
        walkFn(mut az, fi)
        az.walks += 1
    }
    az.rec = true
    for fi <- iter.Range(0, az.nfn) {
        walkFn(mut az, fi)
    }
    az.rec = false
}

// 関数 fi の本体を、局所が広がらなくなるまで歩く
func walkFn(az mut Az, fi int) {
    body := desugar.NodeRef(fnDecl(mut az, fi).e)
    if body == -1 {
        return
    }
    az.cur = fi
    az.pk = desugar.FnAt(mut az.d, fi).pkg
    az.er.envN = 0
    mut again := true
    mut n := 0
    while again && n < 16 {
        az.er.envChanged = false
        blockVal(mut az, body)
        again = az.er.envChanged
        n += 1
    }
    if lsIsFlow(slotGet(mut az, fi)) {
        addSlot(mut az, az.flowBase + fi, LSet{lo: table.Get(mut az.cand, fi), hi: 0})
    }
}

// ── 式と文（集合 = その式の error の成分）──

// ブロックの節（KBlock / EBlock）の文を歩き、値（末尾の式文）の集合を返す
func blockVal(az mut Az, b desugar.NodeRef) LSet {
    if b == -1 {
        return lsNone()
    }
    l := desugar.ListRef(node(mut az, b).a)
    n := desugar.LenL(mut az.d, l)
    mut v := lsNone()
    for i <- iter.Range(0, n) {
        s := nat(mut az, l, i)
        if i + 1 == n && kind(mut az, s) == ast.SExpr {
            v = ev(mut az, desugar.NodeRef(node(mut az, s).a))
        } else {
            est(mut az, s)
        }
    }
    return v
}

// if の else（ブロックか else-if）の集合
func elseVal(az mut Az, e desugar.NodeRef) LSet {
    if e == -1 {
        return lsNone()
    }
    k := kind(mut az, e)
    return if k == ast.EBlock || k == ast.KBlock { blockVal(mut az, e) } else { ev(mut az, e) }
}

func evList(az mut Az, l desugar.ListRef) LSet {
    mut v := lsNone()
    if l == -1 {
        return lsNone()
    }
    for i <- iter.Range(0, desugar.LenL(mut az.d, l)) {
        v = lsOr(v, ev(mut az, nat(mut az, l, i)))
    }
    return v
}

// 文 1 つ
func est(az mut Az, s desugar.NodeRef) {
    x := node(mut az, s)
    k := x.kind
    if k == ast.SBind {
        names := desugar.ListRef(x.a)
        vals := desugar.ListRef(x.c)
        nn := desugar.LenL(mut az.d, names)
        nv := desugar.LenL(mut az.d, vals)
        if nn == nv {
            for i <- iter.Range(0, nn) {
                envAdd(mut az, desugar.StrRef(desugar.LatI(mut az.d, names, i)), ev(mut az, nat(mut az, vals, i)))
            }
        } else {
            // 多値の分解（`x, err := f()`）: 集合は error の成分だけなので、全部の名前に同じ集合（error でない名前には流れても害が無い）
            m := evList(mut az, vals)
            for i <- iter.Range(0, nn) {
                envAdd(mut az, desugar.StrRef(desugar.LatI(mut az.d, names, i)), m)
            }
        }
    } else if k == ast.SAssign {
        ts := desugar.ListRef(x.a)
        vals := desugar.ListRef(x.c)
        nt := desugar.LenL(mut az.d, ts)
        nv := desugar.LenL(mut az.d, vals)
        all := if nt != nv { evList(mut az, vals) } else { lsNone() }
        for i <- iter.Range(0, nt) {
            m := if nt == nv { ev(mut az, nat(mut az, vals, i)) } else { all }
            assignTo(mut az, nat(mut az, ts, i), m)
        }
    } else if k == ast.SRet {
        retVals(mut az, desugar.ListRef(x.a))
    } else if k == ast.SExpr || k == ast.SDefer || k == ast.SYield {
        ev(mut az, desugar.NodeRef(x.a))
    } else if k == ast.SWhile {
        ev(mut az, desugar.NodeRef(x.a))
        blockVal(mut az, desugar.NodeRef(x.b))
    }
    // 末尾の return: 本体の末尾の if 文の腕が値を返す呼び出しで終わると、check がその if を本体の値として型付けして def error になる（摩擦）
    return
}

// 代入の行き先 t へ集合 m（名前 → 局所・欄 → error 型の欄のスロット・添字 → 歩くだけ）
func assignTo(az mut Az, t desugar.NodeRef, m LSet) {
    x := node(mut az, t)
    if x.kind == ast.EIdent {
        envAdd(mut az, desugar.StrRef(x.a), m)
    } else if x.kind == ast.ESelector {
        ev(mut az, desugar.NodeRef(x.a))
        addSlot(mut az, fieldSlot(mut az, desugar.StrRef(x.b)), m)
    } else {
        ev(mut az, t)
    }
    // 末尾の return: est と同じ
    return
}

// return の値: 今の関数の結果の error の位置の集合を R へ（ラムダの本体の return も囲みの関数から — 10 節）
func retVals(az mut Az, vals desugar.ListRef) {
    rs := desugar.ListRef(fnDecl(mut az, az.cur).d)
    nw := desugar.LenL(mut az.d, rs)
    nv := desugar.LenL(mut az.d, vals)
    if nv == nw {
        for i <- iter.Range(0, nv) {
            m := ev(mut az, nat(mut az, vals, i))
            if isErrTy(mut az, nat(mut az, rs, i)) {
                addSlot(mut az, az.cur, m)
            }
        }
        return
    }
    // `return g()` の転送（g の error の成分がそのまま）
    m := evList(mut az, vals)
    if table.Get(mut az.errfn, az.cur) != 0 {
        addSlot(mut az, az.cur, m)
    }
}

// 式を歩いて error の成分の集合を返す
func ev(az mut Az, e desugar.NodeRef) LSet {
    if e == -1 {
        return lsNone()
    }
    x := node(mut az, e)
    k := x.kind
    switch k {
    case ast.EIdent:
        return ident(mut az, desugar.StrRef(x.a))
    case ast.ECall:
        return callVal(mut az, desugar.NodeRef(x.a), desugar.ListRef(x.b), desugar.NodeRef(-1), lsNone())
    case ast.EPipe:
        lm := ev(mut az, desugar.NodeRef(x.a))
        return callVal(mut az, desugar.NodeRef(x.b), desugar.ListRef(x.c), desugar.NodeRef(x.a), lm)
    case ast.ETry:
        m := ev(mut az, desugar.NodeRef(x.a))
        w := desugar.NodeRef(x.b)
        if w == -1 {
            if az.trySink == 0 {
                addSlot(mut az, az.cur, m)
            }
        } else {
            wx := node(mut az, w)
            evElems(mut az, desugar.ListRef(wx.b))
            L := labelOf(mut az, desugar.StrRef(wx.a))
            if az.trySink == 0 {
                addSlot(mut az, az.cur, lsBit(L))
            }
            if L != -1 {
                addSlot(mut az, az.nfn + L, m)
            }
        }
        return lsNone()
    case ast.EComposite:
        return composite(mut az, x)
    case ast.ESelector:
        ev(mut az, desugar.NodeRef(x.a))
        s := fieldSlot(mut az, desugar.StrRef(x.b))
        return if s == -1 { lsNone() } else { readSlot(mut az, s) }
    case ast.EIf:
        ev(mut az, desugar.NodeRef(x.a))
        return lsOr(blockVal(mut az, desugar.NodeRef(x.b)), elseVal(mut az, desugar.NodeRef(x.c)))
    case ast.ESwitch:
        return switchVal(mut az, e, x)
    case ast.EBlock:
        return blockVal(mut az, e)
    case ast.ELambda:
        ps := desugar.ListRef(x.a)
        // 宣言つきの名前付き関数型 F の値になるラムダ（fntype.sober）: F の Flow の対象の仮引数を積み、本体の集合を最後の 1 周で記録する
        key := desugar.LamKey(mut az.d, e)
        member := key != -1 && fnErrs(mut az, key) != -1
        sb := az.lamBase
        sn := az.lamFN
        sc := az.lamCand
        if member {
            az.lamBase = az.lamFN
            az.lamCand = 0
        }
        for i <- iter.Range(0, desugar.LenL(mut az.d, ps)) {
            pn := desugar.StrRef(node(mut az, nat(mut az, ps, i)).a)
            envAdd(mut az, pn, lsTop())
            if member && fnFlowParam(mut az, key, i) {
                lamPush(mut az, pn, i)
            }
        }
        // 値 = 本体の値の集合（Flow の実引数として呼び出し点で読む — callVal。他の位置では関数値は error の位置へ流れない）
        body := desugar.NodeRef(x.b)
        bk := kind(mut az, body)
        v := if bk == ast.EBlock || bk == ast.KBlock { blockVal(mut az, body) } else { ev(mut az, body) }
        if member {
            lamRecord(mut az, e, key, v, az.lamCand)
            az.lamBase = sb
            az.lamFN = sn
            az.lamCand = sc
        }
        return v
    case ast.EFor:
        gs := desugar.ListRef(x.a)
        for i <- iter.Range(0, desugar.LenL(mut az.d, gs)) {
            g := node(mut az, nat(mut az, gs, i))
            ev(mut az, desugar.NodeRef(g.b))
            ns := desugar.ListRef(g.a)
            for j <- iter.Range(0, desugar.LenL(mut az.d, ns)) {
                envAdd(mut az, desugar.StrRef(desugar.LatI(mut az.d, ns, j)), lsTop())
            }
            evList(mut az, desugar.ListRef(g.c))
        }
        if x.b == 0 {
            ev(mut az, desugar.NodeRef(x.c))
        } else {
            stmts := desugar.ListRef(x.c)
            for i <- iter.Range(0, desugar.LenL(mut az.d, stmts)) {
                est(mut az, nat(mut az, stmts, i))
            }
        }
        return lsNone()
    case ast.EIndex:
        ev(mut az, desugar.NodeRef(x.a))
        ev(mut az, desugar.NodeRef(x.b))
        return lsTop()
    case ast.EBinary:
        ev(mut az, desugar.NodeRef(x.b))
        ev(mut az, desugar.NodeRef(x.c))
        return lsNone()
    case ast.EUnary:
        ev(mut az, desugar.NodeRef(x.b))
        return lsNone()
    case ast.ESlice3:
        ev(mut az, desugar.NodeRef(x.a))
        ev(mut az, desugar.NodeRef(x.b))
        ev(mut az, desugar.NodeRef(x.c))
        return lsNone()
    case ast.EInterp | ast.ESlicelit:
        evList(mut az, desugar.ListRef(x.b))
        return lsNone()
    case ast.EMaplit:
        es := desugar.ListRef(x.c)
        for i <- iter.Range(0, desugar.LenL(mut az.d, es)) {
            en := node(mut az, nat(mut az, es, i))
            ev(mut az, desugar.NodeRef(en.a))
            ev(mut az, desugar.NodeRef(en.b))
        }
        return lsNone()
    }
    return lsNone()
}

func evElems(az mut Az, l desugar.ListRef) {
    for i <- iter.Range(0, desugar.LenL(mut az.d, l)) {
        ev(mut az, desugar.NodeRef(node(mut az, nat(mut az, l, i)).b))
    }
}

// リテラル: error ラベルなら {L}。struct なら error 型の欄へ値の集合を流す（位置指定の欄は宣言の順で名前を引く）
func composite(az mut Az, x ast.Node) LSet {
    name := desugar.StrRef(x.a)
    els := desugar.ListRef(x.b)
    L := labelOf(mut az, name)
    if L != -1 {
        // ラベルのリテラルは cause を書けない = cause が nil の値
        if L < table.Len(mut az.lit) {
            table.Set(mut az.lit, L, 1)
        }
        evElems(mut az, els)
        return lsBit(L)
    }
    r := desugar.ResolveType(mut az.d, az.pk, name)
    body := if r.kind == desugar.TopType { desugar.NodeRef(node(mut az, desugar.NodeRef(r.idx)).c) } else { desugar.NodeRef(-1) }
    fs := if body != -1 && kind(mut az, body) == ast.BStruct { desugar.ListRef(node(mut az, body).a) } else { desugar.ListRef(-1) }
    for i <- iter.Range(0, desugar.LenL(mut az.d, els)) {
        el := node(mut az, nat(mut az, els, i))
        m := ev(mut az, desugar.NodeRef(el.b))
        fname := if el.a == -1 && fs != -1 && i < desugar.LenL(mut az.d, fs) { desugar.StrRef(node(mut az, nat(mut az, fs, i)).a) } else { desugar.StrRef(el.a) }
        if fname != -1 {
            addSlot(mut az, fieldSlot(mut az, fname), m)
        }
    }
    return lsNone()
}

// 呼び出しの callee の関数の表の添字（-1 = 関数でない — 組み込み・変換・型の構築。-2 = 関数値 — 中が見えない）
func calleeFn(az mut Az, callee desugar.NodeRef) int {
    c := if kind(mut az, callee) == ast.EIndex { desugar.NodeRef(node(mut az, callee).a) } else { callee }
    x := node(mut az, c)
    if x.kind == ast.EIdent {
        name := desugar.StrRef(x.a)
        if isLocal(mut az, name) {
            return -2
        }
        return desugar.ResolveFn(mut az.d, az.pk, name)
    }
    if x.kind == ast.ESelector && kind(mut az, desugar.NodeRef(x.a)) == ast.EIdent {
        ref := desugar.StrRef(node(mut az, desugar.NodeRef(x.a)).a)
        if isLocal(mut az, ref) {
            return -2
        }
        fi := desugar.ResolveSelFn(mut az.d, az.pk, ref, desugar.StrRef(x.b))
        return if fi == -1 { -1 } else { fi }
    }
    return -2
}

// 呼び出し callee(args)（pipe なら左辺 lhs — 穴 -1 の位置か先頭 — の集合 lm）の集合。実引数の集合は呼び先の error の仮引数の P へ
func callVal(az mut Az, callee desugar.NodeRef, args desugar.ListRef, lhs desugar.NodeRef, lm LSet) LSet {
    fi := calleeFn(mut az, callee)
    fp := if fi == -2 { curFlowParam(mut az, callee) } else { -1 }
    // F の値のラムダの Flow の対象の仮引数の呼び出し・宣言つきの名前付き関数型 F の値の呼び出し（fntype.sober）
    lf := if fi == -2 && fp == -1 { lamFlowIdx(mut az, callee) } else { -1 }
    fd := if fi == -2 && fp == -1 && lf == -1 { fnCallDecl(mut az, callee) } else { -1 }
    if fi == -2 {
        ev(mut az, callee)
    }
    // 呼び先の Flow（読み手に登録 — 広がったらこの関数を歩き直す）。F の値の呼び出しは宣言の仮引数の名前の項
    fl := if fi >= 0 { flowOf(mut az, fi) } else if fd != -1 { fnDeclFlow(mut az, fd) } else { 0 }
    mut extra := lsNone()
    n := desugar.LenL(mut az.d, args)
    mut j := 0
    mut hole := false
    for i <- iter.Range(0, n) {
        a := nat(mut az, args, i)
        if a == -1 {
            hole = true
        }
    }
    if lhs != -1 && !hole {
        argTo(mut az, fi, 0, lm)
        if (fl & 1) != 0 {
            extra = lsOr(extra, flowArg(mut az, lhs, lm))
        }
        j = 1
    }
    // task.Run の本体の `?` は scope の失敗（関数の戻りへ流さない）
    sink := fi >= 0 && desugar.ParKey(mut az.d, fi) == desugar.PAR_SCOPE
    if sink {
        az.trySink += 1
    }
    for i <- iter.Range(0, n) {
        a := nat(mut az, args, i)
        m := if a == -1 { lm } else { ev(mut az, a) }
        argTo(mut az, fi, j, m)
        if j < PBITS && (fl & (1 << j)) != 0 {
            extra = lsOr(extra, flowArg(mut az, if a == -1 { lhs } else { a }, m))
        }
        j += 1
    }
    if sink {
        az.trySink -= 1
    }
    if fp != -1 {
        // 今の関数の匿名の関数型の仮引数の呼び出し: 失敗は呼び出し点ごとに実引数のラベル — 擬ラベル FLOW（戻りに届けば Flow へ — walkFn）
        table.Set(mut az.cand, az.cur, table.Get(mut az.cand, az.cur) | (1 << fp))
        return lsFlow()
    }
    if lf != -1 {
        az.lamCand = az.lamCand | (1 << lf)
        return lsNone()
    }
    if fd != -1 {
        return lsOr(fnSet(mut az, fd), extra)
    }
    if fi == -2 {
        az.unknown += 1
        return lsTop()
    }
    if fi >= 0 && desugar.ParOpenErr(mut az.d, fi) {
        // task.Run の err は ChildDied か、Join も Try もしなかった子の err（P3b-4 1b' — 本体で生んだ error を返す task の err の合併。
        // 子のラムダの集合を scope ごとに集める形は未実装 — 開いた集合として扱う〔網羅の主張をしない〕）。task.Map（scope を開く std の口）も同じ
        return lsTop()
    }
    if fi == -1 || table.Get(mut az.errfn, fi) == 0 {
        return lsNone()
    }
    return lsOr(fnLabels(mut az, fi), extra)
}

// 関数 fi（error を返す）の集合
func fnLabels(az mut Az, fi int) LSet {
    if declHas(mut az, fi) && desugar.FnAt(mut az.d, fi).pkg != desugar.FnAt(mut az.d, az.cur).pkg {
        // package をまたぐ呼び出しは宣言を読む（裁定 E2 — 依存 package の中を解析しない 29 節の合成と同じ答えになる。宣言と導出の食い違いは宣言側の package で拒否する）
        return declGet(mut az, fi)
    }
    return lsNoFlow(readSlot(mut az, fi))
}

// 関数 fi の Flow（package をまたぐ宣言つきの呼び先は宣言の仮引数の名前 — 裁定 E2 と同じ）
func flowOf(az mut Az, fi int) int {
    if declHas(mut az, fi) && desugar.FnAt(mut az.d, fi).pkg != desugar.FnAt(mut az.d, az.cur).pkg {
        return table.Get(mut az.dflow, fi)
    }
    return readSlot(mut az, az.flowBase + fi).lo
}

// Flow の位置の実引数 a（集合 m — ラムダなら本体の値）の失敗のラベル: ラムダは本体の値・名前つき関数はその集合・
// 呼び手自身の Flow の対象の仮引数は呼び手の FLOW（推移）・他（局所の関数値など）は TOP
func flowArg(az mut Az, a desugar.NodeRef, m LSet) LSet {
    k := kind(mut az, a)
    if k == ast.ELambda {
        return m
    }
    lj := lamFlowIdx(mut az, a)
    if lj != -1 {
        az.lamCand = az.lamCand | (1 << lj)
        return lsNone()
    }
    p := curFlowParam(mut az, a)
    if p != -1 {
        table.Set(mut az.cand, az.cur, table.Get(mut az.cand, az.cur) | (1 << p))
        return lsFlow()
    }
    if k == ast.EIdent || k == ast.ESelector {
        g := calleeFn(mut az, a)
        if g >= 0 {
            return if table.Get(mut az.errfn, g) == 0 { lsNone() } else { fnLabels(mut az, g) }
        }
    }
    return lsTop()
}

// 関数 fi の j 番目の仮引数が error 型なら、実引数の集合 m を P へ
func argTo(az mut Az, fi int, j int, m LSet) {
    if fi < 0 || lsEmpty(m) {
        return
    }
    ps := desugar.ListRef(fnDecl(mut az, fi).c)
    if j < desugar.LenL(mut az.d, ps) && isErrTy(mut az, desugar.NodeRef(node(mut az, nat(mut az, ps, j)).b)) {
        addSlot(mut az, table.Get(mut az.pbase, fi) + j, m)
    }
}

// switch: subject の集合 S、腕の束縛（ラベルの型パターンは {L}・その cause は C[L]・他の束縛は TOP）、腕の値の合併。
// error ラベルの型パターンを持つ単一の subject の switch は最後の 1 周で記録する（S・覆ったラベル・default の有無）
func switchVal(az mut Az, e desugar.NodeRef, x ast.Node) LSet {
    subs := desugar.ListRef(x.a)
    S0 := evList(mut az, subs)
    S := if lsIsFlow(S0) { lsOr(lsNoFlow(S0), lsTop()) } else { S0 }
    single := desugar.LenL(mut az.d, subs) == 1
    cs := desugar.ListRef(x.b)
    mut covered := lsNone()
    mut isErr := false
    mut v := lsNone()
    for i <- iter.Range(0, desugar.LenL(mut az.d, cs)) {
        c := node(mut az, nat(mut az, cs, i))
        ps := desugar.ListRef(c.a)
        for j <- iter.Range(0, desugar.LenL(mut az.d, ps)) {
            p := nat(mut az, ps, j)
            px := node(mut az, p)
            if px.kind == ast.KPType {
                L := labelOf(mut az, desugar.StrRef(px.b))
                if L != -1 {
                    // 多値の subject（`case _, L{…}:` — check の断片外）は列ごとの集合を分けない: 記録は単一の subject だけ
                    isErr = single
                    covered = lsOr(covered, lsBit(L))
                    envAdd(mut az, desugar.StrRef(px.a), lsBit(L))
                    labelFields(mut az, L, desugar.ListRef(px.c))
                } else {
                    bindTop(mut az, p)
                }
            } else if px.kind == ast.KPConst {
                alts := desugar.ListRef(px.a)
                for q <- iter.Range(0, desugar.LenL(mut az.d, alts)) {
                    a := nat(mut az, alts, q)
                    if kind(mut az, a) == ast.EIdent {
                        // 裸の識別子は未知なら束縛（syntax.md 9 節）— 束縛なら subject の集合
                        envAdd(mut az, desugar.StrRef(node(mut az, a).a), S)
                    } else {
                        ev(mut az, a)
                    }
                }
            }
        }
        v = lsOr(v, blockVal(mut az, desugar.NodeRef(c.b)))
    }
    hasDef := x.c != -1
    v = lsOr(v, blockVal(mut az, desugar.NodeRef(x.c)))
    if az.rec {
        exhNote(mut az, e)
    }
    if az.rec && isErr {
        // 腕ごとの記録 [switch の記録の添字, 腕のパターンの節, タグ]（到達しない腕の拒否 — 裁定 E4-d (ii)）。腕の中の switch が先に記録されるので、
        // 添字はここ（自分の記録を積む直前）で決める
        swi := table.Len(mut az.sw) / SW_W
        for i <- iter.Range(0, desugar.LenL(mut az.d, cs)) {
            ps := desugar.ListRef(node(mut az, nat(mut az, cs, i)).a)
            for j <- iter.Range(0, desugar.LenL(mut az.d, ps)) {
                p := nat(mut az, ps, j)
                if kind(mut az, p) == ast.KPType {
                    L := labelOf(mut az, desugar.StrRef(node(mut az, p).b))
                    if L != -1 {
                        table.Push(mut az.swarms, swi)
                        table.Push(mut az.swarms, int(p))
                        table.Push(mut az.swarms, L)
                    }
                }
            }
        }
        table.Push(mut az.sw, int(e))
        table.Push(mut az.sw, S.lo)
        table.Push(mut az.sw, S.hi)
        table.Push(mut az.sw, covered.lo)
        table.Push(mut az.sw, covered.hi)
        table.Push(mut az.sw, if hasDef { 1 } else { 0 })
        table.Push(mut az.swpk, az.pk)
    }
    return v
}

// ラベル L の型パターンの欄: `cause` は C[L]、cause の入れ子のラベルの型パターン（`cause: e A{…}`）は e が {A} でその欄を同じく、
// 他の欄（ラベルは error を持てない）と入れ子の束縛は TOP
func labelFields(az mut Az, L int, fps desugar.ListRef) {
    if fps == -1 {
        return
    }
    for i <- iter.Range(0, desugar.LenL(mut az.d, fps)) {
        fp := node(mut az, nat(mut az, fps, i))
        sub := desugar.NodeRef(fp.b)
        isCause := desugar.StrIs(mut az.d, desugar.StrRef(fp.a), "cause")
        A := if isCause && sub != -1 && kind(mut az, sub) == ast.KPType { labelOf(mut az, desugar.StrRef(node(mut az, sub).b)) } else { -1 }
        if sub == -1 {
            m := if isCause { readSlot(mut az, az.nfn + L) } else { lsNone() }
            envAdd(mut az, desugar.StrRef(fp.a), m)
        } else if A != -1 {
            envAdd(mut az, desugar.StrRef(node(mut az, sub).a), lsBit(A))
            labelFields(mut az, A, desugar.ListRef(node(mut az, sub).c))
        } else {
            bindTop(mut az, sub)
        }
    }
}

// パターン p の中の束縛の名前を全部 TOP に（ラベルでない型パターン・入れ子）
func bindTop(az mut Az, p desugar.NodeRef) {
    if p == -1 {
        return
    }
    x := node(mut az, p)
    if x.kind == ast.KPType {
        envAdd(mut az, desugar.StrRef(x.a), lsTop())
        fps := desugar.ListRef(x.c)
        if fps != -1 {
            for i <- iter.Range(0, desugar.LenL(mut az.d, fps)) {
                fp := node(mut az, nat(mut az, fps, i))
                if fp.b == -1 {
                    envAdd(mut az, desugar.StrRef(fp.a), lsTop())
                } else {
                    bindTop(mut az, desugar.NodeRef(fp.b))
                }
            }
        }
    } else if x.kind == ast.KPConst {
        alts := desugar.ListRef(x.a)
        for q <- iter.Range(0, desugar.LenL(mut az.d, alts)) {
            a := nat(mut az, alts, q)
            if kind(mut az, a) == ast.EIdent {
                envAdd(mut az, desugar.StrRef(node(mut az, a).a), lsTop())
            }
        }
    }
}
