package loader

// interface 視点のロード（check --pkg・language.md 29 節「interface 視点のローダ」）: <dir>/link.txt（iface -o が書くリンク集合）の順に、
// package target だけソースから・他の package は <dir>/<path>.sobi から読む（parser.ParseIface — 本体の無い func 宣言・@expand）。
// import を辿る発見ループは回さない（ロード順はリンク表が持つ）。以降の段は load と同じ（finish）

import "ast"
import "diag"
import "lexer"
import "parser"
import "std/iter"

// entry のプログラムを package target の視点で読む（main package のソースは entry — .sober ファイルか main のディレクトリ）
@errors(diag.ReadFail, diag.GrammarMismatch, diag.NoPkgDir, diag.EmbedReceiver, diag.EmbedPattern, diag.EmbedNoMatch, diag.EmbedRead, diag.EmbedFileUtf8, diag.PkgName, diag.RefCollide, diag.NotImported, diag.ImportCycle, diag.Noinline, diag.ErrorHoldsError, diag.RecursiveType, diag.ConstExpr, diag.LocalBuiltin, diag.LocalImport, diag.InternalImport, diag.LocalTop, diag.TParamBuiltin, diag.TParamTop, diag.DeclBuiltin, diag.VariantDup, diag.TopDup, diag.Shadow, diag.PureExprStmt, diag.NilCase, diag.LeadingZero, diag.NamedArg, diag.CatchLhs, diag.MultiBind, diag.MutAlias, diag.ForFallible, diag.FnArg, diag.FnOpt, diag.FnCap, diag.Sealed, diag.Identity, diag.PanicLabel, diag.AssertOutsideTest, diag.Layout, diag.TypeDecl, diag.JsonShape, diag.Intrinsic, diag.Par)
func LoadView(entry string, target string, dir string, sm map[string]string) (Program, error?) {
    lb, lok := readPath(dir + "/link.txt")
    if !lok {
        return Program{}, diag.ReadFail{at: diag.None()}
    }
    paths, pok := linesOf(lb)
    if !pok {
        return Program{}, diag.ReadFail{at: diag.None()}
    }
    return loadView(entry, target, paths, dir, []Sobi{}, sm)
}

// 視点の外の package の .sobi（path = package のパス・src = 中身）— 小分けの check がプロセス内で次の package の視点へ渡す
type Sobi struct {
    path string
    src []byte
    tree ast.Tree   // parse 済みの木（MakeSobi — 依存する側の視点ごとに parse し直さない）
    parsed bool     // tree が使えるか（parse に失敗した値は視点の読み込みが parse し直して同じ拒否を出す）
}

// package path の .sobi の中身 src を 1 度だけ parse して持つ（小分けの check の外側の region に置き、依存する全部の視点で共有する）
func MakeSobi(path string, src []byte) Sobi {
    t, err := parseSobi(src, 0)
    return Sobi{path, src, t, err == nil}
}

// LoadView のプロセス内版: リンク集合 paths の順に、target だけソースから・他は sobis（path で引く）から読む。
// 診断の位置のパスは `<path>.sobi`（ファイルは無い — 依存の .sobi の中の位置は引けない）
@errors(diag.ReadFail, diag.GrammarMismatch, diag.NoPkgDir, diag.EmbedReceiver, diag.EmbedPattern, diag.EmbedNoMatch, diag.EmbedRead, diag.EmbedFileUtf8, diag.PkgName, diag.RefCollide, diag.NotImported, diag.ImportCycle, diag.Noinline, diag.ErrorHoldsError, diag.RecursiveType, diag.ConstExpr, diag.LocalBuiltin, diag.LocalImport, diag.InternalImport, diag.LocalTop, diag.TParamBuiltin, diag.TParamTop, diag.DeclBuiltin, diag.VariantDup, diag.TopDup, diag.Shadow, diag.PureExprStmt, diag.NilCase, diag.LeadingZero, diag.NamedArg, diag.CatchLhs, diag.MultiBind, diag.MutAlias, diag.ForFallible, diag.FnArg, diag.FnOpt, diag.FnCap, diag.Sealed, diag.Identity, diag.PanicLabel, diag.AssertOutsideTest, diag.Layout, diag.TypeDecl, diag.JsonShape, diag.Intrinsic, diag.Par)
func LoadViewMem(entry string, target string, paths []string, sobis []Sobi, sm map[string]string) (Program, error?) {
    p, _, err := loadViewRaw(entry, target, paths, "", sobis, sm)
    return p, err
}

// LoadViewMem に加えて、loader の写しの前の生の木（ファイルごと — target のファイルは parse したまま・他は .sobi の木）を返す
// （iface.Emit が target の原文の形で .sobi を書くのに使う — 書き出しのたびにソースを読み直して parse し直さない）
@errors(diag.ReadFail, diag.GrammarMismatch, diag.NoPkgDir, diag.EmbedReceiver, diag.EmbedPattern, diag.EmbedNoMatch, diag.EmbedRead, diag.EmbedFileUtf8, diag.PkgName, diag.RefCollide, diag.NotImported, diag.ImportCycle, diag.Noinline, diag.ErrorHoldsError, diag.RecursiveType, diag.ConstExpr, diag.LocalBuiltin, diag.LocalImport, diag.InternalImport, diag.LocalTop, diag.TParamBuiltin, diag.TParamTop, diag.DeclBuiltin, diag.VariantDup, diag.TopDup, diag.Shadow, diag.PureExprStmt, diag.NilCase, diag.LeadingZero, diag.NamedArg, diag.CatchLhs, diag.MultiBind, diag.MutAlias, diag.ForFallible, diag.FnArg, diag.FnOpt, diag.FnCap, diag.Sealed, diag.Identity, diag.PanicLabel, diag.AssertOutsideTest, diag.Layout, diag.TypeDecl, diag.JsonShape, diag.Intrinsic, diag.Par)
func LoadViewMemRaw(entry string, target string, paths []string, sobis []Sobi, sm map[string]string) (Program, []ast.Tree, error?) {
    return loadViewRaw(entry, target, paths, "", sobis, sm)
}

@errors(diag.ReadFail, diag.GrammarMismatch, diag.NoPkgDir, diag.EmbedReceiver, diag.EmbedPattern, diag.EmbedNoMatch, diag.EmbedRead, diag.EmbedFileUtf8, diag.PkgName, diag.RefCollide, diag.NotImported, diag.ImportCycle, diag.Noinline, diag.ErrorHoldsError, diag.RecursiveType, diag.ConstExpr, diag.LocalBuiltin, diag.LocalImport, diag.InternalImport, diag.LocalTop, diag.TParamBuiltin, diag.TParamTop, diag.DeclBuiltin, diag.VariantDup, diag.TopDup, diag.Shadow, diag.PureExprStmt, diag.NilCase, diag.LeadingZero, diag.NamedArg, diag.CatchLhs, diag.MultiBind, diag.MutAlias, diag.ForFallible, diag.FnArg, diag.FnOpt, diag.FnCap, diag.Sealed, diag.Identity, diag.PanicLabel, diag.AssertOutsideTest, diag.Layout, diag.TypeDecl, diag.JsonShape, diag.Intrinsic, diag.Par)
func loadView(entry string, target string, paths []string, dir string, sobis []Sobi, sm map[string]string) (Program, error?) {
    p, _, err := loadViewRaw(entry, target, paths, dir, sobis, sm)
    return p, err
}

@errors(diag.ReadFail, diag.GrammarMismatch, diag.NoPkgDir, diag.EmbedReceiver, diag.EmbedPattern, diag.EmbedNoMatch, diag.EmbedRead, diag.EmbedFileUtf8, diag.PkgName, diag.RefCollide, diag.NotImported, diag.ImportCycle, diag.Noinline, diag.ErrorHoldsError, diag.RecursiveType, diag.ConstExpr, diag.LocalBuiltin, diag.LocalImport, diag.InternalImport, diag.LocalTop, diag.TParamBuiltin, diag.TParamTop, diag.DeclBuiltin, diag.VariantDup, diag.TopDup, diag.Shadow, diag.PureExprStmt, diag.NilCase, diag.LeadingZero, diag.NamedArg, diag.CatchLhs, diag.MultiBind, diag.MutAlias, diag.ForFallible, diag.FnArg, diag.FnOpt, diag.FnCap, diag.Sealed, diag.Identity, diag.PanicLabel, diag.AssertOutsideTest, diag.Layout, diag.TypeDecl, diag.JsonShape, diag.Intrinsic, diag.Par)
func loadViewRaw(entry string, target string, paths []string, dir string, sobis []Sobi, sm map[string]string) (Program, []ast.Tree, error?) {
    m := Manifest{entry, "", []string{}, "", ""}
    mut trees := mut []ast.Tree{}
    // 生の木（loader の写しの前 — iface.Emit が原文の形で書く）。trees は写した木（catch の束縛 — 以降の段が読む）
    mut raws := mut []ast.Tree{}
    mut fpkg := mut []string{}
    mut fpath := mut []string{}
    mut fstd := mut []bool{}
    for k <- iter.Range(0, len(paths)) {
        l := paths[k]
        if l == target {
            fs := viewFiles(m, sm, entry, l)
            if len(fs) == 0 {
                return Program{}, []ast.Tree{}, diag.NoPkgDir{at: diag.None()}
            }
            for q <- iter.Range(0, len(fs)) {
                fpath = append(fpath, fs[q])
                fstd = append(fstd, isStd(l))
                t, perr := parseFileRaw(m, true, sm, fs[q], isStd(l), len(trees))
                if perr != nil {
                    return located(freeze(fpath), freeze(fstd)), []ast.Tree{}, perr
                }
                trees = append(trees, catchExprs(t))
                raws = append(raws, t)
                fpkg = append(fpkg, l)
            }
        } else {
            sp := if dir == "" { l + ".sobi" } else { dir + "/" + l + ".sobi" }
            fpath = append(fpath, sp)
            fstd = append(fstd, false)
            pre := sobiPre(l, dir, sobis)
            // .sobi の本体は原文の形（catch 式のまま — iface.Emit）なので、ソースと同じく写してから以降の段へ
            if pre >= 0 {
                trees = append(trees, catchExprs(sobis[pre].tree))
                raws = append(raws, sobis[pre].tree)
            } else {
                src, sok := sobiSrc(sp, l, dir, sobis)
                if !sok {
                    return located(freeze(fpath), freeze(fstd)), []ast.Tree{}, diag.ReadFail{at: diag.None()}
                }
                t, perr := parseSobi(src, len(trees))
                if perr != nil {
                    return located(freeze(fpath), freeze(fstd)), []ast.Tree{}, perr
                }
                trees = append(trees, catchExprs(t))
                raws = append(raws, t)
            }
            fpkg = append(fpkg, l)
        }
    }
    rt := freeze(trees)
    rw := freeze(raws)
    rp := freeze(fpath)
    r, err := finish(rt, freeze(fpkg), rp, freeze(fstd))
    mut p := r
    p.std_src = sm
    // 生の木を finish の後の Program のファイルの並びにそろえる（finish は並べ替え・合成のファイル〔`$layout/…`〕の追加をする — パスで引く。
    // 合成のファイルは空の木 — iface.Emit は載せない・依存する側の loader が自分で合成する）
    mut raw := mut []ast.Tree{}
    for f <- iter.Range(0, len(p.file_path)) {
        raw = append(raw, rawOf(rw, rp, p.file_path[f]))
    }
    return p, freeze(raw), err
}

// parse した木の列 ts（パス ps と同じ並び）の中のパス path の木（無ければ空の木）
func rawOf(ts []ast.Tree, ps []string, path string) ast.Tree {
    for i <- iter.Range(0, len(ps)) {
        if ps[i] == path {
            return ts[i]
        }
    }
    return ast.Tree{[]ast.Node{}, []int{}, 0 - 1}
}

// sobis の中の package l の parse 済みの .sobi の添字（ファイルから読む視点・parse に失敗した値なら -1）
func sobiPre(l string, dir string, sobis []Sobi) int {
    if dir != "" {
        return -1
    }
    for i <- iter.Range(0, len(sobis)) {
        if sobis[i].path == l && sobis[i].parsed {
            return i
        }
    }
    return -1
}

// package l の .sobi の中身（dir が空なら sobis から・でなければファイル sp から）
func sobiSrc(sp string, l string, dir string, sobis []Sobi) ([]byte, bool) {
    if dir != "" {
        return readPath(sp)
    }
    for i <- iter.Range(0, len(sobis)) {
        if sobis[i].path == l {
            return sobis[i].src, true
        }
    }
    return []byte{}, false
}

// .sobi の `@expand` の付いた関数の添字（E2-S の逃げ — 依存の package の check が決めた判定 D'。付加の列の 7 番）
func ExpandMarked(p Program) []int {
    mut out := mut []int{}
    for k <- iter.Range(0, len(p.fn_node)) {
        t := p.trees[p.fn_file[k]]
        x := t.nodes[p.fn_node[k]]
        if x.f >= 0 && t.data[x.f] >= 8 && t.data[x.f + 8] != 0 {
            out = append(out, k)
        }
    }
    return freeze(out)
}

// 小分けの check の順（依存の package が先 — import の深さ優先の帰りがけ。同じ深さはロード順）の package の添字
func SplitOrder(p Program) []int {
    mut seen := mut []bool{}
    for k <- iter.Range(0, len(p.pkg_path)) {
        seen = append(seen, false)
    }
    mut out := mut []int{}
    for k <- iter.Range(0, len(p.pkg_path)) {
        splitVisit(p, k, mut seen, mut out)
    }
    return freeze(out)
}

func splitVisit(p Program, k int, seen mut []bool, out mut []int) {
    if seen[k] {
        return
    }
    seen[k] = true
    for e <- iter.Range(0, len(p.imp_pkg)) {
        if p.imp_pkg[e] == k {
            d := pathIndex(p.pkg_path, p.imp_path[e])
            if d >= 0 {
                splitVisit(p, d, mut seen, mut out)
            }
        }
    }
    out = append(out, k)
}

// package k の視点のリンク集合（k と、k が推移的に import する package）のパス。並びは k から import を辿る帰りがけ順
// （依存が先・k が最後 — 各 package の import の宣言順に辿る）。全体のロード順を使わないのは、並びを k と依存のソースだけで決めるため
// （同じ std の package の視点が entry によって変わらない — キャッシュの鍵の共有の前提）
func SplitLink(p Program, k int) []string {
    mut seen := mut []bool{}
    for j <- iter.Range(0, len(p.pkg_path)) {
        seen = append(seen, false)
    }
    mut ks := mut []int{}
    splitVisit(p, k, mut seen, mut ks)
    mut out := mut []string{}
    for i <- iter.Range(0, len(ks)) {
        out = append(out, p.pkg_path[ks[i]])
    }
    return freeze(out)
}


// 視点の package l のソースのファイル（main なら entry — .sober ファイルか main のディレクトリ）
func viewFiles(m Manifest, sm map[string]string, entry string, l string) []string {
    if l != "main" {
        return dirFiles(m, true, sm, l)
    }
    if isDir(entry) {
        return dirFiles(m, true, sm, entry)
    }
    return []string{entry}
}

// .sobi（interface）の中身を parse する（parser.ParseIface）
@errors(diag.GrammarMismatch)
func parseSobi(src []byte, fi int) (ast.Tree, error?) {
    ts := lexer.Lex(src)
    t, pok := parser.ParseIface(src, ts)
    if !pok {
        far := parser.FarthestTok(src, ts)
        return t, diag.GrammarMismatch{at: if far >= 0 { diag.Pos{file: fi, tok: far} } else { diag.None() }}
    }
    return t, nil
}

// 改行で割った空でない行（UTF-8 でなければ false）
func linesOf(b []byte) ([]string, bool) {
    mut ls := mut []string{}
    mut s := 0
    for i <- iter.Range(0, len(b) + 1) {
        if i == len(b) || b[i] == '\n' {
            if i > s {
                l := string(b[s:i]) catch return []string{}, false
                ls = append(ls, l)
            }
            s = i + 1
        }
    }
    return freeze(ls), true
}
