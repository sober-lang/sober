package binary

// バイト列の語単位の読み（1 バイトずつの読みを 1 回の検査 + 1 回の load に）。書きの対（Store64）は無い — 書くときは 1 バイトずつ積む

// 組み込みの宣言（本体なし。実装はコンパイラの表: loader/intrinsic.sober・lower の ioBuiltin）。検査なしの読み — 境界は下の Load64 の 1 か所だけで見る
@intrinsic("load64")
func sysLoad64(b []byte, i int) int

// b[i]〜b[i + 7] の 8 バイトを little-endian で読んだ int（b[i] が最下位のバイト）。i < 0 か i + 8 > len(b) なら panic(OutOfRange{i, len(b)})
// （検査は 1 か所 — `i > len(b) - 8` は len(b) ≥ 0 なので桁あふれしない）
@effects(panic)
func Load64(b []byte, i int) int {
    if i < 0 || i > len(b) - 8 {
        outOfRange(i, len(b))
    }
    return sysLoad64(b, i)
}

// Load64 / MatchLen の契約違反の panic（本体を小さく保つ — 呼び出し点に展開される大きさに）
func outOfRange(i int, n int) {
    panic(OutOfRange{i: i, n: n})
}

// Load64 / MatchLen の読みが b の外にはみ出した（呼び手の契約違反 — panic ラベル。language.md 27 節）
type OutOfRange panic {
    i int
    n int
}

// 一致の長さの組み込み（検査なし — 境界は下の MatchLen の 1 か所だけで見る・rt.matchlen — x86 の最適化のバックエンドは手書きの本体）
@intrinsic("matchlen")
func sysMatchLen(b []byte, i int, j int, n int) int

// b[i:i+n] と b[j:j+n] の先頭からの一致の長さ（0〜n — 最初に食い違うバイトの位置・全部一致なら n）。区間は重なってよい。
// i < 0・j < 0・n < 0・i + n > len(b)・j + n > len(b) のどれかなら panic(OutOfRange{…})（検査は 1 か所 — 読むのは 2 つの区間の中だけ）。
// 最初の食い違いで止まるので時間は一致の長さに依る（秘密の比較には使わない — 定数時間の比較は std/crypto/ct）
@effects(panic)
func MatchLen(b []byte, i int, j int, n int) int {
    if i < 0 || j < 0 || n < 0 || i > len(b) - n || j > len(b) - n {
        outOfRange(if i > j { i } else { j }, len(b))
    }
    return sysMatchLen(b, i, j, n)
}
