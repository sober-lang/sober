package password

// BLAKE2bとArgon2idの核の検査（white-box）: RFC 7693付録A・RFC 9106 5.3と、golang.org/x/cryptoの格子
// （testdata/crypto/blake2b.txt・argon2id.txt — scripts/oracles/xcrypto）。BLAKE2b の格子はブロック 128 の前後と出力の長さ 1〜64・
// Argon2id の格子はパス 1〜3・レーン 1〜4・m が 4p で割り切れない値・番地のブロックの作り直し（1 スライス 128 ブロック超）・H' の長さ（64 以下 / 65 / 100 / 1024）を跨ぐ

import "std/convert"
import "std/crypto"
import "std/hex"
import "std/iter"
import "std/strings"

@embed("testdata/crypto/blake2b.txt")
const blake2bGrid = map[string]string{}

@embed("testdata/crypto/argon2id.txt")
const argon2idGrid = map[string]string{}

func rep(b int, n int) []byte {
    mut o := mut []byte{}
    for i <- iter.Range(0, n) {
        o = append(o, byte(b))
    }
    return freeze(o)
}

func TestBlake2bRfc7693() {
    w, _ := hex.Parse("ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923")
    ok := crypto.Equal(blake2b(bytes("abc"), 64), w)
    assert(ok)
    println("conf: rfc7693/blake2b 1")
}

func TestBlake2bGrid() {
    lines := strings.Split(strings.TrimSpace(embedded(blake2bGrid, "testdata/crypto/blake2b.txt")), "\n")
    assert(len(lines) == 55)
    println("conf: xcrypto/blake2b ${len(lines)}")
    for li <- iter.Range(0, len(lines)) {
        f := strings.Fields(lines[li])
        l, _ := convert.ParseInt(f[0])
        n, _ := convert.ParseInt(f[1])
        want, _ := hex.Parse(f[2])
        ok := crypto.Equal(blake2b(pat(l, 3), n), want)
        assert(ok)
    }
}

func TestArgon2idRfc9106() {
    w, _ := hex.Parse("0d640df58d78766c08c037a34a8b53c9d01ef0452d75b65eb52520e96b01e659")
    ok := crypto.Equal(argon2idKey(rep(1, 32), rep(2, 16), rep(3, 8), rep(4, 12), 3, 32, 4, 32), w)
    assert(ok)
    println("conf: rfc9106/argon2id 1")
}

func TestArgon2idGrid() {
    lines := strings.Split(strings.TrimSpace(embedded(argon2idGrid, "testdata/crypto/argon2id.txt")), "\n")
    assert(len(lines) == 19)
    println("conf: xcrypto/argon2id ${len(lines)}")
    for li <- iter.Range(0, len(lines)) {
        f := strings.Fields(lines[li])
        pl, _ := convert.ParseInt(f[0])
        sl, _ := convert.ParseInt(f[1])
        t, _ := convert.ParseInt(f[2])
        m, _ := convert.ParseInt(f[3])
        p, _ := convert.ParseInt(f[4])
        n, _ := convert.ParseInt(f[5])
        want, _ := hex.Parse(f[6])
        ok := crypto.Equal(argon2idKey(pat(pl, 1), pat(sl, 2), []byte{}, []byte{}, t, m, p, n), want)
        assert(ok)
    }
}
