package hmac

// HMAC-SHA256（RFC 2104 / FIPS 198-1）。
// 鍵の長さだけが分岐に効く（公開の値）— 中身は SHA-256 の圧縮関数を通るだけで定数時間。tag の照合は crypto.Equal で
//
//     tag := crypto.hmac.Sum256(key, msg)

import "std/crypto/sha256"
import "std/iter"

// key で msg の HMAC-SHA256（32 バイト）。鍵が 64 バイトを超えれば SHA-256 で縮めてから使う
@secret(key)
@effects(!io, !block, !nondet)
func Sum256(key []byte, msg []byte) []byte {
    k := if len(key) > crypto.sha256.BlockSize { crypto.sha256.Sum256(key) } else { key }
    mut ip := mut []byte{}
    mut op := mut []byte{}
    for i <- iter.Range(0, crypto.sha256.BlockSize) {
        b := if i < len(k) { int(k[i]) } else { 0 }
        ip = append(ip, byte(b ^ 0x36))
        op = append(op, byte(b ^ 0x5c))
    }
    mut s := crypto.sha256.New()
    crypto.sha256.Write(mut s, freeze(ip))
    crypto.sha256.Write(mut s, msg)
    inner := crypto.sha256.Sum(s)
    mut o := crypto.sha256.New()
    crypto.sha256.Write(mut o, freeze(op))
    crypto.sha256.Write(mut o, inner)
    return crypto.sha256.Sum(o)
}
