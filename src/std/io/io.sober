package io

import "std/utf8"

// 組み込みの宣言（息継ぎ ③ — 本体なし。鍵の実装はコンパイラの表: loader/intrinsic.sober・desugar / lower の SysKey）
@intrinsic("read_file")
func sysReadFile(path string) []byte

@intrinsic("errno")
func sysErrno() int

@intrinsic("write_file")
func sysWriteFile(path string, b []byte) int

@intrinsic("write_fd")
func sysWriteFd(fd int, b []byte) int

@intrinsic("read_fd")
func sysReadFd(fd int, n int) []byte

@intrinsic("read_dir")
func sysReadDir(path string) []byte

@intrinsic("open")
func sysOpen(path string) int

@intrinsic("close")
func sysClose(fd int) int

@intrinsic("chunk_open")
func sysChunkOpen(fd int, size int, gens int, off int) int

@intrinsic("chunk_next")
func sysChunkNext(rec int) []byte

@intrinsic("chunk_close")
func sysChunkClose(rec int) int

// ファイルの読み書き（同期 syscall の直呼び — Executor・block 効果は持ち込まない。Phase 5a で中身を差し替えても
// API は同期形のまま）。バイト列は []byte（33 節 — byte の段 C で []int から切り替え）。
// text として読むなら `s := string(io.ReadFile(p)?)?`（std/utf8 の検査つき）

// ENOENT / ENOTDIR
type NotFound error

// EACCES / EPERM / EROFS
type Denied error

// 開いたバケツ（13 節「正直な宣言」）: 上の 2 つ以外の errno。EISDIR・EINVAL（path に NUL）・ENAMETOOLONG など
type Other error {
    errno int
}

// errno → ラベル（Linux x86_64 の番号）
func errOf(e int) error {
    if e == 2 || e == 20 {
        return NotFound{}
    }
    if e == 13 || e == 1 || e == 30 {
        return Denied{}
    }
    return Other{errno: e}
}

// Stream は標準ストリーム（language.md 28 節「標準ストリーム」— Stdin / Stdout / Stderr の 3 つだけ）。プロセスの寿命で開いていて Close が無く、
// コピーしても害が無い値の型（同一性なし — Open が返す同一性の型 io.File とは別の型: 2026-10-13 の裁定 Qa4）。fd の番号は値にしない —
// 非公開の型の封の欄 seal があるので外からは欄つきで書けず（utf8.View と同じ形）、int と Stream の間の変換の口は無い。番号は std と rt の中にだけある。
// ゼロ値 `io.Stream{}` は番号 0（Writer の欄としては標準出力へ読み替える — 下の Writer）
type Stream struct {
    fd int
    seal streamSeal
}

// streamSeal は Stream の封（非公開 — 外で値を書けない）
type streamSeal struct {
}

// 標準ストリーム（開いている fd 0 / 1 / 2）
const Stdin = Stream{fd: 0, seal: streamSeal{}}
const Stdout = Stream{fd: 1, seal: streamSeal{}}
const Stderr = Stream{fd: 2, seal: streamSeal{}}

// File は Open で開いたファイル（language.md 28 節「資源とストリーム」— 同一性を持つ型: 作る口は Open だけ・後始末は同じブロックの
// `defer io.Close(f)`・写せない・外へ出せない・give: では渡せない — 子は path から自分で開く。desugar/filecheck の規則）。fd の番号は封の欄の中で、std と rt の外に出ない。
// 標準ストリームの Stream とは別の型（Stream はプロセスの寿命・Close なし・写して害なし — 裁定 Qa4）
type File struct {
    fd int
    seal fileSeal
}

// fileSeal は File の封（非公開 — 外で値を書けない）
type fileSeal struct {
}

// Open は path のファイルを読むために開く（O_RDONLY）。開いたら同じブロックの直後の文で `defer io.Close(f)` を書く
@errors(NotFound, Denied, Other)
func Open(path string) (File, error?) {
    fd := sysOpen(path)
    if fd < 0 {
        return File{fd: -1, seal: fileSeal{}}, errOf(0 - fd)
    }
    return File{fd: fd, seal: fileSeal{}}, nil
}

// Close は f を閉じる（Open の直後の defer でだけ書ける — desugar/filecheck。閉じる失敗は返さない: 読むためだけに開いた fd の close の失敗に打つ手は無い）
func Close(f File) {
    _ = sysClose(f.fd)
}

// ReadAll は f を今の位置から EOF まで全部読む（ReadFile の開いた File 版）。途中で失敗したら error（読めた分は捨てる）
@errors(NotFound, Denied, Other)
func ReadAll(f File) ([]byte, error?) {
    b := sysReadFd(f.fd, -1)
    e := sysErrno()
    if e != 0 {
        return []byte{}, errOf(e)
    }
    return b, nil
}

// Bytes は読むだけのバイト列の View（Chunks / Lines の切片 — language.md 28 節「読みのストリーム」）。作れるのは std/io だけ（封 — utf8.View と同じ形）。
// 中身は rt のスロット（貸出中の pool — region-domain-pool.md 4c 節）を指し、for の 1 反復の間だけ有効: 反復の外の変数への代入・return・送りは
// 境界の写しになる（region の規則 — 外へは写してしか出せない）。書きの口は無い
type Bytes struct {
    b []byte
    seal bytesSeal
}

// bytesSeal は Bytes の封（非公開 — 外で値を書けない）
type bytesSeal struct {
}

// Raw は v のバイト列（読むだけ — 同じ反復の中の View）
func Raw(v Bytes) []byte {
    return v.b
}

// 切片の大きさと世代の段数（案 P の既定 — 64 KiB × 2 のダブルバッファ。口は後便: Web 波の pool: 引数か、生成元の名前つき引数〔PINS〕とセットで）
const chunkSize = 65536
const chunkGens = 2

// Chunks は f を今の位置から EOF まで切片ずつ k へ渡す（失敗しうる生成元 — `for c <- io.Chunks(f)? { … }`）。切片は 1 回の読みの分
// （通常のファイルは最後以外 64 KiB）。次の切片の読みは前の切片を渡している間に先に出す（ダブルバッファ）。読みの失敗は errno のラベル
@errors(NotFound, Denied, Other)
func Chunks(f File, k func(Bytes)) error? {
    return chunksFrom(f, -1, k)
}

// ChunksAt は f の off バイト目から EOF まで切片ずつ k へ渡す（Chunks と同じ切片・先読み — 読みは pread の形で f の位置を動かさない。
// off が EOF 以上なら空の列・off < 0 は Other{errno: 22}）
@errors(NotFound, Denied, Other)
func ChunksAt(f File, off int, k func(Bytes)) error? {
    if off < 0 {
        return Other{errno: 22}
    }
    return chunksFrom(f, off, k)
}

// chunksFrom は Chunks / ChunksAt の本体（off = -1 は今の位置から read — 抜けたら先読みの分を巻き戻す）
@errors(NotFound, Denied, Other)
func chunksFrom(f File, off int, k func(Bytes)) error? {
    rec := sysChunkOpen(f.fd, chunkSize, chunkGens, off)
    defer chunkEnd(rec)
    while true {
        b := sysChunkNext(rec)
        if len(b) == 0 {
            e := sysErrno()
            if e != 0 {
                return errOf(e)
            }
            return nil
        }
        k(Bytes{b: b, seal: bytesSeal{}})
    }
    return nil
}

// chunkEnd はストリームを閉じる（出した読みの完了を待ってからスロットを返す）
func chunkEnd(rec int) {
    _ = sysChunkClose(rec)
}

// Lines は f の行を順に k へ渡す（区切り = '\n'・行末の '\r' は落とす・最後の行は改行が無くても渡す — Go の bufio.ScanLines と同じ）。
// 行は切片の部分 View で、切片をまたぐ行だけ std の中で写す
@errors(NotFound, Denied, Other)
func Lines(f File, k func(Bytes)) error? {
    mut carry := mut []byte{}
    for c <- Chunks(f)? {
        b := c.b
        mut s := 0
        while s < len(b) {
            // 区切りを探す内側のループは呼び出しを持たない（反復ごとの region を開かない — 行の受け渡しは行ごとに 1 回）
            mut i := s
            while i < len(b) && b[i] != '\n' {
                i += 1
            }
            if i == len(b) {
                // 切片の終わりまで区切りが無い: 次の切片へ持ち越す
                mut j := s
                while j < len(b) {
                    carry = append(carry, b[j])
                    j += 1
                }
                s = len(b)
            } else {
                if len(carry) == 0 {
                    k(Bytes{b: dropCR(b[s:i]), seal: bytesSeal{}})
                } else {
                    k(Bytes{b: dropCR(joined(carry, b[s:i])), seal: bytesSeal{}})
                    carry = mut []byte{}
                }
                s = i + 1
            }
        }
    }
    if len(carry) > 0 {
        k(Bytes{b: dropCR(joined(carry, []byte{})), seal: bytesSeal{}})
    }
    return nil
}

// dropCR は末尾の '\r' を 1 つ落とす
func dropCR(b []byte) []byte {
    if len(b) > 0 && b[len(b) - 1] == '\r' {
        return b[0:len(b) - 1]
    }
    return b
}

// joined は a + b の新しいバイト列（切片をまたぐ行の写し）
func joined(a []byte, b []byte) []byte {
    mut out := mut []byte{}
    for x <- a {
        out = append(out, x)
    }
    for x <- b {
        out = append(out, x)
    }
    return freeze(out)
}

// path のファイルを全部読む
@errors(NotFound, Denied, Other)
func ReadFile(path string) ([]byte, error?) {
    b := sysReadFile(path)
    e := sysErrno()
    if e != 0 {
        return []byte{}, errOf(e)
    }
    return b, nil
}

// path に b を書く（作成 / 切り詰め、0644）。/dev/stdout への追記には使わない（切り詰める）— WriteStdout を使う
@errors(NotFound, Denied, Other)
func WriteFile(path string, b []byte) error? {
    e := sysWriteFile(path, b)
    if e != 0 {
        return errOf(e)
    }
    return nil
}

// WriteStdout は開いている標準出力（fd 1）へ b を書く（open しないので切り詰めない）。println の行バッファに残りがあれば先に出す
// （出る順 = 呼んだ順。ただし std/par の task の中では println の行は spawn の木の先行順で出る〔溜まりうる〕ので、直書きとの順は約束しない —
// language.md 11 節 P4 の裁定）
@errors(NotFound, Denied, Other)
func WriteStdout(b []byte) error? {
    e := sysWriteFd(1, b)
    if e != 0 {
        return errOf(e)
    }
    return nil
}

// ReadStdin は標準入力（fd 0）を EOF まで全部読む（同期 — Unix フィルタの入口。text なら `string(io.ReadStdin()?)?`）。
// 途中で失敗したら error（読めた分は捨てる）
@errors(NotFound, Denied, Other)
func ReadStdin() ([]byte, error?) {
    b := sysReadFd(0, -1)
    e := sysErrno()
    if e != 0 {
        return []byte{}, errOf(e)
    }
    return b, nil
}

// WriteStderr は開いている標準エラー（fd 2）へ b を書く（WriteStdout と同じ規則）
@errors(NotFound, Denied, Other)
func WriteStderr(b []byte) error? {
    e := sysWriteFd(2, b)
    if e != 0 {
        return errOf(e)
    }
    return nil
}

// ディレクトリの項目の種類（getdents64 の d_type）。Regular = 通常のファイル・Irregular = 上の 3 つ以外（fifo・socket・デバイス・DT_UNKNOWN）
type EntryKind union {
    Regular {}
    Dir {}
    Symlink {}
    Irregular {}
}

type DirEntry struct {
    Name string
    Kind EntryKind
}

func kindOf(t int) EntryKind {
    if t == 8 {
        return Regular{}
    }
    if t == 4 {
        return Dir{}
    }
    if t == 10 {
        return Symlink{}
    }
    return Irregular{}
}

// dot は名前が "." か ".." か
func dot(nb []byte) bool {
    return (len(nb) == 1 && nb[0] == '.') || (len(nb) == 2 && nb[0] == '.' && nb[1] == '.')
}

// less は名前のバイト列の辞書順（LC_ALL=C sort と同じ）
func less(a string, b string) bool {
    x := bytes(a)
    y := bytes(b)
    mut i := 0
    while i < len(x) && i < len(y) && x[i] == y[i] {
        i += 1
    }
    return if i < len(x) && i < len(y) { x[i] < y[i] } else { len(x) < len(y) }
}

// ReadDir は path の項目を名前のバイト順で返す（`.` / `..` は含めない — Go の os.ReadDir と同じ）。
// 並びはファイルシステムの列挙順に依らない（loader の決定性 — 29 節）。名前が 1 つでも不正な UTF-8 なら全体が utf8.InvalidUtf8
@errors(NotFound, Denied, Other, utf8.InvalidUtf8)
func ReadDir(path string) ([]DirEntry, error?) {
    // 「d_type + 名前のバイト + 0」の連結（getdents64 の順のまま）
    b := sysReadDir(path)
    e := sysErrno()
    if e != 0 {
        return []DirEntry{}, errOf(e)
    }
    mut es := mut []DirEntry{}
    mut i := 0
    while i < len(b) {
        mut j := i + 1
        while b[j] != 0 {
            j += 1
        }
        nb := b[i + 1:j]
        if !dot(nb) {
            name := string(nb)?
            es = append(es, DirEntry{Name: name, Kind: kindOf(int(b[i]))})
        }
        i = j + 1
    }
    // 挿入ソート（1 ディレクトリの項目数なので素朴でよい — 並べ替えは es の中だけで、region を伸ばさない）
    mut k := 1
    while k < len(es) {
        x := es[k]
        mut m := k
        while m > 0 && less(x.Name, es[m - 1].Name) {
            es[m] = es[m - 1]
            m -= 1
        }
        es[m] = x
        k += 1
    }
    return freeze(es), nil
}

// Writer は書きバッファ（定常メモリで流す — 64 KiB の枠を添字で使い回し、満杯で書き出す。溜め込んで最後に 1 回書く形の RSS の回避）:
//
//     mut w := io.Writer{}            // ゼロ値は標準出力へ書く（欄 to のゼロ値 = 番号 0 は標準出力へ読み替える — 標準入力へは書かない）。標準エラーへは io.SetFile(mut w, io.Stderr)
//     io.WriteString(mut w, "hello\n")
//     io.WriteByte(mut w, 'x')
//     err := io.Flush(mut w)          // 残りを書き出す — 最後に Flush しないと枠に残った分は書かれない
//
// 書き出しの失敗は err に貯め（以後の書き出しはしない）、Flush が返す（bufio と同じ「後で返す」）。
// 構築の関数（WriterOf）を持たないのは、mut の欄を持つ struct を関数から返す形を check が受けないため（language.md 26 節 G3）— ゼロ値 + SetFile の口にした
type Writer struct {
    to Stream
    buf mut []byte
    n int
    err int
}

const writerSize = 65536

// SetFile は書き出す先を f に変える（io.Stdout / io.Stderr — 番号は Stream の中に閉じる）
func SetFile(w mut Writer, f Stream) {
    w.to = f
}

// WriteByte は 1 バイト書く（速い道 = 空きがあれば書いて進めるだけ — 呼び手に展開される大きさに保つ。満杯・初回は writerByteSlow）
func WriteByte(w mut Writer, c byte) {
    if w.n < len(w.buf) {
        w.buf[w.n] = c
        w.n += 1
    } else {
        writerByteSlow(mut w, c)
    }
}

// writerByteSlow は枠に空きを作ってから 1 バイト書く（WriteByte の遅い道 — 展開しない: 速い道を小さく保つ）
@noinline
func writerByteSlow(w mut Writer, c byte) {
    writerRoom(mut w)
    w.buf[w.n] = c
    w.n += 1
}

// WriteBytes はバイト列を書く（枠の空きの分ずつ — 内側は添字の写しの形で、最適化のバックエンドが一括の写しにする）
func WriteBytes(w mut Writer, b []byte) {
    mut i := 0
    while i < len(b) {
        if w.n == len(w.buf) {
            writerRoom(mut w)
        }
        at := w.n
        k := if len(b) - i < len(w.buf) - at { len(b) - i } else { len(w.buf) - at }
        mut j := 0
        while j < k {
            w.buf[at + j] = b[i + j]
            j += 1
        }
        w.n = at + k
        i += k
    }
}

// WriteString は文字列を書く
func WriteString(w mut Writer, s string) {
    WriteBytes(mut w, bytes(s))
}

// Flush は枠に残った分を書き出し、それまでの書き出しの失敗を返す（返したら失敗は消える）
@errors(NotFound, Denied, Other)
func Flush(w mut Writer) error? {
    writerSpill(mut w)
    if w.err != 0 {
        e := w.err
        w.err = 0
        return errOf(e)
    }
    return nil
}

// writerRoom は枠に空きを作る: 初回は枠を確保し、以後は満杯の枠を書き出して空にする
func writerRoom(w mut Writer) {
    if len(w.buf) == 0 {
        while len(w.buf) < writerSize {
            w.buf = append(w.buf, byte(0))
        }
        return
    }
    writerSpill(mut w)
}

// writerSpill は枠の中身を書き出して空にする（失敗を貯めた後は書かない）。満杯の枠はそのまま渡し、端数（Flush）は n バイトを写して渡す
// （mut の slice は切り出せない — 枠を freeze すると以後の書き込みが use-after-freeze になるので、端数だけ写す。写すのは Flush ごとに 64 KiB まで）
func writerSpill(w mut Writer) {
    if w.n > 0 && w.err == 0 {
        fd := if w.to.fd == 0 { 1 } else { w.to.fd }
        mut e := 0
        if w.n == len(w.buf) {
            e = sysWriteFd(fd, w.buf)
        } else {
            mut part := mut []byte{}
            mut i := 0
            while i < w.n {
                part = append(part, w.buf[i])
                i += 1
            }
            e = sysWriteFd(fd, freeze(part))
        }
        if e != 0 {
            w.err = e
        }
    }
    w.n = 0
}
