package layout

// @layout（language.md 36 節）の裏方: 利用者は `layout.Decode[T](b, off)`・`layout.DecodeAt[T](b, off, i)`・`layout.Encode[T](mut out, v)`・`layout.Size[T]` を書き、
// loaderの固定テンプレート（compiler/loader/layout.sober）が @layoutのstructごとの変換の関数（普通のSober）を合成し、呼び出しをその関数の呼び出しに変換する。
// ここに置くのは変換の関数が呼ぶ失敗の関数だけ（panicラベルWidthOverflow / LengthMismatch — exit 101・死亡時にフィールドが標準エラーへ。language.md 27 節のpanicの契約）

// 撤去条件: region を持つ型引数の実体 Def が言語に入ったら、Decode / Encode を std の総称関数 + コンパイラが出す `layout[T]` 静的辞書に移す

// std/builderは合成の変換の関数が使う（Encodeの仮引数Builder[byte] — このpackageを読めばstd/builderも読み込まれる）
import "std/builder"

// 書き込みの幅あふれ: フィールドfieldの値valueが幅widthに収まらない
type WidthOverflow panic {
    field string
    value int
    width string
}

// 固定長配列の長さ違い: フィールドfieldの長さがwantでなくgot
type LengthMismatch panic {
    field string
    want int
    got int
}

// 書き込みの幅あふれ: フィールドfieldの値vが幅widthに収まらない
@effects(panic)
func FailWidth(field string, width string, v int) {
    panic(WidthOverflow{field: field, value: v, width: width})
}

// 固定長配列の長さ違い: フィールドfieldの長さがwantでなくgot
@effects(panic)
func FailLength(field string, want int, got int) {
    panic(LengthMismatch{field: field, want: want, got: got})
}


// 以下はloaderが合成するAPI（stdに実体は無い — 呼び出しは型ごとの変換の関数へ変換される）。型引数Tは @layoutのstruct

// 合成: func Decode[T](b []byte, off int) T?
// b の off バイト目から T を 1 つ読む。バイトが足りなければ nil。符号つきの幅は符号拡張して読む
// 例: examples/layout_elf.sober

// 合成: func DecodeAt[T](b []byte, off int, i int) T?
// b の off バイト目から並ぶ T の i 番目を読む（間隔 = Size[T]）。バイトが足りなければ nil

// 合成: func Encode[T](out mut builder.Builder[byte], v T)
// vをoutの末尾に書く。フィールドの値が幅に収まらなければpanic(WidthOverflow)・固定長配列の長さが違えばpanic(LengthMismatch)
// 例: examples/layout_widths.sober

// 合成: const Size[T] int
// Tの静的な大きさ（バイト — フィールドの幅の和）。呼ばずに定数として書く: `layout.Size[T]`
