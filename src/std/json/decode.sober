package json

import "std/convert"
import "std/iter"

// shape[T] の裏方（language.md 16 節 2）: 利用者は `json.Decode[T](d, n)` を書き、loader の固定テンプレート（compiler/loader/jsonshape.sober）が
// struct T（とフィールドから届くstruct・`[]U`・`U?`）ごとの変換の関数（普通のSober）を合成し、呼び出しをその関数の呼び出しに変換する。ここに置くのは変換の関数が呼ぶ
// 部品（ノードの種類の検査・フィールドの引き・スカラーの解釈）と失敗のラベルだけ。フィールドの名前 = JSONのキー（Rename辞書は未実装 — 実需まで足さない）

// T? でないフィールドfieldが無い（pos = オブジェクトの位置）
type Missing error {
    pos int
    field string
}

// ノードの種類がフィールドの型に合わない（want = 期待したJSONの種類: object・array・string・number・int・bool）
type WrongType error {
    pos int
    want string
}

// intのフィールドの数がintに収まらない（小数・指数を含む数はWrongType{want: "int"}）
type IntOutOfRange error {
    pos int
}

// ノード n がオブジェクトなら n（でなければ WrongType）
@errors(WrongType)
@effects()
func NeedObject(d Doc, n int) (int, error?) {
    if d.kind[n] != kObj {
        return 0, WrongType{pos: d.pos[n], want: "object"}
    }
    return n, nil
}

// オブジェクトnのフィールドkeyの値のノード（無ければMissing）
@errors(Missing)
@effects()
func Need(d Doc, n int, key string) (int, error?) {
    return NeedAt(d, n, key, -1)
}

// Needに手掛かりの位置hintを足したもの（GetAtと同じ — 変換の関数はフィールドの宣言の位置を渡す）
@errors(Missing)
@effects()
func NeedAt(d Doc, n int, key string, hint int) (int, error?) {
    v := GetAt(d, n, key, hint)
    if v != nil {
        return v, nil
    }
    return 0, Missing{pos: d.pos[n], field: key}
}

// ノード n が null か
@effects()
func IsNull(d Doc, n int) bool {
    return d.kind[n] == kNull
}

// 配列 n の要素のノード（配列でなければ WrongType）
@errors(WrongType)
@effects()
func Items(d Doc, n int) ([]int, error?) {
    if d.kind[n] != kArr {
        return []int{}, WrongType{pos: d.pos[n], want: "array"}
    }
    return d.kids[d.a[n]:d.a[n] + d.b[n]], nil
}

// 文字列 n の中身
@errors(WrongType)
@effects()
func ParseString(d Doc, n int) (string, error?) {
    k := d.kind[n]
    if k != kStr && k != kStrEsc {
        return "", WrongType{pos: d.pos[n], want: "string"}
    }
    return text(d, n), nil
}

// true / false
@errors(WrongType)
@effects()
func ParseBool(d Doc, n int) (bool, error?) {
    k := d.kind[n]
    if k != kTrue && k != kFalse {
        return false, WrongType{pos: d.pos[n], want: "bool"}
    }
    return k == kTrue, nil
}

// 整数の字句（小数点・指数なし）の数を int に（範囲外は IntOutOfRange）
@errors(WrongType, IntOutOfRange)
@effects()
func ParseInt(d Doc, n int) (int, error?) {
    if d.kind[n] != kNum {
        return 0, WrongType{pos: d.pos[n], want: "int"}
    }
    a := d.a[n]
    b := d.b[n]
    neg := d.src[a] == '-'
    s := if neg { a + 1 } else { a }
    mut v := 0
    for i <- iter.Range(s, b) {
        c := d.src[i]
        if c < '0' || c > '9' {
            return 0, WrongType{pos: d.pos[n], want: "int"}
        }
        x := int(c) - 48
        // 負の側で積む（最小値まで表せる）: v * 10 - x >= 最小値 ⇔ v > 最小値 / 10 か、v = 最小値 / 10（-922337203685477580）で x <= 8
        if v < -922337203685477580 || (v == -922337203685477580 && x > 8) {
            return 0, IntOutOfRange{pos: d.pos[n]}
        }
        v = v * 10 - x
    }
    if neg {
        return v, nil
    }
    if v == -9223372036854775807 - 1 {
        return 0, IntOutOfRange{pos: d.pos[n]}
    }
    return 0 - v, nil
}

// 数を binary64 に（最近接・偶数への丸め — convert.ParseFloat。あふれは IntOutOfRange でなく WrongType{want: "float"}）
@errors(WrongType)
@effects()
func ParseFloat(d Doc, n int) (float, error?) {
    if d.kind[n] != kNum {
        return 0.0, WrongType{pos: d.pos[n], want: "number"}
    }
    f, err := convert.ParseFloat(bytesToString(d.src[d.a[n]:d.b[n]]))
    if err != nil {
        return 0.0, WrongType{pos: d.pos[n], want: "float"}
    }
    return f, nil
}

// 以下はloaderが合成するAPI（stdに実体は無い — 呼び出しは型ごとの変換の関数へ変換される）

// 合成: func Decode[T](d Doc, n int) (T, error?)
// ノードnを struct T に読む。フィールドの名前 = JSONのキー。Tのフィールドに書ける型はint・float・bool・string・struct・`[]U`・`U?`（U は前のどれか か json.Value —
// 裸のjson.Valueのフィールドは拒否: unionはゼロ値を持たない）。T = json.ValueはTreeと同じ（値の木）。
// 欠けたフィールドはMissing（`U?` のフィールドだけ欠けとnullをnilで受ける）・種類の合わないノードはWrongType・intのフィールドの範囲外はIntOutOfRange。余ったフィールドは無視する
// 例: examples/json_decode.sober

// 合成: func DecodeWith[T](d Doc, n int, rename map[string]string) (T, error?)
// Decodeのフィールド名の対応つき版（rename = フィールド名 → JSONのキー・入れ子のstructのフィールドにも同じ辞書が掛かる・対応の無いフィールドはフィールド名のまま）
