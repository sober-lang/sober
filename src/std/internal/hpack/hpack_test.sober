package hpack

// RFC 7541 付録Cの例（C.1〜C.6）・符号化と復号の往復・誤りの形・解いた量の上限（HPACKの爆弾）

import "std/iter"

// 16進の列（空白と改行は読み飛ばす）
func unhex(s string) []byte {
    b := bytes(s)
    mut r := mut []byte{}
    mut i := 0
    while i < len(b) {
        if int(b[i]) <= 0x20 {
            i += 1
        } else {
            r = append(r, byte(hex2(b, i)))
            i += 2
        }
    }
    return freeze(r)
}

func eqb(a []byte, b []byte) bool {
    if len(a) != len(b) {
        return false
    }
    for i <- iter.Range(0, len(a)) {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

func cat(r mut []byte, s []byte) {
    for i <- iter.Range(0, len(s)) {
        r = append(r, s[i])
    }
}

// 解いたヘッダの並びを "名前: 値\n" の列にする
func render(out []byte, fs []int) []byte {
    mut r := mut []byte{}
    mut k := 0
    while k < len(fs) {
        cat(mut r, out[fs[k]:fs[k] + fs[k + 1]])
        cat(mut r, bytes(": "))
        cat(mut r, out[fs[k + 2]:fs[k + 2] + fs[k + 3]])
        r = append(r, byte(10))
        k += 4
    }
    return freeze(r)
}

// 動的表の中身（新しい順に "名前: 値\n"）
func table(d Dec) []byte {
    mut r := mut []byte{}
    for k <- iter.Range(0, d.n) {
        e := ((d.first + d.n - 1 - k) & (entMax - 1)) * 3
        for j <- iter.Range(0, d.ents[e + 1]) {
            r = append(r, d.ring[(d.ents[e] + j) & ringMask])
        }
        cat(mut r, bytes(": "))
        for j <- iter.Range(0, d.ents[e + 2]) {
            r = append(r, d.ring[(d.ents[e] + d.ents[e + 1] + j) & ringMask])
        }
        r = append(r, byte(10))
    }
    return freeze(r)
}

// blkを解き、ヘッダの並び・動的表・大きさの和が期待どおりか
func step(d mut Dec, blk string, want string, tab string, size int) {
    mut out := mut []byte{}
    mut fs := mut []int{}
    st := Decode(mut d, unhex(blk), mut out, mut fs, 1 << 20)
    assert(st == Ok)
    assert(eqb(render(out, Fields(d, freeze(fs))), bytes(want)))
    assert(eqb(table(d), bytes(tab)))
    assert(d.size == size)
}

func setup(d mut Dec, max int) {
    Init(mut d)
    d.max = max
}

// C.1 整数の表現
func TestInt() {
    v1, q1 := readInt(unhex("0a"), 0, 5)
    assert(v1 == 10 && q1 == 1)
    v2, q2 := readInt(unhex("1f9a0a"), 0, 5)
    assert(v2 == 1337 && q2 == 3)
    v3, q3 := readInt(unhex("2a"), 0, 8)
    assert(v3 == 42 && q3 == 1)
    mut o := mut []byte{}
    putInt(mut o, 0, 5, 1337)
    assert(eqb(o, unhex("1f9a0a")))
    // 続きのバイトが切れている
    _, q4 := readInt(unhex("1f9a"), 0, 5)
    assert(q4 < 0)
    // 大きすぎる値
    _, q5 := readInt(unhex("1fffffffffff01"), 0, 5)
    assert(q5 < 0)
    for v <- iter.Range(0, 70000) {
        mut b := mut []byte{}
        putInt(mut b, 0x40, 6, v)
        w, q := readInt(b, 0, 6)
        assert(w == v && q == len(b) && (int(b[0]) & 0xc0) == 0x40)
    }
}

// C.2 1つずつのヘッダ
func TestC2() {
    mut d := Dec{}
    setup(mut d, 4096)
    step(mut d, "400a 6375 7374 6f6d 2d6b 6579 0d63 7573 746f 6d2d 6865 6164 6572", "custom-key: custom-header\n", "custom-key: custom-header\n", 55)
    mut d2 := Dec{}
    setup(mut d2, 4096)
    step(mut d2, "040c 2f73 616d 706c 652f 7061 7468", ":path: /sample/path\n", "", 0)
    mut d3 := Dec{}
    setup(mut d3, 4096)
    step(mut d3, "1008 7061 7373 776f 7264 0673 6563 7265 74", "password: secret\n", "", 0)
    mut d4 := Dec{}
    setup(mut d4, 4096)
    step(mut d4, "82", ":method: GET\n", "", 0)
}

// C.3 リクエスト（Huffmanなし）
func TestC3() {
    mut d := Dec{}
    setup(mut d, 4096)
    step(mut d, "8286 8441 0f77 7777 2e65 7861 6d70 6c65 2e63 6f6d",
        ":method: GET\n:scheme: http\n:path: /\n:authority: www.example.com\n", ":authority: www.example.com\n", 57)
    step(mut d, "8286 84be 5808 6e6f 2d63 6163 6865",
        ":method: GET\n:scheme: http\n:path: /\n:authority: www.example.com\ncache-control: no-cache\n",
        "cache-control: no-cache\n:authority: www.example.com\n", 110)
    step(mut d, "8287 85bf 400a 6375 7374 6f6d 2d6b 6579 0c63 7573 746f 6d2d 7661 6c75 65",
        ":method: GET\n:scheme: https\n:path: /index.html\n:authority: www.example.com\ncustom-key: custom-value\n",
        "custom-key: custom-value\ncache-control: no-cache\n:authority: www.example.com\n", 164)
}

// C.4 リクエスト（Huffman）
func TestC4() {
    mut d := Dec{}
    setup(mut d, 4096)
    step(mut d, "8286 8441 8cf1 e3c2 e5f2 3a6b a0ab 90f4 ff",
        ":method: GET\n:scheme: http\n:path: /\n:authority: www.example.com\n", ":authority: www.example.com\n", 57)
    step(mut d, "8286 84be 5886 a8eb 1064 9cbf",
        ":method: GET\n:scheme: http\n:path: /\n:authority: www.example.com\ncache-control: no-cache\n",
        "cache-control: no-cache\n:authority: www.example.com\n", 110)
    step(mut d, "8287 85bf 4088 25a8 49e9 5ba9 7d7f 8925 a849 e95b b8e8 b4bf",
        ":method: GET\n:scheme: https\n:path: /index.html\n:authority: www.example.com\ncustom-key: custom-value\n",
        "custom-key: custom-value\ncache-control: no-cache\n:authority: www.example.com\n", 164)
}

const c5r1 = ":status: 302\ncache-control: private\ndate: Mon, 21 Oct 2013 20:13:21 GMT\nlocation: https://www.example.com\n"
const c5t1 = "location: https://www.example.com\ndate: Mon, 21 Oct 2013 20:13:21 GMT\ncache-control: private\n:status: 302\n"
const c5r2 = ":status: 307\ncache-control: private\ndate: Mon, 21 Oct 2013 20:13:21 GMT\nlocation: https://www.example.com\n"
const c5t2 = ":status: 307\nlocation: https://www.example.com\ndate: Mon, 21 Oct 2013 20:13:21 GMT\ncache-control: private\n"
const c5r3 = ":status: 200\ncache-control: private\ndate: Mon, 21 Oct 2013 20:13:22 GMT\nlocation: https://www.example.com\ncontent-encoding: gzip\nset-cookie: foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1\n"
const c5t3 = "set-cookie: foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1\ncontent-encoding: gzip\ndate: Mon, 21 Oct 2013 20:13:22 GMT\n"

// C.5 レスポンス（Huffmanなし・表の大きさ256で追い出しが起きる）
func TestC5() {
    mut d := Dec{}
    setup(mut d, 256)
    step(mut d, "4803 3330 3258 0770 7269 7661 7465 611d 4d6f 6e2c 2032 3120 4f63 7420 3230 3133 2032 303a 3133 3a32 3120 474d 546e 1768 7474 7073 3a2f 2f77 7777 2e65 7861 6d70 6c65 2e63 6f6d",
        c5r1, c5t1, 222)
    step(mut d, "4803 3330 37c1 c0bf", c5r2, c5t2, 222)
    step(mut d, "88c1 611d 4d6f 6e2c 2032 3120 4f63 7420 3230 3133 2032 303a 3133 3a32 3220 474d 54c0 5a04 677a 6970 7738 666f 6f3d 4153 444a 4b48 514b 425a 584f 5157 454f 5049 5541 5851 5745 4f49 553b 206d 6178 2d61 6765 3d33 3630 303b 2076 6572 7369 6f6e 3d31",
        c5r3, c5t3, 215)
}

// C.6 レスポンス（Huffman・表の大きさ256）
func TestC6() {
    mut d := Dec{}
    setup(mut d, 256)
    step(mut d, "4882 6402 5885 aec3 771a 4b61 96d0 7abe 9410 54d4 44a8 2005 9504 0b81 66e0 82a6 2d1b ff6e 919d 29ad 1718 63c7 8f0b 97c8 e9ae 82ae 43d3",
        c5r1, c5t1, 222)
    step(mut d, "4883 640e ffc1 c0bf", c5r2, c5t2, 222)
    step(mut d, "88c1 6196 d07a be94 1054 d444 a820 0595 040b 8166 e084 a62d 1bff c05a 839b d9ab 77ad 94e7 821d d7f2 e6c7 b335 dfdf cd5b 3960 d5af 2708 7f36 72c1 ab27 0fb5 291f 9587 3160 65c0 03ed 4ee5 b106 3d50 07",
        c5r3, c5t3, 215)
}

func bad(blk string) {
    mut d := Dec{}
    setup(mut d, 4096)
    mut out := mut []byte{}
    mut fs := mut []int{}
    assert(Decode(mut d, unhex(blk), mut out, mut fs, 1 << 20) == Bad)
}

// 誤りの形はBad
func TestBad() {
    // 添字0・表の外の添字（静的表61まで・動的表は空）
    bad("80")
    bad("be")
    bad("7e00")
    // 表の大きさの更新がブロックの頭でない・上限4096を越える
    bad("823f e11f")
    bad("3fe21f")
    // 文字列の長さがブロックを越える・値が無い
    bad("0005 6162")
    bad("0003 616263")
    // Huffman: 8ビットの埋め草・0の埋め草・EOS（30ビットの1）
    bad("0081 ff 00")
    bad("0081 00 00")
    bad("0084 ffff fffc 00")
    // 整数が切れている
    bad("0f")
}

// 表の大きさの更新（頭なら何度でも）と追い出し
func TestSizeUpdate() {
    mut d := Dec{}
    setup(mut d, 4096)
    step(mut d, "400a 6375 7374 6f6d 2d6b 6579 0d63 7573 746f 6d2d 6865 6164 6572", "custom-key: custom-header\n", "custom-key: custom-header\n", 55)
    step(mut d, "20 3f e11f 82", ":method: GET\n", "", 0)
    assert(d.max == 4096)
}

// 乱数の列（xorshift）
func next(x int) int {
    mut v := x ^ (x << 13)
    v = v ^ (v >> 7)
    return v ^ (v << 17)
}

// 符号化（Field・Status）して解くと元に戻る。Huffmanの有り無し・名前の大文字・静的表の名前・全バイト
func TestRoundtrip() {
    mut x := 88172645463325252
    names := []string{"content-type", "Content-Length", "x-custom", "date", "server", "set-cookie", "x-a", "Vary"}
    for it <- iter.Range(0, 400) {
        mut blk := mut []byte{}
        mut want := mut []byte{}
        x = next(x)
        code := 100 + (x & 0x7fffffff) % 500
        Status(mut blk, code)
        cat(mut want, bytes(":status: "))
        want = append(want, byte(0x30 + (code / 100) % 10))
        want = append(want, byte(0x30 + (code / 10) % 10))
        want = append(want, byte(0x30 + code % 10))
        want = append(want, byte(10))
        x = next(x)
        nf := (x & 0x7fffffff) % 6
        for f <- iter.Range(0, nf) {
            x = next(x)
            nm := bytes(names[(x & 0x7fffffff) % len(names)])
            x = next(x)
            n := (x & 0x7fffffff) % 300
            mut v := mut []byte{}
            for j <- iter.Range(0, n) {
                x = next(x)
                // 半分は印字できる文字・半分は全バイト
                v = append(v, if it % 2 == 0 { byte(0x20 + (x & 0x7fffffff) % 95) } else { byte(x & 0xff) })
            }
            Field(mut blk, nm, v, it % 3 != 0)
            for j <- iter.Range(0, len(nm)) {
                want = append(want, lower(nm[j]))
            }
            cat(mut want, bytes(": "))
            cat(mut want, v)
            want = append(want, byte(10))
        }
        mut d := Dec{}
    setup(mut d, 4096)
        mut out := mut []byte{}
        mut fs := mut []int{}
        assert(Decode(mut d, blk, mut out, mut fs, 1 << 20) == Ok)
        assert(eqb(render(out, Fields(d, freeze(fs))), want))
        assert(d.n == 0)
    }
}

// 静的表の名前は添字で書く・表に無い名前は字句・:statusの表の値は1バイト
func TestEncodeForm() {
    mut b := mut []byte{}
    Field(mut b, bytes("Content-Type"), bytes("a"), false)
    assert(eqb(b, unhex("0f10 0161")))
    mut c := mut []byte{}
    Status(mut c, 200)
    Status(mut c, 418)
    assert(eqb(c, unhex("88 0803 343138")))
    mut e := mut []byte{}
    Field(mut e, bytes("www-authenticate"), bytes(""), false)
    assert(eqb(e, unhex("0f2e 00")))
    mut h := mut []byte{}
    huffEncode(mut h, bytes("www.example.com"))
    assert(eqb(h, unhex("f1e3 c2e5 f23a 6ba0 ab90 f4ff")))
}

// HPACKの爆弾: 大きい項目を1つ表に入れ、1バイトの添字で何度も引く。上限で止まり（outは上限で抑えられる）、
// 表の更新は最後まで続くので次のブロックも解ける
func TestBomb() {
    mut d := Dec{}
    setup(mut d, 4096)
    mut blk := mut []byte{}
    // 名前 "x"・値 4000 バイトを表に足す
    blk = append(blk, byte(0x40))
    putInt(mut blk, 0, 7, 1)
    blk = append(blk, byte(0x78))
    putInt(mut blk, 0, 7, 4000)
    for i <- iter.Range(0, 4000) {
        blk = append(blk, byte(0x61))
    }
    for i <- iter.Range(0, 5000) {
        blk = append(blk, byte(0xbe))
    }
    // 上限を越えた後の、表に足す字句（表は更新される）
    blk = append(blk, byte(0x40))
    putInt(mut blk, 0, 7, 1)
    blk = append(blk, byte(0x79))
    putInt(mut blk, 0, 7, 1)
    blk = append(blk, byte(0x62))
    mut out := mut []byte{}
    mut fs := mut []int{}
    assert(Decode(mut d, freeze(blk), mut out, mut fs, 8192) == Large)
    assert(len(out) <= 8192)
    // 表は "y: b" と "x: aaa…"
    assert(d.n == 2 && d.size == 4033 + 34)
    mut out2 := mut []byte{}
    mut fs2 := mut []int{}
    assert(Decode(mut d, unhex("be"), mut out2, mut fs2, 8192) == Ok)
    assert(eqb(render(out2, Fields(d, freeze(fs2))), bytes("y: b\n")))
}

// 表の大きさを越える項目は表を空にする（RFC 7541 4.4）。名前を表から引いた項目が、その名前の項目を追い出す形
func TestEvictSelf() {
    mut d := Dec{}
    setup(mut d, 100)
    step(mut d, "400a 6375 7374 6f6d 2d6b 6579 0d63 7573 746f 6d2d 6865 6164 6572", "custom-key: custom-header\n", "custom-key: custom-header\n", 55)
    // 名前は動的表の62番（追い出される項目）・値は20バイト（足すと100を越える）
    step(mut d, "7e 14 7676 7676 7676 7676 7676 7676 7676 7676 7676 7676", "custom-key: vvvvvvvvvvvvvvvvvvvv\n", "custom-key: vvvvvvvvvvvvvvvvvvvv\n", 62)
    mut big := mut []byte{}
    big = append(big, byte(0x40))
    putInt(mut big, 0, 7, 1)
    big = append(big, byte(0x7a))
    putInt(mut big, 0, 7, 80)
    for i <- iter.Range(0, 80) {
        big = append(big, byte(0x7a))
    }
    mut out := mut []byte{}
    mut fs := mut []int{}
    assert(Decode(mut d, freeze(big), mut out, mut fs, 1 << 20) == Ok)
    assert(d.n == 0 && d.size == 0)
}

// 表の参照の模型（古い順の名前と値の列。loより前は追い出した項目）と照合する乱択: 表に足す字句（名前は字句・静的表・動的表）・表の添字・
// 表に足さない字句・ブロックの頭の大きさの更新を混ぜ、輪の折り返しと項目の数の上限をまたぐ
func TestTableModel() {
    mut x := 2463534242
    mut d := Dec{}
    setup(mut d, 4096)
    mut mn := mut [][]byte{}
    mut mv := mut [][]byte{}
    mut msize := 0
    mut mmax := 4096
    mut lo := 0
    for blkNo <- iter.Range(0, 300) {
        mut blk := mut []byte{}
        mut want := mut []byte{}
        x = next(x)
        if (x & 0x7fffffff) % 7 == 0 {
            x = next(x)
            mmax = if (x & 1) == 0 { 4096 } else { (x & 0x7fffffff) % 4097 }
            putInt(mut blk, 0x20, 5, mmax)
            while msize > mmax {
                msize -= len(mn[lo]) + len(mv[lo]) + 32
                lo += 1
            }
        }
        x = next(x)
        nf := 1 + (x & 0x7fffffff) % 12
        for f <- iter.Range(0, nf) {
            x = next(x)
            kind := (x & 0x7fffffff) % 5
            x = next(x)
            n := if (x & 0xff) < 8 { (x & 0x7fffffff) % 3000 } else { (x & 0x7fffffff) % 40 }
            mut v := mut []byte{}
            for j <- iter.Range(0, n) {
                x = next(x)
                v = append(v, byte(0x61 + (x & 0x7fffffff) % 26))
            }
            x = next(x)
            hf := (x & 1) == 0
            if kind == 4 && len(mn) > lo {
                // 動的表の添字
                x = next(x)
                k := (x & 0x7fffffff) % (len(mn) - lo)
                putInt(mut blk, 0x80, 7, 62 + k)
                cat(mut want, mn[len(mn) - 1 - k])
                cat(mut want, bytes(": "))
                cat(mut want, mv[len(mv) - 1 - k])
                want = append(want, byte(10))
            } else {
                // 名前: 字句・静的表・動的表
                mut nm := mut []byte{}
                x = next(x)
                src := (x & 0x7fffffff) % 3
                ix := kind != 3
                hi := if ix { 0x40 } else { 0 }
                pb := if ix { 6 } else { 4 }
                if src == 1 {
                    x = next(x)
                    i := 1 + (x & 0x7fffffff) % 61
                    putInt(mut blk, hi, pb, i)
                    cat(mut nm, bytes(staticName(i)))
                } else if src == 2 && len(mn) > lo {
                    x = next(x)
                    k := (x & 0x7fffffff) % (len(mn) - lo)
                    putInt(mut blk, hi, pb, 62 + k)
                    cat(mut nm, mn[len(mn) - 1 - k])
                } else {
                    x = next(x)
                    for j <- iter.Range(0, 1 + (x & 0x7fffffff) % 20) {
                        x = next(x)
                        nm = append(nm, byte(0x61 + (x & 0x7fffffff) % 26))
                    }
                    putInt(mut blk, hi, pb, 0)
                    putStr(mut blk, nm, hf)
                }
                putStr(mut blk, v, hf)
                cat(mut want, nm)
                cat(mut want, bytes(": "))
                cat(mut want, v)
                want = append(want, byte(10))
                if ix {
                    s := len(nm) + len(v) + 32
                    if s > mmax {
                        lo = len(mn)
                        msize = 0
                    } else {
                        while msize + s > mmax {
                            msize -= len(mn[lo]) + len(mv[lo]) + 32
                            lo += 1
                        }
                        mn = append(mn, freeze(nm))
                        mv = append(mv, freeze(v))
                        msize += s
                    }
                }
            }
        }
        mut out := mut []byte{}
        mut fs := mut []int{}
        assert(Decode(mut d, freeze(blk), mut out, mut fs, 1 << 30) == Ok)
        assert(eqb(render(out, Fields(d, freeze(fs))), want))
        assert(d.size == msize && d.n == len(mn) - lo)
    }
}


// 長さの表が静的表の名前と合い、nameIndexがどの名前も（大文字でも）最初の添字で引く
func TestNameIndex() {
    ls := bytes(staticLens)
    assert(len(ls) == 61)
    for i <- iter.Range(1, 62) {
        nm := bytes(staticName(i))
        assert(int(ls[i - 1]) == len(nm) + 64)
        mut first := i
        for k <- iter.Range(1, i) {
            if staticName(k) == staticName(i) && first == i {
                first = k
            }
        }
        assert(nameIndex(nm) == first)
        mut up := mut []byte{}
        for c <- nm {
            up = append(up, if int(c) >= 0x61 && int(c) <= 0x7a { byte(int(c) - 0x20) } else { c })
        }
        assert(nameIndex(up) == first)
    }
    assert(nameIndex(bytes("x-none")) == 0)
    assert(nameIndex(bytes("")) == 0)
}

// 旧い形（1ビットずつ）の復号。表引きの形と結果・拒否が一致することの参照
func huffDecodeRef(d mut Dec, blk []byte, a int, b int, out mut []byte) bool {
    cs := bytes(huffCounts)
    ss := bytes(huffSyms)
    mut code := 0
    mut first := 0
    mut index := 0
    mut l := 0
    for i <- iter.Range(a, b) {
        c := int(blk[i])
        mut k := 7
        while k >= 0 {
            code = code | ((c >> k) & 1)
            l += 1
            cnt := hex2(cs, l * 2)
            if code - cnt < first {
                at := (index + (code - first)) * 2
                if ss[at] == byte(0x2d) {
                    // EOSは符号の中に現れてはいけない
                    return false
                }
                put(mut d, byte(hex2(ss, at)), mut out)
                code = 0
                first = 0
                index = 0
                l = 0
            } else {
                index += cnt
                first = (first + cnt) << 1
                code = code << 1
                if l >= 30 {
                    return false
                }
            }
            k -= 1
        }
    }
    // 埋め草: 7ビット以下で、全部1（EOSの頭）
    return l <= 7 && (code >> 1) == (1 << l) - 1
}

// blkの全体をHuffmanの符号として解いた結果を、表引きの形と参照の形で比べる（成否と出力のバイト列が一致すること）
func huffSame(blk []byte) bool {
    mut d1 := Dec{}
    setup(mut d1, 4096)
    d1.toOut = true
    d1.lim = 1 << 20
    mut o1 := mut []byte{}
    ok1 := huffDecode(mut d1, blk, 0, len(blk), mut o1)
    mut d2 := Dec{}
    setup(mut d2, 4096)
    d2.toOut = true
    d2.lim = 1 << 20
    mut o2 := mut []byte{}
    ok2 := huffDecodeRef(mut d2, blk, 0, len(blk), mut o2)
    return ok1 == ok2 && (!ok1 || eqb(o1, o2))
}

// 表引きの形の復号: 全記号の往復・全部の1バイトと2バイトの列・乱数の列（符号化したものと生のもの）で参照の形と一致する
func TestHuffFast() {
    // 全記号（1つずつと、後ろに長い符号を続けたもの）: 符号化して解くと元に戻る
    for c <- iter.Range(0, 256) {
        mut s := mut []byte{}
        s = append(s, byte(c))
        mut h := mut []byte{}
        huffEncode(mut h, s)
        assert(huffSame(h))
        s = append(s, byte(255 - c))
        s = append(s, byte(c))
        mut h2 := mut []byte{}
        huffEncode(mut h2, s)
        assert(huffSame(h2))
        mut d := Dec{}
        setup(mut d, 4096)
        d.toOut = true
        d.lim = 1 << 20
        mut o := mut []byte{}
        assert(huffDecode(mut d, h2, 0, len(h2), mut o))
        assert(eqb(o, s))
    }
    // 全部の1バイトと2バイトの列（埋め草の規則・EOS・途中で切れた符号を網羅する）
    for a <- iter.Range(0, 256) {
        assert(huffSame([]byte{byte(a)}))
        for b <- iter.Range(0, 256) {
            assert(huffSame([]byte{byte(a), byte(b)}))
        }
    }
    // 乱数の列: 符号化した列と、生の列（多くは不正）
    mut x := 2463534242
    for it <- iter.Range(0, 3000) {
        x = next(x)
        n := (x & 0x7fffffff) % 40
        mut s := mut []byte{}
        for j <- iter.Range(0, n) {
            x = next(x)
            s = append(s, if it % 2 == 0 { byte(0x20 + (x & 0x7fffffff) % 95) } else { byte(x & 0xff) })
        }
        mut h := mut []byte{}
        huffEncode(mut h, s)
        assert(huffSame(h))
        assert(huffSame(s))
    }
    // 境界: 埋め草が1〜7ビットの1（受ける）・8ビットの1（拒む）・EOSの30ビット（拒む）
    assert(huffSame(unhex("1f")))
    assert(huffSame(unhex("ff")))
    assert(huffSame(unhex("07ff")))
    assert(huffSame(unhex("ffff fffc")))
    assert(huffSame(unhex("ffff ffff")))
}

// 16を越える項目のブロック（Decodeが先に伸ばした範囲を越えた分はappendで積む）: 静的表の索引を20本
func TestManyFields() {
    mut d := Dec{}
    setup(mut d, 4096)
    mut blk := mut []byte{}
    mut want := mut []byte{}
    for k <- iter.Range(0, 20) {
        idx := 2 + k % 7
        blk = append(blk, byte(0x80 | idx))
        cat(mut want, bytes(staticName(idx)))
        cat(mut want, bytes(": "))
        cat(mut want, bytes(staticValue(idx)))
        want = append(want, byte(10))
    }
    mut out := mut []byte{}
    mut fs := mut []int{}
    assert(Decode(mut d, freeze(blk), mut out, mut fs, 1 << 20) == Ok)
    assert(eqb(render(out, Fields(d, freeze(fs))), want))
}

// 解いた量の上限が欄の途中に来るどの値でも、outは上限の無い結果の頭で（表の添字の欄は全部か無し・字句の欄は上限の手前の字まで）、
// 表の更新は上限の無いときと同じ。字句（生・Huffman）・表に足す形と足さない形・名前の静的表と動的表・空の値を混ぜる
func TestLargeEdge() {
    mut seed := mut []byte{}
    seed = append(seed, byte(0x40))
    putStr(mut seed, bytes("aa"), false)
    putStr(mut seed, bytes("bbbb"), false)
    mut blk := mut []byte{}
    // 1 = 表の添字の欄・0 = 字句の欄
    mut kinds := mut []int{}
    blk = append(blk, byte(0x82))
    kinds = append(kinds, 1)
    blk = append(blk, byte(0x40))
    putStr(mut blk, bytes("custom-key"), true)
    putStr(mut blk, bytes("hello world"), true)
    kinds = append(kinds, 0)
    blk = append(blk, byte(0x00))
    putStr(mut blk, bytes("x-r"), false)
    putStr(mut blk, bytes("abcdefghij"), false)
    kinds = append(kinds, 0)
    blk = append(blk, byte(0xbf))
    kinds = append(kinds, 1)
    blk = append(blk, byte(0x7e))
    putStr(mut blk, bytes("zzzzzz"), true)
    kinds = append(kinds, 0)
    blk = append(blk, byte(0x04))
    putStr(mut blk, bytes("/p/q?r=1"), true)
    kinds = append(kinds, 0)
    blk = append(blk, byte(0x00))
    putStr(mut blk, bytes("e"), false)
    putStr(mut blk, bytes(""), false)
    kinds = append(kinds, 0)
    // 名前も値も空の字句（上限を越えた後でも、書く字が無ければLargeにならない）
    blk = append(blk, byte(0x00))
    putStr(mut blk, bytes(""), false)
    putStr(mut blk, bytes(""), false)
    kinds = append(kinds, 0)
    mut d0 := Dec{}
    setup(mut d0, 4096)
    mut o0 := mut []byte{}
    mut f0 := mut []int{}
    assert(Decode(mut d0, freeze(seed), mut o0, mut f0, 1 << 20) == Ok)
    mut full := mut []byte{}
    mut ff := mut []int{}
    assert(Decode(mut d0, freeze(blk), mut full, mut ff, 1 << 20) == Ok)
    fv := Fields(d0, freeze(ff))
    assert(len(fv) == len(kinds) * 4)
    tab0 := table(d0)
    fb := freeze(full)
    for lim <- iter.Range(0, len(fb) + len(kinds) * 32 + 8) {
        // 模型: 欄の順に、表の添字は全部か無し・字句は上限の手前の字まで
        mut used := 0
        mut want := 0
        mut large := false
        mut k := 0
        while k < len(kinds) && !large {
            n := fv[k * 4 + 1] + fv[k * 4 + 3]
            room := lim - used - 32
            if n <= room || (n == 0 && kinds[k] == 0) {
                want += n
                used += n + 32
            } else {
                if kinds[k] == 0 && room > 0 {
                    want += room
                }
                large = true
            }
            k += 1
        }
        mut d := Dec{}
        setup(mut d, 4096)
        mut o1 := mut []byte{}
        mut f1 := mut []int{}
        assert(Decode(mut d, freeze(seed), mut o1, mut f1, 1 << 20) == Ok)
        mut out := mut []byte{}
        mut fs := mut []int{}
        st := Decode(mut d, freeze(blk), mut out, mut fs, lim)
        assert(st == if large { Large } else { Ok })
        assert(len(out) == want)
        assert(eqb(freeze(out), fb[0:want]))
        assert(eqb(table(d), tab0))
        assert(d.size == d0.size)
    }
}

// 表に足す字句の大きさの境: 名前と値の和が輪に書ける上限（TableMax - 32）ちょうどなら表に入り、1つ越えれば表を空にする（生とHuffmanの両方）
func TestRingEdge() {
    for hf <- iter.Range(0, 2) {
        for extra <- iter.Range(0, 2) {
            mut d := Dec{}
            setup(mut d, 4096)
            step(mut d, "400161 0162", "a: b\n", "a: b\n", 34)
            mut v := mut []byte{}
            for i <- iter.Range(0, TableMax - 32 - 1 + extra) {
                v = append(v, byte(0x61))
            }
            mut blk := mut []byte{}
            blk = append(blk, byte(0x40))
            putStr(mut blk, bytes("x"), false)
            putStr(mut blk, freeze(v), hf == 1)
            mut out := mut []byte{}
            mut fs := mut []int{}
            assert(Decode(mut d, freeze(blk), mut out, mut fs, 1 << 20) == Ok)
            assert(len(out) == TableMax - 32 + extra)
            if extra == 0 {
                assert(d.n == 1 && d.size == TableMax)
            } else {
                assert(d.n == 0 && d.size == 0)
            }
        }
    }
}

// 表に足さない長いHuffmanの字句（解いた字数が輪の空きを越えうる）は、輪の生きている項目を壊さない
func TestHuffLongPlain() {
    mut d := Dec{}
    setup(mut d, 4096)
    mut big := mut []byte{}
    big = append(big, byte(0x40))
    putStr(mut big, bytes("big"), false)
    mut bv := mut []byte{}
    for i <- iter.Range(0, 3500) {
        bv = append(bv, byte(0x62))
    }
    putStr(mut big, freeze(bv), false)
    mut o0 := mut []byte{}
    mut f0 := mut []int{}
    assert(Decode(mut d, freeze(big), mut o0, mut f0, 1 << 20) == Ok)
    mut av := mut []byte{}
    for i <- iter.Range(0, 5000) {
        av = append(av, byte(0x61))
    }
    mut blk := mut []byte{}
    blk = append(blk, byte(0x00))
    putStr(mut blk, bytes("v"), false)
    putStr(mut blk, freeze(av), true)
    blk = append(blk, byte(0xbe))
    mut want := mut []byte{}
    cat(mut want, bytes("v: "))
    cat(mut want, freeze(av))
    cat(mut want, bytes("\nbig: "))
    cat(mut want, freeze(bv))
    want = append(want, byte(10))
    mut out := mut []byte{}
    mut fs := mut []int{}
    assert(Decode(mut d, freeze(blk), mut out, mut fs, 1 << 20) == Ok)
    assert(eqb(render(out, Fields(d, freeze(fs))), freeze(want)))
}

// 動的表の項目を添字で引く: 輪の端で項目が名前の中・名前と値の境・値の中のどこで切れても、名前と値がそのまま出る
// （長さを変えながら足しては引くので、書く位置が輪を何周もして端のすべての切れ方を通る）
func TestRingWrapIndexed() {
    mut d := Dec{}
    setup(mut d, 4096)
    mut cuts := 0
    for i <- iter.Range(0, 3000) {
        nl := 1 + i % 53
        vl := i % 31
        mut nm := mut []byte{}
        for k <- iter.Range(0, nl) {
            nm = append(nm, byte(0x61 + (i + k) % 26))
        }
        mut vv := mut []byte{}
        for k <- iter.Range(0, vl) {
            vv = append(vv, byte(0x30 + (i + k) % 10))
        }
        st := d.wpos
        if st + nl >= ringSize && st < ringSize {
            cuts += 1
        }
        mut blk := mut []byte{}
        blk = append(blk, byte(0x40))
        putStr(mut blk, freeze(nm), false)
        putStr(mut blk, freeze(vv), false)
        blk = append(blk, byte(0x80 | 62))
        mut out := mut []byte{}
        mut fs := mut []int{}
        assert(Decode(mut d, freeze(blk), mut out, mut fs, 1 << 20) == Ok)
        f := Fields(d, freeze(fs))
        o := freeze(out)
        assert(len(f) == 8 && f[5] == nl && f[7] == vl)
        for k <- iter.Range(0, nl) {
            assert(o[f[4] + k] == nm[k])
        }
        for k <- iter.Range(0, vl) {
            assert(o[f[6] + k] == vv[k])
        }
    }
    // 名前の終わりが輪の端を越える（値が輪の頭から始まる）形を何度も通った
    assert(cuts > 5)
}

// 名前の静的表の添字（Si）: 静的表の名前で表に足した項目は、動的表の添字で引いても同じ添字を出す。字句の名前の項目は0
func TestSiDynamic() {
    mut d := Dec{}
    setup(mut d, 4096)
    mut blk := mut []byte{}
    blk = append(blk, byte(0x41))
    putStr(mut blk, bytes("x.example"), false)
    blk = append(blk, byte(0x40))
    putStr(mut blk, bytes(":authority"), false)
    putStr(mut blk, bytes("y"), false)
    blk = append(blk, byte(0x80 | 63))
    blk = append(blk, byte(0x80 | 62))
    // 6ビットの前置きの63は続きのバイト（0）が要る
    blk = append(blk, byte(0x7f))
    blk = append(blk, byte(0))
    putStr(mut blk, bytes("z"), false)
    b := freeze(blk)
    mut out := mut []byte{}
    Begin(mut d, 1 << 20)
    mut p := 0
    mut sis := mut []int{}
    while p < len(b) {
        q, k, w := Next(mut d, b, p, mut out, len(out), bytes(""))
        assert(k == Got)
        sis = append(sis, d.Si)
        p = q
    }
    // 静的の名前・字句の名前・動的63（静的の名前の項目）・動的62（字句の名前の項目）・動的表の名前（静的の名前の項目）の字句
    assert(len(sis) == 5 && sis[0] == 1 && sis[1] == 0 && sis[2] == 1 && sis[3] == 0 && sis[4] == 1)
}

// 12ビットの表（huffFast）は、符号の表（huffCodes）から作り直したものと全項で一致する
func TestHuffTable() {
    hc := bytes(huffCodes)
    ft := bytes(huffFast)
    assert(len(ft) == 4096 * 5)
    for p <- iter.Range(0, 4096) {
        s1, l1 := huffFirst(hc, p, 12)
        mut e := 0
        if s1 >= 0 {
            e = s1 << 12 | l1
            if l1 < 12 {
                s2, l2 := huffFirst(hc, p & ((1 << (12 - l1)) - 1), 12 - l1)
                if s2 >= 0 {
                    assert(s2 != 0)
                    e = s1 << 12 | s2 << 4 | (l1 + l2)
                }
            }
        }
        assert(hex5(ft, p * 5) == e)
    }
}

// nビットの窓bits（上位から）の頭にある符号の (記号, 長さ)。無ければ (-1, 0)
func huffFirst(hc []byte, bits int, n int) (int, int) {
    for c <- iter.Range(0, 256) {
        code, l := huffCode(hc, byte(c))
        if l <= n && bits >> (n - l) == code {
            return c, l
        }
    }
    return 0 - 1, 0
}
