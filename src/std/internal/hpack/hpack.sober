package hpack

// HTTP/2のヘッダの圧縮（RFC 7541）の復号と符号化。std/http/serverのHTTP/2が使う。
// 復号は動的表を持つ（接続ごとに1つ・表の大きさは既定の4096から変えない）。符号化は動的表を使わない（静的表と字句だけ。状態を持たないので、どのtaskからでも呼べる）。

import "std/iter"

// Decodeの結果
const Ok = 0
// 形の誤り（RFC 9113ではCOMPRESSION_ERRORの接続の誤り）
const Bad = 1
// 解いた量がlimを越えた。表の更新はブロックの最後まで続けたので、接続は続けられる
const Large = 2

// Nextの種別（Badも返す）: 欄を1つ書いた
const Got = 3
// 書いた欄は無い（表の大きさの更新か、上限を越えて書かなかった欄）
const Skip = 4

// 動的表の大きさの上限（SETTINGS_HEADER_TABLE_SIZEの既定の値。広告しない）
const TableMax = 4096

// 表の項目のバイトの輪の大きさ。生きている項目（4096以下）と、書いている途中の新しい項目（4096以下）が重ならない
const ringSize = 8192
const ringMask = 8191
// 項目の数の上限（4096 ÷ 32）
const entMax = 128

// 復号の状態。ゼロ値をInitで整えてから使う
type Dec struct {
    ring mut []byte
    // 項目ごとに (輪の中の始まり | 名前の静的表の添字 << 16, 名前の長さ, 値の長さ)。first = いちばん古い項目の番号
    ents mut []int
    first int
    n int
    // 次の項目を書く輪の位置・RFC 7541 4.1の大きさの和・今の上限
    wpos int
    size int
    max int
    // 書き込みの行き先（項目を解くあいだだけ使う）
    toRing bool
    ringW int
    ringOver bool
    toOut bool
    outW int
    used int
    lim int
    large bool
    // fsの次に書く添字（Decodeが先に伸ばした範囲の中）
    fw int
    // Huffmanを輪の空きへ解く速い道（hw = 書き始めの輪の位置〔mask前〕・hk = 解いた字数）
    fast bool
    hw int
    hk int
    // outへ次に書く位置・表の大きさの更新を許す（ブロックの頭）
    ow int
    head bool
    got bool
    // Nextが欄を書いたとき: 名前の長さ・値の長さ・名前の静的表の添字（名前が静的表から来たとき〔動的表の項目の名前が静的表から来たときも〕。それ以外は0）
    Nl int
    Vl int
    Si int
}

func Init(d mut Dec) {
    for i <- iter.Range(0, ringSize) {
        d.ring = append(d.ring, byte(0))
    }
    for i <- iter.Range(0, entMax * 3) {
        d.ents = append(d.ents, 0)
    }
    d.first = 0
    d.n = 0
    d.wpos = 0
    d.size = 0
    d.max = TableMax
}

// ヘッダのブロックblkを解く。解いたヘッダは、名前と値のバイトをoutに積み、fsに (名前の位置, 名前の長さ, 値の位置, 値の長さ) の4つを書く（位置はoutの中）。
// fsの後ろには使わない0が残るので、項目はFieldsで切り出して読む。
// lim = 解いた量（名前 + 値 + 32 の和。RFC 7541 4.1）の上限。越えたらLargeで、outとfsの中身は途中までになる
func Decode(d mut Dec, blk []byte, out mut []byte, fs mut []int, lim int) int {
    Begin(mut d, lim)
    // fsを先に伸ばしておき、項目は添字で書く。outとfsへ交互にappendすると、regionの先端を外れた側が毎回写しになる（spec 9章M-4）。
    // 項目は1つごとにブロックの1バイト以上と、解いた量の32以上を使うので、数はその小さい方で抑えられる（16を越える分はappendで伸ばす）
    d.fw = len(fs)
    mut nf := len(blk)
    if lim / 32 < nf {
        nf = lim / 32
    }
    if nf > 16 {
        nf = 16
    }
    for k <- iter.Range(0, nf * 4) {
        fs = append(fs, 0)
    }
    mut p := 0
    mut w := len(out)
    while p < len(blk) {
        q, k, w1 := Next(mut d, blk, p, mut out, w, bytes(""))
        if k == Bad {
            return Bad
        }
        if k == Got {
            push(mut d, mut fs, w, d.Nl, w + d.Nl, d.Vl)
        }
        p = q
        w = w1
    }
    return if d.large { Large } else { Ok }
}

// Decodeが書いたfsの項目の範囲（fsはDecodeが先に伸ばした分の後ろに使わない0を持つ。凍らせた後にここで切る）
func Fields(d Dec, fs []int) []int {
    return fs[0:d.fw]
}

// ブロックを解き始める（lim = 解いた量の上限。Decodeと同じ数え方）
func Begin(d mut Dec, lim int) {
    d.used = 0
    d.lim = lim
    d.large = false
    d.head = true
}

// 解いた量がBeginのlimを越えた（ブロックの終わりに見る）
func Over(d Dec) bool {
    return d.large
}

// ブロックblkの位置p（< len(blk)）から表現を1つ解く。欄なら、out[w:]へ名前・sep・値を書く（outの長さを越える分は足す）。
// 結果 = (次の位置, 種別, 書いた後の位置)。GotのときNl・Vl・Siに欄の形を置く。Badはブロックが壊れている（位置は使わない）。
// Skipでは書いた後の位置はwのまま（上限を越えた欄の書きかけはout[w:]に残りうる）
func Next(d mut Dec, blk []byte, p int, out mut []byte, w int, sep []byte) (int, int, int) {
    d.ow = w
    b := int(blk[p])
    if b >= 0x80 {
        v, q := readInt(blk, p, 7)
        if q < 0 || v == 0 {
            return q, Bad, w
        }
        d.head = false
        k := emitIndexed(mut d, v, mut out, sep)
        return q, k, if k == Got { d.ow } else { w }
    }
    if b >= 0x20 && b < 0x40 {
        // 表の大きさの更新はブロックの頭だけ（RFC 7541 4.2）
        v, q := readInt(blk, p, 5)
        if q < 0 || !d.head || v > TableMax {
            return q, Bad, w
        }
        d.max = v
        evict(mut d, 0)
        return q, Skip, w
    }
    ix := b >= 0x40
    v, q := readInt(blk, p, if ix { 6 } else { 4 })
    if q < 0 {
        return q, Bad, w
    }
    d.head = false
    r := literal(mut d, blk, q, v, ix, mut out, sep)
    if r < 0 {
        return r, Bad, w
    }
    return r, if d.got { Got } else { Skip }, if d.got { d.ow } else { w }
}

// blk[p]の下位nビットを前置きとする整数（RFC 7541 5.1）: (値, 次の位置)。形が壊れていれば位置 < 0
func readInt(blk []byte, p int, n int) (int, int) {
    mask := (1 << n) - 1
    mut v := int(blk[p]) & mask
    mut q := p + 1
    if v < mask {
        return v, q
    }
    mut m := 0
    while true {
        // 2^28を越える値は使い道が無い（長さは残りのブロックを越え、添字は表を越える）
        if q >= len(blk) || m > 21 {
            return 0, 0 - 1
        }
        c := int(blk[q])
        q += 1
        v += (c & 0x7f) << m
        m += 7
        if c < 0x80 {
            return v, q
        }
    }
    return 0, 0 - 1
}

// 表の添字のヘッダを書く。結果はNextの種別（添字が表の外ならBad）
func emitIndexed(d mut Dec, idx int, out mut []byte, sep []byte) int {
    if idx <= 61 {
        nm := bytes(staticName(idx))
        vl := bytes(staticValue(idx))
        if !fits(mut d, len(nm) + len(vl)) {
            return Skip
        }
        d.ow = wCat(mut out, d.ow, nm, 0, len(nm))
        // 区切りは短いので、写しの部品を呼ばずに書く
        mut j := 0
        while j < len(sep) {
            if d.ow < len(out) {
                out[d.ow] = sep[j]
            } else {
                out = append(out, sep[j])
            }
            d.ow += 1
            j += 1
        }
        d.ow = wCat(mut out, d.ow, vl, 0, len(vl))
        d.Nl = len(nm)
        d.Vl = len(vl)
        d.Si = idx
        return Got
    }
    k := idx - 62
    if k >= d.n {
        return Bad
    }
    e := ((d.first + d.n - 1 - k) & (entMax - 1)) * 3
    st := d.ents[e] & ringMask
    nl := d.ents[e + 1]
    vl := d.ents[e + 2]
    if !fits(mut d, nl + vl) {
        return Skip
    }
    d.ow = wRing(mut out, d.ow, mut d.ring, st, nl)
    mut j := 0
    while j < len(sep) {
        if d.ow < len(out) {
            out[d.ow] = sep[j]
        } else {
            out = append(out, sep[j])
        }
        d.ow += 1
        j += 1
    }
    d.ow = wRing(mut out, d.ow, mut d.ring, (st + nl) & ringMask, vl)
    d.Nl = nl
    d.Vl = vl
    d.Si = d.ents[e] >> 16
    return Got
}

// 名前と値で長さnの項目を、解いた量の上限に数える。越えたらLargeの印を立ててfalse
func fits(d mut Dec, n int) bool {
    if d.large || d.used + n + 32 > d.lim {
        d.large = true
        return false
    }
    d.used += n + 32
    return true
}

func push(d mut Dec, fs mut []int, a int, b int, c int, e int) {
    if d.fw + 4 <= len(fs) {
        fs[d.fw] = a
        fs[d.fw + 1] = b
        fs[d.fw + 2] = c
        fs[d.fw + 3] = e
    } else {
        fs = append(fs, a)
        fs = append(fs, b)
        fs = append(fs, c)
        fs = append(fs, e)
    }
    d.fw += 4
}

// src[a:b] をo[w:]へ書き、書いた後の位置を返す（w <= len(o)。oの長さの内は添字で、越えた分は足す。どちらもコピーのループの一括化に乗る形）
func wCat(o mut []byte, w int, src []byte, a int, b int) int {
    n := b - a
    room := len(o) - w
    n1 := if n <= room { n } else { room }
    mut i := 0
    while i < n1 {
        o[w + i] = src[a + i]
        i += 1
    }
    mut j := a + n1
    while j < b {
        o = append(o, src[j])
        j += 1
    }
    return w + n
}

// sをoutへ足す（コピーのループの一括化に乗る形）
func appendAll(out mut []byte, s []byte) {
    mut j := 0
    while j < len(s) {
        out = append(out, s[j])
        j += 1
    }
}

// 輪の区間 r[a:b] をo[w:]へ書く（wCatと同じ形。輪はmutの持ち主から借りる）
func rCat(o mut []byte, w int, r mut []byte, a int, b int) int {
    n := b - a
    room := len(o) - w
    n1 := if n <= room { n } else { room }
    mut i := 0
    while i < n1 {
        o[w + i] = r[a + i]
        i += 1
    }
    mut j := a + n1
    while j < b {
        o = append(o, r[j])
        j += 1
    }
    return w + n
}

// 輪の位置s（mask済み）からn字をo[w:]へ書く。輪の端で2つの区間に分ける
func wRing(o mut []byte, w int, r mut []byte, s int, n int) int {
    m := if n < ringSize - s { n } else { ringSize - s }
    w1 := rCat(mut o, w, mut r, s, s + m)
    return rCat(mut o, w1, mut r, 0, n - m)
}

// src[a:a+n] を輪の位置w（mask前）から書く。輪の端で2つの区間に分ける
func ringWrite(ring mut []byte, w int, src []byte, a int, n int) {
    s := w & ringMask
    m := if n < ringSize - s { n } else { ringSize - s }
    mut j := 0
    while j < m {
        ring[s + j] = src[a + j]
        j += 1
    }
    b := a + m
    e := n - m
    mut k := 0
    while k < e {
        ring[k] = src[b + k]
        k += 1
    }
}

// 項目の途中で、outへn字を足せる数を数えて進める（putを1字ずつ呼んだのと同じ結果: 上限を越える字の手前で止め、Largeの印を立てる）
func outTake(d mut Dec, n int) int {
    if !d.toOut || n == 0 {
        return 0
    }
    room := d.lim - d.used - d.outW - 32
    if n <= room {
        d.outW += n
        return n
    }
    d.toOut = false
    d.large = true
    r := if room > 0 { room } else { 0 }
    d.outW += r
    return r
}

// src[a:a+n] を行き先へ書く（putをn回呼んだのと同じ結果）
func span(d mut Dec, src []byte, a int, n int, out mut []byte) {
    if d.toRing {
        room := TableMax - 32 - d.ringW
        k := if n <= room { n } else { room }
        ringWrite(mut d.ring, d.wpos + d.ringW, src, a, k)
        d.ringW += k
        if n > room {
            d.ringOver = true
        }
    }
    k := outTake(mut d, n)
    d.ow = wCat(mut out, d.ow, src, a, a + k)
}

// 字句の名前か値を持つヘッダ（blk[p]は名前の添字の後）。idx = 名前の添字（0 = 名前も字句）・ix = 表に足す形か。次の位置を返す（壊れていれば < 0）
func literal(d mut Dec, blk []byte, p int, idx int, ix bool, out mut []byte, sep []byte) int {
    d.toRing = ix
    d.ringW = 0
    d.ringOver = false
    d.toOut = !d.large
    d.outW = 0
    d.got = false
    d.Si = 0
    mut q := p
    if idx == 0 {
        q = readStr(mut d, blk, q, mut out)
        if q < 0 {
            return q
        }
    } else if idx <= 61 {
        nm := bytes(staticName(idx))
        span(mut d, nm, 0, len(nm), mut out)
        d.Si = idx
    } else {
        k := idx - 62
        if k >= d.n {
            return 0 - 1
        }
        e := ((d.first + d.n - 1 - k) & (entMax - 1)) * 3
        st := d.ents[e] & ringMask
        for j <- iter.Range(0, d.ents[e + 1]) {
            put(mut d, d.ring[(st + j) & ringMask], mut out)
        }
        d.Si = d.ents[e] >> 16
    }
    nl := d.outW
    rnl := d.ringW
    if d.toOut {
        mut j := 0
        while j < len(sep) {
            if d.ow < len(out) {
                out[d.ow] = sep[j]
            } else {
                out = append(out, sep[j])
            }
            d.ow += 1
            j += 1
        }
    }
    if q >= len(blk) {
        return 0 - 1
    }
    q = readStr(mut d, blk, q, mut out)
    if q < 0 {
        return q
    }
    if d.toOut {
        d.used += d.outW + 32
        d.got = true
        d.Nl = nl
        d.Vl = d.outW - nl
    }
    if ix {
        add(mut d, rnl, d.ringW - rnl, d.Si)
    }
    return q
}

// 1バイトを行き先へ書く。表の項目は上限を越えたら書くのをやめる（表に入らない大きさ）。outは解いた量の上限を越えたらやめてLargeの印を立てる
func put(d mut Dec, c byte, out mut []byte) {
    if d.toRing {
        if d.ringW < TableMax - 32 {
            d.ring[(d.wpos + d.ringW) & ringMask] = c
            d.ringW += 1
        } else {
            d.ringOver = true
        }
    }
    if d.toOut {
        if d.used + d.outW + 1 + 32 > d.lim {
            d.toOut = false
            d.large = true
        } else {
            if d.ow < len(out) {
                out[d.ow] = c
            } else {
                out = append(out, c)
            }
            d.ow += 1
            d.outW += 1
        }
    }
}

// 文字列（RFC 7541 5.2）を解いて行き先へ書く。次の位置を返す（壊れていれば < 0）
func readStr(d mut Dec, blk []byte, p int, out mut []byte) int {
    h := int(blk[p]) >= 0x80
    n, q := readInt(blk, p, 7)
    if q < 0 || n > len(blk) - q {
        return 0 - 1
    }
    if !h {
        span(mut d, blk, q, n, mut out)
        return q + n
    }
    // 解いた字数はn × 8 ÷ 5以下（最短の符号は5ビット）。輪の空き（新しい項目の上限の内）に収まるなら、輪へ解いてから一括で書く
    if d.ringW + n * 8 / 5 <= TableMax - 32 {
        d.fast = true
        d.hw = d.wpos + d.ringW
        d.hk = 0
        ok := huffDecode(mut d, blk, q, q + n, mut out)
        d.fast = false
        if !ok {
            return 0 - 1
        }
        k := d.hk
        if d.toRing {
            d.ringW += k
        }
        t := outTake(mut d, k)
        d.ow = wRing(mut out, d.ow, mut d.ring, d.hw & ringMask, t)
        return q + n
    }
    return if huffDecode(mut d, blk, q, q + n, mut out) { q + n } else { 0 - 1 }
}

// 正準Huffmanの符号の長さごとの数（長さ0〜30。2桁の16進）と、長さの順・同じ長さは記号の順に並べた記号（2桁の16進。最後の "--" = EOS）
const huffCounts = "00000000000a1a20060005030206020300000003080d1a1d0c040f131d0004"
const huffSyms = "--"

func hexv(c byte) int {
    x := int(c)
    return if x <= 0x39 { x - 0x30 } else { x - 0x61 + 10 }
}

func hex2(s []byte, i int) int {
    return (hexv(s[i]) << 4) | hexv(s[i + 1])
}

// 先頭の12ビット（上位から）で引く表: 1項 = 5桁の16進で (記号1 << 12) | (記号2 << 4) | 使うビットの数。12ビットに収まる符号を最大2つ解く。
// 記号2 = 0は1つだけ（記号0の符号は13ビットなので2つ目には来ない）。ビットの数0 = 12ビットに収まらない符号の頭（1ビットずつの読みへ）。
// テストのTestHuffTableが符号の表（huffCodes）から作り直して一致を見る
const huffFast = ""

func hex5(s []byte, i int) int {
    return (hexv(s[i]) << 16) | (hexv(s[i + 1]) << 12) | (hexv(s[i + 2]) << 8) | (hexv(s[i + 3]) << 4) | hexv(s[i + 4])
}

// blk[a:b]のHuffmanの符号を解く（RFC 7541 5.2・付録B）。12ビットに収まる符号は表（huffFast）を1回引き、最大2字を出す。
// 長い符号と、残りのビットが足りない末尾は、上位のビットから1ビットずつ長さごとの符号の始まりと比べる（puffの形）
func huffDecode(d mut Dec, blk []byte, a int, b int, out mut []byte) bool {
    ft := bytes(huffFast)
    cs := bytes(huffCounts)
    ss := bytes(huffSyms)
    // 読んだまだ使っていないビット（下位nbビット・上位のビットが先）
    mut acc := 0
    mut nb := 0
    mut i := a
    while true {
        while nb <= 48 && i < b {
            acc = (acc << 8) | int(blk[i])
            nb += 8
            i += 1
        }
        if nb == 0 {
            return true
        }
        pk := if nb >= 12 { acc >> (nb - 12) } else { (acc << (12 - nb)) & 4095 }
        e := hex5(ft, pk * 5)
        ln := e & 15
        if ln != 0 && ln <= nb {
            hput(mut d, byte(e >> 12), mut out)
            c2 := (e >> 4) & 255
            if c2 != 0 {
                hput(mut d, byte(c2), mut out)
            }
            nb -= ln
            acc = acc & ((1 << nb) - 1)
        } else {
            mut code := 0
            mut first := 0
            mut index := 0
            mut l := 0
            mut more := true
            while more {
                // ここへ来るときは、入力が尽きたか、48ビットを越えて読んである（最長の符号は30ビット）。ビットが尽きたら入力の終わり
                if nb == 0 {
                    // 埋め草: 7ビット以下で、全部1（EOSの頭）
                    return l <= 7 && (code >> 1) == (1 << l) - 1
                }
                nb -= 1
                code = code | ((acc >> nb) & 1)
                acc = acc & ((1 << nb) - 1)
                l += 1
                cnt := hex2(cs, l * 2)
                if code - cnt < first {
                    at := (index + (code - first)) * 2
                    if ss[at] == byte(0x2d) {
                        // EOSは符号の中に現れてはいけない
                        return false
                    }
                    hput(mut d, byte(hex2(ss, at)), mut out)
                    more = false
                } else {
                    index += cnt
                    first = (first + cnt) << 1
                    code = code << 1
                    if l >= 30 {
                        return false
                    }
                }
            }
        }
    }
    return true
}

// Huffmanの1字: 速い道は輪の空きへ、それ以外はput
func hput(d mut Dec, c byte, out mut []byte) {
    if d.fast {
        d.ring[(d.hw + d.hk) & ringMask] = c
        d.hk += 1
    } else {
        put(mut d, c, mut out)
    }
}

// 輪のwposに書いた名前nlと値vlの項目を表に足す（RFC 7541 4.4: 入らない大きさなら表を空にする）。
// si = 名前の静的表の添字（無ければ0）。項目の始まりの上位のビットに置き、添字で引いたときにSiへ出す
func add(d mut Dec, nl int, vl int, si int) {
    s := nl + vl + 32
    if d.ringOver || s > d.max {
        evict(mut d, d.max + 1)
        return
    }
    evict(mut d, s)
    e := ((d.first + d.n) & (entMax - 1)) * 3
    d.ents[e] = d.wpos | si << 16
    d.ents[e + 1] = nl
    d.ents[e + 2] = vl
    d.n += 1
    d.size += s
    d.wpos = (d.wpos + nl + vl) & ringMask
}

// 大きさの和 + room が上限以下になるまで古い項目を外す
func evict(d mut Dec, room int) {
    while d.n > 0 && d.size + room > d.max {
        e := d.first * 3
        d.size -= d.ents[e + 1] + d.ents[e + 2] + 32
        d.first = (d.first + 1) & (entMax - 1)
        d.n -= 1
    }
}

// 静的表（RFC 7541 付録A）の名前。i = 1〜61
func staticName(i int) string {
    return switch i {
    case 1: ":authority"
    case 2: ":method"
    case 3: ":method"
