// 整数vを、前置きのビットを除いた上位のビットhiと、下位nビットの前置きで書く（RFC 7541 5.1）
func putInt(out mut []byte, hi int, n int, v int) {
    mask := (1 << n) - 1
    if v < mask {
        out = append(out, byte(hi | v))
        return
    }
    out = append(out, byte(hi | mask))
    mut x := v - mask
    while x >= 0x80 {
        out = append(out, byte((x & 0x7f) | 0x80))
        x = x >> 7
    }
    out = append(out, byte(x))
}

// :statusのヘッダを積む。静的表にある値（200・204・206・304・400・404・500）は添字1バイト
func Status(out mut []byte, code int) {
    idx := switch code {
    case 200: 8
    case 204: 9
    case 206: 10
    case 304: 11
    case 400: 12
    case 404: 13
    case 500: 14
    default: 0
    }
    if idx != 0 {
        out = append(out, byte(0x80 | idx))
        return
    }
    // 表に足さない字句（名前は静的表の8番）・値は3桁
    putInt(mut out, 0, 4, 8)
    out = append(out, byte(3))
    out = append(out, byte(0x30 + (code / 100) % 10))
    out = append(out, byte(0x30 + (code / 10) % 10))
    out = append(out, byte(0x30 + code % 10))
}

// ヘッダ1つを、表に足さない字句（RFC 7541 6.2.2）で積む。名前は小文字にして書く（HTTP/2の名前は小文字）。名前が静的表にあれば添字で書く。
// huff = 値をHuffmanで符号化する（短くならなければ字句のまま）
func Field(out mut []byte, name []byte, value []byte, huff bool) {
    idx := nameIndex(name)
    if idx != 0 {
        putInt(mut out, 0, 4, idx)
    } else {
        out = append(out, byte(0))
        putInt(mut out, 0, 7, len(name))
        for i <- iter.Range(0, len(name)) {
            out = append(out, lower(name[i]))
        }
    }
    putStr(mut out, value, huff)
}

// 文字列を字句のまま積む（長さの前置き + バイト列）
func Str(out mut []byte, s []byte) {
    putInt(mut out, 0, 7, len(s))
    appendAll(mut out, s)
}

// 文字列を積む。huffで、Huffmanの方が短ければHuffmanで
func putStr(out mut []byte, s []byte, huff bool) {
    if huff {
        n := huffLen(s)
        if n < len(s) {
            putInt(mut out, 0x80, 7, n)
            huffEncode(mut out, s)
            return
        }
    }
    putInt(mut out, 0, 7, len(s))
    appendAll(mut out, s)
}

func lower(c byte) byte {
    x := int(c)
    return if x >= 0x41 && x <= 0x5a { byte(x + 0x20) } else { c }
}

// 静的表の名前の長さ（添字1〜61の順。各バイト = 長さ + 64）。nameIndexが長さの合う添字だけstaticNameを引くため
const staticLens = "JGGEEGGGGGGGGGNOOMF[CEMMSPPNPMLFDDFGDDHQMHSMDHLRSEGGKFJYQJDCP"

// 名前（大小を無視）の静的表の最初の添字（無ければ0）
func nameIndex(name []byte) int {
    ls := bytes(staticLens)
    n := len(name) + 64
    for i <- iter.Range(1, 62) {
        if int(ls[i - 1]) == n {
            s := bytes(staticName(i))
            mut j := 0
            while j < len(s) && s[j] == lower(name[j]) {
                j += 1
            }
            if j == len(s) {
                return i
            }
        }
    }
    return 0
}

// 記号ごとの符号（8桁の16進）と長さ（2桁の16進）。記号0〜255
const huffCodes = ""

func huffCode(cs []byte, c byte) (int, int) {
    at := int(c) * 10
    mut v := 0
    for i <- iter.Range(0, 8) {
        v = (v << 4) | hexv(cs[at + i])
    }
    return v, hex2(cs, at + 8)
}

// sのHuffmanの符号のバイト数
func huffLen(s []byte) int {
    cs := bytes(huffCodes)
    mut bits := 0
    for i <- iter.Range(0, len(s)) {
        _, l := huffCode(cs, s[i])
        bits += l
    }
    return (bits + 7) >> 3
}

// sをHuffmanで符号化して積む。最後のバイトの余りはEOSの頭（1のビット）で埋める
func huffEncode(out mut []byte, s []byte) {
    cs := bytes(huffCodes)
    mut acc := 0
    mut n := 0
    for i <- iter.Range(0, len(s)) {
        v, l := huffCode(cs, s[i])
        acc = (acc << l) | v
        n += l
        while n >= 8 {
            n -= 8
            out = append(out, byte((acc >> n) & 0xff))
        }
        acc = acc & ((1 << n) - 1)
    }
    if n > 0 {
        out = append(out, byte(((acc << (8 - n)) | ((1 << (8 - n)) - 1)) & 0xff))
    }
}
