package bless

// 値の祝福のインターフェース（language.md 12 節「秘密の値の宣言」— stdの実装の詳細std/internal/…・stdの中からだけimportできる）: 恒等の関数に `@bless` を付けたもの。
// 関数単位の祝福（`@bless` の関数の結果は公開）では言えない「この値はここで公開してよい」を、値を通す 1 か所に書く
// （署名の自己検証の比較・key logの書き出しのような意図した開示）。通した値の秘密の流れはanalyzerの検査から外れるので、置くたびに理由を添える

// b をそのまま返す（結果は公開の値）
@bless
func Bytes(b []byte) []byte {
    return b
}

// x をそのまま返す（結果は公開の値）
@bless
func Int(x int) int {
    return x
}
