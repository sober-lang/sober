package lot

// 預かり所のテスト（DBなし — fdのフィールドには負の偽の番号を置くので閉じない）: 多くのtaskが待機の枠を取り合っても同じ枠を2本が同時に持たない・
// 預け直した枠がまた借りられる・借り手の task が死んだ枠を Reap が数えて空きへ戻す（生きた借り手の枠は回収しない）

import "std/iter"
import "std/os"
import "std/task"

type Boom panic

const slots = 4

func fill(l Lot) {
    for i <- iter.Range(0, slots) {
        j := TakeFree(l)
        assert(j >= 0, "free slot")
        Fresh(l, j, -1 - j)
        Hold(l, j)
        Park(l, j)
    }
}

// 待機の枠をn回借りて返す（取れなければ数えない）。借りている間は格納場所のワード0に自分のマークを書き、返す前に読み直す
func churn(l Lot, me int, n int) int {
    mut got := 0
    for _ <- iter.Range(0, n) {
        i := TakeIdle(l)
        if i >= 0 {
            Hold(l, i)
            pl := Place(l, i)
            _ = leaseOp(5, pl, 0, me)
            os.Sleep(1)
            assert(leaseOp(4, pl, 0, 0) == me, "exclusive slot ${i}")
            Park(l, i)
            got += 1
        }
    }
    return got
}

func TestChurn() {
    l := New(slots, 8)
    fill(l)
    total, e := task.Run((s task.Scope) => {
        mut hs := mut []task.Handle[int]{}
        for k <- iter.Range(0, 16) {
            hs = append(hs, task.Spawn(s, () => churn(l, k + 1, 50)))
        }
        mut sum := 0
        for v <- task.Gather(hs) {
            sum += v
        }
        sum
    })
    assert(e == nil, "churn scope")
    assert(total > 0, "churn took slots")
    // 全部の枠が待機に戻っている
    mut idle := 0
    for i <- iter.Range(0, slots) {
        if state(l, i) == sIdle {
            idle += 1
        }
    }
    assert(idle == slots, "all parked: ${idle}")
    assert(Reap(l) == 0, "nothing to reap")
}

func TestReapDead() {
    l := New(slots, 8)
    fill(l)
    // 2 本は借りたまま死ぬ・1 本は借りたまま生きている（呼び手の task が持つ）
    held := TakeIdle(l)
    Hold(l, held)
    _, e := task.Run((s task.Scope) => {
        for _ <- iter.Range(0, 2) {
            _ = task.Spawn(s, () => {
                i := TakeIdle(l)
                assert(i >= 0, "dying borrower took a slot")
                Hold(l, i)
                if i >= 0 {
                    panic(Boom{})
                }
                0
            })
        }
        0
    })
    assert(e != nil, "borrowers died")
    assert(Reap(l) == 2, "reaped the dead borrowers")
    assert(state(l, held) == sBusy, "live borrower kept")
    assert(Reap(l) == 0, "reap is once")
    Park(l, held)
    mut free := 0
    for i <- iter.Range(0, slots) {
        if state(l, i) == sFree {
            free += 1
        }
    }
    assert(free == 2, "reaped slots are free: ${free}")
}

// 比較交換（rtのlease_op 8）: 期待どおりなら書いて成功・違えば書かずに失敗（同じ枠を2本が取れない芯 — 取り合いのウィンドウそのものは乱択のスケジュールでは狙えない）
func TestCas() {
    l := New(1, 1)
    assert(cas(l, 0, sFree, sClaim), "free → claim")
    assert(!cas(l, 0, sFree, sClaim), "second claim fails")
    assert(state(l, 0) == sClaim, "state kept")
    assert(cas(l, 0, sClaim, sBusy) && !cas(l, 0, sClaim, sIdle) && state(l, 0) == sBusy, "busy")
}

// 死と並んだ Reap（走査は lease の死の通し番号が動いたときだけ）: 借り手が死ぬのと同時に Reap を回し続けても、回のあとの Reap で死んだ枠が全部回収済み
// （番号を走査の後で読むと、走査が通り過ぎた枠の死の番号を見たことにして、その枠をずっと取りこぼす）
func TestReapRace() {
    rounds := 16
    dying := 4
    l := New(1024, 1)
    // 回ごとの終わりのマーク（枠rのワード0 — 死に役のscopeが決着したら1。Reap役はそれまで回り続ける）
    ctl := New(rounds, 0)
    // LOT_REAP_LATE=1: テストの自己検査（scripts/schedfuzz.sh）— 番号を走査の後で読むコピーで回し、この試験が落ちること
    late := envSet("LOT_REAP_LATE")
    mut reaped := 0
    for r <- iter.Range(0, rounds) {
        got, e := task.Run((s task.Scope) => {
            mut hs := mut []task.Handle[int]{}
            for _ <- iter.Range(0, 3) {
                hs = append(hs, task.Spawn(s, () => {
                    mut n := 0
                    while leaseOp(4, ctl.blk, hHead + r * wHead, 0) == 0 {
                        n += if late { reapLate(l) } else { Reap(l) }
                        os.Sleep(1)
                    }
                    n
                }))
            }
            _ = task.Spawn(s, () => {
                d, de := task.Run((s2 task.Scope) => {
                    for k <- iter.Range(0, dying) {
                        _ = task.Spawn(s2, () => {
                            i := TakeFree(l)
                            if i >= 0 {
                                Fresh(l, i, -1 - i)
                                Hold(l, i)
                                os.Sleep(0)
                                panic(Boom{})
                            }
                            k
                        })
                    }
                    0
                })
                assert(de != nil, "round ${r}: borrowers died")
                _ = leaseOp(5, ctl.blk, hHead + r * wHead, 1)
                d
            })
            mut sum := 0
            for v <- task.Gather(hs) {
                sum += v
            }
            sum
        })
        assert(e == nil, "round ${r}: reapers")
        reaped += got + (if late { reapLate(l) } else { Reap(l) })
        assert(reaped == (r + 1) * dying, "round ${r}: reaped ${reaped} of ${(r + 1) * dying}")
    }
    for i <- iter.Range(0, rounds * dying) {
        assert(state(l, i) == sFree, "slot ${i} free")
    }
}

// Reapの誤ったコピー（番号を走査の後で読む — TestReapRaceが捕まえるべき形）
func reapLate(l Lot) int {
    if leaseOp(9, l.blk, 0, 0) == leaseOp(4, l.blk, hSeen, 0) {
        return 0
    }
    n := size(l)
    mut lost := 0
    mut i := 0
    while i < n {
        b := base(l, i)
        if state(l, i) == sBusy && leaseOp(4, l.blk, b + wMark, 0) == 0 && cas(l, i, sBusy, sReap) {
            release(l, i)
            lost += 1
        }
        i += 1
    }
    _ = leaseOp(5, l.blk, hSeen, leaseOp(9, l.blk, 0, 0))
    return lost
}

func envSet(name string) bool {
    v, err := os.Getenv(name)
    return err == nil && v != nil && v != ""
}
