package lot

// 接続の預かり所（stdの内側 — std/pgのPool。language.md 28 節「資源とストリーム」・11 節「domain」）: 接続の実体（fdと値の外の格納場所）を枠に預かり、
// task の間を同一性の値として渡さずに貸し借りする。どの枠を借りてよいか（待機の本数・張れる本数）は呼び手の domain が数え、ここは枠の状態だけを持つ。
// 枠の状態は取り合う（別のワーカーのtaskが同時に走査する）ので比較交換で動かす。借りている枠は借り手のtaskのleaseのチェーンにマークを積む —
// 借り手が死ぬとrt.lease_drainがマークを0に戻す（deferは走らない）ので、「使用中なのにマークが0」の枠が死んだ借り手の枠（Reapが回収する）。
// fd は rt の登録簿に積まない（死んだ借り手の fd は Reap か Close が閉じる — 二重の閉じを作らない）

import "std/internal/sock"
import "std/iter"

// 枠の状態
const sFree = 0     // 空き（fd なし）
const sIdle = 1     // 待機（fdと格納場所を預かっている — 借りられる）
const sClaim = 2    // 取り中（持ち主の task だけが触る過渡の状態）
const sBusy = 3     // 使用中（借り手のマークがチェーンに積まれている）
const sReap = 4     // 回収中（死んだ借り手の枠を Reap が取った）

// 枠の語: [印, 鎖]（lease_op 2 / 3 の区画 — 並びは rt の約束）・状態・fd・置き場の語
const wMark = 0
const wState = 2
const wFd = 3
const wHead = 4

// 表の頭: 枠の数・枠ごとの格納場所のワード数・Reapが最後に走査した時の死の通し番号（lease_op 9）
const hN = 0
const hW = 1
const hSeen = 2
const hHead = 3

// 預かり所（表はimmの列 — ワードの読み書きはlease_opの生のAPI）
type Lot struct {
    blk []int
}

// n枠・枠ごとにwワードの格納場所の預かり所（全部空き）
func New(n int, w int) Lot {
    stride := wHead + w
    mut b := mut []int{}
    b = append(b, n)
    b = append(b, w)
    b = append(b, 0)
    for _ <- iter.Range(0, n * stride) {
        b = append(b, 0)
    }
    return Lot{blk: freeze(b)}
}

func size(l Lot) int {
    return leaseOp(4, l.blk, hN, 0)
}

func base(l Lot, i int) int {
    return hHead + i * (wHead + leaseOp(4, l.blk, hW, 0))
}

func state(l Lot, i int) int {
    return leaseOp(4, l.blk, base(l, i) + wState, 0)
}

// 枠 i の状態を from から to へ（取れたら true）
func cas(l Lot, i int, from int, to int) bool {
    return leaseOp(8, l.blk, base(l, i) + wState, from | (to << 8)) == from
}

// 待機の枠を 1 つ取る（取り中に — 無ければ −1。呼び手の domain が待機の本数を数えているので、本数を取った呼び手は必ず見つかる）
func TakeIdle(l Lot) int {
    return take(l, sIdle)
}

// 空きの枠を 1 つ取る（取り中に — 張る前。無ければ −1）
func TakeFree(l Lot) int {
    return take(l, sFree)
}

func take(l Lot, from int) int {
    n := size(l)
    mut i := 0
    while i < n {
        if state(l, i) == from && cas(l, i, from, sClaim) {
            return i
        }
        i += 1
    }
    return -1
}

// 取り中の枠iに張ったfdを置き、格納場所を0から始める（Holdの前 — 張ったばかりの接続）
func Fresh(l Lot, i int, fd int) {
    b := base(l, i)
    _ = leaseOp(5, l.blk, b + wFd, fd)
    w := leaseOp(4, l.blk, hW, 0)
    for k <- iter.Range(0, w) {
        _ = leaseOp(5, l.blk, b + wHead + k, 0)
    }
}

// 取り中の枠iを使用中に（マークを今のtaskのチェーンへ — このtaskが死ぬとrtがマークを0に戻す）
func Hold(l Lot, i int) {
    b := base(l, i)
    _ = leaseOp(2, l.blk, b + wMark, 0)
    _ = leaseOp(5, l.blk, b + wState, sBusy)
}

// 枠 i の fd
func Fd(l Lot, i int) int {
    return leaseOp(4, l.blk, base(l, i) + wFd, 0)
}

// 枠iの格納場所（immのウィンドウ — ワードはlease_opで読み書きする）
func Place(l Lot, i int) []int {
    return freeze(leaseView(l.blk, base(l, i) + wHead, leaseOp(4, l.blk, hW, 0)))
}

// 使用中の枠iを待機へ戻す（マークを外す — 取り中を挟む: 生きた借り手の「使用中・マーク0」がReapに見えないように）
func Park(l Lot, i int) {
    b := base(l, i)
    _ = leaseOp(5, l.blk, b + wState, sClaim)
    _ = leaseOp(3, l.blk, b + wMark, 0)
    _ = leaseOp(5, l.blk, b + wState, sIdle)
}

// 使用中の枠iを捨てる（マークを外し・fdを閉じて空きへ）
func Drop(l Lot, i int) {
    b := base(l, i)
    _ = leaseOp(5, l.blk, b + wState, sClaim)
    _ = leaseOp(3, l.blk, b + wMark, 0)
    release(l, i)
}

// 取り中の枠 i を空きへ（張れなかった枠・回収した枠 — fd があれば閉じる）
func Release(l Lot, i int) {
    release(l, i)
}

func release(l Lot, i int) {
    b := base(l, i)
    fd := leaseOp(4, l.blk, b + wFd, 0)
    if fd > 0 {
        internal.sock.Close(fd)
    }
    _ = leaseOp(5, l.blk, b + wFd, 0)
    _ = leaseOp(5, l.blk, b + wState, sFree)
}

// 死んだ借り手の枠（使用中・マーク0）を回収して空きへ戻し、その数を返す（呼び手はdomainのカウンタから引く — 二相の1相目）。
// 状態 → マークの順に読み、使用中 → 回収中の比較交換で取る（生きた借り手は使用中の間ずっとマークが1・返すときは取り中を挟む）。
// 走査はleaseの死の通し番号が前の走査から動いたときだけ: rtはマークを外してから番号を上げるので、走査の前に読んだ番号までの死は走査に見える。
// 番号は走査の前に読み、走査の後に書く（後で読むと、走査が通り過ぎた枠の死の番号を見たことにして取りこぼす）。並んだ Reap が古い番号を書き戻しても、次の走査が 1 回増えるだけ
func Reap(l Lot) int {
    seen := leaseOp(9, l.blk, 0, 0)
    if seen == leaseOp(4, l.blk, hSeen, 0) {
        return 0
    }
    n := size(l)
    mut lost := 0
    mut i := 0
    while i < n {
        b := base(l, i)
        if state(l, i) == sBusy && leaseOp(4, l.blk, b + wMark, 0) == 0 && cas(l, i, sBusy, sReap) {
            release(l, i)
            lost += 1
        }
        i += 1
    }
    _ = leaseOp(5, l.blk, hSeen, seen)
    return lost
}

// 待機の枠を順にkへ渡して（別れの挨拶 — 格納場所とfd）から、全部の枠のfdを閉じる（預かり所の持ち主の出口 — 借り手はもう居ない）
func Close(l Lot, k func(fd int, place []int)) {
    n := size(l)
    mut i := 0
    while i < n {
        if state(l, i) == sIdle {
            k(Fd(l, i), Place(l, i))
        }
        release(l, i)
        i += 1
    }
}

// lease_op（rtのAPI — op 2 = マークを取ってチェーンへ・3 = マークを外す・4 = 生の読み・5 = 生の書き・8 = 比較交換・9 = leaseの死の通し番号）
@intrinsic("lease_op")
func leaseOp(op int, blk []int, off int, v int) int

@intrinsic("lease_view")
func leaseView(blk []int, off int, n int) mut []int
