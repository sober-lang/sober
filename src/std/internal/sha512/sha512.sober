package sha512

// SHA-512とSHA-384（FIPS 180-4 — 64 bitのワード・80段）のワンショットのAPI（stdの内側 — ECDSAのP-384とX.509のecdsa-with-SHA384の下）。
// 算術は64 bitのワードのmod 2^64（intの和のwrap）・右回転と右シフトは算術シフトの上のbitをmaskで落とす。データに依る分岐・添字は無い

import "std/iter"

// 64 bit の右回転（k は 1..63）
func rotr(x int, k int) int {
    return ((x >> k) & ((1 << (64 - k)) - 1)) | (x << (64 - k))
}

// 64 bit の論理右シフト（k は 1..63）
func shr(x int, k int) int {
    return (x >> k) & ((1 << (64 - k)) - 1)
}

// 丸め定数（最初の80個の素数の立方根の小数部の先頭64 bit — FIPS 180-4 4.2.3。2^63以上のワードは負のintで書く）
func k512() []int {
    return []int{
        0x428a2f98d728ae22, 0x7137449123ef65cd, -0x4a3f043013b2c4d1, -0x164a245a7e762444,
        0x3956c25bf348b538, 0x59f111f1b605d019, -0x6dc07d5b50e6b065, -0x54e3a12a25927ee8,
        -0x27f855675cfcfdbe, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
        0x72be5d74f27b896f, -0x7f214e01c4e9694f, -0x6423f958da38edcb, -0x3e640e8b3096d96c,
        -0x1b64963e610eb52e, -0x1041b879c7b0da1d, 0xfc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
        0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
        -0x67c1aead11992055, -0x57ce3992d24bcdf0, -0x4ffcd8376704dec1, -0x40a680384110f11c,
        -0x391ff40cc257703e, -0x2a586eb86cf558db, 0x6ca6351e003826f, 0x142929670a0e6e70,
        0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
        0x650a73548baf63de, 0x766a0abb3c77b2a8, -0x7e3d36d1b812511a, -0x6d8dd37aeb7dcac5,
        -0x5d40175eb30efc9c, -0x57e599b443bdcfff, -0x3db4748f2f07686f, -0x3893ae5cf9ab41d0,
        -0x2e6d17e62910ade8, -0x2966f9dbaa9a56f0, -0xbf1ca7aa88edfd6, 0x106aa07032bbd1b8,
        0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
        0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
        0x748f82ee5defb2fc, 0x78a5636f43172f60, -0x7b3787eb5e0f548e, -0x7338fdf7e59bc614,
        -0x6f410005dc9ce1d8, -0x5baf9314217d4217, -0x41065c084d3986eb, -0x398e870d1c8dacd5,
        -0x35d8c13115d99e64, -0x2e794738de3f3df9, -0x15258229321f14e2, -0xa82b08011912e88,
        0x6f067aa72176fba, 0xa637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
        0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
        0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817,
    }
}

// data の SHA-512（64 バイト）
@effects()
func Sum512(data []byte) []byte {
    return sum(data, []int{0x6a09e667f3bcc908, -0x4498517a7b3558c5, 0x3c6ef372fe94f82b, -0x5ab00ac5a0e2c90f, 0x510e527fade682d1, -0x64fa9773d4c193e1, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179}, 64)
}

// dataのSHA-384（48バイト — 初期値の違うSHA-512の先頭6ワード）
@effects()
func Sum384(data []byte) []byte {
    return sum(data, []int{-0x344462a23efa6128, 0x629a292a367cd507, -0x6ea6fea5cf8f22e9, 0x152fecd8f70e5939, 0x67332667ffc00b31, -0x714bb57897a7eaef, -0x24f3d1f29b067059, 0x47b5481dbefa4fa4}, 48)
}

// 初期値 iv から data を畳んで先頭 n バイト（詰め = 0x80・0 埋め・128 bit の長さ〔上の 64 bit は 0 — 2^61 バイト未満の入力〕）
func sum(data []byte, iv []int, n int) []byte {
    mut h := mut []int{}
    for i <- iter.Range(0, 8) {
        h = append(h, iv[i])
    }
    mut w := mut []int{}
    for i <- iter.Range(0, 80) {
        w = append(w, 0)
    }
    k := k512()
    ln := len(data)
    rest := ln % 128
    tl := if rest < 112 { 128 } else { 256 }
    mut t := mut []byte{}
    for i <- iter.Range(ln - rest, ln) {
        t = append(t, data[i])
    }
    t = append(t, byte(0x80))
    for i <- iter.Range(rest + 1, tl - 8) {
        t = append(t, byte(0))
    }
    bits := ln * 8
    for i <- iter.Range(0, 8) {
        t = append(t, byte((bits >> (56 - 8 * i)) & 0xff))
    }
    tail := freeze(t)
    mut off := 0
    while off + 128 <= ln - rest {
        block(mut h, mut w, k, data, off)
        off = off + 128
    }
    mut toff := 0
    while toff < len(tail) {
        block(mut h, mut w, k, tail, toff)
        toff = toff + 128
    }
    mut out := mut []byte{}
    for i <- iter.Range(0, n) {
        out = append(out, byte((h[i / 8] >> (56 - 8 * (i % 8))) & 0xff))
    }
    return freeze(out)
}

// b[off:off + 128] をhに畳む（wは80ワードの作業域）
func block(h mut []int, w mut []int, k []int, b []byte, off int) {
    for i <- iter.Range(0, 16) {
        mut x := 0
        for j <- iter.Range(0, 8) {
            x = (x << 8) | int(b[off + 8 * i + j])
        }
        w[i] = x
    }
    for i <- iter.Range(16, 80) {
        s0 := rotr(w[i - 15], 1) ^ rotr(w[i - 15], 8) ^ shr(w[i - 15], 7)
        s1 := rotr(w[i - 2], 19) ^ rotr(w[i - 2], 61) ^ shr(w[i - 2], 6)
        w[i] = w[i - 16] + s0 + w[i - 7] + s1
    }
    mut a := h[0]
    mut b2 := h[1]
    mut c := h[2]
    mut d := h[3]
    mut e := h[4]
    mut f := h[5]
    mut g := h[6]
    mut hh := h[7]
    for i <- iter.Range(0, 80) {
        t1 := hh + (rotr(e, 14) ^ rotr(e, 18) ^ rotr(e, 41)) + ((e & f) ^ (^e & g)) + k[i] + w[i]
        t2 := (rotr(a, 28) ^ rotr(a, 34) ^ rotr(a, 39)) + ((a & b2) ^ (a & c) ^ (b2 & c))
        hh = g
        g = f
        f = e
        e = d + t1
        d = c
        c = b2
        b2 = a
        a = t1 + t2
    }
    h[0] = h[0] + a
    h[1] = h[1] + b2
    h[2] = h[2] + c
    h[3] = h[3] + d
    h[4] = h[4] + e
    h[5] = h[5] + f
    h[6] = h[6] + g
    h[7] = h[7] + hh
}
