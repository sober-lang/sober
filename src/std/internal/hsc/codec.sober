package hsc

// codec: handshake のメッセージの読み書きの部品（std/internal/hs の codec の写し — サーバだけのプログラムがクライアントの部品を抱えないよう package を分けた）。読みは粘着する失敗の印つきのカーソル（Cur — 読む範囲 [at, end) だけを
// 持ち、切片は読みのたびに渡す。範囲の外を読んだら bad が立って以後 0 を返す・呼び手は区切りごとに 1 回だけ見る — decode_error）。
// 書きは mut []byte への積み（u8 / u16 / u24 と長さ前置きの塊）

import "std/crypto/sha256"
import "std/internal/record"
import "std/iter"

// 切片の [at, end) を読むカーソル（bad = 範囲の外を読もうとした）
type Cur struct {
    at int
    end int
    bad bool
}

func cur(at int, end int) Cur {
    return Cur{at: at, end: end, bad: false}
}

func u8(b []byte, c mut Cur) int {
    if c.at + 1 > c.end {
        c.bad = true
        return 0
    }
    v := int(b[c.at])
    c.at += 1
    return v
}

func u16(b []byte, c mut Cur) int {
    if c.at + 2 > c.end {
        c.bad = true
        return 0
    }
    v := int(b[c.at]) << 8 | int(b[c.at + 1])
    c.at += 2
    return v
}

func u24(b []byte, c mut Cur) int {
    if c.at + 3 > c.end {
        c.bad = true
        return 0
    }
    v := int(b[c.at]) << 16 | int(b[c.at + 1]) << 8 | int(b[c.at + 2])
    c.at += 3
    return v
}

// 今の位置から n バイトの内側のカーソル（外側はその後ろへ進む）
func sub(c mut Cur, n int) Cur {
    if n < 0 || c.at + n > c.end {
        c.bad = true
        return Cur{at: c.end, end: c.end, bad: true}
    }
    s := Cur{at: c.at, end: c.at + n, bad: false}
    c.at += n
    return s
}

// 今の位置から n バイトの写し
func take(b []byte, c mut Cur, n int) []byte {
    if n < 0 || c.at + n > c.end {
        c.bad = true
        return []byte{}
    }
    mut out := mut []byte{}
    e := c.at + n
    mut j := c.at
    while j < e {
        out = append(out, b[j])
        j += 1
    }
    c.at = e
    return freeze(out)
}

func rest(c Cur) int {
    return c.end - c.at
}

func put8(o mut []byte, v int) {
    o = append(o, byte(v & 0xff))
}

func put16(o mut []byte, v int) {
    o = append(o, byte((v >> 8) & 0xff))
    o = append(o, byte(v & 0xff))
}

func put24(o mut []byte, v int) {
    o = append(o, byte((v >> 16) & 0xff))
    o = append(o, byte((v >> 8) & 0xff))
    o = append(o, byte(v & 0xff))
}

func putBytes(o mut []byte, b []byte) {
    mut j := 0
    while j < len(b) {
        o = append(o, b[j])
        j += 1
    }
}

// handshake のメッセージ（型 1 バイト ‖ 長さ 3 バイト ‖ 本体）
func msg(t int, body []byte) []byte {
    mut o := mut []byte{}
    put8(mut o, t)
    put24(mut o, len(body))
    putBytes(mut o, body)
    return freeze(o)
}

// a ‖ b
func cat(a []byte, b []byte) []byte {
    mut o := mut []byte{}
    putBytes(mut o, a)
    putBytes(mut o, b)
    return freeze(o)
}

// b[at, at + n) の写し
func sliceOf(b []byte, at int, n int) []byte {
    mut o := mut []byte{}
    for i <- iter.Range(at, at + n) {
        o = append(o, b[i])
    }
    return freeze(o)
}

// クライアントが使う定数と小さい部品（std/internal/hs のサーバの側と同じ値）
const tClientHello = 1
const tServerHello = 2
const tEncryptedExtensions = 8
const tCertificate = 11
const tCertificateVerify = 15
const tFinished = 20
const tKeyUpdate = 24
const tMessageHash = 254
const xServerName = 0
const xSupportedGroups = 10
const xSignatureAlgorithms = 13
const xAlpn = 16
const xSupportedVersions = 43
const xKeyShare = 51
const groupX25519 = 0x001d
const groupSecp256r1 = 0x0017
const aCloseNotify = 0
const aUnexpected = 10
const aHandshakeFailure = 40
const aIllegalParameter = 47
const aInternalError = 80
const aDecodeError = 50
const aDecryptError = 51
const aProtocolVersion = 70
const aInternal = 80

// Feed の結果（send = 相手へ送る record の列・app = 受けた application の平文・done = この枠で handshake が済んだ・closed = 相手が閉じた〔peer = 受けた alert の番号〕・
// upd = 相手が update_requested の KeyUpdate を送った）
type Out struct {
    send []byte
    app []byte
    done bool
    closed bool
    peer int
    upd bool
}

func none() Out {
    return Out{send: []byte{}, app: []byte{}, done: false, closed: false, peer: 0 - 1, upd: false}
}

func alert(d int) error? {
    return internal.record.Alert{desc: d}
}

func hrrRandom() []byte {
    return crypto.sha256.Sum256(bytes("HelloRetryRequest"))
}

func emptyDir() internal.record.Dir {
    d, _ := internal.record.NewDir(0, []byte{})
    return d
}

// Derive-Secret(secret, label, transcript の hash)（RFC 9846 7.1）
func deriveSecret(secret []byte, label string, th []byte) []byte {
    return internal.record.ExpandLabel(secret, label, th, 32)
}

// 暗号化しない record（頭 = 型 / 0x0303 / 長さ — 2^14 ずつ割る）
func plain(ct int, body []byte) []byte {
    mut o := mut []byte{}
    mut at := 0
    while at < len(body) || at == 0 {
        n := if len(body) - at < internal.record.MaxPlain { len(body) - at } else { internal.record.MaxPlain }
        put8(mut o, ct)
        put16(mut o, 0x0303)
        put16(mut o, n)
        for i <- iter.Range(at, at + n) {
            o = append(o, body[i])
        }
        at += n
        if len(body) == 0 {
            at = 1
        }
    }
    return freeze(o)
}

func zeros(n int) []byte {
    mut z := mut []byte{}
    for i <- iter.Range(0, n) {
        z = append(z, byte(0))
    }
    return freeze(z)
}
