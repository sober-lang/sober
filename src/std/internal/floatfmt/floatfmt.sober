package floatfmt

// 浮動小数の文字列化と解析（language.md 37 節 — println と std/convert の FormatFloat / ParseFloat の中身 — std の実装の詳細 std/internal/…・利用者は std/convert を使う）。値は IEEE 754 binary64 の
// ビット列（i64 の 2 の補数で読んだ int）で受け渡し、計算は整数だけ（多倍長 — 30 ビットの肢を下位から）。このファイルは浮動小数の型の名前も
// リテラルも書かない — 型の名前かリテラルを含むファイルには parser がこのパッケージの暗黙の import を足す（println の印字の中身）ので、
// ここに書くと自分自身を import する。
//   Format: 最短の往復表現（読み戻すと同じビットになる最短の 10 進 — Burger & Dybvig の free-format 算法・境界は最近接・偶数の読み戻しに合わせ
//     仮数が偶数なら端を含む）を Go の strconv.FormatFloat(f, 'g', -1, 64) と同じ綴りで
//   ParseBits: 10 進の正確な値を 1 回だけ最近接・偶数へ丸める（compiler/lexer の浮動小数リテラルもこれを使う — リテラルと実行時の解析は同じビット）

import "std/internal/bigint"
import "std/iter"

const HIDDEN = 4503599627370496 // 2^52

// binary64 のビット列 bits の最短の往復表現
func Format(bits int) string {
    neg := bits < 0
    ex := (bits >> 52) & 2047
    mant := bits & 4503599627370495
    if ex == 2047 {
        if mant != 0 {
            return "NaN"
        }
        return if neg { "-Inf" } else { "+Inf" }
    }
    mut out := mut []byte{}
    if neg {
        out = append(out, '-')
    }
    if ex == 0 && mant == 0 {
        out = append(out, '0')
        return bytesToString(freeze(out))
    }
    mut ds := mut []int{}
    // 速いパス: 正確な10進展開が15桁以下ならそれが一意の最短（別の短い10進は最後の桁の1単位以上 = 相対1e-15以上離れ、
    // binary64 の 1/2 ulp〔相対 ≤ 2^-53 ≈ 1.1e-16〕より遠い — 別の float に丸まる）。外れは Burger & Dybvig の多倍長
    fdp := exactShort(mut ds, ex, mant)
    dp := if fdp != NoFast { fdp } else { shortest(mut ds, ex, mant) }
    nd := len(ds)
    // 'g' の最短形: 指数 = dp - 1 が -4 未満か 6 以上なら %e（Go の ftoa — 最短のときの判定は精度 6）
    exp := dp - 1
    if exp < -4 || exp >= 6 {
        out = append(out, byte('0' + ds[0]))
        if nd > 1 {
            out = append(out, '.')
            for i <- iter.Range(1, nd) {
                out = append(out, byte('0' + ds[i]))
            }
        }
        out = append(out, 'e')
        mut x := exp
        if x < 0 {
            out = append(out, '-')
            x = 0 - x
        } else {
            out = append(out, '+')
        }
        if x >= 100 {
            out = append(out, byte('0' + x / 100))
            out = append(out, byte('0' + x / 10 % 10))
        } else {
            out = append(out, byte('0' + x / 10))
        }
        out = append(out, byte('0' + x % 10))
        return bytesToString(freeze(out))
    }
    // %f: 整数部（足りない桁は 0）と小数部（max(nd - dp, 0) 桁）
    if dp > 0 {
        for i <- iter.Range(0, dp) {
            out = append(out, byte('0' + (if i < nd { ds[i] } else { 0 })))
        }
    } else {
        out = append(out, '0')
    }
    prec := if nd - dp > 0 { nd - dp } else { 0 }
    if prec > 0 {
        out = append(out, '.')
        for i <- iter.Range(0, prec) {
            j := dp + i
            out = append(out, byte('0' + (if j >= 0 && j < nd { ds[j] } else { 0 })))
        }
    }
    return bytesToString(freeze(out))
}

// binary64 のビット列 bits を小数点以下 prec 桁で（Go の strconv.FormatFloat(f, 'f', prec, 64)・fmt の %.<prec>f と同じ綴り —
// 正確な値を 10^prec 倍して最近接・偶数へ 1 回だけ丸める。負の 0・負に丸まって 0 になる値も符号を残す）（対の ParseFixed は実需まで足さない — 34 節 2 の注記）
func FormatFixed(bits int, prec int) string {
    neg := bits < 0
    ex := (bits >> 52) & 2047
    mant := bits & 4503599627370495
    if ex == 2047 {
        if mant != 0 {
            return "NaN"
        }
        return if neg { "-Inf" } else { "+Inf" }
    }
    mut f := mant
    mut e := -1074
    if ex > 0 {
        f = mant + HIDDEN
        e = ex - 1075
    }
    // q = round(f × 2^e × 10^prec)（最近接・偶数）
    mut n := mut []int{}
    internal.bigint.SetInt(mut n, f)
    for k <- iter.Range(0, prec) {
        internal.bigint.MulAdd(mut n, 10, 0)
    }
    mut q := mut []int{}
    if e >= 0 {
        internal.bigint.Shl(mut n, e)
        internal.bigint.Set(mut q, mut n)
    } else {
        // q = floor(n / 2^-e)・余りの比較で丸め
        sh := 0 - e
        mut d := mut []int{}
        internal.bigint.SetInt(mut d, 1)
        internal.bigint.Shl(mut d, sh)
        internal.bigint.Shr(mut q, mut n, sh)
        mut back := mut []int{}
        internal.bigint.Set(mut back, mut q)
        internal.bigint.Shl(mut back, sh)
        mut r := mut []int{}
        internal.bigint.Set(mut r, mut n)
        internal.bigint.Sub(mut r, mut back)
        internal.bigint.MulAdd(mut r, 2, 0)
        c := internal.bigint.Cmp(mut r, mut d)
        if c > 0 || (c == 0 && internal.bigint.Odd(mut q)) {
            internal.bigint.MulAdd(mut q, 1, 1)
        }
    }
    // q の 10 進の桁（下位から）
    mut ds := mut []int{}
    while internal.bigint.Top(mut q) >= 0 {
        ds = append(ds, internal.bigint.DivSmall(mut q, 10))
    }
    while len(ds) < prec + 1 {
        ds = append(ds, 0)
    }
    mut out := mut []byte{}
    if neg {
        out = append(out, '-')
    }
    mut i := len(ds) - 1
    while i >= 0 {
        out = append(out, byte('0' + ds[i]))
        if i == prec && prec > 0 {
            out = append(out, '.')
        }
        i -= 1
    }
    return bytesToString(freeze(out))
}

// shortestは有限の正の値（指数のフィールドex・仮数のフィールドmant — 0でない）の最短の桁をdsに積み、小数点の位置dp（値 = 0.d1d2… × 10^dp）を返す
// NoFastはexactShortが速いパスを使えないマーク
const NoFast = -100000

// 値（正規化数の ex・mant）の正確な 10 進展開が 15 桁以下なら、その桁を ds に積んで小数点の位置 dp を返す（でなければ NoFast・ds は空のまま）
func exactShort(ds mut []int, ex int, mant int) int {
    if ex == 0 {
        return NoFast
    }
    mut m := mant | 4503599627370496
    mut e := ex - 1075
    // 末尾の 0 のビットを落とす（m を奇数に）
    while m & 1 == 0 && e < 0 {
        m = m >> 1
        e += 1
    }
    lim := 1000000000000000
    mut n := 0
    mut k := 0
    if e >= 0 {
        // 整数: m << e が 10^15 以下
        if e > 10 {
            return NoFast
        }
        n = m << e
        if n > lim {
            return NoFast
        }
    } else {
        // m / 2^k = m × 5^k / 10^k（m は奇数 — 10 進の末尾に 0 は出ない）
        k = 0 - e
        n = m
        mut j := 0
        while j < k {
            if n > lim / 5 {
                return NoFast
            }
            n = n * 5
            j += 1
        }
    }
    // n の 10 進の桁（末尾の 0 は落とす — 整数の場合だけ出る）
    mut rev := mut []int{}
    mut x := n
    while x > 0 {
        rev = append(rev, x % 10)
        x = x / 10
    }
    nd := len(rev)
    mut lo := 0
    while lo < nd - 1 && rev[lo] == 0 {
        lo += 1
    }
    mut i := nd - 1
    while i >= lo {
        ds = append(ds, rev[i])
        i -= 1
    }
    return nd - k
}

func shortest(ds mut []int, ex int, mant int) int {
    mut f := mant
    mut e := -1074
    if ex > 0 {
        f = mant + HIDDEN
        e = ex - 1075
    }
    even := f % 2 == 0
    // 値 = r / s・上下の隣との中点までの幅 = mp / s・mm / s（仮数がちょうど 2^52 で指数が最小でなければ下の幅は半分）
    mut r := mut []int{}
    mut s := mut []int{}
    mut mp := mut []int{}
    mut mm := mut []int{}
    if e >= 0 {
        internal.bigint.SetInt(mut r, f)
        internal.bigint.SetInt(mut mp, 1)
        internal.bigint.Shl(mut mp, e)
        internal.bigint.SetInt(mut mm, 1)
        internal.bigint.Shl(mut mm, e)
        if f != HIDDEN {
            internal.bigint.Shl(mut r, e + 1)
            internal.bigint.SetInt(mut s, 2)
        } else {
            internal.bigint.Shl(mut r, e + 2)
            internal.bigint.SetInt(mut s, 4)
            internal.bigint.Shl(mut mp, 1)
        }
    } else {
        internal.bigint.SetInt(mut r, f)
        internal.bigint.SetInt(mut s, 1)
        internal.bigint.SetInt(mut mm, 1)
        if ex <= 1 || f != HIDDEN {
            internal.bigint.Shl(mut r, 1)
            internal.bigint.Shl(mut s, 1 - e)
            internal.bigint.SetInt(mut mp, 1)
        } else {
            internal.bigint.Shl(mut r, 2)
            internal.bigint.Shl(mut s, 2 - e)
            internal.bigint.SetInt(mut mp, 2)
        }
    }
    // k = 上の端 (r + mp) / s が 10^k 未満（偶数なら以下）になる最小の k。見積もり（log10 2 ≈ 78913 / 2^18）から合わせる
    bl := bitLen(f) + e
    mut k := if bl >= 1 { ((bl - 1) * 78913) >> 18 } else { 0 - ((((1 - bl) * 78913) >> 18) + 1) }
    if k >= 0 {
        for i <- iter.Range(0, k) {
            internal.bigint.MulAdd(mut s, 10, 0)
        }
    } else {
        for i <- iter.Range(0, 0 - k) {
            internal.bigint.MulAdd(mut r, 10, 0)
            internal.bigint.MulAdd(mut mp, 10, 0)
            internal.bigint.MulAdd(mut mm, 10, 0)
        }
    }
    mut hi := mut []int{}
    mut fixed := false
    while !fixed {
        internal.bigint.Set(mut hi, mut r)
        internal.bigint.Add(mut hi, mut mp)
        c := internal.bigint.Cmp(mut hi, mut s)
        if c > 0 || (c == 0 && even) {
            internal.bigint.MulAdd(mut s, 10, 0)
            k += 1
        } else {
            // 小さすぎないか: (r + mp) × 10 が s を越えなければ（偶数なら届かなければ）1 つ下げる
            internal.bigint.MulAdd(mut hi, 10, 0)
            c2 := internal.bigint.Cmp(mut hi, mut s)
            if c2 < 0 || (c2 == 0 && !even) {
                internal.bigint.MulAdd(mut r, 10, 0)
                internal.bigint.MulAdd(mut mp, 10, 0)
                internal.bigint.MulAdd(mut mm, 10, 0)
                k -= 1
            } else {
                fixed = true
            }
        }
    }
    // 桁を出す
    mut done := false
    while !done {
        internal.bigint.MulAdd(mut r, 10, 0)
        internal.bigint.MulAdd(mut mp, 10, 0)
        internal.bigint.MulAdd(mut mm, 10, 0)
        mut d := 0
        while internal.bigint.Cmp(mut r, mut s) >= 0 {
            internal.bigint.Sub(mut r, mut s)
            d += 1
        }
        cl := internal.bigint.Cmp(mut r, mut mm)
        tc1 := cl < 0 || (cl == 0 && even)
        internal.bigint.Set(mut hi, mut r)
        internal.bigint.Add(mut hi, mut mp)
        ch := internal.bigint.Cmp(mut hi, mut s)
        tc2 := ch > 0 || (ch == 0 && even)
        if !tc1 && !tc2 {
            ds = append(ds, d)
        } else {
            done = true
            if tc1 && !tc2 {
                ds = append(ds, d)
            } else if !tc1 && tc2 {
                ds = append(ds, d + 1)
            } else {
                // 両方の端に届く: 近い方（2r と s の比較 — 同点は偶数の桁）
                internal.bigint.Set(mut hi, mut r)
                internal.bigint.MulAdd(mut hi, 2, 0)
                c3 := internal.bigint.Cmp(mut hi, mut s)
                ds = append(ds, if c3 < 0 || (c3 == 0 && d % 2 == 0) { d } else { d + 1 })
            }
        }
    }
    return k
}

// ParseBits の構文の違い
type InvalidSyntax error {
}

// ParseBits の溢れ（値は符号つきの ±Inf のビット列 — Go の ErrRange と同じ）
type OutOfRange error {
}

// s（[+-]? と 10 進の数字・小数点・指数、または inf / infinity / nan — 大文字小文字を問わない）の値のビット列。
// Go の strconv.ParseFloat の 10 進の部分集合（16 進・_ は受けない）。0 に丸まる小さい値は誤りでない
@errors(InvalidSyntax, OutOfRange)
func ParseBits(s []byte) (int, error?) { // 対の FormatBits は実需まで足さない（34 節 2 の注記）
    v, st := parseBits(s)
    if st == 1 {
        return 0, InvalidSyntax{}
    }
    if st == 2 {
        return v, OutOfRange{}
    }
    return v, nil
}

// ParseBits の中身（状態 0 = ok・1 = 構文が違う・2 = 溢れ〔±Inf を返す〕）
func parseBits(s []byte) (int, int) {
    mut i := 0
    mut neg := false
    if i < len(s) && (s[i] == '+' || s[i] == '-') {
        neg = s[i] == '-'
        i += 1
    }
    sign := if neg { 0 - 9223372036854775807 - 1 } else { 0 }
    if wordAt(s, i, "infinity") || wordAt(s, i, "inf") {
        n := if wordAt(s, i, "infinity") { 8 } else { 3 }
        if i + n != len(s) {
            return 0, 1
        }
        return sign | 9218868437227405312, 0
    }
    if wordAt(s, i, "nan") {
        if i + 3 != len(s) || i != 0 {
            return 0, 1
        }
        return 9221120237041090561, 0
    }
    mut ds := mut []int{}
    mut exp10 := 0
    mut frac := false
    mut nd := 0
    while i < len(s) && ((s[i] >= '0' && s[i] <= '9') || (s[i] == '.' && !frac)) {
        if s[i] == '.' {
            frac = true
        } else {
            nd += 1
            if len(ds) > 0 || s[i] != '0' {
                ds = append(ds, int(s[i]) - '0')
            }
            if frac {
                exp10 -= 1
            }
        }
        i += 1
    }
    if nd == 0 {
        return 0, 1
    }
    if i < len(s) && (s[i] == 'e' || s[i] == 'E') {
        i += 1
        mut eneg := false
        if i < len(s) && (s[i] == '+' || s[i] == '-') {
            eneg = s[i] == '-'
            i += 1
        }
        if i >= len(s) {
            return 0, 1
        }
        mut x := 0
        while i < len(s) && s[i] >= '0' && s[i] <= '9' {
            if x < 100000000 {
                x = x * 10 + int(s[i]) - '0'
            }
            i += 1
        }
        if eneg {
            exp10 = exp10 - x
        } else {
            exp10 = exp10 + x
        }
    }
    if i != len(s) {
        return 0, 1
    }
    v, ok := decimalBits(mut ds, exp10)
    if !ok {
        return sign | 9218868437227405312, 2
    }
    return sign | v, 0
}

// s の i からが w（小文字）と大文字小文字を問わず一致するか
func wordAt(s []byte, i int, w string) bool {
    wb := bytes(w)
    if i + len(wb) > len(s) {
        return false
    }
    for j <- iter.Range(0, len(wb)) {
        c := int(s[i + j])
        lc := if c >= 'A' && c <= 'Z' { c + 32 } else { c }
        if lc != int(wb[j]) {
            return false
        }
    }
    return true
}

// 整数 d1d2…dn（ds — 先頭は 0 でない）× 10^exp10 の正確な値の binary64（溢れは false）
func decimalBits(ds mut []int, exp10 int) (int, bool) {
    if len(ds) == 0 {
        return 0, true
    }
    mag := len(ds) + exp10
    if mag < -324 {
        return 0, true
    }
    if mag > 310 {
        return 0, false
    }
    mut n := mut []int{0}
    for k <- iter.Range(0, len(ds)) {
        internal.bigint.MulAdd(mut n, 10, ds[k])
    }
    mut den := mut []int{1}
    if exp10 >= 0 {
        for k <- iter.Range(0, exp10) {
            internal.bigint.MulAdd(mut n, 10, 0)
        }
    } else {
        for k <- iter.Range(0, 0 - exp10) {
            internal.bigint.MulAdd(mut den, 10, 0)
        }
    }
    mut s := 52 - (internal.bigint.BitLen(mut n) - internal.bigint.BitLen(mut den))
    mut q := 0
    mut r := mut []int{}
    mut d2 := mut []int{}
    mut tries := 0
    while tries < 4 {
        q = bnDivScaled(mut n, mut den, s, mut r, mut d2)
        if q < HIDDEN {
            s += 1
        } else if q >= 9007199254740992 {
            s -= 1
        } else {
            tries = 4
        }
        tries += 1
    }
    mut biased := 0 - s + 1075
    if biased <= 0 {
        s = 1074
        q = bnDivScaled(mut n, mut den, s, mut r, mut d2)
        biased = 0
    }
    internal.bigint.MulAdd(mut r, 2, 0)
    c := internal.bigint.Cmp(mut r, mut d2)
    if c > 0 || (c == 0 && q % 2 == 1) {
        q += 1
    }
    if biased == 0 {
        return q, true
    }
    if q == 9007199254740992 {
        q = HIDDEN
        biased += 1
    }
    if biased >= 2047 {
        return 0, false
    }
    return (biased << 52) | (q - HIDDEN), true
}

func bnDivScaled(n mut []int, den mut []int, s int, r mut []int, d2 mut []int) int {
    internal.bigint.Set(mut r, mut n)
    internal.bigint.Set(mut d2, mut den)
    if s >= 0 {
        internal.bigint.Shl(mut r, s)
    } else {
        internal.bigint.Shl(mut d2, 0 - s)
    }
    mut q := 0
    mut sh := mut []int{}
    mut k := 55
    while k >= 0 {
        internal.bigint.Set(mut sh, mut d2)
        internal.bigint.Shl(mut sh, k)
        if internal.bigint.Cmp(mut r, mut sh) >= 0 {
            internal.bigint.Sub(mut r, mut sh)
            q = q | (1 << k)
        }
        k -= 1
    }
    return q
}

func bitLen(x0 int) int {
    mut x := x0
    mut n := 0
    while x > 0 {
        x = x >> 1
        n += 1
    }
    return n
}
