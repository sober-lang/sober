package bigint

// 符号なしの多倍長の整数（30 ビットの肢を下位から — `mut []int`）。積は 2^61 未満に収まり、int の溢れに触れない
// （溢れの意味論は Lean の約束〔値が 64 bit に収まる限り一致 — formal.md〕の外）。どの関数も宛先を mut の実引数で受けて書き換える

import "std/iter"

// 肢の基数
const Limb = 1073741824 // 2^30

// a = v（v は非負の int）
func SetInt(a mut []int, v0 int) {
    a = mut []int{}
    mut v := v0
    a = append(a, v % Limb)
    v = v / Limb
    while v > 0 {
        a = append(a, v % Limb)
        v = v / Limb
    }
}

// a = bのコピー
func Set(a mut []int, b mut []int) {
    a = mut []int{}
    for k <- iter.Range(0, len(b)) {
        a = append(a, b[k])
    }
}

// a = a × m + c（m・c は小さい非負）
func MulAdd(a mut []int, m int, c int) {
    mut carry := c
    for k <- iter.Range(0, len(a)) {
        x := a[k] * m + carry
        a[k] = x % Limb
        carry = x / Limb
    }
    while carry > 0 {
        a = append(a, carry % Limb)
        carry = carry / Limb
    }
}

// a = a + b
func Add(a mut []int, b mut []int) {
    while len(a) < len(b) {
        a = append(a, 0)
    }
    mut carry := 0
    for k <- iter.Range(0, len(a)) {
        x := a[k] + (if k < len(b) { b[k] } else { 0 }) + carry
        a[k] = x % Limb
        carry = x / Limb
    }
    if carry > 0 {
        a = append(a, carry)
    }
}

// a = a × 2^n
func Shl(a mut []int, n int) {
    mut w := n / 30
    bits := n % 30
    if bits > 0 {
        mut carry := 0
        for k <- iter.Range(0, len(a)) {
            x := (a[k] << bits) + carry
            a[k] = x % Limb
            carry = x / Limb
        }
        if carry > 0 {
            a = append(a, carry)
        }
    }
    if w > 0 {
        mut z := mut []int{}
        while w > 0 {
            z = append(z, 0)
            w -= 1
        }
        for k <- iter.Range(0, len(a)) {
            z = append(z, a[k])
        }
        a = z
    }
}

// q = floor(a / 2^n)
func Shr(q mut []int, a mut []int, n int) {
    w := n / 30
    bits := n % 30
    q = mut []int{}
    mut k := w
    while k < len(a) {
        lo := a[k] >> bits
        hi := if k + 1 < len(a) && bits > 0 { (a[k + 1] << (30 - bits)) % Limb } else { 0 }
        q = append(q, lo | hi)
        k += 1
    }
    if len(q) == 0 {
        q = append(q, 0)
    }
}

// a = floor(a / m) にして余りを返す（m は小さい正）
func DivSmall(a mut []int, m int) int {
    mut r := 0
    mut k := len(a) - 1
    while k >= 0 {
        x := r * Limb + a[k]
        a[k] = x / m
        r = x % m
        k -= 1
    }
    return r
}

// a が奇数か
func Odd(a mut []int) bool {
    return len(a) > 0 && a[0] % 2 == 1
}

// 0 でない最上位の肢の添字（a = 0 なら -1）
func Top(a mut []int) int {
    mut k := len(a) - 1
    while k >= 0 && a[k] == 0 {
        k -= 1
    }
    return k
}

// a のビットの長さ（a = 0 なら 0）
func BitLen(a mut []int) int {
    t := Top(mut a)
    if t < 0 {
        return 0
    }
    return t * 30 + bitLen(a[t])
}

// a と b の大小（-1 / 0 / 1）
func Cmp(a mut []int, b mut []int) int {
    ta := Top(mut a)
    tb := Top(mut b)
    if ta != tb {
        return if ta > tb { 1 } else { -1 }
    }
    mut k := ta
    while k >= 0 {
        if a[k] != b[k] {
            return if a[k] > b[k] { 1 } else { -1 }
        }
        k -= 1
    }
    return 0
}

// a = a - b（a ≥ b）
func Sub(a mut []int, b mut []int) {
    mut borrow := 0
    for k <- iter.Range(0, len(a)) {
        x := a[k] - (if k < len(b) { b[k] } else { 0 }) - borrow
        if x < 0 {
            a[k] = x + Limb
            borrow = 1
        } else {
            a[k] = x
            borrow = 0
        }
    }
}

func bitLen(x0 int) int {
    mut x := x0
    mut n := 0
    while x > 0 {
        x = x >> 1
        n += 1
    }
    return n
}

// d = a × b（d は a・b と別の列 — 教科書の筆算。肢どうしの積は 2^60 未満・桁上げを足しても 2^61 未満）
func Mul(d mut []int, a mut []int, b mut []int) {
    d = mut []int{}
    for k <- iter.Range(0, len(a) + len(b)) {
        d = append(d, 0)
    }
    for i <- iter.Range(0, len(a)) {
        mut carry := 0
        ai := a[i]
        for j <- iter.Range(0, len(b)) {
            x := d[i + j] + ai * b[j] + carry
            d[i + j] = x % Limb
            carry = x / Limb
        }
        mut k := i + len(b)
        while carry > 0 {
            x := d[k] + carry
            d[k] = x % Limb
            carry = x / Limb
            k += 1
        }
    }
    if len(d) == 0 {
        d = append(d, 0)
    }
}
