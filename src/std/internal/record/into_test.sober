package record

// OpenInto（white-box）: 1.3 と 1.2 の各 suite で、record を 2 つ同じ列へ続けて開く（2 つ目は 1 つ目の中身の直後から）・
// 前に書いた中身と at より前は変わらない・列が短ければ伸ばす・at が列の外は internal_error

import "std/crypto/aesgcm"
import "std/internal/bless"
import "std/iter"

func TestOpenInto() {
    mut ds := mut []Dir{}
    suites := []int{AesGcm, ChaCha}
    for suite <- suites {
        if suite == AesGcm && !crypto.aesgcm.Available() {
            continue
        }
        d, _ := NewDir(suite, pat(32, suite & 0xff))
        ds = append(ds, d)
    }
    for kind <- kinds() {
        if kind != ChaCha12 && !crypto.aesgcm.Available() {
            continue
        }
        ds = append(ds, dir12(kind, 5))
    }
    for d0 <- freeze(ds) {
        lens := []int{0, 1, 17, 1000, 16384}
        for n1 <- lens {
            n2 := 300 + n1 % 7
            mut w := d0
            p1 := pat(n1, 11)
            p2 := pat(n2, 12)
            // 1.3 は 0 埋めつき（剥がしの道 — 中身が上限のときは 0 埋めなし）
            r1 := bless12(Seal(mut w, CtApp, p1, if n1 < MaxPlain { 3 } else { 0 }))
            r2 := bless12(Seal(mut w, CtApp, p2, 0))
            mut r := d0
            mut out := mut []byte{byte(0xcc), byte(0xcc)}
            ct1, m1, e1 := OpenInto(mut r, At(r1, 0, len(r1)), mut out, 2)
            assert(e1 == nil && ct1 == CtApp && m1 == n1)
            ct2, m2, e2 := OpenInto(mut r, At(r2, 0, len(r2)), mut out, 2 + m1)
            assert(e2 == nil && ct2 == CtApp && m2 == n2)
            assert(internal.bless.Int(Seq(r)) == 2)
            o := bless12(freeze(out))
            assert(o[0] == 0xcc && o[1] == 0xcc)
            assert(same12(o[2:2 + n1], p1))
            assert(same12(o[2 + n1:2 + n1 + n2], p2))
            // at が列の外
            mut r3 := d0
            mut short := mut []byte{}
            _, _, e3 := OpenInto(mut r3, At(r1, 0, len(r1)), mut short, 1)
            assert(e3 != nil)
        }
    }
}
