package hs

// hs: TLS 1.3 のサーバ側の handshake の状態機械と key schedule（RFC 9846 4 節 / 7 節 — 8446bis）。
// **std/tlsの内側** — 利用者はimportしない（公開のAPIはstd/tlsのServe / Conn — 隠し方は0.6.0のAPI総再審）。
//
// - 状態 = Phase（1 状態 1 variant — Start〔最初の ClientHello 待ち〕/ WaitCH2〔HelloRetryRequest を送った後〕/ WaitFin〔サーバの flight を送り終え
//   クライアントの Finished 待ち〕/ Connected / Closed）。Feed は record の枠 1 つを受けて、送るバイト列・受けた application の平文・閉じたかを返す
//   （転送路の受けのインターフェースは1本のinternal.record.Framesのループ — handshakeの直後に同じ切片に乗ってきた application data も同じループで受ける）
// - v1 の範囲: TLS 1.3 だけ・サーバだけ・X25519 だけ・TLS_AES_128_GCM_SHA256 / TLS_CHACHA20_POLY1305_SHA256・
//   署名は rsa_pss_rsae_sha256（証明書の鍵が RSA-2048）か ecdsa_secp256r1_sha256（P-256）・PSK / 0-RTTの受け入れ / クライアント証明書なし（0-RTTはHelloRetryRequestで断って読み飛ばす）。ALPN の不一致は no_application_protocol（RFC 7301）
// - 乱数の源はParams.seed（空 = crypto.Rand・空でなければSHA-256(seed ‖ 用途) — 検査の決定的なゴールデンのため）
// - 誤りは internal.record.Alert{desc}（相手へ送る alert の番号 — 呼び手は AlertRecord を送って閉じる）。相手の alert は Out.peer に

import "std/crypto"
import "std/crypto/hkdf"
import "std/crypto/hmac"
import "std/crypto/rsa"
import "std/crypto/sha256"
import "std/crypto/x25519"
import "std/hex"
import "std/internal/bless"
import "std/internal/p256"
import "std/iter"
import "std/internal/record"

// handshake のメッセージの型（RFC 9846 4）
const tClientHello = 1
const tServerHello = 2
const tEncryptedExtensions = 8
const tCertificate = 11
const tCertificateVerify = 15
const tFinished = 20
const tKeyUpdate = 24
const tMessageHash = 254

// 拡張の型（RFC 9846 4.2）
const xServerName = 0
const xSupportedGroups = 10
const xSignatureAlgorithms = 13
const xAlpn = 16
const xPreSharedKey = 41
const xEarlyData = 42
const xSupportedVersions = 43
const xCookie = 44
const xKeyShare = 51

// 広告しないチケットへの0-RTTを読み飛ばす帯域の上限（読み飛ばしたrecordの本体の合計。暗号文で数える）。平文16 KiBをrecordの増え分込みで吸収する
const earlySkipMax = 2 * internal.record.MaxCipher

const groupX25519 = 0x001d
const sigPssSha256 = 0x0804
const sigEcdsaSha256 = 0x0403

// alert の番号（RFC 9846 6）
const aCloseNotify = 0
const aUnexpected = 10
const aHandshakeFailure = 40
const aIllegalParameter = 47
const aDecodeError = 50
const aDecryptError = 51
const aProtocolVersion = 70
const aInternal = 80
const aMissingExtension = 109
const aNoAlpn = 120

// HelloRetryRequest の random（SHA-256("HelloRetryRequest") — RFC 9846 4.1.3 の値 cf21ad74…8339c）
func hrrRandom() []byte {
    return crypto.sha256.Sum256(bytes("HelloRetryRequest"))
}

// サーバの設定（std/tlsのConfigがここへコピーする）
type Params struct {
    chain [][]byte          // 証明書の列（DER — 葉が先頭）
    key crypto.rsa.PrivateKey      // 葉の鍵（RSA-2048 — ec が空のとき）
    ec []byte               // 葉の鍵が P-256 の ECDSA ならそのスカラー（32 バイト — 空 = RSA）
    alpn []string           // 受ける ALPN（サーバの好みの順 — 空 = ALPN を使わない）
    suites []int            // suite の好みの順（internal.record.AesGcm / internal.record.ChaCha）
    seed []byte             // 乱数の源（空 = crypto.Rand）
    allow12 bool            // TLS 1.2 の ClientHello を受ける（std/tls の DangerouslyAllowTls12 — server12.sober）
}

// Params（std/tlsのConfigから — 検査からも）
func NewParams(chain [][]byte, key crypto.rsa.PrivateKey, alpn []string, suites []int, seed []byte) Params {
    return Params{chain: chain, key: key, alpn: alpn, suites: suites, seed: seed, allow12: false, ec: []byte{}}
}

// 葉の鍵を P-256 の ECDSA のスカラー d に替えた Params（署名 = ecdsa_secp256r1_sha256・1.2 のスイートは ECDHE-ECDSA）
func WithEcdsa(p Params, d []byte) Params {
    return Params{chain: p.chain, key: p.key, alpn: p.alpn, suites: p.suites, seed: p.seed, allow12: p.allow12, ec: d}
}

func isEc(p Params) bool {
    return len(p.ec) > 0
}

// std/tls の Config からの Params（ec = 葉の鍵が P-256 の ECDSA ならそのスカラー・空 = key の RSA。allow12 = TLS 1.2 の ClientHello も受ける）
func ConfigParams(chain [][]byte, key crypto.rsa.PrivateKey, ec []byte, alpn []string, suites []int, allow12 bool) Params {
    return Params{chain: chain, key: key, alpn: alpn, suites: suites, seed: []byte{}, allow12: allow12, ec: ec}
}

// handshake の状態
type Phase union {
    Start {}
    WaitCH2 {}
    WaitFin {}
    WaitCke12 {}
    WaitCcs12 {}
    WaitFin12 {}
    Connected {}
    Closed {}
}

// 1 接続の handshake と record の状態
type Hs struct {
    ph Phase
    th crypto.sha256.State      // transcript
    suite int
    rd internal.record.Dir
    wr internal.record.Dir
    cHs []byte           // client / server handshake traffic secret
    sHs []byte
    cAp []byte           // client / server application traffic secret（0 番目の世代）
    sAp []byte
    expFin []byte        // 期待するクライアントの verify_data
    alpn string          // 決まった ALPN（無ければ ""）
    hbuf []byte          // 組み立て中の handshake のバイト列（record をまたぐメッセージ）
    ccs bool             // 互換の CCS を 1 枚受けた
    hrr bool             // HelloRetryRequest を送った
    early bool           // 最初の ClientHello に early_data があった（WaitCH2 で application_data の record を読み飛ばす — RFC 9846 4.3.10）
    skipped int          // 読み飛ばした record の本体の合計
    cookie []byte        // HelloRetryRequest に入れた cookie（2 番目の ClientHello が同じものを返す）
    keyed bool           // 送りの鍵がある（サーバの flight を封じた後 — alert を暗号化して送る）
    upd bool             // 相手が KeyUpdate で update_requested を送った（次の SealApp が先に自分の KeyUpdate を送る — RFC 9846 4.6.3）
    // TLS 1.2 の道（server12.sober）: v12 = 1.2 を選んだ・cver = ClientHello の client_version（RSA 鍵交換の版の照合）・crandom / srandom・
    // ems / etm = extended_master_secret / encrypt_then_mac を使う・group / priv = ECDHE の群と秘密の鍵・ms = master secret
    v12 bool
    cver int
    crandom []byte
    srandom []byte
    ems bool
    etm bool
    group int
    priv []byte
    ms []byte
}

// Feed の結果（send = 相手へ送る record の列・app = 受けた application の平文・done = この枠で handshake が済んだ・
// closed = 相手が close_notify か alert で閉じた〔peer = 受けた alert の番号 — 無ければ -1〕・upd = 相手が update_requested の KeyUpdate を送った
// 〔受けの鍵は進めた — 送りの返事は次の SealApp / tls.Send が先に送る〕）
type Out struct {
    send []byte
    app []byte
    done bool
    closed bool
    peer int
    upd bool
}

func none() Out {
    return Out{send: []byte{}, app: []byte{}, done: false, closed: false, peer: 0 - 1, upd: false}
}

// 最初の ClientHello を待つ Hs
func New() Hs {
    return Hs{ph: Start{}, th: crypto.sha256.New(), suite: 0, rd: emptyDir(), wr: emptyDir(), cHs: []byte{}, sHs: []byte{}, cAp: []byte{}, sAp: []byte{},
        expFin: []byte{}, alpn: "", hbuf: []byte{}, ccs: false, hrr: false, early: false, skipped: 0, cookie: []byte{}, keyed: false, upd: false,
        v12: false, cver: 0, crandom: []byte{}, srandom: []byte{}, ems: false, etm: false, group: 0, priv: []byte{}, ms: []byte{}}
}

// handshakeの済んだ接続の受けの方向rdだけを持つConnectedのHs（std/tlsのRecvが格納場所のrdから作る — Connectedの受けの表を
// Feedの1か所に置くため。送りの方向は持たない — 送りはstd/tlsの格納場所が持つ）
func Resume(rd internal.record.Dir) Hs {
    mut h := New()
    h.rd = rd
    h.ph = Connected{}
    return h
}

// Resumeに、前の受けで組み立て中だったhandshakeのバイト列hbufを戻したもの（std/tlsのnet.Connの受け — 受けの切片ごとに格納場所から作り直す）
func ResumeWith(rd internal.record.Dir, hbuf []byte) Hs {
    mut h := Resume(rd)
    h.hbuf = hbuf
    return h
}

// 受けの方向と、組み立て中のhandshakeのバイト列（ResumeWithの逆）
func RecvState(h Hs) (internal.record.Dir, []byte) {
    return h.rd, h.hbuf
}

// Connected の Feed に渡す空の Params（Connected の受けは Params を見ない）
func Bare() Params {
    k, _ := crypto.rsa.ParsePKCS8([]byte{})
    return NewParams([][]byte{}, k, []string{}, []int{}, []byte{})
}

func emptyDir() internal.record.Dir {
    d, _ := internal.record.NewDir(0, []byte{})
    return d
}

// Connected は handshake が済んだか
func IsConnected(h Hs) bool {
    return switch h.ph {
        case Connected{}: true
        default: false
    }
}

// サーバのflightを封じた後か（送りの鍵がある。非対称の計算は済んでいる）
func Keyed(h Hs) bool {
    return h.keyed
}

// 抽象の状態の名前（"start/c0/h0" の形 — フェーズ・互換のCCSを受けたか・HelloRetryRequestを送ったか。Closedは "closed"）。
// 検査std/tlsのTestFsm（hs_fsm_test.sober）がLeanの遷移表（lean/FeatherweightSober/Tls.lean）と突き合わせるインターフェース
func Probe(h Hs) string {
    n := switch h.ph {
        case Start{}: "start"
        case WaitCH2{}: "waitCH2"
        case WaitFin{}: "waitFin"
        case WaitCke12{}: "waitCke12"
        case WaitCcs12{}: "waitCcs12"
        case WaitFin12{}: "waitFin12"
        case Connected{}: "connected"
        case Closed{}: ""
    }
    if n == "" {
        return "closed"
    }
    return "${n}/c${if h.ccs { 1 } else { 0 }}/h${if h.hrr { 1 } else { 0 }}"
}

// 決まった ALPN（無ければ ""）
func Alpn(h Hs) string {
    return h.alpn
}

// 決まった suite
func Suite(h Hs) int {
    return h.suite
}

// 受けと送りの方向（handshakeが済んだ後にstd/tlsのConnの格納場所へコピーする）
func Dirs(h Hs) (internal.record.Dir, internal.record.Dir) {
    return h.rd, h.wr
}

// 4つのtraffic secret（client hs ‖ server hs ‖ client ap ‖ server ap の16進 — 検査がGoのKeyLogWriterと照合するインターフェース）。
// key log は鍵を故意に開示するインターフェース: ここで祝福してから16進にする（hex.Formatの表引きの時間は開示した値にだけ掛かる）
func Secrets(h Hs) string {
    return "${hex.Format(internal.bless.Bytes(h.cHs))} ${hex.Format(internal.bless.Bytes(h.sHs))} ${hex.Format(internal.bless.Bytes(h.cAp))} ${hex.Format(internal.bless.Bytes(h.sAp))}"
}

// ── 受け ──

// record の枠 f を 1 つ受ける（誤りのときは自分で Closed に落ちる — 以降の枠は全部 unexpected_message）
@errors(internal.record.Alert)
func Feed(h mut Hs, p Params, f internal.record.Frame) (Out, error?) {
    o, e := feedIn(mut h, p, f)
    if e != nil {
        h.ph = Closed{}
    }
    return o, e
}

// Connectedの受けの入口（mutの仮引数を持たない — std/tlsのRecvの展開点ごとにhandshakeのパスごとinlineさせないため。
// 表は Feed の暗号化した record の枝〔feedSealed〕そのもの — Connected / Closed の h に対して Feed と同じ結果。誤りで Closed に落ちるのも同じ）
@errors(internal.record.Alert)
func Step(h Hs, f internal.record.Frame) (Hs, Out, error?) {
    mut x := h
    if !IsConnected(x) {
        x.ph = Closed{}
        return x, none(), alert(aUnexpected)
    }
    o, e := feedSealed(mut x, f, int(f.b[f.off]))
    if e != nil {
        x.ph = Closed{}
    }
    return x, o, e
}

@errors(internal.record.Alert)
func feedIn(h mut Hs, p Params, f internal.record.Frame) (Out, error?) {
    ct := int(f.b[f.off])
    k := switch h.ph {
        case Start{}: 0
        case WaitCH2{}: 0
        case WaitFin{}: 1
        case WaitCke12{}: 3
        case WaitCcs12{}: 3
        case WaitFin12{}: 1
        case Connected{}: 1
        case Closed{}: 2
    }
    if k == 0 {
        return feedPlain(mut h, p, f, ct)
    }
    if k == 3 {
        return feedPlain12(mut h, p, f, ct)
    }
    if k == 1 {
        return feedSealed(mut h, f, ct)
    }
    return none(), alert(aUnexpected)
}

func alert(d int) error? {
    return internal.record.Alert{desc: d}
}

// 暗号化前の record（最初の ClientHello・HRR の後の互換の CCS と 2 番目の ClientHello）
@errors(internal.record.Alert)
func feedPlain(h mut Hs, p Params, f internal.record.Frame, ct int) (Out, error?) {
    _, body := internal.record.Plain(f)
    // early_dataを断ったHelloRetryRequestの後は、外側の型がapplication_dataのrecord（0-RTTのデータ）を復号せずに上限まで捨てる（RFC 9846 4.3.10・4.7.1）
    if ct == internal.record.CtApp && h.early {
        h.skipped += len(body)
        if h.skipped > earlySkipMax {
            return none(), alert(aUnexpected)
        }
        return none(), nil
    }
    // 暗号化していないrecordの本体の上限は2^14（RFC 9846 5.1）
    if len(body) > internal.record.MaxPlain {
        return none(), alert(internal.record.AlertOverflow)
    }
    if ct == internal.record.CtCcs {
        return ccsOnce(mut h, body)
    }
    if ct != internal.record.CtHandshake || len(body) == 0 {
        return none(), alert(aUnexpected)
    }
    h.hbuf = cat(h.hbuf, body)
    if len(h.hbuf) < 4 {
        return none(), nil
    }
    n := int(h.hbuf[1]) << 16 | int(h.hbuf[2]) << 8 | int(h.hbuf[3])
    if int(h.hbuf[0]) != tClientHello {
        return none(), alert(aUnexpected)
    }
    if len(h.hbuf) < 4 + n {
        return none(), nil
    }
    // ClientHello の後ろに続く handshake のバイトは無い約束（鍵の境目をまたがない — RFC 9846 5.1）
    if len(h.hbuf) != 4 + n {
        return none(), alert(aUnexpected)
    }
    m := h.hbuf
    h.hbuf = []byte{}
    return onClientHello(mut h, p, m)
}

// 互換の CCS（中身 0x01 の 1 枚だけ読み飛ばす — RFC 9846 5 / D.4）
@errors(internal.record.Alert)
func ccsOnce(h mut Hs, body []byte) (Out, error?) {
    if h.ccs || len(body) != 1 || body[0] != 1 {
        return none(), alert(aUnexpected)
    }
    h.ccs = true
    return none(), nil
}

// 暗号化した record（クライアントの Finished・application data・KeyUpdate・alert）
@errors(internal.record.Alert)
func feedSealed(h mut Hs, f internal.record.Frame, ct int) (Out, error?) {
    if ct == internal.record.CtCcs {
        // 1.2 の CCS は WaitCcs12 の 1 枚だけ（Finished の待ち・接続の後の CCS は unexpected_message）
        if IsConnected(h) || h.v12 {
            return none(), alert(aUnexpected)
        }
        _, body := internal.record.Plain(f)
        return ccsOnce(mut h, body)
    }
    ict, pt := internal.record.Open(mut h.rd, f)?
    if ict == internal.record.CtAlert {
        return peerAlert(mut h, pt)
    }
    if ict == internal.record.CtApp {
        if !IsConnected(h) || len(h.hbuf) > 0 {
            return none(), alert(aUnexpected)
        }
        return Out{send: []byte{}, app: pt, done: false, closed: false, peer: 0 - 1, upd: false}, nil
    }
    if ict != internal.record.CtHandshake || len(pt) == 0 {
        return none(), alert(aUnexpected)
    }
    h.hbuf = cat(h.hbuf, pt)
    mut out := none()
    while len(h.hbuf) >= 4 {
        n := int(h.hbuf[1]) << 16 | int(h.hbuf[2]) << 8 | int(h.hbuf[3])
        if len(h.hbuf) < 4 + n {
            return out, nil
        }
        m := sliceOf(h.hbuf, 0, 4 + n)
        h.hbuf = sliceOf(h.hbuf, 4 + n, len(h.hbuf) - 4 - n)
        o := onSealedMsg(mut h, m)?
        out = Out{send: cat(out.send, o.send), app: out.app, done: out.done || o.done, closed: false, peer: 0 - 1, upd: out.upd || o.upd}
    }
    return out, nil
}

// 暗号化した handshake のメッセージ 1 つ（WaitFin = Finished・Connected = KeyUpdate）
@errors(internal.record.Alert)
func onSealedMsg(h mut Hs, m []byte) (Out, error?) {
    t := int(m[0])
    connected := IsConnected(h)
    v12 := internal.record.Is12(h.rd)
    if !connected && h.v12 {
        if t != tFinished {
            return none(), alert(aUnexpected)
        }
        return onFinished12(mut h, m)
    }
    // 1.2 の接続の後の ClientHello（再交渉）は断る（RFC 5746 は持たない再交渉を no_renegotiation で知らせてよいとする — 閉じる）
    if connected && v12 {
        return none(), alert(if t == tClientHello { aNoRenegotiation } else { aUnexpected })
    }
    if !connected && t == tFinished {
        // verify_dataの長さはhashの長さ。違えば構文の誤りでdecode_error、中身の不一致はdecrypt_error（RFC 9846 4.5.3・6）
        if len(m) != 4 + 32 {
            return none(), alert(aDecodeError)
        }
        if !crypto.Equal(sliceOf(m, 4, 32), h.expFin) {
            return none(), alert(aDecryptError)
        }
        // 鍵の境目: Finished の後ろに handshake のバイトが残っていてはならない
        if len(h.hbuf) > 0 {
            return none(), alert(aUnexpected)
        }
        h.rd = internal.record.NewDir(h.suite, h.cAp)?
        h.ph = Connected{}
        return Out{send: []byte{}, app: []byte{}, done: true, closed: false, peer: 0 - 1, upd: false}, nil
    }
    if connected && t == tKeyUpdate {
        if len(m) != 5 || int(m[4]) > 1 {
            return none(), alert(if len(m) != 5 { aDecodeError } else { aIllegalParameter })
        }
        if len(h.hbuf) > 0 {
            return none(), alert(aUnexpected)
        }
        internal.record.Update(mut h.rd)?
        // update_requested: 自分の KeyUpdate（update_not_requested）は次の application data の前に送る（RFC 9846 4.6.3 — 送りは SealApp / tls.Send の 1 か所）
        req := int(m[4]) == 1
        h.upd = h.upd || req
        return Out{send: []byte{}, app: []byte{}, done: false, closed: false, peer: 0 - 1, upd: req}, nil
    }
    return none(), alert(aUnexpected)
}

// 相手の alert（close_notify なら静かに閉じる・他は相手の誤り — 送り返さずに閉じる）
@errors(internal.record.Alert)
func peerAlert(h mut Hs, pt []byte) (Out, error?) {
    // 中身が空のalertのrecordはunexpected_message（RFC 9846 5.4）
    if len(pt) == 0 {
        return none(), alert(aUnexpected)
    }
    if len(pt) != 2 {
        return none(), alert(aDecodeError)
    }
    h.ph = Closed{}
    return Out{send: []byte{}, app: []byte{}, done: false, closed: true, peer: int(pt[1]), upd: false}, nil
}

// ── ClientHello ──

// ClientHello の読んだ形
type hello struct {
    legacy int
    sessid []byte
    suites []int
    compOk bool
    v13 bool
    groupX bool
    share []byte
    hasShare bool
    sigPss bool
    alpn []string
    hasAlpn bool
    hasGroups bool
    hasSigs bool
    hasPsk bool
    hasEarly bool
    cookie []byte
    // 1.2 の道が読む欄（server12.sober）
    random []byte
    compNull bool
    groupP bool
    sigList []int
    hasEms bool
    hasEtm bool
    hasReneg bool
    renegEmpty bool
    hasPointFmt bool
    pointUnc bool
    bad12 bool
}

// ClientHello の本体（型と長さの 4 バイトの後ろ）を読む（読めなければ decode_error・同じ拡張が 2 つなら illegal_parameter）。
// 読む拡張は、本体が構文どおりに尽きることと、リストが下限の長さを満たすことまで見る（空のリストと空の要素は構文の外。RFC 9846 6のdecode_error）
@errors(internal.record.Alert)
func parseHello(m []byte) (hello, error?) {
    mut c := cur(4, len(m))
    legacy := u16(m, mut c)
    random := take(m, mut c, 32)
    sessid := take(m, mut c, u8(m, mut c))
    mut cs := sub(mut c, u16(m, mut c))
    mut suites := mut []int{}
    while rest(cs) >= 2 {
        suites = append(suites, u16(m, mut cs))
    }
    mut cm := sub(mut c, u8(m, mut c))
    // 圧縮の方法の列（1.3 は null の 1 つだけ・1.2 は null を含めばよい）
    mut compNull := false
    mut ncomp := 0
    while rest(cm) > 0 && !cm.bad {
        if u8(m, mut cm) == 0 {
            compNull = true
        }
        ncomp += 1
    }
    compOk := ncomp == 1 && compNull
    mut xs := if rest(c) > 0 { sub(mut c, u16(m, mut c)) } else { sub(mut c, 0) }
    mut seen := mut []int{}
    mut v13 := false
    mut groupX := false
    mut share := []byte{}
    mut hasShare := false
    mut sigPss := false
    mut alpn := mut []string{}
    mut hasAlpn := false
    mut dup := false
    mut hasGroups := false
    mut hasSigs := false
    mut hasPsk := false
    mut hasEarly := false
    mut cookie := []byte{}
    mut xbad := false
    mut groupP := false
    mut sigList := mut []int{}
    mut hasEms := false
    mut hasEtm := false
    mut hasReneg := false
    mut renegEmpty := false
    mut hasPointFmt := false
    mut pointUnc := false
    // 1.2 の道だけが読む拡張の形の誤り（1.3 の ClientHello では知らない拡張と同じく読み飛ばす — onClientHello12 が decode_error にする）
    mut bad12 := false
    while rest(xs) >= 4 {
        t := u16(m, mut xs)
        mut x := sub(mut xs, u16(m, mut xs))
        for s <- seen {
            if s == t {
                dup = true
            }
        }
        seen = append(seen, t)
        if t == xPreSharedKey {
            hasPsk = true
        }
        if t == xEarlyData {
            // ClientHelloのearly_dataの中身は空（RFC 9846 4.2.10）
            hasEarly = true
            xbad = xbad || rest(x) != 0
        }
        if t == xCookie {
            mut l := sub(mut x, u16(m, mut x))
            xbad = xbad || rest(l) < 1
            cookie = take(m, mut l, rest(l))
            xbad = xbad || l.bad || x.bad || rest(x) != 0
        }
        if t == xSupportedVersions {
            mut l := sub(mut x, u8(m, mut x))
            xbad = xbad || rest(l) < 2
            while rest(l) >= 2 {
                if u16(m, mut l) == 0x0304 {
                    v13 = true
                }
            }
            xbad = xbad || l.bad || rest(l) != 0 || x.bad || rest(x) != 0
        } else if t == xSupportedGroups {
            hasGroups = true
            mut l := sub(mut x, u16(m, mut x))
            xbad = xbad || rest(l) < 2
            while rest(l) >= 2 {
                g := u16(m, mut l)
                if g == groupX25519 {
                    groupX = true
                }
                if g == groupP256 {
                    groupP = true
                }
            }
            xbad = xbad || l.bad || rest(l) != 0 || x.bad || rest(x) != 0
        } else if t == xKeyShare {
            hasShare = true
            mut l := sub(mut x, u16(m, mut x))
            while rest(l) > 0 && !l.bad {
                g := u16(m, mut l)
                kn := u16(m, mut l)
                xbad = xbad || kn == 0
                k := take(m, mut l, kn)
                if g == groupX25519 && len(share) == 0 {
                    share = k
                }
            }
            xbad = xbad || l.bad || x.bad || rest(x) != 0
        } else if t == xSignatureAlgorithms {
            hasSigs = true
            mut l := sub(mut x, u16(m, mut x))
            xbad = xbad || rest(l) < 2
            while rest(l) >= 2 {
                sa := u16(m, mut l)
                sigList = append(sigList, sa)
                if sa == sigPssSha256 {
                    sigPss = true
                }
            }
            xbad = xbad || l.bad || rest(l) != 0 || x.bad || rest(x) != 0
        } else if t == xEms || t == xEtm {
            // 中身は空（RFC 7627 5.1・RFC 7366 2）
            hasEms = hasEms || t == xEms
            hasEtm = hasEtm || t == xEtm
            bad12 = bad12 || rest(x) != 0
        } else if t == xReneg {
            hasReneg = true
            rn := u8(m, mut x)
            _ = take(m, mut x, rn)
            renegEmpty = rn == 0
            bad12 = bad12 || x.bad || rest(x) != 0
        } else if t == xEcPointFormats {
            hasPointFmt = true
            mut l := sub(mut x, u8(m, mut x))
            bad12 = bad12 || rest(l) < 1
            while rest(l) > 0 && !l.bad {
                if u8(m, mut l) == 0 {
                    pointUnc = true
                }
            }
            bad12 = bad12 || l.bad || x.bad || rest(x) != 0
        } else if t == xServerName {
            // 構文だけを見る。値は使わない（証明書は1つ）。同じname_typeは2つまで書けない（RFC 6066 3）
            mut l := sub(mut x, u16(m, mut x))
            xbad = xbad || rest(l) < 3
            mut types := mut []int{}
            while rest(l) > 0 && !l.bad {
                nt := u8(m, mut l)
                hn := u16(m, mut l)
                xbad = xbad || hn == 0
                _ = take(m, mut l, hn)
                for y <- types {
                    if y == nt {
                        dup = true
                    }
                }
                types = append(types, nt)
            }
            xbad = xbad || l.bad || x.bad || rest(x) != 0
        } else if t == xAlpn {
            hasAlpn = true
            mut l := sub(mut x, u16(m, mut x))
            xbad = xbad || rest(l) < 2
            while rest(l) > 0 && !l.bad {
                bn := u8(m, mut l)
                xbad = xbad || bn == 0
                b := take(m, mut l, bn)
                s, e := string(b)
                if e == nil {
                    alpn = append(alpn, s)
                }
            }
            xbad = xbad || l.bad || x.bad || rest(x) != 0
        }
    }
    if c.bad || cs.bad || cm.bad || xs.bad || rest(xs) != 0 || rest(c) != 0 || xbad {
        return emptyHello(), alert(aDecodeError)
    }
    if dup {
        return emptyHello(), alert(aIllegalParameter)
    }
    return hello{legacy: legacy, sessid: sessid, suites: freeze(suites), compOk: compOk, v13: v13, groupX: groupX, share: share, hasShare: hasShare, sigPss: sigPss,
        alpn: freeze(alpn), hasAlpn: hasAlpn, hasGroups: hasGroups, hasSigs: hasSigs, hasPsk: hasPsk, hasEarly: hasEarly, cookie: cookie,
        random: random, compNull: compNull, groupP: groupP, sigList: freeze(sigList), hasEms: hasEms, hasEtm: hasEtm, hasReneg: hasReneg, renegEmpty: renegEmpty,
        hasPointFmt: hasPointFmt, pointUnc: pointUnc, bad12: bad12}, nil
}

func emptyHello() hello {
    return hello{legacy: 0, sessid: []byte{}, suites: []int{}, compOk: false, v13: false, groupX: false, share: []byte{}, hasShare: false, sigPss: false, alpn: []string{},
        hasAlpn: false, hasGroups: false, hasSigs: false, hasPsk: false, hasEarly: false, cookie: []byte{},
        random: []byte{}, compNull: false, groupP: false, sigList: []int{}, hasEms: false, hasEtm: false, hasReneg: false, renegEmpty: false, hasPointFmt: false, pointUnc: false, bad12: false}
}

// ClientHello m（型と長さの頭込み）を受けて、サーバの flight（または HelloRetryRequest）を返す
@errors(internal.record.Alert)
func onClientHello(h mut Hs, p Params, m []byte) (Out, error?) {
    ch := parseHello(m)?
    // 1.3 を申し出ない相手は、allow12 なら 1.2 の道（server12.sober）
    if !ch.v13 && p.allow12 {
        return onClientHello12(mut h, p, ch, m)
    }
    // legacy_versionは0x0303だけ（RFC 9846 4.2.2）
    if ch.legacy != 0x0303 || !ch.v13 {
        return none(), alert(aProtocolVersion)
    }
    // TLS 1.3のClientHelloの必須の拡張。PSKが無ければsignature_algorithmsとsupported_groupsが要り、supported_groupsとkey_shareは対で現れる（RFC 9846 9.2）
    if (!ch.hasPsk && (!ch.hasSigs || !ch.hasGroups)) || ch.hasGroups != ch.hasShare {
        return none(), alert(aMissingExtension)
    }
    if !ch.compOk {
        return none(), alert(aIllegalParameter)
    }
    suite := pickSuite(p.suites, ch.suites)
    sigOk := if isEc(p) { hasInt(ch.sigList, sigEcdsaSha256) } else { ch.sigPss }
    if suite == 0 || !sigOk || !ch.groupX {
        return none(), alert(aHandshakeFailure)
    }
    alpn := pickAlpn(p.alpn, ch.alpn)
    if ch.hasAlpn && len(p.alpn) > 0 && alpn == "" {
        return none(), alert(aNoAlpn)
    }
    if h.hrr {
        // 2 番目の ClientHello: X25519 の key_share が要る・最初に選んだ suite がまだ入っている・送った cookie を返す・early_data は無い（RFC 9846 4.1.2 / 4.1.4 / 4.2.2 / 4.2.10）
        if len(ch.share) == 0 || suite != h.suite || !crypto.Equal(ch.cookie, h.cookie) || ch.hasEarly {
            return none(), alert(aIllegalParameter)
        }
    } else if len(ch.share) == 0 || ch.hasEarly {
        // X25519 の key_share が無い（supported_groups にはある）か、0-RTT を断る: HelloRetryRequest を 1 回だけ
        return helloRetry(mut h, p, ch, suite, m)
    }
    if len(ch.share) != 32 {
        return none(), alert(aIllegalParameter)
    }
    crypto.sha256.Write(mut h.th, m)
    h.suite = suite
    h.alpn = alpn
    priv := rnd(p, "x25519", 32)
    shared := crypto.x25519.Shared(priv, ch.share)
    // 全 0 の共有値（低位数の点 — RFC 7748 6.1）は拒否。比べは crypto.Equal（全バイトを畳んで最後に 1 回だけ判定 — 漏れるのは「全 0 か」の 1 ビット）
    if crypto.Equal(shared, zeros(32)) {
        return none(), alert(aIllegalParameter)
    }
    // ServerHello（平文）
    sh := serverHello(rnd(p, "random", 32), ch.sessid, suite, crypto.x25519.Base(priv))
    crypto.sha256.Write(mut h.th, sh)
    zero := zeros(32)
    early := crypto.hkdf.Extract([]byte{}, zero)
    hsS := crypto.hkdf.Extract(deriveSecret(early, "derived", crypto.sha256.Sum256([]byte{})), shared)
    t1 := crypto.sha256.Sum(h.th)
    h.cHs = deriveSecret(hsS, "c hs traffic", t1)
    h.sHs = deriveSecret(hsS, "s hs traffic", t1)
    h.wr = internal.record.NewDir(suite, h.sHs)?
    h.keyed = true
    h.rd = internal.record.NewDir(suite, h.cHs)?
    // EncryptedExtensions・Certificate・CertificateVerify・Finished（暗号化 — 1 回の Seal）
    ee := encryptedExtensions(alpn)
    crypto.sha256.Write(mut h.th, ee)
    cert := certificate(p.chain)
    crypto.sha256.Write(mut h.th, cert)
    cv := certificateVerify(p, crypto.sha256.Sum(h.th))?
    crypto.sha256.Write(mut h.th, cv)
    fin := msg(tFinished, crypto.hmac.Sum256(internal.record.ExpandLabel(h.sHs, "finished", []byte{}, 32), crypto.sha256.Sum(h.th)))
    crypto.sha256.Write(mut h.th, fin)
    t2 := crypto.sha256.Sum(h.th)
    ms := crypto.hkdf.Extract(deriveSecret(hsS, "derived", crypto.sha256.Sum256([]byte{})), zero)
    h.cAp = deriveSecret(ms, "c ap traffic", t2)
    h.sAp = deriveSecret(ms, "s ap traffic", t2)
    h.expFin = crypto.hmac.Sum256(internal.record.ExpandLabel(h.cHs, "finished", []byte{}, 32), t2)
    mut send := mut []byte{}
    putBytes(mut send, plain(internal.record.CtHandshake, sh))
    if len(ch.sessid) > 0 && !h.hrr {
        putBytes(mut send, plain(internal.record.CtCcs, []byte{1}))
    }
    flight := cat(cat(ee, cert), cat(cv, fin))
    putBytes(mut send, internal.record.Seal(mut h.wr, internal.record.CtHandshake, flight, 0))
    h.wr = internal.record.NewDir(suite, h.sAp)?
    h.ph = WaitFin{}
    return Out{send: freeze(send), app: []byte{}, done: false, closed: false, peer: 0 - 1, upd: false}, nil
}

// HelloRetryRequest（transcript の先頭を message_hash(ClientHello1) に置き換え — RFC 9846 4.4.1）
@errors(internal.record.Alert)
// early_dataがあれば、0-RTTを断ってcookieを入れる（key_shareを送り済みのクライアントには、key_shareを求めないHelloRetryRequestになるので、cookieが2番目のClientHelloの変化になる）
func helloRetry(h mut Hs, p Params, ch hello, suite int, m []byte) (Out, error?) {
    h.hrr = true
    h.suite = suite
    h.early = ch.hasEarly
    if ch.hasEarly {
        h.cookie = rnd(p, "cookie", 32)
    }
    mh := msg(tMessageHash, crypto.sha256.Sum256(m))
    crypto.sha256.Write(mut h.th, mh)
    hr := hrrRandom()
    mut x := mut []byte{}
    put16(mut x, xSupportedVersions)
    put16(mut x, 2)
    put16(mut x, 0x0304)
    // 送られた群をkey_shareで求めるHelloRetryRequestはクライアントが拒否する（RFC 9846 4.2.8）
    if len(ch.share) == 0 {
        put16(mut x, xKeyShare)
        put16(mut x, 2)
        put16(mut x, groupX25519)
    }
    if len(h.cookie) > 0 {
        put16(mut x, xCookie)
        put16(mut x, 2 + len(h.cookie))
        put16(mut x, len(h.cookie))
        putBytes(mut x, h.cookie)
    }
    hrr := helloBody(hr, ch.sessid, suite, freeze(x))
    crypto.sha256.Write(mut h.th, hrr)
    mut send := mut []byte{}
    putBytes(mut send, plain(internal.record.CtHandshake, hrr))
    if len(ch.sessid) > 0 {
        putBytes(mut send, plain(internal.record.CtCcs, []byte{1}))
    }
    h.ph = WaitCH2{}
    return Out{send: freeze(send), app: []byte{}, done: false, closed: false, peer: 0 - 1, upd: false}, nil
}

// サーバの好みの順で、クライアントも出した最初の suite（無ければ 0）
func pickSuite(ours []int, theirs []int) int {
    for s <- ours {
        for t <- theirs {
            if s == t {
                return s
            }
        }
    }
    return 0
}

// サーバの好みの順で、クライアントも出した最初の ALPN（無ければ ""）
func pickAlpn(ours []string, theirs []string) string {
    for s <- ours {
        for t <- theirs {
            if s == t {
                return s
            }
        }
    }
    return ""
}

// ── サーバの flight ──

func serverHello(random []byte, sessid []byte, suite int, pub []byte) []byte {
    mut x := mut []byte{}
    put16(mut x, xSupportedVersions)
    put16(mut x, 2)
    put16(mut x, 0x0304)
    put16(mut x, xKeyShare)
    put16(mut x, 4 + len(pub))
    put16(mut x, groupX25519)
    put16(mut x, len(pub))
    putBytes(mut x, pub)
    return helloBody(random, sessid, suite, freeze(x))
}

// ServerHello / HelloRetryRequest（legacy_version 0x0303・random・session_idのコピー・suite・圧縮0・拡張）
func helloBody(random []byte, sessid []byte, suite int, exts []byte) []byte {
    mut b := mut []byte{}
    put16(mut b, 0x0303)
    putBytes(mut b, random)
    put8(mut b, len(sessid))
    putBytes(mut b, sessid)
    put16(mut b, suite)
    put8(mut b, 0)
    put16(mut b, len(exts))
    putBytes(mut b, exts)
    return msg(tServerHello, freeze(b))
}

func encryptedExtensions(alpn string) []byte {
    mut x := mut []byte{}
    if alpn != "" {
        ab := bytes(alpn)
        put16(mut x, xAlpn)
        put16(mut x, 3 + len(ab))
        put16(mut x, 1 + len(ab))
        put8(mut x, len(ab))
        putBytes(mut x, ab)
    }
    mut b := mut []byte{}
    put16(mut b, len(x))
    putBytes(mut b, freeze(x))
    return msg(tEncryptedExtensions, freeze(b))
}

func certificate(chain [][]byte) []byte {
    mut l := mut []byte{}
    for c <- chain {
        put24(mut l, len(c))
        putBytes(mut l, c)
        put16(mut l, 0)
    }
    mut b := mut []byte{}
    put8(mut b, 0)
    put24(mut b, len(l))
    putBytes(mut b, freeze(l))
    return msg(tCertificate, freeze(b))
}

// 署名（64 × 0x20 ‖ "TLS 1.3, server CertificateVerify" ‖ 0 ‖ transcript の hash — RFC 9846 4.4.3）: RSA の鍵は rsa_pss_rsae_sha256（salt 32 バイト）・
// ECDSA の鍵は ecdsa_secp256r1_sha256（DER の Ecdsa-Sig-Value）
@errors(internal.record.Alert)
func certificateVerify(p Params, th []byte) ([]byte, error?) {
    mut c := mut []byte{}
    for i <- iter.Range(0, 64) {
        c = append(c, byte(0x20))
    }
    putBytes(mut c, bytes("TLS 1.3, server CertificateVerify"))
    put8(mut c, 0)
    putBytes(mut c, th)
    mut sig := []byte{}
    if isEc(p) {
        sig = internal.p256.Sign(p.ec, crypto.sha256.Sum256(freeze(c)))
        if len(sig) == 0 {
            return []byte{}, alert(aInternal)
        }
    } else {
        sig = crypto.rsa.SignPSS(p.key, freeze(c), rnd(p, "salt", 32)) catch return []byte{}, alert(aInternal)
    }
    mut b := mut []byte{}
    put16(mut b, if isEc(p) { sigEcdsaSha256 } else { sigPssSha256 })
    put16(mut b, len(sig))
    putBytes(mut b, sig)
    return msg(tCertificateVerify, freeze(b)), nil
}

// Derive-Secret(secret, label, transcript の hash)（RFC 9846 7.1）
func deriveSecret(secret []byte, label string, th []byte) []byte {
    return internal.record.ExpandLabel(secret, label, th, 32)
}

// 暗号化しない record（頭 = 型 / 0x0303 / 長さ — 2^14 ずつ割る）
func plain(ct int, body []byte) []byte {
    mut o := mut []byte{}
    mut at := 0
    while at < len(body) || at == 0 {
        n := if len(body) - at < internal.record.MaxPlain { len(body) - at } else { internal.record.MaxPlain }
        put8(mut o, ct)
        put16(mut o, 0x0303)
        put16(mut o, n)
        for i <- iter.Range(at, at + n) {
            o = append(o, body[i])
        }
        at += n
        if len(body) == 0 {
            at = 1
        }
    }
    return freeze(o)
}

func zeros(n int) []byte {
    mut z := mut []byte{}
    for i <- iter.Range(0, n) {
        z = append(z, byte(0))
    }
    return freeze(z)
}

// 用途labelのnバイトの乱数（seedが空ならcrypto.Rand・空でなければSHA-256(seed ‖ label) の先頭 — 検査の決定的なゴールデン）
func rnd(p Params, label string, n int) []byte {
    if len(p.seed) == 0 {
        return crypto.Rand(n)
    }
    return sliceOf(crypto.sha256.Sum256(cat(p.seed, bytes(label))), 0, n)
}

// ── 送り ──

// application の平文 pt の record の列（AES-GCM の鍵の使用上限の手前なら KeyUpdate を先に送って鍵を進める）
@errors(internal.record.Alert)
func SealApp(h mut Hs, pt []byte) ([]byte, error?) { // 対の OpenApp は実需まで足さない（34 節 2 の注記）
    if !IsConnected(h) {
        return []byte{}, alert(aInternal)
    }
    mut pre := []byte{}
    if h.upd || internal.record.NeedUpdate(h.wr) {
        pre = internal.record.Seal(mut h.wr, internal.record.CtHandshake, msg(tKeyUpdate, []byte{0}), 0)
        internal.record.Update(mut h.wr)?
        h.upd = false
    }
    return cat(pre, internal.record.Seal(mut h.wr, internal.record.CtApp, pt, 0)), nil
}

// alert desc の record（送りの鍵があれば暗号化・無ければ平文。close_notify は warning〔1〕・他は fatal〔2〕）。送った後は閉じる
// （鍵の有無は keyed で見る — Feed が誤りで Closed に落ちた後も、鍵の前の誤りは平文で返す）
func AlertRecord(h mut Hs, desc int) []byte {
    body := []byte{byte(if desc == aCloseNotify { 1 } else { 2 }), byte(desc)}
    h.ph = Closed{}
    if h.keyed {
        return internal.record.Seal(mut h.wr, internal.record.CtAlert, body, 0)
    }
    return plain(internal.record.CtAlert, body)
}

// close_notify の record
func CloseNotify(h mut Hs) []byte {
    return AlertRecord(mut h, aCloseNotify)
}
