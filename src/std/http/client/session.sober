package client

// keep-aliveのまとめ: Openが1つのoriginへの接続を1本張り（httpsなら握手まで）、その接続のSessionをkに渡し、kが返ったら閉じる。
// kの中のSendは同じ接続の上でリクエストとレスポンスを1往復ずつ進める。接続の状態（TLSの鍵と番号・受けて配っていないバイト・死んだマーク）は
// Sessionの値の外の格納場所（接続の寿命のintの列 — std/tlsのConnと同じleaseのAPI）に住む: 値に置くと値のコピーが鍵と番号を複製し、
// 二つのコピーが同じ番号で別の平文を封じる（AES-GCM / ChaCha20-Poly1305のnonceの再利用）。Sessionは同一性の型で、コピー・持ち出し・
// フィールド・捕獲を構文で拒否する
//
//     http.client.Open("https://api.example", (s) => {
//         a := http.client.Send(s, "/v1/a") catch …
//         b := http.client.Send(s, "/v1/b") catch …
//     })?

import "std/http"
import "std/internal/hsc"
import "std/io"
import "std/iter"
import "std/net"
import "std/task"
import "std/time"
import "std/internal/record"

// 1つのoriginへのkeep-aliveの接続（同一性の型 — Openのkの仮引数としてだけ生まれる。blk = 経路の層の格納場所〔link.sober〕・pa / pb = proxy / 行き先の握手の設定・
// p = Openのpolicyを読み解いた設定〔まとめの往復の期限・上限・経路〕）
type Session struct {
    c net.Conn
    p cfg
    blk []int
    t target
    pa internal.hsc.CParams
    pb internal.hsc.CParams
    seal sessionSeal
}

type sessionSeal struct {
}

// at の origin（"https://host[:port]" — path は見ない）へ接続を張り（proxy があれば proxy を通す）、Session を k に渡す（k が返ったら TLS なら close_notify を送って閉じる）。
// policy（既定 = Policy{}）はまとめの全往復に掛かる。policyのtimeoutの期限は経路の層を重ねるまで（proxyへのTLS・CONNECT・行き先へのTLSの握手）— TCPの接続そのものの不達はOSのconnectの期限に任せる。
// k の中の誤りは k の中で受ける（Open が返すのは接続と経路の失敗だけ）
@errors(Dns, Tls, Timeout, Closed, BadUrl, BadResponse, ProxyRefused, io.Expired)
@effects(block, io, panic, nondet)
func Open(at string, k func(s Session), policy Policy?) error? {
    c := resolve(policyOf(policy))
    t, ok := parseTarget(at)
    if !ok {
        return BadUrl{}
    }
    rt := viaOf(c, t)
    pa := params(c, rt.px)
    pb := params(c, t)
    to := c.timeout
    start := time.Mono()
    mut err := noErr()
    mut cut := false
    de := net.Dial(firstHop(rt, t), (conn) => {
        err = openOn(conn, c, rt, t, pa, pb, mut cut, k)
    })
    timedOut := time.Since(start) >= to
    if de != nil {
        return classify(de, timedOut)
    }
    if err != nil {
        return classify(err, timedOut)
    }
    if cut {
        return if timedOut { Timeout{} } else { Closed{} }
    }
    return nil
}

// 張った接続 conn の上に経路の層を重ね（期限 = c の timeout）、Session を k に渡し、k が返ったら close_notify を送る（cut = 期限で切れた）
@errors(io.Closed, io.Timeout, io.Expired, io.Denied, io.Other, internal.record.Alert, internal.hsc.CertFailed, ProxyRefused, BadResponse)
@effects(block, io, panic, nondet)
func openOn(conn net.Conn, c cfg, rt via, t target, pa internal.hsc.CParams, pb internal.hsc.CParams, cut mut bool, k func(s Session)) error? {
    blk := newLink()
    mut err := noErr()
    _, re := task.Run((sc) => {
        err = setupLink(conn, blk, rt, t, pa, pb)
        0
    }, deadline: c.timeout)
    cut = re != nil
    if err != nil || cut {
        return err
    }
    s := Session{c: conn, p: c, blk: blk, t: t, pa: pa, pb: pb, seal: sessionSeal{}}
    k(s)
    if !dead(blk) {
        _ = closeTop(conn, blk)
    }
    return nil
}

// sの接続の上でリクエストを1往復（urlは "/path" かsと同じoriginの絶対URL — 別のoriginはBadUrl・method / headers / body / cookiesはRequestと同じ）。
// redirectは追わない（3xxをそのまま返す — まとめは1本の接続の往復）。期限・本文の上限はOpenのpolicy。相手が閉じた後・閉じで区切るレスポンスの後・
// Connection: closeのレスポンスの後・途中の失敗の後のSendはClosed（張り直すのは呼び手 — 新しいOpenで）
@errors(Tls, Timeout, BodyTooLarge, Closed, BadUrl, BadResponse, io.Expired)
@effects(block, io, panic, nondet)
func Send(s Session, url string, method string?, headers ([]http.Field)?, body ([]byte)?, cookies ([]Cookie)?) (Response, error?) {
    if dead(s.blk) {
        return noResponse(), Closed{}
    }
    c := s.p
    r := outgoingOf(url, method, headers, body)
    t, ok := sameOrigin(s.t, r.url)
    if !ok {
        return noResponse(), BadUrl{}
    }
    rt := viaOf(c, t)
    req := requestBytes(r.method, requestTarget(rt, t), withProxyAuth(rt, t, r.headers), r.body, c.userAgent, true, cookieLine(cookies))
    noBody := r.method == "HEAD"
    mb := c.maxBody
    to := c.timeout
    start := time.Mono()
    mut raw := mut []byte{}
    mut st := newScan()
    mut err := noErr()
    _, re := task.Run((sc) => {
        err = linkTrip(s.c, s.blk, s.pa, s.pb, req, mut raw, mut st, noBody, mb)
        0
    }, deadline: to)
    timedOut := time.Since(start) >= to
    b := freeze(raw)
    if st.mode == mClose && st.hend >= 0 && !st.bad && !st.big && err == nil && re == nil {
        st.end = len(b)
    }
    if re != nil || err != nil || st.end < 0 || st.bad || st.big || st.mode == mClose {
        setFlag(s.blk, bDead)
    }
    if re != nil {
        return noResponse(), if timedOut { Timeout{} } else { Closed{} }
    }
    if err != nil {
        return noResponse(), classifyTrip(err, timedOut)
    }
    if st.big {
        return noResponse(), BodyTooLarge{}
    }
    if st.bad {
        return noResponse(), BadResponse{}
    }
    if st.end < 0 {
        return noResponse(), if st.hend < 0 && len(b) == 0 { Closed{} } else { BadResponse{} }
    }
    res := Response{status: st.status, headers: fieldsOf(b, st), body: bodyOf(b, len(b), st), url: ""}
    conn := Header(res, "connection")
    if conn != nil && lowerStr(conn) == "close" {
        setFlag(s.blk, bDead)
    }
    return res, nil
}

// 張った接続の上の往復の誤りを公開のラベルに（名前の解決と URL の誤りは Open の側で済んでいる）
@errors(Tls, Timeout, Closed, io.Expired)
func classifyTrip(e error, timedOut bool) error? {
    k := kindOf(e)
    if k == kTls {
        wrap(e)? Tls{}
    }
    if k == kTimeout || (k == kExpired && timedOut) {
        return Timeout{}
    }
    if k == kExpired {
        return io.Expired{}
    }
    wrap(e)? Closed{}
    return nil
}

// r.urlをsのoriginの上のリクエストの対象に（"/path" はそのまま・絶対URLはoriginが同じときだけ）
func sameOrigin(base target, u string) (target, bool) {
    b := bytes(u)
    if len(b) > 0 && b[0] == '/' {
        for x <- b {
            if x <= ' ' || x == 0x7f || int(x) >= 0x80 || x == '#' {
                return badTarget(), false
            }
        }
        return target{tls: base.tls, host: base.host, port: base.port, path: u}, true
    }
    t, ok := parseTarget(u)
    if !ok || origin(t) != origin(base) {
        return badTarget(), false
    }
    return t, true
}
