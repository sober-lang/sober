package http

// 要求の枠と頭の読み（frameAt / request）の旧新照合の網（CPU 効率便 U1 — report-1049 / 1050）: 書き換え前の frameAt / request と補助の関数を Ref の名前で
// そのまま写して基準（オラクル）にし、手で組んだ要求の種（CRLF / LF・先頭の空行・HTTP/1.0・Content-Length / chunked・食い違う Content-Length・
// 非 chunked の Transfer-Encoding・Connection の token・obs-fold・裸の CR・505・パイプライン・未完）に 1 バイトの置き換え・削除・重複と全部の切り詰めを掛け、
// mh / mb の境目（431 / 413）も含めて、新しい frameAt の枠（st・s・he・end・chunked・keep・v10）と、揃った要求の request の結果
// （誤りか・method・path・query・head・headers・body）が基準と一致することを照合する（受理集合不変の契約）

import "std/iter"
import "std/utf8"

type frameRef struct {
    // st: 0 = 足りない・1 = 揃った・他 = 誤りの status
    st int
    // s = 要求の始め（先頭の空行の後）・he = 頭の終わり（本文の始め）・end = 要求の終わり
    s int
    he int
    end int
    chunked bool
    // keep = 応答の後も保つ・v10 = HTTP/1.0
    keep bool
    v10 bool
}

func frameAtRef(b []byte, at int, mh int, mb int) frameRef {
    n := len(b)
    // 要求の前の空行は読み飛ばす（RFC 9112 2.2）
    mut s := at
    while s < n && (b[s] == '\r' || b[s] == '\n') {
        s += 1
    }
    // 頭の終わり = 空行（LF LF か LF CR LF）の直後
    mut he := -1
    mut i := s
    lim := if n < s + mh { n } else { s + mh }
    while he < 0 && i < lim {
        if b[i] == '\n' {
            if i + 1 < n && b[i + 1] == '\n' {
                he = i + 2
            } else if i + 2 < n && b[i + 1] == '\r' && b[i + 2] == '\n' {
                he = i + 3
            }
        }
        i += 1
    }
    if he < 0 {
        return frRef(if n - s >= mh { 431 } else { 0 }, s)
    }
    // 要求行: method SP target SP version
    le := lineEndRef(b, s)
    ce := contentEndRef(b, s, le)
    if bareCRRef(b, s, ce) {
        return frRef(400, s)
    }
    sp1 := indexInRef(b, s, ce, ' ')
    sp2 := if sp1 < 0 { -1 } else { indexInRef(b, sp1 + 1, ce, ' ') }
    if sp1 <= s || sp2 <= sp1 + 1 || indexInRef(b, sp2 + 1, ce, ' ') >= 0 {
        return frRef(400, s)
    }
    v11 := isLitRef(b, sp2 + 1, ce, "HTTP/1.1")
    v10 := isLitRef(b, sp2 + 1, ce, "HTTP/1.0")
    if !v11 && !v10 {
        return frRef(if ce - sp2 - 1 >= 5 && isLitRef(b, sp2 + 1, sp2 + 6, "HTTP/") { 505 } else { 400 }, s)
    }
    // ヘッダ
    mut cl := -1
    mut chunked := false
    mut closeTok := false
    mut kaTok := false
    mut ls := le + 1
    while ls < he {
        e := lineEndRef(b, ls)
        c := contentEndRef(b, ls, e)
        if c > ls {
            if b[ls] == ' ' || b[ls] == '\t' || bareCRRef(b, ls, c) {
                return frRef(400, s)
            }
            colon := indexInRef(b, ls, c, ':')
            if colon <= ls || !tokenRunRef(b, ls, colon) {
                return frRef(400, s)
            }
            vs := skipOWSRef(b, colon + 1, c)
            ve := trimOWSRef(b, vs, c)
            if eqFoldRef(b, ls, colon, bytes("content-length")) {
                v := digitsRef(b, vs, ve)
                if v < 0 || (cl >= 0 && cl != v) {
                    return frRef(400, s)
                }
                cl = v
            } else if eqFoldRef(b, ls, colon, bytes("transfer-encoding")) {
                if chunked || !eqFoldRef(b, vs, ve, bytes("chunked")) {
                    return frRef(501, s)
                }
                chunked = true
            } else if eqFoldRef(b, ls, colon, bytes("connection")) {
                closeTok = closeTok || hasTokenRef(b, vs, ve, bytes("close"))
                kaTok = kaTok || hasTokenRef(b, vs, ve, bytes("keep-alive"))
            }
        }
        ls = e + 1
    }
    if chunked && cl >= 0 {
        return frRef(400, s)
    }
    keep := !closeTok && (v11 || kaTok)
    mut end := he
    if chunked {
        end = chunkedEndRef(b, he, mb)
        if end < 0 && end != -1 {
            return frRef(0 - end, s)
        }
    } else if cl > mb {
        return frRef(413, s)
    } else if cl > 0 {
        end = if he + cl <= n { he + cl } else { -1 }
    }
    if end == -1 {
        return frRef(0, s)
    }
    return frameRef{st: 1, s: s, he: he, end: end, chunked: chunked, keep: keep, v10: v10}
}

func chunkedEndRef(b []byte, he int, mb int) int {
    mut p := he
    mut total := 0
    while true {
        // 生のバイト数の上限（小さい chunk の量産で持ち越しの列を溢れさせない）
        if p - he > 2 * mb + 64 {
            return -413
        }
        e := lineEndRef(b, p)
        if e < 0 {
            return if len(b) - p > 1024 { -400 } else { -1 }
        }
        c := contentEndRef(b, p, e)
        mut q := p
        mut size := 0
        while q < c && hexValRef(b[q]) >= 0 {
            size = size * 16 + hexValRef(b[q])
            if size > mb {
                return -413
            }
            q += 1
        }
        // chunk-ext（; …）は読み捨て（前の空白は許す）
        q = skipOWSRef(b, q, c)
        if q == p || (q < c && b[q] != ';') {
            return -400
        }
        p = e + 1
        if size == 0 {
            // trailer: 空行まで読み捨て
            mut t := p
            while true {
                te := lineEndRef(b, t)
                if te < 0 {
                    return -1
                }
                if contentEndRef(b, t, te) == t {
                    return te + 1
                }
                t = te + 1
            }
        }
        total += size
        if total > mb {
            return -413
        }
        if p + size >= len(b) {
            return -1
        }
        d := p + size
        if b[d] == '\n' {
            p = d + 1
        } else if b[d] == '\r' {
            if d + 1 >= len(b) {
                return -1
            }
            if b[d + 1] != '\n' {
                return -400
            }
            p = d + 2
        } else {
            return -400
        }
    }
    return -1
}

func lineEndRef(b []byte, i int) int {
    mut j := i
    while j < len(b) && b[j] != '\n' {
        j += 1
    }
    return if j < len(b) { j } else { -1 }
}

func contentEndRef(b []byte, ls int, le int) int {
    return if le > ls && b[le - 1] == '\r' { le - 1 } else { le }
}

func bareCRRef(b []byte, ls int, ce int) bool {
    mut i := ls
    while i < ce {
        if b[i] == '\r' {
            return true
        }
        i += 1
    }
    return false
}

func indexInRef(b []byte, s int, e int, c byte) int {
    mut i := s
    while i < e {
        if b[i] == c {
            return i
        }
        i += 1
    }
    return -1
}

func isLitRef(b []byte, s int, e int, lit string) bool {
    lb := bytes(lit)
    if e - s != len(lb) {
        return false
    }
    mut i := 0
    while i < len(lb) {
        if b[s + i] != lb[i] {
            return false
        }
        i += 1
    }
    return true
}

func lowerRef(c byte) byte {
    return if c >= 'A' && c <= 'Z' { byte(int(c) + 32) } else { c }
}

func eqFoldRef(b []byte, s int, e int, name []byte) bool {
    if e - s != len(name) {
        return false
    }
    mut i := 0
    while i < len(name) {
        if lowerRef(b[s + i]) != lowerRef(name[i]) {
            return false
        }
        i += 1
    }
    return true
}

func hasTokenRef(b []byte, s int, e int, tok []byte) bool {
    mut i := s
    while i < e {
        j := {
            k := indexInRef(b, i, e, ',')
            if k < 0 { e } else { k }
        }
        ts := skipOWSRef(b, i, j)
        if eqFoldRef(b, ts, trimOWSRef(b, ts, j), tok) {
            return true
        }
        i = j + 1
    }
    return false
}

func tokenRunRef(b []byte, s int, e int) bool {
    mut i := s
    while i < e {
        c := b[i]
        if c <= ' ' || c >= 127 || c == '(' || c == ')' || c == ',' || c == '/' || c == ':' || c == ';' || c == '<' || c == '=' || c == '>' || c == '?' || c == '@' || c == '[' || c == '\\' || c == ']' || c == '{' || c == '}' || c == '"' {
            return false
        }
        i += 1
    }
    return true
}

func skipOWSRef(b []byte, s int, e int) int {
    mut i := s
    while i < e && (b[i] == ' ' || b[i] == '\t') {
        i += 1
    }
    return i
}

func trimOWSRef(b []byte, s int, e int) int {
    mut i := e
    while i > s && (b[i - 1] == ' ' || b[i - 1] == '\t') {
        i -= 1
    }
    return i
}

func digitsRef(b []byte, s int, e int) int {
    if e <= s || e - s > 15 {
        return -1
    }
    mut v := 0
    mut i := s
    while i < e {
        if b[i] < '0' || b[i] > '9' {
            return -1
        }
        v = v * 10 + int(b[i]) - 48
        i += 1
    }
    return v
}

func hexValRef(c byte) int {
    return if c >= '0' && c <= '9' {
        int(c) - 48
    } else if c >= 'a' && c <= 'f' {
        int(c) - 87
    } else if c >= 'A' && c <= 'F' {
        int(c) - 55
    } else {
        -1
    }
}

func frRef(st int, s int) frameRef {
    return frameRef{st: st, s: s, he: 0, end: 0, chunked: false, keep: false, v10: false}
}

func requestRef(b []byte, f frameRef) (Request, error?) {
    v := utf8.Check(b[f.s:f.he])?
    hb := utf8.Bytes(v)
    hn := len(hb)
    le := lineEndRef(hb, 0)
    ce := contentEndRef(hb, 0, le)
    sp1 := indexInRef(hb, 0, ce, ' ')
    sp2 := indexInRef(hb, sp1 + 1, ce, ' ')
    q := indexInRef(hb, sp1 + 1, sp2, '?')
    method := utf8.Str(v, 0, sp1)?
    path := utf8.Str(v, sp1 + 1, if q >= 0 { q } else { sp2 })?
    query := if q >= 0 { utf8.Str(v, q + 1, sp2)? } else { "" }
    mut hs := mut []int{}
    mut ls := le + 1
    while ls < hn {
        e := lineEndRef(hb, ls)
        c := contentEndRef(hb, ls, e)
        if c > ls {
            colon := indexInRef(hb, ls, c, ':')
            vs := skipOWSRef(hb, colon + 1, c)
            hs = append(hs, ls)
            hs = append(hs, colon)
            hs = append(hs, vs)
            hs = append(hs, trimOWSRef(hb, vs, c))
        }
        ls = e + 1
    }
    body := if f.chunked { unchunkRef(b, f.he) } else { b[f.he:f.end] }
    return Request{method: method, path: path, query: query, head: v, headers: freeze(hs), body: body, pattern: ""}, nil
}

func unchunkRef(b []byte, he int) []byte {
    mut out := mut []byte{}
    mut p := he
    mut size := 1
    while size > 0 {
        e := lineEndRef(b, p)
        mut q := p
        size = 0
        while hexValRef(b[q]) >= 0 {
            size = size * 16 + hexValRef(b[q])
            q += 1
        }
        p = e + 1
        mut k := 0
        while k < size {
            out = append(out, b[p + k])
            k += 1
        }
        p += size
        if size > 0 {
            p += if b[p] == '\r' { 2 } else { 1 }
        }
    }
    return freeze(out)
}

func sameBytes(a []byte, b []byte) bool {
    if len(a) != len(b) {
        return false
    }
    for i <- iter.Range(0, len(a)) {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

func sameInts(a []int, b []int) bool {
    if len(a) != len(b) {
        return false
    }
    for i <- iter.Range(0, len(a)) {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

// agree は b の at からの枠と要求が基準と一致するか（違えば 1 行出して偽）
func agree(b []byte, at int, mh int, mb int) bool {
    o := frameAtRef(b, at, mh, mb)
    f := frameAt(b, at, mh, mb)
    if o.st != f.st || o.s != f.s || o.he != f.he || o.end != f.end || o.chunked != f.chunked || o.keep != f.keep || o.v10 != f.v10 {
        println("frame differs: ${string(b) catch "<bytes>"} at ${at} mh ${mh} mb ${mb}: ref st ${o.st} s ${o.s} he ${o.he} end ${o.end} / new st ${f.st} s ${f.s} he ${f.he} end ${f.end}")
        return false
    }
    if o.st != 1 {
        return true
    }
    ro, eo := requestRef(b, o)
    rn, en := request(b, f)
    if (eo == nil) != (en == nil) {
        println("request error differs: ${string(b) catch "<bytes>"}")
        return false
    }
    if eo != nil {
        return true
    }
    if ro.method != rn.method || ro.path != rn.path || ro.query != rn.query || !sameBytes(utf8.Bytes(ro.head), utf8.Bytes(rn.head)) || !sameInts(ro.headers, rn.headers) || !sameBytes(ro.body, rn.body) {
        println("request differs: ${string(b) catch "<bytes>"}")
        return false
    }
    return true
}

// seeds は要求の種（"|" で区切った 1 本の文字列 — 種の中に | は使わない）
func seeds() []string {
    return []string{
        "GET /baseline11?a=1&b=2 HTTP/1.1\r\nHost: localhost:8080\r\nUser-Agent: zrk\r\nConnection: keep-alive\r\n\r\n",
        "GET / HTTP/1.1\r\nHost: x\r\n\r\n",
        "GET /p?q HTTP/1.0\nHost: x\n\n",
        "\r\n\r\nGET /a HTTP/1.1\r\nHost: x\r\n\r\n",
        "POST /e HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhello",
        "POST /e HTTP/1.1\r\nContent-Length: 3\r\nContent-Length: 3\r\n\r\nabcGET / HTTP/1.1\r\n\r\n",
        "POST /e HTTP/1.1\r\nContent-Length: 3\r\nContent-Length: 4\r\n\r\nabcd",
        "POST /c HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n3;x=1\r\nabc\r\n0\r\nT: v\r\n\r\n",
        "POST /c HTTP/1.1\r\nTransfer-Encoding: gzip\r\n\r\n",
        "POST /c HTTP/1.1\r\nTransfer-Encoding: chunked\r\nContent-Length: 2\r\n\r\n0\r\n\r\n",
        "GET / HTTP/1.1\r\nConnection: close\r\n\r\n",
        "GET / HTTP/1.0\r\nConnection: Keep-Alive\r\n\r\n",
        "GET / HTTP/1.0\r\nConnection: foo, keep-alive , bar\r\nConnection: close\r\n\r\n",
        "GET / HTTP/1.1\r\nConnection:CLOSE\r\n\r\n",
        "GET / HTTP/1.1\r\n Host: x\r\n\r\n",
        "GET / HTTP/1.1\r\nHo st: x\r\n\r\n",
        "GET / HTTP/1.1\r\nHost: a\rb\r\n\r\n",
        "GET / HTTP/2.0\r\n\r\n",
        "GET / HTTX/1.1\r\n\r\n",
        "GET  / HTTP/1.1\r\n\r\n",
        "GET / HTTP/1.1 x\r\n\r\n",
        "GET /a HTTP/1.1\r\nX-Empty:\r\nX-Sp:   v  \t\r\n\r\nGET /b HTTP/1.1\r\n\r\n",
        "GET / HTTP/1.1\r\nHost: x\r\n",
        "GET / HTTP/1.1\r\n\r\r\n\r\n",
        "GET / HTTP/1.1\n\r\n",
        "PUT /u HTTP/1.1\r\ncontent-length: 012\r\n\r\n123456789012",
        "GET /é HTTP/1.1\r\nX: é\r\n\r\n",
    }
}

// muts は置き換えに使うバイト
func muts() []byte {
    return []byte{'\r', '\n', ' ', '\t', ':', ',', 'a', 'K', '0', '(', '/', byte(0), byte(0x80), byte(0xff)}
}

// each は種 s のどの位置でも置き換え・削除・重複した列と、全部の切り詰めを k に渡す
func each(s string, k func([]byte) bool) bool {
    b := bytes(s)
    mut ok := true
    for n <- iter.Range(0, len(b) + 1) {
        ok = k(b[0:n]) && ok
    }
    ms := muts()
    for i <- iter.Range(0, len(b)) {
        for m <- ms {
            mut x := mut []byte{}
            for j <- iter.Range(0, len(b)) {
                x = append(x, if j == i { m } else { b[j] })
            }
            ok = k(freeze(x)) && ok
        }
        mut d := mut []byte{}
        mut u := mut []byte{}
        for j <- iter.Range(0, len(b)) {
            if j != i {
                d = append(d, b[j])
            }
            u = append(u, b[j])
            if j == i {
                u = append(u, b[j])
            }
        }
        ok = k(freeze(d)) && ok
        ok = k(freeze(u)) && ok
    }
    return ok
}

func TestFrameAgrees() {
    mut ok := true
    for s <- seeds() {
        ok = each(s, (b []byte) => agree(b, 0, 8192, 8192)) && ok
    }
    assert(ok)
}

// 上限の境目（mh: 頭の長さ・mb: 本文の長さ）と途中からの読み（パイプラインの 2 件目の at）
func TestFrameLimits() {
    mut ok := true
    for s <- seeds() {
        b := bytes(s)
        for mh <- iter.Range(1, len(b) + 2) {
            ok = agree(b, 0, mh, 8192) && ok
        }
        for mb <- iter.Range(0, 16) {
            ok = agree(b, 0, 8192, mb) && ok
        }
        for at <- iter.Range(0, len(b) + 1) {
            ok = agree(b, at, 8192, 8192) && ok
        }
    }
    assert(ok)
}
