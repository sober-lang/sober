package task

// structured concurrency の表層（language.md 11 節「表層」）と、多くの task から 1 つの状態への直列の更新 domain（NewDomain / Update / Read / Await — language.md 11 節「domain」）。task.Run が scope を開き、その中で task.Spawn した子の task を Join / Try で待つ。
// taskの結果はコピーできるimmのデータ（string・slice・mapもJoin / Tryがscopeのregionへコピーする）。errorを返すtask
// （g が `(T, error?)` を返す）の Join は 2 値・Try は Outcome の Failed・Join も Try もしなかった失敗は scope の err へ集約

// Run / Spawn / Join / Tryはdesugar（checkの経路）とlower（buildの経路）が呼び出し点で固定のテンプレートに変換する
// （コンパイラが名前で引く閉じた集合 — ユーザーは鋳造できない）。本体は変換が外れたときの柵で、到達しない

import "std/io"

// 札・handle・死因の封（非公開 — 外で値を書けないので、外からは作れない）。1ワードはbuildの実装が運ぶ値
// （札 = scope の記録・handle = 子の枠・死因 = 終了コードと点 — lower/par.sober。番地は言語から観測できない）
type sealed struct {
    w int
}

// scope のハンドル（task.Run の本体の仮引数）
type Scope struct {
    seal sealed
}

// 子の task の handle（task.Spawn が返す）
type Handle[T] struct {
    seal sealed
}

// 子の死因（不透明 — 中身は実装が運ぶ実行時の値。コアでは抽象）
type Cause struct {
    seal sealed
}

// scope の err: 本体は完走したが死んだ子がいた
type ChildDied error {
    cause Cause
}

// task.Try の結果（死を値で見る — 監督の API）。Failed は error を返す task の失敗
type Outcome[T] union {
    Ok { v T }
    Failed { e error }
    Died { cause Cause }
}

// 予算の単位（バイト — `budget: 64 * MB`）
const KB = 1024
const MB = 1048576
const GB = 1073741824

// 期限の単位（1 ミリ秒 — `deadline: 500 * MS`。値はナノ秒の相対時間 — 時刻源は CLOCK_MONOTONIC）
const MS = 1000000

// 呼び出し点の変換が外れた柵（到達しない）
type NotLowered panic

// region を 1 段開き、本体 f をハンドルで走らせる。子が全部決着してから戻り、死んだ子がいれば err = ChildDied、
// 無くて Join も Try もしなかった失敗があれば（生んだ順で最初のもの）err = その子の err。
// budget = この scope の天井（バイト・省略可 — 省略なら天井のノードを作らず、外の scope の天井だけが掛かる）。wait = true なら天井に入れない直接の子は縮退せずに入れるまで待つ（宣言 = 本当の上限 —
// language.md 11 節「wait」。true / false の字面だけ・省略 = 外の scope の方針を継ぐ〔既定 = 縮退〕）。
// deadline = 開いた時点からの期限（相対・省略可）: 過ぎたら scope の中〔子孫の task も〕の I/O 呼び出しが io.Expired を返す — 走っている仕事は切らない
// （待ちの上限であって実行時間の上限ではない — language.md 28 節「デッドライン」。入れ子は早い方）。
// backlog = この scope の中で生んだ子のうち、ワーカーの列に積んでおける未着手の本数（1〜255 に丸める・省略 = 外の scope から継ぐ〔既定 255〕）: 越えると
// 生んだ task は譲って子をその場で先に走らせる（値は変わらない — 生む速さが掃く速さを上回る間の背圧。language.md 11 節「未着手の子の上限」）。子の task も継ぐ
@errors(ChildDied)
@effects(block)
func Run[T](f func(Scope) T, budget int?, wait bool?, deadline int?, backlog int?) (T, error?) {
    if fence() {
        return panic(NotLowered{})
    }
    return panic(NotLowered{}), ChildDied{cause: Cause{seal: sealed{}}}
}

// 柵（変換が外れたらpanic — 宣言の @errorsを本体が書ける形にするための分岐）
func fence() bool {
    return true
}

// 子のtaskを生む（gの捕獲はimmのデータだけ・結果はscopeのregionへコピーされる）。budget = この子を逐次で走らせたときの使用量の上界（バイト・省略可。書けば入場の見積もりの代わりに使う — 省略ならspawnの点ごとに観測した使用量の高水位〔観測の無い間は1 MiB〕が見積もり。呼び出しを含まない整数式）。
// budget の無い子の region 1 つの上限は 512 MiB（超えると RegionExceeded の死 — 大きい作業域の子は budget を書く・書けばそれ以上の 2 の冪）
@effects()
func Spawn[T](s Scope, g func() T, budget int?) Handle[T] {
    return panic(NotLowered{})
}

// 子の結果（死んでいたら呼び手も死ぬ — この子の死は私の死）
@effects(block)
func Join[T](h Handle[T]) T {
    return panic(NotLowered{})
}

// 子の結果を Outcome で（死は値）
@effects(block)
func Try[T](h Handle[T]) Outcome[T] {
    return panic(NotLowered{})
}

// Sender / Receiver はチャネルの端点（送り端・受け端 — 単一の task が持つ。子へは Spawn の give: でだけ渡す — language.md 11 節）
type Sender[T] struct {
    seal sealed
}

// チャネルの受け端（Sender の対 — NewChannel が組で返す。受けるのは Recv）
type Receiver[T] struct {
    seal sealed
}

// 容量 cap（1 以上の整数の字面）の有界のチャネルの端点の組
@effects()
func NewChannel[T](cap int) (Sender[T], Receiver[T]) {
    return Sender[T]{seal: sealed{w: cap}}, Receiver[T]{seal: sealed{w: cap}}
}

// v を送る（満杯なら待つ）
@effects(block)
func Send[T](tx Sender[T], v T) {
    if fence() {
        panic(NotLowered{})
    }
}

// 次の値（空なら待つ。閉じて空なら nil — 何度受けても nil）
@effects(block)
func Recv[T](rx Receiver[T]) T? {
    return panic(NotLowered{})
}

// `for l <- task.Recv(rx) { … }` の変換先（loaderが呼び先を付け替える — 閉じて空になるまで受けてkへ渡す）（対の SendAll は実需まで足さない — 34 節2の注記）
@effects(block)
func RecvAll[T](rx Receiver[T], k func(T)) {
    mut more := true
    while more {
        v := Recv(rx)
        if v != nil {
            k(v)
        } else {
            more = false
        }
    }
}

// 送り端を閉じる（以後の Send は panic・二度目の Close も panic。受け手は残りを受け終えると nil を受ける）
@effects()
func Close[T](tx Sender[T]) {
    if fence() {
        panic(NotLowered{})
    }
}

// `Spawn(s, give: ep, (ep) => …)` の変換先（loaderが呼び先を付け替える — 端点epをちょうど1つの子へ移す。親に残った別名は失効）
@effects()
func SpawnGive[T, E](s Scope, give E, g func(E) T, budget int?) Handle[T] {
    return panic(NotLowered{})
}

// handle の列を生んだ順（正準順）で待って結果を集める fan-in（死んだ子があれば呼び手も死ぬ: Join と同じ）。
// handle の slice は関数の境界を越えないので、呼び出し点で展開される（loader の expands — 本体は普通の Sober）
@effects(block)
func Gather[T](hs []Handle[T]) []T {
    mut out := mut []T{}
    mut i := 0
    while i < len(hs) {
        out = append(out, Join(hs[i]))
        i += 1
    }
    return freeze(out)
}

// error を返す task の handle の列の Gather（呼び手は task.Gather と書く: handle の slice の
// 要素の型が Handle[(T, error?)] なら表層型検査器がここへ振り分ける）。全部を生んだ順で待ち（失敗で止めない）、err は生んだ順で最初の失敗の err・
// 失敗があれば結果は空。死んだ子があれば呼び手も死ぬ（Join と同じ）。呼び出し点で展開される（handle の slice の仮引数）
func gatherE[T](hs []Handle[(T, error?)]) ([]T, error?) {
    mut out := mut []T{}
    mut bad := -1
    mut i := 0
    while i < len(hs) {
        v, e := Join(hs[i])
        if e != nil && bad < 0 {
            bad = i
        }
        out = append(out, v)
        i += 1
    }
    if bad >= 0 {
        // Join は何度でも同じ結果（handle = future）
        _, e := Join(hs[bad])
        return []T{}, e
    }
    return freeze(out), nil
}

// mapE の scope の値（結果の列と、生んだ順で最初の失敗の err）
type mapRes[U] struct {
    vs []U
    e error?
}

// xs の各要素に f を並列に（要素ごとに 1 task）適用し、結果を添字の順に返す（language.md 11 節: `([]U, error?)`。
// 結果の型 U はラムダの結果から推論する。子が死ねば err = ChildDied で結果は空 — 死は Try で値にして集めず、scope の出口が
// err に乗せる。死を見たら残りを Try しない — scope の値は ChildDied に決まり、後ろの純な子は切られる: Try すると走らせ直しになる）。f の捕獲は Spawn と同じ規則（実引数のラムダの本体が子の本体へ展開される）。呼び出し点で展開される（関数型の引数）
@errors(ChildDied)
@effects(block)
func Map[T, U](xs []T, f func(T) U, budget int?) ([]U, error?) {
    return Run((s Scope) => {
        mut hs := mut []Handle[U]{}
        mut i := 0
        while i < len(xs) {
            x := xs[i]
            hs = append(hs, Spawn(s, () => f(x), budget: budget))
            i += 1
        }
        mut out := mut []U{}
        mut j := 0
        while j < len(hs) {
            switch Try(hs[j]) {
            case Ok{v}: out = append(out, v)
            case Failed{e}: {}
            case Died{cause}: j = len(hs)
            }
            j += 1
        }
        freeze(out)
    })
}

// f が error を返す Map（呼び手は task.Map と書く: ラムダの結果が `(U, error?)` なら
// 表層型検査器がここへ振り分ける）。全部を待ち、err は添字の順（= 生んだ順）で最初の失敗の err で結果は空・子が死ねば err = ChildDied（死が先）。
// 死を見たら残りを Try しない（Map と同じ）。失敗での打ち切りは未実装（失敗は後ろの子の死に負ける）
@errors(ChildDied)
func mapE[T, U](xs []T, f func(T) (U, error?), budget int?) ([]U, error?) {
    r, se := Run((s Scope) => {
        mut hs := mut []Handle[(U, error?)]{}
        mut i := 0
        while i < len(xs) {
            x := xs[i]
            hs = append(hs, Spawn(s, () => f(x), budget: budget))
            i += 1
        }
        mut out := mut []U{}
        mut bad := -1
        mut j := 0
        while j < len(hs) {
            switch Try(hs[j]) {
            case Ok{v}: out = append(out, v)
            case Failed{e}: if bad < 0 {
                bad = j
            }
            case Died{cause}: j = len(hs)
            }
            j += 1
        }
        if bad >= 0 {
            _, e := Join(hs[bad])
            mapRes[U]{vs: []U{}, e: e}
        } else {
            mapRes[U]{vs: freeze(out), e: nil}
        }
    })
    if se != nil {
        return []U{}, se
    }
    return r.vs, r.e
}

// 名前つきプール（テナント・エンドポイント — language.md 11 節「上限の木」）のハンドル: task.SpawnIn の第 2 実引数。
// 1ワードはrtの台帳のノード（immのデータ — 子へ捕獲できる）。shedの単位 = プールのノード（枯れたノードの配下のSpawnInだけが失敗する）
type Pool struct {
    seal sealed
}

// task.SpawnIn の失敗: プール（か祖先のプール）の天井に入れなかった — 受けられない、という値（io の入力 — 兄弟の予算の返却時刻に依る）
type Shed error {}

// プールのノードの表が尽きた（NewPool を POOL_MAX 回より多く呼んだ）
type PoolLimit panic

// rt の台帳にプールのノードを 1 つ取る（budget = 天井のバイト・parent = 親のノード〔0 = 無し〕。表が尽きたら負）
@intrinsic("par_pool")
func newPool(budget int, parent int) int

// 台帳の1ワード（k — Ledgerの読み出しのインターフェース。io: 読んだ値は時刻に依る）
@intrinsic("par_ledger")
func ledgerWord(k int) int

// プールのノードwの失敗の数を1足す（MarkFailedのインターフェース）
@intrinsic("par_fail")
func poolFail(w int) int

// プール p の失敗を 1 つ記帳する（Ledger の fail — 境界の API が「受けた仕事が error で終わった」を数える: net.Serve の handler の失敗）
@effects()
func MarkFailed(p Pool) {
    _ = poolFail(p.seal.w)
}

// 天井 budget バイトのプール（parent があればその下のノード — 入場は自分のノードから根のノードまで全部の天井を見る）
@effects(panic)
func NewPool(budget int, parent Pool?) Pool {
    pw := if parent != nil { parent.seal.w } else { 0 }
    w := newPool(budget, pw)
    if w < 0 {
        return panic(PoolLimit{})
    }
    return Pool{seal: sealed{w: w}}
}

// 台帳のプールのノードの 1 行（id = 作った順の番号・parent = 親の id〔-1 = 無し〕・used / tasks = 計上中のバイト / task の数）
type PoolView struct {
    id int
    parent int
    cap int
    used int
    tasks int
    admit int
    shed int
    fail int // MarkFailed で記帳した失敗の数（net.Serve — handler が error を返した接続）
    died int // このプールで入場した task の死の数（net.Serve — handler が死んだ接続）
}

// domainの合計の行（Ledger().domains — language.md 11 節「domain」の観測のインターフェース）: 全domainをまとめた1行
type DomainView struct {
    waiting int // 今 Await で待っている呼び出しの数
    maxWait int // 待ったAwaitの到着から入るまでの最大（ns — 読むと0に戻るウィンドウの値・maxWaitと同じ流儀）
    expired int // 待ちの上限が来て io.Expired で返った回数の累計
    poisoned int // 本体が死んで毒になった domain の数の累計
}

// 台帳の read-only のビュー（language.md 11 節「メトリクス」）: 根 = プロセスの天井と計上中の量・縮退 / 天井を超えた入場 /
// 宣言超過 / shed の数・ワーカー数、と名前つきプールのノード（作った順）
type LedgerView struct {
    workers int
    cap int
    used int
    tasks int
    inline int
    over int
    declOver int
    shed int
    waits int // wait の scope で入場を待った回数（language.md 11 節「wait」）
    maxWait int // 走れるようになってから走るまでの待ちの最大（ns・全ワーカー — 読むと0に戻る。language.md 28 節io_uringのパス「飽和下の待ちの上限」）
    aged int // 待ちの上限が効いてスタックの底から取った回数の累計（飽和のフラグ — 底を期限で救った数）
    late int // 自分のDを越えてから走ったtaskの数の累計（agedの救いに加え、スタックが浅いときの越えも数える — aged ⊆ late）
    maxLate int // 越えた量（待ち − D）の最大（ns・全ワーカー — 読むと0に戻るウィンドウの値・maxWaitと同じ流儀）
    backlog int // 今の未着手の子の数（全ワーカーの列の和 — ワーカーあたり 255 まで。language.md 11 節「未着手の子の上限」）
    backlogYield int // 列があふれて子をその場で先に走らせた（生んだtaskが譲った）回数の累計（背圧が効いたフラグ）
    pin int // ワーカーの CPU の固定の形（0 = なし・1 = L3 キャッシュを共有する CPU の群・2 = CPU 1 つ・3 = L3 の群が読めず CPU 1 つへ縮退したワーカーがある）
    pinGroups int // 固定した群の数（ワーカーは起動の後に自分を固定する — 全部が数えられるのはワーカーが立ち上がった後）
    parkShallow int // 接続のtaskがシャロースリープした回数の累計（本体より下のスタックを捨て、ワーカーのエリアを持たずにスリープした — language.md 11 節「メトリクス」）
    parkDeep int // 接続のtaskがワーカーのエリアを持ってディープスリープした回数の累計（エリアの交換 — 本体より下の枠が生きている待ち）
    parkDeepWin int // シャロースリープできる点だったがエリアのウィンドウに中身があってディープスリープした回数の累計（parkDeepの内数 — 受けのregionに途中のリクエストを持って待つ等）
    parkSwap int // シャロースリープする前に所有エリアとワーカーのエリアを入れ替えた回数の累計（parkShallowの内数 — ディープスリープの後の受け）
    pools []PoolView
    domains DomainView // domain の合計の行
}

// 台帳の今の値（ioのエフェクト — 読んだ値は時刻に依る: 時計と同じ扱い）
@effects(nondet)
func Ledger() LedgerView {
    np := ledgerWord(0)
    mut ps := mut []PoolView{}
    mut i := 0
    while i < np {
        b := 22 + i * 8
        ps = append(ps, PoolView{id: i, parent: ledgerWord(b + 5) - 1, cap: ledgerWord(b), used: ledgerWord(b + 1), tasks: ledgerWord(b + 2), admit: ledgerWord(b + 3), shed: ledgerWord(b + 4), fail: ledgerWord(b + 6), died: ledgerWord(b + 7)})
        i += 1
    }
    return LedgerView{workers: ledgerWord(8), cap: ledgerWord(1), used: ledgerWord(2), tasks: ledgerWord(3), inline: ledgerWord(4), over: ledgerWord(5), declOver: ledgerWord(6), shed: ledgerWord(7), waits: ledgerWord(9), maxWait: ledgerWord(10), aged: ledgerWord(11), late: ledgerWord(16), maxLate: ledgerWord(17), backlog: ledgerWord(12), backlogYield: ledgerWord(13), pin: ledgerWord(14), pinGroups: ledgerWord(15), parkShallow: ledgerWord(18), parkDeep: ledgerWord(19), parkDeepWin: ledgerWord(20), parkSwap: ledgerWord(21), pools: freeze(ps), domains: DomainView{waiting: ledgerWord(-1), maxWait: ledgerWord(-2), expired: ledgerWord(-3), poisoned: ledgerWord(-4)}}
}

// プール pool の天井に入れれば子の task を生む（handle, nil）・入れなければ (nil, Shed{})（縮退しない — shed を望む境界の API ・
// language.md 11 節「shed」）。入場はプールのノードから親のノードまで全部と根（根の天井を超えるときは give: と同じく超過で入場）。子と子の中の Spawn は
// プールの天井の下に計上される。g・budget は Spawn と同じ
@errors(Shed)
@effects()
func SpawnIn[T](s Scope, pool Pool, g func() T, budget int?) (Handle[T]?, error?) {
    if fence() {
        return panic(NotLowered{})
    }
    return nil, Shed{}
}

// ワーカーローカルストレージのハンドル（region-domain-pool.md 4d節 — task.NewLocalが作る）: ワーカーごとにTを1つ持ち、task.Leaseのウィンドウに貸す。
// 中身はNewLocalを呼んだregionに住むimmの列（regionの規則がそのまま効く — 外へ出すと列ごとコピーされる〔別のストレージ — 観測は同じ・遅いだけ〕）。
// 子taskへはimmのデータとして捕獲で渡る。ゼロ値は何も指さない偽物（同一性の種類 — NewLocalだけが作る）。
// 型引数を持たない: ストレージのTはmutの列（pool.Scratch）を持つstructで、型引数に置けない（language.md 25 節 — 型引数はコピーできる型）。
// T の同一性は loader が型の名前から焼いた指紋で Lease ごとに照合する（違えば panic(LocalType{}) — 呼び手の契約違反）
type Local struct {
    blk []int
}

// NewLocalと違うTのウィンドウでLeaseした（ストレージのTの指紋が合わない）
type LocalType panic

// T のストレージをワーカーの数だけ作る: `gzw := task.NewLocal((w mut flate.Work) => { pool.NewScratch(mut w.head, 1 << 15) … })`。
// ウィンドウのラムダはTのScratchのフィールドを定数の容量で整える文だけ（loaderの検査）。Tはスカラーとpool.Scratchのフィールドだけのstruct。
// 呼び出し点はloaderが変換する（lease.sober — 本体は変換が外れたときの柵）
@effects(panic)
func NewLocal(prep func()) Local {
    return panic(NotLowered{})
}

// lpの今のワーカーのストレージをウィンドウbodyに貸す: `z := task.Lease(gzw, (w mut flate.Work) => flate.EncodeWith(mut w, b, 6))`。
// 意味は「ウィンドウのたびに新しい値」— `{ mut w := T{}; 整え(mut w); body(mut w) }` と観測上同じ（スカラーは0・Scratchは全部0・容量はNewLocalの整えのまま）。
// ストレージが使用中（ウィンドウの中で譲ったtaskが持っている）なら新しい割り当てに倒れる（遅いだけ）。呼び出し点はloaderが変換する
@effects(panic)
func Lease[U](lp Local, body func() U) U {
    return panic(NotLowered{})
}

// LocalNew / LeaseTake / LeaseGive / LeaseBlockはtask.NewLocal / task.Leaseの変換先（loaderが組む — 利用者の直の呼び出しはloaderが拒否）。
// ストレージの列の形: [Tの指紋, Scratchのフィールドの数n, フィールドごとの容量 × n, ワーカーの数W, ワーカーごとのエリア × W]。エリア = [フラグ, チェーン, フィールドごとに (tag, ワード × 容量)]
// （フラグとチェーンはrtのlease_opが書く・tagとワードはpool.LeaseAttachが付けたウィンドウのScratchが書く — immの列のワードをrtのインターフェースだけが書く）

// rtのインターフェース（op 0 = ワーカーの数・1 = 今のワーカーの番号・2 = blk[off] のフラグを取る〔1 / 0 = 使用中〕・3 = 返す・4 = 生の読み・5 = 生の書き・6 = 今の深度より深い死んだスロットのページを返す — std/tlsのhandshakeの後）
@intrinsic("lease_op")
func leaseOp(op int, blk []int, off int, v int) int

// task.NewLocal / task.Leaseの変換先（loaderが組む — 利用者の直の呼び出しはloaderが拒否）: Tの指紋fpとScratchのフィールドの容量の列capsからストレージを作る（ワーカーの数だけのエリアを今のregionに先取り — 全部0）
@effects()
func LocalNew(fp int, caps []int) Local {
    n := len(caps)
    mut sz := 2
    mut i := 0
    while i < n {
        sz += 1 + caps[i]
        i += 1
    }
    nw := leaseOp(0, []int{}, 0, 0)
    total := 3 + n + nw * sz
    mut b := mut []int{}
    b = append(b, fp)
    b = append(b, n)
    i = 0
    while i < n {
        b = append(b, caps[i])
        i += 1
    }
    b = append(b, nw)
    // エリアは全部0から（1回きり — ワーカーの数 × エリアの大きさ）
    mut k := len(b)
    while k < total {
        b = append(b, 0)
        k += 1
    }
    return Local{blk: freeze(b)}
}

// task.NewLocal / task.Leaseの変換先（loaderが組む — 利用者の直の呼び出しはloaderが拒否）: Tの指紋fpを照合し、今のワーカーのエリアの位置を返す（使用中なら −1 = 倒れ）
@effects(panic)
func LeaseTake(lp Local, fp int) int {
    if len(lp.blk) == 0 || lp.blk[0] != fp {
        panic(LocalType{})
    }
    n := lp.blk[1]
    nw := lp.blk[2 + n]
    w := leaseOp(1, lp.blk, 0, 0)
    if w < 0 || w >= nw {
        return 0 - 1
    }
    mut sz := 2
    mut i := 0
    while i < n {
        sz += 1 + lp.blk[2 + i]
        i += 1
    }
    at := 3 + n + w * sz
    return if leaseOp(2, lp.blk, at, 0) == 1 { at } else { 0 - 1 }
}

// task.NewLocal / task.Leaseの変換先（loaderが組む — 利用者の直の呼び出しはloaderが拒否）: LeaseTakeで取ったエリアatを返す（−1なら何もしない）
@effects()
func LeaseGive(lp Local, at int) {
    if at >= 0 {
        _ = leaseOp(3, lp.blk, at, 0)
    }
}

// task.NewLocal / task.Leaseの変換先（loaderが組む — 利用者の直の呼び出しはloaderが拒否）: ストレージの列（pool.LeaseAttachへ渡す）
@effects()
func LeaseBlock(lp Local) []int {
    return lp.blk
}

// domain — 直列化された共有状態（language.md 11 節「domain」）: 状態 S を 1 つ持ち、Update / Read / Await の本体を 1 つずつ当てる。
// 捕獲でき、関数の実引数にできる。scope の値・task の結果・チャネルのペイロードにはできない（札・handle と同じ側 — 作った scope の出口で状態ごと消える）
type Domain[S] struct {
    seal sealed
}

// 札 s の scope に状態の初期値 init を持つ domain を作る。wait = Await の待ちの上限（ナノ秒の相対時間・省略で既定値）。
// 呼び出し点はdesugarがコアのdnewへ変換する（本体は変換が外れたときの柵）
@effects()
func NewDomain[S](s Scope, init S, wait int?) Domain[S] {
    return panic(NotLowered{})
}

// fをdの状態に当て、fの値をコピーして返す。fは待たない・ioなし・nondetなし・明示のpanicなし・捕獲はimmのデータだけ
@effects(nondet)
func Update[S, R](d Domain[S], f func(st mut S) R) R {
    mut st := domEnter(d)
    r := f(mut st)
    domExit(d, st)
    return domOut(r)
}

// gの値をコピーして返す（状態は変えない）。gの約束はUpdateのfと同じ
@effects(nondet)
func Read[S, R](d Domain[S], g func(st S) R) R {
    st := domEnter(d)
    r := g(domView(st))
    domExit(d, st)
    return domOut(r)
}

// when が真になるまで待ってから f を当てる（待つ呼び出しは来た順に入る）。wait = 待ちの上限（省略なら NewDomain の wait）。
// when の約束は f と同じ。待ちが上限（か囲む task.Run の期限）を越えたら io.Expired
@errors(io.Expired)
@effects(nondet)
func Await[S, R](d Domain[S], f func(st mut S) R, when func(st S) bool, wait int?) (R, error?) {
    mut st := domEnter(d)
    while !when(domView(st)) {
        // 入った順は when が真だった順（録った順の下では到達しない — コアの unreach）
        if !domWait(d, wait, when) {
            return domMiss[R](), io.Expired{}
        }
        st = domLoad(d)
    }
    r := f(mut st)
    domExit(d, st)
    return domOut(r), nil
}

// Update / Read / Awaitの変換先のインターフェース（desugarがコアのdenter / dexitへ変換する）: 番が来たら入り、状態を今の最内へコピーして受ける
@effects(nondet)
func domEnter[S](d Domain[S]) S {
    return panic(NotLowered{})
}

// 新しい状態 st を梱包して戻し、出る
@effects()
func domExit[S](d Domain[S], st S) {
    if fence() {
        panic(NotLowered{})
    }
}

// 本体の結果を呼び手の最内へコピーする（状態と別名にしない — desugarは恒等でコピーする）
@effects()
func domOut[R](r R) R {
    if fence() {
        panic(NotLowered{})
    }
    return r
}

// 鍵を手放して待ちの列に積み、手渡されたら鍵を持ってtrue・上限が来たら鍵を持たずにfalse（コアのunreach）。whenは待ち手をまとめる鍵にだけ使う
// （捕捉の無い同じwhenが同じ状態で偽と分かった待ち手はウェイクアップしない — 呼ばない）
@effects(block)
func domWait[S](d Domain[S], wait int?, when func(st S) bool) bool {
    return panic(NotLowered{})
}

// 本体の状態をimmの見方で渡す（mutの器を持つ状態でもg / whenの仮引数の型に合う — コピーしない）
@effects()
func domView[S](st S) S {
    if fence() {
        panic(NotLowered{})
    }
    return st
}

// 手渡された後の状態を読み直す（コアの unreach）
@effects()
func domLoad[S](d Domain[S]) S {
    return panic(NotLowered{})
}

// Awaitのwhenが偽のまま入った分岐（コアのunreach）
@effects()
func domMiss[R]() R {
    return panic(NotLowered{})
}
