package tls

// std/internal/hs（hs は std の内側）: TLS 1.3 のサーバの handshake を
// Goのcrypto/tlsのクライアントと突き合わせる。ゴールデン = scripts/oracles/tls_trace.goが記録したもの: Goのtls.Client（乱数の源を固定 +
// `//go:debug cryptocustomrand=1` で走りごとに同じClientHello）がこのテストのliveのパス（TestTraceLive — 127.0.0.1のTCPで待ち受ける子プロセス）と
// handshake → "ping" → "echo:ping" → close_notify まで往復し、クライアントが送ったバイト列を testdata/tls/trace-<場合>.hex に、受けたバイト列の
// SHA-256とKeyLogWriterの4つのsecretをtestdata/tls/trace.goldenに書く。TestTrace（再生のパス）はクライアントのバイト列を偽の転送路で流し、
// サーバの出力のSHA-256・4つのsecret・受けた平文がゴールデンと一致するかを照合する（Goが受理したhandshakeのバイト列をSoberが決定的に再現できる =
// Go の検証〔署名・Finished・record の保護〕を通る出力だったことの証人）。場合 = aes（TLS_AES_128_GCM_SHA256）・chacha（サーバが ChaCha20-Poly1305 を
// 好む）・hrr（クライアントの key_share が P-256 だけ → HelloRetryRequest → 2 番目の ClientHello で X25519。Go 1.24 以降の crypto/tls は HRR を
// 起こせないので openssl s_client を中継して記録 — secretはopensslの -keylogfile と照合済み）。チャンクの無い機械（SOBER_NOAES=1）ではaes / hrrを飛ばす
//
//     out/stage2/sober2 test std/tls --run TestTraceLive --work /tmp/tt && (cd scripts/oracles && go run tls_trace.go /tmp/tt/t) > testdata/tls/trace.golden
//     （ゴールデンの取り直し — liveのパス。bin/soberは --work を自分の格納場所で上書きするのでstage2を直に）
//
// このファイルの test* の名前（証明書・記録・設定・連結）は hs_reject_test / hs_fsm_test と共用

import "std/crypto/aesgcm"
import "std/crypto/pem"
import "std/crypto/rsa"
import "std/crypto/sha256"
import "std/hex"
import "std/io"
import "std/iter"
import "std/net"
import "std/os"
import "std/strings"
import "std/internal/hs"
import "std/internal/record"

@embed("testdata/crypto/httparena-server.*")
const testCerts = map[string]string{}

@embed("testdata/tls/trace-*.hex")
const testTraces = map[string]string{}

@embed("testdata/tls/trace.golden")
const testTraceGolden = map[string]string{}

func testFile(fs map[string]string, p string) string {
    v := fs[p]
    if v != nil {
        return v
    }
    return ""
}

func testZeros(n int) []byte {
    mut o := mut []byte{}
    for i <- iter.Range(0, n) {
        o = append(o, byte(0))
    }
    return freeze(o)
}

// 場合 name のサーバの設定（証明書と鍵は HttpArena の試験用の対・乱数の源は固定の seed）
func testParams(name string) internal.hs.Params {
    cb, _ := crypto.pem.Parse(testFile(testCerts, "testdata/crypto/httparena-server.crt"))
    kb, _ := crypto.pem.Parse(testFile(testCerts, "testdata/crypto/httparena-server.key"))
    k, _ := crypto.rsa.ParsePKCS8(kb[0].der)
    suites := if name == "chacha" { []int{internal.record.ChaCha, internal.record.AesGcm} } else { []int{internal.record.AesGcm, internal.record.ChaCha} }
    return internal.hs.NewParams([][]byte{cb[0].der}, k, []string{"http/1.1"}, suites, bytes("sober-tls-trace-${name}"))
}

// 1 接続: record の枠を Feed に通し、送るものを send へ・受けた平文に "echo:" を付けて返す・相手の close_notify で close_notify を返して終わる。
// 印字の行（secret・受けた平文・閉じ方）を返す
func trServe(p internal.hs.Params, recv func(k func([]byte)) error?, send func(b []byte) error?) string {
    mut log := ""
    e := trLoop(p, recv, send, mut log)
    return if e == nil { log } else { "${log}error transport\n" }
}

func trLoop(p internal.hs.Params, recv func(k func([]byte)) error?, send func(b []byte) error?, log mut string) error? {
    mut h := internal.hs.New()
    for f <- internal.record.Frames(recv)? {
        o, e := internal.hs.Feed(mut h, p, f)
        if e != nil {
            d := trAlertDesc(e)
            _ = send(internal.hs.AlertRecord(mut h, d))
            log = "${log}error alert ${d}\n"
            return nil
        }
        send(o.send)?
        if o.done {
            log = "${log}secrets ${internal.hs.Secrets(h)}\nalpn ${internal.hs.Alpn(h)} suite ${internal.hs.Suite(h)}\n"
        }
        if len(o.app) > 0 {
            s, _ := string(o.app)
            log = "${log}app ${s}\n"
            r, _ := internal.hs.SealApp(mut h, testCat(bytes("echo:"), o.app))
            send(r)?
        }
        if o.closed {
            log = "${log}closed ${o.peer}\n"
            send(internal.hs.CloseNotify(mut h))?
            return nil
        }
    }
    return nil
}

// Feed の誤りの alert の番号（switch を for の本体に直に書くと check だけが def error になる）
func trAlertDesc(e error?) int {
    return switch e {
        case nil: -1
        case internal.record.Alert{desc}: desc
    }
}

func testCat(a []byte, b []byte) []byte {
    mut o := mut []byte{}
    for c <- a {
        o = append(o, c)
    }
    for c <- b {
        o = append(o, c)
    }
    return freeze(o)
}

// sをsizeバイトずつkへ渡す偽の受けのインターフェース
func trFeed(s []byte, size int, k func([]byte)) error? {
    mut at := 0
    while at < len(s) {
        e := if at + size < len(s) { at + size } else { len(s) }
        mut c := mut []byte{}
        for i <- iter.Range(at, e) {
            c = append(c, s[i])
        }
        k(freeze(c))
        at = e
    }
    return nil
}

// 場合nameの記録を切片の大きさsizeで流し直した印字の節（サーバの出力はSHA-256に畳む — ゴールデンの節と同じ形）
func trReplay(name string, size int) string {
    c2s, _ := hex.Parse(testFile(testTraces, "testdata/tls/trace-${name}.hex"))
    mut acc := crypto.sha256.New()
    log := trServe(testParams(name), (k) => trFeed(c2s, size, k), (b) => trPut(mut acc, b))
    return "== ${name} (chunk ${size})\n${log}s2c ${hex.Format(crypto.sha256.Sum(acc))}\n"
}

func trPut(acc mut crypto.sha256.State, b []byte) error? {
    crypto.sha256.Write(mut acc, b)
    return nil
}

// 127.0.0.1のTCPの1接続（Goの比較用の実装が子プロセスとして叩く — 待ち受けのportを標準出力の1行目に・印字の行は標準エラーへ）
func trLive(name string) error? {
    for l <- net.Listen("127.0.0.1:0")? {
        io.WriteStdout(bytes("port ${net.Port(l)}\n"))?
        for c <- net.Accept(l)? {
            log := trServe(testParams(name), (k) => net.Recv(c, k), (b) => net.Send(c, b))
            io.WriteStderr(bytes(log))?
            break
        }
    }
    return nil
}

func TestTrace() {
    gold := testFile(testTraceGolden, "testdata/tls/trace.golden")
    mut bad := 0
    names := []string{"aes", "chacha", "hrr"}
    sizes := []int{65536, 7}
    for name <- names {
        if name == "chacha" || crypto.aesgcm.Available() {
            for size <- sizes {
                got := trReplay(name, size)
                if !strings.Contains(gold, got) {
                    println("trace ${name} (chunk ${size}) differs from testdata/tls/trace.golden:\n${got}")
                    bad += 1
                }
            }
        } else {
            println("trace ${name}: skipped (no hardware)")
        }
    }
    assert(bad == 0)
}

// ゴールデンの取り直しのliveのパス（scripts/oracles/tls_trace.goが子プロセスとして叩く — 場合の名前は環境変数SOBER_TLS_TRACE_LIVE）。
// 変数が無ければ何もしない（`sober test` の既定の走りでは空の通過）
func TestTraceLive() {
    v, _ := os.Getenv("SOBER_TLS_TRACE_LIVE")
    if v != nil {
        assert(trLive(v) == nil)
    }
}
