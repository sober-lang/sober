package tls

// std/internal/hsの拒否の検査（hsはstdの内側）: ClientHelloを組み立てて
// （偽の転送路で）Feed に通し、サーバが返す alert の番号を照合する。TLS 1.2 だけの ClientHello = protocol_version（70）・X25519 も PSS も共通の suite も
// 無い = handshake_failure（40）・圧縮・重複の拡張・同じname_typeが2つのserver_name・短い / ゼロの key_share・HRR の後も X25519 が無い = illegal_parameter（47）・ALPN の不一致 =
// no_application_protocol（120）・読めない = decode_error（50）・最初に application_data / CCS 2 枚 = unexpected_message（10）・改竄した record =
// bad_record_mac（20）・違う verify_data の Finished = decrypt_error（51）・長すぎる record = record_overflow（22）。最初に正しい ClientHello で
// サーバの flight が出る（WaitFin へ）ことも見る

import "std/crypto/pem"
import "std/crypto/rsa"
import "std/crypto/sha256"
import "std/crypto/x25519"
import "std/hex"
import "std/iter"
import "std/internal/hs"
import "std/internal/record"

func rjParams() internal.hs.Params {
    cb, _ := crypto.pem.Parse(testFile(testCerts, "testdata/crypto/httparena-server.crt"))
    kb, _ := crypto.pem.Parse(testFile(testCerts, "testdata/crypto/httparena-server.key"))
    k, _ := crypto.rsa.ParsePKCS8(kb[0].der)
    return internal.hs.NewParams([][]byte{cb[0].der}, k, []string{"http/1.1"}, []int{internal.record.AesGcm, internal.record.ChaCha}, bytes("sober-tls-reject"))
}

// 組み立てる ClientHello の形
type rjHello struct {
    versions []int      // supported_versions（空 = 拡張なし）
    groups []int        // supported_groups
    shareGroup int      // key_share の群（0 = key_share なし）
    share []byte
    sigs []int
    alpn []string
    suites []int
    comp []int
    dup bool            // supported_groups を 2 回
}

func rjGood() rjHello {
    return rjHello{versions: []int{0x0304}, groups: []int{0x001d}, shareGroup: 0x001d, share: crypto.x25519.Base(rjSeq(7, 32)), sigs: []int{0x0804},
        alpn: []string{"http/1.1"}, suites: []int{0x1301, 0x1303}, comp: []int{0}, dup: false}
}

func rjSeq(from int, n int) []byte {
    mut o := mut []byte{}
    for i <- iter.Range(0, n) {
        o = append(o, byte((from + i) & 0xff))
    }
    return freeze(o)
}

func rjP8(o mut []byte, v int) {
    o = append(o, byte(v & 0xff))
}

func rjP16(o mut []byte, v int) {
    o = append(o, byte((v >> 8) & 0xff))
    o = append(o, byte(v & 0xff))
}

func rjPb(o mut []byte, b []byte) {
    for c <- b {
        o = append(o, c)
    }
}

// 拡張 1 つ（型 ‖ 長さ ‖ 中身）
func rjExt(o mut []byte, t int, body []byte) {
    rjP16(mut o, t)
    rjP16(mut o, len(body))
    rjPb(mut o, body)
}

func rjU16list(xs []int, w1 bool) []byte {
    mut b := mut []byte{}
    if w1 {
        rjP8(mut b, 2 * len(xs))
    } else {
        rjP16(mut b, 2 * len(xs))
    }
    for x <- xs {
        rjP16(mut b, x)
    }
    return freeze(b)
}

// h の ClientHello の record（平文 — 頭 5 バイト込み）。cut > 0 なら本体を cut バイトで打ち切る
func rjClientHello(h rjHello, cut int) []byte {
    return rjClientHelloX(h, cut, []byte{})
}

// 拡張の列の先頭に、組み立て済みの拡張extra（型と長さの頭込み）を置いたClientHelloのrecord
func rjClientHelloX(h rjHello, cut int, extra []byte) []byte {
    mut x := mut []byte{}
    rjPb(mut x, extra)
    if len(h.versions) > 0 {
        rjExt(mut x, 43, rjU16list(h.versions, true))
    }
    rjExt(mut x, 10, rjU16list(h.groups, false))
    if h.dup {
        rjExt(mut x, 10, rjU16list(h.groups, false))
    }
    if h.shareGroup != 0 {
        mut ks := mut []byte{}
        rjP16(mut ks, 4 + len(h.share))
        rjP16(mut ks, h.shareGroup)
        rjP16(mut ks, len(h.share))
        rjPb(mut ks, h.share)
        rjExt(mut x, 51, freeze(ks))
    }
    rjExt(mut x, 13, rjU16list(h.sigs, false))
    if len(h.alpn) > 0 {
        mut al := mut []byte{}
        for a <- h.alpn {
            rjP8(mut al, len(bytes(a)))
            rjPb(mut al, bytes(a))
        }
        mut ab := mut []byte{}
        rjP16(mut ab, len(al))
        rjPb(mut ab, freeze(al))
        rjExt(mut x, 16, freeze(ab))
    }
    mut b := mut []byte{}
    rjP16(mut b, 0x0303)
    rjPb(mut b, rjSeq(1, 32))
    rjP8(mut b, 32)
    rjPb(mut b, rjSeq(100, 32))
    rjP16(mut b, 2 * len(h.suites))
    for s <- h.suites {
        rjP16(mut b, s)
    }
    rjP8(mut b, len(h.comp))
    for c <- h.comp {
        rjP8(mut b, c)
    }
    rjP16(mut b, len(x))
    rjPb(mut b, freeze(x))
    body := freeze(b)
    n := if cut > 0 { cut } else { len(body) }
    mut m := mut []byte{}
    rjP8(mut m, 1)
    rjP8(mut m, 0)
    rjP16(mut m, n)
    for i <- iter.Range(0, n) {
        m = append(m, body[i])
    }
    return rjRec(22, freeze(m))
}

// 平文の record
func rjRec(ct int, body []byte) []byte {
    mut o := mut []byte{}
    rjP8(mut o, ct)
    rjP16(mut o, 0x0303)
    rjP16(mut o, len(body))
    rjPb(mut o, body)
    return freeze(o)
}

func rjFeed(s []byte, k func([]byte)) error? {
    k(s)
    return nil
}

func rjDesc(e error?) int {
    return switch e {
        case nil: 0
        case internal.record.Alert{desc}: desc
        case internal.record.Transport{}: -1
    }
}

// s を 1 切片で流して、最初の誤りの alert の番号（無ければ 0）と送ったバイト数と接続の状態を返す
func rjRun(s []byte) (int, int, bool) {
    mut h := internal.hs.New()
    mut sent := 0
    mut d := 0
    e := rjFrames(s, mut h, mut sent, mut d)
    if e != nil {
        d = rjDesc(e)
    }
    return d, sent, internal.hs.IsConnected(h)
}

func rjFrames(s []byte, h mut internal.hs.Hs, sent mut int, d mut int) error? {
    p := rjParams()
    for f <- internal.record.Frames((k) => rjFeed(s, k))? {
        o, e := internal.hs.Feed(mut h, p, f)
        if e != nil {
            d = rjDesc(e)
            return nil
        }
        sent += len(o.send)
    }
    return nil
}

// 正しい ClientHello の後の、client handshake traffic secret の鍵で封じた Finished（verify_data = vd）
func rjBadFin(ch []byte) []byte {
    return rjSealed(ch, internal.record.CtHandshake, rjFin(32), 0)
}

// verify_dataがnバイトのFinishedのメッセージ（中身は検査用の固定の列）
func rjFin(n int) []byte {
    mut m := mut []byte{}
    rjP8(mut m, 20)
    rjP8(mut m, 0)
    rjP16(mut m, n)
    rjPb(mut m, rjSeq(9, n))
    return freeze(m)
}

// 正しいClientHelloの後の、client handshake traffic secretの鍵で封じたrecord 1つ（内容の型ct・中身body・0埋めpadバイト）
func rjSealed(ch []byte, ct int, body []byte, pad int) []byte {
    mut h := internal.hs.New()
    mut sent := 0
    mut d := 0
    _ = rjFrames(ch, mut h, mut sent, mut d)
    sec, _ := hex.Parse(rjFirstWord(internal.hs.Secrets(h)))
    mut w, _ := internal.record.NewDir(internal.record.AesGcm, sec)
    return internal.record.Seal(mut w, ct, body, pad)
}

func rjFirstWord(s string) string {
    b := bytes(s)
    mut i := 0
    while i < len(b) && b[i] != ' ' {
        i += 1
    }
    w, _ := string(b[0:i])
    return w
}

// sのoffバイト目をvに替えたコピー
func rjPatch(s []byte, off int, v int) []byte {
    mut o := mut []byte{}
    for i <- iter.Range(0, len(s)) {
        o = append(o, if i == off { byte(v) } else { s[i] })
    }
    return freeze(o)
}

// server_nameの拡張（型 0）。names = (name_type, 名前) の列。listLen < 0 ならリストの長さを中身から数える。tail = リストの後ろに足す余りのバイト
func rjSni(types []int, names []string, listLen int, tail []byte) []byte {
    mut l := mut []byte{}
    for i <- iter.Range(0, len(types)) {
        rjP8(mut l, types[i])
        rjP16(mut l, len(bytes(names[i])))
        rjPb(mut l, bytes(names[i]))
    }
    mut b := mut []byte{}
    rjP16(mut b, if listLen < 0 { len(l) } else { listLen })
    rjPb(mut b, freeze(l))
    rjPb(mut b, tail)
    mut x := mut []byte{}
    rjExt(mut x, 0, freeze(b))
    return freeze(x)
}

// early_dataの拡張（中身は空）
func rjEarly() []byte {
    return []byte{0, 42, 0, 0}
}

// cookieの拡張（中身 = rjParamsの乱数の源から作るcookie。サーバーのHelloRetryRequestと同じ値）
func rjCookie() []byte {
    c := crypto.sha256.Sum256(testCat(bytes("sober-tls-reject"), bytes("cookie")))
    mut b := mut []byte{}
    rjP16(mut b, len(c))
    rjPb(mut b, c)
    mut x := mut []byte{}
    rjExt(mut x, 44, freeze(b))
    return freeze(x)
}

// 外側の型がapplication_dataの平文のrecordをn個（本体はそれぞれsize バイト — 0-RTTのデータの代わり）
func rjEarlyRecs(n int, size int) []byte {
    mut o := []byte{}
    for i <- iter.Range(0, n) {
        o = testCat(o, rjRec(23, testZeros(size)))
    }
    return o
}

// 拒否の場合 1 つ（名前・流すバイト列・期待する alert の番号）
type rjCase struct {
    name string
    s []byte
    want int
}

func TestReject() {
    g := rjGood()
    ok := rjClientHello(g, 0)
    d0, sent, _ := rjRun(ok)
    assert(d0 == 0 && sent > 0)
    // server_nameは構文だけを見る。正しい形なら名前が証明書と合わなくても続ける
    dn, sentn, _ := rjRun(rjClientHelloX(g, 0, rjSni([]int{0}, []string{"example.invalid"}, 0 - 1, []byte{})))
    assert(dn == 0 && sentn > 0)
    // early_dataつきのClientHelloにはcookieつきのHelloRetryRequestを返し、0-RTTのデータを上限（2 × MaxCipher）まで読み飛ばして、2番目のClientHelloで続ける
    ch1e := rjClientHelloX(g, 0, rjEarly())
    ch2c := rjClientHelloX(g, 0, rjCookie())
    de, sente, _ := rjRun(testCat(ch1e, testCat(rjEarlyRecs(2, internal.record.MaxCipher), ch2c)))
    assert(de == 0 && sente > 0)
    noShare := rjHello{versions: g.versions, groups: []int{0x0017, 0x001d}, shareGroup: 0x0017, share: rjSeq(4, 65), sigs: g.sigs, alpn: g.alpn, suites: g.suites, comp: g.comp, dup: false}
    cases := []rjCase{
        rjCase{name: "tls12", s: rjClientHello(rjHello{versions: []int{}, groups: g.groups, shareGroup: g.shareGroup, share: g.share, sigs: g.sigs, alpn: g.alpn, suites: g.suites, comp: g.comp, dup: false}, 0), want: 70},
        rjCase{name: "nogroup", s: rjClientHello(rjHello{versions: g.versions, groups: []int{0x0017}, shareGroup: 0x0017, share: rjSeq(4, 65), sigs: g.sigs, alpn: g.alpn, suites: g.suites, comp: g.comp, dup: false}, 0), want: 40},
        rjCase{name: "nosuite", s: rjClientHello(rjHello{versions: g.versions, groups: g.groups, shareGroup: g.shareGroup, share: g.share, sigs: g.sigs, alpn: g.alpn, suites: []int{0x1302}, comp: g.comp, dup: false}, 0), want: 40},
        rjCase{name: "nosig", s: rjClientHello(rjHello{versions: g.versions, groups: g.groups, shareGroup: g.shareGroup, share: g.share, sigs: []int{0x0403}, alpn: g.alpn, suites: g.suites, comp: g.comp, dup: false}, 0), want: 40},
        rjCase{name: "comp", s: rjClientHello(rjHello{versions: g.versions, groups: g.groups, shareGroup: g.shareGroup, share: g.share, sigs: g.sigs, alpn: g.alpn, suites: g.suites, comp: []int{1}, dup: false}, 0), want: 47},
        rjCase{name: "dup", s: rjClientHello(rjHello{versions: g.versions, groups: g.groups, shareGroup: g.shareGroup, share: g.share, sigs: g.sigs, alpn: g.alpn, suites: g.suites, comp: g.comp, dup: true}, 0), want: 47},
        rjCase{name: "alpn", s: rjClientHello(rjHello{versions: g.versions, groups: g.groups, shareGroup: g.shareGroup, share: g.share, sigs: g.sigs, alpn: []string{"h2"}, suites: g.suites, comp: g.comp, dup: false}, 0), want: 120},
        rjCase{name: "short", s: rjClientHello(g, 40), want: 50},
        rjCase{name: "share31", s: rjClientHello(rjHello{versions: g.versions, groups: g.groups, shareGroup: g.shareGroup, share: rjSeq(1, 31), sigs: g.sigs, alpn: g.alpn, suites: g.suites, comp: g.comp, dup: false}, 0), want: 47},
        rjCase{name: "zero", s: rjClientHello(rjHello{versions: g.versions, groups: g.groups, shareGroup: g.shareGroup, share: testZeros(32), sigs: g.sigs, alpn: g.alpn, suites: g.suites, comp: g.comp, dup: false}, 0), want: 47},
        rjCase{name: "hrr-again", s: testCat(rjClientHello(noShare, 0), rjClientHello(noShare, 0)), want: 47},
        rjCase{name: "app-early", s: rjRec(23, rjSeq(0, 20)), want: 10},
        rjCase{name: "ccs2", s: testCat(ok, testCat(rjRec(20, []byte{1}), rjRec(20, []byte{1}))), want: 10},
        rjCase{name: "tamper", s: testCat(ok, rjRec(23, rjSeq(3, 40))), want: 20},
        rjCase{name: "badfin", s: testCat(ok, rjBadFin(ok)), want: 51},
        rjCase{name: "overflow", s: []byte{22, 3, 3, byte(0x41), byte(0x01)}, want: 22},
        rjCase{name: "inner-overflow", s: testCat(ok, rjSealed(ok, internal.record.CtHandshake, rjFin(32), 16587)), want: 22},
        rjCase{name: "plain-overflow", s: rjRec(22, testZeros(16385)), want: 22},
        rjCase{name: "legacy-version", s: rjPatch(ok, 10, 1), want: 70},
        rjCase{name: "groups-empty", s: rjClientHello(rjHello{versions: g.versions, groups: []int{}, shareGroup: g.shareGroup, share: g.share, sigs: g.sigs, alpn: g.alpn, suites: g.suites, comp: g.comp, dup: false}, 0), want: 50},
        rjCase{name: "sigs-empty", s: rjClientHello(rjHello{versions: g.versions, groups: g.groups, shareGroup: g.shareGroup, share: g.share, sigs: []int{}, alpn: g.alpn, suites: g.suites, comp: g.comp, dup: false}, 0), want: 50},
        rjCase{name: "share-empty-key", s: rjClientHello(rjHello{versions: g.versions, groups: g.groups, shareGroup: g.shareGroup, share: []byte{}, sigs: g.sigs, alpn: g.alpn, suites: g.suites, comp: g.comp, dup: false}, 0), want: 50},
        rjCase{name: "alpn-empty-name", s: rjClientHello(rjHello{versions: g.versions, groups: g.groups, shareGroup: g.shareGroup, share: g.share, sigs: g.sigs, alpn: []string{""}, suites: g.suites, comp: g.comp, dup: false}, 0), want: 50},
        rjCase{name: "share-missing", s: rjClientHello(rjHello{versions: g.versions, groups: g.groups, shareGroup: 0, share: []byte{}, sigs: g.sigs, alpn: g.alpn, suites: g.suites, comp: g.comp, dup: false}, 0), want: 109},
        rjCase{name: "alert-empty", s: testCat(ok, rjSealed(ok, internal.record.CtAlert, []byte{}, 0)), want: 10},
        rjCase{name: "sni-empty-list", s: rjClientHelloX(g, 0, rjSni([]int{}, []string{}, 0 - 1, []byte{})), want: 50},
        rjCase{name: "sni-empty-name", s: rjClientHelloX(g, 0, rjSni([]int{0}, []string{""}, 0 - 1, []byte{})), want: 50},
        rjCase{name: "sni-trailing", s: rjClientHelloX(g, 0, rjSni([]int{0}, []string{"localhost"}, 0 - 1, []byte{0})), want: 50},
        rjCase{name: "sni-list-long", s: rjClientHelloX(g, 0, rjSni([]int{0}, []string{"localhost"}, 13, []byte{})), want: 50},
        rjCase{name: "sni-dup-type", s: rjClientHelloX(g, 0, rjSni([]int{0, 0}, []string{"a.example", "b.example"}, 0 - 1, []byte{})), want: 47},
        rjCase{name: "early-skip-over", s: testCat(ch1e, testCat(rjEarlyRecs(2, internal.record.MaxCipher), rjEarlyRecs(1, 1))), want: 10},
        rjCase{name: "early-ch2-nocookie", s: testCat(ch1e, rjClientHello(g, 0)), want: 47},
        rjCase{name: "early-ch2-badcookie", s: testCat(ch1e, rjClientHelloX(g, 0, rjPatch(rjCookie(), 10, 0xff))), want: 47},
        rjCase{name: "early-ch2-early", s: testCat(ch1e, rjClientHelloX(g, 0, testCat(rjCookie(), rjEarly()))), want: 47},
        rjCase{name: "early-nonempty", s: rjClientHelloX(g, 0, []byte{0, 42, 0, 1, 0}), want: 50},
        rjCase{name: "app-after-hrr", s: testCat(rjClientHello(noShare, 0), rjEarlyRecs(1, 10)), want: 10},
        rjCase{name: "fin-short", s: testCat(ok, rjSealed(ok, internal.record.CtHandshake, rjFin(31), 0)), want: 50},
    }
    mut bad := 0
    for c <- cases {
        d, _, _ := rjRun(c.s)
        if d != c.want {
            println("reject ${c.name}: alert ${d}, want ${c.want}")
            bad += 1
        }
        println("conf-item: tls/reject ${c.name} ${c.want}")
    }
    assert(bad == 0)
    println("conf: tls/reject ${len(cases)}")
}

// handshakeの受けは、内容の型がTLSのrecordのどれでもない先頭の1バイトで拒否する（頭と本体を待たない）
func TestFrameType() {
    assert(frameLen([]byte{0x80}, 0) == 0 - 2)
    assert(frameLen([]byte{0x80, 0x2e, 1, 3, 4}, 0) == 0 - 2)
    assert(frameLen([]byte{22}, 0) == 0)
    assert(frameLen([]byte{22, 3, 3, 0, 1, 7}, 0) == 6)
    assert(frameLen([]byte{19, 3, 3, 0, 1, 7}, 0) == 0 - 2)
    assert(frameLen([]byte{24, 3, 3, 0, 1, 7}, 0) == 0 - 2)
}
