package tls

// TLS 1.3 のサーバ（RFC 9846 — X25519・AES-128-GCM / ChaCha20-Poly1305・RSA-PSS の証明書・resumption / 0-RTT なし）。
// tls.Serve(addr, cfg, k) が net.Serve を包み、handshake が済んだ接続だけを k に渡す（handshake 中の接続を利用者に触らせない）。
// kへ渡す接続はTLSの状態を持つnet.Conn（net.Recv / net.Send / net.Put / net.Flushが暗号化して読み書きする — 平文の接続と同じ関数・同じ規則。
// breakで抜けた後も、次のnet.Recvが続きを読む）。受けの誤りはnetのラベル（相手のfatal alert・閉じた後 = io.Closed・壊れたrecord = io.Other{errno: 71}）。
// handshakeの誤り（HandshakeFailed〔alertの種はフィールド〕・Closed）はServeの中で吸収する（alertを送って閉じ、kは呼ばない）。
// 信頼の起点の値 Roots（ParseRoots が作る — 私的 PKI の CA を足すとき std/http/client の Policy の extraRoots: に渡す）もここに住む

// 接続の状態（送りの鍵と seq・受けた KeyUpdate の要求・handshake の残りのバイト）は値の外 — 接続の task の region に 1 回作る int の列（blk）に住み、
// net.Recv / net.Sendが状態の辞書（internal.sec.State — std/tlsの名前つきの関数）を通して、rtのインターフェース（lease_view / lease_op — std/pool・std/taskの
// leaseと同じ鍵）で読み書きする（net.ConnのTCPのseqがカーネルにあるのと同じ形。同一性の型の規則が隠れた可変を観測できなくする）

import "std/crypto/pem"
import "std/crypto/rsa"
import "std/io"
import "std/net"
import "std/strings"
import "std/internal/hs"
import "std/internal/p256"
import "std/internal/x509"
import "std/internal/record"
import "std/internal/mux"
import "std/internal/sec"

// handshake が失敗した（alert = 送った alert の番号 — RFC 9846 6）
type HandshakeFailed error {
    alert int
}

// handshakeの途中で接続が閉じた（相手の切断・転送路の失敗）
type Closed error

// サーバの設定（Load / Parseが作る — 証明書のチェーン・葉の鍵・受けるALPN）
type Config struct {
    chain [][]byte
    key crypto.rsa.PrivateKey
    ec []byte // 葉の鍵が P-256 の ECDSA ならそのスカラー（空 = key の RSA）
    alpn []string
    allow12 bool
}

// 足す信頼の起点（ParseRoots が作る — 封の型。中身は読めた CERTIFICATE の列）
type Roots struct {
    certs []internal.x509.Cert
    seal rootsSeal
}

type rootsSeal struct {
}

// ParseRootsのPEMが読めない（CERTIFICATEのチャンクが無い・チャンクのDERが証明書の形でない）
type BadRoots error

// handshake の済んだ接続 1 本の処理（名前つきの関数型 — 値として接続の task へ渡る。language.md 14 節: 公開境界の関数型は名前つき）。
// 接続はTLSの状態を持つnet.Conn（net.Recv / net.Send / net.Put / net.Flushが暗号化して読み書きする）
type Handler func(c net.Conn) error?

// ストレージの列の形: [旗, 持ち越しのバイト数L, 送りの方向 × dirW, 受けの方向 × dirW, 組み立て中のhandshakeのバイト列, 持ち越しの席の番地, 席を置く深度,
// handshakeの残りのバイト（8バイト / ワード）]。
// 持ち越し = 受けた切片をまたぐrecordの前半。最初はhandshakeの残り（列の末尾）に置き、そこに入らない持ち越しが出たときだけ、1 record分（頭 + MaxFrame）の
// 席を格納場所と同じ深度に1回確保する（lease_op 12 — 切片をまたぐ接続だけが払う）。席は接続の寿命いっぱい残り、breakの後のRecvが続きを読む
const fLeft = 1
const fFlags = 0
const fWr = 2
const dirW = 80
const fRd = 2 + 80
const fHb = 2 + 80 + 80
const fSeat = 2 + 80 + 80 + 1
const fBytes = 2 + 80 + 80 + 3
const carryCap = internal.record.HeadSize + internal.record.MaxFrame
const carryW = (carryCap + 7) / 8

// 送信バッファは接続ごとに持たない。net.Putはrecordをワーカーの作業の列へSealし、rtがワーカーの送信バッファのチャンクの続きへコピーする（net_op 12）。
// チャンクは接続が1つ予約する。net.Flushは予約のチャンクのSENDを積み、送りの完了を待つ（net_op 13）。呼び手は平文のregionを閉じてからFlushを呼ぶので、
// 送りの完了を待つ間もレスポンスの作業のregionを抱えない。std/http/serverのServeConnが受けの前に印（lease_op 10）を置いたときだけ、受けの中のFlush（nw = 1）は
// 完了を待たずに戻り、送りの結果は接続の次の受け・送り・閉じが返す（平文の送信バッファリングと同じ。公開のnet.Flush・net.Sendは印を見ない）。
// チャンクの大きさ = sinkCap。recordがこれを越えるbと、予約できないときは、積んだ分を送ってからその場で送る
const sinkCap = 16384

// Sealの作業の列（ワーカーごとにsinkCapバイト。Serveが1回作り、接続のtaskへ捕獲で渡る）: Putはrecordをここへ書き、rtが予約のチャンクへコピーする。
// 書いてからコピーするまでの間にスリープしないので、同じワーカーの他のtaskと重ならない
const workW = sinkCap / 8

func workNew() []int {
    nw := leaseOp(0, []int{}, 0, 0)
    mut b := mut []int{}
    mut i := 0
    while i < nw * workW {
        b = append(b, 0)
        i += 1
    }
    return freeze(b)
}

// 旗のビット
const bUpdate = 1   // 相手が KeyUpdate で update_requested を送った（次の送りが先に自分の KeyUpdate を送る）
const bRead = 2     // 使わない（旧いtls.Recvの1度きりの読みの印 — ビットの位置は空けておく）
const bDead = 4     // 受けを閉じた（alertを送った・受けた。相手のclose_notifyを含む。以後の受けは終わり）
const bRekey = 8    // 送りの鍵をKeyUpdateで進めた（状態のwrはhandshakeの鍵のまま — 以後の送りは格納場所の列から展開し直す）
const bFatal = 16   // fatalのalertを送った・受けた（bDeadも立つ。相手のclose_notifyでは立たない。以後の送りはio.Closed）
const bH2 = 32      // ALPNでh2に決まった（handshakeが置く・以後変わらない）
const bH11 = 64     // ALPNでhttp/1.1に決まった（同上）
const bEof = 128    // 相手のclose_notifyかFINを受けた（net.Recvの以後の読みは列の終わり）
const bBad = 256    // 壊れたrecordでalertを送った（net.Recvの結果をまだ返していない）

// ── 設定 ──

// PEMの証明書のチェーン（CERTIFICATEが1つ以上 — 葉が先頭）とPKCS#8の鍵のConfig（ALPNの既定 = http/1.1 — 変えるならAlpn）。
// 鍵は RSA か P-256 の ECDSA で、種類から署名とTLS 1.2のスイートの集合が決まる（ECDSA の鍵 = ECDHE-ECDSA のスイート・ecdsa_secp256r1_sha256）。どちらとしても読めなければ crypto.rsa.BadKey
@errors(crypto.pem.Bad, crypto.rsa.BadKey)
@effects()
func Parse(certPem string, keyPem string) (Config, error?) {
    cb := crypto.pem.Parse(certPem)?
    kb := crypto.pem.Parse(keyPem)?
    mut chain := mut [][]byte{}
    for b <- cb {
        if b.label == "CERTIFICATE" {
            chain = append(chain, b.der)
        }
    }
    if len(chain) == 0 || len(kb) == 0 {
        return emptyConfig(), crypto.pem.Bad{}
    }
    d, isEc := internal.p256.ParsePKCS8(kb[0].der)
    if isEc {
        k0, _ := crypto.rsa.ParsePKCS8([]byte{})
        return Config{chain: freeze(chain), key: k0, ec: d, alpn: []string{"http/1.1"}, allow12: false}, nil
    }
    k := crypto.rsa.ParsePKCS8(kb[0].der)?
    return Config{chain: freeze(chain), key: k, ec: []byte{}, alpn: []string{"http/1.1"}, allow12: false}, nil
}

// PEMの文字列pemのCERTIFICATEのチャンクを全部読んだ信頼の起点（私的PKIのCA — 外部ファイルを読むインターフェースは作らない。読めないチャンクが1つでもあればBadRoots）
@errors(BadRoots)
@effects()
func ParseRoots(pem string) (Roots, error?) {
    cs, err := internal.x509.RootsFromPEM(pem)
    if err != nil || len(cs) == 0 {
        return Roots{certs: []internal.x509.Cert{}, seal: rootsSeal{}}, BadRoots{}
    }
    return Roots{certs: cs, seal: rootsSeal{}}, nil
}

// 受ける ALPN をサーバの好みの順 alpn に替えた Config（空 = ALPN を使わない。相手の申し出と重ならなければ no_application_protocol — RFC 7301）
@effects()
func Alpn(cfg Config, alpn []string) Config {
    return Config{chain: cfg.chain, key: cfg.key, ec: cfg.ec, alpn: alpn, allow12: cfg.allow12}
}

// TLS 1.2 のクライアントも受ける Config（既定は 1.3 だけ）。古いクライアント（Windows 7 / 8.1 の IE 11・古い Safari・Java 7 / 8・Android 4.4 ほか）を繋ぐための opt-in で、
// 1.3 を申し出る相手は今までどおり 1.3。1.2 の道は CBC（MAC-then-encrypt）と RSA 鍵交換（前方秘匿なし）のスイートを含む — 知られた攻撃の面は
// 定数時間の処理・暗黙の拒否・降格の番兵で塞ぐが、1.3 だけの既定より危うい面を持つことを、綴りの dangerously で呼び手に引き受けさせる。
// ALPN で h2 に決まった接続は ECDHE + AEAD のスイートだけ。再開・再交渉・圧縮・SSL 3.0〜TLS 1.1 は持たない
@effects()
func DangerouslyAllowTls12(cfg Config) Config {
    return Config{chain: cfg.chain, key: cfg.key, ec: cfg.ec, alpn: cfg.alpn, allow12: true}
}

// Parse のファイル版（certPath / keyPath を読む）
@errors(crypto.pem.Bad, crypto.rsa.BadKey, strings.BadUtf8, io.NotFound, io.Denied, io.Other, io.Timeout, io.Expired)
@effects(io, nondet)
func Load(certPath string, keyPath string) (Config, error?) {
    c := string(io.ReadFile(certPath)?)?
    k := string(io.ReadFile(keyPath)?)?
    return Parse(c, k)
}

func emptyConfig() Config {
    k, _ := crypto.rsa.ParsePKCS8([]byte{})
    return Config{chain: [][]byte{}, key: k, ec: []byte{}, alpn: []string{}, allow12: false}
}

// ── 待ち受け ──

// addr で待ち受け、接続ごとに handshake を済ませてから k を走らせる（接続 1 本 = task 1 本 — net.Serve と同じ admission・k の失敗と死は吸収）。
// handshake の失敗は alert を送って閉じ、k は呼ばない。k が返ったら（error を返しても）close_notify を送って閉じる。k が死んだときは close_notify を送らずに閉じる
// conns・reject・regionはnet.Serveへそのまま（意味も既定もnet.Serveと同じ）。budgetは接続1本の宣言（既定 64 KiB）にwaitStackを足してnet.Serveへ渡す。
// headWait = 接続を受けてからhandshakeが済むまでの上限（task.MS・既定30秒・0以下は開いた時点で期限切れ）。期限が来たら何も送らずに閉じ、kは呼ばない。
// kの中のhttp.server.ServeConnは、入った時刻から自分のheadWait: を数える（handshakeの分は数えない）
@errors(net.Bad, io.Closed, io.Timeout, io.Expired, io.Denied, io.Other)
@effects(block, io, panic, nondet, Handler)
func Serve(addr string, cfg Config, k Handler, budget int?, conns int?, reject string?, region int?, headWait int?) error? {
    wk := workNew()
    hu := waitUnits(if headWait != nil { headWait } else { 30000 * 1000000 })
    // 閉じの送りの期限の送りの間隔のビット（headWaitと同じ単位の数。上限は16ビット）。分岐は accept（定数時間の検査の対象 — ctcheck）の外で
    hiv := (if hu < 65535 { hu } else { 65535 }) * 4294967296
    for l <- net.Listen(addr)? {
        // 接続ごとのhandshakeとk。本体（ページ0の余白）に展開して、接続の状態をkの間ずっとエリアの上の枠に置かない。
        // TLSの接続はkの中で深く待つので、エリアの上の枠の分だけ待っている接続のスタックが深くなる。ラムダの中のreturnは囲むServeから返る（非局所return）ので、
        // 結果はブロックの値で返す。handshakeの作業域はhandshakeのregionに置き、kを呼ぶ前に返す（格納場所の列だけが外へコピーされる）
        net.Serve(l, (nc) => {
            blk, oe := open(nc, cfg, hu)
            if oe != nil {
                oe
            } else {
                s := stateOf(blk, wk)
                // 持ち越しの席を置く深度 = 格納場所の深度（この本体の深度 — kの間ずっと生きている）
                _ = leaseOp(5, s.st.blk, fSeat + 1, leaseOp(11, []int{}, 0, 0))
                ke := net.Secure(nc, s, (c) => k(c))
                closeOut(s.st, nc.fd, hu, hiv)
                ke
            }
        }, budget: (if budget != nil { budget } else { 64 * 1024 }) + waitStack, conns: conns, reject: reject, region: if region != nil { region } else { 128 * 1048576 })?
    }
    return nil
}

// TLSの接続のtaskが、taskの固定費（task.Fixed() = TCBのページとスタックの1ページ）の外で常駐させるスタックの量。平文の接続は受けの待ちが本体の中にあり、
// 待つ間はエリアを持たない。TLSの接続は握手とkの中（関数の値なので本体に展開されない）で待つので、エリアを持ったまま待ち、触ったスタックのページが残る。
// 値 = 接続のtaskの最深のスタック（stackcheckのTLSの経路のstack_hw）が TCB_TOP_ROOM + 1ページ を越える分をページに切り上げた量。stackcheckが照合する
const waitStack = 8192

// 待ちの時間（ns。task.MSの倍数）→ rtの粗い時刻の単位の数（std/http/serverのwaitUnitsと同じ。lower/rdl.sober）
func waitUnits(ns int) int {
    if ns <= 0 {
        return 0
    }
    if ns >= 1 << 59 {
        return 1 << 30
    }
    return ((ns + 536870911) >> 29) + 2
}

// handshakeを期限つきで済ませ、接続の格納場所の列を作る
func open(nc net.Conn, cfg Config, hu int) ([]int, error?) {
    // handshakeの期限（rtの期限の列へ入れて、受けの期限を置く。op 16 / 14 / 15）。handshakeが済んだら外す
    // 送りの間隔のビットは足さない: headWaitはhandshakeの全体に掛かる期限で、送りの進みで延ばすとhandshakeを引き延ばす相手を切れない
    _ = sysNetOp(16, nc.fd, 0, 0)
    _ = sysNetOp(14, sysNetOp(15, 0, 0, 0) + hu, 0, 0)
    blk := handshake(nc, cfg)?
    _ = sysNetOp(14, 0, 0, 0)
    // handshakeの深い作業（署名・鍵の導出 — 1回きり）のページを返す: スロットのページはtaskの寿命いっぱい残るので、リクエストのパスより深い高水位が接続の常駐になる
    _ = leaseOp(6, []int{}, 0, 0)
    return blk, nil
}

// 格納場所の列から接続の状態（送りの方向はhandshakeの鍵のまま展開して持つ — Sendのたびに格納場所の列から鍵の素材をコピーし直さない。変わるのはseqのワードだけ）
func stateOf(blk []int, wk []int) internal.sec.State {
    fl := leaseOp(4, blk, fFlags, 0)
    // ALPNの旗はどちらか一方だけが立つ（bH2 = 1 << 5・bH11 = 1 << 6）: AlpnH2 = 2・AlpnH11 = 1・無ければAlpnNone = 0。分岐なしで組む（定数時間の関数の表 — ctcheck）
    alpn := ((fl >> 5) & 1) * internal.sec.AlpnH2 + ((fl >> 6) & 1) * internal.sec.AlpnH11
    return internal.sec.New(blk, internal.record.Unpack(freeze(leaseView(blk, fWr, dirW)), 0), wk, internal.sec.Ops{recv: recvNet, code: codeNet, put: putNet, flush: flushNet}, alpn)
}

// kの後: 積み残しとclose_notifyを送る
func closeOut(s internal.sec.Store, fd int, hu int, hiv int) {
    // 閉じの送りも相手の待ちで止まらないように、期限をもう1回分だけ置く。送りの間隔のビット hiv（Serve が headWait から組む）も足す — 積み残しの Flush と
    // close_notify の送りは、読み続ける相手には送りの進みで張り直して送り切る（読まない相手は間隔で切る）
    _ = sysNetOp(14, sysNetOp(15, 0, 0, 0) + hu + hiv, 0, 0)
    // 積み残し（Put の後に Flush しないで k が返った）を送ってから close_notify。
    // fatalのalertを送った・受けた接続には、その後に何も送らない（RFC 9846 6.2）。相手のclose_notifyの後は、積み残しを送ってからclose_notifyを返す（6.1）
    if (flags(s) & bFatal) == 0 {
        _ = flushMode(s, fd, 0)
        _ = internal.mux.SendBytes(fd, closeRecord(s))
    }
}

// 1接続のhandshake（handshakeのrecordは小さいので、切片をコピーしてバッファする）→ 格納場所の列（newBlk）。Connectedになった切片の残り
// （クライアントはFinishedと最初のリクエストを同じflightで送るのが普通）は格納場所の持ち越しに置く — kの中の受けが同じfdの続きを読む
@errors(HandshakeFailed, Closed)
func handshake(nc net.Conn, cfg Config) ([]int, error?) {
    p := internal.hs.ConfigParams(cfg.chain, cfg.key, cfg.ec, cfg.alpn, []int{internal.record.AesGcm, internal.record.ChaCha}, cfg.allow12)
    mut h := internal.hs.New()
    mut acc := []byte{}
    for chunk <- (net.Recv(nc)? Closed{}) {
        acc = cat(acc, chunk)
        mut at := 0
        mut n := frameLen(acc, at)
        while n > 0 {
            // 非対称の計算（ClientHelloへの返事のX25519と署名）を含みうるrecordの前に、ワーカーの署名の列で順番を待つ（rtの組み込み・op 31）。
            // 待つ間は実行待ちの列に並ばず、同じワーカーの他の接続の待ちに1回 約1 msの計算を足さない。期限（headWait）が過ぎたら何も送らずに閉じる
            if !internal.hs.Keyed(h) && int(acc[at]) == internal.record.CtHandshake && sysNetOp(31, 0, 0, 0) < 0 {
                return []int{}, Closed{}
            }
            o, e := internal.hs.Feed(mut h, p, internal.record.At(acc, at, n))
            if e != nil {
                d := alertOf(e)
                _ = net.Send(nc, internal.hs.AlertRecord(mut h, d))
                return []int{}, HandshakeFailed{alert: d}
            }
            if len(o.send) > 0 {
                net.Send(nc, o.send)? Closed{}
            }
            at += n
            if o.closed {
                return []int{}, Closed{}
            }
            if o.done {
                return newBlk(h, rest(acc, at)), nil
            }
            n = frameLen(acc, at)
        }
        if n < 0 {
            d := if n == 0 - 2 { internal.record.AlertUnexpected } else { internal.record.AlertOverflow }
            _ = net.Send(nc, internal.hs.AlertRecord(mut h, d))
            return []int{}, HandshakeFailed{alert: d}
        }
        acc = rest(acc, at)
    }
    return []int{}, Closed{}
}

// acc[at:]の先頭のrecordの長さ（頭込み）。0はまだ揃わない、−1は本体が上限を超える、−2は内容の型がTLSのrecordのどれでもない。
// 内容の型は先頭の1バイトで決まるので、頭と本体が揃うのを待たずに拒否する（SSL 2.0の形のClientHelloなどで、本体の長さの分を待ち続けない）
func frameLen(acc []byte, at int) int {
    if len(acc) - at >= 1 {
        t := int(acc[at])
        if t < internal.record.CtCcs || t > internal.record.CtApp {
            return 0 - 2
        }
    }
    if len(acc) - at < internal.record.HeadSize {
        return 0
    }
    body := int(acc[at + 3]) << 8 | int(acc[at + 4])
    if body > internal.record.MaxCipher {
        return 0 - 1
    }
    return if len(acc) - at < internal.record.HeadSize + body { 0 } else { internal.record.HeadSize + body }
}

// handshake の誤りの alert の番号
func alertOf(e error?) int {
    return switch e {
        case nil: internal.record.AlertInternal
        case internal.record.Alert{desc}: desc
    }
}

// handshakeの済んだhsの格納場所（送り / 受けの方向・handshakeの残りleft — 最初の持ち越し。Finishedの後のrecordの列で、揃ったrecordが複数並びうる）。
// 持ち越しの席の番地は0（未確保）、深度はacceptが置く
func newBlk(h internal.hs.Hs, left []byte) []int {
    rd, wr := internal.hs.Dirs(h)
    alpn := internal.hs.Alpn(h)
    mut b := mut []int{}
    b = append(b, if alpn == "h2" { bH2 } else if alpn == "http/1.1" { bH11 } else { 0 })
    b = append(b, len(left))
    putDir(mut b, internal.record.Pack(wr))
    putDir(mut b, internal.record.Pack(rd))
    b = append(b, 0)
    b = append(b, 0)
    b = append(b, 0)
    mut i := 0
    while i < len(left) {
        mut v := 0
        mut j := 0
        while j < 8 && i + j < len(left) {
            v = v | (int(left[i + j]) << (j * 8))
            j += 1
        }
        b = append(b, v)
        i += 8
    }
    return freeze(b)
}

// 方向のワードの列をdirWワードの席に（余りは0）
func putDir(b mut []int, w []int) {
    if len(w) > dirW {
        panic(Overflow{})
    }
    for v <- w {
        b = append(b, v)
    }
    mut i := len(w)
    while i < dirW {
        b = append(b, 0)
        i += 1
    }
}

// 方向のワードの列が席に入らない（stdの内部の約束違反 — panicラベル）
type Overflow panic

// ── 受け ──

// net.Connの受け（sec.Opsのrecv）: 受けた切片bを持ち越しと合わせてrecordに切り、揃ったrecordを受けの表に通して平文を返す。
// 切片の中の平文が1 recordなら開いた列のまま、2つ以上なら繋いだコピー。recordをまたぐ前半は格納場所の持ち越しの席へ写す。
// 受けの方向は格納場所から作り直し、seq（と、KeyUpdateの後は方向の全体）を書き戻す。fin = 相手のFIN（bは空 — 持ち越しが残っていればdecode_error）
func recvNet(s internal.sec.Store, fd int, b []byte, fin bool) []byte {
    fl := flags(s)
    if (fl & (bEof | bDead)) != 0 {
        return []byte{}
    }
    pn0 := leaseOp(4, s.blk, fLeft, 0)
    if fin {
        if pn0 > 0 {
            return dieNet(s, fd, internal.record.AlertDecode)
        }
        setFlags(s, fl | bEof)
        return []byte{}
    }
    // 受けの方向は格納場所から作り直す（鍵の素材は格納場所の view のまま — 写すと受けの1回ごとの固定費になる）。アプリのデータの record は record の層だけで
    // 開き、それ以外（KeyUpdate・alert・handshake の断片）が来たときか、組み立て中の handshake のバイト列があるときだけ、その record から handshake の表
    // （hs.Step — Connected の受けの表）に渡す（hv = 0 か 1 要素。作るのは要るときだけ）
    mut rd := internal.record.UnpackView(view(s, fRd, dirW), bview(s, fRd, dirW), 0)
    hb0 := hbufOf(s)
    mut hv := if len(hb0) > 0 { []internal.hs.Hs{internal.hs.ResumeWith(rd, hb0)} } else { []internal.hs.Hs{} }
    // 本文の長さの上限（受けの鍵の種類 — 1.2 は 2^14 + 2048・1.3 は 2^14 + 256）
    lim := internal.record.BodyMax(leaseOp(4, s.blk, fRd, 0))
    // 持ち越しの置き場（席があれば席・無ければhandshakeの残りの列 — 入らなくなったら席を確保して写す）はhelperが毎回引く（carryTo・pendAt・pendCopy・pendShift）
    mut pn := pn0
    mut out := []byte{}
    mut napp := 0
    mut keyed := false
    mut at := 0
    mut go := true
    while go {
        // 次に通す枠（fl < 0 = 無し）
        mut fb := b
        mut fo := 0
        mut fl2 := 0 - 1
        if pn > 0 {
            // 持ち越しがあれば、まず 1 record を揃える（頭を揃えてから本体）
            if pn < internal.record.HeadSize {
                m := imin(internal.record.HeadSize - pn, len(b) - at)
                carryTo(s, pn, b, at, m)
                pn += m
                at += m
            }
            if pn >= internal.record.HeadSize {
                body := pendAt(s, 3) << 8 | pendAt(s, 4)
                if body > lim {
                    return dieNet(s, fd, internal.record.AlertOverflow)
                }
                want := internal.record.HeadSize + body
                if pn >= want {
                    // 置き場に揃ったrecord（handshakeの残りが複数のrecordを持つときは、先頭の1つ）
                    fb = pendCopy(s, want)
                    fl2 = want
                    pendShift(s, want, pn)
                    pn -= want
                } else {
                    m := imin(want - pn, len(b) - at)
                    carryTo(s, pn, b, at, m)
                    pn += m
                    at += m
                    if pn == want {
                        fb = pendCopy(s, want)
                        fl2 = want
                        pn = 0
                    }
                }
            }
            go = fl2 >= 0
        } else if at < len(b) {
            mut whole := false
            if len(b) - at >= internal.record.HeadSize {
                body := int(b[at + 3]) << 8 | int(b[at + 4])
                if body > lim {
                    return dieNet(s, fd, internal.record.AlertOverflow)
                }
                whole = len(b) - at >= internal.record.HeadSize + body
                if whole {
                    fo = at
                    fl2 = internal.record.HeadSize + body
                    at += fl2
                }
            }
            if !whole {
                m := len(b) - at
                carryTo(s, pn, b, at, m)
                pn += m
                at += m
                go = false
            }
        } else {
            go = false
        }
        mut fast := false
        if fl2 >= 0 && len(hv) == 0 && int(fb[fo]) != internal.record.CtCcs {
            rd0 := rd
            ict, pt, e := internal.record.Open(mut rd, internal.record.At(fb, fo, fl2))
            if e != nil {
                return dieNet(s, fd, alertOf(e))
            }
            if ict == internal.record.CtApp {
                out = if napp == 0 { pt } else { cat(out, pt) }
                napp += 1
                fast = true
            } else {
                // アプリのデータでない record: 開く前の方向から handshake の表に渡し直す（このrecordを2回開く — KeyUpdate・alertの時だけ）
                rd = rd0
            }
        }
        if fl2 >= 0 && !fast {
            // handshake の表の状態は初めて要るときに作る（CCS の record も、開かずにここへ来る）
            if len(hv) == 0 {
                hv = []internal.hs.Hs{internal.hs.ResumeWith(rd, hb0)}
            }
            h2, o, e := internal.hs.Step(hv[0], internal.record.At(fb, fo, fl2))
            hv = []internal.hs.Hs{h2}
            if e != nil {
                return dieNet(s, fd, alertOf(e))
            }
            if o.upd {
                setFlags(s, flags(s) | bUpdate)
            }
            if len(o.app) > 0 {
                out = if napp == 0 { o.app } else { cat(out, o.app) }
                napp += 1
            } else {
                // 平文の無いrecord（KeyUpdate・handshakeの断片・閉じ）— 受けの方向の全体を書き戻す
                keyed = true
            }
            if o.closed {
                setFlags(s, flags(s) | bDead | (if o.peer != 0 { bFatal } else { bEof }))
                go = false
            }
        }
    }
    mut hb := hb0
    if len(hv) > 0 {
        rd2, hb2 := internal.hs.RecvState(hv[0])
        rd = rd2
        hb = hb2
    }
    // 組み立て中のhandshakeのメッセージ: 接続の後に受けるのはKeyUpdate（5バイト）だけなので、残るのは頭の4バイトの途中まで
    if len(hb) > 4 {
        return dieNet(s, fd, internal.record.AlertUnexpected)
    }
    putHbuf(s, hb)
    if keyed {
        if !writeDir(s, fRd, rd) {
            return dieNet(s, fd, internal.record.AlertInternal)
        }
    } else {
        _ = leaseOp(5, s.blk, fRd + 1, internal.record.Seq(rd))
    }
    _ = leaseOp(5, s.blk, fLeft, pn)
    return out
}

// 持ち越しの置き場のpn バイト目からchunk[at, at + m) を写す。置き場が足りなければ（handshakeの残りの列のとき）、席を確保して今の [0, pn) を写してから
func carryTo(s internal.sec.Store, pn int, chunk []byte, at int, m int) {
    if leaseOp(4, s.blk, fSeat, 0) == 0 && pn + m > (len(s.blk) - fBytes) * 8 {
        seatUp(s, pn)
    }
    if leaseOp(4, s.blk, fSeat, 0) != 0 {
        mut v := leaseAt(s.blk, fSeat, carryW * 8)
        carry(mut v, pn, chunk, at, m)
    } else {
        mut v := leaseBytes(s.blk, fBytes, (len(s.blk) - fBytes) * 8)
        carry(mut v, pn, chunk, at, m)
    }
}

// 持ち越しの席を確保し（接続で1回 — 格納場所の深度に。lease_op 12）、handshakeの残りの列の [0, pn) を写す
func seatUp(s internal.sec.Store, pn int) {
    _ = leaseOp(12, s.blk, fSeat, carryW)
    mut v := leaseAt(s.blk, fSeat, carryW * 8)
    mut i := 0
    while i < pn {
        v[i] = byte((leaseOp(4, s.blk, fBytes + i / 8, 0) >> ((i % 8) * 8)) & 0xff)
        i += 1
    }
}

// 持ち越しのiバイト目
func pendAt(s internal.sec.Store, i int) int {
    if leaseOp(4, s.blk, fSeat, 0) != 0 {
        v := leaseAt(s.blk, fSeat, carryW * 8)
        return int(v[i])
    }
    return (leaseOp(4, s.blk, fBytes + i / 8, 0) >> ((i % 8) * 8)) & 0xff
}

// 持ち越しの先頭nバイトのコピー（揃ったrecord — 受けの切片のregionに）。置き場（席か handshake の残りの列）を1回だけ引いて写す
// （バイトごとに pendAt で引き直すと、16 KiB 近い record で要求1件あたり数万回の lease_op になる）
func pendCopy(s internal.sec.Store, n int) []byte {
    if leaseOp(4, s.blk, fSeat, 0) != 0 {
        mut v := leaseAt(s.blk, fSeat, carryW * 8)
        return headCopy(mut v, n)
    }
    mut v := leaseBytes(s.blk, fBytes, (len(s.blk) - fBytes) * 8)
    return headCopy(mut v, n)
}

// pend[0, n) のコピー
func headCopy(pend mut []byte, n int) []byte {
    mut out := mut []byte{}
    mut i := 0
    while i < n {
        out = append(out, pend[i])
        i += 1
    }
    return freeze(out)
}

// 持ち越しの [at, pn) を先頭へ詰める
func pendShift(s internal.sec.Store, at int, pn int) {
    if leaseOp(4, s.blk, fSeat, 0) != 0 {
        mut v := leaseAt(s.blk, fSeat, carryW * 8)
        shift(mut v, at, pn)
    } else {
        mut v := leaseBytes(s.blk, fBytes, (len(s.blk) - fBytes) * 8)
        shift(mut v, at, pn)
    }
}

// pendの [at, pn) を先頭へ詰める
func shift(pend mut []byte, at int, pn int) {
    mut j := 0
    while at + j < pn {
        pend[j] = pend[at + j]
        j += 1
    }
}

// chunk[at, at + m) をpend[pn, pn + m) へ
func carry(pend mut []byte, pn int, chunk []byte, at int, m int) {
    mut j := 0
    while j < m {
        pend[pn + j] = chunk[at + j]
        j += 1
    }
}

func imin(a int, b int) int {
    return if a < b { a } else { b }
}

// fatalのalert descを送って閉じ、壊れたrecordの印を置く（codeが1回だけRecvBadで返す）。平文は無い
func dieNet(s internal.sec.Store, fd int, desc int) []byte {
    die(s, fd, desc)
    setFlags(s, flags(s) | bBad)
    return []byte{}
}

// net.Connの受けの結果（sec.Opsのcode）: 壊れたrecord（1回だけ）・相手の閉じ（close_notifyかFIN）・閉じた接続・続く
func codeNet(s internal.sec.Store) int {
    fl := flags(s)
    if (fl & bBad) != 0 {
        setFlags(s, fl & ^bBad)
        return internal.sec.RecvBad
    }
    return if (fl & bEof) != 0 { internal.sec.RecvEnd } else if (fl & bDead) != 0 { internal.sec.RecvClosed } else { internal.sec.RecvMore }
}

// 組み立て中のhandshakeのバイト列（格納場所のワード: 下位8ビット = 長さ・その上に4バイトまで）
func hbufOf(s internal.sec.Store) []byte {
    w := leaseOp(4, s.blk, fHb, 0)
    n := w & 0xff
    mut b := mut []byte{}
    mut i := 0
    while i < n {
        b = append(b, byte((w >> (8 + i * 8)) & 0xff))
        i += 1
    }
    return freeze(b)
}

func putHbuf(s internal.sec.Store, hb []byte) {
    mut w := len(hb)
    mut i := 0
    while i < len(hb) {
        w = w | (int(hb[i]) << (8 + i * 8))
        i += 1
    }
    _ = leaseOp(5, s.blk, fHb, w)
}

// ── 送り ──

// Putの本体（net.Connの送り — sec.Opsのput）。0 = 積んだか送った・−1 = 閉じた
func putNet(s internal.sec.Store, fd int, b []byte) int {
    fl := flags(s)
    if (fl & bFatal) != 0 {
        return 0 - 1
    }
    if len(b) == 0 {
        return 0
    }
    if (fl & (bUpdate | bRekey)) == 0 {
        seq := leaseOp(4, s.blk, fWr + 1, 0)
        if sealPut(s, fd, b, seq) == 1 {
            setSeq(s, seq + 1)
            return 0
        }
    }
    if flushMode(s, fd, 0) < 0 {
        return 0 - 1
    }
    return sendNow(s, fd, b, fl)
}

// net.ConnのFlush（sec.Opsのflush）
func flushNet(s internal.sec.Store, fd int, nw int) int {
    return flushMode(s, fd, nw)
}

// 期限切れなら積んだ分を送らずに捨てる（送りと同じく失敗 −1）
func flushMode(s internal.sec.Store, fd int, nw int) int {
    dl := sysDeadline() != 0
    r := sysNetOp(13, fd, if dl { 1 } else { 0 }, nw)
    if r == 0 || (r == 1 && !dl) {
        return 0
    }
    return 0 - 1
}

// bのrecordをその場で送る（送信バッファに入らないb・鍵を進める前後）。平文をnowPieceずつ封じて送る。切片ごとのrecordは反復のregionに作って捨てるので、
// 大きいbでも暗号文の全体を抱えない（読まない相手へ送る間も、抱えるのは切片1つ分）。nowPieceはMaxPlainの倍数なので、recordの切れ目はb全体を封じたときと同じ
func sendNow(s internal.sec.Store, fd int, b []byte, fl int) int {
    mut wr := if (fl & bRekey) != 0 { internal.record.Unpack(view(s, fWr, dirW), 0) } else { internal.record.WithSeq(s.wr, leaseOp(4, s.blk, fWr + 1, 0)) }
    mut pre := []byte{}
    if (fl & bUpdate) != 0 || internal.record.NeedUpdate(wr) {
        pre = internal.record.Seal(mut wr, internal.record.CtHandshake, []byte{24, 0, 0, 1, 0}, 0)
        if internal.record.Update(mut wr) != nil {
            return 0 - 1
        }
        setFlags(s, (fl & ^bUpdate) | bRekey)
        if !writeDir(s, fWr, wr) {
            return 0 - 1
        }
    }
    mut at := 0
    while at < len(b) {
        m := if len(b) - at < nowPiece { len(b) - at } else { nowPiece }
        r := internal.record.Seal(mut wr, internal.record.CtApp, b[at:at + m], 0)
        setSeq(s, internal.record.Seq(wr))
        if internal.mux.SendBytes(fd, if at == 0 && len(pre) > 0 { cat(pre, r) } else { r }) != nil {
            return 0 - 1
        }
        at += m
    }
    return 0
}

// sendNowが1回に封じて送る平文の大きさ（record 4つ）
const nowPiece = 4 * internal.record.MaxPlain

// bのrecord（番号seq）をワーカーの作業の列へSealし、rtに予約のチャンクの続きへコピーさせる（net_op 12）。1 = 積んだ。0以下 = 積めない。積めないのは、
// recordがチャンクを越える・鍵の使用上限の手前・予約のチャンクに入らない・予約できないとき。積めなければ呼び手はseqを進めない。作業の列（頭・nonce・AEADのrecordの状態）は
// この関数のregionに積もって戻れば捨てられる（ループでない式ブロックで包む形は、最適化のパスでregionが消えて呼び手に合流するので使わない）
func sealPut(s internal.sec.Store, fd int, b []byte, seq int) int {
    n := internal.record.HeadSize + len(b) + 1 + 16
    wr := internal.record.WithSeq(s.wr, seq)
    if n > sinkCap || internal.record.NeedUpdate(wr) {
        return 0
    }
    k := leaseOp(1, s.wk, 0, 0)
    if k < 0 || (k + 1) * workW > len(s.wk) {
        return 0
    }
    mut w := leaseBytes(s.wk, k * workW, sinkCap)
    m := internal.record.SealInto(wr, internal.record.CtApp, b, mut w, 0)
    if m != n {
        return 0
    }
    return sysNetOp(12, fd, sysAddr(w), m)
}

// close_notify の record（送りの鍵で — Serve が k の後に送る）
func closeRecord(s internal.sec.Store) []byte {
    mut wr := internal.record.Unpack(view(s, fWr, dirW), 0)
    r := internal.record.Seal(mut wr, internal.record.CtAlert, []byte{1, 0}, 0)
    setSeq(s, internal.record.Seq(wr))
    setFlags(s, flags(s) | bDead)
    return r
}

// fatal の alert desc を送って閉じる（送りの失敗は見ない — 閉じる途中）
func die(s internal.sec.Store, fd int, desc int) {
    if (flags(s) & bDead) == 0 {
        _ = flushMode(s, fd, 0)
        mut wr := internal.record.Unpack(view(s, fWr, dirW), 0)
        r := internal.record.Seal(mut wr, internal.record.CtAlert, []byte{2, byte(desc)}, 0)
        setSeq(s, internal.record.Seq(wr))
        setFlags(s, flags(s) | bDead | bFatal)
        _ = internal.mux.SendBytes(fd, r)
    }
}

// ── ALPN ──

// cのALPNで決まったプロトコル（"h2"・"http/1.1"。申し出が無い・合わなかった・平文の接続は ""）
@effects()
func Protocol(c net.Conn) string {
    if len(c.sec) == 0 {
        return ""
    }
    a := c.sec[0].alpn
    return if a == internal.sec.AlpnH2 { "h2" } else if a == internal.sec.AlpnH11 { "http/1.1" } else { "" }
}

// ── 格納場所のインターフェース ──

func flags(s internal.sec.Store) int {
    return leaseOp(4, s.blk, fFlags, 0)
}

func setFlags(s internal.sec.Store, v int) {
    _ = leaseOp(5, s.blk, fFlags, v)
}

// 送りの方向のseqのワード（Packの2ワード目）だけを書き戻す
func setSeq(s internal.sec.Store, seq int) {
    _ = leaseOp(5, s.blk, fWr + 1, seq)
}

// 方向dを席（off = fWr / fRd）に書き戻す（KeyUpdateの後 — internal.record.Packと同じ並び）。バイトを1つずつ組む（Packの8バイトの読みはpanicの経路を持つ —
// net.Recv / net.Sendの契約はpanicを持たない）。席に入らなければfalse（鍵の長さはsuiteで決まるので、起きない）
func writeDir(s internal.sec.Store, off int, d internal.record.Dir) bool {
    km := if d.suite == internal.record.AesGcm { d.aes.ctx } else { d.cc.key }
    if 2 + 3 + (len(d.secret) + 7) / 8 + (len(d.iv) + 7) / 8 + (len(km) + 7) / 8 > dirW {
        return false
    }
    mut v := leaseView(s.blk, off, dirW)
    v[0] = d.suite
    v[1] = d.seq
    mut at := writeBytes(mut v, 2, d.secret)
    at = writeBytes(mut v, at, d.iv)
    at = writeBytes(mut v, at, km)
    while at < dirW {
        v[at] = 0
        at += 1
    }
    return true
}

// bを長さのワードと8バイト / ワードでv[at:]へ（次の位置を返す）
func writeBytes(v mut []int, at int, b []byte) int {
    v[at] = len(b)
    mut w := at + 1
    mut i := 0
    while i < len(b) {
        mut x := 0
        mut j := 0
        while j < 8 && i + j < len(b) {
            x = x | (int(b[i + j]) << (j * 8))
            j += 1
        }
        v[w] = x
        w += 1
        i += 8
    }
    return w
}

// 格納場所の [off, off + n) のワード（コピーしない — 読みはこの列から）
// 格納場所の [off, off + n) の語の列の byte の view（view と同じ語 — record.UnpackView が鍵の素材を写さずに切る）
func bview(s internal.sec.Store, off int, n int) []byte {
    v := leaseBytes(s.blk, off, n * 8)
    return freeze(v)
}

func view(s internal.sec.Store, off int, n int) []int {
    v := leaseView(s.blk, off, n)
    return freeze(v)
}

func cat(a []byte, b []byte) []byte {
    mut o := mut []byte{}
    for x <- a {
        o = append(o, x)
    }
    for x <- b {
        o = append(o, x)
    }
    return freeze(o)
}

// a[at:] のコピー
func rest(a []byte, at int) []byte {
    mut o := mut []byte{}
    mut i := at
    while i < len(a) {
        o = append(o, a[i])
        i += 1
    }
    return freeze(o)
}

// rtのnetのインターフェース（std/netのsysNetOpと同じ組み込み）。ここで使うのはop 12・13（送信バッファのチャンクの予約へ積む・予約のSENDを積む）と
// op 14〜16（受けと送りの期限。期限のワードを置く・ワーカーの粗い時刻・ワーカーの期限の列へ入れる）
@intrinsic("net_op")
func sysNetOp(op int, fd int, a int, b int) int

@intrinsic("addr")
func sysAddr(b []byte) int

@intrinsic("deadline")
func sysDeadline() int

// leaseOp / leaseViewはrtのインターフェース（std/task・std/poolと同じ鍵 — op 4 = 生の読み・5 = 生の書き・6 = 今の深度より深い死んだスロットのページを返す）
@intrinsic("lease_op")
func leaseOp(op int, blk []int, off int, v int) int

@intrinsic("lease_view")
func leaseView(blk []int, off int, n int) mut []int

@intrinsic("lease_bytes")
func leaseBytes(blk []int, off int, n int) mut []byte

// blk[off]のワードが指す番地からnバイト（lease_op 12が確保した持ち越しの席）
@intrinsic("lease_at")
func leaseAt(blk []int, off int, n int) mut []byte
