package tls

// TLS 1.3 のサーバ（RFC 9846 — X25519・AES-128-GCM / ChaCha20-Poly1305・RSA-PSS の証明書・resumption / 0-RTT なし）。
// tls.Serve(addr, cfg, k) が net.Serve を包み、handshake が済んだ接続だけを k に渡す（handshake 中の接続を利用者に触らせない）。
// tls.Connはnet.Connと同じ顔の同一性の型（コピーできない・外へ出せない・give: で渡せない）で、tls.Recv / tls.Sendがnet.Recv / net.Sendと同じ形。
// net.Conn と顔が違う唯一の点: tls.Recv を break で途中で抜けると、その接続の読みは終わる（次の tls.Recv は Closed — 切片に残った record を持ち越さない）。
// 誤りは粗い3ラベル（HandshakeFailed〔alertの種はフィールド〕・BadRecord・Closed）。
// 信頼の起点の値 Roots（ParseRoots が作る — 私的 PKI の CA を足すとき std/http/client の Policy の extraRoots: に渡す）もここに住む

// 接続の状態（送りの鍵と seq・受けた KeyUpdate の要求・handshake の残りのバイト）は値の外 — 接続の task の region に 1 回作る int の列（blk）に住み、
// Recv / Sendがrtのインターフェース（lease_view / lease_op — std/pool・std/taskのleaseと同じ鍵）で読み書きする（net.ConnのTCPのseqがカーネルにあるのと同じ形。
// 同一性の型の規則が隠れた可変を観測できなくする）

import "std/crypto/pem"
import "std/crypto/rsa"
import "std/io"
import "std/net"
import "std/strings"
import "std/internal/hs"
import "std/internal/x509"
import "std/internal/record"

// handshake が失敗した（alert = 送った alert の番号 — RFC 9846 6）
type HandshakeFailed error {
    alert int
}

// 受けた record が壊れている（改竄・形の誤り・想定外のメッセージ — 相手へ alert を送って閉じた）
type BadRecord error

// 接続が閉じている（相手の切断・相手の alert・転送路の失敗・途中で抜けた後の Recv）
type Closed error

// サーバの設定（Load / Parseが作る — 証明書のチェーン・葉の鍵・受けるALPN）
type Config struct {
    chain [][]byte
    key crypto.rsa.PrivateKey
    alpn []string
}

// 足す信頼の起点（ParseRoots が作る — 封の型。中身は読めた CERTIFICATE の列）
type Roots struct {
    certs []internal.x509.Cert
    seal rootsSeal
}

type rootsSeal struct {
}

// ParseRootsのPEMが読めない（CERTIFICATEのチャンクが無い・チャンクのDERが証明書の形でない）
type BadRoots error

// handshake の済んだ接続（同一性の型 — net.Conn と同じ規則。tls.Serve の k の仮引数としてだけ生まれる）
type Conn struct {
    c net.Conn
    blk []int
    wr internal.record.Dir
    wk []int
    seal tlsSeal
}

// handshake の済んだ接続 1 本の処理（名前つきの関数型 — 値として接続の task へ渡る。language.md 14 節: 公開境界の関数型は名前つき）
type Handler func(c Conn) error?

// 封（非公開 — 外で値を書けない）
type tlsSeal struct {
}

// ストレージの列の形: [旗, 残りのバイト数L, 送りの方向 × dirW, 受けの方向 × dirW, 残りのバイト（8バイト / ワード）…]
const fFlags = 0
const fLeft = 1
const fWr = 2
const dirW = 80
const fRd = 2 + 80
const fBytes = 2 + 80 + 80

// 送信バッファは接続ごとに持たない。Putはrecordをワーカーの作業の列へSealし、rtがワーカーの送信バッファのチャンクの続きへコピーする（net_op 12）。
// チャンクは接続が1つ予約する。Flushは予約のチャンクのSENDを積み、送りの完了を待つ（net_op 13）。呼び手は平文のregionを閉じてからFlushを呼ぶので、
// 送りの完了を待つ間もレスポンスの作業のregionを抱えない。std/httpのServeWithが受けの前に印（lease_op 10）を置いたときだけ、Recvの中のFlush（flushIn）は
// 完了を待たずに戻り、送りの結果は接続の次の受け・送り・閉じが返す（平文の送信バッファリングと同じ。公開のFlush・Sendは印を見ない）。
// チャンクの大きさ = sinkCap。recordがこれを越えるbと、予約できないときは、積んだ分を送ってからその場で送る
const sinkCap = 16384

// Sealの作業の列（ワーカーごとにsinkCapバイト。Serveが1回作り、接続のtaskへ捕獲で渡る）: Putはrecordをここへ書き、rtが予約のチャンクへコピーする。
// 書いてからコピーするまでの間にスリープしないので、同じワーカーの他のtaskと重ならない
const workW = sinkCap / 8

func workNew() []int {
    nw := leaseOp(0, []int{}, 0, 0)
    mut b := mut []int{}
    mut i := 0
    while i < nw * workW {
        b = append(b, 0)
        i += 1
    }
    return freeze(b)
}

// 旗のビット
const bUpdate = 1   // 相手が KeyUpdate で update_requested を送った（次の Send が先に自分の KeyUpdate を送る）
const bRead = 2     // Recv を 1 度回した（2 度目は Closed — 読みは接続の終わりまでの 1 本の流れ）
const bDead = 4     // 閉じた（alert を送った・受けた — Send は Closed）
const bRekey = 8    // 送りの鍵をKeyUpdateで進めた（Connのwrはhandshakeの鍵のまま — 以後のSendは格納場所の列から展開し直す）
const bFatal = 16   // fatalのalertを送った・受けた（bDeadも立つ。相手のclose_notifyでは立たない）

// ── 設定 ──

// PEMの証明書のチェーン（CERTIFICATEが1つ以上 — 葉が先頭）とPKCS#8のRSAの鍵のConfig（ALPNの既定 = http/1.1 — 変えるならAlpn）
@errors(crypto.pem.Bad, crypto.rsa.BadKey)
@effects()
func Parse(certPem string, keyPem string) (Config, error?) {
    cb := crypto.pem.Parse(certPem)?
    kb := crypto.pem.Parse(keyPem)?
    mut chain := mut [][]byte{}
    for b <- cb {
        if b.label == "CERTIFICATE" {
            chain = append(chain, b.der)
        }
    }
    if len(chain) == 0 || len(kb) == 0 {
        return emptyConfig(), crypto.pem.Bad{}
    }
    k := crypto.rsa.ParsePKCS8(kb[0].der)?
    return Config{chain: freeze(chain), key: k, alpn: []string{"http/1.1"}}, nil
}

// PEMの文字列pemのCERTIFICATEのチャンクを全部読んだ信頼の起点（私的PKIのCA — 外部ファイルを読むインターフェースは作らない。読めないチャンクが1つでもあればBadRoots）
@errors(BadRoots)
@effects()
func ParseRoots(pem string) (Roots, error?) {
    cs, err := internal.x509.RootsFromPEM(pem)
    if err != nil || len(cs) == 0 {
        return Roots{certs: []internal.x509.Cert{}, seal: rootsSeal{}}, BadRoots{}
    }
    return Roots{certs: cs, seal: rootsSeal{}}, nil
}

// 受ける ALPN をサーバの好みの順 alpn に替えた Config（空 = ALPN を使わない。相手の申し出と重ならなければ no_application_protocol — RFC 7301）
@effects()
func Alpn(cfg Config, alpn []string) Config {
    return Config{chain: cfg.chain, key: cfg.key, alpn: alpn}
}

// Parse のファイル版（certPath / keyPath を読む）
@errors(crypto.pem.Bad, crypto.rsa.BadKey, strings.BadUtf8, io.NotFound, io.Denied, io.Other, io.Timeout, io.Expired)
@effects(io, nondet)
func Load(certPath string, keyPath string) (Config, error?) {
    c := string(io.ReadFile(certPath)?)?
    k := string(io.ReadFile(keyPath)?)?
    return Parse(c, k)
}

func emptyConfig() Config {
    k, _ := crypto.rsa.ParsePKCS8([]byte{})
    return Config{chain: [][]byte{}, key: k, alpn: []string{}}
}

// ── 待ち受け ──

// addr で待ち受け、接続ごとに handshake を済ませてから k を走らせる（接続 1 本 = task 1 本 — net.Serve と同じ admission・k の失敗と死は吸収）。
// handshake の失敗は alert を送って閉じ、k は呼ばない。k が返ったら（error を返しても）close_notify を送って閉じる。k が死んだときは close_notify を送らずに閉じる
// region = 接続のtaskのregion 1つの上限（net.Serveのregion: へそのまま。既定は128 MiB）
@errors(net.Bad, io.Closed, io.Timeout, io.Expired, io.Denied, io.Other)
@effects(block, io, panic, nondet, Handler)
func Serve(addr string, cfg Config, k Handler, region int?) error? {
    wk := workNew()
    for l <- net.Listen(addr)? {
        net.Serve(l, (c) => accept(c, cfg, k, wk), region: if region != nil { region } else { 128 * 1048576 })?
    }
    return nil
}

// 1接続のhandshake（handshake）の後にkを呼ぶ。handshakeの作業域（受けのバッファ・Hs・署名の作業）はhandshakeのregionに置き、
// kを呼ぶ前に返す — 接続の寿命いっぱい（kの間）抱えない（格納場所の列だけが外へコピーされる）
func accept(nc net.Conn, cfg Config, k Handler, wk []int) error? {
    blk := handshake(nc, cfg)?
    // handshakeの深い作業（署名・鍵の導出 — 1回きり）のページを返す: スロットのページはtaskの寿命いっぱい残るので、リクエストのパスより深い高水位が接続の常駐になる
    _ = leaseOp(6, []int{}, 0, 0)
    // 送りの方向はhandshakeの鍵のまま展開して持つ（Sendのたびに格納場所の列から鍵の素材をコピーし直さない — 変わるのはseqのワードだけ）
    c := Conn{c: nc, blk: blk, wr: internal.record.Unpack(freeze(leaseView(blk, fWr, dirW)), 0), wk: wk, seal: tlsSeal{}}
    ke := k(c)
    // 積み残し（Put の後に Flush しないで k が返った）を送ってから close_notify。
    // fatalのalertを送った・受けた接続には、その後に何も送らない（RFC 9846 6.2）。相手のclose_notifyの後は、積み残しを送ってからclose_notifyを返す（6.1）
    if (flags(c) & bFatal) == 0 {
        _ = Flush(c)
        _ = net.Send(nc, closeRecord(c))
    }
    return ke
}

// 1接続のhandshake（handshakeのrecordは小さいので、切片をコピーしてバッファする）→ 格納場所の列（newBlk）。Connectedになった切片の残り
// （クライアントはFinishedと最初のリクエストを同じflightで送るのが普通）は格納場所に置く — kの中のtls.Recvが同じfdの続きを読む
@errors(HandshakeFailed, Closed)
func handshake(nc net.Conn, cfg Config) ([]int, error?) {
    p := internal.hs.NewParams(cfg.chain, cfg.key, cfg.alpn, []int{internal.record.AesGcm, internal.record.ChaCha}, []byte{})
    mut h := internal.hs.New()
    mut acc := []byte{}
    for chunk <- (net.Recv(nc)? Closed{}) {
        acc = cat(acc, chunk)
        mut at := 0
        mut n := frameLen(acc, at)
        while n > 0 {
            o, e := internal.hs.Feed(mut h, p, internal.record.At(acc, at, n))
            if e != nil {
                d := alertOf(e)
                _ = net.Send(nc, internal.hs.AlertRecord(mut h, d))
                return []int{}, HandshakeFailed{alert: d}
            }
            if len(o.send) > 0 {
                net.Send(nc, o.send)? Closed{}
            }
            at += n
            if o.closed {
                return []int{}, Closed{}
            }
            if o.done {
                return newBlk(h, rest(acc, at)), nil
            }
            n = frameLen(acc, at)
        }
        if n < 0 {
            d := if n == 0 - 2 { internal.record.AlertUnexpected } else { internal.record.AlertOverflow }
            _ = net.Send(nc, internal.hs.AlertRecord(mut h, d))
            return []int{}, HandshakeFailed{alert: d}
        }
        acc = rest(acc, at)
    }
    return []int{}, Closed{}
}

// acc[at:]の先頭のrecordの長さ（頭込み）。0はまだ揃わない、−1は本体が上限を超える、−2は内容の型がTLSのrecordのどれでもない。
// 内容の型は先頭の1バイトで決まるので、頭と本体が揃うのを待たずに拒否する（SSL 2.0の形のClientHelloなどで、本体の長さの分を待ち続けない）
func frameLen(acc []byte, at int) int {
    if len(acc) - at >= 1 {
        t := int(acc[at])
        if t < internal.record.CtCcs || t > internal.record.CtApp {
            return 0 - 2
        }
    }
    if len(acc) - at < internal.record.HeadSize {
        return 0
    }
    body := int(acc[at + 3]) << 8 | int(acc[at + 4])
    if body > internal.record.MaxCipher {
        return 0 - 1
    }
    return if len(acc) - at < internal.record.HeadSize + body { 0 } else { internal.record.HeadSize + body }
}

// handshake の誤りの alert の番号
func alertOf(e error?) int {
    return switch e {
        case nil: internal.record.AlertInternal
        case internal.record.Alert{desc}: desc
    }
}

// handshakeの済んだhsの格納場所（送り / 受けの方向・残りのバイト）
func newBlk(h internal.hs.Hs, left []byte) []int {
    rd, wr := internal.hs.Dirs(h)
    mut b := mut []int{}
    b = append(b, 0)
    b = append(b, len(left))
    putDir(mut b, internal.record.Pack(wr))
    putDir(mut b, internal.record.Pack(rd))
    mut i := 0
    while i < len(left) {
        mut v := 0
        mut j := 0
        while j < 8 && i + j < len(left) {
            v = v | (int(left[i + j]) << (j * 8))
            j += 1
        }
        b = append(b, v)
        i += 8
    }
    return freeze(b)
}

// 方向のワードの列をdirWワードの席に（余りは0）
func putDir(b mut []int, w []int) {
    if len(w) > dirW {
        panic(Overflow{})
    }
    for v <- w {
        b = append(b, v)
    }
    mut i := len(w)
    while i < dirW {
        b = append(b, 0)
        i += 1
    }
}

// 方向のワードの列が席に入らない（stdの内部の約束違反 — panicラベル）
type Overflow panic

// ── 受け ──

// c の受けた application の平文を k に順に渡す（呼び出し形の生成元 — `for b <- tls.Recv(c)? { … }`）。相手の close_notify で nil。
// 受けの表は internal.hs.Feed の Connected の枝が持つ（受けの方向 rd から作った Hs に枠を 1 つずつ internal.hs.Step〔mut なしの入口 — 表は Feed と共有〕で通す — 表を 1 か所に）。
// 受けた KeyUpdate は受けの鍵を進め、update_requested なら次の Send が先に自分の KeyUpdate を送る。改竄・形の誤り・想定外は alert を送って BadRecord。
// k が Put で積んだ分は、受けた切片 1 つ分の record を k へ配り終えるたびに送る（Flush — 次の受けを待つ前に。pump）。
// 1 つの接続で 1 度だけ回せる（break で途中で抜けた後・2 度目は Closed）
@errors(BadRecord, Closed)
@effects(block, io, nondet)
func Recv(c Conn, k func([]byte)) error? {
    fl := flags(c)
    if (fl & (bRead | bDead)) != 0 {
        return Closed{}
    }
    setFlags(c, fl | bRead)
    return recvErr(c, recvFrames(c, k))
}

// recvFramesの誤りをRecvの誤りにする。Alertは、alertを送って閉じてBadRecord。転送路の失敗はClosed。
// 関数型の仮引数を持たないので、Recvの展開点ごとに複製されない
@errors(BadRecord, Closed)
@effects(block, io, nondet)
func recvErr(c Conn, e error?) error? {
    return switch e {
        case nil: nil
        case internal.record.Alert{desc}: dieBad(c, desc)
        case internal.record.Transport{}: Closed{}
        case Closed{}: Closed{}
    }
}

// Recvの本体。recordの枠を受けの表に通す。recordの形の誤り（長すぎる・途中で切れた）と中身の誤りは、どちらもAlertで返る（alertはRecvが送る）
@errors(internal.record.Alert, internal.record.Transport, Closed)
@effects(block, io, nondet)
func recvFrames(c Conn, k func([]byte)) error? {
    mut h := internal.hs.Resume(internal.record.Unpack(view(c, fRd, dirW), 0))
    left := leftBytes(c)
    for f <- internal.record.Frames((k2) => pump(c, left, k2))? {
        h2, o, e := internal.hs.Step(h, f)
        h = h2
        if e != nil {
            return e
        }
        if o.upd {
            setFlags(c, flags(c) | bUpdate)
        }
        if len(o.app) > 0 {
            k(o.app)
        }
        if o.closed {
            setFlags(c, flags(c) | bDead | (if o.peer != 0 { bFatal } else { 0 }))
            return if o.peer != 0 { Closed{} } else { nil }
        }
    }
    return nil
}

// fatalのalert descを送って閉じ、BadRecordを返す
@errors(BadRecord)
func dieBad(c Conn, desc int) error? {
    die(c, desc)
    return BadRecord{}
}

// handshakeの残りのバイトを先に渡してからnet.Recvの続き（internal.record.Framesの受けのインターフェース）。
// 残りはnet.Recvと同じ入れ子（反復のregion + 式ブロックのregion）の中でkへ渡す — 直にk(left) と呼ぶと最初のリクエストのパスだけが
// 2段浅い深度を通り、その深度のスロットに本文の大きさのページを一度だけ付けて接続の寿命いっぱい残してしまう。
// 切片1つをkへ渡し終えるたびに、RecvのkがPutで積んだレスポンスを送る（Flush — kの反復のregionが閉じた後なので、送りの完了待ちの間に
// レスポンスの作業のページを抱えない）
func pump(c Conn, left []byte, k func([]byte)) error? {
    mut once := len(left) > 0
    while once {
        n := {
            k(left)
            len(left)
        }
        flushIn(c)?
        once = n < 0
    }
    for b <- net.Recv(c.c)? {
        k(b)
        flushIn(c)?
    }
    return nil
}

// ── 送り ──

// b を application の record にして c へ送る（空の b は送らない — Put + Flush）。相手の KeyUpdate の要求・AES-GCM の使用上限の手前なら、先に自分の KeyUpdate を送って鍵を進める
@errors(Closed)
@effects(block, io, panic, nondet)
func Send(c Conn, b []byte) error? {
    Put(c, b)?
    return Flush(c)
}

// bをapplicationのrecordにしてcの送信バッファに積む。ここでは送らない。Flushか、tls.Recvのkが戻ったときか、送信バッファに入らない次のPutか、Serveの出口が送る。
// 空のbは積まない。送信バッファに入らないとき（積んだ分と合わせてワーカーの送信バッファのチャンクを越える・チャンクを予約できない）と、鍵を進める前後は、
// 積んだ分を送ってからbのrecordをその場で送る（順序は保つ）
@errors(Closed)
@effects(block, io, panic, nondet)
func Put(c Conn, b []byte) error? {
    fl := flags(c)
    if (fl & bDead) != 0 {
        return Closed{}
    }
    if len(b) == 0 {
        return nil
    }
    if (fl & (bUpdate | bRekey)) == 0 {
        seq := leaseOp(4, c.blk, fWr + 1, 0)
        if sealPut(c, b, seq) == 1 {
            setSeq(c, seq + 1)
            return nil
        }
    }
    Flush(c)?
    return sendNow(c, b, fl)
}

// cの送信バッファに積んだrecordを送る（無ければ何もしない）
@errors(Closed)
@effects(block, io, nondet)
func Flush(c Conn) error? {
    return flushMode(c, 0)
}

// Recvの中のFlush: std/httpのServeWithの印（lease_op 10）があれば、送りの完了を待たない（送りの結果は接続の次の受け・送り・閉じが返す）。印が無ければFlushと同じ
func flushIn(c Conn) error? {
    return flushMode(c, 1)
}

// 期限切れなら積んだ分を送らずに捨てる（送りと同じくClosed）
func flushMode(c Conn, nw int) error? {
    dl := sysDeadline() != 0
    r := sysNetOp(13, c.c.fd, if dl { 1 } else { 0 }, nw)
    if r == 0 || (r == 1 && !dl) {
        return nil
    }
    return Closed{}
}

// bのrecordをこの関数のregionに作ってその場で送る（送信バッファに入らないb・鍵を進める前後）
func sendNow(c Conn, b []byte, fl int) error? {
    mut wr := if (fl & bRekey) != 0 { internal.record.Unpack(view(c, fWr, dirW), 0) } else { internal.record.WithSeq(c.wr, leaseOp(4, c.blk, fWr + 1, 0)) }
    mut pre := []byte{}
    if (fl & bUpdate) != 0 || internal.record.NeedUpdate(wr) {
        pre = internal.record.Seal(mut wr, internal.record.CtHandshake, []byte{24, 0, 0, 1, 0}, 0)
        internal.record.Update(mut wr)? Closed{}
        setFlags(c, (fl & ^bUpdate) | bRekey)
        putWr(c, internal.record.Pack(wr))
    }
    r := internal.record.Seal(mut wr, internal.record.CtApp, b, 0)
    setSeq(c, internal.record.Seq(wr))
    net.Send(c.c, if len(pre) == 0 { r } else { cat(pre, r) })? Closed{}
    return nil
}

// bのrecord（番号seq）をワーカーの作業の列へSealし、rtに予約のチャンクの続きへコピーさせる（net_op 12）。1 = 積んだ。0以下 = 積めない。積めないのは、
// recordがチャンクを越える・鍵の使用上限の手前・予約のチャンクに入らない・予約できないとき。積めなければ呼び手はseqを進めない。作業の列（頭・nonce・AEADのrecordの状態）は
// この関数のregionに積もって戻れば捨てられる（ループでない式ブロックで包む形は、最適化のパスでregionが消えて呼び手に合流するので使わない）
func sealPut(c Conn, b []byte, seq int) int {
    n := internal.record.HeadSize + len(b) + 1 + 16
    wr := internal.record.WithSeq(c.wr, seq)
    if n > sinkCap || internal.record.NeedUpdate(wr) {
        return 0
    }
    k := leaseOp(1, c.wk, 0, 0)
    if k < 0 || (k + 1) * workW > len(c.wk) {
        return 0
    }
    mut w := leaseBytes(c.wk, k * workW, sinkCap)
    m := internal.record.SealInto(wr, internal.record.CtApp, b, mut w, 0)
    if m != n {
        return 0
    }
    return sysNetOp(12, c.c.fd, sysAddr(w), m)
}

// close_notify の record（送りの鍵で — Serve が k の後に送る）
func closeRecord(c Conn) []byte {
    mut wr := internal.record.Unpack(view(c, fWr, dirW), 0)
    r := internal.record.Seal(mut wr, internal.record.CtAlert, []byte{1, 0}, 0)
    setSeq(c, internal.record.Seq(wr))
    setFlags(c, flags(c) | bDead)
    return r
}

// fatal の alert desc を送って閉じる（送りの失敗は見ない — 閉じる途中）
func die(c Conn, desc int) {
    if (flags(c) & bDead) == 0 {
        _ = Flush(c)
        mut wr := internal.record.Unpack(view(c, fWr, dirW), 0)
        r := internal.record.Seal(mut wr, internal.record.CtAlert, []byte{2, byte(desc)}, 0)
        setSeq(c, internal.record.Seq(wr))
        setFlags(c, flags(c) | bDead | bFatal)
        _ = net.Send(c.c, r)
    }
}

// ── 格納場所のインターフェース ──

func flags(c Conn) int {
    return leaseOp(4, c.blk, fFlags, 0)
}

func setFlags(c Conn, v int) {
    _ = leaseOp(5, c.blk, fFlags, v)
}

// 送りの方向のseqのワード（Packの2ワード目）だけを書き戻す
func setSeq(c Conn, seq int) {
    _ = leaseOp(5, c.blk, fWr + 1, seq)
}

// 送りの方向のワードの列を席に書き戻す（KeyUpdateの後）
func putWr(c Conn, w []int) {
    v := leaseView(c.blk, fWr, dirW)
    mut i := 0
    while i < dirW {
        v[i] = if i < len(w) { w[i] } else { 0 }
        i += 1
    }
}

// 格納場所の [off, off + n) のワード（コピーしない — 読みはこの列から）
func view(c Conn, off int, n int) []int {
    v := leaseView(c.blk, off, n)
    return freeze(v)
}

// handshake の残りのバイト
func leftBytes(c Conn) []byte {
    n := leaseOp(4, c.blk, fLeft, 0)
    mut b := mut []byte{}
    mut i := 0
    while i < n {
        w := leaseOp(4, c.blk, fBytes + i / 8, 0)
        b = append(b, byte((w >> ((i % 8) * 8)) & 0xff))
        i += 1
    }
    return freeze(b)
}

func cat(a []byte, b []byte) []byte {
    mut o := mut []byte{}
    for x <- a {
        o = append(o, x)
    }
    for x <- b {
        o = append(o, x)
    }
    return freeze(o)
}

// a[at:] のコピー
func rest(a []byte, at int) []byte {
    mut o := mut []byte{}
    mut i := at
    while i < len(a) {
        o = append(o, a[i])
        i += 1
    }
    return freeze(o)
}

// rtのnetのインターフェース（std/netのsysNetOpと同じ組み込み）。ここで使うのはop 12・13だけ: 送信バッファのチャンクの予約へ積む・予約のSENDを積む
@intrinsic("net_op")
func sysNetOp(op int, fd int, a int, b int) int

@intrinsic("addr")
func sysAddr(b []byte) int

@intrinsic("deadline")
func sysDeadline() int

// leaseOp / leaseViewはrtのインターフェース（std/task・std/poolと同じ鍵 — op 4 = 生の読み・5 = 生の書き・6 = 今の深度より深い死んだスロットのページを返す）
@intrinsic("lease_op")
func leaseOp(op int, blk []int, off int, v int) int

@intrinsic("lease_view")
func leaseView(blk []int, off int, n int) mut []int

@intrinsic("lease_bytes")
func leaseBytes(blk []int, off int, n int) mut []byte
