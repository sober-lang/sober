package utf8

// `string(b)`（std/internal/utf8.Parse）のASCIIの速いパスの検査: 速いパスの長さの上限（256バイト）の前後で、ASCIIの列の各位置に0x80以上の字
// （妥当な2 / 3バイト列・継続バイト単独・0xff）を置いた列とASCIIだけの列について、`string(b)` の成否と誤りの位置が strings.IndexInvalid
// （列全体の一般の検査）と一致し、成功なら同じバイト列を返すこと

import "std/iter"
import "std/strings"

// a と b が同じバイト列か
func same(a []byte, b []byte) bool {
    if len(a) != len(b) {
        return false
    }
    for i <- iter.Range(0, len(a)) {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

// `string(b)` と IndexInvalid の判定が一致するか
func convAgrees(b []byte) bool {
    want := strings.IndexInvalid(b)
    s, e := string(b)
    return if e == nil {
        want < 0 && same(bytes(s), b)
    } else {
        switch e {
        case strings.BadUtf8{pos}: pos == want
        }
    }
}

func TestStringConvAsciiFast() {
    inss := [][]byte{[]byte{}, bytes("é"), bytes("あ"), []byte{byte(0x80)}, []byte{byte(0xff)}, []byte{byte(0xc3)}, []byte{byte(0x7f)}}
    mut ok := true
    ns := []int{0, 1, 2, 7, 8, 9, 63, 254, 255, 256, 257}
    for n <- ns {
        for ins <- inss {
            for at <- iter.Range(0, n + 1) {
                b := probe(n, if len(ins) == 0 { -1 } else { at }, ins)
                if !convAgrees(b) {
                    println("string(b) differs: n ${n} at ${at} len ${len(b)}")
                    ok = false
                }
            }
        }
    }
    assert(ok)
}
