package clidoc

// `sober doc --cli` の描き手: プログラムの std/cli の表の JSON（`<exe> --cli-spec`）を Markdown の頁にする。
// 載せるのは利用者向けの宣言だけ（dev のコマンド・環境変数は `--help=dev` の側）。コマンドの節の usage の塊は std/cli の Usage の文面そのもの
// （実行時の `--help` と構成で一致）・効果の行は呼び手が analyzer の導出で引いた run の関数の効果（静的な文書だけ — 実行時の --help には出さない）。
// 文言は英語が正。日本語の頁は訳表（`{"<英語の文>": "<訳>"}` の JSON）で summary / help / 環境変数の説明だけを訳す — usage の塊は
// 実行ファイルが喋る英語のまま。訳の無い文・使われない訳は error（表と頁の陳腐化を生成で止める）

import "std/json"
import "std/iter"
import "std/strings"

// 表の JSON が読めない（what = どこが）
type BadSpec error {
    what string
}

// 日本語の頁で訳の無い文（text = 英語の文）
type NoTranslation error {
    text string
}

// 訳表にあって頁で使われない文
type UnusedTranslation error {
    text string
}

// 表の JSON spec の頁。cmds / effs はコマンドの名前ごとの効果の行の中身（効果が分からないコマンドは載せない）。
// ja が空でなければ訳表の JSON で日本語の頁を描く
@errors(BadSpec, NoTranslation, UnusedTranslation)
func Render(spec []byte, cmds []string, effs []string, ja []byte) (string, error?) {
    d := json.Parse(spec) catch {
        return "", BadSpec{what: "not JSON"}
    }
    r := json.Root(d)
    mut tr := Tr{on: len(ja) > 0, en: mut []string{}, ja: mut []string{}, used: mut []bool{}, miss: ""}
    if tr.on {
        t := json.Parse(ja) catch {
            return "", BadSpec{what: "the translation table is not JSON"}
        }
        switch json.At(t, json.Root(t)) {
        case json.Object{names, vals}:
            for k <- iter.Range(0, len(names)) {
                tr.en = append(tr.en, names[k])
                tr.ja = append(tr.ja, json.ParseString(t, vals[k]) catch "")
                tr.used = append(tr.used, false)
            }
        default:
            return "", BadSpec{what: "the translation table is not an object"}
        }
    }
    name := str(d, r, "name")
    commands := json.Items(d, need(d, r, "commands")) catch []int{}
    mut o := ""
    o = o + if tr.on {
        "<!-- `sober doc --cli` が std/cli の表から生成 — 手で直さない。英語版 ${name}.md が正で、この頁は訳表 ${name}.ja.json の訳（usage の塊は実行ファイルの英語のまま） -->\n\n"
    } else {
        "<!-- Generated by `sober doc --cli` from the std/cli table of ${name} — do not edit. -->\n\n"
    }
    o = o + "# ${name}\n\n" + tl(mut tr, str(d, r, "summary")) + "\n\n"
    help := str(d, r, "help")
    if help != "" {
        o = o + tl(mut tr, help) + "\n\n"
    }
    o = o + if tr.on { "## コマンド\n\n| コマンド | 概要 |\n| --- | --- |\n" } else { "## Commands\n\n| Command | Summary |\n| --- | --- |\n" }
    for c <- commands {
        if !flag(d, c, "dev") {
            full := "${name} ${str(d, c, "name")}"
            o = o + "| [`${full}`](#${slug(full)}) | ${cell(tl(mut tr, str(d, c, "summary")))} |\n"
        }
    }
    o = o + "\n" + envTable(mut tr, d, need(d, r, "env"))
    for c <- commands {
        if !flag(d, c, "dev") {
            o = o + cmdSec(mut tr, d, c, name, cmds, effs)
        }
    }
    if tr.miss != "" {
        return "", NoTranslation{text: tr.miss}
    }
    for k <- iter.Range(0, len(tr.en)) {
        if !tr.used[k] {
            return "", UnusedTranslation{text: tr.en[k]}
        }
    }
    return o, nil
}

// 訳表（en[k] → ja[k]・used = 頁で引いたか・miss = 最初の訳の無い文）
type Tr struct {
    on bool
    en mut []string
    ja mut []string
    used mut []bool
    miss string
}

// s の訳（英語の頁なら s のまま・訳の無い文は miss に記録して s）
func tl(tr mut Tr, s string) string {
    if !tr.on || s == "" {
        return s
    }
    for k <- iter.Range(0, len(tr.en)) {
        if tr.en[k] == s {
            tr.used[k] = true
            return tr.ja[k]
        }
    }
    if tr.miss == "" {
        tr.miss = s
    }
    return s
}

// コマンド c の節（説明・usage の塊・効果 — コマンドの環境変数は usage の塊に載っている）
func cmdSec(tr mut Tr, d json.Doc, c int, app string, cmds []string, effs []string) string {
    cname := str(d, c, "name")
    help := str(d, c, "help")
    mut o := "\n## ${app} ${cname}\n\n" + tl(mut tr, if help != "" { help } else { str(d, c, "summary") }) + "\n\n"
    o = o + "```text\n" + str(d, c, "usage") + "```\n"
    for k <- iter.Range(0, len(cmds)) {
        if cmds[k] == cname && effs[k] != "" {
            o = o + "\n" + (if tr.on { "効果" } else { "Effects" }) + ": `${effs[k]}`\n"
        }
    }
    return o
}

// 環境変数の列 n の節（dev を除く・無ければ空）
func envTable(tr mut Tr, d json.Doc, n int) string {
    es := json.Items(d, n) catch []int{}
    mut o := ""
    for e <- es {
        if !flag(d, e, "dev") {
            o = o + "| `${str(d, e, "name")}` | ${cell(tl(mut tr, str(d, e, "help")))} |\n"
        }
    }
    if o == "" {
        return ""
    }
    return (if tr.on { "## 環境変数\n\n| 変数 | 意味 |\n| --- | --- |\n" } else { "## Environment\n\n| Variable | Meaning |\n| --- | --- |\n" }) + o
}

// オブジェクト n の欄 key のノード（無ければ n — 呼び手の Items / 引きが空 / 既定に落ちる）
func need(d json.Doc, n int, key string) int {
    v := json.Get(d, n, key)
    return if v == nil { n } else { v }
}

func str(d json.Doc, n int, key string) string {
    v := json.Get(d, n, key)
    if v == nil {
        return ""
    }
    return json.ParseString(d, v) catch ""
}

func flag(d json.Doc, n int, key string) bool {
    v := json.Get(d, n, key)
    if v == nil {
        return false
    }
    return json.ParseBool(d, v) catch false
}

// 表の升に置く文（`|` を逃がす）
func cell(s string) string {
    return strings.Replace(s, "|", "\\|", -1)
}

// 見出しの錨（GitHub の形 — 小文字・空白は `-`）
func slug(s string) string {
    return strings.Replace(strings.ToLower(s), " ", "-", -1)
}
