package loader

// パッケージローダ（src/stage1/loader.zigの変換 — language.md 20 節「名前解決の最小形」）。
// ファイル集合の読み込み → parse → package 構成（dir 名 = package 名）→ import 解決（未ロードの import を読み足して繰り返す）→
// 循環の拒否 → expands の確定（名前付き関数型の引数）→ markMutDefs（呼び出しグラフの循環）→ 組み込み error の合成 → const の畳み込み。
//
// Zig 版との差:
// - ディレクトリの列挙（readdir）とargvが無いので、入力はManifest（entry・stdの格納場所・ファイル一覧）で受ける。
//   package のディレクトリを読む = 一覧から dirname が一致するものをファイル名順に拾う
// - stdの焼き込みの代わりに、`std/` で始まるpackageはstdの格納場所から読む（一覧の `std/…` はその格納場所の相対パス）
// - 局所名の衝突（localnames.sober）には決定 16（組み込みの名前の再束縛不可）と variant 名の一意を足した（Zig 版はどちらも検査しない）

import "std/io"
import "ast"
import "diag"
import "lexer"
import "parser"
import "std/iter"
import "std/strings"
import "std/table"

// load の入力。files はルート相対のパス（ファイル名順に並んでいること）。
// `std/` で始まるものは std_root の下から読む（それ以外はルート = cwd から）
type Manifest struct {
    entry string
    std_root string
    files []string
    // テストのビルド（testmain.sober — `sober test`）: test = `_test.sober` も読む package のパス（"" なら無し）、test_main = 合成した main のソース
    // （entry = TestMainPath() のときだけ読む）
    test string
    test_main string
    // カバレッジの計装（coverx.sober — `sober build --cover` / `sober test --cover`）: 変換するpackageの非テストのファイルを変換する。
    // cover_pkg = 変換するpackageのパターン（空 = stdの外の全部・`p` = package p・`p/...` = pとその下）
    cover bool
    cover_pkg []string
    // mutation testing の変換（mutx.sober — `sober test --mutate`）: 0 = 無し・1 = schemata（全部のミュータントを1本に）・k + 2 = ミュータントkだけ。
    // coverを真にして使う（変換するファイルとStartの置き方は計装と同じ — 点はミュータントの点だけ）
    mutate int
    // テストの構成の差し替え（doubles.sober）: dbl_t[i] の package のファイルを double のディレクトリ dbl_d[i] から読む
    dbl_t []string
    dbl_d []string
    // 起点のsober.mod（mod.sober — loadがfsmのパスで読む。depのディレクトリの解決と木での名前）
    mod Mod
}

// Manifestのテキスト（1行目 = entry、2行目 = stdの格納場所、3行目以降 = ファイル一覧。空行は捨てる）を読む。
// 行が 2 本に満たなければ false（compiler/tools の標準入力の形 — argv と readdir が無いための代役）
// 行が UTF-8 でなくても false
func ManifestOf(b []byte) (Manifest, bool) {
    mut ls := mut []string{}
    mut s := 0
    for i <- iter.Range(0, len(b) + 1) {
        if i == len(b) || b[i] == '\n' {
            if i > s {
                l := string(b[s:i]) catch return Manifest{}, false
                ls = append(ls, l)
            }
            s = i + 1
        }
    }
    fs := freeze(ls)
    if len(fs) < 2 {
        return Manifest{}, false
    }
    return Manifest{fs[0], fs[1], fs[2:len(fs)], "", "", false, []string{}, 0, []string{}, []string{}, NoMod()}, true
}

// load の結果（Zig の ast.Program のうち loader が決める部分）。表は全部「ロード順」の平らな列
type Program struct {
    // ファイル（ロード順 — package ごとに連続する）
    trees []ast.Tree
    file_pkg []int
    // package（ロード順）。files は [pkg_lo, pkg_hi)
    pkg_path []string
    pkg_name []string
    pkg_lo []int
    pkg_hi []int
    // import 表（package ごと、参照名は package 内で一意）
    imp_pkg []int
    imp_ref []string
    imp_path []string
    // 関数（ファイル順 × 宣言順）。callees は [fn_clo, fn_chi) が callees の範囲
    fn_file []int
    fn_node []int
    fn_expands []bool
    fn_mut_def []bool
    fn_closed []bool
    fn_has_try []bool
    fn_clo []int
    fn_chi []int
    callees []string
    // const（ファイル順 × 宣言順）
    c_file []int
    c_node []int
    c_value []int
    c_has []bool
    c_dict []bool
    // 組み込み error の variant（ロード順 × ファイル順 × 宣言順）
    err_name []string
    err_pkg []int
    // ファイルのパスとstdのフラグ（treesと同じ順 — 診断の位置を引くためにソースを読み直す: SourceFs）
    file_path []string
    file_std []bool
    // std のソースの表（LoadFs / LoadView に渡された焼き込み — lower が panic の点の行・列を出すのに SourceFs で読み直す）
    std_src map[string]string
    // 値の位置のラムダの捕捉の表（loader/fnval.sober。ラムダは [cap_file, cap_node] で引き、
    // 捕捉の名前はcap_names[cap_lo, cap_hi)。捕捉0本でも「値の位置」のマークとして載る — desugar / lowerが同じ判定を読む）
    cap_file []int
    cap_node []int
    cap_lo []int
    cap_hi []int
    cap_names []string
    // ラムダごとの借りの仮引数のビット（i 番目の仮引数が匿名の関数型 = 借り — (α-L0)・desugar/filecheck が読む）
    cap_brw []int
    // 展開待ちの捕捉（loader/fnval.soberのFnVals.cap_pendと同じ詰めた列 — 名前ごとのターゲット・行ごとの流れのフラグ・ターゲットごとの流れる行）
    cap_pend []int
    // 省略可の匿名関数型の仮引数を持つ関数の変換（loader/optfn.sober — [ファイル, 宣言の節, 節の区間lo, hi) の4ワードずつ。変換は元の宣言と同じ字句の区間を持つので、
    // 節がどの関数に属するかは字句でなく節の区間で引く — desugarのZBlock。analyzerは公開関数の @errorsのtightnessをこれらに掛けない — どの組の変換も全部の分岐を持たない）
    z_decl []int
    // カバレッジの点（coverx.sober — [ファイル, 字句, 種類] の3ワードずつ・番号 = 添字 / 3）と点の表の鍵（変換しないbuildは空）
    cover_pts []int
    cover_key string
    // テストの構成の差し替えの契約の検査が読んだ本物のファイル（doubles.sober — 読んだファイルの照合に足す）
    contract_files []string
}

// 位置つきの失敗のProgram（診断が位置を引けるようにファイルのパスとstdのフラグだけを持たせる — SourceFs）
func located(fpath []string, fstd []bool) Program {
    mut p := Program{}
    p.file_path = fpath
    p.file_std = fstd
    return p
}

// package pkg のpathのファイルをカバレッジの計装で変換するか（std・テストのファイル・double・合成のテストのmainの外 — stdは計装のimportの推移的な依存とループになりうる。
// doubleはテストの道具で被検体でない — 計装もミューテーションも打たない）
func coverOn(m Manifest, path string, std bool, pkg string) bool {
    return m.cover && !std && !strings.HasSuffix(path, "_test.sober") && !isDoubleFile(path) && path != TestMainPath() && coverPkgIs(m.cover_pkg, pkg)
}

// package pkg が変換するpackageのパターンの列patsに当たるか（空 = 全部・`p` = pだけ・`p/...` = pとその下・`...` = 全部）
func coverPkgIs(pats []string, pkg string) bool {
    if len(pats) == 0 {
        return true
    }
    for i <- iter.Range(0, len(pats)) {
        q := pats[i]
        if q == pkg || q == "..." {
            return true
        }
        if strings.HasSuffix(q, "/...") {
            b := strings.TrimSuffix(q, "/...")
            if pkg == b || strings.HasPrefix(pkg, b + "/") {
                return true
            }
        }
    }
    return false
}

// pathのファイルの木に計装のimportを足すか（変換するファイル + 計装のbuildの合成のテストのmain — 書き出し先を開く $cover.Startを置く）
func coverImp(m Manifest, path string, std bool, pkg string) bool {
    return coverOn(m, path, std, pkg) || (m.cover && path == TestMainPath())
}

// path を import する最初の import 宣言の位置（ファイルの読み込み順）
func importAt(trees []ast.Tree, path string) diag.Pos {
    for f <- iter.Range(0, len(trees)) {
        t := trees[f]
        imps := t.nodes[t.file].b
        for k <- iter.Range(0, ast.ListLen(t, imps)) {
            im := t.nodes[ast.ListAt(t, imps, k)]
            if StrIs(t, im.b, path) {
                return diag.Pos{file: f, tok: im.tok}
            }
        }
    }
    return diag.None()
}

// xs に x があるか
func has(xs []string, x string) bool {
    for i <- iter.Range(0, len(xs)) {
        if xs[i] == x {
            return true
        }
    }
    return false
}

// isStd は予約 prefix `std/` の package か
// isInternal は std の実装の詳細の package のパスか（`std/internal/…` — std の中のファイルからだけ import できる — 20 節）
func isInternal(p string) bool {
    return strings.HasPrefix(p, "std/internal/")
}

// import 節 im がコンパイラの合成した暗黙の import か（参照名が `$` で始まる — 利用者は `$` を綴れない。parser の implicitImports）。
// 合成のimportはstd/internal/… の検問の外（20 節 — 補間・`string(b)`・floatの印字の裏方の配置先はinternal）。
// `sober test` の合成のテストの main（TestMainPath — 実在しないパスの予約・利用者のファイルは置けない）も外: その import はテストする package と std/os だけで、
// `sober test std/internal/…`（stdの内側のpackageの単体テスト）を走らせるAPI
func synthImport(t ast.Tree, im ast.Node) bool {
    return im.a >= 0 && strings.HasPrefix(Name(t, im.a), "$")
}

// import のパスの全段が小文字の識別子（a-z・0-9・_ — 数字始まりでない）でキーワードでないか（パスがそのまま修飾子になる — 20 節）
func importPathOk(p string) bool {
    for seg <- strings.Split(p, "/") {
        b := bytes(seg)
        if len(b) == 0 {
            return false
        }
        for c <- b {
            if !(c >= 'a' && c <= 'z' || c >= '0' && c <= '9' || c == '_') {
                return false
            }
        }
        ts := lexer.Lex(b)
        if ts[0].tag != lexer.Identifier || ts[0].end != len(b) {
            return false
        }
    }
    return true
}

func isStd(p string) bool {
    return strings.HasPrefix(p, "std/")
}

// ファイルを読む（stdは格納場所の下から。fsm = LoadFsのときは焼き込んだ表smから）
func readSrc(m Manifest, fsm bool, sm map[string]string, path string, std bool) ([]byte, bool) {
    if path == TestMainPath() {
        return bytes(m.test_main), m.test_main != ""
    }
    if std && fsm {
        v := sm[path]
        if v != nil {
            return bytes(v), true
        }
        return []byte{}, false
    }
    if std {
        return readPath(m.std_root + "/" + path)
    }
    return readPath(path)
}

func readPath(full string) ([]byte, bool) {
    b := io.ReadFile(full) catch return []byte{}, false
    return b, true
}

// 1 ファイルを読んで parse する（失敗なら拒否 — diag のラベル）。
// 1 ファイル 1 region（language.md 21 節の「長寿命の結果 + フェーズ scratch」）: ソースのバイト列・字句列・parser の作業領域は
// この関数の region に置いて捨て、戻りの境界コピーで木（節の表とデータプール）だけを呼び手へ持ち出す
// fi は Program でのこのファイルの番号（文法に合わない拒否の位置 = 最遠到達の近似 parser.FarthestTok — 呼び手は fi 番目にこのファイルのパスを置いた located を返す）
func parseFile(m Manifest, fsm bool, sm map[string]string, path string, std bool, fi int, pc PCache) (ast.Tree, PcPut, error?) {
    src, ok := readSrc(m, fsm, sm, path, std)
    if !ok {
        return ast.Tree{[]ast.Node{}, []int{}, 0 - 1}, pcNone(), diag.ReadFail{at: diag.None()}
    }
    // parseのキャッシュ（pcache.sober — 格納場所を使うbuildだけ。当たりは字句・構文・catchExprsを飛ばす）
    kk := if pc.on { pcKey(src) } else { PcKey{0, 0} }
    e := if pc.on { pcFind(pc, kk.a, kk.b) } else { 0 - 1 }
    if e >= 0 && !pc.vfy {
        ht, hok := pcDec(pc, e)
        if hok {
            return ht, PcPut{1, kk.a, kk.b, []byte{}, path}, nil
        }
    }
    t, perr := parseSrc(src, fi)
    if perr != nil {
        return t, pcNone(), perr
    }
    // catch式・列の要素のフィールドへの代入を既存の形へ変換する（catchx.sober・elemassign.sober — 以降のフェーズは変換した後の木だけを読む）。格納場所を使わないパスは束縛せずに返す（束縛すると木を
    // この関数のregionに作ってから変換するので、境界コピーが1回増える — 自己buildで +0.03 G）
    if !pc.on {
        return surfaceRewrites(t), pcNone(), nil
    }
    ct := surfaceRewrites(t)
    v := pcEnc(ct)
    mut st := 2
    if pc.vfy && e >= 0 {
        // 検証モード: 値が格納場所の値と違えばlowerのbcAddがstale（鍵の穴）で特定する。同じなら読み戻しの照合（読み戻した木 ≡ parseした木 —
        // 自分とは整合する欠けた符号・読みの誤り）
        st = 3
        if pcSame(pc, e, v) {
            rt, rok := pcDec(pc, e)
            st = if rok && pcTreeEq(rt, ct) { 3 } else { 4 }
        }
    }
    return ct, PcPut{st, kk.a, kk.b, v, path}, nil
}

// ソースsrcの字句 + 構文（loaderの変換〔catchExprs〕の前の木）
@errors(diag.LeadingZero, diag.LitRange, diag.GrammarMismatch)
func parseSrc(src []byte, fi int) (ast.Tree, error?) {
    ts := lexer.Lex(src)
    // 先頭が 0 の 10 進（`010`）は字句で拒否 — Go の旧来の 8 進と読み違える（syntax.md 決定 18 — 8 進は `0o755` だけ）
    for k <- iter.Range(0, len(ts)) {
        x := ts[k]
        if x.tag == lexer.IntegerLiteral && x.end - x.start > 1 && src[x.start] == '0' && lexer.IsDecimalDigit(int(src[x.start + 1])) {
            return ast.Tree{[]ast.Node{}, []int{}, 0 - 1}, diag.LeadingZero{at: diag.Pos{file: fi, tok: k}}
        }
    }
    t, pok := parser.Parse(src, ts)
    if !pok {
        far := parser.FarthestTok(src, ts)
        // 値が型に収まらないリテラル（intの範囲外・floatで ±Infに丸まる）があればparserはそこで必ず落ちる — 文法の不一致に紛れさせず明示する
        // （拒否のパスだけで数える — 受理のパスはparserの値の計算が判定を兼ねる）
        for k <- iter.Range(0, len(ts)) {
            lk := litOut(src, ts[k])
            if lk >= 0 {
                return t, diag.LitRange{at: diag.Pos{file: fi, tok: k}, kind: lk}
            }
        }
        return t, diag.GrammarMismatch{at: if far >= 0 { diag.Pos{file: fi, tok: far} } else { diag.None() }}
    }
    return t, nil
}

// トークン x が値の収まらないリテラルなら種類（0 = int・1 = float）、でなければ -1
func litOut(src []byte, x lexer.Token) int {
    if x.tag == lexer.IntegerLiteral {
        _, _, ok := lexer.IntValue(src, x.start, x.end)
        return if ok { -1 } else { 0 }
    }
    if x.tag == lexer.FloatLiteral {
        _, ok := lexer.FloatBits(src, x.start, x.end)
        return if ok { -1 } else { 1 }
    }
    return -1
}

// parseFileの変換の前の木（格納場所を使わないパス — 小分けのcheckの視点のtarget。変換した木は呼び手がcatchExprsで作る）
@errors(diag.ReadFail, diag.LeadingZero, diag.LitRange, diag.GrammarMismatch)
func parseFileRaw(m Manifest, fsm bool, sm map[string]string, path string, std bool, fi int) (ast.Tree, error?) {
    src, ok := readSrc(m, fsm, sm, path, std)
    if !ok {
        return ast.Tree{[]ast.Node{}, []int{}, 0 - 1}, diag.ReadFail{at: diag.None()}
    }
    return parseSrc(src, fi)
}

// package のディレクトリ dir の .sober ファイル（ファイル名順）。Manifest なら一覧のうち dirname が dir のもの（一覧の順）、
// fsm（LoadFs）なら io.ReadDir の通常ファイルで .sober で終わるもの（Zig 版 readPkgDir と同じ規則 — ReadDir は名前のバイト順）。
// fsmのstdは焼き込んだ表smのキーから（keysmのフェーズ — stage2はcwdのstd/ に依存しない）
func dirFiles(m Manifest, fsm bool, sm map[string]string, dir string) []string {
    for i <- iter.Range(0, len(m.dbl_t)) {
        if m.dbl_t[i] == dir {
            return pkgFiles(m, fsm, sm, m.dbl_d[i])
        }
    }
    return noTests(m, dir, pkgFiles(m, fsm, sm, dir))
}

// `_test.sober` と `_double.sober` のファイルを除いた列（テストのビルドの対象 m.test の package の `_test.sober` は残す — testmain.sober。
// `_double.sober` は差し替えの表が名前で指定したディレクトリからだけ読む — dirFiles）
func noTests(m Manifest, dir string, fs []string) []string {
    mut out := mut []string{}
    for i <- iter.Range(0, len(fs)) {
        if !strings.HasSuffix(fs[i], "_double.sober") && (dir == m.test || !strings.HasSuffix(fs[i], "_test.sober")) {
            out = append(out, fs[i])
        }
    }
    return freeze(out)
}

func pkgFiles(m Manifest, fsm bool, sm map[string]string, dir string) []string {
    if fsm && isStd(dir) {
        return stdFiles(sm, dir)
    }
    if fsm {
        return readPkgDir(modDir(m.mod, dir))
    }
    mut out := mut []string{}
    mut i := 0
    while i < len(m.files) {
        f := m.files[i]
        if Dirname(f) == dir && f != dir {
            out = append(out, f)
        }
        i += 1
    }
    return freeze(out)
}

// ディレクトリ dir の通常ファイルで名前が .sober で終わるもの（パス = dir/名前、名前のバイト順）。開けなければ空
func readPkgDir(dir string) []string {
    mut out := mut []string{}
    es := io.ReadDir(dir) catch return freeze(out)
    mut i := 0
    while i < len(es) {
        // 通常のファイル = 下の3つ以外（variantの名前Regularを書かない形 — ブートストラップチェーンの行を足すまでbootの焼き込みのstdと今のstdの両方で通る）
        isFile := switch es[i].Kind {
        case io.Dir{}: false
        case io.Symlink{}: false
        case io.Irregular{}: false
        default: true
        }
        nm := es[i].Name
        if isFile && strings.HasSuffix(nm, ".sober") {
            out = append(out, dir + "/" + nm)
        }
        i += 1
    }
    return freeze(out)
}

// 焼き込んだ表 sm のキーのうち dir 直下の .sober ファイル（パスのバイト順 — readPkgDir の名前順と同じ並び）
func stdFiles(sm map[string]string, dir string) []string {
    mut out := mut []string{}
    ks := keys(sm)
    for i <- iter.Range(0, len(ks)) {
        p := ks[i]
        if Dirname(p) == dir && strings.HasSuffix(p, ".sober") {
            // 挿入ソート（表の順は @embed の走査順 — 並びの約束をここで閉じる）
            out = append(out, p)
            mut j := len(out) - 1
            while j > 0 && ByteLess(out[j], out[j - 1]) {
                t := out[j]
                out[j] = out[j - 1]
                out[j - 1] = t
                j -= 1
            }
        }
    }
    return freeze(out)
}

// path が開けるディレクトリか（Zig 版 readEntry の openDir と同じ判定）
func isDir(path string) bool {
    es, err := io.ReadDir(path)
    return err == nil
}

// Manifest の entry（.sober ファイルか main package のディレクトリ）から Program を組む（失敗なら拒否 — diag のラベル。
// 位置つきの拒否なら Program はファイルのパスだけを持つ — SourceFs）
@errors(diag.ReadFail, diag.GrammarMismatch, diag.NoPkgDir, diag.Mod, diag.ImportPath, diag.NoStd, diag.EmbedReceiver, diag.EmbedPattern, diag.EmbedNoMatch, diag.EmbedRead, diag.EmbedFileUtf8, diag.PkgName, diag.RefCollide, diag.NotImported, diag.ImportCycle, diag.Noinline, diag.ErrorHoldsError, diag.RecursiveType, diag.ConstExpr, diag.LocalBuiltin, diag.LocalImport, diag.InternalImport, diag.LocalTop, diag.TParamBuiltin, diag.TParamTop, diag.DeclBuiltin, diag.VariantDup, diag.TopDup, diag.Shadow, diag.PureExprStmt, diag.NilCase, diag.NamedArg, diag.CatchLhs, diag.MultiBind, diag.MutAlias, diag.ForFallible, diag.FnArg, diag.FnOpt, diag.FnCap, diag.Sealed, diag.Identity, diag.PanicLabel, diag.LeadingZero, diag.LitRange, diag.AssertOutsideTest, diag.Layout, diag.TypeDecl, diag.JsonShape, diag.Intrinsic, diag.Par, diag.Double, diag.Cell)
func Load(m Manifest) (Program, error?) {
    mut sink := PcSink{}
    return load(m, false, map[string]string{}, PcOff(), mut sink)
}

// stage2 の CLI の入口: entry（.sober ファイルか main package のディレクトリ — cwd 相対）から、package のディレクトリを
// io.ReadDir で読み、`std/` の中身は焼き込んだ表 sm（パス → ソース — `@embed("std/**/*.sober")`）から取る。
// stdのpackageのファイル一覧も表のキーから引く（keysmのフェーズ — R35-2の暫定ReadDirを撤去）
@errors(diag.ReadFail, diag.GrammarMismatch, diag.NoPkgDir, diag.Mod, diag.ImportPath, diag.NoStd, diag.EmbedReceiver, diag.EmbedPattern, diag.EmbedNoMatch, diag.EmbedRead, diag.EmbedFileUtf8, diag.PkgName, diag.RefCollide, diag.NotImported, diag.ImportCycle, diag.Noinline, diag.ErrorHoldsError, diag.RecursiveType, diag.ConstExpr, diag.LocalBuiltin, diag.LocalImport, diag.InternalImport, diag.LocalTop, diag.TParamBuiltin, diag.TParamTop, diag.DeclBuiltin, diag.VariantDup, diag.TopDup, diag.Shadow, diag.PureExprStmt, diag.NilCase, diag.NamedArg, diag.CatchLhs, diag.MultiBind, diag.MutAlias, diag.ForFallible, diag.FnArg, diag.FnOpt, diag.FnCap, diag.Sealed, diag.Identity, diag.PanicLabel, diag.LeadingZero, diag.LitRange, diag.AssertOutsideTest, diag.Layout, diag.TypeDecl, diag.JsonShape, diag.Intrinsic, diag.Par, diag.Double, diag.Cell)
func LoadFs(entry string, sm map[string]string) (Program, error?) {
    if doubleDir(Manifest{}, true, sm, entry) {
        return loadDouble(entry, sm)
    }
    mut sink := PcSink{}
    return load(Manifest{entry, "", []string{}, "", "", false, []string{}, 0, []string{}, []string{}, NoMod()}, true, sm, PcOff(), mut sink)
}

// LoadFsにparseのキャッシュの読みの表pcを足したもの（buildの格納場所を使うパス — appがlower.BcParseViewで組む）。
// ファイルごとの読みの結果はsinkへ（lowerが書きのバッチへ）。test = テストのビルド（LoadTestFs — キャッシュは使わない）
@errors(diag.ReadFail, diag.GrammarMismatch, diag.NoPkgDir, diag.Mod, diag.ImportPath, diag.NoStd, diag.EmbedReceiver, diag.EmbedPattern, diag.EmbedNoMatch, diag.EmbedRead, diag.EmbedFileUtf8, diag.PkgName, diag.RefCollide, diag.NotImported, diag.ImportCycle, diag.Noinline, diag.ErrorHoldsError, diag.RecursiveType, diag.ConstExpr, diag.LocalBuiltin, diag.LocalImport, diag.InternalImport, diag.LocalTop, diag.TParamBuiltin, diag.TParamTop, diag.DeclBuiltin, diag.VariantDup, diag.TopDup, diag.Shadow, diag.PureExprStmt, diag.NilCase, diag.NamedArg, diag.CatchLhs, diag.MultiBind, diag.MutAlias, diag.ForFallible, diag.FnArg, diag.FnOpt, diag.FnCap, diag.Sealed, diag.Identity, diag.PanicLabel, diag.LeadingZero, diag.LitRange, diag.AssertOutsideTest, diag.Layout, diag.TypeDecl, diag.JsonShape, diag.Intrinsic, diag.Par, diag.TestSignature, diag.Double, diag.Cell)
func LoadFsC(entry string, sm map[string]string, pc PCache, test bool, sink mut PcSink) (Program, error?) {
    if test {
        return LoadTestFs(entry, sm)
    }
    if doubleDir(Manifest{}, true, sm, entry) {
        return loadDouble(entry, sm)
    }
    return load(Manifest{entry, "", []string{}, "", "", false, []string{}, 0, []string{}, []string{}, NoMod()}, true, sm, pc, mut sink)
}

// LoadFsのカバレッジの計装つき（利用者の非テストのファイルの分岐にカウンタ — coverx.sober。parseのキャッシュは使わない）
@errors(diag.ReadFail, diag.GrammarMismatch, diag.NoPkgDir, diag.Mod, diag.ImportPath, diag.NoStd, diag.EmbedReceiver, diag.EmbedPattern, diag.EmbedNoMatch, diag.EmbedRead, diag.EmbedFileUtf8, diag.PkgName, diag.RefCollide, diag.NotImported, diag.ImportCycle, diag.Noinline, diag.ErrorHoldsError, diag.RecursiveType, diag.ConstExpr, diag.LocalBuiltin, diag.LocalImport, diag.InternalImport, diag.LocalTop, diag.TParamBuiltin, diag.TParamTop, diag.DeclBuiltin, diag.VariantDup, diag.TopDup, diag.Shadow, diag.PureExprStmt, diag.NilCase, diag.NamedArg, diag.CatchLhs, diag.MultiBind, diag.MutAlias, diag.ForFallible, diag.FnArg, diag.FnOpt, diag.FnCap, diag.Sealed, diag.Identity, diag.PanicLabel, diag.LeadingZero, diag.LitRange, diag.AssertOutsideTest, diag.Layout, diag.TypeDecl, diag.JsonShape, diag.Intrinsic, diag.Par, diag.Double, diag.Cell)
func LoadFsCover(entry string, sm map[string]string) (Program, error?) {
    mut sink := PcSink{}
    return load(Manifest{entry, "", []string{}, "", "", true, []string{}, 0, []string{}, []string{}, NoMod()}, true, sm, PcOff(), mut sink)
}

// LoadFsの mutation testing の変換つき（mutx.sober — 全部のミュータントを1本に。開発のAPI `sober build --mutate` — 型付けが通るかの検査）
@errors(diag.ReadFail, diag.GrammarMismatch, diag.NoPkgDir, diag.Mod, diag.ImportPath, diag.NoStd, diag.EmbedReceiver, diag.EmbedPattern, diag.EmbedNoMatch, diag.EmbedRead, diag.EmbedFileUtf8, diag.PkgName, diag.RefCollide, diag.NotImported, diag.ImportCycle, diag.Noinline, diag.ErrorHoldsError, diag.RecursiveType, diag.ConstExpr, diag.LocalBuiltin, diag.LocalImport, diag.InternalImport, diag.LocalTop, diag.TParamBuiltin, diag.TParamTop, diag.DeclBuiltin, diag.VariantDup, diag.TopDup, diag.Shadow, diag.PureExprStmt, diag.NilCase, diag.NamedArg, diag.CatchLhs, diag.MultiBind, diag.MutAlias, diag.ForFallible, diag.FnArg, diag.FnOpt, diag.FnCap, diag.Sealed, diag.Identity, diag.PanicLabel, diag.LeadingZero, diag.LitRange, diag.AssertOutsideTest, diag.Layout, diag.TypeDecl, diag.JsonShape, diag.Intrinsic, diag.Par, diag.Double, diag.Cell)
func LoadFsMutate(entry string, sm map[string]string) (Program, error?) {
    mut sink := PcSink{}
    return load(Manifest{entry, "", []string{}, "", "", true, []string{}, 1, []string{}, []string{}, NoMod()}, true, sm, PcOff(), mut sink)
}

// LoadFs で読んだ Program p の f 番目のファイルのソースを読み直す（診断の位置を引く — 読めなければ ok = false）
func SourceFs(p Program, f int, sm map[string]string) ([]byte, bool) {
    if f < 0 || f >= len(p.file_path) {
        return []byte{}, false
    }
    return readSrc(Manifest{p.file_path[f], "", []string{}, "", "", false, []string{}, 0, []string{}, []string{}, NoMod()}, true, sm, p.file_path[f], p.file_std[f])
}

func load(m0 Manifest, fsm bool, sm map[string]string, pc PCache, sink mut PcSink) (Program, error?) {
    // 起点のsober.mod（mod.sober — fsmのパスだけ。Manifestのパス〔compiler/tools〕は持たない）
    mut m := m0
    if fsm {
        md, mpath, merr := ReadMod(sm)
        if merr != nil {
            return located([]string{mpath}, []bool{false}), merr
        }
        m.mod = md
    }
    // ── ファイル集合（未ロードの import を読み足して繰り返す — Zig の linkLoop）──
    mut trees := mut []ast.Tree{}
    mut fpkg := mut []string{}
    mut fpath := mut []string{}
    mut fstd := mut []bool{}
    // 変換するファイルのパス（カバレッジの計装 — 利用者の非テストのファイル）
    mut cov := mut []string{}
    main := "main"
    entryIsFile := if fsm { !isDir(m.entry) } else { has(m.files, m.entry) }
    if entryIsFile {
        t, pp, perr := parseFile(m, fsm, sm, m.entry, false, 0, pc)
        if perr != nil {
            fpath = append(fpath, m.entry)
            fstd = append(fstd, false)
            return located(freeze(fpath), freeze(fstd)), perr
        }
        trees = append(trees, if coverImp(m, m.entry, false, m.entry) { coverImport(t) } else { t })
        if coverOn(m, m.entry, false, m.entry) {
            cov = append(cov, m.entry)
        }
        if pc.on {
            table.Push(mut sink.t, pp)
        }
        fpkg = append(fpkg, main)
        fpath = append(fpath, m.entry)
        fstd = append(fstd, false)
    } else {
        fs := dirFiles(m, fsm, sm, m.entry)
        if len(fs) == 0 {
            return Program{}, diag.NoPkgDir{at: diag.None()}
        }
        mut i := 0
        while i < len(fs) {
            t, pp, perr := parseFile(m, fsm, sm, fs[i], false, len(trees), pc)
            if perr != nil {
                fpath = append(fpath, fs[i])
                fstd = append(fstd, false)
                return located(freeze(fpath), freeze(fstd)), perr
            }
            trees = append(trees, if coverImp(m, fs[i], false, m.entry) { coverImport(t) } else { t })
            if coverOn(m, fs[i], false, m.entry) {
                cov = append(cov, fs[i])
            }
            if pc.on {
                table.Push(mut sink.t, pp)
            }
            fpkg = append(fpkg, main)
            fpath = append(fpath, fs[i])
            fstd = append(fstd, false)
            i += 1
        }
    }
    mut seen := mut []string{}
    mut going := true
    // テストの構成の差し替え（doubles.sober）: テストの package を読み終えた巡の頭で @doubles を読み、以降の巡は相手を double のディレクトリから読む
    mut mm := m
    mut wire := if len(m.dbl_t) > 0 { presetWiring(m) } else { noWiring() }
    mut wired := m.test == ""
    mut dblFile := mut []int{}
    mut dblRef := mut []string{}
    while going {
        if !wired && has(freeze(fpkg), m.test) {
            wired = true
            mut tt := mut []ast.Tree{}
            for i <- iter.Range(0, len(trees)) {
                tt = append(tt, trees[i])
            }
            w, werr := wiringOf(m, fsm, sm, freeze(tt), freeze(fpkg), freeze(fpath))
            if werr != nil {
                return located(freeze(fpath), freeze(fstd)), werr
            }
            wire = w
            mm.dbl_t = w.t
            mm.dbl_d = w.d
        }
        if len(wire.d) > 0 {
            for i <- iter.Range(0, len(trees)) {
                t := trees[i]
                imps := t.nodes[t.file].b
                for k <- iter.Range(0, ast.ListLen(t, imps)) {
                    im := t.nodes[ast.ListAt(t, imps, k)]
                    q := wireIndex(wire, Name(t, im.b))
                    if q >= 0 {
                        if !strings.HasSuffix(fpath[i], "_test.sober") && !isDoubleFile(fpath[i]) {
                            return located(freeze(fpath), freeze(fstd)), diag.Double{at: diag.Pos{file: i, tok: im.tok}, kind: 11}
                        }
                        dblFile = append(dblFile, i)
                        dblRef = append(dblRef, if im.a >= 0 { Name(t, im.a) } else { QualOf(wire.d[q]) })
                    }
                }
                rt, changed := rewireImports(t, wire)
                if changed {
                    trees[i] = rt
                }
            }
        }
        // 1 巡: 全ファイルの import のうち、まだ package が無く試してもいないもの（出現順）
        loaded := freeze(fpkg)
        mut pending := mut []string{}
        mut i := 0
        while i < len(trees) {
            t := trees[i]
            imps := t.nodes[t.file].b
            mut k := 0
            while k < ast.ListLen(t, imps) {
                im := t.nodes[ast.ListAt(t, imps, k)]
                // import のパスの UTF-8 の検査はここ 1 回（以降の Name(t, im.b) は検査済み）— UTF-8 でないパスの package は無い
                path, pok := NameOk(t, im.b)
                if !pok {
                    return located(freeze(fpath), freeze(fstd)), diag.NoPkgDir{at: diag.Pos{file: i, tok: im.tok}}
                }
                if !synthImport(t, im) && fpath[i] != TestMainPath() && !importPathOk(path) {
                    return located(freeze(fpath), freeze(fstd)), diag.ImportPath{at: diag.Pos{file: i, tok: im.tok}}
                }
                // std/internal/… は std の中からだけ（20 節 — パスの字面で判定: package を読む前に止める）
                if isInternal(path) && !fstd[i] && !synthImport(t, im) && fpath[i] != TestMainPath() {
                    return located(freeze(fpath), freeze(fstd)), diag.InternalImport{at: diag.Pos{file: i, tok: im.tok}}
                }
                if !has(loaded, path) && !has(freeze(seen), path) {
                    pending = append(pending, path)
                }
                k += 1
            }
            i += 1
        }
        // 巡の前読み（prepar.sober — 子 task で parse。ワーカー 1 は前読みしない）
        pr := preParse(mm, fsm, sm, freeze(pending), freeze(seen), len(trees), pc)
        mut pk := 0
        mut j := 0
        while j < len(pending) {
            p := pending[j]
            if !has(freeze(seen), p) {
                seen = append(seen, p)
                fs := if pr.on { pr.fss[j] } else { dirFiles(mm, fsm, sm, p) }
                if len(fs) == 0 {
                    if doubleDir(m, fsm, sm, p) {
                        return located(freeze(fpath), freeze(fstd)), diag.Double{at: importAt(freeze(trees), p), kind: 12}
                    }
                    if isStd(p) {
                        return located(freeze(fpath), freeze(fstd)), diag.NoStd{at: importAt(freeze(trees), p)}
                    }
                    return located(freeze(fpath), freeze(fstd)), diag.NoPkgDir{at: importAt(freeze(trees), p)}
                }
                for q <- iter.Range(0, len(fs)) {
                    t, pp, perr := preOr(pr, pk, mm, fsm, sm, fs[q], isStd(p), len(trees), pc)
                    pk += 1
                    if perr != nil {
                        fpath = append(fpath, fs[q])
                        fstd = append(fstd, isStd(p))
                        return located(freeze(fpath), freeze(fstd)), perr
                    }
                    // dep の package のファイル: 相手のモジュールの中の import を dep の名前の下へ（mod.sober）
                    dt := if depOf(m.mod, p) >= 0 { depImports(t, firstSeg(p)) } else { t }
                    trees = append(trees, if coverImp(m, fs[q], isStd(p), p) { coverImport(dt) } else { dt })
                    if coverOn(m, fs[q], isStd(p), p) {
                        cov = append(cov, fs[q])
                    }
                    if pc.on {
                        table.Push(mut sink.t, pp)
                    }
                    fpkg = append(fpkg, p)
                    fpath = append(fpath, fs[q])
                    fstd = append(fstd, isStd(p))
                }
            }
            j += 1
        }
        going = len(pending) > 0
    }
    Stage("parsed")
    cfs := contractFiles(m, fsm, sm, wire)
    dts, derr := dblCheck(m, fsm, sm, wire, freeze(trees), freeze(fpkg), freeze(fpath), freeze(dblFile), freeze(dblRef))
    if derr != nil {
        for i <- iter.Range(0, len(cfs)) {
            fpath = append(fpath, cfs[i])
            fstd = append(fstd, false)
        }
        return located(freeze(fpath), freeze(fstd)), derr
    }
    r, err := finish(dts, freeze(fpkg), freeze(fpath), freeze(fstd), freeze(cov), m.cover, m.mutate, m.mod)
    Stage("f-fin")
    mut p := r
    mut cf := mut []string{}
    for i <- iter.Range(0, len(cfs)) {
        cf = append(cf, cfs[i])
    }
    for i <- iter.Range(0, len(m.mod.files)) {
        cf = append(cf, m.mod.files[i])
    }
    p.contract_files = freeze(cf)
    p.std_src = sm
    return p, err
}

// ファイルの集合（ロード順 — packageごとに連続）からProgramを組む（@layout・@embed・固定テンプレートの変換・表・検査）。
// load（import を辿って集める）と LoadView（link.txt の順に .sobi とソースを読む）が共用する
@errors(diag.ReadFail, diag.GrammarMismatch, diag.NoPkgDir, diag.Mod, diag.ImportPath, diag.NoStd, diag.EmbedReceiver, diag.EmbedPattern, diag.EmbedNoMatch, diag.EmbedRead, diag.EmbedFileUtf8, diag.PkgName, diag.RefCollide, diag.NotImported, diag.ImportCycle, diag.Noinline, diag.ErrorHoldsError, diag.RecursiveType, diag.ConstExpr, diag.LocalBuiltin, diag.LocalImport, diag.InternalImport, diag.LocalTop, diag.TParamBuiltin, diag.TParamTop, diag.DeclBuiltin, diag.VariantDup, diag.TopDup, diag.Shadow, diag.PureExprStmt, diag.NilCase, diag.NamedArg, diag.CatchLhs, diag.MultiBind, diag.MutAlias, diag.ForFallible, diag.FnArg, diag.FnOpt, diag.FnCap, diag.Sealed, diag.Identity, diag.PanicLabel, diag.LeadingZero, diag.LitRange, diag.AssertOutsideTest, diag.Layout, diag.TypeDecl, diag.JsonShape, diag.Intrinsic, diag.Par, diag.Double, diag.Cell)
func finish(trees0 []ast.Tree, fpkg []string, fpath []string, fstd []bool, cov []string, covOn bool, mutate int, md Mod) (Program, error?) {
    // 木での名前の衝突と alias の参照名（mod.sober — 起点のモジュールのファイルだけ）
    trees, mderr := modTrees(trees0, fpkg, fstd, md)
    if mderr != nil {
        return located(fpath, fstd), mderr
    }
    // std/internal/… の検問（20 節 — loadはimportを辿る巡で先に止める。LoadView〔.sobiの小分け〕のパスはここで）。
    // .sobiの木はfstdが立たないのでpackageのパスでもstdを見る（std/tlsの .sobiは公開の型のフィールドのためにstd/internal/hsをimportする — intrinsicAllと同じ形）
    for f <- iter.Range(0, len(trees)) {
        if !fstd[f] && !isStd(fpkg[f]) && fpath[f] != TestMainPath() {
            t := trees[f]
            imps := t.nodes[t.file].b
            for k <- iter.Range(0, ast.ListLen(t, imps)) {
                im := t.nodes[ast.ListAt(t, imps, k)]
                if isInternal(Name(t, im.b)) && !synthImport(t, im) {
                    return located(fpath, fstd), diag.InternalImport{at: diag.Pos{file: f, tok: im.tok}}
                }
            }
        }
    }
    // 型の別名（alias.sober — language.md 32 節）: 別名を指す名前を実体の名前へ変換し・定義型の下地を検査する。以降のフェーズは変換した後の木（trees1）だけを読む
    //（別名の宣言は検査のバッチの後で剥がす — 名前の規則が別名の名前を型の名前として見る）
    // 複数セグメントの修飾子の畳み（qualfold.sober — `http.server.Serve` の頭を1つの参照名に。以降のフェーズは1レベルの修飾参照だけを見る）
    trees1, atab, alerr := aliasAll(qualFoldAll(trees, fpkg), fpkg)
    if alerr != nil {
        return located(fpath, fstd), alerr
    }
    // std/testing/cell の import の検問と把手の鍵（cellx.sober）
    trees1c, cerr := cellsAll(trees1, fpkg, fpath, fstd)
    if cerr != nil {
        return located(fpath, fstd), cerr
    }
    // `@intrinsic("鍵")` の宣言（intrinsic.sober）: std の中だけ・閉じた鍵・署名の一致
    xerr := intrinsicAll(trees1c, fpkg, fstd)
    if xerr != nil {
        return located(fpath, fstd), xerr
    }
    // @layout（layout.sober — language.md 36 節）: フィールドの型の変換・`layout.X[T]` の差し替え・変換の関数の合成ファイルをpackageの末尾に足す。
    // 以降のフェーズは足した後の列（lay）だけを読む
    lay0, lerr := layoutAll(trees1c, fpkg, fpath, fstd)
    if lerr != nil {
        return located(fpath, fstd), lerr
    }
    // shape[T]（jsonshape.sober — language.md 16 節）: `json.Decode[T](…)` を変換の関数へ・合成ファイルをpackageの末尾に足す
    lay, jerr := jsonAll(lay0.trees, lay0.pkg, lay0.path, lay0.std)
    if jerr != nil {
        return located(lay0.path, lay0.std), jerr
    }
    // `@embed("glob")` の const を「パス → 内容」の map リテラルに畳む（以降は辞書 const — 参照点で展開。節は末尾に足すだけなので既存の添字は動かない）
    ts0, eerr := embedAll(lay.trees)
    if eerr != nil {
        return located(lay.path, lay.std), eerr
    }
    // `T?` のswitchの `case nil:` をifに変換する（nilcase.sober — 脱糖の固定テンプレート。以降の層は変換した後の木だけを読む）
    ts1, nerr := nilCasesAll(ts0)
    if nerr != nil {
        return located(lay.path, lay.std), nerr
    }
    // flow typing の連鎖（`&&` の右辺・`||` の否定側）と早期脱出の後ろをifの入れ子に変換する（flowx.sober）
    ts1f0 := flowAll(ts1)
    // カバレッジの計装（coverx.sober — 利用者の非テストのファイルの分岐にカウンタ。flowxの後: elseの分岐を足すとflowxの変換が外れる）
    // mutation testing の変換は計装の代わりに同じフェーズで（mutx.sober — 両方を掛けると計装がschemataのifを分岐として数える）
    cvo := if mutate != 0 { mutAll(ts1f0, lay.path, lay.pkg, cov, mutate - 2) } else { coverAll(ts1f0, lay.path, lay.pkg, cov, covOn) }
    ts1f := cvo.trees
    // `_test.sober` のstd/quickの変換（quickx.sober — プロパティの値の式を $qassertに包む・Newに囲む関数の名前を入れる）
    ts1q, qerr := quicksAll(ts1f, lay.path)
    if qerr != nil {
        return located(lay.path, lay.std), qerr
    }
    // `_test.sober` のassertを変換する（assert.sober。外のassertは拒否）
    ts2, aerr := assertsAll(ts1q, lay.path)
    if aerr != nil {
        return located(lay.path, lay.std), aerr
    }
    // 宛先構築のマーク（dest.sober: returnに流れ着くリテラル・補間・連結をlowerが呼び手のregionに作る）
    ts := destMarksAll(ts2)
    Stage("f-trees")
    fp := lay.pkg

    pt, perr := pkgTable(ts, fp, md)
    if perr != nil {
        return located(lay.path, lay.std), perr
    }
    it, ierr := importTable(ts, pt)
    if ierr != nil {
        return located(lay.path, lay.std), ierr
    }
    mut cx := Cx{ts, pt.file_pkg, pt.path, pt.lo, pt.hi, it.pkg, it.ref, it.path, tyTab(ts, pt.file_pkg)}

    // ── 循環 import の拒否（外せる package — import 先が全部外れたもの — を外していき、残れば循環）──
    cyc := cycleAt(cx)
    if cyc.file >= 0 {
        return located(lay.path, lay.std), diag.ImportCycle{at: cyc}
    }
    // ── 受理しない再帰の型宣言の拒否（rectype.sober — 値に埋まる閉路・関数型をまたぐ閉路・型引数の変わる参照）──
    rec, rk := recTypeAt(cx)
    if rec.file >= 0 {
        return located(lay.path, lay.std), diag.RecursiveType{at: rec, kind: rk}
    }
    pnames := pt.name

    // ── 検査のバッチ（finpar.sober: ワーカー2以上はファイルごとの子で・最初の拒否はフェーズの順 → ファイルの順）:
    //    多値の型 `(T, error?)` は std/task の Task の型引数にだけ（tupletype.sober）→ import はファイルごと（fileimports.sober）→
    //    名前の検査（ローカル束縛の衝突・組み込みの名前・variant 名の一意 — localnames.sober）→ 式文の検査（exprstmt.sober）──
    bh := checksB(cx, pnames)
    if bh.file >= 0 {
        return located(lay.path, lay.std), bh.err
    }
    // 別名の宣言を型の列から外す（alias.sober — 以降のフェーズとdesugar・lower・analyzerは別名を見ない）
    cx = aliasStripCx(cx, atab)

    // ── 名前付き実引数と `T?` 仮引数の省略を位置引数へ変換し、関数型の実引数に置いた名前付き関数を η 展開する（namedargs.sober — 決定7・eta.sober — 25 節。以降のフェーズは変換した後の木だけを読む）──
    // 関数表（namedargs.soberのfnTab）は変換する前の木で1回組み、namedargs・η 展開・fnval・noderulesが共有する（木の変換は節を足すだけ —
    // 関数の宣言の節と名前のデータの位置は変わらない（3 か所で組み直すより RSS が小さく、出力は同じ）
    Stage("f-checks")
    // 省略可の匿名関数型の仮引数（optfn.sober — language.md 25 節Z）: 名前付き実引数の変換の後に、呼び出し点ごとの有無で関数を変換し分け
    // （`F` / `F$z<有無>`）・`p != nil` の分岐を畳み、続けて η 展開。以降のフェーズは省略可の関数型を見ない（変換が無ければ木も関数表もそのまま）
    merr := fnTyMutOne(cx)
    if merr != nil {
        return located(lay.path, lay.std), merr
    }
    oz, oerr := optEtaAll(cx, fnTab(cx))
    if oerr != nil {
        return located(lay.path, lay.std), oerr
    }
    cx = Cx{oz.trees, cx.file_pkg, cx.pkg_path, cx.pkg_lo, cx.pkg_hi, cx.imp_pkg, cx.imp_ref, cx.imp_path, cx.tys}

    // ── ワーカー局所のlease（lease.sober — region-domain-pool.md 4d節）: task.NewLocal / task.Leaseのウィンドウを普通のSoberとstdの変換先へ変換する ──
    lts, lerr2 := leaseAll(cx)
    if lerr2 != nil {
        return located(lay.path, lay.std), lerr2
    }
    cx = Cx{lts, cx.file_pkg, cx.pkg_path, cx.pkg_lo, cx.pkg_hi, cx.imp_pkg, cx.imp_ref, cx.imp_path, cx.tys}

    // ── panicラベル（panicx.sober — language.md 27 節）: `panic(L{…})` の検査と変換・宣言をBStructに。以降のフェーズは変換した後の木だけを読む ──
    po := panicLabelsAll(cx, pnames, false)
    if po.err != nil {
        return located(lay.path, lay.std), po.err
    }
    cx = Cx{po.trees, cx.file_pkg, cx.pkg_path, cx.pkg_lo, cx.pkg_hi, cx.imp_pkg, cx.imp_ref, cx.imp_path, cx.tys}

    // ── 値の位置の判定と捕捉（fnval.sober: named fn type のフィールドの η 展開・値の位置のラムダの捕捉の表・FnCapの拒否）──
    Stage("f-lease-panic")
    fv, fverr := fnValAll(cx, oz.ft)
    if fverr != nil {
        return located(lay.path, lay.std), fverr
    }
    cx = Cx{fv.trees, cx.file_pkg, cx.pkg_path, cx.pkg_lo, cx.pkg_hi, cx.imp_pkg, cx.imp_ref, cx.imp_path, cx.tys}

    // ── 節の規則のバッチ（noderules.sober — catchの左辺・値1つの束縛に多値・失敗しうる生成元のマーク・封の型のフィールドつきリテラル・同一性のゼロ値・mut実引数の排他）──
    Stage("f-fnval")
    rerr := nodeRules(cx, oz.ft)
    if rerr != nil {
        return located(lay.path, lay.std), rerr
    }

    // ── 関数: expands の確定・callees / has_try・markMutDefs ──
    Stage("f-noderules")
    fs := scanFuncs(cx)
    if fs.bad_noinline != -1 {
        bf := fs.file[fs.bad_noinline]
        return located(lay.path, lay.std), diag.Noinline{at: diag.Pos{file: bf, tok: cx.trees[bf].nodes[fs.node[fs.bad_noinline]].tok}}
    }
    if fs.bad_rec != -1 {
        rf := fs.file[fs.bad_rec]
        return located(lay.path, lay.std), diag.FnCap{at: diag.Pos{file: rf, tok: cx.trees[rf].nodes[fs.node[fs.bad_rec]].tok}, kind: 17}
    }

    et, eterr := errorLabels(cx.trees, cx.file_pkg)
    if eterr != nil {
        return located(lay.path, lay.std), eterr
    }

    // ── const の畳み込み ──
    cs := foldConsts(cx, fs)
    if !cs.ok {
        return located(lay.path, lay.std), diag.ConstExpr{at: cs.bad, kind: cs.why}
    }

    // 書き換えの後の木に別名を指す名前・剥がし残りが無いこと（alias.sober — fail-closed）
    left := aliasLeftCx(cx, atab)
    if left.file >= 0 {
        return located(lay.path, lay.std), diag.TypeDecl{at: left, kind: TD_LEFT}
    }
    Stage("f-done")
    return Program{cx.trees, cx.file_pkg, pt.path, pnames, cx.pkg_lo, cx.pkg_hi, cx.imp_pkg, cx.imp_ref, cx.imp_path,
        fs.file, fs.node, fs.expands, fs.mut_def, fs.closed, fs.has_try, fs.clo, fs.chi, fs.callees,
        cs.file, cs.node, cs.value, cs.has, cs.dict, et.name, et.pkg, lay.path, lay.std, map[string]string{},
        fv.cap_file, fv.cap_node, fv.cap_lo, fv.cap_hi, fv.cap_names, fv.cap_brw,
        fv.cap_pend, oz.zdecl, cvo.pts, cvo.key, []string{}}, nil
}

// package の表（ファイルの出現順 — package のファイルは連続する）: path / name と、ファイルの範囲 [lo, hi)・ファイル → package
type PkgTab struct {
    path []string
    name []string
    lo []int
    hi []int
    file_pkg []int
}

// package 名の字句の番号（文法 `package` identifier `;` がファイルの先頭 — 拒否の位置）
const PKGNAME_TOK = 1

// 木の列 ts（fp = ファイルの package の path）の package の表（package 名がディレクトリ名と食い違えば拒否）
func pkgTable(ts []ast.Tree, fp []string, md Mod) (PkgTab, error?) {
    main := "main"
    mut ppath := mut []string{}
    mut pname := mut []string{}
    mut plo := mut []int{}
    mut phi := mut []int{}
    mut filePkg := mut []int{}
    mut i := 0
    while i < len(ts) {
        t := ts[i]
        pn := Name(t, t.nodes[t.file].a)
        want := if fp[i] == main { main } else { modPkgName(md, fp[i]) }
        if pn != want {
            return PkgTab{}, diag.PkgName{at: diag.Pos{file: i, tok: PKGNAME_TOK}}
        }
        if i == 0 || fp[i] != fp[i - 1] {
            if len(plo) > 0 {
                phi = append(phi, i)
            }
            ppath = append(ppath, fp[i])
            pname = append(pname, pn)
            plo = append(plo, i)
        }
        filePkg = append(filePkg, len(plo) - 1)
        i += 1
    }
    phi = append(phi, len(ts))
    return PkgTab{freeze(ppath), freeze(pname), freeze(plo), freeze(phi), freeze(filePkg)}, nil
}

// import 表（package pkg の参照名 ref → path）
type ImpTab struct {
    pkg []int
    ref []string
    path []string
}

// import 表（同じ参照名で別の path は拒否）
func importTable(ts []ast.Tree, pt PkgTab) (ImpTab, error?) {
    mut ipkg := mut []int{}
    mut iref := mut []string{}
    mut ipath := mut []string{}
    for pk <- iter.Range(0, len(pt.path)) {
        mut f := pt.lo[pk]
        while f < pt.hi[pk] {
            t := ts[f]
            imps := t.nodes[t.file].b
            mut k := 0
            while k < ast.ListLen(t, imps) {
                im := t.nodes[ast.ListAt(t, imps, k)]
                path := Name(t, im.b)
                ref := if im.a >= 0 { Name(t, im.a) } else { QualOf(path) }
                mut dup := false
                mut e := 0
                while e < len(ipkg) {
                    if ipkg[e] == pk && iref[e] == ref {
                        if ipath[e] != path {
                            return ImpTab{}, diag.RefCollide{at: diag.Pos{file: f, tok: im.tok}}
                        }
                        dup = true
                    }
                    e += 1
                }
                if !dup {
                    ipkg = append(ipkg, pk)
                    iref = append(iref, ref)
                    ipath = append(ipath, path)
                }
                k += 1
            }
            f += 1
        }
    }
    return ImpTab{freeze(ipkg), freeze(iref), freeze(ipath)}, nil
}

// 組み込み error の variant（ロード順 × ファイル順 × 宣言順）: ラベルの名前と package
type ErrTab struct {
    name []string
    pkg []int
}

// 木の列tsのerrorラベルの表（ラベルのフィールドにerror / error? があれば拒否 — 再帰型）
func errorLabels(ts []ast.Tree, file_pkg []int) (ErrTab, error?) {
    mut ename := mut []string{}
    mut epkg := mut []int{}
    mut f := 0
    while f < len(ts) {
        t := ts[f]
        tys := t.nodes[t.file].c
        mut k := 0
        while k < ast.ListLen(t, tys) {
            td := t.nodes[ast.ListAt(t, tys, k)]
            body := t.nodes[td.c]
            if body.kind == ast.BError {
                if holdsError(t, body.a) {
                    return ErrTab{}, diag.ErrorHoldsError{at: diag.Pos{file: f, tok: td.tok}}
                }
                ename = append(ename, Name(t, td.a))
                epkg = append(epkg, file_pkg[f])
            }
            k += 1
        }
        f += 1
    }
    return ErrTab{freeze(ename), freeze(epkg)}, nil
}

// error ラベルのフィールドの列 l に error / error? があるか（再帰型 — cause は V4 に無い）
func holdsError(t ast.Tree, l int) bool {
    mut i := 0
    while i < ast.ListLen(t, l) {
        te := t.nodes[t.nodes[ast.ListAt(t, l, i)].b]
        ty := if te.kind == ast.TOpt { t.nodes[te.a] } else { te }
        if ty.kind == ast.TName && StrIs(t, ty.a, "error") {
            return true
        }
        i += 1
    }
    return false
}

// 解決済みの表（load の後段が読む — 全部 imm）
type Cx struct {
    trees []ast.Tree
    file_pkg []int
    pkg_path []string
    pkg_lo []int
    pkg_hi []int
    imp_pkg []int
    imp_ref []string
    imp_path []string
    // 型宣言の索引（fnval.soberのtyTab — packageと名前 → 型宣言。木の変換は節を足すだけで型宣言の節と名前のデータは動かないので、
    // 最初のCxで1回組んで変換後のCxへ引き継ぐ — 関数表fnTabと同じ前提）
    tys []int
}

// path の package の番号（無ければ -1）
func pkgOf(cx Cx, path string) int {
    mut i := 0
    while i < len(cx.pkg_path) {
        if cx.pkg_path[i] == path {
            return i
        }
        i += 1
    }
    return 0 - 1
}

// ファイル f に書いた参照名 ref の import 先 package（無ければ -1）。import はファイルごと（language.md 20 節 — Go と同じ）:
// 同じ package の別ファイルの import は見えない
func fileImportOf(cx Cx, f int, ref string) int {
    t := cx.trees[f]
    imps := t.nodes[t.file].b
    for k <- iter.Range(0, ast.ListLen(t, imps)) {
        im := t.nodes[ast.ListAt(t, imps, k)]
        r := if im.a >= 0 { Name(t, im.a) } else { QualOf(Name(t, im.b)) }
        if r == ref {
            return importOf(cx, cx.file_pkg[f], ref)
        }
    }
    return 0 - 1
}

// package pk の参照名 ref の import 先 package（無ければ -1）
func importOf(cx Cx, pk int, ref string) int {
    mut e := 0
    while e < len(cx.imp_pkg) {
        if cx.imp_pkg[e] == pk && cx.imp_ref[e] == ref {
            return pkgOf(cx, cx.imp_path[e])
        }
        e += 1
    }
    return 0 - 1
}

func cycleAt(cx Cx) diag.Pos {
    n := len(cx.pkg_path)
    mut gone := mut []bool{}
    for i <- iter.Range(0, n) {
        gone = append(gone, false)
    }
    mut left := n
    mut progress := true
    while progress && left > 0 {
        progress = false
        for p <- iter.Range(0, n) {
            if !gone[p] {
                mut free := true
                mut e := 0
                while e < len(cx.imp_pkg) {
                    if cx.imp_pkg[e] == p {
                        d := pkgOf(cx, cx.imp_path[e])
                        if d >= 0 && !gone[d] {
                            free = false
                        }
                    }
                    e += 1
                }
                if free {
                    gone[p] = true
                    left -= 1
                    progress = true
                }
            }
        }
    }
    // 残った package のうち最初のもの — その import のうち、残った package を指す最初の import 宣言の位置
    for p <- iter.Range(0, n) {
        if !gone[p] {
            for f <- iter.Range(cx.pkg_lo[p], cx.pkg_hi[p]) {
                t := cx.trees[f]
                imps := t.nodes[t.file].b
                for k <- iter.Range(0, ast.ListLen(t, imps)) {
                    im := t.nodes[ast.ListAt(t, imps, k)]
                    d := pkgOf(cx, Name(t, im.b))
                    if d >= 0 && !gone[d] {
                        return diag.Pos{file: f, tok: im.tok}
                    }
                }
            }
        }
    }
    return diag.None()
}

// pの木だけをtsに替えたProgram（desugar.NamedValueArgs — 名前付き関数型を通した呼び出しの変換。節は末尾に足すだけなので表の添字は変わらない）
func WithTrees(p Program, ts []ast.Tree) Program {
    mut q := p
    q.trees = ts
    return q
}
