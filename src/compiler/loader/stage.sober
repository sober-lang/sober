package loader

// ステージのマーク: SOBER_STAGES=1のときbuildのステージの境目で `@<名前>` を標準エラーへ1行。読み手 =
// scripts/stagewall.ts（マークの到着時刻とCPU時間を区間ごとに）。offのオーバーヘッド = マーク ≈30点 × 環境変数の引き1回（出力は変わらない）

import "std/io"
import "std/os"

// 環境変数nameが "1" か（開発のインターフェースのフラグ）
func Flag(name string) bool {
    v, err := os.Getenv(name)
    if err != nil || v == nil {
        return false
    }
    return v == "1"
}

// バイト列bを標準エラーへ（開発のインターフェースの出力）
func Err(b []byte) {
    _ = io.WriteStderr(b)
}

// SOBER_STAGESが "1" ならステージの名前nameをマークとして書く
func Stage(name string) {
    v, err := os.Getenv("SOBER_STAGES")
    if err != nil || v == nil {
        return
    }
    if v != "1" {
        return
    }
    _ = io.WriteStderr(bytes("@${name}\n"))
}
