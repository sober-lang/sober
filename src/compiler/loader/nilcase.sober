package loader

// `T?` の単値subjectのswitchの `case nil:` の分岐（language.md 13 / 22 節）— 脱糖の固定テンプレートでifに変換する:
//
//     switch S { …前の分岐…  case nil: A  …  case _, Q: B  …  default: D }
//  →  { $nilK := S; if $nilK != nil { switch $nilK { …前の分岐… …後の分岐… default: D } } else { A } }
//
// Sが名前なら束縛を置かずにその名前を使う（ifの flow typing でthenの中はT）。分岐の並びは保つ（nilの分岐だけ抜く）。
// desugar・lower・typer・analyzerは変換した後の木（`if x != nil { switch x { … } }` の形）だけを読む — コア・Leanは無変更。網羅は内側のswitchの
// 既存の検査（nilの分岐 + 全ラベル / 全variantならdefaultは要らない）。
// 残りの分岐がdefaultだけならthenはdefaultの本体。
// 変換できない形はloaderの拒否（diag.NilCase — 位置 = nilの分岐・理由ごとの文言。D1）: nilの分岐が2つ以上・`nil | …` の選択・nilの分岐より前に名前のパターン
// （`_`・束縛・const — nilにも当たりうるので、源の順の意味と変換した後の意味がずれる）・nilの分岐しか無い形。subjectが2つ以上のswitchのnilは
// 多値のsubjectの形（`case v, nil:` — 13 節）なので触らない。subjectが1つでも多値を返す呼び出し（パターン2つ以上の分岐がある）も同じ

import "std/builder"
import "std/iter"
import "ast"
import "lexer"
import "diag"

// 全ファイルの木の `case nil:` を変換する（変換できない形は拒否）
@errors(diag.NilCase)
func nilCasesAll(ts []ast.Tree) ([]ast.Tree, error?) {
    mut out := mut []ast.Tree{}
    for i <- iter.Range(0, len(ts)) {
        t := ts[i]
        for n <- iter.Range(0, len(t.nodes)) {
            x := t.nodes[n]
            if x.kind == ast.ESwitch {
                kind, tok := nilCaseBad(t, x)
                if kind != 0 {
                    return []ast.Tree{}, diag.NilCase{at: diag.Pos{file: i, tok: tok}, kind: kind}
                }
                if mvApplies(t, x) {
                    mk, mt := mvBad(t, x)
                    if mk != 0 {
                        return []ast.Tree{}, diag.NilCase{at: diag.Pos{file: i, tok: mt}, kind: mk}
                    }
                }
            }
        }
        // 単値の `case nil:`（このファイル）→ 2位置の `case P, nil:`（mvcase.sober）の順に変換する
        out = append(out, mvCases(nilCases(t)))
    }
    return freeze(out), nil
}

// switch節xがパターン2つ以上の分岐を持つか（多値のsubject — `case v, nil:`（13 節）。nilは単値のnilの分岐ではない）
func multiPat(t ast.Tree, x ast.Node) bool {
    for i <- iter.Range(0, ast.ListLen(t, x.b)) {
        if ast.ListLen(t, t.nodes[ast.ListAt(t, x.b, i)].a) > 1 {
            return true
        }
    }
    return false
}

// 単値subjectのswitch節xのnilの分岐が変換できない理由（0 = 変換できるかnilの分岐が無い・1 = 2つ以上・2 = `nil | …` / 他のパターンと並ぶ・
// 3 = 前に名前のパターン・4 = nilの分岐しか無い）と位置（nilの分岐の字句）。パターン2つ以上の分岐があるswitch（多値のsubject）は見ない
func nilCaseBad(t ast.Tree, x ast.Node) (int, int) {
    if ast.ListLen(t, x.a) != 1 || multiPat(t, x) {
        return 0, 0
    }
    mut seen := false
    mut named := false
    for i <- iter.Range(0, ast.ListLen(t, x.b)) {
        cn := t.nodes[ast.ListAt(t, x.b, i)]
        ps := cn.a
        for j <- iter.Range(0, ast.ListLen(t, ps)) {
            p := t.nodes[ast.ListAt(t, ps, j)]
            if p.kind == ast.KPConst {
                for k <- iter.Range(0, ast.ListLen(t, p.a)) {
                    alt := t.nodes[ast.ListAt(t, p.a, k)].kind
                    if alt == ast.ENil {
                        if seen {
                            return 1, cn.tok
                        }
                        if ast.ListLen(t, ps) != 1 || ast.ListLen(t, p.a) != 1 {
                            return 2, cn.tok
                        }
                        if named {
                            return 3, cn.tok
                        }
                        if ast.ListLen(t, x.b) == 1 && x.c < 0 {
                            return 4, cn.tok
                        }
                        seen = true
                    } else if alt == ast.EIdent && !seen {
                        named = true
                    }
                }
            }
        }
    }
    return 0, 0
}

// switchの節xのnilの分岐の添字（変換できなければ -1）
func nilCaseAt(t ast.Tree, x ast.Node) int {
    if ast.ListLen(t, x.a) != 1 || multiPat(t, x) {
        return -1
    }
    mut at := -1
    mut named := false
    for i <- iter.Range(0, ast.ListLen(t, x.b)) {
        ps := t.nodes[ast.ListAt(t, x.b, i)].a
        for j <- iter.Range(0, ast.ListLen(t, ps)) {
            p := t.nodes[ast.ListAt(t, ps, j)]
            if p.kind == ast.KPConst {
                for k <- iter.Range(0, ast.ListLen(t, p.a)) {
                    alt := t.nodes[ast.ListAt(t, p.a, k)].kind
                    if alt == ast.ENil {
                        if at >= 0 || named || ast.ListLen(t, ps) != 1 || ast.ListLen(t, p.a) != 1 {
                            return -1
                        }
                        at = i
                    } else if alt == ast.EIdent && at < 0 {
                        named = true
                    }
                }
            }
        }
    }
    // nilの分岐のほかに分岐もdefaultも無い形は変換しない（nil以外の値の行き先が無い — 網羅の拒否に落とす）
    if at >= 0 && ast.ListLen(t, x.b) == 1 && x.c < 0 {
        return -1
    }
    return at
}

// 木tの `case nil:` を変換した木（節は末尾に足し、switchの節をその場で差し替える — 既存の添字は動かない）
func nilCases(t ast.Tree) ast.Tree {
    n0 := len(t.nodes)
    mut found := false
    for i <- iter.Range(0, n0) {
        x := t.nodes[i]
        if x.kind == ast.ESwitch && nilCaseAt(t, x) >= 0 {
            found = true
        }
    }
    if !found {
        return t
    }
    mut ns := mut []ast.Node{}
    for i <- iter.Range(0, n0) {
        ns = append(ns, t.nodes[i])
    }
    mut nb := builder.Builder[ast.Node]{}
    mut db := builder.Builder[int]{}
    for j <- iter.Range(0, len(t.data)) {
        builder.Push(mut db, t.data[j])
    }
    mut k := 0
    for i <- iter.Range(0, n0) {
        x := t.nodes[i]
        c := if x.kind == ast.ESwitch { nilCaseAt(t, x) } else { -1 }
        if c >= 0 {
            base := n0 + builder.Len(mut nb)
            tok := x.tok
            nc := t.nodes[ast.ListAt(t, x.b, c)]
            s0 := ast.ListAt(t, x.a, 0)
            // 名前の subject はそのまま、他は $nilK に束縛する
            nm := if t.nodes[s0].kind == ast.EIdent { t.nodes[s0].a } else { ast.PutLit(mut db, "$nil${k}") }
            mut rest := mut []int{}
            for j <- iter.Range(0, ast.ListLen(t, x.b)) {
                if j != c {
                    rest = append(rest, ast.ListAt(t, x.b, j))
                }
            }
            // base + 0 = 内側の switch の subject・1 = 内側の switch・2 = then の SExpr・3 = then の KBlock・4 = 判定の名前・5 = nil・6 = 判定
            builder.Push(mut nb, ast.Node{ast.EIdent, tok, nm, 0, 0, 0, 0, 0})
            builder.Push(mut nb, ast.Node{ast.ESwitch, tok, ast.PutList(mut db, []int{base}), ast.PutList(mut db, freeze(rest)), x.c, 0, 0, 0})
            builder.Push(mut nb, ast.Node{ast.SExpr, tok, base + 1, 0, 0, 0, 0, 0})
            // 残りの分岐がdefaultだけならthenはdefaultの本体（分岐の無いswitchは書けない）
            then := if len(rest) == 0 { t.nodes[x.c].a } else { ast.PutList(mut db, []int{base + 2}) }
            builder.Push(mut nb, ast.Node{ast.KBlock, tok, then, 0, 0, 0, 0, 0})
            builder.Push(mut nb, ast.Node{ast.EIdent, tok, nm, 0, 0, 0, 0, 0})
            builder.Push(mut nb, ast.Node{ast.ENil, nc.tok, 0, 0, 0, 0, 0, 0})
            builder.Push(mut nb, ast.Node{ast.EBinary, tok, lexer.BangEqual, base + 4, base + 5, 0, 0, 0})
            // base + 7 = else（EBlock — nilの分岐の本体の文の列）
            builder.Push(mut nb, ast.Node{ast.EBlock, nc.tok, t.nodes[nc.b].a, 0, 0, 0, 0, 0})
            ifn := ast.Node{ast.EIf, tok, base + 6, base + 3, base + 7, 0, 0, 0}
            if t.nodes[s0].kind == ast.EIdent {
                ns[i] = ifn
            } else {
                // base + 8 = if・9 = 束縛・10 = if の SExpr
                builder.Push(mut nb, ifn)
                builder.Push(mut nb, ast.Node{ast.SBind, tok, ast.PutList(mut db, []int{nm}), 0, ast.PutList(mut db, []int{s0}), 0, 0, 0})
                builder.Push(mut nb, ast.Node{ast.SExpr, tok, base + 8, 0, 0, 0, 0, 0})
                ns[i] = ast.Node{ast.EBlock, tok, ast.PutList(mut db, []int{base + 9, base + 10}), 0, 0, 0, 0, 0}
                k += 1
            }
        }
    }
    added := builder.Build(mut nb)
    for i <- iter.Range(0, len(added)) {
        ns = append(ns, added[i])
    }
    return ast.Tree{freeze(ns), builder.Build(mut db), t.file}
}
