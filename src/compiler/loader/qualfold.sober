package loader

// 複数セグメントの修飾子の畳み（language.md 20 節）: `http.server.Serve` の選択子の連鎖のうち、package の import の修飾子
// （`http.server` — aliasの無い複数セグメントのimport）に一致する最長の頭を、名前がその修飾子のEIdent 1つに変換する。
// 以降のステージ（検査・desugar・lower・analyzer）は「EIdentを基底とする選択子 = 修飾参照」の1レベルの形だけを見る。
// 修飾子のセグメントは小文字・公開の名前は大文字なので、一致する頭は高々1つに決まる（探索も優先順位も持たない）。
// 型名の綴り（`http.server.Request`）は parser が 1 本の文字列にするので畳まない — 修飾子と名前の境は最後の '.'。
// 一致の表は package 単位（import はファイルごとの約束の検査 — NotImported — は畳んだ後の木で fileimports.sober が見る）

import "std/builder"
import "std/iter"
import "ast"

// 木の列を畳む（複数セグメントの修飾子を持たない package の木はそのまま。ファイルは package ごとに連続 — finish の約束）
func qualFoldAll(trees []ast.Tree, fpkg []string) []ast.Tree {
    mut out := mut []ast.Tree{}
    mut lo := 0
    while lo < len(trees) {
        mut hi := lo
        while hi < len(trees) && fpkg[hi] == fpkg[lo] {
            hi += 1
        }
        qs := pkgQuals(trees, lo, hi)
        for f <- iter.Range(lo, hi) {
            out = append(out, if len(qs) == 0 { trees[f] } else { qualFold(trees[f], qs) })
        }
        lo = hi
    }
    return freeze(out)
}

// ファイル [lo, hi)（1 つの package）の import の複数セグメントの修飾子
func pkgQuals(trees []ast.Tree, lo int, hi int) []string {
    mut qs := mut []string{}
    for f <- iter.Range(lo, hi) {
        t := trees[f]
        imps := t.nodes[t.file].b
        for k <- iter.Range(0, ast.ListLen(t, imps)) {
            im := t.nodes[ast.ListAt(t, imps, k)]
            // 別名は識別子 1 つ — '.' を含むのはテストの配線の書き換え（double へ差し替えた import の参照名 = 元の修飾子）だけ
            q := if im.a >= 0 { Name(t, im.a) } else { QualOf(Name(t, im.b)) }
            if RootSeg(q) != q {
                if !has(freeze(qs), q) {
                    qs = append(qs, q)
                }
            }
        }
    }
    return freeze(qs)
}

// 節 i の識別子の連鎖の綴り（`a` / `a.b.c` — 連鎖でなければ ""）
func chainText(t ast.Tree, i int) string {
    x := t.nodes[i]
    if x.kind == ast.EIdent {
        return Name(t, x.a)
    }
    if x.kind == ast.ESelector && x.a >= 0 {
        base := chainText(t, x.a)
        return if base == "" { "" } else { "${base}.${Name(t, x.b)}" }
    }
    return ""
}

// 木 t の選択子 y で、基底 y.a の連鎖の綴りが qs にあり y 自身の綴りが qs に無いもの（= 最長の一致）の基底を、
// その綴りのEIdentに変換する。基底の下の節も同じ綴りのEIdentに変換する（根から辿れない節を名前の検査が拾わないように）
func qualFold(t ast.Tree, qs []string) ast.Tree {
    mut roots := mut []string{}
    for q <- qs {
        roots = append(roots, RootSeg(q))
    }
    rs := freeze(roots)
    mut hits := mut []int{}
    for i <- iter.Range(0, len(t.nodes)) {
        y := t.nodes[i]
        if y.kind == ast.ESelector && y.a >= 0 && t.nodes[y.a].kind == ast.ESelector && has(rs, chainRoot(t, y.a)) {
            if has(qs, chainText(t, y.a)) && !has(qs, chainText(t, i)) {
                hits = append(hits, y.a)
            }
        }
    }
    if len(hits) == 0 {
        return t
    }
    mut ns := mut []ast.Node{}
    for i <- iter.Range(0, len(t.nodes)) {
        ns = append(ns, t.nodes[i])
    }
    mut db := builder.Builder[int]{}
    for j <- iter.Range(0, len(t.data)) {
        builder.Push(mut db, t.data[j])
    }
    for h <- hits {
        mut n := h
        while n >= 0 && (t.nodes[n].kind == ast.ESelector || t.nodes[n].kind == ast.EIdent) {
            x := t.nodes[n]
            ns[n] = ast.Node{ast.EIdent, rootTok(t, h), ast.PutLit(mut db, chainText(t, n)), 0, 0, 0, 0, 0}
            n = if x.kind == ast.ESelector { x.a } else { -1 }
        }
    }
    return ast.Tree{freeze(ns), builder.Build(mut db), t.file}
}

// 連鎖の根の識別子の名前（連鎖でなければ ""）
func chainRoot(t ast.Tree, i int) string {
    mut n := i
    while t.nodes[n].kind == ast.ESelector && t.nodes[n].a >= 0 {
        n = t.nodes[n].a
    }
    return if t.nodes[n].kind == ast.EIdent { Name(t, t.nodes[n].a) } else { "" }
}

// 連鎖の根の識別子の字句（診断の位置 — 修飾子の頭）
func rootTok(t ast.Tree, i int) int {
    mut n := i
    while t.nodes[n].kind == ast.ESelector && t.nodes[n].a >= 0 {
        n = t.nodes[n].a
    }
    return t.nodes[n].tok
}
