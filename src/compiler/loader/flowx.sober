package loader

// flow typing の連鎖と早期脱出（language.md 427行の flow typing の改訂）を脱糖の固定テンプレートでifの入れ子に変換する。
// 以降の層（desugar・lower・typer・analyzer）は変換した後の木（単独の `x != nil` / `x == nil` を条件に持つif）だけを読む — コア・Leanは無変更。
//
// ① `&&` の連鎖の中の `x != nil`（右辺と本体で x は T）— else の無い if:
//        if A && x != nil && B { T }   →   if A { if x != nil { if B { T } } }
// ② `||` の連鎖の中の `x == nil` で、then が脱出（return / break / continue）1 文だけ（否定側 = else で x は T）:
//        if A || x == nil || B { T } else { E }
//     →  if A { T } else { if x == nil { T } else { if B { T } else { E } } }
//     （thenは脱出なので複製してもxを絞った形で値として読まれない — 脱出で終わらないthenは変換しない）
// ③ 早期脱出: 文の列の中の else の無い `if C { …; return }`（C は `x == nil` か ② の連鎖）の後ろの文を else に入れる:
//        if x == nil { return … }  rest…   →   if x == nil { return … } else { rest… }
//     （restの中でxはT。defer・束縛の見える範囲は列の終わりと同じ — elseの分岐はregion境界ではない）
// ④ 値の位置の `&&` / `||`（else つき if の条件を含む — ①〜③ の if の条件は除く）の中の `x != nil` / `x == nil`（右の項で x は T）:
//        A && x != nil && B   →   if A { if x != nil { B } else { false } } else { false }
//        A || x == nil || B   →   if A { true } else { if x == nil { true } else { B } }
//     （複製するのは定数の分岐だけ）
// ⑤ else つき if の本体（`&&` は then・`||` は else — ② の形を除く）: 条件は ④ の形・本体は連鎖の nil 判定の名前ごとの単独の判定で包む:
//        if A && x != nil && B { T } else { E }   →   if <④ の形> { if x != nil { T } else { $unreach() } } else { E }
//        if A || x == nil || B { T } else { E }   →   if <④ の形> { T } else { if x != nil { E } else { $unreach() } }
//     （T・Eは1回ずつ — elseの分岐の複製はlowerの展開で膨らむ〔自己buildのRSS 479 → 2248 MBを実測〕。条件の値が真〔|| は偽〕なら
//      判定は必ず成り立つ — 判定より後ろの項がxに書くなら包まない〔下の ⑥ の注記〕。`$unreach` は利用者が書けない名前で、
//      後段は到達しない点〔panicのエフェクトに数えない〕として読む）
// ⑥ while の条件の `&&` の連鎖の中の `x != nil`（本体で x は T — 周の頭で毎回絞り直す）:
//        while C { B }   →   while true { if C { B } else { break } }
//     （if は ⑤ / 単独の判定の形で絞る。本体の中の x への代入で絞りが外れ、次の周の頭でまた絞る — desugar/narrowkill.sober）
// ⑤ の再判定は、判定より後ろの項が x に書く（`f(mut x)`・式の中の代入）なら作らない（本体の x は T? のまま — 書いた後に再判定すると nil で $unreach に落ちる）
// 変換は固定点まで回す（変換した後の入れ子にまた連鎖が残る）。名前の判定は字面だけ（xの型は見ない — 型がT? でなくても変換は意味を変えない）

import "std/builder"
import "std/iter"
import "ast"
import "lexer"

// 全ファイルの木の flow typing の連鎖と早期脱出を変換する
func flowAll(ts []ast.Tree) []ast.Tree {
    mut out := mut []ast.Tree{}
    for i <- iter.Range(0, len(ts)) {
        out = append(out, flowFix(ts[i]))
    }
    return freeze(out)
}

// 木tを固定点まで変換する
func flowFix(t0 ast.Tree) ast.Tree {
    mut t := t0
    mut round := 0
    mut going := true
    while going && round < 16 {
        t2, changed := flowRound(t)
        t = t2
        going = changed
        round += 1
    }
    return t
}

// ④ の連鎖の nil 判定の位置（&& なら x != nil・|| なら x == nil — 右の項が x を読むものだけ）。無ければ -1
func valueNilAt(t ast.Tree, cs []int, op int) int {
    want := if op == lexer.AmpersandAmpersand { 1 } else { 2 }
    for q <- iter.Range(0, len(cs) - 1) {
        if nilTestKind(t, cs[q]) == want {
            nm := nilTestName(t, cs[q])
            for r <- iter.Range(q + 1, len(cs)) {
                if mentions(t, cs[r], nm) {
                    return q
                }
            }
        }
    }
    return -1
}

// nil 判定 n の名前（プールの文字列）
func nilTestName(t ast.Tree, n0 int) int {
    x := t.nodes[unparen(t, n0)]
    l := unparen(t, x.b)
    return if t.nodes[l].kind == ast.EIdent { t.nodes[l].a } else { t.nodes[unparen(t, x.c)].a }
}

// 式nが名前nmを読むか（辿らない種類の節は読むとみなす — 変換は意味を変えないので過剰側は安全）
func mentions(t ast.Tree, n int, nm int) bool {
    x := t.nodes[n]
    k := x.kind
    if k == ast.EIdent || k == ast.EMutArg {
        return strEqPool(t, x.a, nm)
    }
    if k == ast.EInt || k == ast.ENil || k == ast.EStrlit || k == ast.EFloat {
        return false
    }
    if k == ast.EBinary {
        return mentions(t, x.b, nm) || mentions(t, x.c, nm)
    }
    if k == ast.EUnary {
        return mentions(t, x.b, nm)
    }
    if k == ast.EParen || k == ast.ESelector {
        return mentions(t, x.a, nm)
    }
    if k == ast.EIndex {
        return mentions(t, x.a, nm) || mentions(t, x.b, nm)
    }
    if k == ast.ECall {
        for j <- iter.Range(0, ast.ListLen(t, x.b)) {
            if mentions(t, ast.ListAt(t, x.b, j), nm) {
                return true
            }
        }
        return mentions(t, x.a, nm)
    }
    return true
}

// 連鎖の節nとその内側の同じ演算子の節をkeptに（左結合の内側の節を ④ が変換すると ①〜③ の連鎖が崩れる）
func keepChain(t ast.Tree, kept mut []bool, n int) {
    kept[n] = true
    x := t.nodes[n]
    if x.kind == ast.EBinary && (x.a == lexer.AmpersandAmpersand || x.a == lexer.PipePipe) {
        keepSide(t, mut kept, x.b, x.a)
        keepSide(t, mut kept, x.c, x.a)
    }
}

// keepChainの片側c（同じ演算子opの節ならマークを付けて潜る）
func keepSide(t ast.Tree, kept mut []bool, c int, op int) {
    u := unparen(t, c)
    if t.nodes[u].kind == ast.EBinary && t.nodes[u].a == op {
        kept[c] = true
        keepChain(t, mut kept, u)
    }
}

// if の条件を ①〜③ に任せるか（else の無い if・then が脱出 1 文の if）
func condKept(t ast.Tree, nd ast.Node) bool {
    return nd.c < 0 || diverges(t, nd.b) && ast.ListLen(t, t.nodes[nd.b].a) == 1
}

// 節 n が `x != nil`（1）/ `x == nil`（2）/ どちらでもない（0）か（x は名前）
func nilTestKind(t ast.Tree, n0 int) int {
    n := unparen(t, n0)
    if n < 0 || t.nodes[n].kind != ast.EBinary {
        return 0
    }
    x := t.nodes[n]
    l := unparen(t, x.b)
    r := unparen(t, x.c)
    named := (t.nodes[l].kind == ast.EIdent && t.nodes[r].kind == ast.ENil) || (t.nodes[l].kind == ast.ENil && t.nodes[r].kind == ast.EIdent)
    if !named {
        return 0
    }
    return if x.a == lexer.BangEqual { 1 } else if x.a == lexer.EqualEqual { 2 } else { 0 }
}

// op（&& / ||）の連鎖を左から平らにした項の列
func chainOf(t ast.Tree, n0 int, op int) []int {
    n := unparen(t, n0)
    if t.nodes[n].kind == ast.EBinary && t.nodes[n].a == op {
        l := chainOf(t, t.nodes[n].b, op)
        r := chainOf(t, t.nodes[n].c, op)
        mut out := mut []int{}
        for i <- iter.Range(0, len(l)) {
            out = append(out, l[i])
        }
        for i <- iter.Range(0, len(r)) {
            out = append(out, r[i])
        }
        return freeze(out)
    }
    return []int{n0}
}

// KBlock の文の列が脱出（return / break / continue）で終わるか
func diverges(t ast.Tree, blk int) bool {
    l := t.nodes[blk].a
    k := ast.ListLen(t, l)
    if k == 0 {
        return false
    }
    s := t.nodes[ast.ListAt(t, l, k - 1)].kind
    return s == ast.SRet || s == ast.SBreak || s == ast.SContinue
}

// 変換の作業場（足す節・データ）
type Fx struct {
    n0 int
    nb builder.Builder[ast.Node]
    db builder.Builder[int]
}

// 節を足してその添字
func fxNode(x mut Fx, n ast.Node) int {
    at := x.n0 + builder.Len(mut x.nb)
    builder.Push(mut x.nb, n)
    return at
}

// 項の列 cs[lo:hi] を op の左結合の連鎖に（1 項ならその項）
func fxJoin(x mut Fx, cs []int, lo int, hi int, op int, tok int) int {
    mut acc := cs[lo]
    for i <- iter.Range(lo + 1, hi) {
        acc = fxNode(mut x, ast.Node{ast.EBinary, tok, op, acc, cs[i], 0, 0, 0})
    }
    return acc
}

// 式 e を唯一の文に持つ KBlock
func fxBlock(x mut Fx, e int, tok int) int {
    s := fxNode(mut x, ast.Node{ast.SExpr, tok, e, 0, 0, 0, 0, 0})
    return fxNode(mut x, ast.Node{ast.KBlock, tok, ast.PutList(mut x.db, []int{s}), 0, 0, 0, 0, 0})
}

// 式eを唯一の文に持つEBlock（elseの分岐）
func fxBlockE(x mut Fx, e int, tok int) int {
    s := fxNode(mut x, ast.Node{ast.SExpr, tok, e, 0, 0, 0, 0, 0})
    return fxNode(mut x, ast.Node{ast.EBlock, tok, ast.PutList(mut x.db, []int{s}), 0, 0, 0, 0, 0})
}

// 名前 kw（true / false）の節
func fxConst(x mut Fx, kw string, tok int) int {
    return fxNode(mut x, ast.Node{ast.EIdent, tok, ast.PutLit(mut x.db, kw), 0, 0, 0, 0, 0})
}

// 名前kwだけのelseの分岐
func fxConstE(x mut Fx, kw string, tok int) int {
    return fxBlockE(mut x, fxConst(mut x, kw, tok), tok)
}

// ④ の形: 項の列 cs の p 番目の nil 判定で割った値の位置の連鎖（&& : if 頭 { if 判定 { 残り } else { false } } else { false }・|| は真偽を逆に）
func fxValueChain(x mut Fx, cs []int, p int, op int, tok int) ast.Node {
    and := op == lexer.AmpersandAmpersand
    kw := if and { "false" } else { "true" }
    if p + 1 == len(cs) {
        // 判定が末尾（⑤ だけ — p > 0）: && : if 頭 { 判定 } else { false }・|| : if 頭 { true } else { 判定 }
        head := fxJoin(mut x, cs, 0, p, op, tok)
        return if and { ast.Node{ast.EIf, tok, head, fxBlock(mut x, cs[p], tok), fxConstE(mut x, kw, tok), 0, 0, 0} } else { ast.Node{ast.EIf, tok, head, fxBlock(mut x, fxConst(mut x, kw, tok), tok), fxBlockE(mut x, cs[p], tok), 0, 0, 0} }
    }
    rest := fxJoin(mut x, cs, p + 1, len(cs), op, tok)
    mid := if and { ast.Node{ast.EIf, tok, cs[p], fxBlock(mut x, rest, tok), fxConstE(mut x, kw, tok), 0, 0, 0} } else { ast.Node{ast.EIf, tok, cs[p], fxBlock(mut x, fxConst(mut x, kw, tok), tok), fxBlockE(mut x, rest, tok), 0, 0, 0} }
    if p == 0 {
        return mid
    }
    m := fxNode(mut x, mid)
    head := fxJoin(mut x, cs, 0, p, op, tok)
    return if and { ast.Node{ast.EIf, tok, head, fxBlock(mut x, m, tok), fxConstE(mut x, kw, tok), 0, 0, 0} } else { ast.Node{ast.EIf, tok, head, fxBlock(mut x, fxConst(mut x, kw, tok), tok), fxBlockE(mut x, m, tok), 0, 0, 0} }
}

// 到達しない点 `$unreach()` だけのelseの分岐
func fxUnreachE(x mut Fx, tok int) int {
    callee := fxNode(mut x, ast.Node{ast.EIdent, tok, ast.PutLit(mut x.db, "$unreach"), 0, 0, 0, 0, 0})
    call := fxNode(mut x, ast.Node{ast.ECall, tok, callee, ast.PutList(mut x.db, []int{}), 0, 0, 0, 0})
    return fxBlockE(mut x, call, tok)
}

// 本体 blk（KBlock）を連鎖 cs の nil 判定（種類 want）の名前ごとの `if x != nil { … } else { $unreach() }` で包んだ外側の if（同じ名前は 1 回・名前は 1 つ以上）
func fxNarrowBody(t ast.Tree, x mut Fx, cs []int, want int, blk int, tok int) int {
    mut names := mut []int{}
    mut ats := mut []int{}
    for q <- iter.Range(0, len(cs)) {
        if nilTestKind(t, cs[q]) == want {
            nm := nilTestName(t, cs[q])
            mut seen := false
            for w <- iter.Range(0, len(names)) {
                seen = seen || names[w] == nm
            }
            for r <- iter.Range(q + 1, len(cs)) {
                seen = seen || writesT(t, cs[r], nm)
            }
            if !seen {
                names = append(names, nm)
                ats = append(ats, unparen(t, cs[q]))
            }
        }
    }
    mut body := blk
    mut out := -1
    mut q := len(names) - 1
    while q >= 0 {
        at := t.nodes[ats[q]].tok
        id := fxNode(mut x, ast.Node{ast.EIdent, at, names[q], 0, 0, 0, 0, 0})
        nl := fxNode(mut x, ast.Node{ast.ENil, at, 0, 0, 0, 0, 0, 0})
        test := fxNode(mut x, ast.Node{ast.EBinary, at, lexer.BangEqual, id, nl, 0, 0, 0})
        out = fxNode(mut x, ast.Node{ast.EIf, at, test, body, fxUnreachE(mut x, at), 0, 0, 0})
        body = fxBlock(mut x, out, tok)
        q -= 1
    }
    return out
}

// 節nの中に名前nmへの書き（名前・パスの根への代入・mut実引数）があるか（ラムダの中は数えない — desugar/narrowkill.soberのwritesNと同じ基準）
func writesT(t ast.Tree, n int, nm int) bool {
    if n < 0 {
        return false
    }
    x := t.nodes[n]
    k := x.kind
    if k == ast.EMutArg {
        return mutRootT(t, x.a, nm)
    }
    if k == ast.EIdent || k == ast.EInt || k == ast.ENil || k == ast.EFloat || k == ast.EStrlit || k == ast.EUtf8Ref || k == ast.ELambda || k == ast.SBreak || k == ast.SContinue {
        return false
    }
    if k == ast.SAssign {
        for i <- iter.Range(0, ast.ListLen(t, x.a)) {
            if rootT(t, ast.ListAt(t, x.a, i), nm) {
                return true
            }
        }
        return writesLT(t, x.a, nm) || writesLT(t, x.c, nm)
    }
    if k == ast.SBind {
        return writesLT(t, x.c, nm)
    }
    if k == ast.SRet || k == ast.KBlock || k == ast.EBlock {
        return writesLT(t, x.a, nm)
    }
    if k == ast.SExpr || k == ast.SDefer || k == ast.SYield || k == ast.EParen || k == ast.ESelector {
        return writesT(t, x.a, nm)
    }
    if k == ast.EBinary {
        return writesT(t, x.b, nm) || writesT(t, x.c, nm)
    }
    if k == ast.EIndex || k == ast.ECatch || k == ast.ETry || k == ast.SWhile || k == ast.KEntry {
        return writesT(t, x.a, nm) || writesT(t, x.b, nm)
    }
    if k == ast.KNamedArg || k == ast.KCase || k == ast.KElem {
        // aは名前 / パターンの列 / フィールドの名前
        return writesT(t, x.b, nm)
    }
    if k == ast.EUnary {
        return writesT(t, x.b, nm)
    }
    if k == ast.ECall {
        return writesT(t, x.a, nm) || writesLT(t, x.b, nm)
    }
    if k == ast.EPipe {
        return writesT(t, x.a, nm) || writesT(t, x.b, nm) || writesLT(t, x.c, nm)
    }
    if k == ast.ESlice3 || k == ast.EIf {
        return writesT(t, x.a, nm) || writesT(t, x.b, nm) || writesT(t, x.c, nm)
    }
    if k == ast.EInterp || k == ast.EComposite || k == ast.ESlicelit {
        return writesLT(t, x.b, nm)
    }
    if k == ast.EMaplit {
        return writesLT(t, x.c, nm)
    }
    if k == ast.ESwitch {
        return writesLT(t, x.a, nm) || writesLT(t, x.b, nm) || writesT(t, x.c, nm)
    }
    if k == ast.EFor {
        for i <- iter.Range(0, ast.ListLen(t, x.a)) {
            g := t.nodes[ast.ListAt(t, x.a, i)]
            if writesT(t, g.b, nm) || writesLT(t, g.c, nm) {
                return true
            }
        }
        return if x.b == 0 { writesT(t, x.c, nm) } else { writesLT(t, x.c, nm) }
    }
    return false
}

func writesLT(t ast.Tree, l int, nm int) bool {
    if l < 0 {
        return false
    }
    for i <- iter.Range(0, ast.ListLen(t, l)) {
        if writesT(t, ast.ListAt(t, l, i), nm) {
            return true
        }
    }
    return false
}

// パス（`x.f`・`x[i]`）の根が名前nmか
func rootT(t ast.Tree, n0 int, nm int) bool {
    mut n := n0
    while t.nodes[n].kind == ast.ESelector || t.nodes[n].kind == ast.EIndex || t.nodes[n].kind == ast.EParen {
        n = t.nodes[n].a
    }
    return t.nodes[n].kind == ast.EIdent && strEqPool(t, t.nodes[n].a, nm)
}

// mut実引数のパス（"x" / "x.f"）の根がnmか
func mutRootT(t ast.Tree, path int, nm int) bool {
    n := t.data[nm]
    p := t.data[path]
    if p < n || p > n && t.data[path + 1 + n] != '.' {
        return false
    }
    for i <- iter.Range(0, n) {
        if t.data[path + 1 + i] != t.data[nm + 1 + i] {
            return false
        }
    }
    return true
}

// ⑥ の対象（while の条件の && の連鎖に x != nil）
func whileNil(t ast.Tree, nd ast.Node) bool {
    return nilIn(t, nd.a, lexer.AmpersandAmpersand, 1, false)
}

// ⑤ の対象（else つき if で、&& の連鎖に x != nil・または ② に任せない || の連鎖に x == nil）なら 1（&&）/ 2（||）・でなければ 0
func fiveAt(t ast.Tree, nd ast.Node) int {
    if nd.kind != ast.EIf || nd.c < 0 {
        return 0
    }
    if nilIn(t, nd.a, lexer.AmpersandAmpersand, 1, true) {
        return 1
    }
    two := diverges(t, nd.b) && ast.ListLen(t, t.nodes[nd.b].a) == 1
    return if !two && nilIn(t, nd.a, lexer.PipePipe, 2, true) { 2 } else { 0 }
}

// 節 n の op の連鎖（multi なら 2 項以上）に nilTestKind が want の項があるか
func nilIn(t ast.Tree, n int, op int, want int, multi bool) bool {
    cs := chainOf(t, n, op)
    if multi && len(cs) < 2 {
        return false
    }
    for q <- iter.Range(0, len(cs)) {
        if nilTestKind(t, cs[q]) == want {
            return true
        }
    }
    return false
}

// 節ndをflowRoundが変換するか（下の ①〜③ の条件と同じ — 変換する節が1つも無い周は節の表とデータのコピーを作らずに返す）
func flowAt(t ast.Tree, nd ast.Node) bool {
    if nd.kind == ast.EIf {
        return fiveAt(t, nd) != 0 || nd.c < 0 && nilIn(t, nd.a, lexer.AmpersandAmpersand, 1, true) ||
            diverges(t, nd.b) && ast.ListLen(t, t.nodes[nd.b].a) == 1 && nilIn(t, nd.a, lexer.PipePipe, 2, true)
    }
    if nd.kind == ast.EBinary && (nd.a == lexer.AmpersandAmpersand || nd.a == lexer.PipePipe) {
        l := chainOf(t, nd.b, nd.a)
        r := chainOf(t, nd.c, nd.a)
        mut cs := mut []int{}
        for i <- iter.Range(0, len(l)) {
            cs = append(cs, l[i])
        }
        for i <- iter.Range(0, len(r)) {
            cs = append(cs, r[i])
        }
        return valueNilAt(t, freeze(cs), nd.a) >= 0
    }
    if nd.kind == ast.SWhile && whileNil(t, nd) {
        return true
    }
    if nd.kind == ast.KBlock || nd.kind == ast.EBlock {
        k := ast.ListLen(t, nd.a)
        for q <- iter.Range(0, k - 1) {
            s := t.nodes[ast.ListAt(t, nd.a, q)]
            if s.kind == ast.SExpr && t.nodes[s.a].kind == ast.EIf && t.nodes[s.a].c < 0 && diverges(t, t.nodes[s.a].b) && nilIn(t, t.nodes[s.a].a, lexer.PipePipe, 2, false) {
                return true
            }
        }
    }
    return false
}

// 木を1周変換する（変換したらchanged）
func flowRound(t ast.Tree) (ast.Tree, bool) {
    n0 := len(t.nodes)
    mut any := false
    for i <- iter.Range(0, n0) {
        any = any || flowAt(t, t.nodes[i])
    }
    if !any {
        return t, false
    }
    mut ns := mut []ast.Node{}
    for i <- iter.Range(0, n0) {
        ns = append(ns, t.nodes[i])
    }
    mut x := Fx{n0: n0, nb: builder.Builder[ast.Node]{}, db: builder.Builder[int]{}}
    for j <- iter.Range(0, len(t.data)) {
        builder.Push(mut x.db, t.data[j])
    }
    mut changed := false
    // ①〜③ に任せるifの条件（④ で変換しない）
    mut kept := mut []bool{}
    for i <- iter.Range(0, n0) {
        kept = append(kept, false)
    }
    for i <- iter.Range(0, n0) {
        nd := t.nodes[i]
        if nd.kind == ast.EIf && (condKept(t, nd) || fiveAt(t, nd) != 0) {
            kept[nd.a] = true
            keepChain(t, mut kept, unparen(t, nd.a))
        }
    }
    for i <- iter.Range(0, n0) {
        nd := t.nodes[i]
        tok := nd.tok
        if nd.kind == ast.EBinary && (nd.a == lexer.AmpersandAmpersand || nd.a == lexer.PipePipe) && !kept[i] {
            op := nd.a
            cs := chainOf(t, i, op)
            p := valueNilAt(t, cs, op)
            if p >= 0 {
                ns[i] = fxValueChain(mut x, cs, p, op, tok)
                changed = true
                continue
            }
        }
        if nd.kind == ast.SWhile && whileNil(t, nd) {
            // ⑥ while C { B } → while true { if C { B } else { break } }
            brk := fxNode(mut x, ast.Node{ast.SBreak, tok, 0, 0, 0, 0, 0, 0})
            els := fxNode(mut x, ast.Node{ast.EBlock, tok, ast.PutList(mut x.db, []int{brk}), 0, 0, 0, 0, 0})
            iff := fxNode(mut x, ast.Node{ast.EIf, tok, nd.a, nd.b, els, 0, 0, 0})
            ns[i] = ast.Node{ast.SWhile, tok, fxConst(mut x, "true", tok), fxBlock(mut x, iff, tok), nd.c, nd.d, nd.e, nd.f}
            changed = true
            continue
        }
        five := fiveAt(t, nd)
        if five != 0 {
            // ⑤ else つき if の本体
            op := if five == 1 { lexer.AmpersandAmpersand } else { lexer.PipePipe }
            cs := chainOf(t, nd.a, op)
            mut p := -1
            for q <- iter.Range(0, len(cs)) {
                if p < 0 && nilTestKind(t, cs[q]) == five {
                    p = q
                }
            }
            cond := fxNode(mut x, fxValueChain(mut x, cs, p, op, tok))
            if five == 1 {
                nb := fxNarrowBody(t, mut x, cs, 1, nd.b, tok)
                ns[i] = ast.Node{ast.EIf, tok, cond, if nb >= 0 { fxBlock(mut x, nb, tok) } else { nd.b }, nd.c, 0, 0, 0}
            } else {
                e := t.nodes[nd.c]
                eb := if e.kind == ast.EBlock { fxNode(mut x, ast.Node{ast.KBlock, e.tok, e.a, 0, 0, 0, 0, 0}) } else { fxBlock(mut x, nd.c, tok) }
                nb := fxNarrowBody(t, mut x, cs, 2, eb, tok)
                ns[i] = ast.Node{ast.EIf, tok, cond, nd.b, if nb >= 0 { fxBlockE(mut x, nb, tok) } else { nd.c }, 0, 0, 0}
            }
            changed = true
            continue
        }
        if nd.kind == ast.EIf {
            // ① && の連鎖の中の x != nil
            ands := chainOf(t, nd.a, lexer.AmpersandAmpersand)
            mut p := -1
            for q <- iter.Range(0, len(ands)) {
                if p < 0 && nilTestKind(t, ands[q]) == 1 {
                    p = q
                }
            }
            // elseのあるifは変換しない（elseの分岐〔else-ifの連鎖ごと〕の複製がlowerの展開で膨らむ — 自己buildのRSS 479 → 2248 MBの実測）
            if p >= 0 && len(ands) > 1 && nd.c < 0 {
                els := nd.c
                // 中: x != nil の then = 残りの連鎖の if（無ければ元の then）
                inner := if p + 1 < len(ands) {
                    fxBlock(mut x, fxNode(mut x, ast.Node{ast.EIf, tok, fxJoin(mut x, ands, p + 1, len(ands), lexer.AmpersandAmpersand, tok), nd.b, els, 0, 0, 0}), tok)
                } else {
                    nd.b
                }
                mid := ast.Node{ast.EIf, tok, ands[p], inner, els, 0, 0, 0}
                if p == 0 {
                    ns[i] = mid
                } else {
                    m := fxNode(mut x, mid)
                    ns[i] = ast.Node{ast.EIf, tok, fxJoin(mut x, ands, 0, p, lexer.AmpersandAmpersand, tok), fxBlock(mut x, m, tok), els, 0, 0, 0}
                }
                changed = true
                continue
            }
            // ② || の連鎖の中の x == nil（then が脱出のときだけ）
            ors := chainOf(t, nd.a, lexer.PipePipe)
            mut r := -1
            for q <- iter.Range(0, len(ors)) {
                if r < 0 && nilTestKind(t, ors[q]) == 2 {
                    r = q
                }
            }
            // then は 1 文（脱出だけ）のときだけ複製する（大きい then の複製は膨らむ）
            if r >= 0 && len(ors) > 1 && diverges(t, nd.b) && ast.ListLen(t, t.nodes[nd.b].a) == 1 {
                els := nd.c
                // x == nil の else = 残りの連鎖の if（無ければ元の else）
                after := if r + 1 < len(ors) {
                    fxNode(mut x, ast.Node{ast.EIf, tok, fxJoin(mut x, ors, r + 1, len(ors), lexer.PipePipe, tok), nd.b, els, 0, 0, 0})
                } else {
                    els
                }
                mid := ast.Node{ast.EIf, tok, ors[r], nd.b, after, 0, 0, 0}
                if r == 0 {
                    ns[i] = mid
                } else {
                    m := fxNode(mut x, mid)
                    ns[i] = ast.Node{ast.EIf, tok, fxJoin(mut x, ors, 0, r, lexer.PipePipe, tok), nd.b, m, 0, 0, 0}
                }
                changed = true
                continue
            }
        }
        if nd.kind == ast.KBlock || nd.kind == ast.EBlock {
            // ③ 早期脱出の後ろの文を else へ
            l := nd.a
            k := ast.ListLen(t, l)
            mut at0 := -1
            for q <- iter.Range(0, k) {
                s := t.nodes[ast.ListAt(t, l, q)]
                if at0 < 0 && q + 1 < k && s.kind == ast.SExpr {
                    e := t.nodes[s.a]
                    if e.kind == ast.EIf && e.c < 0 && diverges(t, e.b) {
                        ors := chainOf(t, e.a, lexer.PipePipe)
                        mut neg := false
                        for w <- iter.Range(0, len(ors)) {
                            if nilTestKind(t, ors[w]) == 2 {
                                neg = true
                            }
                        }
                        if neg {
                            at0 = q
                        }
                    }
                }
            }
            if at0 >= 0 {
                s := t.nodes[ast.ListAt(t, l, at0)]
                e := t.nodes[s.a]
                mut rest := mut []int{}
                for q <- iter.Range(at0 + 1, k) {
                    rest = append(rest, ast.ListAt(t, l, q))
                }
                eb := fxNode(mut x, ast.Node{ast.EBlock, e.tok, ast.PutList(mut x.db, freeze(rest)), 0, 0, 0, 0, 0})
                ni := fxNode(mut x, ast.Node{ast.EIf, e.tok, e.a, e.b, eb, 0, 0, 0})
                ns2 := fxNode(mut x, ast.Node{ast.SExpr, s.tok, ni, 0, 0, 0, 0, 0})
                mut head := mut []int{}
                for q <- iter.Range(0, at0) {
                    head = append(head, ast.ListAt(t, l, q))
                }
                head = append(head, ns2)
                ns[i] = ast.Node{nd.kind, tok, ast.PutList(mut x.db, freeze(head)), nd.b, nd.c, nd.d, nd.e, nd.f}
                changed = true
            }
        }
    }
    if !changed {
        return t, false
    }
    added := builder.Build(mut x.nb)
    for i <- iter.Range(0, len(added)) {
        ns = append(ns, added[i])
    }
    return ast.Tree{freeze(ns), builder.Build(mut x.db), t.file}, true
}
