package loader

// 名前・パスの小道具。名前・パス（packageのパス・参照名・ラベル名・ファイルのパス）はstringで持つ（byte型のフェーズの入口）。
// 木のデータプールの文字列（[n, バイト…]）からstringを作るAPIはName / NameOkの2つだけ（UTF-8の検査とコピーはここで1回）:
// - Name = 識別子の綴り（lexer が ASCII に限る）と、load が NameOk で検査済みの import のパス — 失敗しない
// - NameOk = 文字列リテラル由来で検査が要るもの（import のパス・@embed のパターン）— 失敗は呼び手が loader の拒否に落とす
// 比べるだけなら StrIs（コピーしない）

import "ast"
import "std/iter"
import "std/strings"

// バイト順（辞書式）で a < b か
func less(a []byte, b []byte) bool {
    mut i := 0
    while i < len(a) && i < len(b) {
        if a[i] != b[i] {
            return a[i] < b[i]
        }
        i += 1
    }
    return len(a) < len(b)
}

// バイト順（辞書式 — LC_ALL=C sortと同じ）でa < bか（stringに順序の比較は無い — 並べ替えのAPIはこれ1本）
func ByteLess(a string, b string) bool {
    return less(bytes(a), bytes(b))
}

// データプールの文字列s（t.data[s] = バイト数、続くn個がバイト — プールはintの列のまま）のバイト列（コピー）
func Bytes(t ast.Tree, s int) []byte {
    mut b := mut []byte{}
    for i <- iter.Range(0, t.data[s]) {
        b = append(b, byte(t.data[s + 1 + i]))
    }
    return freeze(b)
}

// データプールの文字列 s が w と一致するか（コピーしない）
func StrIs(t ast.Tree, s int, w string) bool {
    wb := bytes(w)
    if t.data[s] != len(wb) {
        return false
    }
    for i <- iter.Range(0, len(wb)) {
        if t.data[s + 1 + i] != int(wb[i]) {
            return false
        }
    }
    return true
}

// データプールの文字列 s の string（UTF-8 でなければ ok = false）
func NameOk(t ast.Tree, s int) (string, bool) {
    r := string(Bytes(t, s)) catch return "", false
    return r, true
}

// データプールの文字列 s の string（識別子か検査済みの import のパス — 上の冒頭の注記。UTF-8 でない入力はここに届かない）
func Name(t ast.Tree, s int) string {
    r, ok := NameOk(t, s)
    if !ok {
        return "?"
    }
    return r
}

// p のバイト [a, b)（a・b は ASCII の区切り '/' '.' の前後 — UTF-8 の文字の途中では切らないので string(…) は失敗しない。
// string には添字も部分列も無い — 24 節）
func cut(p string, a int, b int) string {
    r := string(bytes(p)[a:b]) catch return "?"
    return r
}

// パスの親（'/' が無ければ空）
func Dirname(p string) string {
    dir, _, slashed := strings.CutLast(p, "/")
    return if slashed { dir } else { "" }
}

// パスの末尾の要素
func Basename(p string) string {
    _, base, slashed := strings.CutLast(p, "/")
    return if slashed { base } else { p }
}

// import のパスの修飾子（alias の無い import の参照名 — language.md 20 節）: `std/` を落とし、段の区切り '/' を '.' に
// （std/http/server → http.server・testdata/box → testdata.box）
func QualOf(p string) string {
    q := if strings.HasPrefix(p, "std/") { cut(p, 4, len(bytes(p))) } else { p }
    mut out := mut []byte{}
    for c <- bytes(q) {
        out = append(out, if c == '/' { byte('.') } else { c })
    }
    r := string(freeze(out)) catch return "?"
    return r
}

// import 節 im の参照名（alias か修飾子）
func ImpRef(t ast.Tree, im ast.Node) string {
    return if im.a >= 0 { Name(t, im.a) } else { QualOf(Name(t, im.b)) }
}

// import 節 im が参照名 ref で引けるか（alias か修飾子）
func ImpRefIs(t ast.Tree, im ast.Node, ref string) bool {
    return ImpRef(t, im) == ref
}

// 修飾子の根の段（`http.server` → `http`。1 段ならそのまま）
func RootSeg(q string) string {
    root, _, dotted := strings.Cut(q, ".")
    return if dotted { root } else { q }
}
