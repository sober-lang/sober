package loader

// std/testing/cell（language.md 41 節「状態を貯めるfake」）のloaderのフェーズ: ① importはテストの構成のファイル（`_test.sober`・`_double.sober`）とstdだけ
// ② 把手 `cell.Cell[T]{…}` のリテラルはトップレベルのconstの右辺だけ ③ その右辺にフィールド `key:` を足す（値 = packageのパスとconstの名前の
// ハッシュ — 宣言ごとに 1 つ・読み込みの順に依らないので package ごとのキャッシュの鍵と食い違わない）。利用者は key を書かない

import "std/builder"
import "std/iter"
import "std/strings"
import "ast"
import "diag"

const CELL_PATH = "std/testing/cell"

// 全ファイルの把手を変換する（格納場所のpackageをimportしないファイルはそのまま）
@errors(diag.Cell)
func cellsAll(ts []ast.Tree, fpkg []string, fpath []string, fstd []bool) ([]ast.Tree, error?) {
    mut out := mut []ast.Tree{}
    for f <- iter.Range(0, len(ts)) {
        t := ts[f]
        ref, itok := cellRef(t)
        if ref == "" {
            out = append(out, t)
        } else {
            std := fstd[f] || isStd(fpkg[f])
            if !std && !strings.HasSuffix(fpath[f], "_test.sober") && !strings.HasSuffix(fpath[f], "_double.sober") {
                return ts, diag.Cell{at: diag.Pos{file: f, tok: itok}, kind: 1}
            }
            nt := cellTree(t, f, ref, fpkg[f])?
            out = append(out, nt)
        }
    }
    return freeze(out), nil
}

// ファイルの格納場所のpackageの参照名とimportの字句（importが無ければ ""）
func cellRef(t ast.Tree) (string, int) {
    imps := t.nodes[t.file].b
    for k <- iter.Range(0, ast.ListLen(t, imps)) {
        im := t.nodes[ast.ListAt(t, imps, k)]
        if Name(t, im.b) == CELL_PATH {
            return ImpRef(t, im), im.tok
        }
    }
    return "", 0
}

// ファイル f の把手のリテラルを検査し、const の右辺に key を足した木（無ければそのまま）
@errors(diag.Cell)
func cellTree(t ast.Tree, f int, ref string, pkg string) (ast.Tree, error?) {
    tn := ref + ".Cell"
    cl := t.nodes[t.file].e
    mut rhs := mut []int{}
    mut names := mut []string{}
    for k <- iter.Range(0, ast.ListLen(t, cl)) {
        c := t.nodes[ast.ListAt(t, cl, k)]
        rhs = append(rhs, c.b)
        names = append(names, Name(t, c.a))
    }
    // 変換する節: [リテラルの節, constの名前の添字]
    mut hits := mut []int{}
    for j <- iter.Range(0, len(t.nodes)) {
        x := t.nodes[j]
        if x.kind == ast.ECall && cellUpdateBad(t, x, ref) {
            return t, diag.Cell{at: diag.Pos{file: f, tok: if ast.ListLen(t, x.b) == 2 { t.nodes[ast.ListAt(t, x.b, 1)].tok } else { x.tok }}, kind: 4}
        }
        if x.kind == ast.EComposite && Name(t, x.a) == tn {
            mut at := -1
            for k <- iter.Range(0, len(rhs)) {
                if rhs[k] == j {
                    at = k
                }
            }
            if at < 0 {
                return t, diag.Cell{at: diag.Pos{file: f, tok: x.tok}, kind: 2}
            }
            for e <- iter.Range(0, ast.ListLen(t, x.b)) {
                el := t.nodes[ast.ListAt(t, x.b, e)]
                if el.a >= 0 && Name(t, el.a) == "key" {
                    return t, diag.Cell{at: diag.Pos{file: f, tok: t.nodes[el.b].tok}, kind: 3}
                }
            }
            hits = append(hits, j)
            hits = append(hits, at)
        }
    }
    if len(hits) == 0 {
        return t, nil
    }
    n0 := len(t.nodes)
    mut db := builder.Builder[int]{}
    for j <- iter.Range(0, len(t.data)) {
        builder.Push(mut db, t.data[j])
    }
    kname := ast.PutLit(mut db, "key")
    // 足す節: 把手ごとに (EInt, KElem)
    mut lists := mut []int{}
    for h <- iter.Range(0, len(hits) / 2) {
        x := t.nodes[hits[2 * h]]
        mut es := mut []int{}
        for e <- iter.Range(0, ast.ListLen(t, x.b)) {
            es = append(es, ast.ListAt(t, x.b, e))
        }
        es = append(es, n0 + 2 * h + 1)
        lists = append(lists, ast.PutList(mut db, freeze(es)))
    }
    mut nb := builder.Builder[ast.Node]{}
    for j <- iter.Range(0, n0) {
        x := t.nodes[j]
        mut li := -1
        for h <- iter.Range(0, len(hits) / 2) {
            if hits[2 * h] == j {
                li = h
            }
        }
        if li >= 0 {
            builder.Push(mut nb, ast.Node{x.kind, x.tok, x.a, lists[li], x.c, x.d, x.e, x.f})
        } else {
            builder.Push(mut nb, x)
        }
    }
    for h <- iter.Range(0, len(hits) / 2) {
        x := t.nodes[hits[2 * h]]
        builder.Push(mut nb, ast.Node{ast.EInt, x.tok, cellKey(pkg + "." + names[hits[2 * h + 1]]), 0, 0, 0, 0, 0})
        builder.Push(mut nb, ast.Node{ast.KElem, x.tok, kname, n0 + 2 * h, 0, 0, 0, 0})
    }
    return ast.Tree{builder.Build(mut nb), builder.Build(mut db), t.file}, nil
}

// 呼び出し x が `ref.Update(h, f)` で f がラムダのリテラル（仮引数 1 つ）でないか
func cellUpdateBad(t ast.Tree, x ast.Node, ref string) bool {
    c := t.nodes[x.a]
    if c.kind != ast.ESelector || Name(t, c.b) != "Update" || t.nodes[c.a].kind != ast.EIdent || Name(t, t.nodes[c.a].a) != ref {
        return false
    }
    if ast.ListLen(t, x.b) != 2 {
        return true
    }
    l := t.nodes[ast.ListAt(t, x.b, 1)]
    return l.kind != ast.ELambda || ast.ListLen(t, l.a) != 1
}

// 把手の鍵（0 でない正の 62 ビット — 2 本の 31 ビットの多項式ハッシュを並べる）
func cellKey(s string) int {
    b := bytes(s)
    mut h1 := 7
    mut h2 := 11
    for i <- iter.Range(0, len(b)) {
        h1 = (h1 * 131 + int(b[i])) % 2147483647
        h2 = (h2 * 257 + int(b[i])) % 2147483629
    }
    return h1 * 2147483648 + h2 + 1
}
