package diag

// 診断（C4 — reaudit 第 2 弾）: 位置 Pos と拒否の種類ごとの error ラベル（language.md 13 節 — 種類 = ラベルのタグ）、印字 Format。
// 層（loader / desugar / lower）は拒否をここのラベルで返し、app が Format で 1 行にする。位置は各層が手元の節（desugar の NodeRef・
// loader の字句）から raise の時点で Pos に落とす（ファイルは推測しない — 引けなければ -1）。
// ラベルは位置だけを持つ（文言はFormatの分岐 — stringのフィールドを持たせるとerror? の全値が中身つきの境界コピーを背負う）。
// バッファする形（loaderのNameHit・desugarのnomLog）はPosか (ファイル, 字句) の組を別に持つ

import "lexer"
import "std/iter"
import "std/strings"

// ファイル file（loader の Program のファイルの番号 — 無ければ -1）の字句 tok
type Pos struct {
    file int
    tok int
}

// 位置の無い拒否の Pos
func None() Pos {
    return Pos{file: -1, tok: 0}
}

// ── desugar（脱糖器）の拒否 — 綴りは Zig 版の error 名 ──

// コアの断片の外（型検査器が扱わない形）
type CoreFragment error {
    at Pos
}

// 名前が引けない
type UnknownName error {
    at Pos
}

// 形が不正（kind 0 = 名指しなし・1 = 呼び出しの実引数の数が仮引数の数と合わない）
type Malformed error {
    at Pos
    kind int
}

// 型の違反。kind 0 = 型宣言の区別の違反（language.md 32 節 — 表層型の照合）・1 = string の値の switch（15 節 — 単値の subject は
// int / union / error / T?）・2 = T? と値の == / !=（絞り込んでから比べる — 15 節）・3 = string を for の生成元に直に置いた（7 節）・
// 4 = 関数値のoption（`F?` のフィールド・束縛・mapの読み）を絞らずに呼んだ・5 = Defとして呼ぶジェネリックにregionを持つ型引数（31 節R1）・
// 6 = 局所に束縛した名前付き関数を値の位置に置いた（spec F-11）・7 = ゼロ値の無い型（関数値・union）のフィールドをリテラルで省いた・
// 8 = 値化できない名前付き関数型（型引数つき）への変換 `Gen[T](f)`・9 = 別の名前付き関数型の値の変換（nominal）
type TypeMismatch error {
    at Pos
    kind int
}

// println の実引数が印字できない型（int・byte・bool・string 以外 — `T?`・struct・多値等）
type PrintArg error {
    at Pos
}

// len を string に掛けた（language.md 33 節 — string に len は無い。バイト数は len(bytes(s))）
type LenString error {
    at Pos
}

// 期待型の無い位置のnil（`x := if c { 3 } else { nil }`・`f() catch nil` のnilの分岐 — 型が決まらない）
type UntypedNil error {
    at Pos
}

// unionの型パターンのswitchが全variantを覆わない（defaultも `_` も無い）。missing = 一度も分岐に出ない最初のvariantの宣言
// （全部のvariantが分岐に出ていて入れ子のフィールドの網羅だけ漏れていればNone）— 文面はappがmissingの字句（variantの名前）を添える（Note・Spell）
type NonExhaustive error {
    at Pos
    missing Pos
}

// imm の map / slice への書き込み（`m[k] = v` — 束縛が mut でも値が imm: `mut m := map[K]V{}` は右辺の mut を書き忘れた形）
type ImmWrite error {
    at Pos
}

// structのcompositeのフィールドの値の型がフィールドの宣言型に合わない（スカラーのフィールド）
type FieldType error {
    at Pos
}

// ── lower の拒否（種類の綴りは Zig 版の error 名 — Undefined* は引けなかったものの種類ごと）──

type Unsupported error {
    at Pos
}

type UndefinedName error {
    at Pos
}

type UndefinedFunction error {
    at Pos
}

type UndefinedType error {
    at Pos
}

type UndefinedField error {
    at Pos
}

type Mismatch error {
    at Pos
}

type Missing error {
    at Pos
}

// ── loader の拒否（1 ラベル 1 文言 — 文言は Format）──

type ReadFail error {
    at Pos
}

type GrammarMismatch error {
    at Pos
}

type NoPkgDir error {
    at Pos
}

type ImportPath error {
    at Pos
}

type NoStd error {
    at Pos
}

type EmbedReceiver error {
    at Pos
}

type EmbedPattern error {
    at Pos
}

type EmbedNoMatch error {
    at Pos
}

type EmbedPathUtf8 error {
    at Pos
}

type EmbedRead error {
    at Pos
}

type EmbedFileUtf8 error {
    at Pos
}

type PkgName error {
    at Pos
}

type RefCollide error {
    at Pos
}

// 修飾名の参照名をそのファイルが import していない（import はファイルごと — language.md 20 節）
type NotImported error {
    at Pos
}

type ImportCycle error {
    at Pos
}

type Noinline error {
    at Pos
}

type ErrorHoldsError error {
    at Pos
}

// 受理しない再帰の型宣言（loader — rectype.sober）。kind = 理由（0 = 値に埋まる閉路〔I〕・1 = 組の中の参照の型引数が宣言の型引数そのままでない）
type RecursiveType error {
    at Pos
    kind int
}

// kind = 拒否の理由（loader/consts.sober の CE_* — 0 は理由の添えなし）
type ConstExpr error {
    at Pos
    kind int
}

type LocalBuiltin error {
    at Pos
}

type LocalImport error {
    at Pos
}

// std の外のファイルから `std/internal/…` を import した（std の実装の詳細 — language.md 20 節）
type InternalImport error {
    at Pos
}

type LocalTop error {
    at Pos
}

type TParamBuiltin error {
    at Pos
}

type TParamTop error {
    at Pos
}

type DeclBuiltin error {
    at Pos
}

// トップレベルの名前（const・func・型）が package の中で 2 度宣言された（loader — localnames.sober。variant どうしは VariantDup）
type TopDup error {
    at Pos
}

type VariantDup error {
    at Pos
}

type Shadow error {
    at Pos
}

type PureExprStmt error {
    at Pos
    // 0 = 純粋な式の値を捨てる文・1 = 結果を持つ func の本体の末尾の呼び出しの式文（値は戻り値にならない — spec F-2）
    kind int
}

// `case nil:` の分岐を変換できない形（loader/nilcase.sober — D1）。kind = 1 nilの分岐が2つ以上・2 `nil | …`・3前に名前のパターン・4 nilの分岐しか無い・5〜8は2位置の `case P, nil:`（loader/mvcase.soberのmvBad）
type NilCase error {
    at Pos
    kind int
}

// 先頭が 0 の 10 進の整数リテラル（`010` — Go の旧来の 8 進と読み違える。syntax.md 決定 18 — 8 進は `0o755` だけ）
type LeadingZero error {
    at Pos
}

// 値が型に収まらないリテラル（kind = 0 int の範囲外・1 float で ±Inf に丸まる — language.md 37 節）
type LitRange error {
    at Pos
    kind int
}

// 名前付き実引数（syntax.md決定7）を位置へ変換できない形（loader/namedargs.sober・名前付き関数型の値はdesugar/namedval.sober）。kind = 1呼び先がfunc宣言でも仮引数名を持つ名前付き関数型の値でもない・2その名前の仮引数が無い・
// 3宣言の順でない（重複を含む）・4位置で渡した仮引数を名前でも渡した・5省略できない（`T?` でない）仮引数が無い・6パイプステージで穴 `_` が無い
type NamedArg error {
    at Pos
    kind int
}

// CatchLhsはcatchの左辺が `(T, error?)` を返さないfunc宣言の呼び出し（loader/catchx.sober — 変換した後の多値の束縛の数の照合より先に特定する）
// MultiBind は多値の受け方の誤り（loader — catchx.sober）: kind 0 = 値 1 つの束縛（`d := f()`）の値が 2 つ以上の結果を返す呼び出し・
// 1 = 多値を既存の名前へ代入（`a, b = f()` — spec X-6: 多値は `:=` の束縛か全部 `_` の捨てでだけ受ける）
type MultiBind error {
    at Pos
    kind int
}

// 同じ呼び出しの mut 実引数の経路の重なり（同じ / 一方が他方の接頭 — loader/mutalias.sober・language.md 26 節）。位置 = 後ろの mut 実引数
type MutAlias error {
    at Pos
}

type CatchLhs error {
    at Pos
}

// 封の型（フィールドの型に宣言したpackageの非公開の型を持つstruct — utf8.View・json.Doc）の、外でのフィールドつきリテラル（loader/sealx.sober・language.md 15 節）
type Sealed error {
    at Pos
}

// 同一性を持つ型（std/task の札・handle・端点・Pool、std/io の File）のゼロ値を std の外で作る composite（loader/identityx.sober・language.md 28 節 /
// 11 節）。kind 1〜6 = 型そのもののゼロ値 `T{}`（1 task.Scope・2 task.Handle・3 task.Sender・4 task.Receiver・5 task.Pool・6 io.File）・
// 11〜16 = その型を（フィールドを通して）持つフィールドを省いたcomposite（`W{}`・部分リテラル）
type Identity error {
    at Pos
    kind int
}

// 開いたファイル io.File の使い方の拒否（desugar/filecheck.sober・language.md 28 節「資源とストリーム」）。kind = filecheck の FC_*
// （1規則の形の外のOpen・2直後の文が defer Close でない・3規則の形の外のClose・4 deferが別の名前を閉じる・5コピーの束縛・6代入・7 return / Fileを返す呼び出し・
// 8 composite・append・9クロージャの捕獲・10 give:）
type FileUse error {
    at Pos
    kind int
}

// 関数型のmut仮引数の拒否（language.md 25 節）。kind = 1 η で変換する名前付き関数のmut仮引数が関数型と違う・2仮引数の数が関数型と違う・
// 3関数型のmut仮引数が2本以上・4ラムダの仮引数のmutのマークが関数型と違う・5関数値の呼び出しの実引数のmutのマークがmut仮引数と違う
type FnArg error {
    at Pos
    kind int
}

// 省略可の匿名関数型 `(func(…) R)?`（language.md 25 節 Z — loader/optfn.sober）の拒否。kind = 1 裸の `func(…)?`（括弧の形へ誘導）・
// 2 func宣言の仮引数の外（名前付き関数型の中・structのフィールド・結果・ラムダの仮引数など）・3実引数の形（nil・ラムダ・関数の名前・囲む関数の省略可の仮引数だけ）・
// 4 `if p != nil { … }` の外での使用・5 呼ぶ・渡す・nil と比べる以外の使用（束縛・格納・return など）
type FnOpt error {
    at Pos
    kind int
}

// 値の位置（値化可能な named fn type のstructのフィールド — language.md 25 節）のラムダの、値になれない形
// （loader/fnval.sober）。kind = 1 mut（mut 束縛・mut 実引数）の捕捉・2 非局所 return・3 `?`（非局所脱出）・4 ラムダを越える break / continue・
// 5値として変換できない捕捉（同一性の型・関数値・能力・mutの器 — desugar/closure.soberが束縛の型で判定）・
// 局所の束縛のラムダ（借りの局所 — `f := (…) => …`・loader/fnval.sober の llBind）: 8 mut の束縛・9 他の名前と同時の束縛・10 呼ぶ / 展開の位置へ渡す以外の使用・
// 11 値の位置・値の呼び出しの実引数へ渡す・12 値の位置のラムダの中での使用・13 本体の return・14 本体の `?`・15 本体を越える break / continue・
// 16 本体がラムダより後で宣言した名前を指す。17 = 匿名の関数型の仮引数を持つ関数（展開される）どうしの再帰（loader/funcs.sober の scanFuncs）
type FnCap error {
    at Pos
    kind int
}

// 失敗しうる生成元（結果が `error?` の呼び出し形の生成元 — language.md 7 節）のマークの誤り（loader/forfallible.sober）。
// kind 1 = マーク `?` が無い（errorを黙って捨てる形）・2 = 式の位置のfor（yield形）の生成元・3 = マーク `?` つきだが生成元の結果が `error?` 1つでない・
// 4 = 生成元の呼び先が名前付き関数型の仮引数（展開されないので生成元にならない — L-for の範囲外）
type ForFallible error {
    at Pos
    kind int
}

// assertの配置先の拒否: kind 0 = `_test.sober` の外（T7 — assertはテストの語彙）・1 = quick.Checkのプロパティのラムダの中（落ちた試行はシュリンクできない — 偽は最後のbool式で返す）
type AssertOutsideTest error {
    at Pos
    kind int
}

// 型宣言の形の拒否（loader/alias.sober — language.md 32 節）。kind = 0 定義型の下地が int / bool でない・1 別名の右辺が型宣言の名前でない
// （組み込みの型・合成の型・型引数つき・error / panic ラベル）・2 別名の循環・3 型パラメータつきの別名・4 別名の右辺が未定義か見えない・
// 5書き換えの後に別名を指す名前が残った（fail-closed — loaderのフェーズの漏れ）
type TypeDecl error {
    at Pos
    kind int
}

// @layout（language.md 36 節）の拒否（loader/layout.sober）。kind = 1 `[N]T` のフィールドが @layoutのstructの外・2 @layoutがstructでない型宣言に付いている・
// 3 @layoutのフィールドの型が幅の語（か幅の語の `[N]`、N ≥ 1）でない・4 幅の語が @layoutのフィールドの外・5 @layoutのstructにフィールドが無いか型パラメータがある・
// 6 `layout.X[T]` のTが @layoutのstructでない・7 std/layoutのAPIの形（Decode / DecodeAt / Encodeは `[T]` をつけて呼ぶ・Sizeは `[T]` をつけて呼ばない）・
// 8 @layoutのstructのリテラルのフィールドの整数リテラルが幅に収まらない
type Layout error {
    at Pos
    kind int
}

// `json.Decode[T]`（shape[T] — loader/jsonshape.sober）の拒否（kind 1 = Tがstructでない・2 = 範囲外のフィールドの型・3 = 型引数つきで呼んでいない・
// 4 = DecodeのTのフィールドに裸のjson.Value）
type JsonShape error {
    at Pos
    kind int
}

// `@intrinsic("鍵")` の宣言（std の本体なしの宣言 — loader/intrinsic.sober）の拒否（kind 1 = std の外・2 = 鍵が閉じた集合に無い・
// 3 = 署名が鍵の実装と合わない・4 = 同じ package に同じ名前の宣言が 2 つ）
type Intrinsic error {
    at Pos
    kind int
}

// structured concurrency（std/task — language.md 11 節）の呼び出し点の拒否（kind 1 = build の経路は未実装・
// 3〜17 = 呼び出し点の形 — desugar/parcheck.soberの表・18 = 多値の型の格納場所 — loader/tupletype.sober）
type Par error {
    at Pos
    kind int
}

// 健全性の規則（analyzer の freeze の U1〜U3 — language.md 17 節）の拒否（build — lower の build が表層型の表の上で掛ける。n = 指摘の数）。
// 行は app が analyzer.Freeze で引き直して analyze と同じ形で出す（拒否の経路だけ — slice を持つラベルを default つきの switch で受けると
// 検査器が def error にする）
type Frozen error {
    n int
}

// err が Frozen か
// lower の拒否が内部段の名前だけ（文面の無い Mismatch / Unsupported）か
func IsInternal(err error?) bool {
    return switch err {
    case nil: false
    case Mismatch{at}: true
    case Unsupported{at}: true
    default: false
    }
}

func IsFrozen(err error?) bool {
    return switch err {
    case nil: false
    case Frozen{n}: true
    default: false
    }
}

// panic ラベル（language.md 27 節 — loader/panicx.sober の PL_*）の拒否。kind = 1 裸の `panic()`・2 実引数がラベルのリテラル 1 つでない・
// 3リテラルの型がpanicラベルでない・4 RegionExceededを書いた・5フィールドの書き方・6宣言のフィールドの型・7組み込みのラベルの名前の宣言・8実引数の外の使用
type PanicLabel error {
    at Pos
    kind int
}

// `_test.sober` の `TestXxx` が引数・戻り・型パラメータを持つ（テストのビルド — loader/testmain.sober。T3）
type TestSignature error {
    at Pos
}

// テストの構成の差し替え（loader/doubles.sober — language.md 41 節）の拒否。kind は Format の文面の番号
type Double error {
    at Pos
    kind int
}

// テストの構成の状態の格納場所（std/testing/cell — language.md 41 節）の拒否。kindはFormatの文面の番号（1〜3 = loader・10〜 = desugar）
type Cell error {
    at Pos
    kind int
}

// モジュールの宣言（sober.mod — language.md 20 節）の拒否と木での名前の衝突。kind は Format の文面の番号
type Mod error {
    at Pos
    kind int
}

// 拒否 err の位置（ここのラベルでなければ None）
func At(err error?) Pos {
    return switch err {
    case nil: None()
    case CoreFragment{at}: at
    case UnknownName{at}: at
    case Malformed{at}: at
    case TypeMismatch{at}: at
    case PrintArg{at}: at
    case LenString{at}: at
    case UntypedNil{at}: at
    case NonExhaustive{at}: at
    case ImmWrite{at}: at
    case FieldType{at}: at
    case Unsupported{at}: at
    case UndefinedName{at}: at
    case UndefinedFunction{at}: at
    case UndefinedType{at}: at
    case UndefinedField{at}: at
    case Mismatch{at}: at
    case Missing{at}: at
    case ReadFail{at}: at
    case GrammarMismatch{at}: at
    case NoPkgDir{at}: at
    case NoStd{at}: at
    case ImportPath{at}: at
    case EmbedReceiver{at}: at
    case EmbedPattern{at}: at
    case EmbedNoMatch{at}: at
    case EmbedPathUtf8{at}: at
    case EmbedRead{at}: at
    case EmbedFileUtf8{at}: at
    case PkgName{at}: at
    case RefCollide{at}: at
    case NotImported{at}: at
    case ImportCycle{at}: at
    case Noinline{at}: at
    case ErrorHoldsError{at}: at
    case RecursiveType{at}: at
    case ConstExpr{at}: at
    case LocalBuiltin{at}: at
    case LocalImport{at}: at
    case InternalImport{at}: at
    case LocalTop{at}: at
    case TParamBuiltin{at}: at
    case TParamTop{at}: at
    case DeclBuiltin{at}: at
    case VariantDup{at}: at
    case TopDup{at}: at
    case Shadow{at}: at
    case PureExprStmt{at}: at
    case TestSignature{at}: at
    case Double{at}: at
    case Mod{at}: at
    case Cell{at}: at
    case Frozen{n}: None()
    case NilCase{at}: at
    case NamedArg{at}: at
    case LeadingZero{at}: at
    case LitRange{at}: at
    case AssertOutsideTest{at}: at
    case CatchLhs{at}: at
    case MultiBind{at}: at
    case MutAlias{at}: at
    case ForFallible{at}: at
    case FnArg{at}: at
    case FnCap{at}: at
    case FnOpt{at}: at
    case Sealed{at}: at
    case Identity{at}: at
    case Layout{at}: at
    case TypeDecl{at}: at
    case JsonShape{at}: at
    case Intrinsic{at}: at
    case PanicLabel{at}: at
    case Par{at}: at
    case FileUse{at}: at
    default: None()
    }
}

// 拒否 err の 1 行（where = At(err) の `<path>:<行>:<列>` — Where）:
// `desugar error at <where> (<種類>)`・`lower error at <where> (<種類>)`・`load error: <理由>`（位置があれば `load error at <where>: <理由>`）
func Format(err error?, where string) string {
    return switch err {
    case nil: "error"
    case CoreFragment{at}: "desugar error at ${where} (CoreFragment)"
    case UnknownName{at}: "desugar error at ${where} (UnknownName)"
    case Malformed{at, kind}: if kind == 1 { "desugar error at ${where} (Malformed): the number of arguments does not match the function's parameters" } else { "desugar error at ${where} (Malformed)" }
    case TypeMismatch{at, kind}: switch kind {
        case 1: "desugar error at ${where} (TypeMismatch): switch on a string value is not in the language — the subject of a value switch is an int (with default), a union, an error or a T?; compare strings with if / else if"
        case 2: "desugar error at ${where} (TypeMismatch): cannot compare a T? with a value — narrow it first (`if x != nil { … }`, `x != nil && …`, or switch with case nil)"
        case 3: "desugar error at ${where} (TypeMismatch): a string is not a for source — name the view: `for c <- bytes(s)`"
        case 4: "desugar error at ${where} (TypeMismatch): cannot call an optional function value (F?) — narrow it first (`if f != nil { f(…) }`)"
        case 6: "desugar error at ${where} (TypeMismatch): a local binding of a named function cannot be stored as a value (spec F-11) — use the function's name directly or a lambda"
        case 7: "desugar error at ${where} (TypeMismatch): a function-typed or union-typed value has no zero value — give every such field in the literal"
        case 8: "desugar error at ${where} (TypeMismatch): a generic named function type is not a value type — it can only be a parameter's type (pass a lambda or a function there)"
        case 9: "desugar error at ${where} (TypeMismatch): a value of another named function type cannot be converted — named function types are distinct even with the same signature"
        case 10: "desugar error at ${where} (TypeMismatch): a mut slice / map that is not a local path cannot be stored in an imm field — only `x`, `x.f` or `x[i]` is frozen implicitly there: bind the value first (`v := …`) and store `v`, or build the field's value as imm"
        case 5: "desugar error at ${where} (TypeMismatch): a generic func called as a function (not expanded) takes type arguments without regions — string / slice / map / channel types are not allowed here (a func with a mut or function-typed parameter is expanded and takes them)"
        default: "desugar error at ${where} (TypeMismatch)"
    }
    case PrintArg{at}: "desugar error at ${where} (PrintArg): println prints int, byte, bool and string values"
    case LenString{at}: "desugar error at ${where} (LenString): len is not defined on string — use len(bytes(s)) for the byte count"
    case UntypedNil{at}: "desugar error at ${where} (UntypedNil): nil has no type here — use it where a T? is expected (a typed parameter, field or result)"
    case NonExhaustive{at}: "error at ${where} (NonExhaustive): switch does not cover every variant of the union — add the missing cases or a default"
    case ImmWrite{at}: "error at ${where} (ImmWrite): cannot write into an imm map / slice — create it writable (`mut m := mut map[K]V{}`, `mut xs := mut []T{}`)"
    case FieldType{at}: "desugar error at ${where} (FieldType): the value does not have the field's declared type"
    case Unsupported{at}: "lower error at ${where} (Unsupported)"
    case UndefinedName{at}: "lower error at ${where} (UndefinedName)"
    case UndefinedFunction{at}: "lower error at ${where} (UndefinedFunction)"
    case UndefinedType{at}: "lower error at ${where} (UndefinedType)"
    case UndefinedField{at}: "lower error at ${where} (UndefinedField)"
    case Mismatch{at}: "lower error at ${where} (Mismatch)"
    case Missing{at}: "lower error at ${where} (Missing)"
    case ReadFail{at}: loadLine(err, where, "cannot read file")
    case GrammarMismatch{at}: loadLine(err, where, "source does not match the grammar")
    case NoPkgDir{at}: loadLine(err, where, "cannot open package directory")
    case NoStd{at}: loadLine(err, where, "no such std package")
    case ImportPath{at}: loadLine(err, where, "every segment of an import path is a lowercase identifier (a-z, 0-9, _ — not starting with a digit) that is not a keyword — the path is also the qualifier (std/http/server → http.server)")
    case EmbedReceiver{at}: loadLine(err, where, "@embed needs the receiver `map[string]string{}` (empty, imm)")
    case EmbedPattern{at}: loadLine(err, where, "invalid @embed pattern")
    case EmbedNoMatch{at}: loadLine(err, where, "@embed pattern matches no file")
    case EmbedPathUtf8{at}: loadLine(err, where, "@embed path is not valid UTF-8")
    case EmbedRead{at}: loadLine(err, where, "@embed cannot read file")
    case EmbedFileUtf8{at}: loadLine(err, where, "@embed file is not valid UTF-8")
    case PkgName{at}: loadLine(err, where, "package name must match the directory name")
    case RefCollide{at}: loadLine(err, where, "import reference name collides (use an alias)")
    case NotImported{at}: loadLine(err, where, "this file does not import the package it names (imports are per file — add the import to this file)")
    case ImportCycle{at}: loadLine(err, where, "import cycle")
    case Noinline{at}: loadLine(err, where, "@noinline applies to a function with mut parameters and no function-typed parameters")
    case ErrorHoldsError{at}: loadLine(err, where, "an error label cannot hold an error")
    case RecursiveType{at, kind}: loadLine(err, where, switch kind {
    case 1: "recursive type whose recursive references change the type arguments — pass the declaration's own type parameters in the same order"
    default: "recursive type contains itself by value (directly, through [N]T or another type's field) — the size would be infinite; go through T?, []T or map[K]T, or keep a table and an index"
    })
    case ConstExpr{at, kind}: loadLine(err, where, switch kind {
        case 1: "const expression: a const cannot call a function — call it inside a function instead"
        case 2: "const expression: a const is immutable — `mut` literals are not allowed"
        case 3: "const expression: a map literal is not allowed in a const (only @embed fills a map const)"
        case 4: "const expression: operators work only on int consts, and + - * / on float consts (float literals and float consts — no int literal); string, bool, struct and slice consts are written as literals"
        case 5: "const expression: nil is allowed only as a field value"
        default: "const expression"
    })
    case LocalBuiltin{at}: loadLine(err, where, "a local binding cannot reuse a builtin name (len, shape, println, await, freeze, keys, bytes, true, false, append, delete)")
    case LocalImport{at}: loadLine(err, where, "a local binding cannot reuse an import reference name")
    case InternalImport{at}: loadLine(err, where, "std/internal/... is an implementation detail of std — it can be imported only from inside std")
    case LocalTop{at}: loadLine(err, where, "a local binding cannot reuse a top-level name (const, func or type)")
    case TParamBuiltin{at}: loadLine(err, where, "a type parameter cannot reuse a builtin name")
    case TParamTop{at}: loadLine(err, where, "a type parameter cannot reuse a top-level type name")
    case DeclBuiltin{at}: loadLine(err, where, "a top-level declaration cannot reuse a builtin name")
    case VariantDup{at}: loadLine(err, where, "a variant name must be unique among the package's top-level names")
    case TopDup{at}: loadLine(err, where, "a top-level name is declared more than once in the package")
    case Shadow{at}: loadLine(err, where, "a local binding cannot shadow or redeclare another local binding")
    case PureExprStmt{at, kind}: loadLine(err, where, if kind == 1 { "the body of a func with results ends in a call whose value is not returned — the last expression is not the result: write `return f(…)`" } else { "an expression statement must be a call: the value of a pure expression is unused (bind or assign it, or remove it)" })
    case TestSignature{at}: loadLine(err, where, "a test function (Test… in a _test.sober file) takes no parameters, type parameters or results")
    case Double{at, kind}: loadLine(err, where, switch kind {
        case 1: "@replaces is written only before the package clause of a _double.sober file"
        case 2: "every file of a double names the package it replaces: start each _double.sober file with the same @replaces(\"path\")"
        case 3: "a double's directory holds only _double.sober files"
        case 4: "@doubles is written once, before the package clause of a _test.sober file of the package under test"
        case 6: "this package is not a double (its directory has no _double.sober files)"
        case 7: "two doubles replace the same package in this test build"
        case 8: "this double replaces a package that the test build does not import"
        case 9: "a double cannot replace the package under test or a std package"
        case 10: "a double cannot import the package it replaces"
        case 11: "a double is imported only from _test.sober and _double.sober files"
        case 12: "this package is a double (its files are _double.sober): it is read only through the @doubles list of a test package"
        case 13: "a double's package name is the name of the package it replaces"
        case 14: "this name exists only in the double: refer to it through the double's own import path"
        case 15: "this name is declared as a different kind of declaration in the package the double replaces"
        case 16: "this function's signature differs from the function of the same name in the package the double replaces"
        case 17: "this constant differs from the constant of the same name in the package the double replaces"
        case 18: "this type differs from the type of the same name in the package the double replaces (a struct may add or drop fields, but a field of both has the same type)"
        case 19: "this function's @errors is not within the @errors of the function of the same name in the package the double replaces"
        case 20: "the function of the same name in the package the double replaces has no @effects (and @errors, when it returns an error): add them there (sober fix --effects --errors)"
        case 21: "this function's @effects is not within the @effects of the function of the same name in the package the double replaces"
        default: "the replaced declaration names a type in @effects or uses a negated label in @errors, which a double cannot be checked against yet"
    })
    case Mod{at, kind}: loadLine(err, where, switch kind {
        case 1: "sober.mod is a `module \"path\"` line followed by `dep [name] \"source\"` and `alias name \"std/root\"` lines (plain string literals — no escapes or interpolation)"
        case 2: "the last segment of a module path is its name: a lowercase identifier (a-z, 0-9, _ — not starting with a digit) that is not a keyword"
        case 3: "a tree name (the name of a dep or an alias) is a lowercase identifier (a-z, 0-9, _ — not starting with a digit) that is not a keyword"
        case 4: "only local-path dependencies (`./…`, `../…`) are supported in this version — fetching a module from elsewhere is not"
        case 5: "a local-path dependency takes no version"
        case 6: "the directory of this dependency has no sober.mod with a module line"
        case 7: "this tree name is already taken (a std root, another dep or alias, or a directory at the root of this module) — rename one of them with the dep's name or an alias line"
        case 8: "an alias renames a std root: write `alias name \"std/<root>\"`"
        case 9: "a dependency's own dep and alias lines are not supported in this version"
        default: "the tree name of this import is also the tree name of another package root imported in this module (a std root, a dep, or a directory at the root) — rename one of them in sober.mod"
    })
    case Cell{at, kind}: if kind < 10 { loadLine(err, where, switch kind {
        case 1: "std/testing/cell is imported only from _test.sober and _double.sober files"
        case 2: "a cell.Cell is made only by a top-level const declaration (`const X = cell.Cell[T]{…}`) — a literal elsewhere would name no cell"
        case 3: "the key of a cell.Cell is given by the compiler: write only `init:`"
        default: "the function given to cell.Update is a lambda literal with one parameter"
    }) } else { "error at ${where} (Cell): a cell holds plain data — no function values, mut parts or values with identity (scopes, handles, endpoints, files)" }
    case Frozen{n}: "error: ${n} soundness findings (Analyzer)"
    case AssertOutsideTest{at, kind}: loadLine(err, where, if kind == 1 { "assert inside a quick.Check property: end the property with the bool expression instead (a false property is shrunk and reported with its subexpressions; a failed assert is not shrunk)" } else { "assert is only available in _test.sober files" })
    case CatchLhs{at}: loadLine(err, where, "the left of catch must be a call that returns (T, error?)")
    case Sealed{at}: loadLine(err, where, "this type is sealed (a field has a non-public type of its package): only its own package builds it with fields — write T{} for the zero value, or use the package's constructor")
    case Identity{at, kind}: loadLine(err, where, if kind < 100 {
        "`${identityName(kind)}` has identity: only ${identityMaker(kind)} makes one — a zero value would refer to nothing"
    } else {
        "this literal leaves a field at its zero value that holds a `${identityName(kind - 100)}`, which has identity: only ${identityMaker(kind - 100)} makes one — set the field, or declare it `T?`"
    })
    case FnArg{at, kind}: loadLine(err, where, switch kind {
        case 1: "the mut parameters of this function are not where the function type has them — a function type marks its mut parameter (`func(st mut S, x int)`), and the function must take the same parameters mut"
        case 3: "a function type has at most one mut parameter — put the state in one struct and take that (`func(st mut S, …)` with `type S struct { … }`)"
        case 4: "this lambda's parameters do not match the function type it is passed as — write `mut` on a parameter exactly where the function type has it (`(st mut S, x int) => …`), or leave the parameter types out to take them from the function type"
        case 5: "this argument does not match the function's parameter: a mut parameter takes `mut x` (a mut binding or one of its fields), and a parameter taken by value takes a plain value"
        default: "this function takes a different number of parameters than the function type expects"
    })
    case FnOpt{at, kind}: loadLine(err, where, switch kind {
        case 1: "an optional function type is written in parentheses: `(func(…) R)?` — a bare `func(…) R?` reads as a function returning `R?`"
        case 2: "an optional anonymous function type `(func(…) R)?` is only allowed for a parameter of a func declaration (inside a named function type, a struct field, a result or a lambda parameter, declare a named function type and use `F?`)"
        case 3: "the argument for an optional function parameter is nil, a lambda, a function name, or an optional function parameter of the enclosing function"
        case 4: "an optional function parameter can only be used inside `if p != nil { … }` (or the else of `if p == nil`) — outside it the parameter may be absent"
        default: "an optional function parameter can only be called, passed on to another call, or compared with nil — not bound, stored or returned"
    })
    case FnCap{at, kind}: loadLine(err, where, switch kind {
        case 1: "a lambda that becomes a closure (a function-typed field, a value of named function type, or a lambda passed to a call of a function value) cannot capture a mut binding — captures are immutable copies taken at creation. To keep the value it has now, copy it into an immutable binding first (`kk := k`) and capture that; to keep updating state, keep it with the caller and pass it through a mut parameter of the function type (`func(st mut S, …)` called as `f(mut st, …)`)"
        case 2: "a lambda kept as a value (a function-typed field, a value of named function type, or an element of []F / map[K]F) cannot use return — its body is an expression; return would escape the enclosing function"
        case 3: "a lambda kept as a value (a function-typed field, a value of named function type, or an element of []F / map[K]F) cannot use `?` — the error would escape the enclosing function"
        case 5: "a lambda kept as a value (a function-typed field, a value of named function type, or an element of []F / map[K]F) can only capture plain values (scalars, strings, immutable slices / maps and structs of them) — not a value with identity (task.Scope, task.Handle, a channel end, io.File, net.Conn …), a function value or a mutable container"
        case 8: "a lambda bound to a local name cannot be mut — the name stands for the lambda, which is expanded where it is called (bind it with `f := (…) => …`)"
        case 9: "bind a lambda to a local name on its own (`f := (…) => …`) — not together with other names"
        case 10: "a lambda bound to a local name can only be called (`f(x)`) or passed to a parameter of anonymous function type — it is expanded where it is used and is not a value (to keep a function as a value, write the lambda in a position of named function type)"
        case 11: "a lambda bound to a local name is not a value, so it cannot be passed where a value is kept (a parameter of named function type, or an argument of a call of a function value) — write the lambda itself there, or use a named function"
        case 12: "a lambda kept as a value (or passed to a call of a function value) cannot use a lambda bound to a local name — that lambda is expanded where it is called, and this body runs elsewhere"
        case 13: "the body of a lambda bound to a local name cannot use return — its value is its last expression (return would leave the enclosing function where the lambda is called)"
        case 14: "the body of a lambda bound to a local name cannot use `?` — the error would leave the enclosing function where the lambda is called; let the lambda return the error as its value (`f := (s) => parse(s)`) and use `?` at the call (`f(s)?`)"
        case 15: "the body of a lambda bound to a local name cannot break or continue a loop outside the lambda"
        case 16: "this lambda bound to a local name uses a name that is declared after the lambda — the body sees only the names visible where the lambda is written"
        case 17: "this function has a parameter of anonymous function type, so it is expanded where it is called — it cannot call itself, directly or through other such functions (the expansion would not end): loop with for / while, or take a named function type (a value) instead"
        default: "a lambda kept as a value (a function-typed field, a value of named function type, or an element of []F / map[K]F) cannot break or continue a loop outside the lambda"
    })
    case ForFallible{at, kind}: loadLine(err, where, switch kind {
        case 1: "this generator can fail (it returns error?): mark the for with `?` — `for x <- g(…)? { … }` — or drop the error explicitly with `_ = g(…, (x) => { … })`"
        case 2: "a generator that can fail is only allowed in the statement form of for (for x <- g(…)? { … }), not in a for expression"
        case 4: "only a parameter of anonymous function type (`recv func(k func(T)) error?` — expanded at the call) can be called as a for generator; a parameter of named function type is a value and is not expanded — call it with a lambda instead (`recv((x) => { … })`)"
        default: "`?` on a generator needs a generator that returns error? only"
    })
    case MultiBind{at, kind}: loadLine(err, where, if kind == 1 { "a multi-value result cannot be assigned to existing names (spec X-6): bind it with `:=` (`a2, b2 := f()`) and copy the values, or discard it whole with `_, _ = f()`" } else { "this call returns several values: bind them all (`v, err := f()`), or handle the error with `?` or `catch` (`v := f()?`)" })
    case MutAlias{at}: loadLine(err, where, "mut arguments overlap: this mut argument names the same place as an earlier one in the call (the same name, or a field of it) — mut arguments are exclusive for the duration of the call")
    case Layout{at, kind}: loadLine(err, where, switch kind {
        case 1: "a fixed-length array field ([N]T) is only allowed in a @layout struct"
        case 2: "@layout applies only to a struct type declaration"
        case 3: "a @layout field has a width type (u8, i8, u16le, u32be, …) or a fixed-length array [N] of one (N ≥ 1)"
        case 4: "width types (u8, u16le, …) are only allowed as @layout struct field types"
        case 5: "a @layout struct needs at least one field and no type parameters"
        case 6: "the type argument of layout.Decode / DecodeAt / Encode / Size must be a @layout struct"
        case 7: "layout.Decode / DecodeAt / Encode are called with a type argument (layout.Decode[T](…)); layout.Size[T] is a constant"
        default: "an integer literal does not fit the width of its @layout field"
    })
    case TypeDecl{at, kind}: loadLine(err, where, switch kind {
        case 0: "the underlying type of a defined type is int or bool — to give another type a second name, write an alias: type V = W"
        case 1: "an alias names a type declaration (N or pkg.N — a struct, union, named function type, named scalar or another alias): not a builtin, composite, instantiated or error / panic label type"
        case 2: "an alias refers back to itself through other aliases"
        case 3: "an alias has no type parameters — write the type arguments where the alias is used (type B = lib.Box, then B[int])"
        case 4: "the type an alias names is not declared or not visible here (a type from another package must be exported)"
        default: "internal: a name still refers to an alias after the loader rewrote aliases to the types they name"
    })
    case JsonShape{at, kind}: loadLine(err, where, switch kind {
        case 1: "the type argument of json.Decode / Encode must be a struct type without type parameters or json.Value"
        case 2: "json.Decode / Encode support struct fields of int, float, bool, string, json.Value, nested structs, []T and T? (generic structs, unions, maps and named scalars come later)"
        case 4: "json.Decode cannot read into a struct with a json.Value field (a union has no zero value, so the early return of `?` has no struct to return) — make the field json.Value? or read it with json.Tree"
        default: "json.Decode / Encode (and DecodeWith / EncodeWith) are called with a type argument: json.Decode[T](doc, node), json.Encode[T](value)"
    })
    case Intrinsic{at, kind}: loadLine(err, where, switch kind {
        case 1: "@intrinsic is only accepted inside std"
        case 2: "unknown @intrinsic key (the set of keys is closed — see desugar/intrinsic.sober)"
        case 3: "the signature of an @intrinsic declaration does not match its key"
        default: "duplicate @intrinsic declaration in the package"
    })
    case Par{at, kind}: if kind == 1 { "lower error at ${where}: task.Run / Spawn / Join / Try are not lowered yet (build of structured concurrency is 段 6 P3a-2)" } else { loadLine(err, where, switch kind {
        case 3: "task.Run / task.Spawn take a lambda literal written at the call ((s) => … for Run, () => … for Spawn)"
        case 4: "a spawned task cannot capture a mut binding (the child sees only imm values — pass a copy: v := x before the Spawn)"
        case 5: "a spawned task cannot capture the scope token (task.Scope), also inside a struct field or T? — spawn from the scope body"
        case 6: "a spawned task cannot capture a task handle (task.Handle), also inside a struct field or T? — join it in the scope body"
        case 7: "return and break / continue cannot leave a task.Run / task.Spawn body, and ? cannot leave a task.Spawn body (the scope waits for its children at its end; ? in a task.Run body fails the scope)"
        case 8: "the result of a spawned task must be copyable to the scope (data — not a function value, task.Scope, task.Handle, a channel endpoint or a task.Domain)"
        case 9: "the result of task.Run cannot hold a task.Scope, task.Handle or task.Domain (it would outlive the scope)"
        case 13: "task.NewChannel takes its capacity as an integer literal of 1 or more (cap: 16)"
        case 14: "task.NewChannel needs its payload type written: task.NewChannel[T](cap: n)"
        case 15: "a channel endpoint (task.Sender / task.Receiver) moves to a child only through give: — task.Spawn(s, (out) => …, give: tx)"
        case 17: "an error-returning task's handle goes in a slice of task.Handle[(T, error?)] (the element type says the task can fail — Join gives two values)"
        case 18: "a multi-value type (T, error?) is written only as the type argument of task.Handle — task.Handle[(T, error?)] (no anonymous tuple types)"
        case 20: "budget: is a size written without calls or division (a literal, a name, task.MB, + - *) — it is read for the admission only"
        case 19: "a channel payload cannot hold task.Scope, task.Handle, a channel endpoint or a task.Domain (also inside struct fields or T?) — they stay with the task that owns them"
        case 16: "handles (task.Handle) and domains (task.Domain) go in a mut slice: mut hs := mut []task.Handle[T]{} (an imm slice copies its elements, and a handle or a domain is not copied)"
        case 22: "wait: is written as the literal true or false — the admission policy of a scope is fixed where it is written"
        case 23: "deadline: is a relative time written without calls or division (a literal, a name, task.MS, + - *)"
        case 30: "give: hands one channel endpoint (task.Sender / task.Receiver) to the child — capture any other value in the lambda instead"
        case 29: "backlog: is a count written without calls or division (a literal, a name, + - *) — the bound on unstarted children per worker, 1 to 255"
        case 21: "a spawned task cannot capture mut contents (this value is a mut slice / map or holds one — freeze it before the Spawn: v := freeze(x))"
        case 24: "task.Lease / task.NewLocal take a window: a lambda with one mut parameter of a written struct type — (w mut T) => …"
        case 26: "a worker-local place holds a struct with only scalar fields (int, byte, bool, float) and pool.Scratch fields, without type parameters"
        case 27: "the setup of task.NewLocal sizes each pool.Scratch field exactly once — pool.NewScratch(mut w.f, n) with n a constant (a literal, a const name, + - * <<) — and does nothing else"
        case 28: "LocalNew / LeaseTake / LeaseGive / LeaseBlock / LeaseAttach are what task.NewLocal / task.Lease are rewritten into — call task.NewLocal / task.Lease instead"
        case 11: "a spawned task cannot capture a function-typed parameter (it is a closure inlined at the call — call it in the scope body and spawn with the value)"
        case 31: "task.Update / task.Read / task.Await take lambda literals written at the call with one parameter — (st mut S) => … for the body, (st S) => … for task.Read and when:"
        case 32: "the body of a domain call (and when:) captures only imm data — not a mut binding or mut contents, task.Scope, task.Handle, a channel endpoint or a function-typed parameter (the body may run on another task)"
        case 33: "return and break / continue and ? cannot leave the body of a domain call or when: (the call ends where the body ends)"
        case 35: "wait: is a relative time written without calls or division (a literal, a name, task.MS, + - *)"
        case 36: "the body of a domain call writes only region-free values (int, bool, byte, float and structs of them) into the state, and not through a map index — the state lives as long as the domain and is written in place, so append, re-slicing, strings or map writes would grow it on every call. Rewrite: (1) preallocate a mut slice in init: and write its elements (st.items[i] = v), (2) keep a count or an index in the state and the growing data outside the domain, or (3) return the value from the body and store it outside"
        case 37: "the body of a domain call cannot pass the state (or a part of it) as a mut argument — the function could grow the state, which is written in place. Rewrite: (1) make the function take values and return the new ones, then assign them in the body (st.n = next(st.n)), (2) write the fields directly in the body, or (3) pass an imm copy and assign what the function returns"
        case 39: "a domain cannot be put where it outlives the scope that made it — here it is stored in a place made outside that scope (or in a mut parameter, whose place the function does not know), or captured by a task spawned on an outer scope. Rewrite: (1) keep it in a binding made inside the scope that made the domain (a struct made there can hold it), or (2) spawn the task on the scope that made the domain"
        default: "task.Scope, task.Handle and channel endpoints do not cross a function boundary, and a task.Domain is not returned from a function (pass values to the function and spawn in the scope body)"
    }) }
    case FileUse{at, kind}: loadLine(err, where, switch kind {
        case 1: "io.Open must be bound as a statement of its own — `f := io.Open(path)?` or `f := io.Open(path) catch …` — and closed by the next statement `defer io.Close(f)` (io.OpenUnder the same way; io.OpenRoot closed by `defer io.CloseRoot(r)`)"
        case 2: "the file opened here must be closed by the next statement: insert `defer io.Close(f)` (with the name bound here — `defer io.CloseRoot(r)` for io.OpenRoot) right after this line"
        case 3: "io.Close may only appear as `defer io.Close(f)` right after the `f := io.Open(…)` it closes (io.CloseRoot likewise after `r := io.OpenRoot(…)`)"
        case 4: "this defer must close the file opened just before it: write `defer io.Close(f)` with the name bound by io.Open"
        case 5: "${resourceList()} cannot be copied to another binding (it has identity — keep using the name bound by io.Open or by the for)"
        case 6: "${resourceList()} cannot be assigned (it has identity — keep using the name bound by io.Open or by the for)"
        case 7: "${resourceList()} cannot leave the block that opened it (no return, and no call that returns one) — pass it down as an argument instead"
        case 8: "${resourceList()} cannot be put in a struct, slice, map or channel, or appended (it has identity — keep it in the binding made by io.Open)"
        case 9: "a closure cannot capture ${resourceList()} — pass it as an argument (only the body of task.Run and a lambda passed straight to a call may capture it)"
        case 11: "a borrowed function (a parameter of anonymous function type of a function value) can only be called, passed on to a call, or captured by a lambda passed to a call — it cannot be stored, returned, bound, or handed to another task"
        default: "${resourceList()} cannot be given to a task with give: (the opener's defer closes it when its block ends, which can be before the child is done) — give the path and open it in the child"
    })
    case PanicLabel{at, kind}: loadLine(err, where, switch kind {
        case 1: "panic needs a reason: panic(L{…}) with a panic label (Unreachable, InvariantBroken, or one declared as type L panic{…})"
        case 2: "the argument of panic is a single panic label literal L{…}"
        case 3: "not a panic label — declare it as type L panic{…} (or use Unreachable / InvariantBroken)"
        case 4: "RegionExceeded is raised by the runtime only"
        case 5: "a panic label literal names its fields (name: value), each at most once — omitted fields are zero"
        case 6: "a panic label field is int, byte, bool or string"
        case 7: "Unreachable, InvariantBroken and RegionExceeded are built-in panic labels"
        default: "a panic label is only used as the argument of panic(L{…})"
    })
    case LeadingZero{at}: loadLine(err, where, "a decimal literal cannot start with 0 — write 0o for octal (0o755), or drop the leading zeros")
    case LitRange{at, kind}: loadLine(err, where, if kind == 0 { "an integer literal must fit in int (at most 9223372036854775807)" } else { "a float literal must be finite — it rounds to Inf (the largest float is 1.7976931348623157e308)" })
    case NamedArg{at, kind}: loadLine(err, where, switch kind {
        case 1: "named arguments can only be passed to a func declaration or a value of a named function type with parameter names"
        case 2: "the function has no parameter with this name"
        case 3: "named arguments must follow the order of the parameters"
        case 4: "this parameter is already given by position"
        case 5: "a parameter that is not optional (T?) is missing — only T? parameters can be left out"
        default: "a pipe stage with named arguments marks the piped value with _"
    })
    case NilCase{at, kind}: loadLine(err, where, switch kind {
        case 1: "case nil appears more than once in the switch"
        case 2: "case nil cannot be combined with other alternatives (nil | …)"
        case 3: "case nil must come before name patterns (_ or a binding also matches nil)"
        case 4: "a switch with case nil needs another case or a default"
        case 5: "in a (value, error?) switch, a case for a non-nil error takes _ as its value pattern (case _, e:)"
        case 6: "case _, e also matches a nil error: the nil cases must cover every value (case v, nil:)"
        case 7: "a default here would be needed for both a nil and a non-nil error: cover every value in the nil cases (case v, nil:)"
        default: "a non-nil error has no case: add case _, e: or a default"
    })
    default: "error"
    }
}

// loadLine は loader の拒否の 1 行（位置があれば `load error at <where>: <理由>`）
// identityName / identityMakerは同一性の種類の番号（Identityのkind）の型の綴りと生成のAPI
// 同一性の種類の表（i行目 = packageのpath・型の名前・種類の番号・資源か・作れるAPI）。loaderのゼロ値の検査・desugarの捕捉の検査とfilecheck・
// lowerのクロージャの照合・このpackageの文面はみなこの表を読む（名前の集合を1か所に — diagはその全部がimportする底のpackage）。
// 資源 = 開いた接続やファイルの類（filecheckがコピー・持ち出し・composite・捕獲・give: を見る）— taskの札・handle・端点・Pool・Localは資源でない（taskの規則が見る）
const IdPaths = []string{"std/task", "std/task", "std/task", "std/task", "std/task", "std/task", "std/io", "std/io", "std/net", "std/net", "std/tls", "std/http/client", "std/pg"}
const IdNames = []string{"Scope", "Handle", "Sender", "Receiver", "Pool", "Local", "File", "Root", "Listener", "Conn", "Conn", "Session", "Conn"}
const IdFamilies = []int{1, 2, 3, 4, 5, 7, 6, 8, 9, 10, 11, 12, 13}
const IdResources = []bool{false, false, false, false, false, false, true, true, true, true, true, true, true}
const IdMakers = []string{"task.Run (the body's parameter)", "task.Spawn", "task.NewChannel", "task.NewChannel", "task.NewPool", "task.NewLocal", "io.Open", "io.OpenRoot",
    "net.Listen (the parameter of its function)", "net.Accept or net.Dial (the parameter of its function)", "tls.Serve (the handler's parameter)", "client.Open (the parameter of its function)", "pg.Open (the parameter of its function)"}

// 表の i 行目の型の綴り（package の path の最後の段 + 名前 — "client.Session"）
func idSpelling(i int) string {
    _, last, _ := strings.CutLast(IdPaths[i], "/")
    return "${last}.${IdNames[i]}"
}

func idRow(k int) int {
    for i <- iter.Range(0, len(IdFamilies)) {
        if IdFamilies[i] == k {
            return i
        }
    }
    return 6
}

func identityName(k int) string {
    return idSpelling(idRow(k))
}

func identityMaker(k int) string {
    return IdMakers[idRow(k)]
}

// 資源の型の列の文面（"an io.File, io.Root, …, client.Session or pg.Conn"）
func resourceList() string {
    mut names := mut []string{}
    for i <- iter.Range(0, len(IdPaths)) {
        if IdResources[i] {
            names = append(names, idSpelling(i))
        }
    }
    mut o := "an ${names[0]}"
    for i <- iter.Range(1, len(names)) {
        o = if i == len(names) - 1 { "${o} or ${names[i]}" } else { "${o}, ${names[i]}" }
    }
    return o
}

func loadLine(err error?, where string, why string) string {
    return if At(err).file >= 0 { "load error at ${where}: ${why}" } else { "load error: ${why}" }
}

// 拒否の 2 つ目の位置（NonExhaustive の落ちている variant — 無ければ None）
func Note(err error?) Pos {
    return switch err {
    case nil: None()
    case NonExhaustive{at, missing}: missing
    default: None()
    }
}

// 脱糖の拒否err（checkの判定の経路が返す種類 — checker.CheckE2の @errors）のワード [種類, kind, 位置, 2つ目の位置]（位置 = Pos・
// 種類 0 = 他の拒否 — 値にしない）。check の関数単位キャッシュの拒否の値（checker/defcache.sober）が書いて FromWords で再生する
type Words struct {
    tag int
    kind int
    at Pos
    missing Pos
}

func WordsOf(err error?) Words {
    return switch err {
    case nil: Words{tag: 0, kind: 0, at: None(), missing: None()}
    case CoreFragment{at}: Words{tag: 1, kind: 0, at: at, missing: None()}
    case UnknownName{at}: Words{tag: 2, kind: 0, at: at, missing: None()}
    case Malformed{at, kind}: Words{tag: 3, kind: kind, at: at, missing: None()}
    case TypeMismatch{at, kind}: Words{tag: 4, kind: kind, at: at, missing: None()}
    case PrintArg{at}: Words{tag: 5, kind: 0, at: at, missing: None()}
    case LenString{at}: Words{tag: 6, kind: 0, at: at, missing: None()}
    case UntypedNil{at}: Words{tag: 7, kind: 0, at: at, missing: None()}
    case NonExhaustive{at, missing}: Words{tag: 8, kind: 0, at: at, missing: missing}
    case ImmWrite{at}: Words{tag: 9, kind: 0, at: at, missing: None()}
    case FieldType{at}: Words{tag: 10, kind: 0, at: at, missing: None()}
    case FnCap{at, kind}: Words{tag: 11, kind: kind, at: at, missing: None()}
    case FnArg{at, kind}: Words{tag: 13, kind: kind, at: at, missing: None()}
    case Cell{at, kind}: Words{tag: 14, kind: kind, at: at, missing: None()}
    default: Words{tag: 0, kind: 0, at: None(), missing: None()}
    }
}

// WordsOf の逆（種類 tag・kind・位置 at・2 つ目の位置 missing — 種類 0 は呼ばない）
@errors(CoreFragment, UnknownName, Malformed, TypeMismatch, PrintArg, LenString, UntypedNil, NonExhaustive, ImmWrite, FieldType, FnCap, FnArg, Cell)
func FromWords(tag int, kind int, at Pos, missing Pos) error? {
    return switch tag {
    case 2: UnknownName{at: at}
    case 3: Malformed{at: at, kind: kind}
    case 4: TypeMismatch{at: at, kind: kind}
    case 5: PrintArg{at: at}
    case 6: LenString{at: at}
    case 7: UntypedNil{at: at}
    case 8: NonExhaustive{at: at, missing: missing}
    case 9: ImmWrite{at: at}
    case 10: FieldType{at: at}
    case 11: FnCap{at: at, kind: kind}
    case 13: FnArg{at: at, kind: kind}
    case 14: Cell{at: at, kind: kind}
    default: CoreFragment{at: at}
    }
}

// WTag / WKind / WAt / WMissingはWordsのフィールドを読むAPI
func WTag(w Words) int {
    return w.tag
}

func WKind(w Words) int {
    return w.kind
}

func WAt(w Words) Pos {
    return w.at
}

func WMissing(w Words) Pos {
    return w.missing
}

// ソース src の字句 tok の綴り（範囲外なら ""）
func Spell(src []byte, tok int) string {
    toks := lexer.Lex(src)
    if tok < 0 || tok >= len(toks) {
        return ""
    }
    s, err := string(src[toks[tok].start:toks[tok].end])
    return if err == nil { s } else { "" }
}

// ファイル path（ソース src）の字句 tok の `<path>:<行>:<列>`（tok が字句の範囲外なら `token <tok>`）
func Where(path string, src []byte, tok int) string {
    toks := lexer.Lex(src)
    if tok < 0 || tok >= len(toks) {
        return "token ${tok}"
    }
    at := toks[tok].start
    mut line := 1
    mut col := 1
    for i <- iter.Range(0, at) {
        if src[i] == '\n' {
            line += 1
            col = 1
        } else {
            col += 1
        }
    }
    return "${path}:${line}:${col}"
}
