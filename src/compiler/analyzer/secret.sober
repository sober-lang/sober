package analyzer

// 秘密の値の流れ（language.md 12 節「秘密の値の宣言」・13 節の補 2）: 値の流れのエンジンの 2 本目。error の導出（errors.sober）を
// 解き切った後に、同じ解き手 az.er（flow.sober）へスロットを区間として積み、同じ作業の列で解く（原子の番号は名前空間ごと — error のラベルと同居しない）。
// 値 = LSet 1 本に (S, P) を詰める: lo = 源の原子（0〜63 — `@secret` の仮引数 (f, j)・欄 (型, 欄)・const の通し番号。越えたら TOP）・
// hi のビット 0〜61 = 今の関数の仮引数 j から届いた分・ビット 62 = TOP（秘密かもしれない）。FLOW のビットは使わない。
// 関数 f の要約（スロット）: Res[f] = 結果の (S, P)・Sink[f] = sink に届く仮引数の集合（lo のビット j）・Pin[f][j] = 全呼び手の実引数の S の合併
// （欄・値の位置の閉包へ P を含む値を書いたときに具体化する — 文脈に鈍い）・Mout[f][j] = mut の仮引数 j へ書いた値の (S, P)。
// 欄は文脈欄（型 × 名前 × 値の出所）: 型 × 名前のスロット（文脈に鈍い）は struct リテラルの欄と、局所・仮引数でない基底への書き込みと、
// 名前の基底への書き込みの具体の部分（源の原子・TOP）だけを持つ。名前の基底 x への書き込みの仮引数由来の部分（P）は x の欄の道（局所）に置き、
// x が仮引数 j なら欄の Mout[f][j.g] で呼び手の実引数の欄の道へ戻す。仮引数 j の欄 g の読みは欄のビット（P の 62 ビットを仮引数の後ろから割り当てる —
// 尽きたら仮引数のビット）で、呼び出し点が実引数の欄の道で具体化する（汎用の型〔sha256.State 等〕を秘密の文脈と公開の文脈で共有しない）。
// 名前の値を丸ごと使う所は欄の道の合併。型パラメータつきの struct（コンテナ）・union・型の分からない基底の欄は集約（基底の値 — 書きは基底へ）。名前付き関数型 F の仮引数ごとのスロット（F の値の呼び出しの実引数の合併）は F の値になるラムダの仮引数が読む。
// 呼び出し点 g(a…) = Res[g].S ∪ ⋃{aⱼ | j ∈ Res[g].P}・j ∈ Sink[g] で aⱼ.S ≠ ∅ なら呼び出し点で拒否（g の中の sink の位置を注に）。`@bless` の g の結果は (∅, ∅)。
// 関数値の呼び出しの結果 = 関数値の値（仮引数なら P のビット・ラムダなら本体の値・欄なら欄のスロット）∪ 実引数。借りのラムダ（直の実引数）の仮引数 = 同じ呼び出しの他の実引数の合併。
// 暗黙の流れは追わない（秘密の条件そのものが sink — 受理されたプログラムに暗黙の流れは無い）。源が 0 本なら解かない（compiler/ は @secret を書かない）

import "ast"
import "desugar"
import "diag"
import "lexer"
import "loader"
import "std/iter"
import "std/table"

const MSecSink = 35   // 秘密の値が sink に届く（at = sink の式 / 呼び出しの実引数, 付帯 = 違反の記録の添字）
const MSecNote = 36   // 上の注 — 呼び先の中の sink（at = 呼び先の中の節, 付帯 = 違反の記録の添字）
const MSecAnn = 37    // `@secret(…)` の項が仮引数の名前でない（at = 関数宣言, 付帯 = 項の添字）
const MSecBless = 38  // std の外の `@bless`（at = 関数宣言, 付帯 = 0）

const PMASK = 4611686018427387903  // hi のビット 0〜61（仮引数の集合）
const SVH = 4096                   // 型宣言 → 欄のスロットの表の大きさ

// sink の種類（違反の記録・注の文面）
const SkCond = 0
const SkSwitch = 1
const SkAndOr = 2
const SkIndex = 3
const SkSlice = 4
const SkDiv = 5
const SkCall = 6
const SkVar = 7   // 可変時間の組み込みの実引数（binary.MatchLen の `@intrinsic("matchlen")` — 最初の食い違いで止まる）
const SkVarJ = 8  // 同じく json の文字列の書き出しの `@intrinsic("jclean")`（最初のエスケープの要るバイトで止まる）

// 秘密の値の流れの状態（Az の欄 — 区間の基底と表）
type Sv struct {
    on bool
    rec bool
    natom int
    atoms table.Table[int]   // 原子 [種類 0 = 仮引数 (関数, 添字)・1 = 欄 (欄の項の添字, -)・2 = const (宣言の節, -)]…
    resBase int              // Res[f] の結果の位置 i = スロット resBase + rpos[f] + i
    rpos table.Table[int]    // 関数の結果の位置の基底（結果が 0 個でも 1 つ）
    nres int
    mresN int
    mres table.Table[int]    // 直前の呼び出しの結果の位置ごとの値 [lo, hi, error の位置か]…（多値の束縛・return の転送・`?` が読む — 次の呼び出しの前に読む）
    sinkBase int             // Sink[f] = スロット sinkBase + f
    pbase table.Table[int]   // 関数の仮引数の項の基底（Pin / Mout / sinkAt / secp の添字 = pbase[f] + j）
    npar int
    pinBase int              // Pin = スロット pinBase + 項・Mout = スロット pinBase + npar + 項
    secp table.Table[int]    // 仮引数の項の原子（-1 = 源でない）
    sinkAt table.Table[int]  // 仮引数の項が最初に sink に届いた節（-1 = 無し）
    sinkK table.Table[int]   // 同じく sink の種類
    fl table.Table[int]      // 欄の項 [型宣言, 名前, 原子]…（スロット = flBase + 項）
    flBase int
    hk table.Table[int]      // 型宣言 → 欄の項 [宣言 + 1, 最初の項, 個数]…（SVH 個 — 開番地法）
    cons table.Table[int]    // 源の const [const の表の添字, 原子]…
    lamIn LSet               // 借りのラムダの仮引数の値（同じ呼び出しの他の実引数の合併）
    viol table.Table[int]    // 違反の記録 [節, 種類, 付帯（呼び先の関数 * 64 + 仮引数 / sink の種類）, 原子（-1 = TOP）]…
    walks int
    touch table.Table[int]   // 関数が秘密の値を演算子・添字・呼び出しの実引数に使うか（0 / 1 — 最後の 1 周・`check --secret-dump` の表 T）
    pe table.Table[int]      // 今の関数の道の表 [根の名前, 欄 1, 欄 2〔-1 = 深さ 1〕, lo, hi]…（peN 個が有効 — 局所・仮引数の欄の値の出所: 文脈欄）
    peN int
    al table.Table[int]      // 今の関数の別名 [名前, 行き先の根, 欄 1, 欄 2, 根の型宣言, 最後の欄の項]…（alN 個が有効 — `y := x` / `y := x.f` / 仮引数を丸ごと返す呼び出しの結果）
    alN int
    fmh table.Table[int]     // 関数 → 仮引数の道の項の鎖の頭（-1 = 無し）
    fm table.Table[int]      // 仮引数の道の項 [仮引数, 欄 1, 欄 2, 欄のビット〔-1 = 未〕, 道の Mout のスロット〔-1 = 未〕, 道の Pin のスロット〔-1 = 未〕, 次]…
    fbn table.Table[int]     // 関数 → 次に割り当てる欄のビット（仮引数のビットの後ろ — PBITS まで）
    mal table.Table[int]     // 直前の呼び出しの結果の別名の候補 [結果の位置, 根, 欄 1, 欄 2, 根の型宣言, 最後の欄の項]…（束縛の右辺の直の呼び出しだけ）
    malN int
    nodump bool              // 名前の根の道の丸ごとの読みで道の表を吐かない（呼び出しの実引数・別名の束縛の右辺 — 値は逃げない）
    bind bool                // 次の呼び出しは束縛の右辺の直の呼び出し（仮引数を丸ごと返す結果を別名の候補へ）
    // 出所の名前空間（origin.sober — 同じ walker を og のモードで走らせる: 値は丸ごと〔欄の中身を持つ〕・道と別名は使わない・sink は出会いだけ）
    og bool
    effBase int              // Eff[f] = スロット effBase + f（lo の 1 = 呼ぶと認証の源に届きうる）
    effHit bool              // 今のラムダの本体が源に届いた
    catom int                // 原子 C（源に届きうる関数値）
    shMask int               // 原子 SH（`@shared` の variant のリテラル）の lo のビット
    oMask int                // 原子 O（源）と C の lo のビット
    mountFn int              // std/http の Mount（出会いの口の名指し — 無ければ -1）
    shv table.Table[int]     // `@shared` の variant [union の型宣言, variant の添字, 原子]…
    shf table.Table[int]     // 欄の項ごとの SH の欄の印（0 = 否・1 = SH の欄・2 = 応答 1 件の SH の欄〔std/http の Response.cache — 利用者は SH を書けない〕）
    ftn table.Table[int]     // 欄の項ごとの [型の式の節, package]（shf を作る材料）
    ov table.Table[int]      // 出所の違反 [節, 種類, 原子 SH, 原子 O / C]…
    credf table.Table[int]   // 関数 → `@credential` の原子（-1 = 源でない）
}

// ── 値の小道具 ──

// 関数 fi の結果の位置の数（0 個でも 1）
func svNRes(az mut Az, fi int) int {
    n := desugar.LenL(mut az.d, desugar.ListRef(fnDecl(mut az, fi).d))
    return if n < 1 { 1 } else { n }
}

func svRes(az mut Az, fi int, i int) int {
    return az.sv.resBase + table.Get(mut az.sv.rpos, fi) + i
}

// 関数 fi の結果の全部の位置へ v
func svResAll(az mut Az, fi int, v LSet) {
    for i <- iter.Range(0, svNRes(mut az, fi)) {
        addSlot(mut az, svRes(mut az, fi, i), v)
    }
}

// svMres は直前の呼び出しの結果の値の列を 1 つ（関数値・組み込み）にする
func svMres1(az mut Az, v LSet) {
    az.sv.mresN = 0
    svMresPut(mut az, v, 0)
}

// 結果の値の列の末尾へ v（e = error の位置か）
func svMresPut(az mut Az, v LSet, e int) {
    i := az.sv.mresN * 3
    if i < table.Len(mut az.sv.mres) {
        table.Set(mut az.sv.mres, i, v.lo)
        table.Set(mut az.sv.mres, i + 1, v.hi)
        table.Set(mut az.sv.mres, i + 2, e)
    } else {
        table.Push(mut az.sv.mres, v.lo)
        table.Push(mut az.sv.mres, v.hi)
        table.Push(mut az.sv.mres, e)
    }
    az.sv.mresN += 1
}

func svMresN(az mut Az) int {
    return az.sv.mresN
}

func svMresAt(az mut Az, i int) LSet {
    return LSet{lo: table.Get(mut az.sv.mres, i * 3), hi: table.Get(mut az.sv.mres, i * 3 + 1)}
}

// 多値の右辺 e（呼び出しか `?` の呼び出し）の位置ごとの値を n 個（`?` は error の位置を除く。形が合わなければ全部の位置に合併）
func svMulti(az mut Az, e desugar.NodeRef, n int) []LSet {
    k := kind(mut az, e)
    try := k == ast.ETry && desugar.NodeRef(node(mut az, e).b) == -1
    inner := if try { desugar.NodeRef(node(mut az, e).a) } else { e }
    ik := kind(mut az, inner)
    all := sv(mut az, e)
    mut out := mut []LSet{}
    if ik == ast.ECall || ik == ast.EPipe {
        for i <- iter.Range(0, svMresN(mut az)) {
            if !try || table.Get(mut az.sv.mres, i * 3 + 2) == 0 {
                out = append(out, svMresAt(mut az, i))
            }
        }
    }
    if len(out) != n {
        out = mut []LSet{}
        for i <- iter.Range(0, n) {
            out = append(out, all)
        }
    }
    return freeze(out)
}

func svP(j int) LSet {
    return if j >= 0 && j < PBITS { LSet{lo: 0, hi: 1 << j} } else { lsNone() }
}

// 原子 a の値（64 本を越えたら TOP）
func svAtom(a int) LSet {
    return if a < 0 { lsNone() } else if a < 64 { LSet{lo: 1 << a, hi: 0} } else { lsTop() }
}

// 値に源（S — TOP を含む）があるか
func svSecret(v LSet) bool {
    return v.lo != 0 || lsIsTop(v)
}

// 値の最初の原子（TOP だけなら -1）
func svFirst(v LSet) int {
    for a <- iter.Range(0, 64) {
        if (v.lo & (1 << a)) != 0 {
            return a
        }
    }
    return -1
}

func svNParams(az mut Az, fi int) int {
    return desugar.LenL(mut az.d, desugar.ListRef(fnDecl(mut az, fi).c))
}

// 値の P を今の関数の Pin で具体化した S（欄・閉包へ書く値 — 欄のビットは仮引数ごと丸ごと）
func svConcrete(az mut Az, v LSet) LSet {
    mut r := LSet{lo: v.lo, hi: v.hi & TOPH}
    p := v.hi & PMASK
    if p == 0 {
        return r
    }
    for b <- iter.Range(0, PBITS) {
        if (p & (1 << b)) != 0 {
            j, it := svBitJ(mut az, az.cur, b)
            if it != -1 {
                r = lsOr(r, readSlot(mut az, table.Get(mut az.sv.fm, it + 5)))
            } else if j != -1 {
                r = lsOr(r, readSlot(mut az, az.sv.pinBase + table.Get(mut az.sv.pbase, az.cur) + j))
            }
        }
    }
    return r
}

// ── 文脈欄（名前の根の道・別名・仮引数の欄の項と欄のビット）──
// 道 = (根の名前, 欄 1, 欄 2)（欄 2 = -1 なら深さ 1・深さ 3 以上は深さ 2 へ畳む — 畳んだ先は下の欄の丸ごと）。丸ごとの値は欄の中身を持たない:
// 欄の中身は型 × 名前のスロット（具体の部分）・道の表（今の関数の局所と仮引数）・欄のビット（仮引数の欄の読み — 呼び出し点が実引数の道で具体化）にある

// 関数 fi の仮引数 j の道 (a, b) の項（無ければ作る）
func svFm(az mut Az, fi int, j int, a desugar.StrRef, b desugar.StrRef) int {
    mut i := table.Get(mut az.sv.fmh, fi)
    while i != -1 {
        if table.Get(mut az.sv.fm, i) == j && svNameEq(mut az, table.Get(mut az.sv.fm, i + 1), a) && svNameEq(mut az, table.Get(mut az.sv.fm, i + 2), b) {
            return i
        }
        i = table.Get(mut az.sv.fm, i + 6)
    }
    n := table.Len(mut az.sv.fm)
    table.Push(mut az.sv.fm, j)
    table.Push(mut az.sv.fm, int(a))
    table.Push(mut az.sv.fm, int(b))
    table.Push(mut az.sv.fm, -1)
    table.Push(mut az.sv.fm, -1)
    table.Push(mut az.sv.fm, -1)
    table.Push(mut az.sv.fm, table.Get(mut az.sv.fmh, fi))
    table.Set(mut az.sv.fmh, fi, n)
    return n
}

// 名前の文字列の一致（-1 同士も一致）
func svNameEq(az mut Az, x int, y desugar.StrRef) bool {
    if x == -1 || y == -1 {
        return x == int(y)
    }
    return desugar.StrEq(mut az.d, desugar.StrRef(x), y)
}

// 今の関数の仮引数 j の道 (a, b) を読んだ値（欄のビット — 割り当てが尽きたら仮引数のビット）
func svFbit(az mut Az, j int, a desugar.StrRef, b desugar.StrRef) LSet {
    i := svFm(mut az, az.cur, j, a, b)
    mut bit := table.Get(mut az.sv.fm, i + 3)
    if bit == -1 {
        nb := table.Get(mut az.sv.fbn, az.cur)
        if nb >= PBITS {
            return svP(j)
        }
        bit = nb
        table.Set(mut az.sv.fm, i + 3, bit)
        table.Set(mut az.sv.fbn, az.cur, nb + 1)
        // 道の Pin（全呼び手の実引数のその道 — 文脈に鈍い具体化）
        table.Set(mut az.sv.fm, i + 5, newSlot(mut az, lsNone()))
        svWake(mut az, az.cur)
    }
    return LSet{lo: 0, hi: 1 << bit}
}

// 関数 fi の呼び手（Sink の読み手）を作業の列へ（新しい道の Mout / Pin を呼び手はまだ読み書きしていない）
func svWake(az mut Az, fi int) {
    mut rd := table.Get(mut az.er.rhead, az.sv.sinkBase + fi)
    while rd != -1 {
        enqueue(mut az, table.Get(mut az.er.rnode, rd))
        rd = table.Get(mut az.er.rnode, rd + 1)
    }
}

// 関数 fi の P のビット b の仮引数（無ければ -1）と項（仮引数そのもののビットなら -1）
func svBitJ(az mut Az, fi int, b int) (int, int) {
    if b < svNParams(mut az, fi) {
        return b, -1
    }
    mut i := table.Get(mut az.sv.fmh, fi)
    while i != -1 {
        if table.Get(mut az.sv.fm, i + 3) == b {
            return table.Get(mut az.sv.fm, i), i
        }
        i = table.Get(mut az.sv.fm, i + 6)
    }
    return -1, -1
}

// 道 (r, a, b) の下の欄 (g1, g2) の道（深さ 2 へ畳む）
func svCompose(r desugar.StrRef, a desugar.StrRef, b desugar.StrRef, g1 desugar.StrRef, g2 desugar.StrRef) (desugar.StrRef, desugar.StrRef, desugar.StrRef) {
    if a == -1 {
        return r, g1, g2
    }
    if b == -1 {
        return r, a, g1
    }
    return r, a, b
}

// 式 e の名前の根の道（根 = -1 なら道でない）と、添字で切れたか（切れた道へは下の欄でなく丸ごと書く）
func svAPOf(az mut Az, e desugar.NodeRef) (desugar.StrRef, desugar.StrRef, desugar.StrRef, bool) {
    none := desugar.StrRef(-1)
    if e == -1 || az.sv.og {
        // 出所の名前空間は道を持たない（値は丸ごと）
        return none, none, none, false
    }
    x := node(mut az, e)
    if x.kind == ast.EParen {
        return svAPOf(mut az, desugar.NodeRef(x.a))
    }
    if x.kind == ast.EIdent {
        nm := desugar.StrRef(x.a)
        if isLocal(mut az, nm) {
            return nm, none, none, false
        }
        return none, none, none, false
    }
    if x.kind == ast.ESelector {
        r, a, b, ix := svAPOf(mut az, desugar.NodeRef(x.a))
        if r == -1 || ix {
            return none, none, none, false
        }
        r2, a2, b2 := svCompose(r, a, b, desugar.StrRef(x.b), none)
        return r2, a2, b2, false
    }
    if x.kind == ast.EMutArg {
        return svAPPath(mut az, desugar.StrRef(x.a))
    }
    return none, none, none, false
}

// mut の実引数の綴り（`x` / `x.f.g…` / `x…[i]…`）の道（欄の名前は欄の表の同じ綴りの文字列を借りる — 引けなければそこで切る）
func svAPPath(az mut Az, path desugar.StrRef) (desugar.StrRef, desugar.StrRef, desugar.StrRef, bool) {
    none := desugar.StrRef(-1)
    n := desugar.Dat(mut az.d, int(path))
    mut root := mut []byte{}
    mut i := 0
    while i < n && desugar.Dat(mut az.d, int(path) + 1 + i) != '.' && desugar.Dat(mut az.d, int(path) + 1 + i) != '[' {
        root = append(root, byte(desugar.Dat(mut az.d, int(path) + 1 + i)))
        i += 1
    }
    rn := svFindName(mut az, freeze(root))
    if rn == -1 {
        return none, none, none, false
    }
    mut fs := mut []desugar.StrRef{}
    while i < n && desugar.Dat(mut az.d, int(path) + 1 + i) == '.' && len(fs) < 2 {
        lo := i + 1
        mut hi := lo
        while hi < n && desugar.Dat(mut az.d, int(path) + 1 + hi) != '.' && desugar.Dat(mut az.d, int(path) + 1 + hi) != '[' {
            hi += 1
        }
        nm := svFieldName(mut az, path, lo, hi)
        if nm == -1 {
            // 欄の名前が引けない — ここまでの道へ丸ごと
            a0 := if len(fs) > 0 { fs[0] } else { none }
            return rn, a0, none, true
        }
        fs = append(fs, nm)
        i = hi
    }
    ix := i < n && desugar.Dat(mut az.d, int(path) + 1 + i) == '['
    a := if len(fs) > 0 { fs[0] } else { none }
    b := if len(fs) > 1 { fs[1] } else { none }
    return rn, a, b, ix
}

// 綴り path[lo, hi) と同じ綴りの欄の名前の文字列（無ければ -1）
func svFieldName(az mut Az, path desugar.StrRef, lo int, hi int) desugar.StrRef {
    for q <- iter.Range(0, table.Len(mut az.sv.fl) / 3) {
        nm := desugar.StrRef(table.Get(mut az.sv.fl, q * 3 + 1))
        if nm != -1 && desugar.StrEqPart(mut az.d, nm, path, lo, hi) {
            return nm
        }
    }
    return -1
}

// 道 (r, a, b) の表の添字（無ければ -1）
func svPe(az mut Az, r desugar.StrRef, a desugar.StrRef, b desugar.StrRef) int {
    for i <- iter.Range(0, az.sv.peN) {
        if desugar.StrEq(mut az.d, desugar.StrRef(table.Get(mut az.sv.pe, i * 5)), r) && svNameEq(mut az, table.Get(mut az.sv.pe, i * 5 + 1), a) && svNameEq(mut az, table.Get(mut az.sv.pe, i * 5 + 2), b) {
            return i
        }
    }
    return -1
}

func svPeVal(az mut Az, i int) LSet {
    return if i == -1 { lsNone() } else { LSet{lo: table.Get(mut az.sv.pe, i * 5 + 3), hi: table.Get(mut az.sv.pe, i * 5 + 4)} }
}

// 道 (r, a, b)（a ≠ -1）へ値 w（道の表へ・r が仮引数 j なら仮引数の道の Mout へも — 呼び手の実引数の道へ戻る）
func svPathWrite(az mut Az, r desugar.StrRef, a desugar.StrRef, b desugar.StrRef, w LSet) {
    if lsEmpty(w) || a == -1 {
        return
    }
    i := svPe(mut az, r, a, b)
    if i == -1 {
        k := az.sv.peN * 5
        if k >= table.Len(mut az.sv.pe) {
            for _ <- iter.Range(0, 5) {
                table.Push(mut az.sv.pe, 0)
            }
        }
        table.Set(mut az.sv.pe, k, int(r))
        table.Set(mut az.sv.pe, k + 1, int(a))
        table.Set(mut az.sv.pe, k + 2, int(b))
        table.Set(mut az.sv.pe, k + 3, w.lo)
        table.Set(mut az.sv.pe, k + 4, w.hi)
        az.sv.peN += 1
        az.er.envChanged = true
    } else {
        o := svPeVal(mut az, i)
        if !lsSub(w, o) {
            u := lsOr(o, w)
            table.Set(mut az.sv.pe, i * 5 + 3, u.lo)
            table.Set(mut az.sv.pe, i * 5 + 4, u.hi)
            az.er.envChanged = true
        }
    }
    j := paramIdx(mut az, r)
    if j != -1 {
        it := svFm(mut az, az.cur, j, a, b)
        mut s := table.Get(mut az.sv.fm, it + 4)
        if s == -1 {
            s = newSlot(mut az, lsNone())
            table.Set(mut az.sv.fm, it + 4, s)
            svWake(mut az, az.cur)
        }
        addSlot(mut az, s, w)
    }
}

// 名前 y を道 (r, a, b) の別名にする（y の欄の読みは行き先の道の欄・丸ごとは行き先の丸ごと — decl = 値の型宣言・q = 行き先の最後の欄の型 × 名前のスロットの項）
func svAlias(az mut Az, y desugar.StrRef, r desugar.StrRef, a desugar.StrRef, b desugar.StrRef, decl desugar.NodeRef, q int) {
    if desugar.StrEq(mut az.d, y, r) && a == -1 {
        return
    }
    for i <- iter.Range(0, az.sv.alN) {
        k := i * 6
        if desugar.StrEq(mut az.d, desugar.StrRef(table.Get(mut az.sv.al, k)), y) && desugar.StrEq(mut az.d, desugar.StrRef(table.Get(mut az.sv.al, k + 1)), r) &&
            svNameEq(mut az, table.Get(mut az.sv.al, k + 2), a) && svNameEq(mut az, table.Get(mut az.sv.al, k + 3), b) {
            return
        }
    }
    k := az.sv.alN * 6
    if k >= table.Len(mut az.sv.al) {
        for _ <- iter.Range(0, 6) {
            table.Push(mut az.sv.al, 0)
        }
    }
    table.Set(mut az.sv.al, k, int(y))
    table.Set(mut az.sv.al, k + 1, int(r))
    table.Set(mut az.sv.al, k + 2, int(a))
    table.Set(mut az.sv.al, k + 3, int(b))
    table.Set(mut az.sv.al, k + 4, int(decl))
    table.Set(mut az.sv.al, k + 5, q)
    az.sv.alN += 1
    az.er.envChanged = true
}

// 道 (r, a, b)（a ≠ -1）の値の出所の分: 道の表（畳んだ上の段の丸ごとも）∪ 根の局所の値 ∪ 別名の行き先の道 ∪ 仮引数なら欄のビット（`@secret` なら原子）。
// 型 × 名前のスロットは含まない（読む所が節の型で足す）
func svOrigin(az mut Az, r desugar.StrRef, a desugar.StrRef, b desugar.StrRef, d int) LSet {
    mut v := svPeVal(mut az, svPe(mut az, r, a, b))
    if b != -1 {
        v = lsOr(v, svPeVal(mut az, svPe(mut az, r, a, desugar.StrRef(-1))))
    }
    i := envFind(mut az, r)
    if i != -1 {
        v = lsOr(v, envGet(mut az, i))
    }
    if d < 4 {
        for k <- iter.Range(0, az.sv.alN) {
            if desugar.StrEq(mut az.d, desugar.StrRef(table.Get(mut az.sv.al, k * 6)), r) {
                t0, t1, t2 := svCompose(desugar.StrRef(table.Get(mut az.sv.al, k * 6 + 1)), desugar.StrRef(table.Get(mut az.sv.al, k * 6 + 2)), desugar.StrRef(table.Get(mut az.sv.al, k * 6 + 3)), a, b)
                v = lsOr(v, svOrigin(mut az, t0, t1, t2, d + 1))
                // 行き先の最後の欄（読む道の上の段）の型 × 名前のスロット（`@secret` の欄の原子も）
                aq := table.Get(mut az.sv.al, k * 6 + 5)
                if aq != -1 {
                    v = lsOr(v, svFieldRead(mut az, aq))
                }
            }
        }
    }
    j := paramIdx(mut az, r)
    if j != -1 {
        sa := table.Get(mut az.sv.secp, table.Get(mut az.sv.pbase, az.cur) + j)
        v = lsOr(v, if sa != -1 { svAtom(sa) } else { svFbit(mut az, j, a, b) })
    }
    return v
}

// 名前 r の丸ごとの値（局所 ∪ 仮引数のビット・原子 ∪ 別名の行き先の丸ごと — 欄の中身は持たない）。dump なら r の道の表を型 × 名前のスロットへ吐く（値が逃げる所）
func svWholeName(az mut Az, r desugar.StrRef, decl desugar.NodeRef, dump bool, d int) LSet {
    i := envFind(mut az, r)
    mut v := if i != -1 { envGet(mut az, i) } else { lsNone() }
    j := paramIdx(mut az, r)
    if j != -1 {
        sa := table.Get(mut az.sv.secp, table.Get(mut az.sv.pbase, az.cur) + j)
        v = lsOr(v, if sa != -1 { svAtom(sa) } else { svP(j) })
    }
    if dump {
        svDump(mut az, r, desugar.StrRef(-1), decl)
    }
    if d < 4 {
        for k <- iter.Range(0, az.sv.alN) {
            if desugar.StrEq(mut az.d, desugar.StrRef(table.Get(mut az.sv.al, k * 6)), r) {
                t0 := desugar.StrRef(table.Get(mut az.sv.al, k * 6 + 1))
                t1 := desugar.StrRef(table.Get(mut az.sv.al, k * 6 + 2))
                t2 := desugar.StrRef(table.Get(mut az.sv.al, k * 6 + 3))
                td := desugar.NodeRef(table.Get(mut az.sv.al, k * 6 + 4))
                v = lsOr(v, if t1 == -1 { svWholeName(mut az, t0, td, dump, d + 1) } else { svWholeSub(mut az, t0, t1, t2, td, table.Get(mut az.sv.al, k * 6 + 5), dump) })
            }
        }
    }
    return v
}

// 道 (r, a, b)（a ≠ -1）の丸ごとの値（出所の分 ∪ 最後の欄の型 × 名前のスロット q）。dump なら下の道を吐く
func svWholeSub(az mut Az, r desugar.StrRef, a desugar.StrRef, b desugar.StrRef, decl desugar.NodeRef, q int, dump bool) LSet {
    if dump && b == -1 {
        svDump(mut az, r, a, decl)
    }
    return lsOr(svOrigin(mut az, r, a, b, 0), if q != -1 { svFieldRead(mut az, q) } else { lsNone() })
}

// 道 (r, a)（a = -1 なら名前 r）の下の道の表の値を、根の型宣言 rd の最初の段の欄（r.e1）の型 × 名前のスロットへ吐く
// （値が逃げる所 — 仮引数のビットは Pin で具体化。下の段の型〔sha256.State 等〕の共有のスロットへは吐かない）
func svDump(az mut Az, r desugar.StrRef, a desugar.StrRef, rd desugar.NodeRef) {
    if rd == -1 {
        return
    }
    for i <- iter.Range(0, az.sv.peN) {
        if desugar.StrEq(mut az.d, desugar.StrRef(table.Get(mut az.sv.pe, i * 5)), r) {
            e1 := table.Get(mut az.sv.pe, i * 5 + 1)
            // 道 (r, a) の丸ごとの読みは (r, a) 自身の値を返す — 吐くのは下の段だけ
            if a == -1 || (svNameEq(mut az, e1, a) && table.Get(mut az.sv.pe, i * 5 + 2) != -1) {
                q := svField(mut az, rd, desugar.StrRef(e1))
                if q != -1 {
                    addSlot(mut az, az.sv.flBase + q, svConcrete(mut az, svPeVal(mut az, i)))
                }
            }
        }
    }
}

// 道 (r, a)（a = -1 なら名前 r）の下の道の表の合併（別名の行き先の下も 1 段 — Pin へ写す実引数の中身）
func svApSub(az mut Az, r desugar.StrRef, a desugar.StrRef) LSet {
    mut v := lsNone()
    for i <- iter.Range(0, az.sv.peN) {
        if desugar.StrEq(mut az.d, desugar.StrRef(table.Get(mut az.sv.pe, i * 5)), r) && (a == -1 || svNameEq(mut az, table.Get(mut az.sv.pe, i * 5 + 1), a)) {
            v = lsOr(v, svPeVal(mut az, i))
        }
    }
    if a == -1 {
        for k <- iter.Range(0, az.sv.alN) {
            if desugar.StrEq(mut az.d, desugar.StrRef(table.Get(mut az.sv.al, k * 6)), r) {
                t0 := desugar.StrRef(table.Get(mut az.sv.al, k * 6 + 1))
                t1 := desugar.StrRef(table.Get(mut az.sv.al, k * 6 + 2))
                for i <- iter.Range(0, az.sv.peN) {
                    if desugar.StrEq(mut az.d, desugar.StrRef(table.Get(mut az.sv.pe, i * 5)), t0) && (t1 == -1 || svNameEq(mut az, table.Get(mut az.sv.pe, i * 5 + 1), t1)) {
                        v = lsOr(v, svPeVal(mut az, i))
                    }
                }
            }
        }
    }
    return v
}

// 名前の根の道の式 e の根の型宣言と最後の欄の型 × 名前のスロットの項（無ければ -1）
func svApDecls(az mut Az, e desugar.NodeRef) (desugar.NodeRef, int) {
    mut c := e
    mut q := -1
    mut first := true
    while c != -1 && (kind(mut az, c) == ast.ESelector || kind(mut az, c) == ast.EParen) {
        x := node(mut az, c)
        if x.kind == ast.ESelector && first {
            q = svField(mut az, desugar.ExprDecl(mut az.d, desugar.NodeRef(x.a)), desugar.StrRef(x.b))
            first = false
        }
        c = desugar.NodeRef(x.a)
    }
    if c != -1 && kind(mut az, c) == ast.EIdent {
        return desugar.ExprDecl(mut az.d, c), q
    }
    return desugar.NodeRef(-1), q
}

// 欄の読みの節 e の全部の段の型 × 名前のスロット（基底の型ごと）
func svGChain(az mut Az, e desugar.NodeRef) LSet {
    mut v := lsNone()
    mut c := e
    while c != -1 && (kind(mut az, c) == ast.ESelector || kind(mut az, c) == ast.EParen) {
        x := node(mut az, c)
        if x.kind == ast.ESelector {
            q := svField(mut az, desugar.ExprDecl(mut az.d, desugar.NodeRef(x.a)), desugar.StrRef(x.b))
            if q != -1 {
                v = lsOr(v, svFieldRead(mut az, q))
            }
        }
        c = desugar.NodeRef(x.a)
    }
    return v
}

// 呼び出し点の実引数 a（丸ごとの値 whole）の下の道 (g1, g2) の値（名前の根の道なら出所の分・他は丸ごと）
func svApArg(az mut Az, a desugar.NodeRef, whole LSet, g1 desugar.StrRef, g2 desugar.StrRef) LSet {
    r, x, y, ix := svAPOf(mut az, a)
    if r == -1 {
        return whole
    }
    if ix {
        return if x == -1 { svWholeName(mut az, r, desugar.NodeRef(-1), false, 0) } else { svOrigin(mut az, r, x, y, 0) }
    }
    t0, t1, t2 := svCompose(r, x, y, g1, g2)
    return svOrigin(mut az, t0, t1, t2, 0)
}

// 呼び先の mut の仮引数（実引数 a）の道 (g1, g2)（g1 = -1 なら丸ごと）へ書いた値 w を呼び手の側へ
func svWriteArg(az mut Az, a desugar.NodeRef, g1 desugar.StrRef, g2 desugar.StrRef, w LSet) {
    r, x, y, ix := svAPOf(mut az, a)
    if r == -1 {
        svAssign(mut az, a, w)
        return
    }
    if ix {
        svWriteTo(mut az, r, x, y, w)
        return
    }
    c0, c1, c2 := svCompose(r, x, y, g1, g2)
    svWriteTo(mut az, c0, c1, c2, w)
}

// 道 (r, a, b) へ w（a = -1 なら名前 r の丸ごと）
func svWriteTo(az mut Az, r desugar.StrRef, a desugar.StrRef, b desugar.StrRef, w LSet) {
    if a == -1 {
        svName(mut az, r, w)
    } else {
        svPathWrite(mut az, r, a, b, w)
    }
}

// 別名の候補の列の末尾へ 1 語
func svMalPut(az mut Az, x int) {
    if az.sv.malN < table.Len(mut az.sv.mal) {
        table.Set(mut az.sv.mal, az.sv.malN, x)
    } else {
        table.Push(mut az.sv.mal, x)
    }
    az.sv.malN += 1
}

// 呼び先 fi の要約の値 v（P = 呼び先の仮引数と欄のビット）を呼び出し点の実引数（節 an・値 av — 丸ごと）で具体化する。
// 仮引数の丸ごとのビットは実引数の丸ごと: 名前の根の道の実引数は、束縛の右辺の結果（pos ≥ 0）なら別名の候補に・他は値が逃げる（道を吐く）
func svInst(az mut Az, fi int, v LSet, an []desugar.NodeRef, av []LSet, pos int) LSet {
    mut res := LSet{lo: v.lo, hi: v.hi & TOPH}
    p := v.hi & PMASK
    if p == 0 {
        return res
    }
    for b <- iter.Range(0, PBITS) {
        if (p & (1 << b)) != 0 {
            j, it := svBitJ(mut az, fi, b)
            if j != -1 && j < len(av) {
                if it == -1 {
                    res = lsOr(res, av[j])
                    r, x, y, ix := svAPOf(mut az, an[j])
                    if r != -1 {
                        rd, q := svApDecls(mut az, an[j])
                        if pos >= 0 && !ix {
                            svMalPut(mut az, pos)
                            svMalPut(mut az, int(r))
                            svMalPut(mut az, int(x))
                            svMalPut(mut az, int(y))
                            svMalPut(mut az, int(rd))
                            svMalPut(mut az, q)
                        } else {
                            svDump(mut az, r, x, rd)
                        }
                    }
                } else {
                    res = lsOr(res, svApArg(mut az, an[j], av[j], desugar.StrRef(table.Get(mut az.sv.fm, it + 1)), desugar.StrRef(table.Get(mut az.sv.fm, it + 2))))
                }
            }
        }
    }
    return res
}

// ── 型宣言 → 欄の表 ──

func svHash(d int) int {
    x := if d < 0 { -d } else { d }
    return (x ^ (x >> 13)) % SVH
}

// 型宣言 d の表の位置（無ければ空きの位置 — 表の [3i] が 0）
func svDeclAt(az mut Az, d int) int {
    mut i := svHash(d)
    while table.Get(mut az.sv.hk, i * 3) != 0 && table.Get(mut az.sv.hk, i * 3) != d + 1 {
        i = (i + 1) % SVH
    }
    return i
}

// 型宣言 d の欄 name の項（無ければ -1）
func svField(az mut Az, d desugar.NodeRef, name desugar.StrRef) int {
    if d == -1 {
        return -1
    }
    i := svDeclAt(mut az, int(d))
    if table.Get(mut az.sv.hk, i * 3) == 0 {
        return -1
    }
    first := table.Get(mut az.sv.hk, i * 3 + 1)
    for k <- iter.Range(0, table.Get(mut az.sv.hk, i * 3 + 2)) {
        if desugar.StrEq(mut az.d, desugar.StrRef(table.Get(mut az.sv.fl, (first + k) * 3 + 1)), name) {
            return first + k
        }
    }
    return -1
}

// 欄の項 q の値（スロット ∪ `@secret` の欄なら原子）
func svFieldRead(az mut Az, q int) LSet {
    return lsOr(readSlot(mut az, az.sv.flBase + q), svAtom(table.Get(mut az.sv.fl, q * 3 + 2)))
}

// ── 準備 ──

// 源の原子を数え、注釈を照合し、源があればスロットを積む（error の解きの後 — 同じ Eng）
func svInit(az mut Az) {
    for fi <- iter.Range(0, az.nfn) {
        fd := fnDecl(mut az, fi)
        table.Push(mut az.sv.pbase, az.sv.npar)
        n := svNParams(mut az, fi)
        table.Push(mut az.sv.fmh, -1)
        table.Push(mut az.sv.fbn, if n < PBITS { n } else { PBITS })
        for j <- iter.Range(0, n) {
            table.Push(mut az.sv.secp, -1)
            table.Push(mut az.sv.sinkAt, -1)
            table.Push(mut az.sv.sinkK, 0)
        }
        l0, t := desugar.FuncSecret(mut az.d, fd)
        l := if az.sv.og { desugar.ListRef(-1) } else { l0 }
        if az.sv.og {
            ogInitFn(mut az, fi, fd)
        }
        if l != -1 {
            for k <- iter.Range(0, desugar.LenL(mut az.d, l)) {
                s := desugar.StrRef(desugar.LatI(mut az.d, l, k))
                j := paramOf(mut az, fi, s)
                if j == -1 {
                    report(mut az, MSecAnn, desugar.FnAt(mut az.d, fi).node, desugar.NodeRef(k))
                } else if table.Get(mut az.sv.secp, az.sv.npar + j) == -1 {
                    table.Set(mut az.sv.secp, az.sv.npar + j, az.sv.natom)
                    svPushAtom(mut az, 0, fi, j)
                }
            }
        }
        if !az.sv.og && desugar.FuncBless(mut az.d, fd) && !desugar.IsStdPkg(mut az.d, desugar.FnAt(mut az.d, fi).pkg) {
            report(mut az, MSecBless, desugar.FnAt(mut az.d, fi).node, desugar.NodeRef(0))
        }
        az.sv.npar += n
    }
    // 欄の項（struct の欄・名前付き関数型の仮引数）と源の const
    for _ <- iter.Range(0, SVH * 3) {
        table.Push(mut az.sv.hk, 0)
    }
    for f <- iter.Range(0, desugar.Nfile(mut az.d)) {
        root := desugar.NodeOf(mut az.d, desugar.FileRoot(mut az.d, f))
        ts := desugar.ListRef(root.c)
        for i <- iter.Range(0, desugar.LenL(mut az.d, ts)) {
            td := nat(mut az, ts, i)
            body := desugar.NodeRef(node(mut az, td).c)
            bk := if body == -1 { -1 } else { kind(mut az, body) }
            // 型パラメータを持つ struct（コンテナ — table.Table・builder.Builder 等）は欄のスロットを持たない: 値の集約（基底の値）で読み書きする
            generic := desugar.LenL(mut az.d, desugar.ListRef(node(mut az, td).b)) > 0
            if (bk == ast.BStruct && !generic) || bk == ast.BFunc {
                fs := desugar.ListRef(node(mut az, body).a)
                h := svDeclAt(mut az, int(td))
                table.Set(mut az.sv.hk, h * 3, int(td) + 1)
                table.Set(mut az.sv.hk, h * 3 + 1, table.Len(mut az.sv.fl) / 3)
                table.Set(mut az.sv.hk, h * 3 + 2, desugar.LenL(mut az.d, fs))
                for k <- iter.Range(0, desugar.LenL(mut az.d, fs)) {
                    fx := node(mut az, nat(mut az, fs, k))
                    // 源の欄: 秘密の名前空間は `@secret`（c = 1）・出所の名前空間は `@credential`（c = 2）
                    sec := bk == ast.BStruct && fx.c == (if az.sv.og { 2 } else { 1 })
                    if az.sv.og {
                        ogInitField(mut az, td, if bk == ast.BStruct { desugar.NodeRef(fx.b) } else { desugar.NodeRef(-1) }, f, sec)
                    }
                    table.Push(mut az.sv.fl, int(td))
                    table.Push(mut az.sv.fl, if bk == ast.BStruct { fx.a } else { -1 })
                    table.Push(mut az.sv.fl, if sec { az.sv.natom } else { -1 })
                    if sec {
                        if az.sv.og {
                            az.sv.oMask = az.sv.oMask | (1 << az.sv.natom)
                        }
                        svPushAtom(mut az, 1, table.Len(mut az.sv.fl) / 3 - 1, 0)
                    }
                }
            }
            if az.sv.og && bk == ast.BUnion {
                ogInitUnion(mut az, td, body, f)
            }
        }
        cs := desugar.ListRef(root.e)
        for i <- iter.Range(0, if az.sv.og { 0 } else { desugar.LenL(mut az.d, cs) }) {
            cn := node(mut az, nat(mut az, cs, i))
            if (cn.f & 2) != 0 {
                ci := desugar.ResolveTop(mut az.d, desugar.FilePkg(mut az.d, f), desugar.StrRef(cn.a), false, desugar.TopConst).idx
                table.Push(mut az.sv.cons, ci)
                table.Push(mut az.sv.cons, az.sv.natom)
                svPushAtom(mut az, 2, int(nat(mut az, cs, i)), 0)
            }
        }
    }
    if az.sv.natom == 0 || (az.sv.og && az.sv.oMask == 0) {
        return
    }
    if az.sv.og {
        ogInitRest(mut az)
    }
    for fi <- iter.Range(0, az.nfn) {
        table.Push(mut az.sv.touch, 0)
    }
    az.sv.on = true
    az.sv.resBase = table.Len(mut az.er.rhead)
    for fi <- iter.Range(0, az.nfn) {
        table.Push(mut az.sv.rpos, az.sv.nres)
        az.sv.nres += svNRes(mut az, fi)
    }
    for i <- iter.Range(0, az.sv.nres) {
        newSlot(mut az, lsNone())
    }
    az.sv.sinkBase = table.Len(mut az.er.rhead)
    for fi <- iter.Range(0, az.nfn) {
        newSlot(mut az, lsNone())
    }
    az.sv.pinBase = table.Len(mut az.er.rhead)
    for i <- iter.Range(0, 2 * az.sv.npar) {
        newSlot(mut az, lsNone())
    }
    az.sv.flBase = table.Len(mut az.er.rhead)
    for q <- iter.Range(0, table.Len(mut az.sv.fl) / 3) {
        newSlot(mut az, lsNone())
    }
    az.sv.effBase = table.Len(mut az.er.rhead)
    for fi <- iter.Range(0, if az.sv.og { az.nfn } else { 0 }) {
        newSlot(mut az, lsNone())
    }
}

func svPushAtom(az mut Az, k int, a int, b int) {
    table.Push(mut az.sv.atoms, k)
    table.Push(mut az.sv.atoms, a)
    table.Push(mut az.sv.atoms, b)
    az.sv.natom += 1
}

// 全関数を作業の列に積み（error の解きの後の列の続き）、スロットが広がらなくなるまで歩く。最後の 1 周で違反を記録する
func svSolve(az mut Az) {
    if !az.sv.on {
        return
    }
    mut h := table.Len(mut az.er.work)
    for fi <- iter.Range(0, az.nfn) {
        enqueue(mut az, fi)
    }
    while h < table.Len(mut az.er.work) {
        fi := table.Get(mut az.er.work, h)
        h += 1
        table.Set(mut az.er.inq, fi, 0)
        svWalkFn(mut az, fi)
        az.sv.walks += 1
    }
    az.sv.rec = true
    for fi <- iter.Range(0, az.nfn) {
        svWalkFn(mut az, fi)
    }
    az.sv.rec = false
    if az.sv.og {
        for i <- iter.Range(0, table.Len(mut az.sv.ov) / 4) {
            report(mut az, MOrgMeet, desugar.NodeRef(table.Get(mut az.sv.ov, i * 4)), desugar.NodeRef(i))
        }
        return
    }
    for i <- iter.Range(0, table.Len(mut az.sv.viol) / 4) {
        report(mut az, MSecSink, desugar.NodeRef(table.Get(mut az.sv.viol, i * 4)), desugar.NodeRef(i))
        x := table.Get(mut az.sv.viol, i * 4 + 2)
        if table.Get(mut az.sv.viol, i * 4 + 1) == SkCall {
            at := table.Get(mut az.sv.sinkAt, table.Get(mut az.sv.pbase, x / 64) + x % 64)
            if at != -1 {
                report(mut az, MSecNote, desugar.NodeRef(at), desugar.NodeRef(i))
            }
        }
    }
}

// 関数 fi の本体を、局所が広がらなくなるまで歩く（本体の末尾の値も結果へ）
func svWalkFn(az mut Az, fi int) {
    body := desugar.NodeRef(fnDecl(mut az, fi).e)
    if body == -1 {
        return
    }
    az.cur = fi
    az.pk = desugar.FnAt(mut az.d, fi).pkg
    az.er.envN = 0
    az.sv.peN = 0
    az.sv.alN = 0
    az.sv.nodump = false
    az.sv.bind = false
    az.sv.lamIn = lsNone()
    mut again := true
    mut n := 0
    while again && n < 16 {
        az.er.envChanged = false
        tail := svBlock(mut az, body)
        svResAll(mut az, fi, tail)
        again = az.er.envChanged
        n += 1
    }
}

// 値 v（P は Pin で文脈に鈍く具体化）が秘密なら今の関数を表 T に記す（最後の 1 周）
func svTouch(az mut Az, v LSet) {
    if az.sv.rec && table.Get(mut az.sv.touch, az.cur) == 0 && svSecret(svConcrete(mut az, v)) {
        table.Set(mut az.sv.touch, az.cur, 1)
    }
}

// ── sink ──

// 値 v が sink（種類 k・節 at）に届いた: 源は違反（最後の 1 周で記録）、P は今の関数の Sink へ
func svSink(az mut Az, v LSet, at desugar.NodeRef, k int, x int) {
    if az.sv.og {
        // 出所の名前空間に分岐・番地・除算の sink は無い（sink は出会いだけ — origin.sober）
        return
    }
    if svSecret(v) && az.sv.rec {
        svViol(mut az, at, k, x, v)
    }
    pb := v.hi & PMASK
    if pb != 0 {
        addSlot(mut az, az.sv.sinkBase + az.cur, LSet{lo: pb, hi: 0})
        for b <- iter.Range(0, PBITS) {
            if (pb & (1 << b)) != 0 {
                j, _ := svBitJ(mut az, az.cur, b)
                q := table.Get(mut az.sv.pbase, az.cur) + j
                if j != -1 && table.Get(mut az.sv.sinkAt, q) == -1 {
                    table.Set(mut az.sv.sinkAt, q, int(at))
                    table.Set(mut az.sv.sinkK, q, k)
                }
            }
        }
    }
}

func svViol(az mut Az, at desugar.NodeRef, k int, x int, v LSet) {
    for i <- iter.Range(0, table.Len(mut az.sv.viol) / 4) {
        if table.Get(mut az.sv.viol, i * 4) == int(at) {
            return
        }
    }
    table.Push(mut az.sv.viol, int(at))
    table.Push(mut az.sv.viol, k)
    table.Push(mut az.sv.viol, x)
    table.Push(mut az.sv.viol, svFirst(v))
}

// ── 式と文 ──

func svBlock(az mut Az, b desugar.NodeRef) LSet {
    if b == -1 {
        return lsNone()
    }
    l := desugar.ListRef(node(mut az, b).a)
    n := desugar.LenL(mut az.d, l)
    mut v := lsNone()
    for i <- iter.Range(0, n) {
        s := nat(mut az, l, i)
        if i + 1 == n && kind(mut az, s) == ast.SExpr {
            v = sv(mut az, desugar.NodeRef(node(mut az, s).a))
        } else {
            svStmt(mut az, s)
        }
    }
    return v
}

func svElse(az mut Az, e desugar.NodeRef) LSet {
    if e == -1 {
        return lsNone()
    }
    k := kind(mut az, e)
    return if k == ast.EBlock || k == ast.KBlock { svBlock(mut az, e) } else { sv(mut az, e) }
}

func svList(az mut Az, l desugar.ListRef) LSet {
    mut v := lsNone()
    if l == -1 {
        return v
    }
    for i <- iter.Range(0, desugar.LenL(mut az.d, l)) {
        v = lsOr(v, sv(mut az, nat(mut az, l, i)))
    }
    return v
}

func svStmt(az mut Az, s desugar.NodeRef) {
    x := node(mut az, s)
    k := x.kind
    if k == ast.SBind {
        names := desugar.ListRef(x.a)
        vals := desugar.ListRef(x.c)
        nn := desugar.LenL(mut az.d, names)
        nv := desugar.LenL(mut az.d, vals)
        // 右辺が直の呼び出し（`f(…)` / `f(…)?`）なら、仮引数を丸ごと返す結果は実引数の道の別名の候補（svInst）
        az.sv.bind = nv == 1 && svDirectCall(mut az, nat(mut az, vals, 0))
        mv := if nn != nv && nv == 1 { svMulti(mut az, nat(mut az, vals, 0), nn) } else { []LSet{} }
        all := if nn != nv && nv != 1 { svList(mut az, vals) } else { lsNone() }
        for i <- iter.Range(0, nn) {
            nm := desugar.StrRef(desugar.LatI(mut az.d, names, i))
            if nn == nv && svBindAlias(mut az, nm, nat(mut az, vals, i)) {
                continue
            }
            m := if nn == nv { sv(mut az, nat(mut az, vals, i)) } else if nv == 1 { mv[i] } else { all }
            envAdd(mut az, nm, m)
        }
        az.sv.bind = false
        if nv == 1 && svDirectCall(mut az, nat(mut az, vals, 0)) {
            svBindCands(mut az, names, nat(mut az, vals, 0))
        }
    } else if k == ast.SAssign {
        ts := desugar.ListRef(x.a)
        vals := desugar.ListRef(x.c)
        nt := desugar.LenL(mut az.d, ts)
        nv := desugar.LenL(mut az.d, vals)
        mv := if nt != nv && nv == 1 { svMulti(mut az, nat(mut az, vals, 0), nt) } else { []LSet{} }
        all := if nt != nv && nv != 1 { svList(mut az, vals) } else { lsNone() }
        div := x.b == lexer.SlashEqual || x.b == lexer.PercentEqual
        for i <- iter.Range(0, nt) {
            t := nat(mut az, ts, i)
            if nt == nv && x.b == lexer.Equal && svStoreAP(mut az, t, nat(mut az, vals, i)) {
                continue
            }
            m := if nt == nv { sv(mut az, nat(mut az, vals, i)) } else if nv == 1 { mv[i] } else { all }
            // 複合代入（`+=` など）は古い値も運ぶ。`/=` `%=` は両辺が sink
            old := if x.b != lexer.Equal { sv(mut az, t) } else { lsNone() }
            if div {
                svSink(mut az, old, t, SkDiv, SkDiv)
                svSink(mut az, m, nat(mut az, vals, i), SkDiv, SkDiv)
            }
            svAssign(mut az, t, lsOr(m, old))
        }
    } else if k == ast.SRet {
        vals := desugar.ListRef(x.a)
        nv := desugar.LenL(mut az.d, vals)
        nr := svNRes(mut az, az.cur)
        if nv == nr {
            for i <- iter.Range(0, nv) {
                addSlot(mut az, svRes(mut az, az.cur, i), sv(mut az, nat(mut az, vals, i)))
            }
        } else if nv == 1 {
            // `return g()` の転送（位置ごと）
            mv := svMulti(mut az, nat(mut az, vals, 0), nr)
            for i <- iter.Range(0, nr) {
                addSlot(mut az, svRes(mut az, az.cur, i), mv[i])
            }
        } else {
            svResAll(mut az, az.cur, svList(mut az, vals))
        }
    } else if k == ast.SExpr || k == ast.SDefer || k == ast.SYield {
        sv(mut az, desugar.NodeRef(x.a))
    } else if k == ast.SWhile {
        svSink(mut az, sv(mut az, desugar.NodeRef(x.a)), desugar.NodeRef(x.a), SkCond, SkCond)
        svBlock(mut az, desugar.NodeRef(x.b))
    }
    return
}

// 式 e が直の呼び出し（`f(…)` / `f(…)?` / pipe）か
func svDirectCall(az mut Az, e desugar.NodeRef) bool {
    if e == -1 {
        return false
    }
    k := kind(mut az, e)
    if k == ast.ETry && desugar.NodeRef(node(mut az, e).b) == -1 {
        ik := kind(mut az, desugar.NodeRef(node(mut az, e).a))
        return ik == ast.ECall || ik == ast.EPipe
    }
    return k == ast.ECall || k == ast.EPipe
}

// 束縛 nm := v の右辺が名前の根の道なら nm をその別名にする（値は道の表と一緒に行き先が持つ）
func svBindAlias(az mut Az, nm desugar.StrRef, v desugar.NodeRef) bool {
    r, a, b, ix := svAPOf(mut az, v)
    if r == -1 || ix {
        return false
    }
    rd, q := svApDecls(mut az, v)
    envAdd(mut az, nm, lsNone())
    svAlias(mut az, nm, r, a, b, rd, q)
    return true
}

// 直の呼び出しの束縛の名前の列 names へ、直前の呼び出しの別名の候補（結果の位置 → 名前 — `?` は error の位置を飛ばす）
func svBindCands(az mut Az, names desugar.ListRef, v desugar.NodeRef) {
    try := kind(mut az, v) == ast.ETry
    nn := desugar.LenL(mut az.d, names)
    for c <- iter.Range(0, az.sv.malN / 6) {
        pos := table.Get(mut az.sv.mal, c * 6)
        // 位置 pos の名前の添字（`?` なら error でない位置だけ数える）
        mut k := pos
        if try {
            k = 0
            for i <- iter.Range(0, pos) {
                if i < svMresN(mut az) && table.Get(mut az.sv.mres, i * 3 + 2) == 0 {
                    k += 1
                }
            }
        }
        if k < nn {
            nm := desugar.StrRef(desugar.LatI(mut az.d, names, k))
            svAlias(mut az, nm, desugar.StrRef(table.Get(mut az.sv.mal, c * 6 + 1)), desugar.StrRef(table.Get(mut az.sv.mal, c * 6 + 2)), desugar.StrRef(table.Get(mut az.sv.mal, c * 6 + 3)),
                desugar.NodeRef(table.Get(mut az.sv.mal, c * 6 + 4)), table.Get(mut az.sv.mal, c * 6 + 5))
        }
    }
}

// `t = v` の両辺が名前の根の道なら、名前へは別名・欄へは丸ごとの値（吐かない）と v の下の道の表を t の下へ写す
func svStoreAP(az mut Az, t desugar.NodeRef, v desugar.NodeRef) bool {
    r, a, b, ix := svAPOf(mut az, v)
    tr, ta, tb, tix := svAPOf(mut az, t)
    if r == -1 || ix || tr == -1 || tix {
        return false
    }
    if ta == -1 {
        // 名前への代入: 別名（流れに鈍い — 前の値と合併）
        rd, q := svApDecls(mut az, v)
        svAlias(mut az, tr, r, a, b, rd, q)
        j := paramIdx(mut az, tr)
        if j != -1 {
            svName(mut az, tr, lsNone())
        }
        return j == -1
    }
    nd := az.sv.nodump
    az.sv.nodump = true
    m := sv(mut az, v)
    az.sv.nodump = nd
    svAssign(mut az, t, m)
    // v の下の道（と v が名前なら別名の行き先の下の道）を t の下へ
    for i <- iter.Range(0, az.sv.peN) {
        e0 := desugar.StrRef(table.Get(mut az.sv.pe, i * 5))
        e1 := desugar.StrRef(table.Get(mut az.sv.pe, i * 5 + 1))
        e2 := desugar.StrRef(table.Get(mut az.sv.pe, i * 5 + 2))
        if desugar.StrEq(mut az.d, e0, r) {
            if a == -1 {
                d0, d1, d2 := svCompose(tr, ta, tb, e1, e2)
                svPathWrite(mut az, d0, d1, d2, svPeVal(mut az, i))
            } else if b == -1 && svNameEq(mut az, int(e1), a) && e2 != -1 {
                d0, d1, d2 := svCompose(tr, ta, tb, e2, desugar.StrRef(-1))
                svPathWrite(mut az, d0, d1, d2, svPeVal(mut az, i))
            }
        }
    }
    return true
}

// 代入の行き先 t へ値 m（名前 → 局所〔mut の仮引数なら Mout へも〕・欄 → 欄のスロット・添字 → 基底へ）
func svAssign(az mut Az, t desugar.NodeRef, m LSet) {
    x := node(mut az, t)
    if x.kind == ast.EIdent {
        svName(mut az, desugar.StrRef(x.a), m)
    } else if x.kind == ast.ESelector && az.sv.og {
        ogFieldWrite(mut az, t, desugar.NodeRef(x.a), desugar.StrRef(x.b), m)
        svAssign(mut az, desugar.NodeRef(x.a), m)
    } else if x.kind == ast.ESelector {
        base := desugar.NodeRef(x.a)
        q := svField(mut az, desugar.ExprDecl(mut az.d, base), desugar.StrRef(x.b))
        r, a, b, _ := svAPOf(mut az, t)
        if q != -1 && r != -1 {
            // 名前の根の道: 具体の部分は型 × 名前のスロット・仮引数由来の部分は道の表（文脈欄）
            addSlot(mut az, az.sv.flBase + q, LSet{lo: m.lo, hi: m.hi & TOPH})
            svPathWrite(mut az, r, a, b, LSet{lo: 0, hi: m.hi & PMASK})
        } else if q != -1 {
            addSlot(mut az, az.sv.flBase + q, svConcrete(mut az, m))
            sv(mut az, base)
        } else {
            // 集約: 基底へ書く
            svAssign(mut az, desugar.NodeRef(x.a), m)
        }
    } else if x.kind == ast.EIndex {
        svSink(mut az, sv(mut az, desugar.NodeRef(x.b)), desugar.NodeRef(x.b), SkIndex, SkIndex)
        svAssign(mut az, desugar.NodeRef(x.a), m)
    } else if x.kind == ast.EParen {
        svAssign(mut az, desugar.NodeRef(x.a), m)
    }
    return
}

// 名前 name へ値 m（局所へ・今の関数の仮引数なら Mout へも）
func svName(az mut Az, name desugar.StrRef, m LSet) {
    envAdd(mut az, name, m)
    j := paramIdx(mut az, name)
    if j != -1 {
        addSlot(mut az, az.sv.pinBase + az.sv.npar + table.Get(mut az.sv.pbase, az.cur) + j, m)
    }
}

// 名前の値: 局所 ∪ 仮引数（P のビット・`@secret` なら原子）∪ 源の const ∪ 関数の名前（値としての関数 — 結果の S）
func svIdent(az mut Az, name desugar.StrRef) LSet {
    if isLocal(mut az, name) {
        // `@secret` の仮引数は源（呼び手に約束を課さない — P のビットを持たないので呼び手の実引数は sink に数えない）
        return svWholeName(mut az, name, desugar.NodeRef(-1), false, 0)
    }
    r := desugar.ResolveTop(mut az.d, az.pk, name, false, desugar.TopConst | desugar.TopFn)
    return svTop(mut az, r)
}

// トップレベル名の値（源の const は原子・関数は結果の S）
func svTop(az mut Az, r desugar.TopRef) LSet {
    if r.kind == desugar.TopConst {
        for c <- iter.Range(0, table.Len(mut az.sv.cons) / 2) {
            if table.Get(mut az.sv.cons, c * 2) == r.idx {
                return svAtom(table.Get(mut az.sv.cons, c * 2 + 1))
            }
        }
    } else if r.kind == desugar.TopFn {
        mut fv := lsNone()
        for i <- iter.Range(0, svNRes(mut az, r.idx)) {
            rv := readSlot(mut az, svRes(mut az, r.idx, i))
            fv = lsOr(fv, LSet{lo: rv.lo, hi: rv.hi & TOPH})
        }
        // 出所: 値としての関数は、呼ぶと源に届きうるなら C
        return if az.sv.og && ogEffOf(mut az, r.idx) { lsOr(fv, svAtom(az.sv.catom)) } else { fv }
    }
    return lsNone()
}

// mut の実引数の道 `x` / `x.f…`（EMutArg の綴り）の値（丸ごと — 道の表は吐かない）: 名前なら名前の丸ごと・`x.f…` は道の出所の分
// （欄の型は綴りから引けない — 型 × 名前のスロットは読まない）・添字の道は切れた所までの丸ごと
func svMutArg(az mut Az, path desugar.StrRef) LSet {
    r, a, b, _ := svAPPath(mut az, path)
    if r == -1 {
        return lsNone()
    }
    if a != -1 && !az.sv.og {
        return svOrigin(mut az, r, a, b, 0)
    }
    return svWholeName(mut az, r, desugar.NodeRef(-1), false, 0)
}

// 綴り b の名前の文字列（局所と今の関数の仮引数から — 無ければ -1）
func svFindName(az mut Az, b []byte) desugar.StrRef {
    for i <- iter.Range(0, az.er.envN) {
        s := desugar.StrRef(table.Get(mut az.er.env, i * 3))
        if svBytesIs(mut az, s, b) {
            return s
        }
    }
    ps := desugar.ListRef(fnDecl(mut az, az.cur).c)
    for j <- iter.Range(0, desugar.LenL(mut az.d, ps)) {
        s := desugar.StrRef(node(mut az, nat(mut az, ps, j)).a)
        if svBytesIs(mut az, s, b) {
            return s
        }
    }
    return -1
}

// 文字列 s の綴りが b か
func svBytesIs(az mut Az, s desugar.StrRef, b []byte) bool {
    n := desugar.Dat(mut az.d, int(s))
    if n != len(b) {
        return false
    }
    for i <- iter.Range(0, n) {
        if desugar.Dat(mut az.d, int(s) + 1 + i) != int(b[i]) {
            return false
        }
    }
    return true
}

// 式を歩いて値を返す
func sv(az mut Az, e desugar.NodeRef) LSet {
    if e == -1 {
        return lsNone()
    }
    x := node(mut az, e)
    k := x.kind
    switch k {
    case ast.EIdent:
        nm := desugar.StrRef(x.a)
        if isLocal(mut az, nm) {
            // 名前の丸ごとの読み: 値が逃げる所なら道の表を型 × 名前のスロットへ吐く
            return svWholeName(mut az, nm, desugar.ExprDecl(mut az.d, e), !az.sv.nodump, 0)
        }
        return svIdent(mut az, nm)
    case ast.EMutArg:
        return svMutArg(mut az, desugar.StrRef(x.a))
    case ast.EParen:
        return sv(mut az, desugar.NodeRef(x.a))
    case ast.ECall:
        return svCall(mut az, e, desugar.NodeRef(x.a), desugar.ListRef(x.b), desugar.NodeRef(-1))
    case ast.EPipe:
        return svCall(mut az, e, desugar.NodeRef(x.b), desugar.ListRef(x.c), desugar.NodeRef(x.a))
    case ast.ETry:
        inner := desugar.NodeRef(x.a)
        v := sv(mut az, inner)
        ik := kind(mut az, inner)
        mut tv := v
        if ik == ast.ECall || ik == ast.EPipe {
            // `f()?` の値は error でない位置の合併
            tv = lsNone()
            for i <- iter.Range(0, svMresN(mut az)) {
                if table.Get(mut az.sv.mres, i * 3 + 2) == 0 {
                    tv = lsOr(tv, svMresAt(mut az, i))
                }
            }
        }
        w := desugar.NodeRef(x.b)
        if w != -1 {
            svComposite(mut az, w, node(mut az, w))
        }
        return tv
    case ast.EComposite:
        return svComposite(mut az, e, x)
    case ast.ESelector:
        base := desugar.NodeRef(x.a)
        if kind(mut az, base) == ast.EIdent && !isLocal(mut az, desugar.StrRef(node(mut az, base).a)) {
            r := desugar.ResolveSel(mut az.d, az.pk, desugar.StrRef(node(mut az, base).a), desugar.StrRef(x.b), desugar.TopConst | desugar.TopFn)
            if r.kind != desugar.TopNone {
                return svTop(mut az, r)
            }
        }
        if az.sv.og {
            return lsOr(sv(mut az, base), ogFieldRead(mut az, base, desugar.StrRef(x.b)))
        }
        q := svField(mut az, desugar.ExprDecl(mut az.d, base), desugar.StrRef(x.b))
        // 欄の値 = 全部の段の型 × 名前のスロット ∪ 値の出所（名前の根の道なら道の表・別名・仮引数の欄のビット・他は基底の値）。
        // 欄のスロットの無い型（型パラメータつきの struct・union・型が分からない）は集約 = 基底の値
        if q == -1 {
            return sv(mut az, base)
        }
        r, a, b, _ := svAPOf(mut az, e)
        if r != -1 {
            if !az.sv.nodump {
                rd, _ := svApDecls(mut az, e)
                svDump(mut az, r, a, rd)
            }
            return lsOr(svGChain(mut az, e), svOrigin(mut az, r, a, b, 0))
        }
        return lsOr(svFieldRead(mut az, q), sv(mut az, base))
    case ast.EIf:
        svSink(mut az, sv(mut az, desugar.NodeRef(x.a)), desugar.NodeRef(x.a), SkCond, SkCond)
        return lsOr(svBlock(mut az, desugar.NodeRef(x.b)), svElse(mut az, desugar.NodeRef(x.c)))
    case ast.ESwitch:
        return svSwitch(mut az, x)
    case ast.EBlock:
        return svBlock(mut az, e)
    case ast.ELambda:
        return svLambda(mut az, e, x)
    case ast.EFor:
        return svFor(mut az, x)
    case ast.EIndex:
        bv := sv(mut az, desugar.NodeRef(x.a))
        iv := sv(mut az, desugar.NodeRef(x.b))
        svSink(mut az, iv, desugar.NodeRef(x.b), SkIndex, SkIndex)
        svTouch(mut az, lsOr(bv, iv))
        return lsOr(bv, iv)
    case ast.EBinary:
        lv := sv(mut az, desugar.NodeRef(x.b))
        rv := sv(mut az, desugar.NodeRef(x.c))
        svTouch(mut az, lsOr(lv, rv))
        if x.a == lexer.AmpersandAmpersand || x.a == lexer.PipePipe {
            svSink(mut az, lv, desugar.NodeRef(x.b), SkAndOr, SkAndOr)
        } else if x.a == lexer.Slash || x.a == lexer.Percent {
            svSink(mut az, lv, desugar.NodeRef(x.b), SkDiv, SkDiv)
            svSink(mut az, rv, desugar.NodeRef(x.c), SkDiv, SkDiv)
        }
        return lsOr(lv, rv)
    case ast.EUnary:
        uv := sv(mut az, desugar.NodeRef(x.b))
        svTouch(mut az, uv)
        return uv
    case ast.ESlice3:
        bv := sv(mut az, desugar.NodeRef(x.a))
        svSink(mut az, sv(mut az, desugar.NodeRef(x.b)), desugar.NodeRef(x.b), SkSlice, SkSlice)
        svSink(mut az, sv(mut az, desugar.NodeRef(x.c)), desugar.NodeRef(x.c), SkSlice, SkSlice)
        return bv
    case ast.EInterp | ast.ESlicelit:
        return svList(mut az, desugar.ListRef(x.b))
    case ast.EMaplit:
        es := desugar.ListRef(x.c)
        mut mv := lsNone()
        for i <- iter.Range(0, desugar.LenL(mut az.d, es)) {
            en := node(mut az, nat(mut az, es, i))
            kv := sv(mut az, desugar.NodeRef(en.a))
            svSink(mut az, kv, desugar.NodeRef(en.a), SkIndex, SkIndex)
            mv = lsOr(mv, lsOr(kv, sv(mut az, desugar.NodeRef(en.b))))
        }
        return mv
    }
    return lsNone()
}

// リテラル: struct なら欄のスロットへ（値は ∅ — 欄が運ぶ）、他（union の variant・ラベル）は要素の合併
func svComposite(az mut Az, e desugar.NodeRef, x ast.Node) LSet {
    if az.sv.og {
        return ogComposite(mut az, e, x)
    }
    els := desugar.ListRef(x.b)
    r := desugar.ResolveType(mut az.d, az.pk, desugar.StrRef(x.a))
    body := if r.kind == desugar.TopType { desugar.NodeRef(node(mut az, desugar.NodeRef(r.idx)).c) } else { desugar.NodeRef(-1) }
    st := body != -1 && kind(mut az, body) == ast.BStruct
    fs := if st { desugar.ListRef(node(mut az, body).a) } else { desugar.ListRef(-1) }
    mut v := lsNone()
    for i <- iter.Range(0, desugar.LenL(mut az.d, els)) {
        el := node(mut az, nat(mut az, els, i))
        m := sv(mut az, desugar.NodeRef(el.b))
        fname := if el.a == -1 && st && i < desugar.LenL(mut az.d, fs) { desugar.StrRef(node(mut az, nat(mut az, fs, i)).a) } else { desugar.StrRef(el.a) }
        q := if st && fname != -1 { svField(mut az, desugar.NodeRef(r.idx), fname) } else { -1 }
        if q != -1 {
            addSlot(mut az, az.sv.flBase + q, svConcrete(mut az, m))
        } else {
            v = lsOr(v, m)
        }
    }
    return v
}

// ラムダ: 仮引数は F の値なら F の仮引数のスロット・借りなら同じ呼び出しの他の実引数（lamIn）。値 = 本体の値
func svLambda(az mut Az, e desugar.NodeRef, x ast.Node) LSet {
    ps := desugar.ListRef(x.a)
    key := desugar.LamKey(mut az.d, e)
    for i <- iter.Range(0, desugar.LenL(mut az.d, ps)) {
        pv := if key != -1 { svFnParam(mut az, key, i) } else { az.sv.lamIn }
        envAdd(mut az, desugar.StrRef(node(mut az, nat(mut az, ps, i)).a), pv)
    }
    body := desugar.NodeRef(x.b)
    bk := kind(mut az, body)
    li := az.sv.lamIn
    az.sv.lamIn = lsNone()
    eh := az.sv.effHit
    az.sv.effHit = false
    v := if bk == ast.EBlock || bk == ast.KBlock { svBlock(mut az, body) } else { sv(mut az, body) }
    az.sv.lamIn = li
    // 出所: 本体が源に届いたラムダの値は C を持つ
    hit := az.sv.effHit
    az.sv.effHit = eh || hit
    return if az.sv.og && hit { lsOr(v, svAtom(az.sv.catom)) } else { v }
}

// 名前付き関数型の型宣言 key の仮引数 j のスロットの値（項が無ければ ∅）
func svFnParam(az mut Az, key int, j int) LSet {
    i := svDeclAt(mut az, key)
    if table.Get(mut az.sv.hk, i * 3) == 0 || j >= table.Get(mut az.sv.hk, i * 3 + 2) {
        return lsNone()
    }
    return readSlot(mut az, az.sv.flBase + table.Get(mut az.sv.hk, i * 3 + 1) + j)
}

// 名前付き関数型 key の値の呼び出しの実引数 j の値を F の仮引数のスロットへ
func svFnArg(az mut Az, key int, j int, v LSet) {
    i := svDeclAt(mut az, key)
    if table.Get(mut az.sv.hk, i * 3) != 0 && j < table.Get(mut az.sv.hk, i * 3 + 2) {
        addSlot(mut az, az.sv.flBase + table.Get(mut az.sv.hk, i * 3 + 1) + j, svConcrete(mut az, v))
    }
}

// switch: subject は sink・束縛は subject の値・値は腕の合併
func svSwitch(az mut Az, x ast.Node) LSet {
    subs := desugar.ListRef(x.a)
    S := svList(mut az, subs)
    if desugar.LenL(mut az.d, subs) > 0 {
        svSink(mut az, S, nat(mut az, subs, 0), SkSwitch, SkSwitch)
    }
    cs := desugar.ListRef(x.b)
    mut v := lsNone()
    for i <- iter.Range(0, desugar.LenL(mut az.d, cs)) {
        c := node(mut az, nat(mut az, cs, i))
        ps := desugar.ListRef(c.a)
        for j <- iter.Range(0, desugar.LenL(mut az.d, ps)) {
            svBind(mut az, nat(mut az, ps, j), S)
        }
        v = lsOr(v, svBlock(mut az, desugar.NodeRef(c.b)))
    }
    return lsOr(v, svBlock(mut az, desugar.NodeRef(x.c)))
}

// パターン p の中の束縛の名前へ subject の値 S（定数の選択肢の式は歩く）
func svBind(az mut Az, p desugar.NodeRef, S LSet) {
    if p == -1 {
        return
    }
    x := node(mut az, p)
    if x.kind == ast.KPType {
        envAdd(mut az, desugar.StrRef(x.a), S)
        fps := desugar.ListRef(x.c)
        if fps != -1 {
            for i <- iter.Range(0, desugar.LenL(mut az.d, fps)) {
                fp := node(mut az, nat(mut az, fps, i))
                if fp.b == -1 {
                    envAdd(mut az, desugar.StrRef(fp.a), S)
                } else {
                    svBind(mut az, desugar.NodeRef(fp.b), S)
                }
            }
        }
    } else if x.kind == ast.KPConst {
        alts := desugar.ListRef(x.a)
        for q <- iter.Range(0, desugar.LenL(mut az.d, alts)) {
            a := nat(mut az, alts, q)
            if kind(mut az, a) == ast.EIdent && envFind(mut az, desugar.StrRef(node(mut az, a).a)) == -1 && paramIdx(mut az, desugar.StrRef(node(mut az, a).a)) == -1 &&
                desugar.ResolveTop(mut az.d, az.pk, desugar.StrRef(node(mut az, a).a), false, desugar.TopAll).kind == desugar.TopNone {
                // 裸の識別子は未知なら束縛（syntax.md 9 節）
                envAdd(mut az, desugar.StrRef(node(mut az, a).a), S)
            } else {
                sv(mut az, a)
            }
        }
    }
}

// for: 生成元の値（呼び出しなら結果と実引数の合併）が要素の名前へ・ガードは sink・値は yield の式
func svFor(az mut Az, x ast.Node) LSet {
    gs := desugar.ListRef(x.a)
    for i <- iter.Range(0, desugar.LenL(mut az.d, gs)) {
        g := node(mut az, nat(mut az, gs, i))
        src := desugar.NodeRef(g.b)
        sk := kind(mut az, src)
        gv := sv(mut az, src)
        av := if sk == ast.ECall { svList(mut az, desugar.ListRef(node(mut az, src).b)) } else { lsNone() }
        ns := desugar.ListRef(g.a)
        for j <- iter.Range(0, desugar.LenL(mut az.d, ns)) {
            envAdd(mut az, desugar.StrRef(desugar.LatI(mut az.d, ns, j)), lsOr(gv, av))
        }
        gl := desugar.ListRef(g.c)
        for j <- iter.Range(0, desugar.LenL(mut az.d, gl)) {
            gd := nat(mut az, gl, j)
            svSink(mut az, sv(mut az, gd), gd, SkCond, SkCond)
        }
    }
    if x.b == 0 {
        return sv(mut az, desugar.NodeRef(x.c))
    }
    stmts := desugar.ListRef(x.c)
    for i <- iter.Range(0, desugar.LenL(mut az.d, stmts)) {
        svStmt(mut az, nat(mut az, stmts, i))
    }
    return lsNone()
}

// 呼び出し callee(args)（pipe なら左辺 lhs が穴 -1 の位置か先頭）の値
func svCall(az mut Az, e desugar.NodeRef, callee desugar.NodeRef, args desugar.ListRef, lhs desugar.NodeRef) LSet {
    fi := calleeFn(mut az, callee)
    bnd := az.sv.bind
    az.sv.bind = false
    n := desugar.LenL(mut az.d, args)
    mut hole := false
    for i <- iter.Range(0, n) {
        if nat(mut az, args, i) == -1 {
            hole = true
        }
    }
    // 実引数の並び（仮引数の位置 — pipe の左辺は穴か先頭）。ラムダは後で歩く（仮引数 = 他の実引数の合併）
    mut an := mut []desugar.NodeRef{}
    if lhs != -1 && !hole {
        an = append(an, lhs)
    }
    for i <- iter.Range(0, n) {
        a := nat(mut az, args, i)
        an = append(an, if a == -1 { lhs } else { a })
    }
    mut av := mut []LSet{}
    mut u := lsNone()
    nd := az.sv.nodump
    for i <- iter.Range(0, len(an)) {
        lam := an[i] != -1 && kind(mut az, an[i]) == ast.ELambda
        // 名前の根の道の実引数は丸ごとの値（道の表は呼び先の欄のビットが実引数の道で読む — 吐かない）
        mut ap := false
        if fi >= 0 && !lam {
            r0, _, _, _ := svAPOf(mut az, an[i])
            ap = r0 != -1
        }
        az.sv.nodump = nd || ap
        v := if lam { lsNone() } else { sv(mut az, an[i]) }
        az.sv.nodump = nd
        av = append(av, v)
        u = lsOr(u, v)
    }
    li := az.sv.lamIn
    az.sv.lamIn = u
    for i <- iter.Range(0, len(an)) {
        if an[i] != -1 && kind(mut az, an[i]) == ast.ELambda {
            av[i] = sv(mut az, an[i])
        }
    }
    az.sv.lamIn = li
    svTouch(mut az, u)
    fa := freeze(an)
    fv := freeze(av)
    if fi == -1 {
        // 組み込み・変換・型の構築: len / cap と std の `@intrinsic`（番地・syscall の結果・専用命令の状態 — 中身の書き込みは解析の外）は公開の値、他は実引数を運ぶ
        cn := if kind(mut az, callee) == ast.EIdent { desugar.StrRef(node(mut az, callee).a) } else { desugar.StrRef(-1) }
        sk := if cn != -1 { desugar.SysKey(mut az.d, az.pk, cn) } else { 0 }
        pub := cn != -1 && (desugar.StrIs(mut az.d, cn, "len") || desugar.StrIs(mut az.d, cn, "cap") || sk > 0)
        if sk == loader.IMatchLen || sk == loader.IJClean {
            // 可変時間の組み込み（matchlen・jclean）: 実引数（列・位置・長さ）は全部 sink（std の binary.MatchLen / json の quote の仮引数に Sink が立ち、秘密を渡す呼び手が拒否される）
            for i <- iter.Range(0, len(fv)) {
                svSink(mut az, fv[i], if fa[i] == -1 { e } else { fa[i] }, if sk == loader.IJClean { SkVarJ } else { SkVar }, if sk == loader.IJClean { SkVarJ } else { SkVar })
            }
        }
        mut r1 := lsNone()
        for i <- iter.Range(0, len(fv)) {
            r1 = lsOr(r1, fv[i])
        }
        svMres1(mut az, if pub { lsNone() } else { r1 })
        az.sv.malN = 0
        return if pub { lsNone() } else { r1 }
    }
    if fi == -2 {
        // 関数値の呼び出し: 関数値の値 ∪ 実引数。名前付き関数型の値なら実引数を F の仮引数のスロットへ
        mut r2 := sv(mut az, callee)
        if az.sv.og && (r2.lo & (1 << az.sv.catom)) != 0 {
            ogEff(mut az)
        }
        key := desugar.FnTypeOf(mut az.d, callee)
        for i <- iter.Range(0, len(fv)) {
            r2 = lsOr(r2, fv[i])
            if key != -1 {
                svFnArg(mut az, key, i, fv[i])
            }
        }
        svMres1(mut az, r2)
        az.sv.malN = 0
        return r2
    }
    np := svNParams(mut az, fi)
    pb := table.Get(mut az.sv.pbase, fi)
    sinks := readSlot(mut az, az.sv.sinkBase + fi).lo
    for j <- iter.Range(0, if len(fv) < np { len(fv) } else { np }) {
        // Pin（文脈に鈍い）には実引数の道の表の中身も
        r, a, _, _ := svAPOf(mut az, fa[j])
        addSlot(mut az, az.sv.pinBase + pb + j, svConcrete(mut az, if r != -1 { lsOr(fv[j], svApSub(mut az, r, a)) } else { fv[j] }))
    }
    // 道の Pin へ実引数のその道
    mut ip := table.Get(mut az.sv.fmh, fi)
    while ip != -1 {
        ps := table.Get(mut az.sv.fm, ip + 5)
        jp := table.Get(mut az.sv.fm, ip)
        if ps != -1 && jp < len(fv) {
            addSlot(mut az, ps, svConcrete(mut az, svApArg(mut az, fa[jp], fv[jp], desugar.StrRef(table.Get(mut az.sv.fm, ip + 1)), desugar.StrRef(table.Get(mut az.sv.fm, ip + 2)))))
        }
        ip = table.Get(mut az.sv.fm, ip + 6)
    }
    // sink に届く仮引数（欄のビットなら実引数のその欄）
    for b <- iter.Range(0, if sinks != 0 { PBITS } else { 0 }) {
        if (sinks & (1 << b)) != 0 {
            j, it := svBitJ(mut az, fi, b)
            if j != -1 && j < len(fv) {
                v := if it == -1 { fv[j] } else { svApArg(mut az, fa[j], fv[j], desugar.StrRef(table.Get(mut az.sv.fm, it + 1)), desugar.StrRef(table.Get(mut az.sv.fm, it + 2))) }
                svSink(mut az, v, if fa[j] == -1 { e } else { fa[j] }, SkCall, fi * 64 + j)
            }
        }
    }
    // 結果の位置ごと: Res の S ∪ Res の P の位置の実引数（`@bless` は ∅ — 出所の名前空間は `@bless(origin)` も）
    bless := if az.sv.og { desugar.FuncBlessOrigin(mut az.d, fnDecl(mut az, fi)) } else { desugar.FuncBless(mut az.d, fnDecl(mut az, fi)) }
    if az.sv.og {
        ogCall(mut az, e, fi, fv)
    }
    rs := desugar.ListRef(fnDecl(mut az, fi).d)
    mut rv := mut []LSet{}
    mut r := lsNone()
    az.sv.malN = 0
    for i <- iter.Range(0, svNRes(mut az, fi)) {
        res := readSlot(mut az, svRes(mut az, fi, i))
        mut ri := svInst(mut az, fi, res, fa, fv, if bnd && !bless { i } else { -1 })
        if bless {
            ri = lsNone()
        }
        if az.sv.og && table.Get(mut az.sv.credf, fi) != -1 {
            // `@credential` の結果は源
            ri = lsOr(ri, svAtom(table.Get(mut az.sv.credf, fi)))
        }
        rv = append(rv, ri)
        r = lsOr(r, ri)
    }
    // 別名の候補は書き戻しの中の呼び出しが上書きするので写して最後に戻す
    mut cands := mut []int{}
    for i <- iter.Range(0, az.sv.malN) {
        cands = append(cands, table.Get(mut az.sv.mal, i))
    }
    // mut の仮引数へ書いた値を呼び手の実引数へ
    for j <- iter.Range(0, if len(fv) < np { len(fv) } else { np }) {
        mo := readSlot(mut az, az.sv.pinBase + az.sv.npar + pb + j)
        if !lsEmpty(mo) && fa[j] != -1 {
            svWriteArg(mut az, fa[j], desugar.StrRef(-1), desugar.StrRef(-1), svInst(mut az, fi, mo, fa, fv, -1))
        }
    }
    // mut の仮引数の道へ書いた値を呼び手の実引数の道へ（文脈欄）
    mut it := table.Get(mut az.sv.fmh, fi)
    while it != -1 {
        ms := table.Get(mut az.sv.fm, it + 4)
        j := table.Get(mut az.sv.fm, it)
        if ms != -1 && j < len(fa) && fa[j] != -1 {
            mo := readSlot(mut az, ms)
            if !lsEmpty(mo) {
                svWriteArg(mut az, fa[j], desugar.StrRef(table.Get(mut az.sv.fm, it + 1)), desugar.StrRef(table.Get(mut az.sv.fm, it + 2)), svInst(mut az, fi, mo, fa, fv, -1))
            }
        }
        it = table.Get(mut az.sv.fm, it + 6)
    }
    az.sv.malN = 0
    for i <- iter.Range(0, len(cands)) {
        svMalPut(mut az, cands[i])
    }
    // 結果の値の列は最後に組む（mut の書き戻しの中の呼び出しが上書きする）
    az.sv.mresN = 0
    for i <- iter.Range(0, len(rv)) {
        svMresPut(mut az, rv[i], if i < desugar.LenL(mut az.d, rs) && isErrTy(mut az, nat(mut az, rs, i)) { 1 } else { 0 })
    }
    return r
}

// ── 文面 ──

// 原子 a の綴り（-1 = TOP）
func svSrc(az mut Az, a int) string {
    if a < 0 || a * 3 >= table.Len(mut az.sv.atoms) {
        return "a secret value"
    }
    k := table.Get(mut az.sv.atoms, a * 3)
    x := table.Get(mut az.sv.atoms, a * 3 + 1)
    y := table.Get(mut az.sv.atoms, a * 3 + 2)
    if k == 0 {
        p := node(mut az, nat(mut az, desugar.ListRef(fnDecl(mut az, x).c), y))
        return "the @secret parameter '${str(mut az, desugar.StrRef(p.a))}' of '${fnName(mut az, x)}'"
    }
    if k == 1 {
        td := node(mut az, desugar.NodeRef(table.Get(mut az.sv.fl, x * 3)))
        return "the @secret field '${str(mut az, desugar.StrRef(td.a))}.${str(mut az, desugar.StrRef(table.Get(mut az.sv.fl, x * 3 + 1)))}'"
    }
    return "the @secret const '${str(mut az, desugar.StrRef(node(mut az, desugar.NodeRef(x)).a))}'"
}

func svWhat(k int) string {
    return switch k {
    case SkCond: "a branch condition"
    case SkSwitch: "a switch subject"
    case SkAndOr: "the left side of && / ||"
    case SkIndex: "an index or map key"
    case SkSlice: "a slice bound"
    case SkDiv: "a division (`/` or `%`)"
    case SkVar: "a variable-time comparison (`binary.MatchLen` — it stops at the first mismatch)"
    case SkVarJ: "a variable-time scan (JSON string escaping — it stops at the first byte to escape)"
    case _: "a call that does"
    }
}

// 違反の記録 i の本文（note = 呼び先の中の sink の注）
func svMessage(az mut Az, i int, note bool) string {
    k := table.Get(mut az.sv.viol, i * 4 + 1)
    x := table.Get(mut az.sv.viol, i * 4 + 2)
    src := svSrc(mut az, table.Get(mut az.sv.viol, i * 4 + 3))
    why := "its timing would reveal the secret (language.md 12 節「秘密の値の宣言」)"
    if k != SkCall {
        return "a value derived from ${src} reaches ${svWhat(k)} — ${why}"
    }
    g := x / 64
    j := x % 64
    pn := str(mut az, desugar.StrRef(node(mut az, nat(mut az, desugar.ListRef(fnDecl(mut az, g).c), j)).a))
    ik := table.Get(mut az.sv.sinkK, table.Get(mut az.sv.pbase, g) + j)
    if note {
        return "note: '${fnName(mut az, g)}' uses its parameter '${pn}' in ${svWhat(ik)}${if ik == SkCall { " (on a secret)" } else { "" }} here"
    }
    return "a value derived from ${src} is passed as '${pn}' of '${fnName(mut az, g)}', which uses it in ${svWhat(ik)}${if ik == SkCall { " (on a secret)" } else { "" }} — ${why}"
}

// `@secret(…)` の項の指摘の本文
func svAnnMessage(az mut Az, fd desugar.NodeRef, j int) string {
    l, t := desugar.FuncSecret(mut az.d, node(mut az, fd))
    item := str(mut az, desugar.StrRef(desugar.LatI(mut az.d, l, j)))
    return "@secret lists the parameters that hold secrets: '${item}' is not a parameter of '${str(mut az, desugar.StrRef(node(mut az, fd).a))}'"
}

// 秘密の値の流れの導出（開発用 `check --secret-dump`）: 表 T（秘密の値〔仮引数は全呼び手の実引数で文脈に鈍く読む〕を
// 演算子・添字・呼び出しの実引数に使う関数 — ctcheck の関数の表と照合する）を 1 関数 1 行、秘密を持つ欄のスロットを 1 欄 1 行、違反を 1 件 1 行、最後に要約（位置の無い 1 行）。源の無い木では表は空
func SecretDump(p loader.Program) []Finding {
    mut az := Az{d: desugar.S{}, pk: 0, out: table.Table[int]{}, ok: table.Table[int]{}, nfn: 0, nerr: 0, er: Eng{sets: table.Table[int]{}, rhead: table.Table[int]{}, rnode: table.Table[int]{}, work: table.Table[int]{}, inq: table.Table[int]{}, env: table.Table[int]{}, envN: 0, envChanged: false},
        pbase: table.Table[int]{}, errfn: table.Table[int]{},
        ffield: table.Table[int]{}, cur: 0, rec: false, sw: table.Table[int]{}, unknown: 0, walks: 0, declared: table.Table[int]{}, swpk: table.Table[int]{}, swarms: table.Table[int]{}, lit: table.Table[int]{}, wins: table.Table[int]{}, winN: 0, winBase: 0, flowBase: 0, cand: table.Table[int]{}, dflow: table.Table[int]{}, exsw: table.Table[int]{}, trySink: 0, lamf: table.Table[int]{}, lamFN: 0, lamBase: 0, lamCand: 0, lamck: table.Table[int]{}, sv: Sv{on: false, rec: false, natom: 0, atoms: table.Table[int]{}, resBase: 0, sinkBase: 0, pbase: table.Table[int]{}, npar: 0, pinBase: 0, secp: table.Table[int]{}, rpos: table.Table[int]{}, nres: 0, mres: table.Table[int]{}, mresN: 0, sinkAt: table.Table[int]{}, sinkK: table.Table[int]{}, fl: table.Table[int]{}, flBase: 0, hk: table.Table[int]{}, cons: table.Table[int]{}, lamIn: LSet{lo: 0, hi: 0}, viol: table.Table[int]{}, walks: 0, touch: table.Table[int]{}, pe: table.Table[int]{}, peN: 0, al: table.Table[int]{}, alN: 0, fmh: table.Table[int]{}, fm: table.Table[int]{}, fbn: table.Table[int]{}, mal: table.Table[int]{}, malN: 0, nodump: false, bind: false, og: false, effBase: 0, effHit: false, catom: -1, shMask: 0, oMask: 0, mountFn: -1, shv: table.Table[int]{}, shf: table.Table[int]{}, ftn: table.Table[int]{}, ov: table.Table[int]{}, credf: table.Table[int]{}}, ef: Ef{n: 0, nk: table.Table[int]{}, nref: table.Table[int]{}, bits: table.Table[int]{}, e: table.Table[int]{}, fnodes: table.Table[int]{}, fn: 0, cur: 0, lp: table.Table[int]{}, lpN: 0, lb: table.Table[int]{}, lbN: 0, addr: table.Table[int]{}, flam: table.Table[int]{}, viol: table.Table[int]{}, anyCalls: 0, ek: table.Table[int]{}, own: table.Table[int]{}, tm: table.Table[int]{}, tdecl: table.Table[int]{}, te: table.Table[int]{}, ekind: 0, tst: table.Table[int]{}}}
    desugar.Typed(mut az.d, p)
    errInit(mut az)
    errSolve(mut az)
    svInit(mut az)
    svSolve(mut az)
    mut fs := mut []Finding{}
    mut nt := 0
    for fi <- iter.Range(0, if az.sv.on { az.nfn } else { 0 }) {
        if table.Get(mut az.sv.touch, fi) != 0 {
            nt += 1
            fs = append(fs, Finding{warn: false, at: desugar.PosOf(mut az.d, desugar.FnAt(mut az.d, fi).node), what: "secret ${fnName(mut az, fi)}"})
        }
    }
    // 秘密を持つ欄のスロット（型 × 名前 — 文脈に鈍い合併。名前付き関数型の仮引数の項は名前なし）
    mut nf := 0
    for q <- iter.Range(0, if az.sv.on { table.Len(mut az.sv.fl) / 3 } else { 0 }) {
        v := slotGet(mut az, az.sv.flBase + q)
        nm := desugar.StrRef(table.Get(mut az.sv.fl, q * 3 + 1))
        if svSecret(v) && nm != -1 {
            nf += 1
            td := desugar.NodeRef(table.Get(mut az.sv.fl, q * 3))
            fs = append(fs, Finding{warn: false, at: desugar.PosOf(mut az.d, td), what: "field ${str(mut az, desugar.StrRef(node(mut az, td).a))}.${str(mut az, nm)} from ${svSrc(mut az, svFirst(v))}"})
        }
    }
    mut nv := 0
    for i <- iter.Range(0, table.Len(mut az.out) / 3) {
        if table.Get(mut az.out, i * 3) == MSecSink {
            nv += 1
            at := desugar.NodeRef(table.Get(mut az.out, i * 3 + 1))
            fs = append(fs, Finding{warn: false, at: desugar.PosOf(mut az.d, at), what: "violation ${svMessage(mut az, table.Get(mut az.out, i * 3 + 2), false)}"})
        }
    }
    fs = append(fs, Finding{warn: false, at: diag.None(), what: "summary atoms=${az.sv.natom} secret-fns=${nt} secret-fields=${nf} violations=${nv} walks=${az.sv.walks}"})
    return freeze(fs)
}
