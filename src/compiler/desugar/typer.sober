package desugar

// 表層型検査器（C1 B1・D1 = α・D6 = 抽象で 1 回・D7 = 元の節をキー）。
// 関数本体ごとに 1 回、表層 AST の式に表層型を付けて節をキーの表に残す（ジェネリクスは型変数のまま）。
// 今は影で動かすだけ — 消費者は無い。lower の `--typer-diff`（lower.TyperDiff）が式ごとに lower の型と突き合わせて不一致を数える。
// 型が決まらない式は表に載せない（-1 = 不明）。断片を広げるのは不一致 0 を保ったまま

import "ast"
import "lexer"
import "std/io"
import "std/iter"
import "std/os"
import "std/table"

// 表層型（st.ytys の添字。-1 = 不明）。列は店の列（tystore.sober — YLBASE + 添字）。作業の列（記録が指さないもの）はヒープの列（listN）
const YInt = 1
const YBool = 2
const YString = 3
const YNone = 4    // 値なし（文・0 個の結果）
const YNever = 5   // 戻らない（return / break / continue で終わるブロック）
const YNil = 6
const YErr = 7     // error
const YSlice = 8   // a = 要素, b = mut（0 / 1）
const YMap = 9     // a = キー, b = 値, c = mut
const YOpt = 10    // a = 中身
const YDecl = 11   // 型宣言（struct / union / named scalar / 名前付き関数型）: a = 型宣言の節, b = package, c = 型引数の列（-1 = 無し）
const YFn = 12     // 関数値: a = 仮引数の型の列, b = 結果の型の列, c = 名前付き関数型の型宣言の節 + 1（名前なしは0 - mut仮引数のビット）
const YTuple = 13  // 多値（2 個以上の結果）: a = 型の列
const YVar = 14    // 型パラメータ: a = 添字（関数か型宣言の型パラメータの列の中）, b = 名前（文字列）
const YLabel = 15  // error ラベルのリテラルの値（error へは受け手で包む — lower のラベルの union）
const YFloat = 17  // float（language.md 37 節 — 記録は TypeAll が YByte の直後に積む = 添字 yFloat()）
const YByte = 16   // byte（language.md 33 節 — 基本の型の後で足した種類。記録は TypeAll が基本の型の直後に積む = 添字 yByte()）

type YT struct {
    k int
    a int
    b int
    c int
}

// 検査器の局所の束縛（親のチェーン）
type YBind struct {
    parent int
    name StrRef
    ty int
    clo bool   // クロージャの名前（展開される関数の関数型の仮引数 — lowerのLClosure）
    lam int    // 局所の束縛のラムダの節（`f := (…) => …` — 使用の点で本体を型付けする）。他は -1
}

// 表の記録（節 → 型のチェーンつきハッシュ）
type YEnt struct {
    key int
    ty int
    next int
}

const YBUCKETS = 65536

// 表層型 y の記録（lower が読む）
func YAt(st mut S, y int) YT {
    return table.Get(mut st.ty.ytys, y)
}

// ybindAt / yentAt は記録（非ジェネリックの包み — F-10）
func ybindAt(st mut S, b int) YBind {
    return table.Get(mut st.ty.ybinds, b)
}

func yentAt(st mut S, i int) YEnt {
    return table.Get(mut st.ty.yents, i)
}

func yMk(st mut S, k int, a int, b int, c int) int {
    at := table.Len(mut st.ty.ytys)
    table.Push(mut st.ty.ytys, YT{k: k, a: a, b: b, c: c})
    return at
}

// 基本の型（TypeAll の先頭で種類の順に積んだもの — YInt〜YErr は添字 = 種類 - 1）
func yBase(k int) int {
    return k - 1
}

// byte の記録の添字（TypeAll が YErr の記録の直後に積む）
func yByte() int {
    return YErr
}

// float の記録の添字（TypeAll が byte の記録の直後に積む）
func yFloat() int {
    return YErr + 1
}

func yk(st mut S, y int) int {
    return if y < 0 { -1 } else { YAt(mut st, y).k }
}

// yLa / yLb / yLc / yNaは表層型の記録のフィールドを列・節として読む（フィールドの意味は種類ごと — 上の表）
func yLa(x YT) ListRef {
    return ListRef(x.a)
}

func yLb(x YT) ListRef {
    return ListRef(x.b)
}

func yLc(x YT) ListRef {
    return ListRef(x.c)
}

func yNa(x YT) NodeRef {
    return NodeRef(x.a)
}

// yDecl / yFnT / yTupleは節・列をフィールドに持つ種類の構築子
func yDecl(st mut S, decl NodeRef, pk int, targs ListRef) int {
    return yMk(mut st, YDecl, int(decl), pk, int(targs))
}

func yFnT(st mut S, ps ListRef, rs ListRef, td int) int {
    return yMk(mut st, YFn, int(ps), int(rs), td)
}

func yTuple(st mut S, l ListRef) int {
    return yMk(mut st, YTuple, int(l), 0, 0)
}

// ── 表 ──

func yHash(st mut S, e int) int {
    return (e % 1000003 + 1000003) % 1000003 % bucketsOf(st.hbuckets)
}

func yPut(st mut S, e int, y int) {
    h := yHash(mut st, e)
    table.Push(mut st.ty.yents, YEnt{key: e, ty: y, next: table.Get(mut st.ty.ybucket, h)})
    table.Set(mut st.ty.ybucket, h, table.Len(mut st.ty.yents) - 1)
}

// 節 e の表層型（表に無ければ -1）
func YTypeOf(st mut S, e NodeRef) int {
    return yGet(mut st, int(e))
}

// 表の鍵 key（節の参照か、別キー 0 - 1 - 節 — 呼び出しの型引数・for の yield の型）の表層型
func yGet(st mut S, key int) int {
    if table.Len(mut st.ty.ybucket) == 0 {
        return -1
    }
    mut i := table.Get(mut st.ty.ybucket, yHash(mut st, key))
    while i != -1 {
        x := yentAt(mut st, i)
        if x.key == key {
            return x.ty
        }
        i = x.next
    }
    return -1
}

// ── 局所の束縛 ──

func yBindName(st mut S, name StrRef, y int) {
    at := table.Len(mut st.ty.ybinds)
    table.Push(mut st.ty.ybinds, YBind{parent: st.yenv, name: name, ty: y, clo: false, lam: -1})
    st.yenv = at
}

// クロージャの名前を積む
func yBindClo(st mut S, name StrRef, y int) {
    at := table.Len(mut st.ty.ybinds)
    table.Push(mut st.ty.ybinds, YBind{parent: st.yenv, name: name, ty: y, clo: true, lam: -1})
    st.yenv = at
}

// 局所の名前がクロージャの名前か
func yIsClo(st mut S, name StrRef) bool {
    mut b := st.yenv
    while b != -1 {
        x := ybindAt(mut st, b)
        if strEq(mut st, x.name, name) {
            return x.clo
        }
        b = x.parent
    }
    return false
}

// 局所の名前（見つからなければ -2、見つかって型が不明なら -1）
// 局所の束縛のラムダを積む（型は持たない — 呼び出しの点で本体を型付けする: yLocalCall）
func yBindLam(st mut S, name StrRef, lam NodeRef) {
    st.nLocLam += 1
    at := table.Len(mut st.ty.ybinds)
    table.Push(mut st.ty.ybinds, YBind{parent: st.yenv, name: name, ty: -1, clo: true, lam: int(lam)})
    st.yenv = at
}

// 名前が局所の束縛のラムダならそのラムダの節（でなければ -1）
func yLookupLam(st mut S, name StrRef) NodeRef {
    if st.nLocLam == 0 {
        return -1
    }
    mut b := st.yenv
    while b != -1 {
        x := ybindAt(mut st, b)
        if strEq(mut st, x.name, name) {
            return NodeRef(x.lam)
        }
        b = x.parent
    }
    return -1
}

// 実引数の節 a が局所の束縛のラムダの名前ならそのラムダ、ラムダならそれ自身（でなければ -1）
func yLamArg(st mut S, a NodeRef) NodeRef {
    if a == -1 {
        return -1
    }
    k := kindN(mut st, a)
    return if k == ast.ELambda { a } else if k == ast.EIdent { yLookupLam(mut st, sA(nodeOf(mut st, a))) } else { NodeRef(-1) }
}

// 局所の束縛のラムダlamの呼び出し: 仮引数を書いた型（書かなければ実引数の型at）で束ねて本体を型付けし、本体の型を返す（脱糖器のlocalCallTyと同じ解釈）
func yLocalCall(st mut S, lam NodeRef, at ListRef) int {
    saved := st.yenv
    ps := lA(nodeOf(mut st, lam))
    for i <- iter.Range(0, lenL(mut st, ps)) {
        p := nodeOf(mut st, latN(mut st, ps, i))
        t := if nB(p) != -1 { yTe(mut st, st.ypk, st.ytps, nB(p)) } else if at != -1 && i < lenL(mut st, at) { latI(mut st, at, i) } else { -1 }
        yBindName(mut st, sA(p), t)
    }
    st.ylam += 1
    r := yExpr(mut st, nB(nodeOf(mut st, lam)))
    st.ylam -= 1
    st.yenv = saved
    return r
}

func yLookup(st mut S, name StrRef) int {
    mut b := st.yenv
    while b != -1 {
        x := ybindAt(mut st, b)
        if strEq(mut st, x.name, name) {
            return x.ty
        }
        b = x.parent
    }
    return -2
}

// ── 型の構造 ──

// 表層型の構造の一致（型宣言は節の同一性・型引数は列ごと）
func yEq(st mut S, a int, b int) bool {
    if a == b {
        return true
    }
    if a < 0 || b < 0 {
        return false
    }
    x := YAt(mut st, a)
    y := YAt(mut st, b)
    if x.k != y.k {
        return false
    }
    return switch x.k {
    case YSlice | YOpt: x.b == y.b && yEq(mut st, x.a, y.a)
    case YMap: x.c == y.c && yEq(mut st, x.a, y.a) && yEq(mut st, x.b, y.b)
    case YDecl: x.a == y.a && yListEq(mut st, yLc(x), yLc(y))
    case YFn: yListEq(mut st, yLa(x), yLa(y)) && yListEq(mut st, yLb(x), yLb(y))
    case YTuple: yListEq(mut st, yLa(x), yLa(y))
    case YVar: x.a == y.a
    default: true
    }
}

func yListEq(st mut S, a ListRef, b ListRef) bool {
    if a == b {
        return true
    }
    if a == -1 || b == -1 || lenL(mut st, a) != lenL(mut st, b) {
        return false
    }
    for i <- iter.Range(0, lenL(mut st, a)) {
        if !yEq(mut st, latI(mut st, a, i), latI(mut st, b, i)) {
            return false
        }
    }
    return true
}

// 表層型 y が型パラメータを含むか（不明も含むと数える）
func YHasVar(st mut S, y int) bool {
    if y < 0 {
        return true
    }
    x := YAt(mut st, y)
    return switch x.k {
    case YVar: true
    case YSlice | YOpt: YHasVar(mut st, x.a)
    case YMap: YHasVar(mut st, x.a) || YHasVar(mut st, x.b)
    case YDecl: x.c >= 0 && yListHasVar(mut st, yLc(x))
    case YFn: yListHasVar(mut st, yLa(x)) || yListHasVar(mut st, yLb(x))
    case YTuple: yListHasVar(mut st, yLa(x))
    default: false
    }
}

// 表層型 y に不明（-1）の成分があるか
func YHasHole(st mut S, y int) bool {
    if y < 0 {
        return true
    }
    x := YAt(mut st, y)
    return switch x.k {
    case YSlice | YOpt: YHasHole(mut st, x.a)
    case YMap: YHasHole(mut st, x.a) || YHasHole(mut st, x.b)
    case YDecl: x.c >= 0 && yListHasHole(mut st, yLc(x))
    case YFn: yListHasHole(mut st, yLa(x)) || yListHasHole(mut st, yLb(x))
    case YTuple: yListHasHole(mut st, yLa(x))
    default: false
    }
}

func yListHasHole(st mut S, l ListRef) bool {
    for i <- iter.Range(0, lenL(mut st, l)) {
        if YHasHole(mut st, latI(mut st, l, i)) {
            return true
        }
    }
    return false
}

func yListHasVar(st mut S, l ListRef) bool {
    for i <- iter.Range(0, lenL(mut st, l)) {
        if YHasVar(mut st, latI(mut st, l, i)) {
            return true
        }
    }
    return false
}

// 型パラメータ YVar(i) を args の i 番に置き換える（args = -1 なら置き換えない）
func ySubst(st mut S, y int, args ListRef) int {
    if y < 0 || args == -1 {
        return y
    }
    x := YAt(mut st, y)
    switch x.k {
    case YVar:
        return if x.a < lenL(mut st, args) { latI(mut st, args, x.a) } else { -1 }
    case YSlice | YOpt:
        a := ySubst(mut st, x.a, args)
        return if a == x.a { y } else if a < 0 { -1 } else { yMk(mut st, x.k, a, x.b, x.c) }
    case YMap:
        a := ySubst(mut st, x.a, args)
        b := ySubst(mut st, x.b, args)
        return if a == x.a && b == x.b { y } else if a < 0 || b < 0 { -1 } else { yMk(mut st, YMap, a, b, x.c) }
    }
    if x.k == YDecl && x.c >= 0 {
        return yDecl(mut st, yNa(x), x.b, ySubstList(mut st, yLc(x), args))
    }
    if x.k == YFn {
        // 名前付き関数型の型宣言（c）は代入で変わらない（名前付き実引数はフィールド・型引数つきの値の呼び先から引く — namedval.sober）
        return yFnT(mut st, ySubstList(mut st, yLa(x), args), ySubstList(mut st, yLb(x), args), x.c)
    }
    if x.k == YTuple {
        return yTuple(mut st, ySubstList(mut st, yLa(x), args))
    }
    return y
}

func ySubstList(st mut S, l ListRef, args ListRef) ListRef {
    n := lenL(mut st, l)
    out := ylN(mut st, n)
    for i <- iter.Range(0, n) {
        yput(mut st, out, i, ySubst(mut st, latI(mut st, l, i), args))
    }
    return out
}

// ── 型式 → 表層型 ──

// 型式 te（package pk の文脈・型パラメータ名の列 tps — -1 = 無し）の表層型
func yTe(st mut S, pk int, tps ListRef, te NodeRef) int {
    if te == -1 {
        return -1
    }
    k := kindN(mut st, te)
    if k == ast.TName {
        return yTName(mut st, pk, tps, sA(nodeOf(mut st, te)))
    }
    return yTe2(mut st, pk, tps, te, k)
}

// 型名 n（"N" か "ref.N"）の表層型
func yTName(st mut S, pk int, tps ListRef, n StrRef) int {
    if strIs(mut st, n, "int") {
        return yBase(YInt)
    }
    if strIs(mut st, n, "bool") {
        return yBase(YBool)
    }
    if strIs(mut st, n, "byte") {
        return yByte()
    }
    if strIs(mut st, n, "float") {
        return yFloat()
    }
    if strIs(mut st, n, "string") {
        return yBase(YString)
    }
    if strIs(mut st, n, "error") {
        return yBase(YErr)
    }
    if tps != -1 {
        for i <- iter.Range(0, lenL(mut st, tps)) {
            if strEq(mut st, latS(mut st, tps, i), n) {
                return yMk(mut st, YVar, i, latI(mut st, tps, i), 0)
            }
        }
    }
    r := ResolveType(mut st, pk, n)
    if r.kind != TopType {
        return -1
    }
    return yDecl(mut st, NodeRef(r.idx), r.pkg, -1)
}

func yTe2(st mut S, pk int, tps ListRef, te NodeRef, k int) int {
    x := nodeOf(mut st, te)
    switch k {
    case ast.TGeneric:
        r := ResolveType(mut st, pk, sA(x))
        if r.kind != TopType {
            return -1
        }
        args := yTeList(mut st, pk, tps, lB(x))
        return if args == -1 { -1 } else { yDecl(mut st, NodeRef(r.idx), r.pkg, args) }
    case ast.TTuple:
        // 多値の型（型引数の位置だけ — task.Handle[(T, error?)]・P3b 残穴1）: Spawn の単一化が型変数に束ねる多値と同じ表現
        l := yTeList(mut st, pk, tps, lA(x))
        return if l == -1 { -1 } else { yTuple(mut st, l) }
    case ast.TOpt:
        a := yTe(mut st, pk, tps, nA(x))
        return if a < 0 { -1 } else { yMk(mut st, YOpt, a, 0, 0) }
    case ast.TMutP:
        // 関数型のmut仮引数: 表層型は中身の型（mut仮引数の照合はコアの検査器とlowerの関数型の同一性 — refの型・ftMut）
        return yTe(mut st, pk, tps, nA(x))
    case ast.TSlice:
        a := yTe(mut st, pk, tps, nA(x))
        return if a < 0 { -1 } else { yMk(mut st, YSlice, a, if x.b != 0 { 1 } else { 0 }, 0) }
    case ast.TMap:
        a := yTe(mut st, pk, tps, nA(x))
        b := yTe(mut st, pk, tps, nB(x))
        return if a < 0 || b < 0 { -1 } else { yMk(mut st, YMap, a, b, if x.c != 0 { 1 } else { 0 }) }
    case ast.TFunc:
        ps := yTeList(mut st, pk, tps, lA(x))
        rs := yTeList(mut st, pk, tps, lB(x))
        // 名前付き関数型の展開の結果なら型宣言を c に（1 + 節 — 名前の区別は surface.sober の照合だけが見る）
        // 名前なしの関数型のmut仮引数はcに負で（- ビット — 名前付きは宣言の署名から読む）
        td := namedFnOf(mut st, int(te))
        return if ps == -1 || rs == -1 { -1 } else { yFnT(mut st, ps, rs, if td == -1 { 0 - teMutMask(mut st, te) } else { int(td) + 1 }) }
    }
    return -1
}

// 型式の列の表層型の列（どれか不明なら -1）
func yTeList(st mut S, pk int, tps ListRef, l ListRef) ListRef {
    n := lenL(mut st, l)
    out := ylN(mut st, n)
    for i <- iter.Range(0, n) {
        y := yTe(mut st, pk, tps, latN(mut st, l, i))
        if y < 0 {
            return -1
        }
        yput(mut st, out, i, y)
    }
    return out
}

// 結果の型の列 → 式の型（0 個 = 値なし、1 個 = その型、2 個以上 = 多値）
func yResults(st mut S, rs ListRef) int {
    if rs == -1 {
        return -1
    }
    n := lenL(mut st, rs)
    if n == 0 {
        return yBase(YNone)
    }
    if n == 1 {
        return latI(mut st, rs, 0)
    }
    return yTuple(mut st, rs)
}

// 関数表の i 番の関数値の型（ジェネリック・展開される関数は -1）
func yFnSig(st mut S, fi int) int {
    m := table.Get(mut st.ty.yfnsig, fi)
    if m != -2 {
        return m
    }
    yLate(mut st, fnPkg(mut st, fi))
    r := yFnSig0(mut st, fi)
    table.Set(mut st.ty.yfnsig, fi, r)
    return r
}

func yFnSig0(st mut S, fi int) int {
    if lenL(mut st, fnTParams(mut st, fi)) > 0 || fnExpands(mut st, fi) {
        return -1
    }
    pk := fnPkg(mut st, fi)
    ps := fnParams(mut st, fi)
    n := lenL(mut st, ps)
    pl := ylN(mut st, n)
    for i <- iter.Range(0, n) {
        y := yTe(mut st, pk, -1, nB(nodeOf(mut st, latN(mut st, ps, i))))
        if y < 0 {
            return -1
        }
        yput(mut st, pl, i, y)
    }
    rs := yTeList(mut st, pk, -1, fnResults(mut st, fi))
    return if rs == -1 { -1 } else { yFnT(mut st, pl, rs, 0) }
}

// 関数表のi番の関数を呼んだ結果の型（ジェネリックは -1 — 型引数の推論は後のフェーズ）。関数ごとに1度だけ求める
func yFnResults(st mut S, fi int) int {
    m := table.Get(mut st.ty.yfnres, fi)
    if m != -2 {
        return m
    }
    yLate(mut st, fnPkg(mut st, fi))
    r := if lenL(mut st, fnTParams(mut st, fi)) > 0 { -1 } else { yResults(mut st, yTeList(mut st, fnPkg(mut st, fi), -1, fnResults(mut st, fi))) }
    table.Set(mut st.ty.yfnres, fi, r)
    return r
}

// 型yのフィールドnameの型（structの型宣言だけ。型引数は代入する）
func yField(st mut S, y int, name StrRef) int {
    if yk(mut st, y) != YDecl || kindN(mut st, nC(nodeOf(mut st, yNa(YAt(mut st, y))))) != ast.BStruct {
        return -1
    }
    return yFieldAt(mut st, y, fieldIndex(mut st, lA(nodeOf(mut st, nC(nodeOf(mut st, yNa(YAt(mut st, y)))))), name))
}

// 型y（structの型宣言）のidx番のフィールドの型。memo（ParCheckの札・mutの中身の検査が同じ型のフィールドを何度も引く）: 型引数の
// 無い記録は型宣言 × フィールド（フィールドの型は型宣言だけで決まる）・型引数つきは記録 × フィールド（memoの値の記録をまた引けば、入れ子もそのまま当たる）
func yFieldAt(st mut S, y int, idx int) int {
    if idx < 0 || yk(mut st, y) != YDecl {
        return -1
    }
    x := YAt(mut st, y)
    body := nC(nodeOf(mut st, yNa(x)))
    if kindN(mut st, body) != ast.BStruct {
        return -1
    }
    fs := lA(nodeOf(mut st, body))
    nf := lenL(mut st, fs)
    if idx >= nf {
        return -1
    }
    // 型引数つきの鍵は型付けしている package ごと（記録を package を跨いで共有すると、区画が依存の外の区画を指す）
    c := yfmCells(mut st, if x.c < 0 { x.a } else { -1 - (y * 65536 + st.ty.ycur) }, nf) + idx
    m := table.Get(mut st.ty.yfm, c)
    if m != 0 {
        return m - 2
    }
    if x.c < 0 {
        yLate(mut st, x.b)
    }
    ft := yTe(mut st, x.b, lB(nodeOf(mut st, yNa(x))), nB(nodeOf(mut st, latN(mut st, fs, idx))))
    r := ySubst(mut st, ft, yLc(x))
    table.Set(mut st.ty.yfm, c, r + 2)
    return r
}

// ── 検査の入口 ──

// 全関数の本体に表層型を付ける（表 st.yents）。package ごとに依存の後順（tyPlan — Init と同じ順）で、① 宣言の相（関数の署名・
// 呼び出しの結果の型・const の型を先に全部求める — 呼んだ順に依らず、記録が持ち主の package の区画に積まれる）② 本体の相（本体を型付けし、
// packageの中でフラグの不動点を取る — importは非巡回なので、依存の順に回せばpackageの中だけで正確）。区画の境はst.ty.preg
func TypeAll(st mut S) {
    _ = TypeAllC(mut st, TyCacheOff())
}

// TypeAllに格納場所の切り口 γ を掛けた形（tycache.sober）: c.onならpackageの番の頭で鍵K1を組み、当たりは区画を
// 読み戻して型付けを飛ばす（c.vfy = 1は当たりでも型付けして値を書きの側へ）。外れの値はTyPutで返す（lowerが格納場所へ書く）
func TypeAllC(st mut S, c0 TyCache) TyPut {
    // 部分の型付け（届く関数だけ — 下のreach）の区画は全部の型付けの区画と違う — 格納場所を使わない
    c := if st.rangeSet || st.onlySet || st.nvSet { TyCacheOff() } else { c0 }
    if c.on {
        TyKeyOn(mut st, c.exe)
    }
    tf := if c.on && len(c.k1) > 0 { tyFnNames(mut st) } else { 0 }
    td := if c.on && len(c.k1) > 0 { tyDeclNames(mut st) } else { 0 }
    mut ppk := mut []int{}
    mut pk1 := mut []int{}
    mut pk2 := mut []int{}
    mut pvs := mut [][]byte{}
    mut bad := mut [][]byte{}
    mut nhit := 0
    mut nmiss := 0
    for k <- iter.Range(1, YErr + 1) {
        yMk(mut st, k, 0, 0, 0)
    }
    yMk(mut st, YByte, 0, 0, 0)
    yMk(mut st, YFloat, 0, 0, 0)
    for i <- iter.Range(0, bucketsOf(st.hbuckets)) {
        table.Push(mut st.ty.ybucket, -1)
    }
    for i <- iter.Range(0, st.nfn) {
        table.Push(mut st.ty.yfnres, -2)
        table.Push(mut st.ty.yfnsig, -2)
    }
    for i <- iter.Range(0, st.ncon) {
        table.Push(mut st.ty.yconty, -2)
    }
    for i <- iter.Range(0, YFMB) {
        table.Push(mut st.ty.yfmh, -1)
    }
    st.ty.ymark = int(ylN(mut st, st.nfn))
    st.yfi = -1
    st.instEnvs = -1
    st.insts = -1
    st.ty.yedges = -1
    st.ty.ydk = -1
    st.ty.ycur = st.npkg
    // 部分検査は P から届く関数だけ（reach.sober）
    // Def の区間の子は区間から届く関数だけ（rangeReach）
    // 名前付き関数型のコピーは名前付きの実引数を含む関数だけ（nvReach — namedval.sober）
    reach := if st.rangeSet { rangeReach(mut st) } else if st.onlySet { yReach(mut st) } else if st.nvSet { st.nvMark } else { ListRef(-1) }
    mut typed := 0
    mut oh := 0
    for q <- iter.Range(0, st.npkg) {
        pk := hget(mut st, st.ty.pord + 1 + q)
        flo := hget(mut st, st.ty.fo + 1 + pk)
        fhi := hget(mut st, st.ty.fo + 2 + pk)
        t0 := table.Len(mut st.ty.ytys)
        l0 := table.Len(mut st.ty.yl)
        e0 := table.Len(mut st.ty.yents)
        m0 := table.Len(mut st.ty.ylamN)
        mut hv := -1
        if st.ty.kst != 0 {
            // 型付けの前の鍵（tycanon.sober）
            tyKeyPre(mut st, pk)
            if c.on {
                hv = tyFind(c, ksAt(mut st, KSKK, pk * 2), ksAt(mut st, KSKK, pk * 2 + 1))
                if hv >= 0 {
                    nhit += 1
                } else {
                    nmiss += 1
                }
            }
        }
        if hv >= 0 && c.vfy != 1 {
            // 当たり: 区画を読み戻す（型付けの番の代わり）
            w, chk := tyValDec(c.vs[hv])
            tyRead(mut st, pk, w, tf, td)
            // 検査の飛ばし（γc — tycache.soberのGC_*）: 検査のワードのDeadlineUseのフラグを持ち越す
            gcHit(mut st, pk, chk, c.vfy == 2)
            if c.vfy == 2 && !tyAudit2(mut st, pk, w) {
                bad = append(bad, tcPathB(mut st, pk))
            }
            continue
        }
        // ① 宣言の相
        st.ty.ydk = pk
        st.ty.ycur = pk
        for j <- iter.Range(flo, fhi) {
            yDeclPre(mut st, hget(mut st, st.ty.ford + 1 + j))
        }
        yFieldsPre(mut st, pk)
        for j <- iter.Range(hget(mut st, st.ty.co + 1 + pk), hget(mut st, st.ty.co + 2 + pk)) {
            // const の初期化式（辞書 const の型・exprSty が const の名前から初期化式を見る）
            yConTy(mut st, hget(mut st, st.ty.cord + 1 + j))
        }
        st.ty.ydk = -1
        prSet(mut st, pk, PRDECL, t0, table.Len(mut st.ty.ytys))
        // ② 本体の相
        g0 := st.ty.yedges
        for j <- iter.Range(flo, fhi) {
            fi := hget(mut st, st.ty.ford + 1 + j)
            body := fnBody(mut st, fi)
            if body != -1 && (reach == -1 || latI(mut st, reach, fi) != 0) {
                st.yfi = fi
                yFunc(mut st, fi, body)
                st.yfi = -1
                typed += 1
                oh = (oh * 31 + fi + 1) % 1000000007
            }
        }
        yPropagateTo(mut st, g0)
        prSet(mut st, pk, PREDGE, st.ty.yedges, g0)
        prSet(mut st, pk, PRLAM, m0, table.Len(mut st.ty.ylamN))
        prSet(mut st, pk, PRTYS, t0, table.Len(mut st.ty.ytys))
        prSet(mut st, pk, PRYL, l0, table.Len(mut st.ty.yl))
        prSet(mut st, pk, PRENT, e0, table.Len(mut st.ty.yents))
        if st.ty.kst != 0 {
            tyKeyPost(mut st, pk)
            // フィールドの書き / 読みの記録（yfaのチェーン — 区画の外・FieldViolationsが後で読む）を足したpackageは値を書かない（当たりでチェーンが欠ける）
            if c.on && ksAt(mut st, KSST, pk * KSN + 2) == 0 {
                ppk = append(ppk, pk)
                pk1 = append(pk1, ksAt(mut st, KSKK, pk * 2))
                pk2 = append(pk2, ksAt(mut st, KSKK, pk * 2 + 1))
                pvs = append(pvs, tyValEnc(mut st, pk))
            }
        }
    }
    st.ty.ycur = st.npkg
    tySeal(mut st)
    if st.ty.ordOn != 0 {
        // 証人（オプションが効いたこと — 検査は既定の順とordの値が違うことを見る）
        _ = io.WriteStderr(bytes("#tyorder typed=${typed} ord=${oh}\n"))
    }
    return TyPut{pk: freeze(ppk), k1: freeze(pk1), k2: freeze(pk2), vs: freeze(pvs), hit: nhit, miss: nmiss, bad: freeze(bad)}
}

// 宣言の相の型宣言の分: package pk のstructのフィールドの型（型引数なしのmemo — 型宣言 × フィールド）を先に求める（区画の外から引かれても
// 持ち主の区画の記録になる — 扉〔区画をまたぐ読みの監査〕の対象）
func yFieldsPre(st mut S, pk int) {
    for f <- iter.Range(PkgFlo(mut st, pk), PkgFhi(mut st, pk)) {
        tys := lC(nodeOf(mut st, FileRoot(mut st, f)))
        for i <- iter.Range(0, lenL(mut st, tys)) {
            td := latN(mut st, tys, i)
            body := nC(nodeOf(mut st, td))
            if kindN(mut st, body) == ast.BStruct {
                nf := lenL(mut st, lA(nodeOf(mut st, body)))
                if nf > 0 {
                    y := yDecl(mut st, td, pk, -1)
                    for k <- iter.Range(0, nf) {
                        _ = yFieldAt(mut st, y, k)
                    }
                }
            }
        }
    }
}

// 宣言の相の関数 fi の分: 関数値の型と呼び出しの結果の型（署名から結果を引けるときは同じ列から — 型式を 2 度引かない）
func yDeclPre(st mut S, fi int) {
    s := yFnSig(mut st, fi)
    if s >= 0 && table.Get(mut st.ty.yfnres, fi) == -2 {
        table.Set(mut st.ty.yfnres, fi, yResults(mut st, yLb(YAt(mut st, s))))
        return
    }
    _ = yFnResults(mut st, fi)
}

// package の分割の順（Init と TypeAll が同じ順で回る。Init が呼ぶ）: package の順 = 依存の後順（import 先が先 — Kahn の
// 位相の順。ロード順は main からの幅優先 = 依存の前順なので、そのままでは使えない）と、package ごとの関数・const の順（既定 = 表の順）。
// 撹拌のオプションSOBER_TYORDER（検査tyorder — 区画の中身は順に依っても、出力は依らない）: rev = packageの中の関数・const・ファイルを逆順・
// pkgrev = 準備のできたpackageを番号の小さい方から選ぶ（既定は大きい方から）・shuf:<シード> = 準備のできたpackageをシードつきで選び、
// package の中の関数・const も並べ替える
func tyPlan(st mut S) {
    mode, seed := tyOrderMode()
    mut x := seed
    np := st.npkg
    // 入次数 = import の行（列 [2n, (ref, pkg)…]。同じ package への行が複数あれば行の数 — 選んだときも行の数だけ減らす）
    mut indeg := mut []int{}
    mut done := mut []bool{}
    for k <- iter.Range(0, np) {
        im := hget(mut st, st.pkgs + k * PKSZ + 4)
        mut n := 0
        for i <- iter.Range(0, hget(mut st, im) / 2) {
            d := hget(mut st, im + 2 + i * 2)
            if d >= 0 && d != k {
                n += 1
            }
        }
        indeg = append(indeg, n)
        done = append(done, false)
    }
    st.ty.pord = listN(mut st, np)
    for q <- iter.Range(0, np) {
        mut nready := 0
        for k <- iter.Range(0, np) {
            if !done[k] && indeg[k] == 0 {
                nready += 1
            }
        }
        mut r := if nready == 0 { 0 } else if mode == 2 { 0 } else if mode == 3 { tyLcg(x) % nready } else { nready - 1 }
        if mode == 3 {
            x = tyLcg(x)
        }
        mut pick := -1
        for k <- iter.Range(0, np) {
            if pick == -1 && !done[k] && (indeg[k] == 0 || nready == 0) {
                if r == 0 {
                    pick = k
                } else {
                    r -= 1
                }
            }
        }
        done[pick] = true
        hset(mut st, st.ty.pord + 1 + q, pick)
        for k <- iter.Range(0, np) {
            if !done[k] {
                im := hget(mut st, st.pkgs + k * PKSZ + 4)
                for i <- iter.Range(0, hget(mut st, im) / 2) {
                    if hget(mut st, im + 2 + i * 2) == pick {
                        indeg[k] = indeg[k] - 1
                    }
                }
            }
        }
    }
    // 関数・constをpackageごとに数えて詰める（packageの中は表の順 — オプションがあれば逆順か並べ替え）
    st.ty.fo = listN(mut st, np + 1)
    st.ty.ford = listN(mut st, st.nfn)
    st.ty.co = listN(mut st, np + 1)
    st.ty.cord = listN(mut st, st.ncon)
    x = tyBucket(mut st, st.ty.fo, st.ty.ford, st.nfn, false, mode, x)
    _ = tyBucket(mut st, st.ty.co, st.ty.cord, st.ncon, true, mode, x)
    st.ty.frev = if mode == 1 || mode == 3 { 1 } else { 0 }
    st.ty.ordOn = if mode == 0 { 0 } else { 1 }
    st.ty.preg = listN(mut st, np * PRSZ)
    st.ty.ydk = -1
}

// n個（関数かconst — con）をpackageごとに詰めてoutに、区間の頭をoffに書く（mode — tyPlanのオプション）。乱数の続きを返す
func tyBucket(st mut S, off int, out int, n int, con bool, mode int, seed int) int {
    np := st.npkg
    for i <- iter.Range(0, n) {
        p := if con { ConPkg(mut st, i) } else { fnPkg(mut st, i) }
        hset(mut st, off + 2 + p, hget(mut st, off + 2 + p) + 1)
    }
    for p <- iter.Range(0, np) {
        hset(mut st, off + 2 + p, hget(mut st, off + 2 + p) + hget(mut st, off + 1 + p))
    }
    mut pos := mut []int{}
    for p <- iter.Range(0, np) {
        pos = append(pos, hget(mut st, off + 1 + p))
    }
    for i <- iter.Range(0, n) {
        p := if con { ConPkg(mut st, i) } else { fnPkg(mut st, i) }
        hset(mut st, out + 1 + pos[p], i)
        pos[p] = pos[p] + 1
    }
    mut x := seed
    if mode == 1 || mode == 3 {
        for p <- iter.Range(0, np) {
            lo := hget(mut st, off + 1 + p)
            mut i := hget(mut st, off + 2 + p) - 1
            if mode == 1 {
                mut j := lo
                while j < i {
                    t := hget(mut st, out + 1 + i)
                    hset(mut st, out + 1 + i, hget(mut st, out + 1 + j))
                    hset(mut st, out + 1 + j, t)
                    j += 1
                    i -= 1
                }
            } else {
                while i > lo {
                    x = tyLcg(x)
                    j := lo + x % (i - lo + 1)
                    t := hget(mut st, out + 1 + i)
                    hset(mut st, out + 1 + i, hget(mut st, out + 1 + j))
                    hset(mut st, out + 1 + j, t)
                    i -= 1
                }
            }
        }
    }
    return x
}

func tyLcg(x int) int {
    return (x * 1103515245 + 12345) % 2147483648
}

// 撹拌のオプションSOBER_TYORDERの形（0 = 既定・1 = rev・2 = pkgrev・3 = shuf）とシード
func tyOrderMode() (int, int) {
    v, err := os.Getenv("SOBER_TYORDER")
    if err != nil || v == nil {
        return 0, 0
    }
    if v == "pkgrev" {
        return 2, 0
    }
    b := bytes(v)
    if len(b) > 5 && b[0] == 's' && b[4] == ':' {
        mut x := 0
        for i <- iter.Range(5, len(b)) {
            x = x * 10 + int(b[i]) - 48
        }
        return 3, x
    }
    return 1, 0
}

// 検査中の関数から関数fiへの呼び出しの型引数tlが型パラメータを含むなら辺を積む（fiにフラグが付けば呼び手にも伝わる — YPropagate）
func yNoteEdge(st mut S, fi int, tl ListRef) {
    if st.yfi == -1 {
        return
    }
    for i <- iter.Range(0, lenL(mut st, tl)) {
        if YHasVar(mut st, latI(mut st, tl, i)) {
            e := ylN(mut st, 3)
            yput(mut st, e, 0, st.yfi)
            yput(mut st, e, 1, fi)
            yput(mut st, e, 2, st.ty.yedges)
            st.ty.yedges = int(e)
            return
        }
    }
}

// フラグを辺に沿って呼び手へ不動点まで伝える（型パラメータをフラグの付いた関数へ渡す関数も、インスタンスごとでないと穴の種類が決まらない）
func YPropagate(st mut S) {
    mut changed := true
    while changed {
        changed = false
        mut r := st.ty.yedges
        while r != -1 {
            if YInstNeeded(mut st, ylAt(mut st, r, 1)) && !YInstNeeded(mut st, ylAt(mut st, r, 0)) {
                yput(mut st, ListRef(st.ty.ymark), ylAt(mut st, r, 0), 1)
                changed = true
            }
            r = ylAt(mut st, r, 2)
        }
    }
}

// 辺のチェーンの頭からstopの手前まで（packageの本体の相で積んだ辺 — 呼び先は同じpackageか型付け済みの依存）でフラグを不動点まで伝える
func yPropagateTo(st mut S, stop int) {
    mut changed := true
    while changed {
        changed = false
        mut r := st.ty.yedges
        while r != stop {
            if YInstNeeded(mut st, ylAt(mut st, r, 1)) && !YInstNeeded(mut st, ylAt(mut st, r, 0)) {
                yput(mut st, ListRef(st.ty.ymark), ylAt(mut st, r, 0), 1)
                changed = true
            }
            r = ylAt(mut st, r, 2)
        }
    }
}

// 関数 fi の本体に型パラメータ型の補間の穴があるか（ジェネリック Def ならインスタンスごとに脱糖する — call.sober の instDef）
func YInstNeeded(st mut S, fi int) bool {
    return latI(mut st, ListRef(st.ty.ymark), fi) != 0
}

// 辞書 const i の型（初期化式を const の package の文脈で検査する — const ごとに 1 度）
func yConTy(st mut S, i int) int {
    m := table.Get(mut st.ty.yconty, i)
    if m != -2 {
        return m
    }
    yLate(mut st, ConPkg(mut st, i))
    table.Set(mut st.ty.yconty, i, -1)
    saved := yCtx(mut st)
    st.ypk = ConPkg(mut st, i)
    st.ytps = -1
    st.yenv = -1
    t := yExpr(mut st, nB(nodeOf(mut st, ConNode(mut st, i))))
    setYCtx(mut st, saved)
    table.Set(mut st.ty.yconty, i, t)
    return t
}

func yFunc(st mut S, fi int, body NodeRef) {
    st.ypk = fnPkg(mut st, fi)
    st.ytps = fnTParams(mut st, fi)
    st.yenv = -1
    ps := fnParams(mut st, fi)
    ex := fnExpands(mut st, fi)
    for i <- iter.Range(0, lenL(mut st, ps)) {
        p := nodeOf(mut st, latN(mut st, ps, i))
        t := yTe(mut st, st.ypk, st.ytps, nB(p))
        if ex && kindN(mut st, nB(p)) == ast.TFunc {
            yBindClo(mut st, sA(p), t)
        } else {
            yBindName(mut st, sA(p), t)
        }
    }
    yRetMut(mut st, fi, ps, ex)
    yBlock(mut st, lA(nodeOf(mut st, body)))
}

// mutの仮引数も関数型の仮引数（展開）も持たない関数の結果の型がmutの中身（mutのslice / map — structのフィールド・T? の中も、型引数を
// 代入した後で）を持つなら記録する（language.md 26 節: mutの値の格納場所は呼び手のmutの実引数〔callMのanchor〕か展開の呼び手が決める。
// どちらも無い関数〔コアの Def — formal.md の Ty.retOk〕は mut を返せない。check の analyzer と build の lower が同じ表から拒否する）
func yRetMut(st mut S, fi int, ps ListRef, ex bool) {
    if ex {
        return
    }
    for i <- iter.Range(0, lenL(mut st, ps)) {
        if nodeOf(mut st, latN(mut st, ps, i)).c != 0 {
            return
        }
    }
    rs := fnResults(mut st, fi)
    for i <- iter.Range(0, lenL(mut st, rs)) {
        rt := yTe(mut st, st.ypk, st.ytps, latN(mut st, rs, i))
        if yHasMut(mut st, rt, 8) {
            yFieldNote(mut st, 2, fnNode(mut st, fi), StrRef(-1), rt)
        }
    }
}

// 文の列をスコープの中で検査し、ブロックの値の型を返す
func yBlock(st mut S, l ListRef) int {
    saved := st.yenv
    mut v := yBase(YNone)
    for i <- iter.Range(0, lenL(mut st, l)) {
        s := latN(mut st, l, i)
        if len(st.yNrw) > 0 {
            yKill(mut st, s, true)
        }
        v = yStmt(mut st, s)
        if len(st.yNrw) > 0 {
            yKill(mut st, s, false)
        }
    }
    st.yenv = saved
    return v
}

// 絞りの消滅（narrowkill.sober の KillOf を共有）: 文 s の頭 / 後ろで、s が書く絞った名前を外の T? の型へ束縛し直す
func yKill(st mut S, s NodeRef, before bool) {
    mut i := 0
    while i < len(st.yNrw) {
        nm := StrRef(st.yNrw[i])
        ko := KillOf(mut st, s, nm)
        if ko == KillBefore && before || ko == KillAfter && !before {
            yBindName(mut st, nm, st.yNrw[i + 1])
        }
        i += 2
    }
}

// 文 s を検査し、ブロックの末尾に置かれたときの値の型を返す（式文 = その式・return / break / continue = 戻らない・他 = 値なし）
func yStmt(st mut S, s NodeRef) int {
    k := kindN(mut st, s)
    switch k {
    case ast.SExpr:
        x := nA(nodeOf(mut st, s))
        if kindN(mut st, x) == ast.EFor && nodeOf(mut st, x).b == 1 {
            // 文形 for（値なし）
            yFor(mut st, x)
            return yBase(YNone)
        }
        return yExpr(mut st, x)
    case ast.SBind:
        yBindStmt(mut st, s)
        return yBase(YNone)
    case ast.SAssign:
        yExprs(mut st, lA(nodeOf(mut st, s)))
        yExprs(mut st, lC(nodeOf(mut st, s)))
        yNoteAssign(mut st, lA(nodeOf(mut st, s)), lC(nodeOf(mut st, s)))
        for i <- iter.Range(0, lenL(mut st, lA(nodeOf(mut st, s)))) {
            yFieldWrite(mut st, latN(mut st, lA(nodeOf(mut st, s)), i))
        }
        return yBase(YNone)
    case ast.SRet:
        // 値化可能な named fn type を返す関数の return のラムダは結果の型で仮引数に型を付ける（工程 4 B1 の同梱 — desugar の retValue と同じ線）
        rv := lA(nodeOf(mut st, s))
        if st.ylam == 0 && st.yfi >= 0 && lenL(mut st, rv) == 1 && kindN(mut st, latN(mut st, rv, 0)) == ast.ELambda && lenL(mut st, fnResults(mut st, st.yfi)) == 1 {
            _ = yLambda(mut st, latN(mut st, rv, 0), yTe(mut st, fnPkg(mut st, st.yfi), fnTParams(mut st, st.yfi), latN(mut st, fnResults(mut st, st.yfi), 0)))
        } else {
            yExprs(mut st, rv)
            // 分岐が全部型なしの定数のif / switchの値は、結果のbyte / named scalar に割り当てる（desugarの末尾期待型・lowerのexprExpectingと同じ）
            if st.ylam == 0 && st.yfi >= 0 && lenL(mut st, rv) == 1 && lenL(mut st, fnResults(mut st, st.yfi)) == 1 {
                v := latN(mut st, rv, 0)
                rt := yTe(mut st, fnPkg(mut st, st.yfi), fnTParams(mut st, st.yfi), latN(mut st, fnResults(mut st, st.yfi), 0))
                vt := YTypeOf(mut st, v)
                if vt >= 0 && rt >= 0 && yNamedOver(mut st, rt, vt) && yArmsUntyped(mut st, v) {
                    yPut(mut st, int(v), rt)
                }
            }
        }
        yNoteRet(mut st, lA(nodeOf(mut st, s)))
        return yBase(YNever)
    case ast.SBreak | ast.SContinue:
        return yBase(YNever)
    case ast.SWhile:
        yExpr(mut st, nA(nodeOf(mut st, s)))
        yBlock(mut st, lA(nodeOf(mut st, nB(nodeOf(mut st, s)))))
        return yBase(YNone)
    case ast.SDefer:
        yExpr(mut st, nA(nodeOf(mut st, s)))
        return yBase(YNone)
    case ast.SYield:
        t := yExpr(mut st, nA(nodeOf(mut st, s)))
        st.yyield = if st.yyield == -3 { t } else if yEq(mut st, st.yyield, t) { t } else { -1 }
        return yBase(YNone)
    }
    return -1
}

// リテラルの要素の列 l（要素の型 el）を検査する — ラムダは要素の型で仮引数に型を付ける（値の位置の `[]F{…}`）
func yElems(st mut S, l ListRef, el int) {
    for i <- iter.Range(0, lenL(mut st, l)) {
        yElem(mut st, latN(mut st, l, i), el)
    }
}

func yElem(st mut S, v NodeRef, el int) {
    if kindN(mut st, v) == ast.ELambda && el >= 0 {
        _ = yLambda(mut st, v, el)
    } else {
        vt := yExpr(mut st, v)
        // 分岐が全部型なしの定数のif / switchの要素は、要素のbyte / named scalar に割り当てる（returnと同じ規則）
        if vt >= 0 && el >= 0 && yNamedOver(mut st, el, vt) && yArmsUntyped(mut st, v) {
            yPut(mut st, int(v), el)
        }
    }
}

func yExprs(st mut S, l ListRef) {
    for i <- iter.Range(0, lenL(mut st, l)) {
        yExpr(mut st, latN(mut st, l, i))
    }
}

func yBindStmt(st mut S, s NodeRef) {
    names := lA(nodeOf(mut st, s))
    vals := lC(nodeOf(mut st, s))
    nn := lenL(mut st, names)
    if nn > 1 && lenL(mut st, vals) == 1 {
        t := yExpr(mut st, latN(mut st, vals, 0))
        tl := if yk(mut st, t) == YTuple { yLa(YAt(mut st, t)) } else { -1 }
        for j <- iter.Range(0, nn) {
            yBindName(mut st, latS(mut st, names, j), if tl != -1 && j < lenL(mut st, tl) { latI(mut st, tl, j) } else { -1 })
        }
        return
    }
    if isLocalLam(mut st, s) {
        // 局所の束縛のラムダ: 本体は使用の点で型付けする（yLocalCall・yLamArg）
        yBindLam(mut st, latS(mut st, names, 0), latN(mut st, vals, 0))
        return
    }
    // 値は新しい名前が見えないところで左から右へ
    tys := ListRef(listN(mut st, nn))
    for j <- iter.Range(0, nn) {
        yput(mut st, tys, j, if j < lenL(mut st, vals) { yExpr(mut st, latN(mut st, vals, j)) } else { -1 })
    }
    for j <- iter.Range(0, nn) {
        yBindName(mut st, latS(mut st, names, j), latI(mut st, tys, j))
    }
}

// ── 式 ──

// 式 e の表層型（分かれば表に載せる）
func yExpr(st mut S, e NodeRef) int {
    if e == -1 {
        return -1
    }
    y := yExpr0(mut st, e)
    if y >= 0 {
        yPut(mut st, int(e), y)
    }
    return y
}

func yExpr0(st mut S, e NodeRef) int {
    k := kindN(mut st, e)
    switch k {
    case ast.EInt:
        return yBase(YInt)
    case ast.EFloat:
        return yFloat()
    case ast.ENil:
        return yBase(YNil)
    case ast.EStrlit:
        return yBase(YString)
    case ast.EInterp:
        holes := lB(nodeOf(mut st, e))
        yExprs(mut st, holes)
        if st.yfi != -1 {
            for i <- iter.Range(0, lenL(mut st, holes)) {
                if yk(mut st, YTypeOf(mut st, latN(mut st, holes, i))) == YVar {
                    yput(mut st, ListRef(st.ty.ymark), st.yfi, 1)
                }
            }
        }
        return yBase(YString)
    case ast.EParen:
        return yExpr(mut st, nA(nodeOf(mut st, e)))
    case ast.EIdent:
        return yIdent(mut st, e)
    case ast.EMutArg:
        // `mut x` / `mut x.f.g`（フィールドの場所 — 名前は "x.f.g" の1ワード）
        parts := DotParts(mut st, nodeOf(mut st, e).a)
        l := yLookup(mut st, latS(mut st, parts, 0))
        mut t := if l == -2 { -1 } else { l }
        for i <- iter.Range(1, lenL(mut st, parts)) {
            // `mut x.f` は呼び先が書きうる = フィールドへの書き（他のpackageのstructのフィールドなら拒否 — fieldwrite.sober）。b = 1はloaderのleaseのコピーが組んだ
            // ウィンドウのフィールドの場所（配置先の付け外し・容量の読み — loader/lease.sober。形はloaderが検査済み）
            if yForeignTy(mut st, t) && nodeOf(mut st, e).b == 0 {
                yFieldNote(mut st, 0, e, latS(mut st, parts, i), t)
            }
            t = yField(mut st, t, latS(mut st, parts, i))
        }
        return t
    case ast.EBinary:
        return yBinary(mut st, e)
    case ast.EUnary:
        x := yExpr(mut st, nB(nodeOf(mut st, e)))
        op := nodeOf(mut st, e).a
        if op == lexer.Bang {
            return yBase(YBool)
        }
        return if yk(mut st, x) == YInt || (op == lexer.Minus && yk(mut st, x) == YFloat) { x } else { -1 }
    case ast.ECall:
        args := lB(nodeOf(mut st, e))
        yArgs(mut st, args)
        return yCall(mut st, nA(nodeOf(mut st, e)), args, yArgTys(mut st, args))
    case ast.EPipe:
        lhs := nA(nodeOf(mut st, e))
        lt := yExpr(mut st, lhs)
        args := lC(nodeOf(mut st, e))
        yArgs(mut st, args)
        return yPipe(mut st, nB(nodeOf(mut st, e)), args, lt, lhs)
    case ast.ETry:
        x := yExpr(mut st, nA(nodeOf(mut st, e)))
        if nB(nodeOf(mut st, e)) != -1 {
            yComposite(mut st, nB(nodeOf(mut st, e)))
        }
        return yStripLast(mut st, x)
    case ast.ESelector:
        r := ySelector(mut st, e)
        yFieldRead(mut st, e, r)
        return r
    case ast.EComposite:
        return yComposite(mut st, e)
    case ast.EIndex:
        b := yExpr(mut st, nA(nodeOf(mut st, e)))
        yExpr(mut st, nB(nodeOf(mut st, e)))
        if yk(mut st, b) == YSlice {
            return YAt(mut st, b).a
        }
        if yk(mut st, b) == YMap {
            return yMk(mut st, YOpt, YAt(mut st, b).b, 0, 0)
        }
        return -1
    case ast.ESlice3:
        b := yExpr(mut st, nA(nodeOf(mut st, e)))
        yExpr(mut st, nB(nodeOf(mut st, e)))
        yExpr(mut st, nC(nodeOf(mut st, e)))
        return if yk(mut st, b) == YString || (yk(mut st, b) == YSlice && YAt(mut st, b).b == 0) { b } else { -1 }
    case ast.ESlicelit:
        el := yTe(mut st, st.ypk, st.ytps, nA(nodeOf(mut st, e)))
        yElems(mut st, lB(nodeOf(mut st, e)), el)
        yNoteElems(mut st, lB(nodeOf(mut st, e)), el)
        return if el < 0 { -1 } else { yMk(mut st, YSlice, el, if nodeOf(mut st, e).c != 0 { 1 } else { 0 }, 0) }
    case ast.EMaplit:
        ents := lC(nodeOf(mut st, e))
        kt := yTe(mut st, st.ypk, st.ytps, nA(nodeOf(mut st, e)))
        vt := yTe(mut st, st.ypk, st.ytps, nB(nodeOf(mut st, e)))
        for i <- iter.Range(0, lenL(mut st, ents)) {
            en := nodeOf(mut st, latN(mut st, ents, i))
            yExpr(mut st, nA(en))
            yElem(mut st, nB(en), vt)
        }
        for i <- iter.Range(0, lenL(mut st, ents)) {
            ev := nB(nodeOf(mut st, latN(mut st, ents, i)))
            if yCand(mut st, ev) {
                yNoteImplicit(mut st, ev, vt)
            }
        }
        return if kt < 0 || vt < 0 { -1 } else { yMk(mut st, YMap, kt, vt, if nodeOf(mut st, e).d != 0 { 1 } else { 0 }) }
    case ast.EBlock:
        return yBlock(mut st, lA(nodeOf(mut st, e)))
    case ast.EIf:
        return yIf(mut st, e)
    case ast.ESwitch:
        return ySwitch(mut st, e)
    case ast.EFor:
        yFor(mut st, e)
        return -1
    }
    return -1
}

// 実引数の列を検査する（ラムダと穴は飛ばす — ラムダの仮引数の型は呼び手の文脈で決まる。後のフェーズ）
func yArgs(st mut S, l ListRef) {
    for i <- iter.Range(0, lenL(mut st, l)) {
        a := latN(mut st, l, i)
        if a != -1 && kindN(mut st, a) != ast.ELambda {
            yExpr(mut st, a)
        }
    }
}

func yIdent(st mut S, e NodeRef) int {
    name := sA(nodeOf(mut st, e))
    l := yLookup(mut st, name)
    if l != -2 {
        return l
    }
    if strIs(mut st, name, "true") || strIs(mut st, name, "false") {
        return yBase(YBool)
    }
    return yTop(mut st, ResolveTop(mut st, st.ypk, name, false, TopConst | TopFn))
}

// トップレベルのconst（int — 辞書は後のフェーズ）か名前付き関数の参照（関数値）
func yTop(st mut S, r TopRef) int {
    if r.kind == TopConst {
        if ConDict(mut st, r.idx) {
            return yConTy(mut st, r.idx)
        }
        if ConHas(mut st, r.idx) && ConNamed(mut st, r.idx) != -1 {
            // 型つきの const（`const OK = Status(200)` — language.md 32 節）
            return yDecl(mut st, ConNamed(mut st, r.idx), -1, -1)
        }
        return if ConHas(mut st, r.idx) { yBase(YInt) } else { -1 }
    }
    if r.kind == TopFn {
        return yFnSig(mut st, r.idx)
    }
    return -1
}

func ySelector(st mut S, e NodeRef) int {
    base := nA(nodeOf(mut st, e))
    field := sB(nodeOf(mut st, e))
    if kindN(mut st, base) == ast.EIdent && yLookup(mut st, sA(nodeOf(mut st, base))) == -2 && importRef(mut st, st.ypk, sA(nodeOf(mut st, base))) {
        return yTop(mut st, ResolveSel(mut st, st.ypk, sA(nodeOf(mut st, base)), field, TopConst | TopFn))
    }
    return yField(mut st, yExpr(mut st, base), field)
}

func isCmpOp(op int) bool {
    return op == lexer.EqualEqual || op == lexer.BangEqual || op == lexer.Less || op == lexer.LessEqual || op == lexer.Greater || op == lexer.GreaterEqual
}

func yBinary(st mut S, e NodeRef) int {
    op := nodeOf(mut st, e).a
    l := yExpr(mut st, nB(nodeOf(mut st, e)))
    r := yExpr(mut st, nC(nodeOf(mut st, e)))
    if op == lexer.AmpersandAmpersand || op == lexer.PipePipe || isCmpOp(op) {
        return yBase(YBool)
    }
    if yk(mut st, l) == YString && op == lexer.Plus {
        return l
    }
    if yk(mut st, l) == YFloat && yk(mut st, r) == YFloat && (op == lexer.Plus || op == lexer.Minus || op == lexer.Star || op == lexer.Slash) {
        return l
    }
    return if yk(mut st, l) == YInt && yk(mut st, r) == YInt { l } else { -1 }
}

// `?` の成功値の型（最後の結果を剥がした残り）
func yStripLast(st mut S, x int) int {
    if yk(mut st, x) == YTuple {
        l := yLa(YAt(mut st, x))
        n := lenL(mut st, l)
        if n == 2 {
            return latI(mut st, l, 0)
        }
        out := ylN(mut st, n - 1)
        for i <- iter.Range(0, n - 1) {
            yput(mut st, out, i, latI(mut st, l, i))
        }
        return yTuple(mut st, out)
    }
    return if yk(mut st, x) == YOpt { yBase(YNone) } else { -1 }
}

// 実引数の列の型の列（ラムダ・穴は -1 — 引数は検査済み）
func yArgTys(st mut S, args ListRef) ListRef {
    n := lenL(mut st, args)
    out := ListRef(listN(mut st, n))
    for i <- iter.Range(0, n) {
        a := latN(mut st, args, i)
        yput(mut st, out, i, if a == -1 { -1 } else { YTypeOf(mut st, a) })
    }
    return out
}

// パイプ `lhs |> callee(args)` の結果の型: 左辺（多値なら成分ごと）を穴へ、穴が無ければ先頭へ
func yPipe(st mut S, callee NodeRef, args ListRef, lt int, lhs NodeRef) int {
    // for 式の左辺は節のまま穴（か先頭）へ（yNamedCall が yield の型から Iter[T] を組む）
    ln := if kindN(mut st, lhs) == ast.EFor { lhs } else { -1 }
    comps := if yk(mut st, lt) == YTuple { yLa(YAt(mut st, lt)) } else { ListRef(list1(mut st, lt)) }
    na := lenL(mut st, args)
    mut holes := 0
    for i <- iter.Range(0, na) {
        if latN(mut st, args, i) == -1 {
            holes += 1
        }
    }
    nc := lenL(mut st, comps)
    n := if holes == 0 { na + nc } else { na }
    an := ListRef(listN(mut st, n))
    at := ListRef(listN(mut st, n))
    mut q := 0
    if holes == 0 {
        for j <- iter.Range(0, nc) {
            yput(mut st, an, q, int(ln))
            yput(mut st, at, q, latI(mut st, comps, j))
            q += 1
        }
    }
    mut h := 0
    for i <- iter.Range(0, na) {
        a := latN(mut st, args, i)
        yput(mut st, an, q, if a == -1 { int(ln) } else { int(a) })
        if a == -1 {
            yput(mut st, at, q, if h < nc { latI(mut st, comps, h) } else { -1 })
            h += 1
        } else {
            yput(mut st, at, q, YTypeOf(mut st, a))
        }
        q += 1
    }
    r := yCallee(mut st, callee, an, at)
    // 左辺（1 値）は穴か先頭の仮引数へ — an に節が無い（for 式でなければ -1）ので別に
    if nc == 1 && ln == -1 && yCand(mut st, lhs) {
        mut k := 0
        if holes > 0 {
            mut found := false
            for i <- iter.Range(0, na) {
                if !found && latN(mut st, args, i) == -1 {
                    k = i
                    found = true
                }
            }
        }
        yNoteImplicit(mut st, lhs, WantParam(mut st, st.ypk, callee, k))
    }
    return r
}

// 呼び出し callee(args) の結果の型（at = 実引数の型の列）
func yCall(st mut S, callee NodeRef, args ListRef, at ListRef) int {
    if kindN(mut st, callee) == ast.EIdent {
        name := sA(nodeOf(mut st, callee))
        if yLookup(mut st, name) == -2 {
            b := yBuiltin(mut st, name, args)
            if b != -2 {
                return b
            }
            cv := convTarget(mut st, callee, -1, st.ypk)
            switch cv {
            case CONV_INT:
                return yBase(YInt)
            case CONV_BOOL:
                return yBase(YBool)
            case CONV_BYTE:
                return yByte()
            case CONV_FLOAT:
                return yFloat()
            }
            if cv >= 0 {
                return yDecl(mut st, NodeRef(cv), -1, -1)
            }
        }
    }
    if kindN(mut st, callee) == ast.ESelector {
        // package 修飾の named scalar への変換 `p.X(e)`（convTarget は修飾名も引く）
        cv := convTarget(mut st, callee, -1, st.ypk)
        if cv >= 0 {
            return yDecl(mut st, NodeRef(cv), -1, -1)
        }
    }
    // 名前付き関数型への変換 `W(e)` / `p.W(e)`（language.md 25 節）: 実引数は W の値の位置（ラムダは W の仮引数の型で）
    return yCallee(mut st, callee, args, at)
}

// 名前付き関数型への変換 `W(e)` / `p.W(e)`（language.md 25 節）の型（変換でなければ -2）: 実引数は W の値の位置（ラムダは W の仮引数の型で）。
// 型引数を書いた変換 `Gen[int](f)` も同じ（総称の named fn type は値の型にならない — 拒否する）。呼び先が関数でなかったときだけ呼ばれる
func yConvCall(st mut S, callee NodeRef, args ListRef) int {
    cb := if kindN(mut st, callee) == ast.EIndex { nA(nodeOf(mut st, callee)) } else { callee }
    fr := yFnConv(mut st, cb)
    if fr.kind == TopType {
        decl := NodeRef(fr.idx)
        if cb != callee || lenL(mut st, lB(nodeOf(mut st, decl))) > 0 {
            // 値化できない named fn type への変換（TypeMismatch kind 8）
            yFieldNote(mut st, 4, callee, StrRef(-1), -1)
            return -1
        }
        y := yDecl(mut st, decl, fr.pkg, -1)
        if lenL(mut st, args) == 1 {
            a0 := latN(mut st, args, 0)
            a := yLamArg(mut st, a0)
            fv := yFnView(mut st, y)
            if a != -1 && yk(mut st, fv) == YFn {
                yLambda(mut st, a, fv)
            } else if kindN(mut st, a0) != ast.ELambda {
                // 別の named fn type の値（nominal — 同じ宣言どうしだけ。TypeMismatch kind 9）
                t := yExpr(mut st, a0)
                if t >= 0 && yk(mut st, t) == YDecl && yNa(YAt(mut st, t)) != decl && kindN(mut st, nC(nodeOf(mut st, yNa(YAt(mut st, t))))) == ast.BFunc {
                    yFieldNote(mut st, 5, a0, StrRef(-1), -1)
                }
            }
        }
        return y
    }
    return -2
}

// callee が名前付き関数型の名前（変換 — 局所の束縛でない）ならその型の解決（でなければ kind が TopType でない）
func yFnConv(st mut S, callee NodeRef) TopRef {
    k := kindN(mut st, callee)
    mut name := StrRef(-1)
    if k == ast.EIdent {
        name = sA(nodeOf(mut st, callee))
        if yLookup(mut st, name) != -2 {
            return TopRef{kind: 0 - 1, idx: 0 - 1, pkg: 0 - 1, sub: 0 - 1}
        }
    } else if k == ast.ESelector {
        name = qualName(mut st, callee, -1, st.ypk)
    }
    if name == -1 {
        return TopRef{kind: 0 - 1, idx: 0 - 1, pkg: 0 - 1, sub: 0 - 1}
    }
    r := ResolveType(mut st, st.ypk, name)
    if r.kind != TopType || kindN(mut st, nC(nodeOf(mut st, NodeRef(r.idx)))) != ast.BFunc {
        return TopRef{kind: 0 - 1, idx: 0 - 1, pkg: 0 - 1, sub: 0 - 1}
    }
    return r
}

// 関数（名前付き関数か関数値）を実引数の節 an・型 at で呼んだ結果の型。明示の型引数 `f[T](…)` も読む
func yCallee(st mut S, callee0 NodeRef, an ListRef, at ListRef) int {
    mut callee := callee0
    mut ex := ListRef(-1)
    if kindN(mut st, callee0) == ast.EIndex {
        ix := nB(nodeOf(mut st, callee0))
        t := if kindN(mut st, ix) == ast.EIdent { yTName(mut st, st.ypk, st.ytps, sA(nodeOf(mut st, ix))) } else { -1 }
        if t < 0 {
            // 型引数でない添字 = 値の添字の読み（`ops[k](…)`・`fs[i](…)`）: map の読みと `[]F?` の要素は F? — 絞らずには呼べない
            yOptCall(mut st, callee0, yExpr(mut st, callee0))
            return -1
        }
        ex = ListRef(list1(mut st, t))
        callee = nA(nodeOf(mut st, callee0))
    }
    k := kindN(mut st, callee)
    if k == ast.EIdent {
        name := sA(nodeOf(mut st, callee))
        ll := yLookupLam(mut st, name)
        if ll != -1 {
            return yLocalCall(mut st, ll, at)
        }
        l0 := yLookup(mut st, name)
        if l0 != -2 {
            if l0 >= 0 {
                yPut(mut st, int(callee), l0)
            }
            yOptCall(mut st, callee, l0)
            l := yFnView(mut st, l0)
            if yk(mut st, l) != YFn || ex != -1 {
                return -1
            }
            // 関数値へのラムダの実引数は仮引数の型で
            fps := yLa(YAt(mut st, l))
            yNoteArgTys(mut st, an, at, fps)
            for i <- iter.Range(0, lenL(mut st, an)) {
                a := yLamArg(mut st, latN(mut st, an, i))
                if a != -1 && i < lenL(mut st, fps) {
                    yLambda(mut st, a, latI(mut st, fps, i))
                }
            }
            return yResults(mut st, yLb(YAt(mut st, l)))
        }
        fi := ResolveFn(mut st, st.ypk, name)
        if fi >= 0 {
            return yNamedCall(mut st, fi, an, at, ex, callee0)
        }
        c := yConvCall(mut st, callee0, an)
        return if c != -2 { c } else { -1 }
    }
    if k == ast.ESelector {
        base := nA(nodeOf(mut st, callee))
        if kindN(mut st, base) == ast.EIdent && yLookup(mut st, sA(nodeOf(mut st, base))) == -2 && importRef(mut st, st.ypk, sA(nodeOf(mut st, base))) {
            fi := ResolveSelFn(mut st, st.ypk, sA(nodeOf(mut st, base)), sB(nodeOf(mut st, callee)))
            if fi >= 0 {
                return yNamedCall(mut st, fi, an, at, ex, callee0)
            }
            c := yConvCall(mut st, callee0, an)
            return if c != -2 { c } else { -1 }
        }
        raw := yExpr(mut st, callee)
        yOptCall(mut st, callee, raw)
        f := yFnView(mut st, raw)
        if yk(mut st, f) == YFn && ex == -1 {
            fps := yLa(YAt(mut st, f))
            yNoteArgTys(mut st, an, at, fps)
            // 関数値（フィールドの読み）へのラムダの実引数も仮引数の型で（識別子のcalleeと同じ — 借りの実引数の期待型を記録する）
            for i <- iter.Range(0, lenL(mut st, an)) {
                a := latN(mut st, an, i)
                if a != -1 && kindN(mut st, a) == ast.ELambda && i < lenL(mut st, fps) {
                    yLambda(mut st, a, latI(mut st, fps, i))
                }
            }
        }
        return if yk(mut st, f) == YFn && ex == -1 { yResults(mut st, yLb(YAt(mut st, f))) } else { -1 }
    }
    return -1
}

// calleeの型tが関数値のoption（`F?` — フィールド・束縛・添字の読み）なら記録する（絞らずに呼ぶ形 — checkとbuildが同じ表から拒否）
func yOptCall(st mut S, callee NodeRef, t int) {
    if t >= 0 && yk(mut st, t) == YOpt && yk(mut st, yFnView(mut st, YAt(mut st, t).a)) == YFn {
        yFieldNote(mut st, 3, callee, StrRef(-1), t)
    }
}

// 実引数の節の列に局所の束縛のラムダの名前があるか
func hasLocalLam(st mut S, an ListRef) bool {
    for i <- iter.Range(0, lenL(mut st, an)) {
        a := latN(mut st, an, i)
        if a != -1 && kindN(mut st, a) == ast.EIdent && yLookupLam(mut st, sA(nodeOf(mut st, a))) != -1 {
            return true
        }
    }
    return false
}

// 実引数の節の列にラムダがあるか
func hasLambda(st mut S, an ListRef) bool {
    for i <- iter.Range(0, lenL(mut st, an)) {
        a := latN(mut st, an, i)
        if a != -1 && kindN(mut st, a) == ast.ELambda {
            return true
        }
    }
    return false
}

// 名前付き関数 fi の呼び出しの結果の型。型引数は明示（ex）か、実引数の型との単一化で決める。
// ラムダの実引数は仮引数の関数型（決まった型引数を代入したもの）で仮引数に型を付けて本体を検査し、結果の型も単一化に足す
func yNamedCall(st mut S, fi int, an ListRef, at ListRef, ex ListRef, cn NodeRef) int {
    tps := fnTParams(mut st, fi)
    nt := lenL(mut st, tps)
    if nt == 0 && ex == -1 && !hasLambda(mut st, an) && !hasLocalLam(mut st, an) {
        yNoteArgs(mut st, fi, an, at, ListRef(-1))
        return yFnResults(mut st, fi)
    }
    if ex != -1 && lenL(mut st, ex) != nt {
        return -1
    }
    fpk := fnPkg(mut st, fi)
    ps := fnParams(mut st, fi)
    np := lenL(mut st, ps)
    env := ListRef(listN(mut st, nt))
    for i <- iter.Range(0, nt) {
        yput(mut st, env, i, if ex != -1 { latI(mut st, ex, i) } else { -1 })
    }
    pts := ListRef(listN(mut st, np))
    for i <- iter.Range(0, np) {
        yput(mut st, pts, i, yTe(mut st, fpk, tps, nB(nodeOf(mut st, latN(mut st, ps, i)))))
    }
    m := if lenL(mut st, at) < np { lenL(mut st, at) } else { np }
    // 実引数の型の列（for 式は Iter[T] に組む）
    ats := ListRef(listN(mut st, m))
    for i <- iter.Range(0, m) {
        a := latN(mut st, an, i)
        pt := latI(mut st, pts, i)
        mut t := latI(mut st, at, i)
        // for 式を Iter[T] 型の仮引数へ: 実引数の型 = 仮引数の名前付き関数型に yield の型を入れたもの
        // （仮引数の名前付き関数型は init が展開済みのことがある — その形は func(func(E))）
        if a != -1 && kindN(mut st, a) == ast.EFor {
            // 生成元がクロージャの名前なら型を付けない（lowerのforIterTypeと同じ — 推論に使わない）
            fsrc := nB(nodeOf(mut st, latN(mut st, lA(nodeOf(mut st, a)), 0)))
            cl := kindN(mut st, fsrc) == ast.EIdent && yIsClo(mut st, sA(nodeOf(mut st, fsrc)))
            yt := if cl { -1 } else { YYieldOf(mut st, a) }
            if yt < 0 {
                t = -1
            } else if yk(mut st, pt) == YDecl && YAt(mut st, pt).c >= 0 && lenL(mut st, yLc(YAt(mut st, pt))) == 1 {
                t = yDecl(mut st, yNa(YAt(mut st, pt)), YAt(mut st, pt).b, yl1(mut st, yt))
            } else if yk(mut st, pt) == YFn {
                t = yFnT(mut st, yl1(mut st, yFnT(mut st, yl1(mut st, yt), yl0(mut st), 0)), yl0(mut st), 0)
            }
        }
        yput(mut st, ats, i, t)
    }
    // 推論は lower の inferWithConsts と同じ手順: 型なしの定数の実引数を外して単一化し、決まらない型パラメータが残れば
    // 定数も入れて最初からやり直す（language.md 32 節 — 定数は相手の named scalar に合わせる）
    yInfer(mut st, pts, an, ats, m, env, ex)
    for i <- iter.Range(0, m) {
        a := yLamArg(mut st, latN(mut st, an, i))
        if a != -1 {
            // 値化可能な named fn type の仮引数（展開されず値の位置 — 工程 4 B1 の同梱）は関数値の表層型として読む
            pt := yFnView(mut st, latI(mut st, pts, i))
            r := yLambda(mut st, a, ySubst(mut st, pt, env))
            if yk(mut st, pt) == YFn && lenL(mut st, yLb(YAt(mut st, pt))) == 1 {
                yUnify(mut st, latI(mut st, yLb(YAt(mut st, pt)), 0), r, env)
            } else if yk(mut st, pt) == YFn && r >= 0 && yk(mut st, r) == YTuple && lenL(mut st, yLa(YAt(mut st, r))) == lenL(mut st, yLb(YAt(mut st, pt))) {
                // 多値の結果（`func(T) (U, error?)` — task.Map の mapE）: 成分ごとに
                for j <- iter.Range(0, lenL(mut st, yLa(YAt(mut st, r)))) {
                    yUnify(mut st, latI(mut st, yLb(YAt(mut st, pt)), j), latI(mut st, yLa(YAt(mut st, r)), j), env)
                }
            }
        }
    }
    if nt > 0 {
        // 呼び出しの型引数（callee の節の別キー — YTArgsOf）。ラムダの結果の型からも推論する（desugar の inferTs0 も同じ規則で
        // ラムダの本体の型を単一化するので、表に載せても build が check より広がらない）
        tl := ylN(mut st, nt)
        for i <- iter.Range(0, nt) {
            yput(mut st, tl, i, latI(mut st, env, i))
        }
        yPut(mut st, 0 - 1 - int(cn), yTuple(mut st, tl))
        yNoteEdge(mut st, fi, tl)
    }
    // error を返す task の Gather / Map（P3b 残穴1・2）: 振り分け先で型付けし直し、先を callee の節の別キーに記録する（desugar/task.sober の PREDIR）
    rd := parRedirectY(mut st, fi, at, env)
    if rd >= 0 {
        bare := if kindN(mut st, cn) == ast.EIndex { nA(nodeOf(mut st, cn)) } else { cn }
        yPut(mut st, 0 - PREDIR - int(bare), rd)
        return yNamedCall(mut st, rd, an, at, ex, cn)
    }
    yNoteArgs(mut st, fi, an, at, if nt > 0 { env } else { ListRef(-1) })
    // task.Tryのerrorを返すtask（Task[(T, error?)] — P3b-4 1b'）: 結果はOutcome[T]（失敗はFailedの分岐）
    if nt == 1 && ParKey(mut st, fi) == PAR_TRY && parFallibleY(mut st, latI(mut st, env, 0)) {
        yput(mut st, env, 0, latI(mut st, yLa(YAt(mut st, latI(mut st, env, 0))), 0))
    }
    rs := yTeList(mut st, fpk, tps, fnResults(mut st, fi))
    return if rs == -1 { -1 } else { yResults(mut st, ySubstList(mut st, rs, env)) }
}

// 実引数（節 an・型 ats の先頭 m 個）と仮引数の型 pts から型引数 env を決める（ex = 明示の型引数か -1）
func yInfer(st mut S, pts ListRef, an ListRef, ats ListRef, m int, env ListRef, ex ListRef) {
    for i <- iter.Range(0, m) {
        a := latN(mut st, an, i)
        if !(a != -1 && yUntypedArg(mut st, a)) {
            yUnify(mut st, latI(mut st, pts, i), latI(mut st, ats, i), env)
        }
    }
    if yEnvOpen(mut st, env) {
        for i <- iter.Range(0, lenL(mut st, env)) {
            yput(mut st, env, i, if ex != -1 { latI(mut st, ex, i) } else { -1 })
        }
        for i <- iter.Range(0, m) {
            yUnify(mut st, latI(mut st, pts, i), latI(mut st, ats, i), env)
        }
    }
}

// 呼び出しの callee の節 cn の型引数の列（ジェネリック関数の呼び出しでなければ -1。決まらない成分は -1）
func YTArgsOf(st mut S, cn NodeRef) ListRef {
    y := yGet(mut st, 0 - 1 - int(cn))
    return if y < 0 { -1 } else { yLa(YAt(mut st, y)) }
}

// 型引数の列に決まっていないものがあるか
func yEnvOpen(st mut S, env ListRef) bool {
    for i <- iter.Range(0, lenL(mut st, env)) {
        if latI(mut st, env, i) < 0 {
            return true
        }
    }
    return false
}

// 実引数 a が型なしの定数か（局所の束縛は違う）
func yUntypedArg(st mut S, a NodeRef) bool {
    if kindN(mut st, a) == ast.EIdent && yLookup(mut st, sA(nodeOf(mut st, a))) != -2 {
        return false
    }
    return isUntypedConst(mut st, a, -1, st.ypk)
}

// 仮引数の型 p（型パラメータ YVar を含む）と実引数の型 a を突き合わせ、決まっていない型パラメータを env に書く
func yUnify(st mut S, p int, a int, env ListRef) {
    if p < 0 || a < 0 {
        return
    }
    x := YAt(mut st, p)
    if x.k == YVar {
        if yk(mut st, a) == YNil || yk(mut st, a) == YNone {
            return
        }
        if x.a < lenL(mut st, env) && latI(mut st, env, x.a) == -1 {
            yput(mut st, env, x.a, a)
        }
        return
    }
    y := YAt(mut st, a)
    if x.k != y.k {
        return
    }
    if x.k == YSlice || x.k == YOpt {
        yUnify(mut st, x.a, y.a, env)
    } else if x.k == YMap {
        yUnify(mut st, x.a, y.a, env)
        yUnify(mut st, x.b, y.b, env)
    } else if x.k == YDecl {
        if x.a == y.a && x.c >= 0 && y.c >= 0 {
            yUnifyList(mut st, yLc(x), yLc(y), env)
        }
    } else if x.k == YFn {
        yUnifyList(mut st, yLa(x), yLa(y), env)
        yUnifyList(mut st, yLb(x), yLb(y), env)
    } else if x.k == YTuple {
        yUnifyList(mut st, yLa(x), yLa(y), env)
    }
}

func yUnifyList(st mut S, pl ListRef, al ListRef, env ListRef) {
    if lenL(mut st, pl) != lenL(mut st, al) {
        return
    }
    for i <- iter.Range(0, lenL(mut st, pl)) {
        yUnify(mut st, latI(mut st, pl, i), latI(mut st, al, i), env)
    }
}

// ラムダ lam の本体を検査する（仮引数の型は注釈か、期待する関数型 pt の仮引数）。本体の値の型を返す
func yLambda(st mut S, lam NodeRef, pt0 int) int {
    // 値化可能な named fn type（値の位置のフィールド・仮引数・結果）は関数値の表層型として読む（optionのフィールド `F?` は中身 — 借りの仮引数の型が要る: (α-L0)）
    pt := yFnView(mut st, if pt0 >= 0 && yk(mut st, pt0) == YOpt { YAt(mut st, pt0).a } else { pt0 })
    if pt >= 0 && yk(mut st, pt) == YFn && capEntry(mut st, lam) >= 0 && lamRec(mut st, lam) < 0 {
        // 値の位置のラムダの期待型（lowerがenvの形をKごとに集めるインターフェース — named fn type は宣言・匿名は関数型の表層型）
        table.Push(mut st.ty.ylamN, int(lam))
        table.Push(mut st.ty.ylamK, if YAt(mut st, pt).c > 0 { YAt(mut st, pt).c - 1 } else { 0 - 1 })
        table.Push(mut st.ty.ylamY, pt)
    }
    // mut仮引数のある関数型の位置のラムダは、ラムダの節に期待型を記録する（analyzerが仮引数をmut仮引数として数えるインターフェース — LamMutSeats）
    if pt >= 0 && yk(mut st, pt) == YFn && yFnSeats(mut st, YAt(mut st, pt)) != 0 {
        yPut(mut st, int(lam), pt)
    }
    saved := st.yenv
    ps := lA(nodeOf(mut st, lam))
    fps := if yk(mut st, pt) == YFn { yLa(YAt(mut st, pt)) } else { -1 }
    for i <- iter.Range(0, lenL(mut st, ps)) {
        p := nodeOf(mut st, latN(mut st, ps, i))
        t := if nB(p) != -1 {
            yTe(mut st, st.ypk, st.ytps, nB(p))
        } else if fps != -1 && i < lenL(mut st, fps) {
            latI(mut st, fps, i)
        } else {
            -1
        }
        yBindName(mut st, sA(p), t)
    }
    st.ylam += 1
    r := yExpr(mut st, nB(nodeOf(mut st, lam)))
    st.ylam -= 1
    st.yenv = saved
    return r
}

// 組み込みの呼び出しの結果の型（組み込みでなければ -2）
func yBuiltin(st mut S, name StrRef, args ListRef) int {
    if strIs(mut st, name, "delete") && lenL(mut st, args) >= 1 {
        // delete(m, k) はmのbufferへの書き（他のpackageのstructのフィールドを通すなら拒否 — fieldwrite.sober）
        yFieldWrite(mut st, latN(mut st, args, 0))
    }
    if strIs(mut st, name, "println") || strIs(mut st, name, "delete") {
        return yBase(YNone)
    }
    if strIs(mut st, name, "panic") || strIs(mut st, name, "$unreach") {
        // `panic(L{…})` は戻らない（returnと同じ — 兄弟の分岐の型に合う）
        return yBase(YNever)
    }
    if strIs(mut st, name, "len") {
        return yBase(YInt)
    }
    if strIs(mut st, name, "bytes") {
        return yMk(mut st, YSlice, yByte(), 0, 0)
    }
    if IsStdPkg(mut st, st.ypk) {
        // std 専用の組み込み（`@intrinsic("鍵")` の宣言 — 結果の型は鍵の署名から・bytesToString）
        sk := SysKey(mut st, st.ypk, name)
        if sk != 0 {
            r := SysResult(sk)
            return if r == 'b' { yMk(mut st, YSlice, yByte(), 0, 0) } else if r == 'm' { yMk(mut st, YSlice, yBase(YInt), 1, 0) } else if r == 'x' { yMk(mut st, YSlice, yByte(), 1, 0) } else if r == 'f' { yFloat() } else { yBase(YInt) }
        }
        if strIs(mut st, name, "bytesToString") {
            return yBase(YString)
        }
    }
    if lenL(mut st, args) == 0 {
        return -2
    }
    a0 := YTypeOf(mut st, latN(mut st, args, 0))
    if strIs(mut st, name, "append") {
        if yk(mut st, a0) == YSlice {
            for i <- iter.Range(1, lenL(mut st, args)) {
                if yCand(mut st, latN(mut st, args, i)) {
                    yNoteImplicit(mut st, latN(mut st, args, i), YAt(mut st, a0).a)
                }
            }
        }
        return a0
    }
    if strIs(mut st, name, "freeze") {
        if yk(mut st, a0) == YSlice {
            return yMk(mut st, YSlice, YAt(mut st, a0).a, 0, 0)
        }
        if yk(mut st, a0) == YMap {
            return yMk(mut st, YMap, YAt(mut st, a0).a, YAt(mut st, a0).b, 0)
        }
        return a0
    }
    if strIs(mut st, name, "keys") {
        return if yk(mut st, a0) == YMap { yMk(mut st, YSlice, YAt(mut st, a0).a, 0, 0) } else { -1 }
    }
    // clone(x): 新しいmutのコピー（freezeの双対 — mut / immのどちらからも）
    if strIs(mut st, name, "clone") {
        if yk(mut st, a0) == YSlice {
            return yMk(mut st, YSlice, YAt(mut st, a0).a, 1, 0)
        }
        return if yk(mut st, a0) == YMap { yMk(mut st, YMap, YAt(mut st, a0).a, YAt(mut st, a0).b, 1) } else { -1 }
    }
    return -2
}

// リテラル `T{…}`（struct・variant・errorラベル）の型。フィールドの値も検査する
func yComposite(st mut S, e NodeRef) int {
    t := yComposite0(mut st, e)
    // フィールドの値（関数型のフィールドのラムダはフィールドの型で仮引数に型を付ける）
    elems := lB(nodeOf(mut st, e))
    for i <- iter.Range(0, lenL(mut st, elems)) {
        el := nodeOf(mut st, latN(mut st, elems, i))
        v := nB(el)
        yFieldGive(mut st, t, if el.a >= 0 { sA(el) } else { StrRef(-1) }, i, v)
        yDangerGive(mut st, t, if el.a >= 0 { sA(el) } else { StrRef(-1) }, v)
        if kindN(mut st, v) == ast.ELambda {
            ft := if el.a >= 0 { yField(mut st, t, sA(el)) } else { yFieldAt(mut st, t, i) }
            yLambda(mut st, v, ft)
        } else {
            yExpr(mut st, v)
            if yCand(mut st, v) {
                ft0 := if el.a >= 0 { yField(mut st, t, sA(el)) } else { yFieldAt(mut st, t, i) }
                // unionのvariantのcompositeのフィールドも暗黙のfreezeの点（language.md — 「compositeのフィールド」にstruct / variantの区別は無い）
                ft := if ft0 != -1 { ft0 } else { yVariantField(mut st, e, if el.a >= 0 { sA(el) } else { StrRef(-1) }, i) }
                yNoteImplicit(mut st, v, ft)
                // immのフィールドに、点にならないmutのコンテナ（呼び出しの結果・局所の束縛のラムダの呼び出し — 捕捉した束縛の別名でありうる）を置く形は拒否。
                // コアのstructは直積でフィールドの型を持たないので、ここで拒否しないとcheckは受理しbuildのlowerだけが落とす
                have := YTypeOf(mut st, v)
                if ft >= 0 && have >= 0 && yFreezes(mut st, have, ft) && !IsImplicit(mut st, v) {
                    yFieldNote(mut st, 6, v, StrRef(-1), -1)
                }
            }
        }
    }
    return t
}

// variantのcomposite e（型引数の無いunion）のフィールドの型（名前nameか位置i — 解決できなければ -1）
func yVariantField(st mut S, e NodeRef, name StrRef, i int) int {
    vr := findVariant(mut st, st.ypk, sA(nodeOf(mut st, e)))
    if vr.decl == -1 || vr.decl == NodeRef(ERRS) || lenL(mut st, lB(nodeOf(mut st, vr.decl))) > 0 {
        return -1
    }
    v := vat(mut st, vr.decl, vr.idx)
    fs := vfields(mut st, v)
    idx := if name != -1 { fieldIndex(mut st, fs, name) } else { i }
    if idx < 0 || idx >= lenL(mut st, fs) {
        return -1
    }
    return yTe(mut st, vpkgOr(mut st, v, vr.pkg), ListRef(listN(mut st, 0)), nB(nodeOf(mut st, latN(mut st, fs, idx))))
}

func yComposite0(st mut S, e NodeRef) int {
    name := sA(nodeOf(mut st, e))
    r := ResolveType(mut st, st.ypk, name)
    if r.kind == TopType {
        d := nodeOf(mut st, NodeRef(r.idx))
        if kindN(mut st, nC(d)) == ast.BError {
            return yMk(mut st, YLabel, 0, 0, 0)
        }
        ntp := lenL(mut st, lB(d))
        ta := lC(nodeOf(mut st, e))
        if ntp == 0 {
            return yDecl(mut st, NodeRef(r.idx), r.pkg, -1)
        }
        if ta == -1 || lenL(mut st, ta) != ntp {
            return -1
        }
        args := yTeList(mut st, st.ypk, st.ytps, ta)
        return if args == -1 { -1 } else { yDecl(mut st, NodeRef(r.idx), r.pkg, args) }
    }
    vr := findVariant(mut st, st.ypk, name)
    if vr.decl == NodeRef(ERRS) {
        return yMk(mut st, YLabel, 0, 0, 0)
    }
    if vr.decl == -1 || lenL(mut st, lB(nodeOf(mut st, vr.decl))) > 0 {
        return -1
    }
    return yDecl(mut st, vr.decl, vr.pkg, -1)
}

// 分岐の型の合流（片方が戻らなければ他方・一致ならそれ・片方が値なしなら値なし）
func yJoin(st mut S, a int, b int) int {
    if a < 0 || b < 0 {
        return -1
    }
    if yEq(mut st, a, b) || yk(mut st, b) == YNever {
        return a
    }
    if yk(mut st, a) == YNever {
        return b
    }
    if yk(mut st, a) == YNone || yk(mut st, b) == YNone {
        return yBase(YNone)
    }
    // nilの分岐は兄弟の分岐のT?（`if c { v } else { nil }` — 兄弟がT? ならそのまま）
    if yk(mut st, b) == YNil {
        return yNilUp(mut st, a)
    }
    if yk(mut st, a) == YNil {
        return yNilUp(mut st, b)
    }
    // Tの分岐とT? の分岐はT?（`if c { "a" } else if d { "b" } else { nil }` の内側のif・`else { o }` — T? の期待位置の合流）
    if yk(mut st, a) == YOpt && yOptHolds(mut st, a, b) {
        return a
    }
    if yk(mut st, b) == YOpt && yOptHolds(mut st, b, a) {
        return b
    }
    return -1
}

// nilの分岐と合流する分岐の型tのT?（T? ならそのまま・errorのラベルはerror?）
func yNilUp(st mut S, t int) int {
    if yk(mut st, t) == YOpt {
        return t
    }
    return yMk(mut st, YOpt, if yk(mut st, t) == YLabel { yBase(YErr) } else { t }, 0, 0)
}

// T? のoが分岐の型tの値を中身に持てるか（tが中身そのもの・error? にラベル）
func yOptHolds(st mut S, o int, t int) bool {
    in := YAt(mut st, o).a
    return yEq(mut st, in, t) || (yk(mut st, in) == YErr && yk(mut st, t) == YLabel)
}

// 条件 c が `x != nil` / `x == nil`（x は T? の局所）なら (名前, 中身の型, then 側が値ありか)。でなければ名前 -1
func yNilTest(st mut S, c NodeRef) (StrRef, int, bool) {
    if kindN(mut st, c) != ast.EBinary {
        return -1, -1, false
    }
    op := nodeOf(mut st, c).a
    if op != lexer.EqualEqual && op != lexer.BangEqual {
        return -1, -1, false
    }
    lhs := nB(nodeOf(mut st, c))
    rhs := nC(nodeOf(mut st, c))
    side := if kindN(mut st, lhs) == ast.ENil { rhs } else if kindN(mut st, rhs) == ast.ENil { lhs } else { -1 }
    if side == -1 || kindN(mut st, side) != ast.EIdent {
        return -1, -1, false
    }
    t := yLookup(mut st, sA(nodeOf(mut st, side)))
    if yk(mut st, t) != YOpt {
        return -1, -1, false
    }
    return sA(nodeOf(mut st, side)), YAt(mut st, t).a, op == lexer.BangEqual
}

func yIf(st mut S, e NodeRef) int {
    yExpr(mut st, nA(nodeOf(mut st, e)))
    nn, inner, someThen := yNilTest(mut st, nA(nodeOf(mut st, e)))
    saved := st.yenv
    nmark := len(st.yNrw)
    if nn != -1 && IfWrites(mut st, e, nn) {
        st.yNrw = append(st.yNrw, int(nn))
        st.yNrw = append(st.yNrw, yLookup(mut st, nn))
    }
    if nn != -1 && someThen {
        yBindName(mut st, nn, inner)
    }
    t := yBlock(mut st, lA(nodeOf(mut st, nB(nodeOf(mut st, e)))))
    st.yenv = saved
    el := nC(nodeOf(mut st, e))
    if el == -1 {
        st.yNrw = st.yNrw[0:nmark]
        return yBase(YNone)
    }
    if nn != -1 && !someThen {
        yBindName(mut st, nn, inner)
    }
    o := yExpr(mut st, el)
    st.yNrw = st.yNrw[0:nmark]
    st.yenv = saved
    j := yJoin(mut st, t, o)
    if j < 0 && t >= 0 && o >= 0 {
        // 型なしの定数の分岐は兄弟の分岐の named scalar に割り当てる（language.md 32 節 — lowerのifExprと同じ）
        if yNamedOver(mut st, t, o) && yArmUntyped(mut st, el) {
            return t
        }
        if yNamedOver(mut st, o, t) && yArmUntyped(mut st, nB(nodeOf(mut st, e))) {
            return o
        }
    }
    return j
}

// n が named scalar で、その下地が u か（byte は int の型なしの定数を受ける — language.md 33 節）
func yNamedOver(st mut S, n int, u int) bool {
    if yk(mut st, n) == YByte {
        return yk(mut st, u) == YInt
    }
    if yk(mut st, n) != YDecl || kindN(mut st, nC(nodeOf(mut st, yNa(YAt(mut st, n))))) != ast.BDefined {
        return false
    }
    un := NamedUnder(mut st, NodeRef(YAt(mut st, n).a))
    return (un == 0 && yk(mut st, u) == YInt) || (un == 1 && yk(mut st, u) == YBool)
}

// 値のif（elseつき）/ switchの分岐が全部、値が型なしの定数か
func yArmsUntyped(st mut S, e NodeRef) bool {
    k := kindN(mut st, e)
    if k == ast.EIf {
        return nC(nodeOf(mut st, e)) != -1 && yArmUntyped(mut st, nB(nodeOf(mut st, e))) && yArmUntyped(mut st, nC(nodeOf(mut st, e)))
    }
    if k != ast.ESwitch {
        return false
    }
    cs := lB(nodeOf(mut st, e))
    for i <- iter.Range(0, lenL(mut st, cs)) {
        if !yArmUntyped(mut st, nB(nodeOf(mut st, latN(mut st, cs, i)))) {
            return false
        }
    }
    dflt := nC(nodeOf(mut st, e))
    return dflt == -1 || yArmUntyped(mut st, dflt)
}

// ifの分岐a（thenのKBlock・elseのEBlockか式）の値が型なしの定数か（ブロックなら末尾の式文 — 前の文は問わない。lowerのarmUntypedと同じ）
func yArmUntyped(st mut S, a NodeRef) bool {
    k := kindN(mut st, a)
    if k == ast.KBlock || k == ast.EBlock {
        l := lA(nodeOf(mut st, a))
        n := lenL(mut st, l)
        if n == 0 || kindN(mut st, latN(mut st, l, n - 1)) != ast.SExpr {
            return false
        }
        return yArmUntyped(mut st, nA(nodeOf(mut st, latN(mut st, l, n - 1))))
    }
    if k == ast.EIdent && yLookup(mut st, sA(nodeOf(mut st, a))) != -2 {
        return false
    }
    return isUntypedConst(mut st, a, -1, st.ypk)
}

func ySwitch(st mut S, e NodeRef) int {
    subs := lA(nodeOf(mut st, e))
    yExprs(mut st, subs)
    // subject ごとの型（1 つの多値の呼び出しは成分ごと）
    ns := lenL(mut st, subs)
    s0 := if ns == 1 { YTypeOf(mut st, latN(mut st, subs, 0)) } else { -1 }
    mut sl := ListRef(listN(mut st, ns))
    for j <- iter.Range(0, ns) {
        yput(mut st, sl, j, YTypeOf(mut st, latN(mut st, subs, j)))
    }
    if yk(mut st, s0) == YTuple {
        sl = yLa(YAt(mut st, s0))
    }
    mut acc := -3
    mut catchAll := false
    mut typed := false
    cs := lB(nodeOf(mut st, e))
    for i <- iter.Range(0, lenL(mut st, cs)) {
        c := latN(mut st, cs, i)
        saved := st.yenv
        pats := lA(nodeOf(mut st, c))
        for j <- iter.Range(0, lenL(mut st, pats)) {
            p := latN(mut st, pats, j)
            catchAll = catchAll || yCatchAll(mut st, p)
            typed = typed || (ns <= 1 && kindN(mut st, p) == ast.KPType)
            yPattern(mut st, p, if j < lenL(mut st, sl) { latI(mut st, sl, j) } else { -1 })
        }
        v := yBlock(mut st, lA(nodeOf(mut st, nB(nodeOf(mut st, c)))))
        st.yenv = saved
        acc = if acc == -3 { v } else { yJoin(mut st, acc, v) }
    }
    dflt := nC(nodeOf(mut st, e))
    if dflt != -1 {
        v := yBlock(mut st, lA(nodeOf(mut st, dflt)))
        acc = if acc == -3 { v } else { yJoin(mut st, acc, v) }
    } else if acc != -3 && yk(mut st, acc) == YNever && !catchAll && !typed {
        // defaultも全域のcaseも無く、分岐が全部戻らない: 外れは何もせず後ろへ続く（値なし）。
        // 単一の subject の型パターンの switch は網羅が check / lower の網羅検査で保証され（error の switch の外れは panic）外れに来ない
        acc = yBase(YNone)
    }
    return if acc == -3 { -1 } else { acc }
}

// パターン p が全域の定数パターン（`_` か、裸の束縛 1 つ — yPattern の束縛の判定と同じ）か
func yCatchAll(st mut S, p NodeRef) bool {
    if kindN(mut st, p) != ast.KPConst {
        return false
    }
    alts := lA(nodeOf(mut st, p))
    if hasWildcard(mut st, alts) {
        return true
    }
    if lenL(mut st, alts) != 1 || kindN(mut st, latN(mut st, alts, 0)) != ast.EIdent {
        return false
    }
    n := sA(nodeOf(mut st, latN(mut st, alts, 0)))
    return yLookup(mut st, n) == -2 && !strIs(mut st, n, "true") && !strIs(mut st, n, "false") && !HasTopName(mut st, st.ypk, n)
}

// パターンp（subjectの型s）の束縛を積む（型パターンはvariantのフィールドの型、裸の識別子はsubjectの型）
func yPattern(st mut S, p NodeRef, s int) {
    k := kindN(mut st, p)
    if k == ast.KPConst {
        alts := lA(nodeOf(mut st, p))
        if lenL(mut st, alts) == 1 && kindN(mut st, latN(mut st, alts, 0)) == ast.EIdent {
            n := sA(nodeOf(mut st, latN(mut st, alts, 0)))
            if !strIs(mut st, n, "_") && yLookup(mut st, n) == -2 && !strIs(mut st, n, "true") && !strIs(mut st, n, "false") && !HasTopName(mut st, st.ypk, n) {
                yBindName(mut st, n, s)
                return
            }
        }
        for i <- iter.Range(0, lenL(mut st, alts)) {
            a := latN(mut st, alts, i)
            if !(kindN(mut st, a) == ast.EIdent && strIs(mut st, sA(nodeOf(mut st, a)), "_")) {
                yExpr(mut st, a)
            }
        }
        return
    }
    if k != ast.KPType {
        return
    }
    pn := nodeOf(mut st, p)
    if pn.a >= 0 {
        yBindName(mut st, sA(pn), s)
    }
    vr := findVariant(mut st, st.ypk, sB(pn))
    v := if vr.decl == -1 { -1 } else { vat(mut st, vr.decl, vr.idx) }
    fps := lC(pn)
    for i <- iter.Range(0, lenL(mut st, fps)) {
        fp := nodeOf(mut st, latN(mut st, fps, i))
        mut ft := -1
        mut isCause := false
        if v != -1 {
            vfs := vfields(mut st, v)
            idx := fieldIndex(mut st, vfs, sA(fp))
            if idx < 0 && vr.decl == NodeRef(ERRS) && strIs(mut st, sA(fp), "cause") {
                // error ラベルの自動フィールド cause（R4b K1'' — error?）
                ft = yMk(mut st, YOpt, yBase(YErr), 0, 0)
                isCause = true
            }
            if idx >= 0 {
                tps := if vr.decl == NodeRef(ERRS) { ListRef(-1) } else { lB(nodeOf(mut st, vr.decl)) }
                ft = yTe(mut st, vpkgOr(mut st, v, vr.pkg), tps, nB(nodeOf(mut st, latN(mut st, vfs, idx))))
                ft = ySubst(mut st, ft, if yk(mut st, s) == YDecl { yLc(YAt(mut st, s)) } else { -1 })
            }
        }
        sub := nB(fp)
        if sub != -1 {
            // cause の型パターン（`cause: e A{…}` — language.md 13 節 A6）は nil でない内側の error に照合する
            yPattern(mut st, sub, if isCause && kindN(mut st, sub) == ast.KPType { yBase(YErr) } else { ft })
        } else {
            yBindName(mut st, sA(fp), ft)
        }
    }
}

// for（生成元の要素に名前を付けて本体を検査する — 生成元が slice のときだけ要素の型が分かる）
func yFor(st mut S, e NodeRef) {
    saved := st.yenv
    gens := lA(nodeOf(mut st, e))
    for i <- iter.Range(0, lenL(mut st, gens)) {
        g := nodeOf(mut st, latN(mut st, gens, i))
        names := lA(g)
        nn := lenL(mut st, names)
        srcN := nB(g)
        // 失敗しうる生成元のマーク `g(a)?` は `?` の内側の呼び出しを呼び出し形として見る（呼び出し形でなければ普通の `?` の式 — 下の値のパス）
        mut el := yGenCall(mut st, srcN)
        if el == -2 && kindN(mut st, srcN) == ast.ETry {
            el = yGenCall(mut st, nA(nodeOf(mut st, srcN)))
        }
        mut el2 := -1
        if el == -2 {
            src := yExpr(mut st, srcN)
            el = yElemOf(mut st, src)
            if yk(mut st, src) == YMap {
                el2 = YAt(mut st, src).b
            }
            // sliceの生成元は書き換えiter.Slice(xs, k) のxs（imm []T）の位置 — mutのsliceのパスは暗黙のfreeze（17 節）
            if yk(mut st, src) == YSlice && el >= 0 && yCand(mut st, srcN) {
                yNoteImplicit(mut st, srcN, yMk(mut st, YSlice, el, 0, 0))
                yPut(mut st, 0 - FORSRCKEY - int(srcN), 1)
            }
        }
        for j <- iter.Range(0, nn) {
            yBindName(mut st, latS(mut st, names, j), if j == 0 { el } else if j == 1 && nn == 2 { el2 } else { -1 })
        }
        yExprs(mut st, lC(g))
    }
    saved_y := st.yyield
    st.yyield = -3
    if nodeOf(mut st, e).b == 0 {
        st.yyield = yExpr(mut st, nC(nodeOf(mut st, e)))
    } else {
        yBlock(mut st, lC(nodeOf(mut st, e)))
    }
    if st.yyield >= 0 {
        yPut(mut st, 0 - 1 - int(e), st.yyield)
    }
    st.yyield = saved_y
    st.yenv = saved
}

// for 式 e の yield の型（yield 形の式・ブロック形の yield 文の型が 1 つに揃うとき。でなければ -1）
func YYieldOf(st mut S, e NodeRef) int {
    return yGet(mut st, 0 - 1 - int(e))
}

// 生成元の型 src の要素の型（slice の要素・map のキー・Iter[T]（名前付き関数型 func(func(T))）の T）
func yElemOf(st mut S, src int) int {
    k := yk(mut st, src)
    if k == YSlice || k == YMap {
        return YAt(mut st, src).a
    }
    if k == YDecl {
        return yIterElem(mut st, src)
    }
    if k == YFn {
        // 展開済みの Iter[T]（func(func(E))）
        x := YAt(mut st, src)
        if lenL(mut st, yLa(x)) == 1 && lenL(mut st, yLb(x)) == 0 {
            cb := latI(mut st, yLa(x), 0)
            if yk(mut st, cb) == YFn && lenL(mut st, yLa(YAt(mut st, cb))) == 1 {
                return latI(mut st, yLa(YAt(mut st, cb)), 0)
            }
        }
    }
    return -1
}

// 値化可能な named fn type の値（YDecl — 値の位置のクロージャ・closure.sober）を関数値の表層型YFnとして読む（他はそのまま）
func yFnView(st mut S, y int) int {
    if y < 0 || yk(mut st, y) != YDecl {
        return y
    }
    x := YAt(mut st, y)
    if !fnValDeclNode(mut st, yNa(x)) {
        return y
    }
    body := nC(nodeOf(mut st, yNa(x)))
    tps := ListRef(listN(mut st, 0))
    ps := yTeList(mut st, x.b, tps, lA(nodeOf(mut st, body)))
    rs := yTeList(mut st, x.b, tps, lB(nodeOf(mut st, body)))
    return if ps == -1 || rs == -1 { y } else { yFnT(mut st, ps, rs, int(yNa(x)) + 1) }
}

// 名前付き関数型 `type X[T] func(func(E))` の値の要素の型 E（型引数を代入する）
func yIterElem(st mut S, y int) int {
    x := YAt(mut st, y)
    body := nC(nodeOf(mut st, yNa(x)))
    if kindN(mut st, body) != ast.BFunc {
        return -1
    }
    ps := lA(nodeOf(mut st, body))
    if lenL(mut st, ps) != 1 {
        return -1
    }
    cb := latN(mut st, ps, 0)
    if kindN(mut st, cb) != ast.TFunc || lenL(mut st, lA(nodeOf(mut st, cb))) != 1 {
        return -1
    }
    return ySubst(mut st, yTe(mut st, x.b, lB(nodeOf(mut st, yNa(x))), latN(mut st, lA(nodeOf(mut st, cb)), 0)), yLc(x))
}

// 呼び出し形の生成元（`for x <- f(a…)` — f の最後の仮引数が関数型 func(E) で、実引数が 1 つ少ない）の要素の型 E。
// 呼び出し形でなければ -2（生成元は値として検査する）
func yGenCall(st mut S, src NodeRef) int {
    if kindN(mut st, src) != ast.ECall {
        return -2
    }
    callee := nA(nodeOf(mut st, src))
    args := lB(nodeOf(mut st, src))
    cx := nodeOf(mut st, callee)
    // クロージャの名前の呼び出し形（L-for — 束縛の型が匿名の関数型で、仮引数が実引数より1つ多く、最後が1引数の関数型）
    lt := if cx.kind == ast.EIdent { yLookup(mut st, sA(cx)) } else { -2 }
    if lt >= 0 && yk(mut st, lt) == YFn && YAt(mut st, lt).c <= 0 {
        lps := yLa(YAt(mut st, lt))
        nl := lenL(mut st, lps)
        if nl != lenL(mut st, args) + 1 {
            return -2
        }
        cb := latI(mut st, lps, nl - 1)
        if yk(mut st, cb) != YFn || lenL(mut st, yLa(YAt(mut st, cb))) != 1 {
            return -2
        }
        yArgs(mut st, args)
        return latI(mut st, yLa(YAt(mut st, cb)), 0)
    }
    fi := if cx.kind == ast.EIdent && yLookup(mut st, sA(cx)) == -2 {
        ResolveFn(mut st, st.ypk, sA(cx))
    } else if cx.kind == ast.ESelector && kindN(mut st, nA(cx)) == ast.EIdent && yLookup(mut st, sA(nodeOf(mut st, nA(cx)))) == -2 && importRef(mut st, st.ypk, sA(nodeOf(mut st, nA(cx)))) {
        ResolveSelFn(mut st, st.ypk, sA(nodeOf(mut st, nA(cx))), sB(cx))
    } else {
        -1
    }
    if fi < 0 {
        return -2
    }
    ps := fnParams(mut st, fi)
    np := lenL(mut st, ps)
    if np != lenL(mut st, args) + 1 || kindN(mut st, nB(nodeOf(mut st, latN(mut st, ps, np - 1)))) != ast.TFunc {
        return -2
    }
    yArgs(mut st, args)
    tps := fnTParams(mut st, fi)
    fpk := fnPkg(mut st, fi)
    env := ylN(mut st, lenL(mut st, tps))
    for j <- iter.Range(0, lenL(mut st, tps)) {
        yput(mut st, env, j, -1)
    }
    at := yArgTys(mut st, args)
    pts := ListRef(listN(mut st, np - 1))
    for j <- iter.Range(0, np - 1) {
        yput(mut st, pts, j, yTe(mut st, fpk, tps, nB(nodeOf(mut st, latN(mut st, ps, j)))))
    }
    yInfer(mut st, pts, args, at, np - 1, env, -1)
    if lenL(mut st, tps) > 0 {
        // 型引数を表へ（書き換え `f(a…, (x) => …)` は元の callee の節のまま — lower が読む）
        yPut(mut st, 0 - 1 - int(callee), yTuple(mut st, env))
        yNoteEdge(mut st, fi, env)
    }
    cb := yTe(mut st, fpk, tps, nB(nodeOf(mut st, latN(mut st, ps, np - 1))))
    if yk(mut st, cb) != YFn || lenL(mut st, yLa(YAt(mut st, cb))) != 1 {
        return -1
    }
    return ySubst(mut st, latI(mut st, yLa(YAt(mut st, cb)), 0), env)
}

// for の書き換えが合成した iter.Slice の呼び出し（callee の節 callee）の型引数を、元の生成元 src の要素の型から
// 表に載せる（検査器が走っていなければ何もしない — check の経路）
func yNoteGenTArgs(st mut S, callee NodeRef, src NodeRef) {
    if table.Len(mut st.ty.ybucket) == 0 {
        return
    }
    t := YTypeOf(mut st, src)
    k := yk(mut st, t)
    if k == YSlice || k == YMap {
        yPut(mut st, 0 - 1 - int(callee), yTuple(mut st, yl1(mut st, YAt(mut st, t).a)))
    }
}

// ── desugar 側の差分オラクル（check --typer-diff — C1 B3 の入口）: exprSty（名前の区別つきの表層型 — surface.sober）を
// 表の表層型から変換したもの（yToSty）と突き合わせる ──

// 表層型 y の surface.sober の表層型（SUNK / SFREE / 型宣言 / 名前を含む slice・map）
func yToSty(st mut S, y int) int {
    k := yk(mut st, y)
    // nil・値なし・戻らない・多値は照合しない（nil はどの T? にも置ける — named scalar の T? を含む）
    if k < 0 || k == YErr || k == YLabel || k == YVar || k == YNil || k == YNone || k == YNever || k == YTuple {
        return SUNK
    }
    x := YAt(mut st, y)
    switch k {
    case YDecl:
        mut s := sDecl(mut st, NodeRef(x.a))
        if yLc(x) != -1 {
            for i <- iter.Range(0, lenL(mut st, yLc(x))) {
                s = sGenArg(mut st, NodeRef(x.a), s, yToSty(mut st, latI(mut st, yLc(x), i)))
            }
        }
        return s
    case YFn:
        return if x.c > 0 { sDecl(mut st, NodeRef(x.c - 1)) } else { SFREE }
    case YOpt:
        return yToSty(mut st, x.a)
    case YSlice:
        e := yToSty(mut st, x.a)
        return if e == SFREE || e == SUNK { e } else { sIntern(mut st, SKSlice, 0, e, 0) }
    case YMap:
        a := yToSty(mut st, x.a)
        b := yToSty(mut st, x.b)
        if a == SUNK || b == SUNK {
            return SUNK
        }
        return if a == SFREE && b == SFREE { SFREE } else { sIntern(mut st, SKMap, 0, a, b) }
    }
    return SFREE
}

// 節 e の表の表層型を surface.sober の形で（表に無い・不明の成分がある・型パラメータ・error は SUNK）
func yStyOf(st mut S, e NodeRef) int {
    y := YTypeOf(mut st, e)
    return if y < 0 || YHasHole(mut st, y) { SUNK } else { yToSty(mut st, y) }
}

// 表層型 y のコア型（int・bool・その named scalar だけ — region を持たない型。他は -1）
func yLocFreeTy(st mut S, y int) TyRef {
    k := yk(mut st, y)
    if k == YInt {
        return st.tInt
    }
    if k == YBool {
        return st.tBool
    }
    if k == YDecl && kindN(mut st, nC(nodeOf(mut st, yNa(YAt(mut st, y))))) == ast.BDefined {
        u := namedUnder(mut st, NodeRef(YAt(mut st, y).a))
        return if u == 0 { st.tInt } else if u == 1 { st.tBool } else { TyRef(-1) }
    }
    return -1
}

// 脱糖器が合成した節eの表層型k（基本の型）を表に載せる（補間の書き換え — 元の節の型をコピーする: D7）
func yNoteSyn(st mut S, e NodeRef, k int) {
    if table.Len(mut st.ty.ybucket) != 0 {
        yPut(mut st, int(e), yBase(k))
    }
}

func yCompareSty(st mut S, e NodeRef, s int) {
    if e == -1 || (int(e) >= SBASE && int(e) < LBASE) || s == SUNTYPED {
        st.ydskip += 1
        return
    }
    y := YTypeOf(mut st, e)
    t := yStyOf(mut st, e)
    if t == s {
        st.ydsame += 1
        return
    }
    if s == SUNK {
        st.ydgain += 1
        return
    }
    if t == SUNK {
        st.ydloss += 1
    } else {
        st.ydmis += 1
    }
    if table.Len(mut st.ydlog) < 400 {
        table.Push(mut st.ydlog, fileOf(mut st, e))
        table.Push(mut st.ydlog, tokN(mut st, e))
        table.Push(mut st.ydlog, if t == SUNK { 0 } else { 1 })
        table.Push(mut st.ydlog, yk(mut st, y))
    }
}

// inferTs の結果（ts — ok でなければ失敗）を表の型引数（callee の節 cn の YTArgsOf）と突き合わせる:
// 決まる / 決まらないが一致し、region を持たない型引数（yLocFreeTy）はコア型まで一致すること
func yCompareTArgs(st mut S, cn NodeRef, ts ListRef, ok bool) {
    // std/task の鍵（脱糖は呼び出し点のテンプレートで、inferTs は札・handle・端点の own 型を総称 struct と単一化できない）は突き合わせない
    pf := findFn(mut st, if kindN(mut st, cn) == ast.EIndex { nA(nodeOf(mut st, cn)) } else { cn }, -1)
    if pf >= 0 && ParKey(mut st, pf) != 0 {
        st.ydskip += 1
        return
    }
    ta := YTArgsOf(mut st, cn)
    mut at := ta != -1
    if at {
        for i <- iter.Range(0, lenL(mut st, ta)) {
            y := latI(mut st, ta, i)
            if y < 0 || YHasHole(mut st, y) {
                at = false
            }
        }
    }
    mut same := at == ok
    if same && ok {
        for i <- iter.Range(0, lenL(mut st, ta)) {
            c := yLocFreeTy(mut st, latI(mut st, ta, i))
            if c != -1 && !tyEql(mut st, c, latTy(mut st, ts, i)) {
                same = false
            }
        }
    }
    if same {
        st.ydtsame += 1
        return
    }
    st.ydtdiff += 1
    if table.Len(mut st.ydlog) < 400 {
        table.Push(mut st.ydlog, fileOf(mut st, cn))
        table.Push(mut st.ydlog, tokN(mut st, cn))
        table.Push(mut st.ydlog, 2)
        table.Push(mut st.ydlog, if ok { 1 } else { 0 })
    }
}

// 関数型の型式te（TFunc / BFunc）のmut仮引数のビット
func teMutMask(st mut S, te NodeRef) int {
    ps := lA(nodeOf(mut st, te))
    mut m := 0
    for i <- iter.Range(0, lenL(mut st, ps)) {
        if kindN(mut st, latN(mut st, ps, i)) == ast.TMutP {
            m = m | (1 << i)
        }
    }
    return m
}

// 関数型x（YFn）のmut仮引数のビット（名前なしはcに負で・名前付きは宣言の署名から）
func yFnSeats(st mut S, x YT) int {
    return if x.c <= 0 { 0 - x.c } else { teMutMask(mut st, nC(nodeOf(mut st, NodeRef(x.c - 1)))) }
}

// ラムダlamのmut仮引数のビット（書いたマークと、期待する関数型のmut仮引数 — 表層型検査器の記録）
func LamMutSeats(st mut S, lam NodeRef) int {
    ps := lA(nodeOf(mut st, lam))
    mut m := 0
    for i <- iter.Range(0, lenL(mut st, ps)) {
        if nodeOf(mut st, latN(mut st, ps, i)).c != 0 {
            m = m | (1 << i)
        }
    }
    y := yGet(mut st, int(lam))
    return if y >= 0 && yk(mut st, y) == YFn { m | yFnSeats(mut st, YAt(mut st, y)) } else { m }
}

// ラムダ lam の仮引数 i の型がスカラー（int・bool・byte・float・string — 中身を持たない）と分かるか（期待型の記録から）
func LamParamScalar(st mut S, lam NodeRef, i int) bool {
    y := yGet(mut st, int(lam))
    if y < 0 || yk(mut st, y) != YFn || i >= lenL(mut st, yLa(YAt(mut st, y))) {
        return false
    }
    k := yk(mut st, latI(mut st, yLa(YAt(mut st, y)), i))
    return k == YInt || k == YBool || k == YString || k == YByte || k == YFloat
}
