package desugar

// E2-S（docs/formal.md「checkのcallMの段階」）: checkの経路だけで、δ の対象（関数型の引数が無くmut引数だけが
// 展開の理由の非再帰関数 — loader の closed）のうち次を満たす関数を、展開でなく既存の callM（anchor つき呼び出し）の Def として出す。
//   1. mut 仮引数がちょうど 1 つ（anchor が 1 slot で足りる）
//   2. 他の仮引数が region を持たない型（imm 実引数の「anchor 以下」が呼び出し点に依らない）
// （旧条件5 — 本体の中で callM で呼ぶ関数へ mut 実引数を 2 つ以上渡さない — は 2026-11-23 に外した: 別の region の mut 実引数は
// セルの宛先構築〔allocAt〕で anchor に揃い、型付かない残りは逃げが拾う）
// 上げる判定は関数の署名と本体だけで決まる（packageの中で閉じる・判定D'）。呼び出し点の形に依る2つは、関数のフラグでなく呼び出し点ごとに選ぶ
// （e2sSiteInline — 形が合わない呼び出し点だけ展開する。展開は inline の許容性の論証の向き〔callM で型付く ⇒ 展開でも型付く〕に倒すだけ）:
//   4. フィールドの経路のmut実引数（`mut x.f`）を渡す呼び出し点
// 本体が Def として型付かなかった関数と、型引数が関数の kind を満たさない呼び出し点を持つ関数（条件3 — kind は検査器が推論した後にしか
// 分からないので、呼び出し点ごとではなく関数ごとに戻す）は、呼び手（checker の CheckE2 等）が検査器の判定で集めて e2sExcl に入れて
// 脱糖し直す（逃げ — 展開へ戻すのは型付けを緩めるだけなので単調に収束）。lower の経路（Init）は触らない — build は今どおり δ。

import "ast"
import "std/iter"
import "std/table"

// 条件 1・2 を満たし、逃げ（e2sExcl）に入っていない関数を callM の Def に上げる（表層型検査器の後・Def の番号の振り直しの前）
func e2sPromote(st mut S) {
    cand := ListRef(listN(mut st, st.nfn))
    for i <- iter.Range(0, st.nfn) {
        x := FnAt(mut st, i)
        if x.closed && !x.mutDef && !e2sExcluded(st.e2sExcl, i) && e2sSig(mut st, i) {
            lput(mut st, cand, i, 1)
        }
    }
    for i <- iter.Range(0, st.nfn) {
        if latI(mut st, cand, i) != 0 {
            mut x := FnAt(mut st, i)
            x.expands = false
            x.mutDef = true
            x.def = st.ndef
            st.ndef = st.ndef + 1
            table.Set(mut st.fns, i, x)
        }
    }
}

func e2sExcluded(xs []int, i int) bool {
    for k <- iter.Range(0, len(xs)) {
        if xs[k] == i {
            return true
        }
    }
    return false
}

// 条件 1・2（mut 仮引数がちょうど 1 つ・他の仮引数が region を持たない — 型パラメータそのものは条件 3 が見る）
func e2sSig(st mut S, i int) bool {
    ps := fnParams(mut st, i)
    tps := fnTParams(mut st, i)
    mut nm := 0
    for k <- iter.Range(0, lenL(mut st, ps)) {
        prm := nodeOf(mut st, latN(mut st, ps, k))
        if ast.ParamIsMut(prm) {
            nm += 1
        } else {
            te := nB(prm)
            mut isTp := false
            if kindN(mut st, te) == ast.TName {
                for q <- iter.Range(0, lenL(mut st, tps)) {
                    isTp = isTp || StrEq(mut st, sA(nodeOf(mut st, te)), latS(mut st, tps, q))
                }
            }
            if !isTp {
                t, err := tyOf(mut st, fnPkg(mut st, i), te, fnNode(mut st, i), TYFUEL)
                if err != nil || tyHasRegion(mut st, t) {
                    return false
                }
            }
        }
    }
    return nm == 1
}

// コア型 t が region を持つか（slice / map / ref — opt・union・prod の中も）
func tyHasRegion(st mut S, t TyRef) bool {
    k := tg(mut st, t)
    return switch k {
    case TSl | TMp | TRef: true
    case TPr | TUn: tyHasRegion(mut st, tLeft(mut st, t)) || tyHasRegion(mut st, tRight(mut st, t))
    case TOpt: tyHasRegion(mut st, tInner(mut st, t))
    default: false
    }
}

// package pk のファイルに書いた callee の節の指す関数（直接呼び出しでなければ -1）
func e2sCallee(st mut S, pk int, c NodeRef) int {
    b := if kindN(mut st, c) == ast.EIndex { nA(nodeOf(mut st, c)) } else { c }
    if kindN(mut st, b) == ast.EIdent {
        return ResolveFn(mut st, pk, sA(nodeOf(mut st, b)))
    }
    if kindN(mut st, b) == ast.ESelector && kindN(mut st, nA(nodeOf(mut st, b))) == ast.EIdent {
        return ResolveSelFn(mut st, pk, sA(nodeOf(mut st, nA(nodeOf(mut st, b)))), sB(nodeOf(mut st, b)))
    }
    return -1
}

// ファイルfの木の節nを本体に含む関数（無ければ -1）— 字句の区間で引く（省略可の関数型のコピーは節の区間 — zBlock）
func e2sEnclosing(st mut S, f int, n int) int {
    z := zBlock(mut st, f, n)
    if z >= 0 {
        return z
    }
    tok := st.trees[f].nodes[n].tok
    // 関数を全部たどらず、ファイル f の関数だけを昇順に見る（索引の外の、後から足した関数は続けて走査する）
    if st.nfn < st.e2sN || st.nfn - st.e2sN > 256 && st.nfn - st.e2sN > st.e2sN / 8 {
        e2sIndex(mut st)
    }
    nf := len(st.trees)
    if f >= 0 && f < nf && len(st.e2sIx) > nf {
        for k <- iter.Range(st.e2sIx[f], st.e2sIx[f + 1]) {
            i := st.e2sIx[nf + 1 + k]
            if e2sIn(mut st, i, f, tok) {
                return i
            }
        }
    }
    for i <- iter.Range(st.e2sN, st.nfn) {
        if e2sIn(mut st, i, f, tok) {
            return i
        }
    }
    return -1
}

// 関数 i がファイル f の字句 tok を範囲に含むか（省略可の匿名関数型の写しは除く）
func e2sIn(st mut S, i int, f int, tok int) bool {
    nd := fnNode(mut st, i)
    if fileOf(mut st, nd) == f && !ZVariant(mut st, i) {
        ext := nodeOf(mut st, nd).f
        return ext >= 0 && tok >= latI(mut st, ListRef(ext), 1) && tok < latI(mut st, ListRef(ext), 2)
    }
    return false
}

// 今の関数表 [0, nfn) から e2sEnclosing の索引を組む
func e2sIndex(st mut S) {
    nf := len(st.trees)
    n := st.nfn
    mut fo := mut []int{}
    for i <- iter.Range(0, n) {
        fo = append(fo, fileOf(mut st, fnNode(mut st, i)))
    }
    mut out := mut []int{}
    for k <- iter.Range(0, nf + 1 + n) {
        out = append(out, 0)
    }
    for i <- iter.Range(0, n) {
        if fo[i] >= 0 && fo[i] < nf {
            out[fo[i] + 1] += 1
        }
    }
    for k <- iter.Range(0, nf) {
        out[k + 1] += out[k]
    }
    mut fill := mut []int{}
    for k <- iter.Range(0, nf) {
        fill = append(fill, out[k])
    }
    for i <- iter.Range(0, n) {
        if fo[i] >= 0 && fo[i] < nf {
            out[nf + 1 + fill[fo[i]]] = i
            fill[fo[i]] += 1
        }
    }
    st.e2sIx = freeze(out)
    st.e2sN = n
}

// Def の添字 → 関数表の添字（上げた関数だけ。他は -1）— 逃げの判定で、検査器が落とした Def を関数へ引く
func E2Map(st mut S) []int {
    mut out := mut []int{}
    for j <- iter.Range(0, st.ndef) {
        out = append(out, -1)
    }
    for i <- iter.Range(0, st.nfn) {
        x := FnAt(mut st, i)
        if x.def >= 0 && x.def < st.ndef && x.closed && x.mutDef {
            out[x.def] = i
        }
    }
    return freeze(out)
}

// 関数 i が callM の Def に上げた関数か（check の経路だけ — lower の経路では closed の関数は展開のまま）
func fnPromoted(st mut S, i int) bool {
    x := FnAt(mut st, i)
    return x.closed && x.mutDef
}

// 上げた関数 fi の呼び出し点が callM で出せない形か（条件 4 — 呼び出し点ごとの選択。真ならその呼び出し点だけ展開する）
func e2sSiteInline(st mut S, fi int, explicit NodeRef, args ListRef, eb int, ef int, at NodeRef) bool {
    if !fnPromoted(mut st, fi) {
        return false
    }
    for q <- iter.Range(0, lenL(mut st, args)) {
        a := latN(mut st, args, q)
        if a != -1 && kindN(mut st, a) == ast.EMutArg && isDotted(mut st, a) {
            return true
        }
    }
    return false
}
