package desugar

// std/testing/cellの呼び出し点（language.md 41 節「状態を貯めるfake」）のコアの近似。格納場所はrtの外の状態で、コアからは
// ioの葉と同じく不透明: Get = 把手のinitフィールド（格納場所の値はコピーしたT — 型はinitと同じ）・Set = 実引数を評価して捨てる・
// Update = ラムダの仮引数をinitフィールドにまとめて本体を評価し、値を捨てる（書きの先は格納場所）

import "diag"
import "ast"

// 鍵 key の呼び出し（実引数 args）のコア
func cellCall(st mut S, key int, args ListRef, at NodeRef, eb int, ef int, depth int) (CoreRef, error?) {
    na := lenL(mut st, args)
    if na != (if key == CELL_GET { 1 } else { 2 }) {
        return 0, diag.Malformed{at: posOf(mut st, at)}
    }
    h0 := latN(mut st, args, 0)
    ht0 := computeTy(mut st, h0, eb, ef)
    if ht0 != -1 && tg(mut st, ht0) == TPr && !cellTyOk(mut st, tRight(mut st, ht0), 64) {
        return 0, diag.Cell{at: posOf(mut st, h0), kind: 11}
    }
    h := expr(mut st, h0, eb, ef, depth)?
    if key == CELL_GET {
        return projection(mut st, h, 1, 2), nil
    }
    // 置く値はT（呼び手の最内へコピーした形 — 外のregionの値は部分型で受ける）
    want := if ht0 != -1 && tg(mut st, ht0) == TPr { tyRelocAll(mut st, tRight(mut st, ht0), st.rdepth - 1) } else { TyRef(-1) }
    if want == -1 {
        return 0, diag.CoreFragment{at: posOf(mut st, at)}
    }
    if key == CELL_SET {
        v := coerceExpr(mut st, latN(mut st, args, 1), want, eb, ef, depth + 1, at)?
        return cLet(mut st, h, cLet(mut st, cAnn(mut st, v, want), cTriv(mut st))), nil
    }
    // ラムダのリテラルで仮引数 1 つ（loader の cellx.sober が保証する）
    lam := latN(mut st, args, 1)
    if kindN(mut st, lam) != ast.ELambda || lenL(mut st, lA(nodeOf(mut st, lam))) != 1 {
        return 0, diag.Malformed{at: posOf(mut st, lam)}
    }
    ht := computeTy(mut st, h0, eb, ef)
    dr := declOfExpr(mut st, h0, eb, ef)
    if ht == -1 || tg(mut st, ht) != TPr || dr < 0 {
        return 0, diag.CoreFragment{at: posOf(mut st, at)}
    }
    lp := latN(mut st, lA(nodeOf(mut st, lam)), 0)
    pt := nB(nodeOf(mut st, lp))
    d := if pt != -1 { declOfTypeExpr(mut st, st.curPkg, pt) } else { fieldDecl(mut st, dr, 1) }
    el := if pt != -1 { elemDeclOfTypeExpr(mut st, st.curPkg, pt) } else { -1 }
    sty := if pt != -1 { SurfaceOf(mut st, st.curPkg, pt) } else { SUNK }
    // 本体は h の束縛（level depth）と仮引数（depth + 1）の内側
    eb1 := bind(mut st, eb, strLit(mut st, "$cellh"), depth, false, dr, ht, -1, 0, -1, false, SUNK)
    // 仮引数は格納場所の値を呼び手の最内へ緩めた型（want）で受ける — 本体の外の値（仮引数のstringなど）を足すappendと座標が揃う
    eb2 := bind(mut st, eb1, sA(nodeOf(mut st, lp)), depth + 1, false, d, want, el, 0, -1, false, sty)
    lbody := nB(nodeOf(mut st, lam))
    body := if kindN(mut st, lbody) == ast.EBlock { scoped(mut st, lA(nodeOf(mut st, lbody)), eb2, ef, depth + 2, false, false, -1)? } else { expr(mut st, lbody, eb2, ef, depth + 2)? }
    return cLet(mut st, h, cLet(mut st, cAnn(mut st, projection(mut st, cVar(mut st, 0), 1, 2), want), cLet(mut st, cAnn(mut st, body, want), cTriv(mut st)))), nil
}

// 格納場所に置ける型か: クロージャの捕捉と同じ素のデータ（capTyOk）に、再帰型（μ の本体を見る・再帰の変数は組の成分 = 同じ判定の中）を足したもの
// （格納場所のコピーは再帰型をコピーできる — チャネルの送りと同じ梱包）
func cellTyOk(st mut S, t TyRef, fuel int) bool {
    if fuel == 0 {
        return false
    }
    k := tg(mut st, t)
    switch k {
    case TRVar: return true
    case TMuRs: return cellTyOk(mut st, muRsBody(mut st, t), fuel - 1)
    case TMuS: return cellTyOk(mut st, TyRef(tyAt(mut st, t).c), fuel - 1)
    case TPr | TUn: return cellTyOk(mut st, tLeft(mut st, t), fuel - 1) && cellTyOk(mut st, tRight(mut st, t), fuel - 1)
    case TOpt: return cellTyOk(mut st, tInner(mut st, t), fuel - 1)
    case TSl: return tMutBit(mut st, t) == 0 && cellTyOk(mut st, tElem(mut st, t), fuel - 1)
    case TMp: return tMutBit(mut st, t) == 0 && cellTyOk(mut st, tKey(mut st, t), fuel - 1) && cellTyOk(mut st, tVal(mut st, t), fuel - 1)
    default: return capTyOk(mut st, t)
    }
}

// `cell.Get(h)` の結果の型宣言（elem なら要素の宣言）: 把手の const の右辺 `cell.Cell[T]{…}` の型引数 T の型式から読む
// （総称の型引数の束縛は struct の宣言を持たないので、型パラメータの名前の結果からは引けない）。把手が const の参照でなければ -1
func cellDecl(st mut S, h NodeRef, eb int, elem bool) int {
    dc := dictConstOf(mut st, h, eb)
    if dc < 0 {
        return -1
    }
    r := dictEnter(mut st, ConPkg(mut st, dc))
    lit := nB(nodeOf(mut st, ConNode(mut st, dc)))
    mut d := -1
    if kindN(mut st, lit) == ast.EComposite && lenL(mut st, lC(nodeOf(mut st, lit))) == 1 {
        te := latN(mut st, lC(nodeOf(mut st, lit)), 0)
        d = if elem { elemDeclOfTypeExpr(mut st, st.curPkg, te) } else { declOfTypeExpr(mut st, st.curPkg, te) }
    }
    dictLeave(mut st, r)
    return d
}
