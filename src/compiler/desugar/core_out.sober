package desugar

// 脱糖の結果をプロセス内で渡すインターフェース（Sober版 `sober check` の直結 — compiler/tools/sobercheck。JSONを経ない）。
// 意味はJsonと同じ: runの結果（関数表・持ち上げたラムダのチェーン・根の式）を、ヒープの読み出し専用の眺めとして受け手kに渡す。
// 記録の形（Def の [param, ret, body, kinds, next]）は json.sober の印字が読む形そのまま。ラベルは Labels（CLabel の a = 添字）、型は Types（参照 − TBASE = 添字）、コア式は Exprs（参照 − CBASE = 添字）

import "loader"
import "std/iter"
import "std/table"
import "diag"

// ヒープの眺め。Defs = 名前付き関数の列 [n, def…]、Lifted = 持ち上げたラムダのチェーンの頭（def + 4 = 次、-1 = 終わり）
type Core struct {
    H []int
    Labels []Label
    Types []Ty
    Exprs []CoreExpr
    Defs int
    Lifted int
    Root int
    Orig []int   // 出所の列（追跡のとき — Exprs と同じ添字で PackPos の位置・0 = 無し。追跡でなければ空）
    Use []int    // 持ち上げの使いの辺 [ctx, 持ち上げ k]…（check の関数単位キャッシュの区間の子 — defcache.sober の luOut。でなければ空）
    DefFn []int  // 名前付きの Def の添字 → 関数表の添字（同じく — でなければ空）
    Aud []int    // 扉の監査の対 [関数, 読んだ項目]…（検証 =2 の区間の子 — でなければ空）
    Kinds []int  // 親が推論した名前付きの Def の kind（Def の順に [n, k…] — 検査器は推論せずこれを使う。空 = 全部推論する）
    Caps []int   // 値の位置のクロージャの捕捉の記録（追跡のとき — capDiagRec の形の並び。でなければ空）
}

// p を脱糖して k に結果を渡す（失敗なら k を呼ばず拒否を返す — diag のラベル）。
// k を関数型引数にするのは、ヒープを返り値で持ち出さないため（Def の返り値は呼び手の region への境界コピーになる — ヒープは数十 MB）。
// 結果の型 T はゼロ値の実引数 z で決める（拒否のときの戻り値も z — ラムダの結果からの型引数の推論は無い）。
// check の経路なので E2-S（e2s.sober）で上げる。excl = 上げない関数（逃げ）。k の 2 つ目の実引数は Def の添字 → 上げた関数の表（E2Map）
@errors(diag.CoreFragment, diag.UnknownName, diag.Malformed, diag.TypeMismatch, diag.PrintArg, diag.LenString, diag.UntypedNil, diag.NonExhaustive, diag.ImmWrite, diag.FieldType, diag.FnCap, diag.Cell, diag.FnArg, diag.Par)
func WithCore[T](p loader.Program, excl []int, z T, k func(Core, []int) T) (T, error?) {
    return WithCorePkg(p, excl, -1, z, k)
}

// WithCore の部分検査版（check --pkg）: only >= 0 なら package only の Def だけ本体つき・他の Def は署名だけ（本体 -1）、
// 根の式は only が main のときだけ（でなければ Root = -1）。only = -1 は WithCore と同じ
@errors(diag.CoreFragment, diag.UnknownName, diag.Malformed, diag.TypeMismatch, diag.PrintArg, diag.LenString, diag.UntypedNil, diag.NonExhaustive, diag.ImmWrite, diag.FieldType, diag.FnCap, diag.Cell, diag.FnArg, diag.Par)
func WithCorePkg[T](p loader.Program, excl []int, only int, z T, k func(Core, []int) T) (T, error?) {
    return WithCoreOpt(p, excl, only, false, 0, WholeRng(), (d) => z, k)
}

// WithCorePkg に trust（L0: std の Def は署名だけ・受理印は焼き込みが運ぶ）を足したもの。
// rng は Def の区間（WholeRng = 全部）。
// 拒否のときは zr(拒否を帰す先の Def — S.rejDef) を err と一緒に返す（check の関数単位キャッシュの拒否の値）。
// stopAtは計測のインターフェース（SOBER_CHECK_STOP）: 4 = 表層型検査器（TypeAll）の後・5 = Defと根の脱糖の後（検査器へのコピーの前）で止めてzを返す。0 = 止めない。
// 本体は関数型の引数を取る総称 = 呼び出し点ごとに展開されるので、呼び手は 1 か所で呼ぶ（raw ビルドの lower のヒープの容量）
@errors(diag.CoreFragment, diag.UnknownName, diag.Malformed, diag.TypeMismatch, diag.PrintArg, diag.LenString, diag.UntypedNil, diag.NonExhaustive, diag.ImmWrite, diag.FieldType, diag.FnCap, diag.Cell, diag.FnArg, diag.Par)
func WithCoreOpt[T](p loader.Program, excl []int, only int, trust bool, stopAt int, rng DefRng, zr func(int) T, k func(Core, []int) T) (T, error?) {
    mut st := S{}
    initState(mut st, p)
    if len(rng.fz) > 0 {
        // 店のヒープの尾は Init の終わりの長さに積む（lower の Init と同じ — TyAdopt が照合する）
        st.ty.h0 = hlen(mut st)
        TyAdopt(mut st, rng.fz[0])
        st.adopted = true
    }
    st.stopAt = stopAt
    st.rangeSet = rng.set
    st.rlo = rng.lo
    st.rhi = rng.hi
    st.rangeRoot = rng.root
    st.track = rng.track
    st.dkOn = loader.Flag("SOBER_DKAUDIT") || rng.aud
    st.rskip = rng.skip
    st.lazyRoot = rng.lazy
    st.luOn = rng.lu
    st.refs = rng.plan.refs
    if rng.plan.rok != 0 {
        capReachFrom(mut st, rng.plan.rok, rng.plan.reach)
    }
    st.genOnly = rng.gen
    st.e2s = !rng.flat
    st.e2sExcl = excl
    st.only = only
    st.onlySet = only >= 0
    st.trustStd = trust
    // env の形の前走り（工程 4 B1）は区間なし — 区間の子どうしで U が揃う（子ごとに同じ前走りを走らせ直す — 決定的）
    loadShapes(mut st, shapesFor(p, !rng.flat, excl, only, trust))
    defs, root, err := run(mut st)
    if err != nil {
        return zr(st.rejDef), err
    }
    if stopAt == 4 || stopAt == 5 || stopAt == 6 || stopAt == 7 {
        return zr(-1), nil
    }
    loader.Stage("ds-run")
    if st.dkOn && !rng.aud {
        dkFlush(mut st)
    }
    lifted := st.liftedHead
    // 検査器へは連続したimmの列で渡す（1回だけコピーする）
    mut hs := mut []int{}
    mut i := 0
    while i < hlen(mut st) {
        hs = append(hs, hget(mut st, i))
        i += 1
    }
    h := freeze(hs)
    mut ls := mut []Label{}
    i = 0
    while i < table.Len(mut st.labels) {
        ls = append(ls, lab(mut st, i))
        i += 1
    }
    mut ts := mut []Ty{}
    i = 0
    while i < table.Len(mut st.types) {
        ts = append(ts, tyAt(mut st, TyRef(TBASE + i)))
        i += 1
    }
    mut es := mut []CoreExpr{}
    i = 0
    while i < table.Len(mut st.cores) {
        es = append(es, coreAt(mut st, CoreRef(CBASE + i)))
        i += 1
    }
    mut orig := mut []int{}
    i = 0
    while i < table.Len(mut st.corig) {
        orig = append(orig, table.Get(mut st.corig, i))
        i += 1
    }
    return k(Core{h, freeze(ls), freeze(ts), freeze(es), int(defs), lifted, int(root), freeze(orig), if st.luOn { luOut(mut st) } else { []int{} }, if st.luOn || rng.gen { defFns(mut st) } else { []int{} }, if rng.aud { dkPairs(mut st) } else { []int{} }, kindsByDef(mut st, rng.kinds), if st.track { tyInts(mut st.capDiag) } else { []int{} }}, E2Map(mut st)), nil
}

// ── Def の区間 ──
// 判定の経路（check — idx でない）は Def の区間ごとに子 task が「前段 → 区間の Def の本体だけ脱糖（区間の外は署名だけ）→ 検査」を自前の S で
// 行い、親は区間の順に判定を合流する（checker/e2s.sober）。持ち上げ・インスタンスは子の中で作る（子ごとに自己完結 — Core は合流しない）。
// コアを出す経路（--core-json・--def-index・lower）は今までどおり 1 本の脱糖（持ち上げの大域の番号が要る）

// 区間: set なら関数表の添字 [lo, hi) の Def の本体だけ・root なら根の式も（set でなければ全部 — 区間を使わない）。
// 関数表の添字で切るのは、子の Def の添字（renumberDefs）が子の型付けの範囲〔rangeReach〕で変わりうるため — 関数表は前段で動かない
type DefRng struct {
    set bool
    lo int
    hi int
    root bool
    plan DefPlan
    track bool   // 出所の追跡（check の拒否の位置 — Core.Orig を作る）
    skip []bool  // check の関数単位キャッシュ: 区間の中で飛ばす関数（当たり）・lazy = 根の区間も署名を後回しに・lu = 持ち上げの使いの辺を積む・
    lazy bool    // aud = 扉の監査の対を Core.Aud へ（検証 =2）
    lu bool
    aud bool
    // kind の推論: gen = 型パラメータを持つ Def の本体だけを脱糖する（親が子へ渡す kind を推論する前段 — 根なし）・
    // kinds = 親が推論した名前付きの Def の kind（関数表の添字で [関数, n, k…] の並び — 子の Def の添字は子ごとに変わりうる）
    gen bool
    kinds []int
    // fz（空でなければ 1 つ）= 呼び手（build の lower）が同じ Program で型付けた店。表層型検査器を走らせず、Init の直後に載せる。
    // 店は大きな値なので列で持つ（区間を作り直す点ごとに値を写さない）
    fz []TyFrozen
    // flat = E2-S で上げない形（開発用 `check --core-json-expanded` の kind の推論 — 同じ形の Def の順で kind を出す）
    flat bool
}

// 拒否の診断のやり直し: 区間を使わず、出所を追跡し、名前付きの Def の関数表の添字（Core.DefFn）を出す
func DiagRng() DefRng {
    return DefRng{set: false, lo: 0, hi: 0, root: true, plan: emptyPlan(), track: true, skip: []bool{}, lazy: false, lu: true, aud: false}
}

// 区間を使わない（全部の Def と根）
func WholeRng() DefRng {
    return DefRng{set: false, lo: 0, hi: 0, root: true, plan: emptyPlan(), skip: []bool{}, lazy: false, lu: false, aud: false}
}

// 区間を使わず、E2-S で上げない形
func FlatRng() DefRng {
    return DefRng{set: false, lo: 0, hi: 0, root: true, plan: emptyPlan(), skip: []bool{}, lazy: false, lu: false, aud: false, flat: true}
}

// r に出所の追跡を立てた区間
func Tracked(r DefRng) DefRng {
    return DefRng{set: r.set, lo: r.lo, hi: r.hi, root: r.root, plan: r.plan, track: true, skip: r.skip, lazy: r.lazy, lu: r.lu, aud: r.aud, gen: r.gen, kinds: r.kinds}
}

// r に親が推論した kind（関数表の添字の並び）を持たせた区間
func WithKinds(r DefRng, ks []int) DefRng {
    return DefRng{set: r.set, lo: r.lo, hi: r.hi, root: r.root, plan: r.plan, track: r.track, skip: r.skip, lazy: r.lazy, lu: r.lu, aud: r.aud, gen: r.gen, kinds: ks}
}

// 型パラメータを持つ Def の本体だけを脱糖する（区間なし・根なし）。d = 親の計画（参照の辺があれば、表層型検査を総称関数から届く関数に絞る）
func GenRng(d DefPlan) DefRng {
    return DefRng{set: false, lo: 0, hi: 0, root: false, plan: d, skip: []bool{}, lazy: false, lu: false, aud: false, gen: true, kinds: []int{}}
}

// r に、呼び手が同じ Program で型付けた店を載せる区間（表層型検査器を飛ばす）
func WithAdopt(r DefRng, fz TyFrozen) DefRng {
    return DefRng{set: r.set, lo: r.lo, hi: r.hi, root: r.root, plan: r.plan, track: r.track, skip: r.skip, lazy: r.lazy, lu: r.lu, aud: r.aud, gen: r.gen, kinds: r.kinds, fz: []TyFrozen{fz}}
}

// 区間 r の計画
func RngPlanOf(r DefRng) DefPlan {
    return r.plan
}

// 親が推論した kind（関数表の添字の並び ks）を、名前付きの Def の添字の順の [n, k…] の並びにする（kind の無い Def は [0]）
func kindsByDef(st mut S, ks []int) []int {
    if len(ks) == 0 {
        return []int{}
    }
    mut at := mut []int{}
    for j <- iter.Range(0, st.ndef) {
        at = append(at, -1)
    }
    mut q := 0
    while q < len(ks) {
        dx := fnDef(mut st, ks[q])
        if dx >= 0 && dx < st.ndef {
            at[dx] = q + 1
        }
        q += 2 + ks[q + 1]
    }
    mut out := mut []int{}
    for j <- iter.Range(0, st.ndef) {
        if at[j] < 0 {
            out = append(out, 0)
        } else {
            n := ks[at[j]]
            for i <- iter.Range(0, n + 1) {
                out = append(out, ks[at[j] + i])
            }
        }
    }
    return freeze(out)
}

// 区間の切り方の材料（PlanDefs — 親が前段を 1 回走らせて出す）: cost = 関数表の添字ごとの費用の代理（本体を脱糖する Def だけ — 他は 0）・
// heap = 前段の後のヒープの語数（子の前段の作業域の見積もり）
type DefPlan struct {
    cost []int
    heap int
    refs RefGraph
    ck DefCk     // check の関数単位キャッシュの鍵の計画（PlanDefs の self が空でなく前走りの要らないプログラムのとき）
    rok int      // 届くクロージャのフラグ（capLive）: 0 = 渡さない（子が遅延で作る）・1 = mainが無い（全部届く扱い）・2 = reach（関数の添字ごとの0 / 1）
    reach []int
}

func EmptyPlan() DefPlan {
    return emptyPlan()
}

func emptyPlan() DefPlan {
    return DefPlan{cost: []int{}, heap: 0, refs: RefGraph{head: []int{}, adj: []int{}}, ck: emptyCk(), rok: 0, reach: []int{}}
}

// 計画 d の区間 [lo, hi)（root なら根も）— 子が親の走査の結果（計画）を読む
func RangeOf(d DefPlan, lo int, hi int, root bool) DefRng {
    return DefRng{set: true, lo: lo, hi: hi, root: root, plan: d, skip: []bool{}, lazy: false, lu: false, aud: false}
}

// check の関数単位キャッシュの区間: skip = 区間の中で飛ばす関数（当たり）・根の区間は署名を後回しに・持ち上げの使いの辺を積む
func RangeCk(d DefPlan, lo int, hi int, root bool, skip []bool, aud bool) DefRng {
    return DefRng{set: true, lo: lo, hi: hi, root: root, plan: d, skip: skip, lazy: root, lu: true, aud: aud}
}

// RngLo / RngHi / RngRootは区間のフィールドの読みインターフェース（checkerから）
func RngLo(r DefRng) int {
    return r.lo
}

func RngHi(r DefRng) int {
    return r.hi
}

// PlanCost / PlanHeapはDefPlanのフィールドの読みインターフェース（checkerから）
func PlanCost(d DefPlan) []int {
    return d.cost
}

func PlanHeap(d DefPlan) int {
    return d.heap
}

// 前段（prefix）を走らせて Def ごとの費用の代理を出す（前段の拒否はそのまま返す — 逐次の run と同じ順の最初の拒否）。
// 費用の代理 = 展開込みの節の数（ExpCost — 自分の節の数は、木は後置順に積むので同じファイルの前の関数の宣言の節との添字の差〔間の型・const の宣言も含む粗い上界〕）
@errors(diag.CoreFragment, diag.TypeMismatch)
func PlanDefs(p loader.Program, excl []int, only int, trust bool, self []byte) (DefPlan, error?) {
    mut st := S{}
    initState(mut st, p)
    st.e2s = true
    st.e2sExcl = excl
    st.only = only
    st.onlySet = only >= 0
    st.trustStd = trust
    st.planOnly = true
    perr := prefix(mut st)
    if perr != nil {
        return emptyPlan(), perr
    }
    mut own := mut []int{}
    for i <- iter.Range(0, st.nfn) {
        fl := p.fn_file[i]
        prev := if i > 0 && p.fn_file[i - 1] == fl { p.fn_node[i - 1] } else { 0 }
        c := p.fn_node[i] - prev
        own = append(own, if c > 0 { c } else { 1 })
    }
    ex := ExpCost(mut st, freeze(own))
    mut cost := mut []int{}
    for i <- iter.Range(0, st.nfn) {
        dx := fnDef(mut st, i)
        cost = append(cost, if dx >= 0 && !sigOnlyAt(mut st, i, dx) { ex[i] } else { 0 })
    }
    // 鍵の計画（self が空でなければ — check の関数単位キャッシュ）: 前走り（env の形の和 U_F）の要るプログラムは鍵が閉じないので組まない
    loader.Stage("ds-plan")
    ck := if len(self) > 0 && only < 0 && !needShapes(p) { ckPlan(mut st, self, trust) } else { emptyCk() }
    // 届くクロージャのフラグ（capLive）は親が1回作って子へ渡す — 子が脱糖の途中で遅延で作ると、そのとき脱糖中のDefが全部の木の名前の解決を読んだことになる
    // （check の関数単位キャッシュの鍵の外の読みになる）
    refs := refGraph(mut st)
    mk, rok := mainReachG(mut st, refs)
    mut reach := mut []int{}
    if rok {
        for i <- iter.Range(0, st.nfn) {
            reach = append(reach, latI(mut st, mk, i))
        }
    }
    return DefPlan{cost: freeze(cost), heap: hlen(mut st), refs: refs, ck: ck, rok: if rok { 2 } else { 1 }, reach: freeze(reach)}, nil
}

// buildの道の捕獲の寿命の検査: skip（SpawnSkip — true = 飛ばす）の外のDefだけを、呼び手（lower）が型付けた店fzの上で核へ脱糖し、spawnの点の
// 捕獲の判定（parSpawnのspawnCapBad — Parの41番）だけを拒否として返す。展開される関数の上げ（E2-S）はcheckと同じ形で掛ける（上げた関数のDefに
// spawnの点が残る・上げない平らな形は展開の入れ子が深くなる）。ほかの脱糖の誤りは返さない（形の前走り〔shapesFor〕を走らせないので、
// クロージャの環境の形に依る誤りが出うる — そこはcheckの検査器が今どおり判定する。buildがcheckより狭くならない）。stdのDefは署名だけ
@errors(diag.Par)
func SpawnCheck(p loader.Program, skip []bool, fz TyFrozen) error? {
    mut st := S{}
    initState(mut st, p)
    st.ty.h0 = hlen(mut st)
    TyAdopt(mut st, fz)
    st.adopted = true
    st.rangeSet = true
    st.rlo = 0
    st.rhi = st.nfn
    // 根の式（mainの本体）は、mainに印があるときだけ脱糖する（区間の外のDefの署名は後回し — lazyRoot）
    mut mi := 0 - 1
    for i <- iter.Range(0, st.nfn) {
        if fnPkg(mut st, i) == st.mainPkg && strIs(mut st, fnName(mut st, i), "main") {
            mi = i
        }
    }
    st.rangeRoot = mi >= 0 && mi < len(skip) && !skip[mi]
    st.lazyRoot = true
    st.rskip = skip
    st.e2s = true
    st.e2sExcl = []int{}
    st.trustStd = true
    _, _, err := run(mut st)
    if err == nil {
        return nil
    }
    return switch err {
    case diag.Par{at, kind}: if kind == 41 { diag.Par{at: at, kind: 41} } else { nil }
    default: nil
    }
}

// SpawnCheckの結果を整数で（子のtaskの結果 — buildの下ろしと並行に走らせる）: 1 = 通った・2以上 = 拒否の位置（file × 2^32 + tok + 2）
func SpawnCheckCode(p loader.Program, skip []bool, fz TyFrozen) int {
    e := SpawnCheck(p, skip, fz)
    if e == nil {
        return 1
    }
    w := diag.WordsOf(e)
    at := diag.WAt(w)
    return if diag.WTag(w) == 15 { at.file * 4294967296 + at.tok + 2 } else { 1 }
}
