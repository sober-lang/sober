package desugar

// 部分検査（check --pkg・小分けの check — st.onlySet）の表層型検査の対象を絞る（視点の固定費）: 視点には依存の package の
// 本体つきの宣言（.sobi の whole — 展開される関数・mut 関数・総称・リンク可視）が全部入るが、P の脱糖が読むのは P の関数と、P から呼び出しで
// 推移的に届く本体（展開・インスタンスの持ち上げでPのDefの中にコピーされる分）の表だけ。全部を型付けると、desugarのmut関数の本体を全部持つ
// lower の視点では検査の量の大半が依存の本体の型付けになっていた。
// フラグ（YInstNeeded）は呼び先 → 呼び手へ伝わる（YPropagate）ので、届く集合（呼び先について閉じている）の中のフラグは全体で型付けたときと同じ。
// 脱糖テンプレートの暗黙の呼び出し（文字列の補間・string(b) 等 — 字面の呼び出しに出ない）は std の関数を呼ぶので、std の本体は常に入れる（保守的）

import "ast"
import "std/iter"

// 表層型を付ける関数のフラグの列（1 = 付ける）: Pの関数・stdの関数・constの初期化式から呼ばれる関数をシードに、本体の中の呼び出しを辿って閉じる
func yReach(st mut S) ListRef {
    mark := ListRef(listN(mut st, st.nfn))
    mut work := mut []int{}
    for i <- iter.Range(0, st.nfn) {
        if fnPkg(mut st, i) == st.only || IsStdPkg(mut st, fnPkg(mut st, i)) {
            lput(mut st, mark, i, 1)
            work = append(work, i)
        }
    }
    // 辺 [呼び手（-1 = 関数の外 — const の初期化式）, 呼び先] の平らな列
    mut edges := mut []int{}
    for f <- iter.Range(0, st.nfile) {
        t := st.trees[f]
        pk := FilePkg(mut st, f)
        // このファイルの関数と本体の字句の範囲 [関数, 始め, 終わり]…
        mut rs := mut []int{}
        for i <- iter.Range(0, st.nfn) {
            nd := fnNode(mut st, i)
            if fileOf(mut st, nd) == f {
                ext := nodeOf(mut st, nd).f
                if ext >= 0 && !ZVariant(mut st, i) {
                    rs = append(rs, i)
                    rs = append(rs, latI(mut st, ListRef(ext), 1))
                    rs = append(rs, latI(mut st, ListRef(ext), 2))
                }
            }
        }
        rr := freeze(rs)
        for n <- iter.Range(0, len(t.nodes)) {
            k := t.nodes[n].kind
            if k == ast.ECall || k == ast.EPipe {
                x := nodeOf(mut st, NodeRef(ABASE + f * FW + n))
                callee := if k == ast.ECall { NodeRef(x.a) } else { NodeRef(x.b) }
                ci := e2sCallee(mut st, pk, callee)
                if ci >= 0 && int(fnBody(mut st, ci)) >= 0 {
                    edges = append(edges, zOr(mut st, f, n, rangeOf(rr, t.nodes[n].tok)))
                    edges = append(edges, ci)
                }
            }
        }
    }
    for e <- iter.Range(0, len(edges) / 2) {
        if edges[e * 2] < 0 && latI(mut st, mark, edges[e * 2 + 1]) == 0 {
            lput(mut st, mark, edges[e * 2 + 1], 1)
            work = append(work, edges[e * 2 + 1])
        }
    }
    mut h := 0
    while h < len(work) {
        g := work[h]
        h += 1
        for e <- iter.Range(0, len(edges) / 2) {
            if edges[e * 2] == g && latI(mut st, mark, edges[e * 2 + 1]) == 0 {
                lput(mut st, mark, edges[e * 2 + 1], 1)
                work = append(work, edges[e * 2 + 1])
            }
        }
    }
    return mark
}

// 字句 tok を本体に含む関数（rs = [関数, 始め, 終わり]…・無ければ -1）
func rangeOf(rs []int, tok int) int {
    for i <- iter.Range(0, len(rs) / 3) {
        if tok >= rs[i * 3 + 1] && tok < rs[i * 3 + 2] {
            return rs[i * 3]
        }
    }
    return -1
}

// 関数の参照の辺（呼び手ごとに束ねた CSR — 呼び手 + 1 で引く: 0 = 関数の外〔const の初期化式〕）。区間の計画（親）が
// 1 回だけ作って子へ渡す（子ごとに全部の木を走査しない）
type RefGraph struct {
    head []int
    adj []int
}

// 全部の木の名前と `package.名前` の節から、それが指す本体つきの関数への辺を作る（呼び出しに限らない — 関数値として渡す形も）
func refGraph(st mut S) RefGraph {
    mut src := mut []int{}
    mut dst := mut []int{}
    ff := fileFns(mut st)
    for f <- iter.Range(0, st.nfile) {
        t := st.trees[f]
        pk := FilePkg(mut st, f)
        rr := fnRanges(mut st, ff, f)
        for n <- iter.Range(0, len(t.nodes)) {
            k := t.nodes[n].kind
            if k == ast.EIdent || k == ast.ESelector {
                ci := e2sCallee(mut st, pk, NodeRef(ABASE + f * FW + n))
                if ci >= 0 && int(fnBody(mut st, ci)) >= 0 {
                    src = append(src, zOr(mut st, f, n, rangeOfSorted(rr, t.nodes[n].tok)) + 1)
                    dst = append(dst, ci)
                }
            }
        }
    }
    return csrOf(mut st, freeze(src), freeze(dst))
}

// 名前の参照の節（EIdent / ESelector）を持ち主ごとに振り分けた表（解決はしない — 持ち主の規則は refGraph と同じ: 字句の区間・
// 省略可の関数型のコピーは節の区間）: head[c]..head[c + 1] が持ち主c（0 = 関数の外・1 + 関数の添字）の節（adj）。数えてから詰める2回の走査
// （持ち主と節の組の列を積まない — 名前の参照の節は自己で百万の桁。組の列 + 詰めた表の 3 本だと自己 build の peak RSS +7 MB）
func refOwners(st mut S) RefGraph {
    ff := fileFns(mut st)
    mut head := mut []int{}
    for c <- iter.Range(0, st.nfn + 2) {
        head = append(head, 0)
    }
    for f <- iter.Range(0, st.nfile) {
        t := st.trees[f]
        rr := fnRanges(mut st, ff, f)
        for n <- iter.Range(0, len(t.nodes)) {
            k := t.nodes[n].kind
            if k == ast.EIdent || k == ast.ESelector {
                x := zOr(mut st, f, n, rangeOfSorted(rr, t.nodes[n].tok)) + 2
                head[x] = head[x] + 1
            }
        }
    }
    for c <- iter.Range(0, st.nfn + 1) {
        head[c + 1] = head[c + 1] + head[c]
    }
    mut fill := mut []int{}
    for c <- iter.Range(0, st.nfn + 1) {
        fill = append(fill, head[c])
    }
    mut adj := mut []int{}
    for e <- iter.Range(0, head[st.nfn + 1]) {
        adj = append(adj, 0)
    }
    for f <- iter.Range(0, st.nfile) {
        t := st.trees[f]
        rr := fnRanges(mut st, ff, f)
        for n <- iter.Range(0, len(t.nodes)) {
            k := t.nodes[n].kind
            if k == ast.EIdent || k == ast.ESelector {
                c := zOr(mut st, f, n, rangeOfSorted(rr, t.nodes[n].tok)) + 1
                adj[fill[c]] = ABASE + f * FW + n
                fill[c] = fill[c] + 1
            }
        }
    }
    return RefGraph{head: freeze(head), adj: freeze(adj)}
}

// 関数をファイルごとに振り分けた表（head[f]..head[f + 1] がファイル f の関数 — 添字の昇順。以前は refGraph がファイルごとに全関数を見ていた）
func fileFns(st mut S) RefGraph {
    mut src := mut []int{}
    mut dst := mut []int{}
    for i <- iter.Range(0, st.nfn) {
        fl := fileOf(mut st, fnNode(mut st, i))
        if fl >= 0 {
            src = append(src, fl)
            dst = append(dst, i)
        }
    }
    return csrN(freeze(src), freeze(dst), st.nfile)
}

// ファイル f の関数の本体の字句の範囲（始めの昇順 — 宣言順）: [関数, 始め, 終わり]…
func fnRanges(st mut S, ff RefGraph, f int) []int {
    mut rs := mut []int{}
    for j <- iter.Range(ff.head[f], ff.head[f + 1]) {
        i := ff.adj[j]
        ext := nodeOf(mut st, fnNode(mut st, i)).f
        if ext >= 0 && !ZVariant(mut st, i) {
            rs = append(rs, i)
            rs = append(rs, latI(mut st, ListRef(ext), 1))
            rs = append(rs, latI(mut st, ListRef(ext), 2))
        }
    }
    return freeze(rs)
}

// 持ち主の列 src（0..nfn）と相手の列 dst の辺を持ち主ごとに詰めた表（持ち主の中は src の出現順）
func csrOf(st mut S, src []int, dst []int) RefGraph {
    return csrN(src, dst, st.nfn + 1)
}

// src（0..n − 1）ごとに dst を詰めた表: head[c]..head[c + 1] が c の相手（出現順）
func csrN(src []int, dst []int, n int) RefGraph {
    mut head := mut []int{}
    for c <- iter.Range(0, n + 1) {
        head = append(head, 0)
    }
    for e <- iter.Range(0, len(src)) {
        x := src[e] + 1
        head[x] = head[x] + 1
    }
    for c <- iter.Range(0, n) {
        head[c + 1] = head[c + 1] + head[c]
    }
    mut fill := mut []int{}
    mut adj := mut []int{}
    for c <- iter.Range(0, n) {
        fill = append(fill, head[c])
    }
    for e <- iter.Range(0, len(src)) {
        adj = append(adj, 0)
    }
    for e <- iter.Range(0, len(src)) {
        c := src[e]
        q := fill[c]
        adj[q] = dst[e]
        fill[c] = q + 1
    }
    return RefGraph{head: freeze(head), adj: freeze(adj)}
}

// kind の推論の前段（st.genOnly — 型パラメータを持つ Def の本体だけを脱糖する）の表層型検査の対象のフラグ: rangeReach の区間の代わりに、
// 本体を脱糖する総称関数をシードにする（constの初期化式の参照先もシード。stdはL0の信頼が無いときだけシード）。
// 辿る辺は、本体がシードのDefの中へコピーされうる呼び先（総称関数〔インスタンス〕・展開される関数・逃げの集合）への辺だけ。
// 他の呼び先はDefとして呼ぶので署名だけで足り、フラグ（YInstNeeded）は型パラメータを含む型引数の呼び出し（総称関数どうし）でしか伝わらない
func genReach(st mut S) ListRef {
    mark := ListRef(listN(mut st, st.nfn))
    mut work := mut []int{}
    for i <- iter.Range(0, st.nfn) {
        gen := lenL(mut st, fnTParams(mut st, i)) > 0 && !outsideOnly(mut st, i) && !(st.trustStd && IsStdPkg(mut st, fnPkg(mut st, i)))
        // L0 の std（署名だけ — kind は焼き込みの `@kind`）はシードにしない（総称関数の本体が参照する std の関数は辺で届く）
        if gen || (!st.trustStd && IsStdPkg(mut st, fnPkg(mut st, i))) {
            lput(mut st, mark, i, 1)
            work = append(work, i)
        }
    }
    return reachCloseIf(mut st, mark, work, true)
}

// mark・work（シード）から参照の辺（st.refs）を辿って閉じる（constの初期化式の参照先もシード）
func reachClose(st mut S, mark ListRef, work0 []int) ListRef {
    return reachCloseIf(mut st, mark, work0, false)
}

// 本体がDefの中へコピーされうる関数か（総称関数・展開される関数・逃げの集合）
func copiedIn(st mut S, i int) bool {
    return lenL(mut st, fnTParams(mut st, i)) > 0 || fnExpands(mut st, i) || e2sExcluded(st.e2sExcl, i)
}

// reachCloseの辺を、copiedならcopiedInの呼び先だけに限ったもの（constの初期化式の参照先はシードなので限らない）
func reachCloseIf(st mut S, mark ListRef, work0 []int, copied bool) ListRef {
    mut work := mut []int{}
    for g <- work0 {
        work = append(work, g)
    }
    head := st.refs.head
    adj := st.refs.adj
    for e <- iter.Range(head[0], head[1]) {
        if latI(mut st, mark, adj[e]) == 0 {
            lput(mut st, mark, adj[e], 1)
            work = append(work, adj[e])
        }
    }
    mut h := 0
    while h < len(work) {
        g := work[h]
        h += 1
        for e <- iter.Range(head[g + 1], head[g + 2]) {
            if latI(mut st, mark, adj[e]) == 0 && (!copied || copiedIn(mut st, adj[e])) {
                lput(mut st, mark, adj[e], 1)
                work = append(work, adj[e])
            }
        }
    }
    return mark
}

// Defの区間の子（st.rangeSet）の表層型検査の対象のフラグ: 区間の中で本体を脱糖しうる関数（部分検査の視点の外・L0のstdを除く）・
// 根の区間ならmain・stdの関数・constの初期化式が参照する関数をシードに、参照の辺（st.refs — 親のrefGraph）を辿って閉じる。参照は呼び出しに限らない
// （関数値として渡す形 — 区間の本体のfnrefが指す関数のフラグ〔YInstNeeded〕も全体と同じにする。yReachより保守的）。
// フラグは呼び先 → 呼び手へ伝わるので、届く集合の中のフラグ・表は全体で型付けたときと同じ（yReachと同じ論証）
func rangeReach(st mut S) ListRef {
    mark := ListRef(listN(mut st, st.nfn))
    mut work := mut []int{}
    for i <- iter.Range(0, st.nfn) {
        inRange := i >= st.rlo && i < st.rhi && !outsideOnly(mut st, i) && !(st.trustStd && IsStdPkg(mut st, fnPkg(mut st, i)))
        isMain := st.rangeRoot && fnPkg(mut st, i) == st.mainPkg && strIs(mut st, fnName(mut st, i), "main")
        if inRange || isMain || IsStdPkg(mut st, fnPkg(mut st, i)) {
            lput(mut st, mark, i, 1)
            work = append(work, i)
        }
    }
    head := st.refs.head
    adj := st.refs.adj
    // constの初期化式（呼び手0）の参照先はシード
    for e <- iter.Range(head[0], head[1]) {
        if latI(mut st, mark, adj[e]) == 0 {
            lput(mut st, mark, adj[e], 1)
            work = append(work, adj[e])
        }
    }
    mut h := 0
    while h < len(work) {
        g := work[h]
        h += 1
        for e <- iter.Range(head[g + 1], head[g + 2]) {
            if latI(mut st, mark, adj[e]) == 0 {
                lput(mut st, mark, adj[e], 1)
                work = append(work, adj[e])
            }
        }
    }
    return mark
}

// ファイルfの節nの関数: 省略可の関数型のコピーの節の区間に入っていればその組の関数（state.soberのzBlock）・でなければ字句で引いたg
func zOr(st mut S, f int, n int, g int) int {
    z := zBlock(mut st, f, n)
    return if z >= 0 { z } else { g }
}

// rangeOf の二分探索版（rs の範囲は始めの昇順で互いに素）
func rangeOfSorted(rs []int, tok int) int {
    mut lo := 0
    mut hi := len(rs) / 3
    while lo < hi {
        m := (lo + hi) / 2
        if rs[m * 3 + 2] <= tok {
            lo = m + 1
        } else {
            hi = m
        }
    }
    if lo < len(rs) / 3 && tok >= rs[lo * 3 + 1] && tok < rs[lo * 3 + 2] {
        return rs[lo * 3]
    }
    return -1
}

// 呼び出しの辺 [呼び手, 呼び先]…（呼び先が展開される関数だけ — 呼び出し点ごと。ExpCost と開発用の DefCostDump が読む）
func expEdges(st mut S) []int {
    mut edges := mut []int{}
    for f <- iter.Range(0, st.nfile) {
        t := st.trees[f]
        pk := FilePkg(mut st, f)
        mut rs := mut []int{}
        for i <- iter.Range(0, st.nfn) {
            nd := fnNode(mut st, i)
            if fileOf(mut st, nd) == f {
                ext := nodeOf(mut st, nd).f
                if ext >= 0 && !ZVariant(mut st, i) {
                    rs = append(rs, i)
                    rs = append(rs, latI(mut st, ListRef(ext), 1))
                    rs = append(rs, latI(mut st, ListRef(ext), 2))
                }
            }
        }
        rr := freeze(rs)
        for n <- iter.Range(0, len(t.nodes)) {
            k := t.nodes[n].kind
            if k == ast.ECall || k == ast.EPipe {
                x := nodeOf(mut st, NodeRef(ABASE + f * FW + n))
                callee := if k == ast.ECall { NodeRef(x.a) } else { NodeRef(x.b) }
                ci := e2sCallee(mut st, pk, callee)
                if ci >= 0 && int(fnBody(mut st, ci)) >= 0 && fnExpands(mut st, ci) {
                    g := zOr(mut st, f, n, rangeOfSorted(rr, t.nodes[n].tok))
                    if g >= 0 {
                        edges = append(edges, g)
                        edges = append(edges, ci)
                    }
                }
            }
        }
    }
    return freeze(edges)
}

// ExpCost は関数ごとの展開込みの大きさ（Def の区間の費用の代理）: own = 関数ごとの自分の節の数、
// 展開込み = own + 本体の中の呼び出し点ごとに、呼び先が展開される関数（fnExpands — 前段の後）ならその展開込み（呼び出し点の数だけ）。
// 展開される関数は再帰しない（する形は脱糖が拒否する）が、念のため辿り中の関数は own だけに数える。上限 EXP_CAP で頭打ち
const EXP_CAP = 1073741824

func ExpCost(st mut S, own []int) []int {
    // 呼び出しの辺（呼び先が展開される関数だけ）を呼び手ごとに束ねる
    edges := expEdges(mut st)
    mut src := mut []int{}
    mut dst := mut []int{}
    for e <- iter.Range(0, len(edges) / 2) {
        src = append(src, edges[e * 2])
        dst = append(dst, edges[e * 2 + 1])
    }
    mut head := mut []int{}
    for c <- iter.Range(0, st.nfn + 1) {
        head = append(head, 0)
    }
    for e <- iter.Range(0, len(src)) {
        x := src[e] + 1
        head[x] = head[x] + 1
    }
    for c <- iter.Range(0, st.nfn) {
        head[c + 1] = head[c + 1] + head[c]
    }
    mut fill := mut []int{}
    mut adj := mut []int{}
    for c <- iter.Range(0, st.nfn) {
        fill = append(fill, head[c])
    }
    for e <- iter.Range(0, len(src)) {
        adj = append(adj, 0)
    }
    for e <- iter.Range(0, len(src)) {
        c := src[e]
        q := fill[c]
        adj[q] = dst[e]
        fill[c] = q + 1
    }
    // 後順の明示スタックで畳む（memo: -1 = まだ・-2 = 辿り中）
    mut memo := mut []int{}
    for i <- iter.Range(0, st.nfn) {
        memo = append(memo, -1)
    }
    mut stk := mut []int{}
    mut sp := 0
    for r <- iter.Range(0, st.nfn) {
        if memo[r] == -1 {
            if len(stk) > 0 {
                stk[0] = r
            } else {
                stk = append(stk, r)
            }
            sp = 1
            while sp > 0 {
                g := stk[sp - 1]
                if memo[g] == -1 {
                    memo[g] = -2
                    for e <- iter.Range(head[g], head[g + 1]) {
                        if memo[adj[e]] == -1 {
                            if sp < len(stk) {
                                stk[sp] = adj[e]
                            } else {
                                stk = append(stk, adj[e])
                            }
                            sp += 1
                        }
                    }
                } else {
                    sp -= 1
                    if memo[g] == -2 {
                        mut sum := own[g]
                        for e <- iter.Range(head[g], head[g + 1]) {
                            v := memo[adj[e]]
                            w := if v >= 0 { v } else { own[adj[e]] }
                            sum = sum + w
                            if sum > EXP_CAP {
                                sum = EXP_CAP
                            }
                        }
                        memo[g] = sum
                    }
                }
            }
        }
    }
    return freeze(memo)
}


// 入口（main packageのmain）とconstの初期化式から参照の辺（refGraph — ParReachと同じ保守的な辺）で届く関数のフラグ。
// main が無ければ ok = false（部分検査・package の検査 — 呼び手は全部届く扱いにする）
func mainReach(st mut S) (ListRef, bool) {
    return mainReachG(mut st, refGraph(mut st))
}

// mainReach の辺 g を与える形（PlanDefs — 親が区間の計画の refGraph で 1 回作って子へ渡す）
func mainReachG(st mut S, g RefGraph) (ListRef, bool) {
    mark := ListRef(listN(mut st, st.nfn))
    mut work := mut []int{}
    for i <- iter.Range(0, st.nfn) {
        if fnPkg(mut st, i) == st.mainPkg && strIs(mut st, fnName(mut st, i), "main") {
            lput(mut st, mark, i, 1)
            work = append(work, i)
        }
    }
    if len(work) == 0 {
        return mark, false
    }
    for e <- iter.Range(g.head[0], g.head[1]) {
        if latI(mut st, mark, g.adj[e]) == 0 {
            lput(mut st, mark, g.adj[e], 1)
            work = append(work, g.adj[e])
        }
    }
    mut h := 0
    while h < len(work) {
        f := work[h]
        h += 1
        for e <- iter.Range(g.head[f + 1], g.head[f + 2]) {
            if latI(mut st, mark, g.adj[e]) == 0 {
                lput(mut st, mark, g.adj[e], 1)
                work = append(work, g.adj[e])
            }
        }
    }
    return mark, true
}

// 入口（main packageのmain）とconstの初期化式から参照の辺で届く関数にstd/taskのインターフェース（ParKey）があるか。
// lower の並列モード（task の大域・M:N の rt・罠）の判定: import しただけで届かないプログラム（std/utf8 の内側が par を使っても、それを呼ばない
// プログラム）は逐次のまま — trap.sober の「使わないプログラムの IR は不変」。辺は refGraph（名前の参照 — 呼び出しに限らず関数値として渡す形も・
// ラムダと総称の本体の中の参照は囲む関数から）で保守的。届かない扱いの誤りはrtが欠けて壊れる向きなので、lowerはparのインターフェースを下ろす点で表明する
// 辺は届いた関数の分だけ解決する（refOwners — 名前の参照の節を持ち主ごとに振り分けるだけ・解決は辿るとき）。最初にインターフェースを見つけた所で止まるので、
// task を使うプログラムは全体の名前の解決を払わない（refGraph で全節を解決してから辿る形は自己 build で ≈ 0.7 G 重い）。
// 答え（届くか）は refGraph の辺で辿ったときと同じ
func ParReach(st mut S) bool {
    g := refOwners(mut st)
    mark := ListRef(listN(mut st, st.nfn))
    mut work := mut []int{}
    for i <- iter.Range(0, st.nfn) {
        if fnPkg(mut st, i) == st.mainPkg && strIs(mut st, fnName(mut st, i), "main") {
            lput(mut st, mark, i, 1)
            work = append(work, i)
        }
    }
    // 持ち主c（0 = 関数の外 — constの初期化式・1 + 関数の添字）の参照先のうち、まだフラグの無い関数を積む
    mut c := 0
    mut h := 0
    while c >= 0 {
        for e <- iter.Range(g.head[c], g.head[c + 1]) {
            r := NodeRef(g.adj[e])
            ci := e2sCallee(mut st, FilePkg(mut st, fileOf(mut st, r)), r)
            if ci >= 0 && int(fnBody(mut st, ci)) >= 0 && latI(mut st, mark, ci) == 0 {
                lput(mut st, mark, ci, 1)
                work = append(work, ci)
            }
        }
        c = -1
        while c < 0 && h < len(work) {
            f := work[h]
            h += 1
            if ParRtUse(mut st, f) {
                return true
            }
            c = f + 1
        }
    }
    return false
}

// taskの関数name（NewDomain / Await）を名前で参照する節があるか（std/taskの外の `X.name` — lowerのdomainのrt: 本体で死んだtaskの毒のパス。
// 保守的〔届かない関数の中の参照でも真〕— 参照の辺を全部辿る形はdomainを使わないプログラムで全域を歩き、自己buildで +0.9 Gだった）
func DomNamed(st mut S, name string) bool {
    for f <- iter.Range(0, st.nfile) {
        if strIs(mut st, PkgPath(mut st, FilePkg(mut st, f)), "std/task") {
            continue
        }
        t := st.trees[f]
        for n <- iter.Range(0, len(t.nodes)) {
            if t.nodes[n].kind == ast.ESelector && strIs(mut st, sB(treeNode(f, t.nodes, n, st.descs, st.utf8)), name) {
                return true
            }
        }
    }
    return false
}

// mainとconstの初期化式から参照の辺で届く関数のフラグ（ParReachの閉包そのもの — lowerの並列分割の計画: lower/split.soberが群の受け持ちを決める。
// 出力には効かない — 漏れは見つけた子が下ろし、余分は親の模擬が取り出さない）
func PlanMarks(st mut S) []int {
    g := refGraph(mut st)
    mut mark := mut []int{}
    for i <- iter.Range(0, st.nfn) {
        mark = append(mark, 0)
    }
    mut work := mut []int{}
    for i <- iter.Range(0, st.nfn) {
        if fnPkg(mut st, i) == st.mainPkg && strIs(mut st, fnName(mut st, i), "main") {
            mark[i] = 1
            work = append(work, i)
        }
    }
    for e <- iter.Range(g.head[0], g.head[1]) {
        if mark[g.adj[e]] == 0 {
            mark[g.adj[e]] = 1
            work = append(work, g.adj[e])
        }
    }
    mut h := 0
    while h < len(work) {
        f := work[h]
        h += 1
        for e <- iter.Range(g.head[f + 1], g.head[f + 2]) {
            if mark[g.adj[e]] == 0 {
                mark[g.adj[e]] = 1
                work = append(work, g.adj[e])
            }
        }
    }
    return freeze(mark)
}

// 関数ごとにtask.Awaitに届くかのフラグ（1 = 届く — 参照の辺の逆向きの不動点・保守的）。lower: Awaitに届くSpawnの子は縮退しない
// （縮退した子が待てるのは子孫だけ、の約束を domain の待ちで崩さない — language.md 11 節「予算と admission」）
func AwaitMarks(st mut S) []int {
    g := refGraph(mut st)
    mut m := mut []int{}
    for i <- iter.Range(0, st.nfn) {
        m = append(m, if DomKey(mut st, i) == 3 { 1 } else { 0 })
    }
    mut ch := true
    while ch {
        ch = false
        for f <- iter.Range(0, st.nfn) {
            if m[f] == 0 {
                mut e := g.head[f + 1]
                while e < g.head[f + 2] && m[f] == 0 {
                    if m[g.adj[e]] == 1 {
                        m[f] = 1
                        ch = true
                    }
                    e += 1
                }
            }
        }
    }
    return freeze(m)
}

// 節 n（Spawn のラムダ）の中の呼び出しが Await に届くか（marks = AwaitMarks。関数値の呼び出しは届く側に数える — 保守的）
func LamReachesAwait(st mut S, n NodeRef, marks []int) bool {
    if n == -1 {
        return false
    }
    x := nodeOf(mut st, n)
    if x.kind == ast.ECall {
        cal := if kindN(mut st, nA(x)) == ast.EIndex { nA(nodeOf(mut st, nA(x))) } else { nA(x) }
        pk := st.curPkg
        st.curPkg = FilePkg(mut st, fileOf(mut st, n))
        fk := findFn(mut st, cal, -1)
        st.curPkg = pk
        if fk >= 0 && marks[fk] == 1 {
            return true
        }
        y := YTypeOf(mut st, cal)
        if fk < 0 && y >= 0 && yk(mut st, y) == YFn {
            return true
        }
    }
    c := pcDesc(mut st, x)
    for j <- iter.Range(0, 6) {
        d := c / pow8(j) % 8
        v := pcField(x, j)
        if d == 1 && v != -1 {
            if LamReachesAwait(mut st, NodeRef(v), marks) {
                return true
            }
        } else if d == 3 && v != -1 {
            l := ListRef(v)
            for i <- iter.Range(0, lenL(mut st, l)) {
                if LamReachesAwait(mut st, latN(mut st, l, i), marks) {
                    return true
                }
            }
        }
    }
    return false
}

// buildの捕獲の寿命の検査（parSpawnのspawnCapBad — checkの検査器の kSpawn の givable rs と同じ判定）で脱糖する関数の印。返すのは飛ばす印（true = 脱糖しない）。
// 判定が偽になりうるspawnの点（spCapRisk）を、自前で持つか、呼び出し点へ展開される関数を経由して持つ、stdの外の関数だけを脱糖する（展開される関数は
// E2-Sの上げで自前のDefになりうる・stdの関数は焼き込みの検査の側）。印は2種類: own = 自前の危うさ（脱糖が要る）・arg = 関数型の仮引数を子が使う
// （危うさは呼び手が渡すラムダの捕獲で決まる — 呼び出し点の実引数を見て呼び手へ伝える）。印の無いプログラムは空（呼び手は脱糖を走らせない）
func SpawnSkip(st mut S) []bool {
    mut isSp := mut []bool{}
    mut any := false
    for i <- iter.Range(0, st.nfn) {
        k := ParKey(mut st, i)
        sp := k == PAR_SPAWN || k == PAR_SPAWNIN || k == PAR_SPAWNGIVE
        isSp = append(isSp, sp)
        any = any || sp
    }
    if !any {
        return []bool{}
    }
    mut own := mut []bool{}
    mut arg := mut []bool{}
    for i <- iter.Range(0, st.nfn) {
        own = append(own, false)
        arg = append(arg, false)
    }
    mut nc := spNameCache(mut st)
    // 展開される関数の呼び出し点（持ち主・呼び出しの節・呼び先）
    mut co := mut []int{}
    mut cn := mut []int{}
    mut cg := mut []int{}
    ff := fileFns(mut st)
    for f <- iter.Range(0, st.nfile) {
        t := st.trees[f]
        pk := FilePkg(mut st, f)
        rr := fnRanges(mut st, ff, f)
        for n <- iter.Range(0, len(t.nodes)) {
            if t.nodes[n].kind == ast.ECall {
                cnode := NodeRef(ABASE + f * FW + n)
                cal0 := nA(nodeOf(mut st, cnode))
                cal := if kindN(mut st, cal0) == ast.EIndex { nA(nodeOf(mut st, cal0)) } else { cal0 }
                ci := e2sCallee(mut st, pk, cal)
                o := zOr(mut st, f, n, rangeOfSorted(rr, t.nodes[n].tok))
                if ci >= 0 && o >= 0 && isSp[ci] {
                    args := lB(nodeOf(mut st, cnode))
                    li := if ParKey(mut st, ci) == PAR_SPAWN { 1 } else { 2 }
                    lam := if li < lenL(mut st, args) { latN(mut st, args, li) } else { NodeRef(-1) }
                    if lam == -1 || kindN(mut st, lam) != ast.ELambda {
                        own[o] = true
                    } else {
                        r := spRisk(mut st, mut nc, o, nB(nodeOf(mut st, lam)))
                        own[o] = own[o] || r == 2
                        arg[o] = arg[o] || r == 1
                    }
                } else if ci >= 0 && o >= 0 && fnDef(mut st, ci) < 0 && int(fnBody(mut st, ci)) >= 0 {
                    co = append(co, o)
                    cn = append(cn, int(cnode))
                    cg = append(cg, ci)
                }
            }
        }
    }
    mut ch := true
    while ch {
        ch = false
        for e <- iter.Range(0, len(co)) {
            o := co[e]
            g := cg[e]
            if own[g] && !own[o] {
                own[o] = true
                ch = true
            }
            if arg[g] && !own[o] {
                args := lB(nodeOf(mut st, NodeRef(cn[e])))
                for q <- iter.Range(0, lenL(mut st, args)) {
                    an := latN(mut st, args, q)
                    if an != -1 {
                        r := spRisk(mut st, mut nc, o, if kindN(mut st, an) == ast.ELambda { nB(nodeOf(mut st, an)) } else { an })
                        if r == 2 && !own[o] {
                            own[o] = true
                            ch = true
                        } else if r == 1 && !arg[o] {
                            arg[o] = true
                            ch = true
                        }
                    }
                }
            }
        }
    }
    mut skip := mut []bool{}
    mut need := false
    for i <- iter.Range(0, st.nfn) {
        on := own[i] && !IsStdPkg(mut st, fnPkg(mut st, i))
        skip = append(skip, !on)
        need = need || on
    }
    return if need { freeze(skip) } else { []bool{} }
}

// 関数ごとの、task.Runの本体の入れ子で束縛した名前と、関数型の仮引数の名前の溜め（初めて引いたときに数える）
type SpNames struct {
    at []int       // 関数ごとの [始め, 入れ子の数, 仮引数の数]（-1 = まだ）
    names []StrRef
}

func spNameCache(st mut S) SpNames {
    mut at := mut []int{}
    for i <- iter.Range(0, st.nfn * 3) {
        at = append(at, 0 - 1)
    }
    return SpNames{at: freeze(at), names: []StrRef{}}
}

// 子のラムダの本体bの危うさ（持ち主o）: 2 = 入れ子の束縛でregionを持ちうる名前を使う・1 = 関数型の仮引数を使う（呼び手の実引数で決まる）・0 = 無し
func spRisk(st mut S, nc mut SpNames, o int, b NodeRef) int {
    if nc.at[o * 3] < 0 {
        st0 := len(nc.names)
        mut ns := mut []StrRef{}
        for x <- nc.names {
            ns = append(ns, x)
        }
        nest := spNestedNames(mut st, fnBody(mut st, o))
        for x <- nest {
            ns = append(ns, x)
        }
        mut np := 0
        ps := fnParams(mut st, o)
        for i <- iter.Range(0, lenL(mut st, ps)) {
            prm := latN(mut st, ps, i)
            tk := kindN(mut st, nB(nodeOf(mut st, prm)))
            if tk == ast.TFunc || tk == ast.TOpt {
                ns = append(ns, sA(nodeOf(mut st, prm)))
                np += 1
            }
        }
        mut at := mut []int{}
        for x <- nc.at {
            at = append(at, x)
        }
        at[o * 3] = st0
        at[o * 3 + 1] = len(nest)
        at[o * 3 + 2] = np
        nc.at = freeze(at)
        nc.names = freeze(ns)
    }
    s0 := nc.at[o * 3]
    nn := nc.at[o * 3 + 1]
    np := nc.at[o * 3 + 2]
    nested := nc.names[s0:s0 + nn]
    fnps := nc.names[s0 + nn:s0 + nn + np]
    if spRiskName(mut st, b, nested, []StrRef{}) {
        return 2
    }
    return if spRiskName(mut st, b, []StrRef{}, fnps) { 1 } else { 0 }
}

func spHas(st mut S, xs []StrRef, s StrRef) bool {
    for x <- xs {
        if strEq(mut st, x, s) {
            return true
        }
    }
    return false
}

// 木nの中の名前のうち、入れ子の束縛でregionを持ちうるもの・関数型の仮引数があるか
func spRiskName(st mut S, n NodeRef, nested []StrRef, fnps []StrRef) bool {
    if n == -1 {
        return false
    }
    x := nodeOf(mut st, n)
    if x.kind == ast.EIdent {
        nm := sA(x)
        return spHas(mut st, fnps, nm) || spHas(mut st, nested, nm) && !pcRegionFree(mut st, YTypeOf(mut st, n), 8)
    }
    c := pcDesc(mut st, x)
    for j <- iter.Range(0, 6) {
        d := c / pow8(j) % 8
        v := pcField(x, j)
        if d == 1 && v != -1 {
            if spRiskName(mut st, NodeRef(v), nested, fnps) {
                return true
            }
        } else if d == 3 && v != -1 {
            l := ListRef(v)
            for i <- iter.Range(0, lenL(mut st, l)) {
                if spRiskName(mut st, latN(mut st, l, i), nested, fnps) {
                    return true
                }
            }
        }
    }
    return false
}

// 関数の本体nの中の、task.Runの本体の入れ子で束縛した名前（本体の頭の文の束縛は数えない）
func spNestedNames(st mut S, n NodeRef) []StrRef {
    // 名前はヒープの末尾に積む（再帰する mut の関数へ局所の mut slice を st と一緒に渡すと check の 1 slot の規則に掛かる — coreFreeと同じ）
    base := hlen(mut st)
    spWalkRun(mut st, n)
    mut out := mut []StrRef{}
    for q <- iter.Range(base, hlen(mut st)) {
        out = append(out, StrRef(hget(mut st, q)))
    }
    return freeze(out)
}

// 木nを歩き、task.Runの呼び出しの本体を見つけたら、頭の文の束縛を外して入れ子の束縛を集める
func spWalkRun(st mut S, n NodeRef) {
    if n == -1 {
        return
    }
    x := nodeOf(mut st, n)
    if x.kind == ast.ECall {
        cal0 := nA(x)
        cal := if kindN(mut st, cal0) == ast.EIndex { nA(nodeOf(mut st, cal0)) } else { cal0 }
        fk := findFn(mut st, cal, -1)
        args := lB(x)
        if fk >= 0 && ParKey(mut st, fk) == PAR_SCOPE && lenL(mut st, args) >= 1 && kindN(mut st, latN(mut st, args, 0)) == ast.ELambda {
            body := nB(nodeOf(mut st, latN(mut st, args, 0)))
            bk := kindN(mut st, body)
            if bk == ast.EBlock || bk == ast.KBlock {
                ss := lA(nodeOf(mut st, body))
                for i <- iter.Range(0, lenL(mut st, ss)) {
                    sn := latN(mut st, ss, i)
                    if sn != -1 && kindN(mut st, sn) == ast.SBind {
                        vs := lC(nodeOf(mut st, sn))
                        for q <- iter.Range(0, lenL(mut st, vs)) {
                            spCollect(mut st, latN(mut st, vs, q))
                        }
                    } else {
                        spCollect(mut st, sn)
                    }
                }
            } else {
                spCollect(mut st, body)
            }
            for i <- iter.Range(1, lenL(mut st, args)) {
                spWalkRun(mut st, latN(mut st, args, i))
            }
            return
        }
    }
    c := pcDesc(mut st, x)
    for j <- iter.Range(0, 6) {
        d := c / pow8(j) % 8
        v := pcField(x, j)
        if d == 1 && v != -1 {
            spWalkRun(mut st, NodeRef(v))
        } else if d == 3 && v != -1 {
            l := ListRef(v)
            for i <- iter.Range(0, lenL(mut st, l)) {
                spWalkRun(mut st, latN(mut st, l, i))
            }
        }
    }
}

// 木nの中の束縛の名前（:= の名前・for の生成の名前・ラムダの仮引数）を全部集める
func spCollect(st mut S, n NodeRef) {
    if n == -1 {
        return
    }
    x := nodeOf(mut st, n)
    if x.kind == ast.SBind || x.kind == ast.KGen {
        l := lA(x)
        for i <- iter.Range(0, lenL(mut st, l)) {
            hpush(mut st, int(latS(mut st, l, i)))
        }
    } else if x.kind == ast.KLParam {
        hpush(mut st, int(sA(x)))
    }
    c := pcDesc(mut st, x)
    for j <- iter.Range(0, 6) {
        d := c / pow8(j) % 8
        v := pcField(x, j)
        if d == 1 && v != -1 {
            spCollect(mut st, NodeRef(v))
        } else if d == 3 && v != -1 {
            l := ListRef(v)
            for i <- iter.Range(0, lenL(mut st, l)) {
                spCollect(mut st, latN(mut st, l, i))
            }
        }
    }
}
