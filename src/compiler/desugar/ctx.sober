package desugar

// 文脈の束（C10）: 関数・展開・ラムダ・辞書const・switchの入口で、入れ子に積む状態を丸ごと退避して戻す。フィールドはSに平らに置いたまま
// （参照はst.tenv等のまま）、束の取り出し / 書き戻しをここ1か所に定義する — 退避の書き忘れ・戻し忘れのフィールドが構造的に出ない。
// 文脈のフィールドは入れ子の規律（内側で変えたら内側で戻す）なので、ある入口で使わないフィールドも束ごと戻してよい（内側が釣り合っていればno-op）

// 関数の本体を脱糖する文脈（package・型環境・結果・return / breakの行き先・展開のチェーン・持ち上げの外側・辞書const）
type FnCtx struct {
    curPkg int
    tenv int
    curTparams int
    curRes ListRef
    curResPkg int
    curRtys ListRef
    retTarget int
    loopFloor int
    inlrec int
    hasOuter int
    outerB int
    outerF int
    inDict int
}

func fnCtx(st mut S) FnCtx {
    return FnCtx{curPkg: st.curPkg, tenv: st.tenv, curTparams: st.curTparams, curRes: st.curRes, curResPkg: st.curResPkg, curRtys: st.curRtys, retTarget: st.retTarget, loopFloor: st.loopFloor, inlrec: st.inlrec, hasOuter: st.hasOuter, outerB: st.outerB, outerF: st.outerF, inDict: st.inDict}
}

func setFnCtx(st mut S, c FnCtx) {
    st.curPkg = c.curPkg
    st.tenv = c.tenv
    st.curTparams = c.curTparams
    st.curRes = c.curRes
    st.curResPkg = c.curResPkg
    st.curRtys = c.curRtys
    st.retTarget = c.retTarget
    st.loopFloor = c.loopFloor
    st.inlrec = c.inlrec
    st.hasOuter = c.hasOuter
    st.outerB = c.outerB
    st.outerF = c.outerF
    st.inDict = c.inDict
}

// 型パターンのswitchの文脈（分岐の束縛名が指すsubject・wildの本体）
type SwCtx struct {
    swSubj int
    swSubjDecl int
    swSubjTy TyRef
    swDecl NodeRef
    swSubjSty int
    swEnv int
}

func swCtx(st mut S) SwCtx {
    return SwCtx{swSubj: st.swSubj, swSubjDecl: st.swSubjDecl, swSubjTy: st.swSubjTy, swDecl: st.swDecl, swSubjSty: st.swSubjSty, swEnv: st.swEnv}
}

func setSwCtx(st mut S, c SwCtx) {
    st.swSubj = c.swSubj
    st.swSubjDecl = c.swSubjDecl
    st.swSubjTy = c.swSubjTy
    st.swDecl = c.swDecl
    st.swSubjSty = c.swSubjSty
    st.swEnv = c.swEnv
}

// errorのswitchの文脈（分岐の `cause` が読むチェーンのレベルと型）
type ErrCtx struct {
    hasErrSw int
    errLevel int
    errTy TyRef
}

func errCtx(st mut S) ErrCtx {
    return ErrCtx{hasErrSw: st.hasErrSw, errLevel: st.errLevel, errTy: st.errTy}
}

func setErrCtx(st mut S, c ErrCtx) {
    st.hasErrSw = c.hasErrSw
    st.errLevel = c.errLevel
    st.errTy = c.errTy
}

// 表層型検査器の文脈（package・型パラメータ名の列・局所の束縛のチェーン — typer.sober）
type YCtx struct {
    ypk int
    ytps ListRef
    yenv int
}

func yCtx(st mut S) YCtx {
    return YCtx{ypk: st.ypk, ytps: st.ytps, yenv: st.yenv}
}

func setYCtx(st mut S, c YCtx) {
    st.ypk = c.ypk
    st.ytps = c.ytps
    st.yenv = c.yenv
}
