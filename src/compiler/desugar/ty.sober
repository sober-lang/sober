package desugar

import "ast"
import "std/iter"
import "std/table"

// コアの型（LeanのTyと同形 — [tag, a, b, c, d]）と、src/stage1/desugar.zigの型の小道具のコピー。
// 型は st.types（Ty の表）に intern する — 同じ形の型は同じ参照（mkTy）。型の記録は作ったら変えない。
// 型の参照 = TyRef（TBASE + 添字。ヒープの番地と取り違えて hget すると範囲外で panic する — 音を立てる）。無しは -1（`!= -1` で見る）

const TInt = 1
const TVar = 2   // a = 添字
const TBool = 3
const TUnit = 4
const TOpt = 5   // a = 中身
const TSl = 6    // a = m, b = r, c = 要素, d = str（stringのフラグ）
const TMp = 7    // a = m, b = r, c = キー, d = 値
const TUn = 8    // a = l, b = r
const TPr = 9    // a = l, b = r
const TRef = 10  // a = m, b = r, c = 中身
const TChan = 11 // a = rc, b = 中身
const TFn = 12   // a = p, b = r
// byteの段階で足した種類（LeanのTy.byte — language.md 33 節。区域系の述語はintと同じ扱い）
const TByte = 13
// floatの段階で足した種類（LeanのTy.f64 — language.md 37 節。表層の名前はfloat。区域系の述語はintと同じ扱い）
const TFloat = 14
// 単一 task が所有する能力（Lean の Ty.own）: a = 種類（OWN_*）, b = 家の region, c = 結果 / ペイロードの型
const TOwn = 15
// 再帰型（Lean の Ty.rvar / Ty.mus / Ty.muRs — iso の同時の μ。language.md 1 節）: TRVar の a = 再帰の変数（de Bruijn）・
// TMuS（S）のa = 成分の数n・b = 成分の番号i・c = 組（本体のprodのチェーン）/ TMuRs（D）のa = 座標r・b = n・c = i・d = 組（本体は局所座標 — region 0）
const TRVar = 16
const TMuS = 17
const TMuRs = 18
const OWN_SCOPE = 0
const OWN_TASK = 1
const OWN_TX = 2
const OWN_RX = 3
// domain（Leanの Ty.dom r s — 種類4のownとして持ち、JSONとcheckerの境でdomへ変換する: regionのずらし・変換の分岐はownと同じ）
const OWN_DOM = 4

// 推論用のプレースホルダ tvar の底
const PH = 1048576

// 型の参照（language.md 32 節の named scalar — 式・節・ヒープの番地の int と取り違えない）
type TyRef int

// 型1つ（st.typesの要素）。フィールドの意味は種類ごとに違う（上の表）— 読むのは下の型付きの読み出しAPIから
type Ty struct {
    tag int
    a int
    b int
    c int
    d int
}

const TBASE = 1099511627776
const TBUCKETS = 65536

// 木の節の総数に見合うハッシュ表の頭の数（2 の冪・1024〜TBUCKETS）
func bucketsFor(ts []ast.Tree) int {
    mut n := 0
    for i <- iter.Range(0, len(ts)) {
        n += len(ts[i].nodes)
    }
    mut b := 1024
    while b < n && b < TBUCKETS {
        b = b * 2
    }
    return b
}

// 表の頭の数（初期化前のゼロ値の S — Init を通らない経路 — は TBUCKETS）
func bucketsOf(b int) int {
    return if b > 0 { b } else { TBUCKETS }
}

// 型 t の記録（非ジェネリックの包み — F-10）
func tyAt(st mut S, t TyRef) Ty {
    return table.Get(mut st.types, int(t) - TBASE)
}

func tyHash(x int) int {
    return (x % 1000003 + 1000003) % 1000003
}

// 型 [tag, a, b, c, d] の参照（同じ形が既にあればそれ — intern。表のチェーン = st.tyBucketの頭 → st.tyNext）。
// フィールドは生のint（子の型はint(t)）— 外からは下の種類つきの構築子で作る
func mkTy(st mut S, tag int, a int, b int, c int, d int) TyRef {
    if table.Len(mut st.tyBucket) == 0 {
        for _ <- iter.Range(0, bucketsOf(st.hbuckets)) {
            table.Push(mut st.tyBucket, -1)
        }
    }
    hb := (((((tyHash(tag) * 31 + tyHash(a)) % 1000003) * 31 + tyHash(b)) % 1000003 * 31 + tyHash(c)) % 1000003 * 31 + tyHash(d)) % bucketsOf(st.hbuckets)
    mut i := table.Get(mut st.tyBucket, hb)
    while i >= 0 {
        x := tyAt(mut st, TyRef(TBASE + i))
        if x.tag == tag && x.a == a && x.b == b && x.c == c && x.d == d {
            return TyRef(TBASE + i)
        }
        i = table.Get(mut st.tyNext, i)
    }
    n := table.Len(mut st.types)
    table.Push(mut st.types, Ty{tag: tag, a: a, b: b, c: c, d: d})
    table.Push(mut st.tyNext, table.Get(mut st.tyBucket, hb))
    table.Set(mut st.tyBucket, hb, n)
    return TyRef(TBASE + n)
}

func b2i(b bool) int {
    return if b { 1 } else { 0 }
}

func tg(st mut S, t TyRef) int {
    return tyAt(mut st, t).tag
}

// ── 種類つきの構築子（m / strは0 / 1のフラグ、rはregionの添字）──

func tRVar(st mut S, i int) TyRef {
    return mkTy(mut st, TRVar, i, 0, 0, 0)
}

func tMuS(st mut S, n int, i int, bs TyRef) TyRef {
    return mkTy(mut st, TMuS, n, i, int(bs), 0)
}

func tMuRs(st mut S, r int, n int, i int, bs TyRef) TyRef {
    return mkTy(mut st, TMuRs, r, n, i, int(bs))
}

// D の μ の座標 r を差し替えた型
func tMuRsAt(st mut S, t TyRef, r int) TyRef {
    x := tyAt(mut st, t)
    return mkTy(mut st, TMuRs, r, x.b, x.c, x.d)
}

// 組のチェーンbsのc番目の成分の本体（チェーンの外はunit — LeanのTy.comp）
func tyComp(st mut S, bs TyRef, c int) TyRef {
    mut t := bs
    mut k := c
    while k > 0 && tg(mut st, t) == TPr {
        t = tRight(mut st, t)
        k -= 1
    }
    return if tg(mut st, t) == TPr { tLeft(mut st, t) } else { st.tUnit }
}

// 再帰の変数 k を閉じた型 s に置き換える（Lean の Ty.rsubst — 束縛の下は k + n。s は閉じているので持ち上げない）
func tyRsubst(st mut S, t TyRef, k int, s TyRef) TyRef {
    x := tyAt(mut st, t)
    return switch x.tag {
    case TRVar: if x.a == k { s } else { t }
    case TOpt: tOpt(mut st, tyRsubst(mut st, TyRef(x.a), k, s))
    case TUn | TPr | TFn: mkTy(mut st, x.tag, int(tyRsubst(mut st, TyRef(x.a), k, s)), int(tyRsubst(mut st, TyRef(x.b), k, s)), x.c, x.d)
    case TSl | TRef | TOwn: mkTy(mut st, x.tag, x.a, x.b, int(tyRsubst(mut st, TyRef(x.c), k, s)), x.d)
    case TMp: mkTy(mut st, TMp, x.a, x.b, int(tyRsubst(mut st, TyRef(x.c), k, s)), int(tyRsubst(mut st, TyRef(x.d), k, s)))
    case TChan: mkTy(mut st, TChan, x.a, int(tyRsubst(mut st, TyRef(x.b), k, s)), 0, 0)
    case TMuS: tMuS(mut st, x.a, x.b, tyRsubst(mut st, TyRef(x.c), k + x.a, s))
    case TMuRs: tMuRs(mut st, x.a, x.b, x.c, tyRsubst(mut st, TyRef(x.d), k + x.b, s))
    default: t
    }
}

// 局所座標（region 0）の本体を座標 r へ（Lean の Ty.shiftR r — 関数型・S の μ は base 座標のスキームなので触らない）
func tyShiftR(st mut S, t TyRef, r int) TyRef {
    if r == 0 {
        return t
    }
    x := tyAt(mut st, t)
    return switch x.tag {
    case TOpt: tOpt(mut st, tyShiftR(mut st, TyRef(x.a), r))
    case TUn | TPr: mkTy(mut st, x.tag, int(tyShiftR(mut st, TyRef(x.a), r)), int(tyShiftR(mut st, TyRef(x.b), r)), 0, 0)
    case TSl | TRef | TOwn: mkTy(mut st, x.tag, x.a, x.b + r, int(tyShiftR(mut st, TyRef(x.c), r)), x.d)
    case TMp: mkTy(mut st, TMp, x.a, x.b + r, int(tyShiftR(mut st, TyRef(x.c), r)), int(tyShiftR(mut st, TyRef(x.d), r)))
    case TChan: mkTy(mut st, TChan, x.a + r, int(tyShiftR(mut st, TyRef(x.b), r)), 0, 0)
    case TMuRs: tMuRsAt(mut st, t, x.a + r)
    default: t
    }
}

// 1レベルの展開（LeanのTy.unfold — 組の全成分を局所座標で代入してから本体ごとrへ）。μ でなければそのまま
func tyUnfold(st mut S, t TyRef) TyRef {
    x := tyAt(mut st, t)
    if x.tag == TMuRs {
        mut b := tyComp(mut st, TyRef(x.d), x.c)
        for j <- iter.Range(0, x.b) {
            b = tyRsubst(mut st, b, j, tMuRs(mut st, 0, x.b, j, TyRef(x.d)))
        }
        return tyShiftR(mut st, b, x.a)
    }
    if x.tag == TMuS {
        mut b := tyComp(mut st, TyRef(x.c), x.b)
        for j <- iter.Range(0, x.a) {
            b = tyRsubst(mut st, b, j, tMuS(mut st, x.a, j, TyRef(x.c)))
        }
        return b
    }
    return t
}

// 再帰型（fold / unfold が扱う μ）か
func isMu(st mut S, t TyRef) bool {
    k := tg(mut st, t)
    return k == TMuRs || k == TMuS
}

func tSliceOf(st mut S, m int, r int, e TyRef, str int) TyRef {
    return mkTy(mut st, TSl, m, r, int(e), str)
}

func tSlice(st mut S, m bool, r int, t TyRef, str bool) TyRef {
    return tSliceOf(mut st, b2i(m), r, t, b2i(str))
}

func tMapOf(st mut S, m int, r int, k TyRef, v TyRef) TyRef {
    return mkTy(mut st, TMp, m, r, int(k), int(v))
}

func tMap(st mut S, m bool, r int, k TyRef, t TyRef) TyRef {
    return tMapOf(mut st, b2i(m), r, k, t)
}

func tRefOf(st mut S, m int, r int, t TyRef) TyRef {
    return mkTy(mut st, TRef, m, r, int(t), 0)
}

func tChanOf(st mut S, rc int, t TyRef) TyRef {
    return mkTy(mut st, TChan, rc, int(t), 0, 0)
}

func tOpt(st mut S, t TyRef) TyRef {
    return mkTy(mut st, TOpt, int(t), 0, 0, 0)
}

// 二項の型（k = TUn / TPr / TFn）
func tPair(st mut S, k int, l TyRef, r TyRef) TyRef {
    return mkTy(mut st, k, int(l), int(r), 0, 0)
}

func tProd(st mut S, l TyRef, r TyRef) TyRef {
    return tPair(mut st, TPr, l, r)
}

func tUnion(st mut S, l TyRef, r TyRef) TyRef {
    return tPair(mut st, TUn, l, r)
}

func tFn(st mut S, p TyRef, r TyRef) TyRef {
    return tPair(mut st, TFn, p, r)
}

// 能力の型（k = OWN_*）
func tOwn(st mut S, k int, r int, t TyRef) TyRef {
    return mkTy(mut st, TOwn, k, r, int(t), 0)
}

func tVar(st mut S, i int) TyRef {
    return mkTy(mut st, TVar, i, 0, 0, 0)
}

// byte の型（language.md 33 節 — intern なので作るたびに同じ参照）
func tByte(st mut S) TyRef {
    return mkTy(mut st, TByte, 0, 0, 0, 0)
}

// float の型（language.md 37 節 — intern）
func tFloat(st mut S) TyRef {
    return mkTy(mut st, TFloat, 0, 0, 0, 0)
}

func tString(st mut S) TyRef {
    return tSlice(mut st, false, 0, tByte(mut st), true)
}

// ── ヒープ越しの型（型の列・型環境のフィールド — ヒープはintの表なので出し入れで変換する）──

func hgetTy(st mut S, i int) TyRef {
    return TyRef(hget(mut st, i))
}

func hsetTy(st mut S, i int, t TyRef) {
    hset(mut st, i, int(t))
}

func latTy(st mut S, l ListRef, i int) TyRef {
    return TyRef(latI(mut st, l, i))
}

// ── 型付きの読み出しAPI ──

// T? の中身
func tInner(st mut S, t TyRef) TyRef {
    return TyRef(tyAt(mut st, t).a)
}

// tLeft / tRight は二項の型（union / prod / 関数 = 引数と結果）の左右
func tLeft(st mut S, t TyRef) TyRef {
    return TyRef(tyAt(mut st, t).a)
}

func tRight(st mut S, t TyRef) TyRef {
    return TyRef(tyAt(mut st, t).b)
}

// slice の要素・ref の中身
func tElem(st mut S, t TyRef) TyRef {
    return TyRef(tyAt(mut st, t).c)
}

// tKey / tVal は map のキーと値
func tKey(st mut S, t TyRef) TyRef {
    return TyRef(tyAt(mut st, t).c)
}

func tVal(st mut S, t TyRef) TyRef {
    return TyRef(tyAt(mut st, t).d)
}

// チャネルの中身
func tChanElem(st mut S, t TyRef) TyRef {
    return TyRef(tyAt(mut st, t).b)
}

// slice / map / ref の m（0 = imm、1 = mut）、tRegion はその region
func tMutBit(st mut S, t TyRef) int {
    return tyAt(mut st, t).a
}

func tRegion(st mut S, t TyRef) int {
    return tyAt(mut st, t).b
}

// sliceのstringのフラグ
func tStrBit(st mut S, t TyRef) int {
    return tyAt(mut st, t).d
}

// tvar の添字、tChanRc はチャネルの rc
func tVarIdx(st mut S, t TyRef) int {
    return tyAt(mut st, t).a
}

func tChanRc(st mut S, t TyRef) int {
    return tyAt(mut st, t).a
}

// t（-1 可）が string か
func isStringTy(st mut S, t TyRef) bool {
    return t != -1 && tg(mut st, t) == TSl && tStrBit(mut st, t) != 0
}

func isTag(st mut S, t TyRef, k int) bool {
    return t != -1 && tg(mut st, t) == k
}

// 二項の型（union / prod / 関数）の種類か
func isPair(k int) bool {
    return k == TUn || k == TPr || k == TFn
}

// 構造一致（region・mut・stringのフラグも見る）
func tyEql(st mut S, a TyRef, b TyRef) bool {
    k := tg(mut st, a)
    if k != tg(mut st, b) {
        return false
    }
    switch k {
    case TInt | TBool | TUnit | TByte | TFloat:
        return true
    case TVar:
        return tVarIdx(mut st, a) == tVarIdx(mut st, b)
    case TOpt:
        return tyEql(mut st, tInner(mut st, a), tInner(mut st, b))
    case TRVar | TMuS | TMuRs:
        // hash-cons — 同じ形は同じ参照（μ の中は見ない — iso）
        return a == b
    }
    if isPair(k) {
        return tyEql(mut st, tLeft(mut st, a), tLeft(mut st, b)) && tyEql(mut st, tRight(mut st, a), tRight(mut st, b))
    }
    return switch k {
    case TRef: tMutBit(mut st, a) == tMutBit(mut st, b) && tRegion(mut st, a) == tRegion(mut st, b) && tyEql(mut st, tElem(mut st, a), tElem(mut st, b))
    case TSl: tMutBit(mut st, a) == tMutBit(mut st, b) && tRegion(mut st, a) == tRegion(mut st, b) && tStrBit(mut st, a) == tStrBit(mut st, b) && tyEql(mut st, tElem(mut st, a), tElem(mut st, b))
    case TMp: tMutBit(mut st, a) == tMutBit(mut st, b) && tRegion(mut st, a) == tRegion(mut st, b) && tyEql(mut st, tKey(mut st, a), tKey(mut st, b)) && tyEql(mut st, tVal(mut st, a), tVal(mut st, b))
    case TChan: tChanRc(mut st, a) == tChanRc(mut st, b) && tyEql(mut st, tChanElem(mut st, a), tChanElem(mut st, b))
    case TOwn: tyAt(mut st, a).a == tyAt(mut st, b).a && tRegion(mut st, a) == tRegion(mut st, b) && tyEql(mut st, tElem(mut st, a), tElem(mut st, b))
    default: false
    }
}

// aをbへ緩められるか（LeanのTy.subの鏡 — mutの分岐は等しいときだけ）
func tyLooser(st mut S, a TyRef, b TyRef) bool {
    // 型の読めない値（-1 — 分岐の型を束縛なしで推定するときのパターンの名前など）は比べない
    if a == -1 || b == -1 {
        return false
    }
    k := tg(mut st, a)
    if k != tg(mut st, b) {
        return false
    }
    return switch k {
    case TOpt: tyLooser(mut st, tInner(mut st, a), tInner(mut st, b))
    case TUn | TPr: tyLooser(mut st, tLeft(mut st, a), tLeft(mut st, b)) && tyLooser(mut st, tRight(mut st, a), tRight(mut st, b))
    case TSl: if tMutBit(mut st, a) != 0 || tMutBit(mut st, b) != 0 { tyEql(mut st, a, b) } else { tRegion(mut st, a) <= tRegion(mut st, b) && tyLooser(mut st, tElem(mut st, a), tElem(mut st, b)) }
    case TMp: if tMutBit(mut st, a) != 0 || tMutBit(mut st, b) != 0 { tyEql(mut st, a, b) } else { tRegion(mut st, a) <= tRegion(mut st, b) && tyLooser(mut st, tKey(mut st, a), tKey(mut st, b)) && tyLooser(mut st, tVal(mut st, a), tVal(mut st, b)) }
    case TRef: if tMutBit(mut st, a) != 0 || tMutBit(mut st, b) != 0 { tyEql(mut st, a, b) } else { tRegion(mut st, a) <= tRegion(mut st, b) && tyEql(mut st, tElem(mut st, a), tElem(mut st, b)) }
    // Dの μ: 同じ組・同じ成分で外の座標だけ（深く共変な組ならr ≤ r'・そうでなければr = r' — LeanのsubのmuRsの分岐）
    case TMuRs: muRsBody(mut st, a) == muRsBody(mut st, b) && tyAt(mut st, a).b == tyAt(mut st, b).b && tyAt(mut st, a).c == tyAt(mut st, b).c && (tyAt(mut st, a).a == tyAt(mut st, b).a || (tyAt(mut st, a).a <= tyAt(mut st, b).a && tyCovOk(mut st, muRsBody(mut st, a))))
    // domain: 家のregionは上界（Leanのsubのdomの分岐）・状態の型は一致
    case TOwn: if tyAt(mut st, a).a == OWN_DOM && tyAt(mut st, b).a == OWN_DOM { tyAt(mut st, a).b <= tyAt(mut st, b).b && tyEql(mut st, TyRef(tyAt(mut st, a).c), TyRef(tyAt(mut st, b).c)) } else { tyEql(mut st, a, b) }
    default: tyEql(mut st, a, b)
    }
}

// region を見ない構造一致
func tyEqlLoose(st mut S, a TyRef, b TyRef) bool {
    k := tg(mut st, a)
    if k != tg(mut st, b) {
        return false
    }
    switch k {
    case TInt | TBool | TUnit | TByte | TFloat:
        return true
    case TVar:
        return tVarIdx(mut st, a) == tVarIdx(mut st, b)
    case TOpt:
        return tyEqlLoose(mut st, tInner(mut st, a), tInner(mut st, b))
    case TRVar | TMuS:
        return a == b
    case TMuRs:
        return tyAt(mut st, a).b == tyAt(mut st, b).b && tyAt(mut st, a).c == tyAt(mut st, b).c && muRsBody(mut st, a) == muRsBody(mut st, b)
    }
    if isPair(k) {
        return tyEqlLoose(mut st, tLeft(mut st, a), tLeft(mut st, b)) && tyEqlLoose(mut st, tRight(mut st, a), tRight(mut st, b))
    }
    return switch k {
    case TSl | TRef: tMutBit(mut st, a) == tMutBit(mut st, b) && tyEqlLoose(mut st, tElem(mut st, a), tElem(mut st, b))
    case TMp: tMutBit(mut st, a) == tMutBit(mut st, b) && tyEqlLoose(mut st, tKey(mut st, a), tKey(mut st, b)) && tyEqlLoose(mut st, tVal(mut st, a), tVal(mut st, b))
    case TChan: tyEqlLoose(mut st, tChanElem(mut st, a), tChanElem(mut st, b))
    case TOwn: tyAt(mut st, a).a == OWN_DOM && tyAt(mut st, b).a == OWN_DOM && tyEqlLoose(mut st, TyRef(tyAt(mut st, a).c), TyRef(tyAt(mut st, b).c))
    default: false
    }
}

// base座標の型を今の点座標（最内region = rdepth - 1）へ変換する
func pointTy(st mut S, t TyRef) TyRef {
    k := tg(mut st, t)
    r := st.rdepth - 1
    switch k {
    case TOpt:
        return tOpt(mut st, pointTy(mut st, tInner(mut st, t)))
    case TUn | TPr:
        l := pointTy(mut st, tLeft(mut st, t))
        return tPair(mut st, k, l, pointTy(mut st, tRight(mut st, t)))
    case TSl:
        return tSliceOf(mut st, tMutBit(mut st, t), r, pointTy(mut st, tElem(mut st, t)), tStrBit(mut st, t))
    case TMp:
        kk := pointTy(mut st, tKey(mut st, t))
        return tMapOf(mut st, tMutBit(mut st, t), r, kk, pointTy(mut st, tVal(mut st, t)))
    case TRef:
        return tRefOf(mut st, tMutBit(mut st, t), r, pointTy(mut st, tElem(mut st, t)))
    case TMuRs:
        return tMuRsAt(mut st, t, r)
    case TOwn:
        // domain（関数の仮引数・フィールドの型 — 家のregion 0は呼び手空間の上界）: 点の最内へ
        if tyAt(mut st, t).a == OWN_DOM {
            return mkTy(mut st, TOwn, OWN_DOM, r, tyAt(mut st, t).c, tyAt(mut st, t).d)
        }
    }
    return t
}

// tyClamp は imm の region を k へ締める（Lean の Ty.clampR）
// tyRelocAllはimmのコンテナ / 参照のregionを全部kへ（Leanの Ty.relocR k のimmの分岐 — taskの結果の型の変換先・P3b-4。
// mut は触らない — task の結果は mutFree）
func tyRelocAll(st mut S, t TyRef, k int) TyRef {
    x := tg(mut st, t)
    switch x {
    case TOpt:
        return tOpt(mut st, tyRelocAll(mut st, tInner(mut st, t), k))
    case TUn | TPr:
        l := tyRelocAll(mut st, tLeft(mut st, t), k)
        return tPair(mut st, x, l, tyRelocAll(mut st, tRight(mut st, t), k))
    case TSl:
        if tMutBit(mut st, t) != 0 {
            return t
        }
        return tSliceOf(mut st, 0, k, tyRelocAll(mut st, tElem(mut st, t), k), tStrBit(mut st, t))
    case TMp:
        if tMutBit(mut st, t) != 0 {
            return t
        }
        kk := tyRelocAll(mut st, tKey(mut st, t), k)
        return tMapOf(mut st, 0, k, kk, tyRelocAll(mut st, tVal(mut st, t), k))
    case TRef:
        if tMutBit(mut st, t) != 0 {
            return t
        }
        return tRefOf(mut st, 0, k, tyRelocAll(mut st, tElem(mut st, t), k))
    case TMuRs:
        return if tyMutFreeD(mut st, muRsBody(mut st, t)) { tMuRsAt(mut st, t, k) } else { t }
    }
    return t
}

// domain の型（家の region r）: c = コアの状態の型（mut の器を imm に倒して region を全部 0 へ締めた像 — Lean の dom が梱包して持つ形）・
// d = 器をmutのままregionを0へ締めた状態の型 + 1（脱糖が入る / 出るの変換を組むときに引く — 型の同一性には入らない）
func tOwnDom(st mut S, r int, full TyRef) TyRef {
    return mkTy(mut st, TOwn, OWN_DOM, r, int(tyRelocAll(mut st, tyImmImg(mut st, full), 0)), int(tyRelocAllM(mut st, full, 0)) + 1)
}

// domain の型 t の mut の器を残した状態の型（d が無ければ像そのもの）
func tDomFull(st mut S, t TyRef) TyRef {
    d := tyAt(mut st, t).d
    return if d > 0 { TyRef(d - 1) } else { tElem(mut st, t) }
}

// mut の器（slice / map / 参照）を imm に倒した型（region はそのまま）
func tyImmImg(st mut S, t TyRef) TyRef {
    x := tg(mut st, t)
    switch x {
    case TOpt:
        return tOpt(mut st, tyImmImg(mut st, tInner(mut st, t)))
    case TUn | TPr:
        l := tyImmImg(mut st, tLeft(mut st, t))
        return tPair(mut st, x, l, tyImmImg(mut st, tRight(mut st, t)))
    case TSl:
        return tSliceOf(mut st, 0, tRegion(mut st, t), tyImmImg(mut st, tElem(mut st, t)), tStrBit(mut st, t))
    case TMp:
        kk := tyImmImg(mut st, tKey(mut st, t))
        return tMapOf(mut st, 0, tRegion(mut st, t), kk, tyImmImg(mut st, tVal(mut st, t)))
    case TRef:
        return tRefOf(mut st, 0, tRegion(mut st, t), tyImmImg(mut st, tElem(mut st, t)))
    }
    return t
}

// tyRelocAllのmutの器もkへ寄せる版（domainの状態を入る側の最内へ変換した型 — 器は入る変換で最内に作り直す）
func tyRelocAllM(st mut S, t TyRef, k int) TyRef {
    x := tg(mut st, t)
    switch x {
    case TOpt:
        return tOpt(mut st, tyRelocAllM(mut st, tInner(mut st, t), k))
    case TUn | TPr:
        l := tyRelocAllM(mut st, tLeft(mut st, t), k)
        return tPair(mut st, x, l, tyRelocAllM(mut st, tRight(mut st, t), k))
    case TSl:
        if tMutBit(mut st, t) != 0 {
            return tSliceOf(mut st, 1, k, tyRelocAllM(mut st, tElem(mut st, t), k), tStrBit(mut st, t))
        }
    case TMp:
        if tMutBit(mut st, t) != 0 {
            kk := tyRelocAll(mut st, tKey(mut st, t), k)
            return tMapOf(mut st, 1, k, kk, tyRelocAllM(mut st, tVal(mut st, t), k))
        }
    }
    return tyRelocAll(mut st, t, k)
}

func tyClamp(st mut S, t TyRef, k int) TyRef {
    x := tg(mut st, t)
    switch x {
    case TOpt:
        return tOpt(mut st, tyClamp(mut st, tInner(mut st, t), k))
    case TUn | TPr:
        l := tyClamp(mut st, tLeft(mut st, t), k)
        return tPair(mut st, x, l, tyClamp(mut st, tRight(mut st, t), k))
    case TSl:
        if tMutBit(mut st, t) != 0 {
            return t
        }
        return tSliceOf(mut st, 0, minI(tRegion(mut st, t), k), tyClamp(mut st, tElem(mut st, t), k), tStrBit(mut st, t))
    case TMp:
        if tMutBit(mut st, t) != 0 {
            return t
        }
        kk := tyClamp(mut st, tKey(mut st, t), k)
        return tMapOf(mut st, 0, minI(tRegion(mut st, t), k), kk, tyClamp(mut st, tVal(mut st, t), k))
    case TRef:
        if tMutBit(mut st, t) != 0 {
            return t
        }
        return tRefOf(mut st, 0, minI(tRegion(mut st, t), k), tyClamp(mut st, tElem(mut st, t), k))
    case TMuRs:
        return if tyMutFreeD(mut st, muRsBody(mut st, t)) { tMuRsAt(mut st, t, minI(tyAt(mut st, t).a, k)) } else { t }
    }
    return t
}

func minI(a int, b int) int {
    return if a < b { a } else { b }
}

// 戻り値の最上段（値ラッパを分配した位置）の slice / map を自フレーム（r = 1）へ付け替える
func retTy(st mut S, t TyRef) TyRef {
    k := tg(mut st, t)
    if k == TSl {
        m := tMutBit(mut st, t) != 0
        return tSliceOf(mut st, tMutBit(mut st, t), 1, if m { tElem(mut st, t) } else { retTy(mut st, tElem(mut st, t)) }, tStrBit(mut st, t))
    }
    if k == TMp {
        m := tMutBit(mut st, t) != 0
        // キー型も中身（string キーの map — 値型と同じく自フレーム可。F-24）
        return tMapOf(mut st, tMutBit(mut st, t), 1, if m { tKey(mut st, t) } else { retTy(mut st, tKey(mut st, t)) }, if m { tVal(mut st, t) } else { retTy(mut st, tVal(mut st, t)) })
    }
    if k == TMuRs {
        return tMuRsAt(mut st, t, 1)
    }
    if !wrapsContainer(mut st, t) {
        return t
    }
    if k == TOpt {
        return tOpt(mut st, retTy(mut st, tInner(mut st, t)))
    }
    if k == TUn || k == TPr {
        l := retTy(mut st, tLeft(mut st, t))
        return tPair(mut st, k, l, retTy(mut st, tRight(mut st, t)))
    }
    return t
}

// 型の列（ヒープの列 — 要素はint(TyRef)）→ 右結合のprodチェーン（0はunit、1は素の型）
func tyChain(st mut S, l ListRef) TyRef {
    n := lenL(mut st, l)
    if n == 0 {
        return st.tUnit
    }
    mut acc := latTy(mut st, l, n - 1)
    mut i := n - 2
    while i >= 0 {
        acc = tProd(mut st, latTy(mut st, l, i), acc)
        i -= 1
    }
    return acc
}

// ゼロ値を持つ型か（language.md 15 節）
func hasZero(st mut S, t TyRef) bool {
    k := tg(mut st, t)
    if k == TInt || k == TBool || k == TUnit || k == TByte || k == TFloat || k == TOpt || k == TSl || k == TMp {
        return true
    }
    if k == TPr {
        return hasZero(mut st, tLeft(mut st, t)) && hasZero(mut st, tRight(mut st, t))
    }
    // D の μ: 展開のゼロ値を fold で包む（組の整形でガードの無い閉路は無い — 展開の連鎖は止まる）
    if k == TMuRs {
        return hasZero(mut st, tyUnfold(mut st, t))
    }
    return false
}

// 値ラッパ越しに最上段の slice / map を持つか
func wrapsContainer(st mut S, t TyRef) bool {
    k := tg(mut st, t)
    return switch k {
    case TSl | TMp | TMuRs: true
    case TOpt: wrapsContainer(mut st, tInner(mut st, t))
    case TUn | TPr: wrapsContainer(mut st, tLeft(mut st, t)) || wrapsContainer(mut st, tRight(mut st, t))
    default: false
    }
}

// t の imm の slice / map の region を r 以上へ上げた型（imm の参照は region の添字を上界に読める — 31 節。mut は上げない・
// immの要素・キー・値の中も上げる。string〔strのフラグ〕の要素はbyteなので触らない）。
// struct / union / optは成分ごと（値位置のifの分岐の合流）
func upRegion(st mut S, t TyRef, r int) TyRef {
    k := tg(mut st, t)
    if (k == TSl || k == TMp) && tMutBit(mut st, t) == 0 {
        // immの中身も上界へ読める（immのslice / mapの要素・キー・値: `[]string` の分岐は要素のstringのregionも合わせないと合流しない）
        x := tyAt(mut st, t)
        c := if k == TSl && x.d != 0 { x.c } else { int(upRegion(mut st, TyRef(x.c), r)) }
        d := if k == TMp { int(upRegion(mut st, TyRef(x.d), r)) } else { x.d }
        nr := if tRegion(mut st, t) < r { r } else { tRegion(mut st, t) }
        if nr == tRegion(mut st, t) && c == x.c && d == x.d {
            return t
        }
        return mkTy(mut st, k, x.a, nr, c, d)
    }
    if k == TPr || k == TUn {
        l := upRegion(mut st, tLeft(mut st, t), r)
        rr := upRegion(mut st, tRight(mut st, t), r)
        return if l == tLeft(mut st, t) && rr == tRight(mut st, t) { t } else { tPair(mut st, k, l, rr) }
    }
    if k == TOpt {
        i := upRegion(mut st, tInner(mut st, t), r)
        return if i == tInner(mut st, t) { t } else { tOpt(mut st, i) }
    }
    if k == TMuRs && tyMutFreeD(mut st, muRsBody(mut st, t)) && tyAt(mut st, t).a < r {
        return tMuRsAt(mut st, t, r)
    }
    return t
}

func hasRegion(st mut S, t TyRef) bool {
    k := tg(mut st, t)
    if k == TSl || k == TMp || k == TMuRs {
        return true
    }
    if k == TPr {
        return hasRegion(mut st, tLeft(mut st, t)) || hasRegion(mut st, tRight(mut st, t))
    }
    return false
}

// 値が型注釈を持たない型か（Lean の Ty.annFree）
func tyAnnFree(st mut S, t TyRef) bool {
    k := tg(mut st, t)
    return switch k {
    case TVar | TOpt | TUn | TMuRs: false
    case TPr: tyAnnFree(mut st, tLeft(mut st, t)) && tyAnnFree(mut st, tRight(mut st, t))
    case TSl: tMutBit(mut st, t) != 0 || tyAnnFree(mut st, tElem(mut st, t))
    case TMp: tMutBit(mut st, t) != 0
    default: true
    }
}

// k より深い region を指すか
func tyRegionAbove(st mut S, t TyRef, k int) bool {
    x := tg(mut st, t)
    return switch x {
    case TChan: tChanRc(mut st, t) > k + 1 || tyRegionAbove(mut st, tChanElem(mut st, t), k)
    case TOpt: tyRegionAbove(mut st, tInner(mut st, t), k)
    case TUn | TPr: tyRegionAbove(mut st, tLeft(mut st, t), k) || tyRegionAbove(mut st, tRight(mut st, t), k)
    case TSl | TRef: tRegion(mut st, t) > k || tyRegionAbove(mut st, tElem(mut st, t), k)
    case TMp: tRegion(mut st, t) > k || tyRegionAbove(mut st, tKey(mut st, t), k) || tyRegionAbove(mut st, tVal(mut st, t), k)
    case TMuRs: tyAt(mut st, t).a > k
    default: false
    }
}

// 型が chan を持たないか（Lean の Ty.chanFree — 境界コピー式 copyTo の前提）
func tyChanFree(st mut S, t TyRef) bool {
    x := tg(mut st, t)
    return switch x {
    case TChan: false
    case TOpt: tyChanFree(mut st, tInner(mut st, t))
    case TUn | TPr: tyChanFree(mut st, tLeft(mut st, t)) && tyChanFree(mut st, tRight(mut st, t))
    case TSl | TRef: tyChanFree(mut st, tElem(mut st, t))
    case TMp: tyChanFree(mut st, tKey(mut st, t)) && tyChanFree(mut st, tVal(mut st, t))
    case TMuRs: tyChanFree(mut st, muRsBody(mut st, t))
    case TMuS: tyChanFree(mut st, TyRef(tyAt(mut st, t).c))
    default: true
    }
}

// 型がmutのコンテナ・参照を持たないか（LeanのTy.mutFree — copyToでコピーできる値の型の判定。M4）
func tyMutFreeD(st mut S, t TyRef) bool {
    x := tg(mut st, t)
    return switch x {
    case TOpt: tyMutFreeD(mut st, tInner(mut st, t))
    case TUn | TPr: tyMutFreeD(mut st, tLeft(mut st, t)) && tyMutFreeD(mut st, tRight(mut st, t))
    case TSl | TRef: tMutBit(mut st, t) == 0 && tyMutFreeD(mut st, tElem(mut st, t))
    case TMp: tMutBit(mut st, t) == 0 && tyMutFreeD(mut st, tKey(mut st, t)) && tyMutFreeD(mut st, tVal(mut st, t))
    case TMuRs: tyMutFreeD(mut st, muRsBody(mut st, t))
    case TMuS: tyMutFreeD(mut st, TyRef(tyAt(mut st, t).c))
    default: true
    }
}

// 展開されるジェネリック・ジェネリック struct の型引数（チャネル・参照を含まない値の型）
func tyArgValueOk(st mut S, t TyRef) bool {
    k := tg(mut st, t)
    return switch k {
    case TRef | TChan: false
    case TOpt: tyArgValueOk(mut st, tInner(mut st, t))
    case TUn | TPr: tyArgValueOk(mut st, tLeft(mut st, t)) && tyArgValueOk(mut st, tRight(mut st, t))
    case TSl: tyArgValueOk(mut st, tElem(mut st, t))
    case TMp: tyArgValueOk(mut st, tKey(mut st, t)) && tyArgValueOk(mut st, tVal(mut st, t))
    case TMuRs: tyArgValueOk(mut st, muRsBody(mut st, t))
    default: true
    }
}

// Def として呼ぶジェネリックの型引数（region もチャネルも持たない）
func tyArgOk(st mut S, t TyRef) bool {
    k := tg(mut st, t)
    return switch k {
    case TSl | TMp | TRef | TChan | TMuRs: false
    case TOpt: tyArgOk(mut st, tInner(mut st, t))
    case TUn | TPr: tyArgOk(mut st, tLeft(mut st, t)) && tyArgOk(mut st, tRight(mut st, t))
    default: true
    }
}

// pat のプレースホルダ tvar を act の対応部分に束縛する（binds = 型の列 — 要素は int(TyRef)、未定は -1）。衝突は false
func unifyTy(st mut S, pat TyRef, act TyRef, binds ListRef) bool {
    k := tg(mut st, pat)
    if k == TVar && tVarIdx(mut st, pat) >= PH {
        i := tVarIdx(mut st, pat) - PH
        if i >= lenL(mut st, binds) {
            return true
        }
        b := latTy(mut st, binds, i)
        if b != -1 {
            return tyEqlLoose(mut st, b, act)
        }
        hsetTy(mut st, int(binds) + 1 + i, act)
        return true
    }
    if k != tg(mut st, act) {
        return true
    }
    if k == TOpt {
        return unifyTy(mut st, tInner(mut st, pat), tInner(mut st, act), binds)
    }
    if isPair(k) {
        return unifyTy(mut st, tLeft(mut st, pat), tLeft(mut st, act), binds) && unifyTy(mut st, tRight(mut st, pat), tRight(mut st, act), binds)
    }
    return switch k {
    case TSl | TRef: unifyTy(mut st, tElem(mut st, pat), tElem(mut st, act), binds)
    case TMp: unifyTy(mut st, tKey(mut st, pat), tKey(mut st, act), binds) && unifyTy(mut st, tVal(mut st, pat), tVal(mut st, act), binds)
    case TChan: unifyTy(mut st, tChanElem(mut st, pat), tChanElem(mut st, act), binds)
    case TMuRs: unifyTy(mut st, muRsBody(mut st, pat), muRsBody(mut st, act), binds)
    case TMuS: unifyTy(mut st, TyRef(tyAt(mut st, pat).c), TyRef(tyAt(mut st, act).c), binds)
    default: true
    }
}

// Dの μ の組（本体のprodのチェーン）
func muRsBody(st mut S, t TyRef) TyRef {
    return TyRef(tyAt(mut st, t).d)
}

// 深く共変な型（Lean の Ty.covOk — D の μ の部分型で座標を緩めてよい組）
func tyCovOk(st mut S, t TyRef) bool {
    k := tg(mut st, t)
    return switch k {
    case TOpt: tyCovOk(mut st, tInner(mut st, t))
    case TUn | TPr: tyCovOk(mut st, tLeft(mut st, t)) && tyCovOk(mut st, tRight(mut st, t))
    case TRef: tMutBit(mut st, t) == 0 && !tyRegionAbove(mut st, tElem(mut st, t), -1) && tyChanFree(mut st, tElem(mut st, t))
    case TSl: tMutBit(mut st, t) == 0 && tyCovOk(mut st, tElem(mut st, t))
    case TMp: tMutBit(mut st, t) == 0 && tyCovOk(mut st, tVal(mut st, t)) && tyCovOk(mut st, tKey(mut st, t))
    case TMuRs: tyCovOk(mut st, muRsBody(mut st, t))
    case TChan | TOwn: false
    default: true
    }
}
