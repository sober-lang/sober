package lower

// ループの region の省略の判定（rlight.sober llInsAllocs）の単体テスト（`cd compiler && ../bin/sober test lower`）: rt.region_relocate（ptr, i64, 深度）と
// rt.region_relocate8（ptr, 深度）は深度の実引数の位置が違う。relocate8 を relocate と同じ位置で読むと、2 引数の呼び出しはいつも「確保しうる」の
// 保守の側に倒れて周回の region が残っていた（report-499 H1）。今の深度 / 外の深度の 2 形を IR で組んで直に見る

import "desugar"

// llT は relocate（r8 = false）か relocate8（r8 = true）を、行き先の深度 = 今の深度（here = true — region.depth の値）か外の深度（関数の引数）で
// 1 回呼ぶ関数を組み、その呼び出しに llInsAllocs を当てる
func llT(r8 bool, here bool) bool {
    mut st := St{}
    initScalars(mut st)
    desugar.HeapPush(mut st.d, 0)
    pt := listN(mut st, 2)
    desugar.HeapSet(mut st.d, pt + 1, TyI64)
    desugar.HeapSet(mut st.d, pt + 2, TyI64)
    st.rtReloc = addFunc(mut st, 0, desugar.ListRef(list3(mut st, TyPtr, TyI64, TyI64)), -1)
    st.rtReloc8 = addFunc(mut st, 0, desugar.ListRef(list2(mut st, TyPtr, TyI64)), -1)
    f := addFunc(mut st, 0, desugar.ListRef(pt), TyI64)
    begin(mut st, f)
    d := if here { regionDepth(mut st) } else { 1 }
    if r8 {
        call(mut st, st.rtReloc8, list2(mut st, 0, d))
    } else {
        call(mut st, st.rtReloc, list3(mut st, 0, iconst(mut st, 3), d))
    }
    i := irBlkITail(mut st, st.cur)
    ret(mut st, 0)
    mut ma := mut map[int]int{}
    return llInsAllocs(mut st, i, mut ma, llDepths(mut st, f))
}

func TestLlInsAllocsReloc() {
    assert(llT(false, true))
    assert(!llT(false, false))
    assert(llT(true, true))
    // 外の深度へ写す relocate8（append の伸長 — 外の out のヘッダの深度）は今の深度で確保しない
    assert(!llT(true, false))
}

// llcT は入口で region を開かない関数 g（仮引数 0 = 条件）に、頭 H（setdepth）・本体の入口 B0（region.enter）・呼び出しのブロック C の
// ループを組み、llCallees が C の呼び出し（確保しうる関数 a）を g の要約の呼び先に数えた数を返す（0 = 除いた — G' report-541）。
// kind: 0 = C は B0 の後で H へ戻る（除く）・1 = C は break の側（ループの外の出口へ — 次の周へ戻れない）・2 = 入口から C へ直に入る辺がある
// （本体が B0 だけから入られない）・3 = 呼び出しがループの外（出口のブロック）・4 = C の呼び出しの前に setdepth（本体の途中の深度の戻し）
func llcT(kind int) int {
    mut st := St{}
    initScalars(mut st)
    desugar.HeapPush(mut st.d, 0)
    pt := listN(mut st, 1)
    desugar.HeapSet(mut st.d, pt + 1, TyI64)
    a := addFunc(mut st, 0, desugar.ListRef(listN(mut st, 0)), -1)
    g := addFunc(mut st, 0, desugar.ListRef(pt), -1)
    st.fn = g
    entry := newBlock(mut st)
    h := newBlock(mut st)
    b0 := newBlock(mut st)
    c := newBlock(mut st)
    x := newBlock(mut st)
    st.cur = entry
    d := regionDepth(mut st)
    if kind == 2 {
        condbr(mut st, 0, h, -1, c, -1)
    } else {
        br(mut st, h, -1)
    }
    setCur(mut st, h)
    regionSetDepth(mut st, d)
    condbr(mut st, 0, b0, -1, x, -1)
    setCur(mut st, b0)
    regionEnter(mut st)
    br(mut st, c, -1)
    setCur(mut st, c)
    if kind == 4 {
        regionSetDepth(mut st, d)
    }
    if kind != 3 {
        _ = call(mut st, a, listN(mut st, 0))
    }
    if kind == 1 {
        br(mut st, x, -1)
    } else {
        br(mut st, h, -1)
    }
    setCur(mut st, x)
    regionSetDepth(mut st, d)
    if kind == 3 {
        _ = call(mut st, a, listN(mut st, 0))
    }
    ret(mut st, -1)
    mut cs := mut []int{}
    llCallees(mut st, g, mut cs)
    return cs[1]
}

func TestLlCalleesInLoop() {
    // 0: 残る enter の下で次の周へ戻る呼び出しは g の要約に数えない
    assert(llcT(0) == 0)
    // 1: 戻れない側（break）の呼び出しは数える — その確保だけなら enter は消え、確保は g の入口の深度に落ちる（戻れるかの検査を外す変異はここで落ちる）
    assert(llcT(1) == 1)
    // 2: 本体へ B0 以外から入る道があれば数える（一つの入口の検査を外す変異はここで落ちる）
    assert(llcT(2) == 1)
    // 3: ループの外の呼び出しは数える
    assert(llcT(3) == 1)
    // 4: 本体の途中の setdepth の後ろの呼び出しは数える
    assert(llcT(4) == 1)
}
