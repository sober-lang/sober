package lower

// taskの器（段階6 P3b-1・language.md 11 節P3b・docs/ir.md 4.6）: std/taskの子は自前の機械スタックで走る。
// - 記録（TCB）は1チャンク [ガードページ | スタック1 MiB | ページ: スタックの頂上2 KiB + TCB | TC_SAVEの続き] のページの途中（mmap — NORESERVE・ガードは
//   PROT_NONE・TC_TOP = TCBの番地 — スタックはTCBの直下から下へ伸びる）。毎回触るスタックの頂上とTCBの先頭のフィールドを1ページに乗せる（
//   4096接続の公平な一巡でdTLB −12%・cycles −9%。前の並び [TCBのページ | ガード | スタック] ではスタックの頂上がTCBから1 MiB離れた別のページ）。終わったtaskのチャンクはプール
//   （@rt.taskの空きのチェーン）へ返して次のspawnが使う（mprotectはチャンクを作るときだけ）
// - 切替 = rt.task_switch(from, to) / 始める = rt.task_go(from, to): 今の task の深度・宛先 / anchor のレジスタ・最内の罠を from に退避し、
//   to のを戻して、OpTSwitch / OpTStart（今の文脈を from の記録の先頭語に積む）
// - 子の入口 = rt.task_start(tcb): 罠を張って子の関数を呼び（死は罠で受ける）、handle の枠に状態・死因を書き、scope の記録の死の数を数え、
//   チャンクをプールへ返してウェイクアップする側（waker — spawnしたtask）へ切り替える（戻らない）
// - 既定の方針 = 子を先に（spawn の時点で子へ切り替える — 子が終わるまで親は止まる。待つ形〔chan〕は P3b-2）
// region は P3a と同じ 1 本（子は中断しないので、親の死んだ深度のスロットをそのまま使う — 中断する task の region は P3b-2）

import "desugar"
import "std/iter"

// @rt.taskの配置（ワード）: [今のtaskのTCB, 空きのチャンクのチェーン]
const TK_CUR = 0
const TK_FREE = 1
const TK_READY = 2   // 走れるtaskの数（環 + 溢れの列 — 空 ⇔ 0。スタックはLIFO: spawnで親を積んで子を先に・子が終わるか待つと最後に積んだtaskが走る）
const TK_INLE = 3    // 縮退の記帳（admit.sober — rt.task_new が入場できず縮退に回した子の計上量と天井の節の最内。直後の rt.task_inline が入口で読む・同じワーカーの間に切替は無い）
const TK_INLN = 4
// 走れるスタックは配列の環（積み・取り出しがTCBのチェーンを触らない）: TK_RQH = 頭（次に積む添字 — 単調）・TK_RQT = 底。
// 枠 = [task の番地, 積んだ時刻の TSC]（期限 = 積んだ時刻 + D は rt.mn_next が深いときに底の 1 本でだけ計算する — D は底の TC_MAXW。積む口は掛け算を払わない）。
// 環が満杯（頭 − 底 = 容量）の押し込みは底の1本を溢れの列（旧のTCBのチェーン — TC_NEXT = 1つ新しい側・TC_PREV = 1つ古い側）の最新へ移してから積む。
// 溢れの列はどれも環のどれより古い — 頭の取り出しは環が空のときだけ溢れの最新から・底の取り出しは溢れが空でなければ溢れの最古から
// （WK_DQ の「固定の環 + あふれの逃げ道」と同じ型。容量 RQ_CAP は観測の最大〔async 24000 で ≈2,000 / ワーカー〕の 2 倍 — 溢れは通常は踏まない）
const TK_RQH = 5
const TK_RQT = 6
const TK_SPO = 7     // 溢れの列の最古（0 = 空）
const TK_SPN = 8     // 溢れの列の最新
const TK_FREEA = 9   // 所有エリアが自分でないチャンクの空きのチェーン（area.sober — フラグつきのspawnだけが引く）
const TK_RQ = 16     // 環の枠（2ワード × RQ_CAP — 頭と底のワードと行を分ける）
const RQ_CAP = 4096
const TK_WORDS = TK_RQ + 2 * RQ_CAP

// TCBの配置（ワード）
const TC_CTX = 0     // 退避した rsp（OpTSwitch / OpTStart が書く — 先頭語）
const TC_DEPTH = 1   // 退避した region の深度
const TC_BASE = 2    // spawn した時点の深度（自前の region はこれより深い）
const TC_DEST = 3    // 退避した W_DEST
const TC_ANCHOR = 4  // 退避した W_ANCHOR
const TC_TRAP = 5    // 退避した最内の罠（@rt.trap[0]）
const TC_WAKER = 6   // 終わったら切り替える task（spawn した task）
const TC_FRAME = 7   // handle の枠
const TC_KID = 8     // 子の関数の番地
const TC_NEXT = 9    // 空きのチェーン
const TC_TOP = 10    // スタックの頂上（チャンクの末尾）
const TC_STARTED = 12 // 1 = 走り始めた（0 = spawn で積まれただけ — 最初の切替は OpTStart で始める）
const TC_OWN = 11    // 退避した「自前のスロットを持つ最深の深度」（(TC_BASE, TC_OWN] の深度のスロットはこの task のもの — R1'）
const TC_SEG = 13    // 今書いている出力の区間（out.sober）
const TC_WORKER = 14 // 固定されたワーカーの番号（M:N — 走り始めたときに決まる・段階6 P4-4 mn.sober）
const TC_INEXT = 15  // 受け箱のチェーン（M:N）
const TC_ENTRY = 16  // 始めるときの入口（rt.task_start — M:N は rt.task_start_mn）
const TC_ID = 17     // 通し番号（M:N の trace）
const TC_KOFF = 18   // 枠の預かりのフィールドの位置（ワード — 結果がregionを持つ子だけ・(B1)）
const TC_SCOPE = 19  // 開いている最内のscopeの記録（SR_UPで外へ — 段階6 P4-5。0 = 無し）
const TC_CUTOK = 20  // 1 = 純な子（切ってよい — 段階6 P4-5 cancel.sober）・2 = 純でないがstdoutに書かない子（区間を持たない）。main・それ以外の子・走らせ直しは0。切ってよいかは1のビット
const TC_IDX = 21    // 生んだscopeの中の番号（生んだ順 — 打ち切りのフラグSR_CUTと比べる）
const TC_SITE = 22   // spawn の点の番号（1 始まり — 0 = 走らせ直し。計測〔spawn の点ごとの使用量〕・見積もりに使う）
const TC_ADM = 23    // 入場で台帳に積んだ量（admit.sober — 見積もりのバイト | 1 << LED_TSHIFT。0 = 計上していない〔main・走らせ直し〕）
const TC_NODE = 24   // 入場で足した天井の節の最内（budget: のscopeの記録 — 段階6 P5-3 admit.sober。0 = 根だけ）
const TC_DECL = 25   // 宣言の上界（budget: — 0 = 宣言なし。終わりで宣言超過を数える）
const TC_CNODE = 26  // 今効いている天井の節（spawn の子の入場が辿る入口 — 生まれたときは TC_NODE・budget: の scope の開閉で付け替える）
// 空きのチェーンの長さ（M:Nの手元のチェーン — この節から尾までの本数。tcb_freeのpushで頭の値 + 1・取りは触らない）
const TC_FLEN = 27
const TC_IORES = TC_FLEN + 1 // ring に出した io の結果（IO_PENDING = 完了をまだ取り込んでいない — uring.sober）
const TC_WAIT = TC_FLEN + 2  // 1 = 今waitのscopeの中（段階3の ③ admit.sober — 入場できない直接の子を待つ。scopeの開閉で付け替える・子は0で生まれる）
const TC_AWNEXT = TC_FLEN + 3 // 入場の待ちのチェーン（@rt.mn[MN_AWAIT] から — admit.sober）
const TC_SLOTSZ = TC_FLEN + 4 // この task の自前のスロットの大きさ（バイト — 宣言の無い子は W_SLOT_DEF・宣言の子はそれ以上の 2 の冪・main は起動の W_SLOT_SIZE。切替で meta の W_SLOT_SIZE へ）
const TC_WORDS = TC_FLEN + 5
// 自前の深度の [スロットの基底, bump] の退避（深度k → TC_SAVE + 2k・+1）。2 × (MAX_DEPTH + 1) ワード = 16 KiBの列なので記録の末尾に置く —
// 毎回のioのフィールド（TC_FLEN〜TC_SLOTSZ・TC_FDS / TC_CHS / TC_DL = ワード27〜34）をTC_NEXT等と同じ先頭のページに収め、完了1本でTCBの2ページを
// 触らないため（退避の列の後ろに置くとioのフィールドが5ページ目に来て、4096接続のringでdTLBの取りこぼし12 / リクエストのうち
// 3.6がrt.uring_pollのTC_IORESになる）。TC_SAVEはTC_DL・TC_LEASE（ワード35）・孤児の登録簿のTC_ORG（ワード36 — orphan.sober）・TC_NSLOT（ワード37）より後ろ・TC_END × 8 = 16,816 B < 予約ページの始まり（WIN_OFF = 18,432 — チャンクの末尾の4ページは浅いregionの予約ページ）
// 次のspawn 1回のスロットの大きさのフラグ（バイト — 0 = フラグなし。rt.netop 6が今のtaskに書き、rt.task_newが親のこのワードを読んで消す — std/netのServeのregion:）
const TC_NSLOT = 37
// 飽和下の待ちの上限（language.md 28 節io_uringのパス）: TC_PREV = 溢れの列の1つ古い側（走れるスタックの環から溢れたtaskだけ。
// netpollの時計のウェイクアップも一時のチェーンに使う）。TC_WAKE = 積んだ時刻（TSC — LedgerのmaxWaitと溢れの列の期限が読む）・TC_MAXW = このtaskのD（ns・0 = 既定MN_WAIT_DEF — 子は親から継ぐ）・TC_NMAXW = 次のspawn 1回のDのフラグ
// （rt.netop 7 — net.ServeのmaxWait:。rt.task_new_inが消費）。毎回の取り出し・押し込みが触るのでTC_NEXTと同じ先頭のページに（TC_ENDの後ろに置くと
// taskごとに1ページ増える — async 24000でRSS +100 MBの実測）
const TC_PREV = 38
const TC_WAKE = 39
const TC_MAXW = 40
const TC_NMAXW = 41
// 未着手の子の上限（language.md 11 節 — 1〜255・0 = 既定DQ_CAP − 1）: このtaskがspawnした子を列に積める本数。子は親から継ぐ・spawnごとに読むので先頭のページに
const TC_BACKLOG = 42
// 前回走り出した時刻（TSC — rt.mn_nextが取るたびにWK_NOW・spawnで親のワーカーのWK_NOW）。ミュータント4のoff-CPUの計測ツールが読む（off-CPU = 今 − このワード）
const TC_LRUN = 43
// 送信バッファリングのフラグ（netring.soberのrt.netop 9 / 1）: 1 = 次の送り1回を送信バッファリングにする（rt.netop 9が書き、送りが消費して0に）
const TC_FUSE = 44
// 予約ページから移した分（深度BASE + 1 + iの予約ページの使った分を16 bit × i — 0 = 移していない）。深度の入り・返しが読むので先頭のページに
const TC_WSP = 45
// チェーンの前のワードの番地（期限の待ちのチェーンUR_DLQ / EP_DLQと入場の待ちのチェーンMN_AWAIT — TC_AWNEXTと対。チェーンの頭のワードか前の節のTC_AWNEXTの番地・0 = どのチェーンにも居ない）。
// 取り外しをO(1) にする（受けの完了・期限の走査・孤児の走査が毎回触るので先頭のページに）
const TC_AWPREV = 46
// domain（domain.sober）: TC_DOM = 今入っている domain の記録（0 = 入っていない — 本体で死んだら task の終わりが毒を立てて鍵を返す）・
// TC_DQNEXT / TC_DQPREV = domainの待ちの列（Await — 期限のチェーンと同時に居るのでTC_AWNEXT / TC_AWPREVとは別の対）
const TC_DOM = 47
const TC_DQNEXT = 48
const TC_DQPREV = 49
// Await の待ちの到着の時刻（ns — 最初の待ちで置く・0 = 待っていない。期限 = 到着 + D・手渡しで戻っても列の位置と到着を保つ）
const TC_DQDL = 50
// Awaitの待ち手のwhenの鍵（domain.soberのdomWhenKey — 0 = まとめない）
const TC_DQKEY = 51
// Awaitの待ち手の到着の番号（Pの順）・居場所（0 = スリープしている列P・1 = ウェイクアップされ済み — domain.sober）。TC_SAVEは偶数に保つ（退避の対を16 Bに揃える）
const TC_DQSEQ = 52
const TC_DQH = 53
// 接続のtaskのスタック（area.sober）: TC_AREA = 所有エリアのエリアの頂上（チャンクを作ったときは自分のスタックの領域の頂上 = ページ0の底・交換で他のチャンクの領域に
// なりうる — チャンクと一緒にプールへ渡る）。TC_ONW = bit 0: フラグつきのspawn（net.Serveの接続 — 本体の入口で付け替える）・bit 1: ワーカーのエリアの上で
// 走っている（止まるとエリアを交換する）・bit 2（spawnする側）: 次のspawn 1回にフラグを付ける（rt.netop 10）
const TC_AREA = 54
const TC_ONW = 55
// シャロースリープ（area.sober）: 本体のrbpと、待っている接続の記録（ウェイクアップした後に待ち手を外す）。本体の戻り先はTC_CTXに置く（浅くスリープしたtaskは退避しない）
const TC_SRBP = 56
const TC_SNP = 57
// 予約ページの錨（エリアの予約ページを組むプログラム — task.sober予約ページの注記）: このtaskの予約ページ0の終わり（チャンクの予約ページならTCB + WIN_OFF + W・エリアの予約ページならエリアの頂上 +
// AWIN_OFF + W）。taskの予約ページはいつも一方の種類だけで、エリアの予約ページはいつも1つのエリア（走っているエリアか、深くスリープして持つエリア）に居る
const TC_WANCH = 58
const TC_SAVE = 60
const TC_END = TC_SAVE + 2 * (MAX_DEPTH + 1)
// 開いたfdのチェーンの頭（fd + 1・0 = 空 — 登録簿rt.soberのneedOpen）。sysOpenを使うプログラムでだけ使うワード（TC_WORDSの外）。mainの記録
// （rt.main_task）は退避の列の末尾まで（TC_END）なので、TC_FDS / TC_CHS / TC_DLはどのプログラムでも中にある。子のチャンクの記録はTASK_HEADのページの中
const TC_FDS = TC_WORDS

// 深度ごとのスロットの表（R1'）: @rt.slots[d] = 今の task の深度 d の region のスロットの基底・[MAX_DEPTH + 1] = 自前の
// スロットを持つ最深の深度（own）。main は予約のアリーナの d 番目（W_SLOTS + d × サイズ）・子はプール（@rt.slot_free — 空なら SLOT_CHUNK 本ぶんの VA を予約）から取る。
// スロットの大きさは task ごと（TC_SLOTSZ — main は起動の大きさ・子は既定 W_SLOT_DEF か budget: から導いた 2 の冪。今の task の値が meta の W_SLOT_SIZE）。
// プールは既定の大きさのスロットだけ — 既定より大きい子は深度ごとにmmapして終わりでmunmap。子が終わるとスロットはプールへ返る（先頭からW_MADVを超えて使ったページはMADV_DONTNEED）
const SLOT_OWN = MAX_DEPTH + 1
// 予備（parkで死んだ深度の返し — region-domain-pool.mdの格納場所の節）: 表の (SLOT_SPLO, SLOT_SPHI] のフィールドはワーカーの予備のスロット
// （どの task のものでもない — 表に置いたまま）。不変条件: SLOT_SPLO ≥ own（予備は今の task の自前の範囲より深い）。空 = SPLO ≥ SPHI。
// park（rt.task_wait・協調形の spawn の切替）で、task の (今の深度, own] を予備にして own を今の深度へ（main と既定より大きいスロットの task は返さない）。
// 次に深度own + 1へ入るtaskは、それが予備なら表のフィールドをそのまま採る（rt.slot_newの頭 — プールから取らない）。切替でtoの自前の範囲が予備に重なれば、
// 重なった予備はプールへ出す（taskHandover — toの退避がフィールドを上書きする前に）。プールへ出すときはmadviseしない（予備のbumpは前の持ち主の値で信用できない）
const SLOT_SPLO = MAX_DEPTH + 2
const SLOT_SPHI = MAX_DEPTH + 3
// 小さいスロット（既定より小さい task — std/net の Serve の region:）: 既定のスロット 1 本を k = 既定 ÷ 大きさ 本に割り、
// 深度ごとに1本ずつ取る。取りは ① 返された小さいスロットの深度ごとの列（手元 → 共有 — SM_CAPの注記）② 切り出しの位置
// （SLOT_SMC = 次の小さいスロットの番地・SLOT_SMN = 残りの本数・SLOT_SMZ = 大きさ — まだ使っていない小さいスロットには触らない）
// ③ 既定のスロットを1本取って切り出し直す。返したスロットのページには何も書かない（列はスロットの外 — 中にチェーンのワードを書く形は、列を1度通った
// スロットの先頭のページを全部常駐させる: 32000接続で +6 KB/接続）。既定のプールへは返さない（VAは小さいスロットの高水位で止まる）。
// 予備のフィールドの大きさのフラグSLOT_SPSZ（名前つきプールを使うプログラムだけ書く）: 予備を採るのは同じ大きさのtaskだけ
const SLOT_SPSZ = MAX_DEPTH + 4
const SLOT_SMC = MAX_DEPTH + 5
const SLOT_SMN = MAX_DEPTH + 6
const SLOT_SMZ = MAX_DEPTH + 7
// 返された小さいスロットの列は深度ごと（列r = d & DP_MASK — 既定のプールの深度ごとの列と同じ理由: 深度の役が揃い、W_MADV以下の触ったページを
// 別の役へ持ち回らない〔1 本の列では 32000 接続で常駐が 2 倍になる〕）。SLOT_SMH + r = 手元の列 r の数
const SLOT_SMH = MAX_DEPTH + 8
// 小さいスロットの手元の列（rt.smslots — ワーカーごと・深度ごとの列 r に SM_CAP 本）と共有の列（rt.ssm = [数の和, 列 r の数 × 32, 列 r の基底 × SSM_CAP × 32]
// — 鍵SSM_L〔既定のスロットのMN_RLOCKと別〕・溢れは手元の下半分をまとめて移す・全列の和がSSM_CAP本まで・越えたらmunmap）。既定のスロットの深度ごとのプール（WK_DPS / rt.sdp — mn.sober）と同じ形。基底には大きさのフラグ
// （smTag — 下位12ビット）を足して積み、取りはフラグが合うものだけ
const SM_CAP = 256
const SM_TAGM = 4095
const SSM_CAP = 65536
const SSM_S = 2 + DP_MASK
const SSM_L = SSM_S + (DP_MASK + 1) * SSM_CAP + 8   // 共有の列の鍵（数の和の行と分ける）
// 手元の列の上限（実行時 — 0 = 未設定・最初の rt.sm_give が決める）= clamp(SM_TOT ÷ ワーカー数, SM_MIN, SM_CAP)。全ワーカーの手元の和を
// ワーカー数に依らずSM_TOT本 × 列にする（手元の列にスリープしているスロットは他のワーカーが使い回せず、その分だけ新しく切り出して
// 先頭のページを触る: 固定の256では手元の和がワーカー数に比例し〔async 24000接続・W12で ≈170本 × 列 × ワーカー〕、本/接続の伸びの一部になる）。
// W ≤ 8は256のまま（keep-aliveのコストで確認済み）
const SSM_CW = SSM_L + 8   // 鍵の行と分ける（smallPush が毎回読む — 鍵の書き込みの行を読まない）
const SM_TOT = 2048
const SM_MIN = 16
const SLOT_FREE_CAP = 4096
// プールの冷えた水位（rt.slot_freeのSLOT_WMワード = 下から何本を先頭のW_MADVまで返し済みか・SLOT_WM + 1ワード = そのときの水位の位置のスロット — 番兵。
// pop / pushのパスでは触らない〔ホットパス — popごとのminでskynetの命令 +1.7%〕。次の刈り込みで、数が水位を割ったか水位の位置の番地が
// 番兵と違えば水位を 0 に戻して刈り直す。水位は最適化だけ — 外しても madvise が余分に走るか返し漏れるだけで、意味は変わらない）
const SLOT_WM = 1 + SLOT_FREE_CAP
const SLOT_CHUNK = 16
// SOBER_SCHED（決定的な再生）: 切替点ごとの選択の列 `SOBER_SCHED=1,0,2`（spawn = 0 子を先に / 1 親を先に・待つ / 終わる =
// 走れるtaskのスタックの上から何番目か）。列が尽きた後と選択肢が1つの点は0（既定の方針）。SOBER_SCHED_TRACE=1なら選択肢が2つ以上の点ごとに
// 標準エラーへ `#sched <選択肢の数> <選んだ番号>`（schedvec が全スケジュールを列挙するための足場）。@rt.sched = [列の長さ, 次の位置, trace, 列…]
const SCHED_CAP = 4096
const SCHED_SEED = 3 + SCHED_CAP   // @rt.sched の乱択の状態（0 = 使わない）
const SCHED_ACT = 4 + SCHED_CAP    // 選択の器を使うか（列・trace・シードのどれか — 0なら切替点は既定の選択0をrt.sched_pickを呼ばずに取る・段階6 P4-4）

// TCBの頭のページ（記録TC_ENDワード + 浅いregionの予約ページWIN_Nページ = 32 KiBの後にエリアの予約ページAWIN_Nページ — 予約ページの注記）
const TASK_HEAD = 49152
const TASK_GUARD = 4096
// TCBのページの中のスタックの頂上の余白（TCBはチャンクのページの先頭からこの位置に置き、スタックはその直下から下へ伸びる）。接続のtaskのkeep-aliveの
// 1リクエストの最深のスタックは「この余白 + 下の1ページ」に収める — 越えると接続ごとにスタックのページが1枚増える（検査 = stackcheck — pstatのstack_hw）。
// TCBの取り分は4096 − この値（毎回触るTC_SAVEより前の46ワードと、浅い深度の退避の列が同じページに残る大きさ）
const TCB_TOP_ROOM = 3072
// 機械スタックの大きさ: 1 MiB（NORESERVE — 実メモリは触ったページだけ）。子のregionの深度の上限（1023）まで再帰しても溢れない大きさ —
// 102（depth_limit）の境目を P3a（親の 8 MB スタックの上で走った）と同じに保つ（64 KiB では深度 1000 程度の再帰で先にスタックが尽きる）
const TASK_STACK = 1048576
// SIGSEGVのインターフェース（ガードページに触れた = スタックの溢れ）: 代替スタック64 KiB・@rt.sig = [stack_t 3ワード, sigaction 4ワード]
const SIG_ALT = 65536
const SIG_WORDS = 8
// rt.panic_mem の種類の続き（スタックの溢れ — 死因の印字は StackExceeded{}）
const PM_STACK = 4

// task の器の宣言（std/task を使うプログラムだけ — installRt から。本体は program の最後に buildTaskRt）
func needTaskRt(st mut St) {
    lsNeed(mut st, NEED_TASK, 0)
    st.taskG = addWorkerGlobal(mut st, int(strLit(mut st, "rt.task")), TK_WORDS)
    st.mainTcb = addGlobalInit(mut st, int(strLit(mut st, "rt.main_task")), TC_END + (if st.rtMut == 4 { 1 } else { 0 }), -1)
    st.rtTaskNew = addFunc(mut st, int(strLit(mut st, "rt.task_new")), desugar.ListRef(list2(mut st, TyI64, TyI64)), TyPtr)
    st.rtTaskGo = addFunc(mut st, int(strLit(mut st, "rt.task_go")), desugar.ListRef(list2(mut st, TyPtr, TyPtr)), -1)
    st.rtTaskStart = addFunc(mut st, int(strLit(mut st, "rt.task_start")), desugar.ListRef(list1(mut st, TyPtr)), -1)
    st.rtTaskSwitch = addFunc(mut st, int(strLit(mut st, "rt.task_switch")), desugar.ListRef(list2(mut st, TyPtr, TyPtr)), -1)
    st.sigG = addGlobalInit(mut st, int(strLit(mut st, "rt.sig")), SIG_WORDS, -1)
    st.slotsG = addWorkerGlobal(mut st, int(strLit(mut st, "rt.slots")), SLOT_SMH + DP_MASK + 1)
    st.slotFreeG = addWorkerGlobal(mut st, int(strLit(mut st, "rt.slot_free")), 3 + SLOT_FREE_CAP)
    st.rtSlotNew = addFunc(mut st, int(strLit(mut st, "rt.slot_new")), desugar.ListRef(list1(mut st, TyI64)), -1)
    st.rtTaskWait = addFunc(mut st, int(strLit(mut st, "rt.task_wait")), desugar.ListRef(list0(mut st)), -1)
    st.rtTaskPop = addFunc(mut st, int(strLit(mut st, "rt.task_pop")), desugar.ListRef(list0(mut st)), TyPtr)
    st.rtRdySpill = addFunc(mut st, int(strLit(mut st, "rt.ready_spill")), desugar.ListRef(list0(mut st)), -1)
    st.rtRdyUnspill = addFunc(mut st, int(strLit(mut st, "rt.ready_unspill")), desugar.ListRef(list0(mut st)), TyI64)
    st.rtSchedPick = addFunc(mut st, int(strLit(mut st, "rt.sched_pick")), desugar.ListRef(list1(mut st, TyI64)), TyI64)
    st.schedG = addWorkerGlobal(mut st, int(strLit(mut st, "rt.sched")), 5 + SCHED_CAP)
    st.rtDeadlock = addFunc(mut st, int(strLit(mut st, "rt.deadlock")), desugar.ListRef(list0(mut st)), -1)
    st.rtSegv = addFunc(mut st, int(strLit(mut st, "rt.segv")), desugar.ListRef(list0(mut st)), -1)
    st.rtSlotGive = addFunc(mut st, int(strLit(mut st, "rt.slot_give")), desugar.ListRef(list2(mut st, TyI64, TyI64)), -1)
    st.rtSlotTrim = addFunc(mut st, int(strLit(mut st, "rt.slot_trim")), desugar.ListRef(list0(mut st)), -1)
    st.rtUnmap = addFunc(mut st, int(strLit(mut st, "rt.unmap")), desugar.ListRef(list2(mut st, TyI64, TyI64)), -1)
    st.rtKidKeep = addFunc(mut st, int(strLit(mut st, "rt.kid_keep")), desugar.ListRef(list1(mut st, TyI64)), TyPtr)
    st.rtSlotTake = addFunc(mut st, int(strLit(mut st, "rt.slot_take")), desugar.ListRef(list0(mut st)), TyI64)
    st.rtChanFree = addFunc(mut st, int(strLit(mut st, "rt.chan_free")), desugar.ListRef(list2(mut st, TyPtr, TyI64)), -1)
    st.cutGenG = addGlobalInit(mut st, int(strLit(mut st, "rt.cutgen")), 1, -1)
    st.rtCutWalk = addFunc(mut st, int(strLit(mut st, "rt.cut_walk")), desugar.ListRef(list1(mut st, TyPtr)), TyI64)
    st.rtCutEnd = addFunc(mut st, int(strLit(mut st, "rt.cut_end")), desugar.ListRef(list2(mut st, TyPtr, TyI64)), TyI64)
    st.rtCancel = addFunc(mut st, int(strLit(mut st, "rt.cancel_check")), desugar.ListRef(list0(mut st)), -1)
    st.rtTaskRerun = addFunc(mut st, int(strLit(mut st, "rt.task_rerun")), desugar.ListRef(list1(mut st, TyPtr)), -1)
    needMnRt(mut st)
    needOutRt(mut st)
    needPstatRt(mut st)
    needAdmitRt(mut st)
    // ワーカーの記録（段階6 P4-3 — 表の番地の列。ワード数はprogramの最後に表の数で決める — buildWorkerInit）
    st.workerG = addGlobalInit(mut st, int(strLit(mut st, "rt.worker")), 0, -1)
    st.rtWorkerInit = addFunc(mut st, int(strLit(mut st, "rt.worker_init")), desugar.ListRef(list0(mut st)), -1)
}

// 子の入口の出口でtaskのチェーンに残ったfdを閉じる（死・切られた子はdeferが走らない — rt.soberのneedOpen。sysOpenを使うプログラムだけ）
func fdDrainCall(st mut St) {
    leaseDrainCall(mut st)
    chDrainCall(mut st)
    if st.rtFdDrain != -1 {
        call(mut st, st.rtFdDrain, list3(mut st, 0, iconst(mut st, 0), iconst(mut st, 1)))
    }
}

// rt.worker_init(): ワーカー 0（main のスレッド）の記録 = 各表の大域の番地の列を組み、arch_prctl(ARCH_SET_FS) で %fs の基底に置く
// （入口の最初 — 以降の fsaddr の表 k は fs:[8k]。program の最後に組む: 表は lower の途中でも足される〔needStat 等〕）。P4-4 のワーカーは自分の表を
// 確保して同じ形の記録を作る
func buildWorkerInit(st mut St) {
    desugar.HeapSet(mut st.d, st.workerG + G_WORDS, if st.nwslot > 0 { st.nwslot } else { 1 })
    begin(mut st, st.rtWorkerInit)
    w := globaladdrRaw(mut st, st.workerG)
    mut g := st.ghead
    while g >= 0 {
        k := desugar.HeapGet(mut st.d, g + G_WSLOT)
        if k >= 0 {
            store(mut st, w, k, ptoi(mut st, globaladdrRaw(mut st, g)))
        }
        g = desugar.HeapGet(mut st.d, g + G_NEXT)
    }
    // arch_prctl(ARCH_SET_FS = 0x1002, 記録)
    syscall(mut st, list3(mut st, iconst(mut st, 158), iconst(mut st, 4098), ptoi(mut st, w)))
    ret(mut st, -1)
    buildMnStart(mut st)
}

// 入口で今の task を main の記録にする（buildEntry から）
func taskInitMain(st mut St, sp int) {
    // スロットの大きさ: main = 起動のW_SLOT_SIZE・子の既定 = min(SOBER_TASK_REGION_MB〔既定256〕, main)（ワーカーの起動のチャンクを作るmnInitより先に — metaのコピーに乗る）
    meta := globaladdr(mut st, st.meta)
    ms := load(mut st, meta, W_SLOT_SIZE)
    store(mut st, globaladdr(mut st, st.mainTcb), TC_SLOTSZ, ms)
    tmb := envMb(mut st, sp, "SOBER_TASK_REGION_MB=", DEFAULT_TASK_SLOT_MB, false)
    store(mut st, meta, W_SLOT_DEF, imin(mut st, bin(mut st, BShl, tmb, iconst(mut st, 20)), ms))
    if dlFn(st.rtD3) != 0 {
        vdsoInit(mut st, sp)
    }
    store(mut st, globaladdr(mut st, st.taskG), TK_CUR, ptoi(mut st, globaladdr(mut st, st.mainTcb)))
    store(mut st, globaladdr(mut st, st.mainTcb), TC_STARTED, iconst(mut st, 1))
    schedInit(mut st, sp)
    mnInit(mut st, sp)
    outInitMain(mut st)
    // main の深度 0 のスロット = アリーナの先頭・own = 0（深く入るたびに rt.slot_new がアリーナの d 番目を表に置く）
    store(mut st, globaladdr(mut st, st.slotsG), 0, load(mut st, globaladdr(mut st, st.meta), W_SLOTS))
    // SIGSEGV を代替スタックの rt.segv で受ける（task のガードページ = スタックの溢れ → 罠へ巻き戻る StackExceeded の死）。
    // sigaltstack(&stack_t, NULL)・rt_sigaction(SIGSEGV, &act, NULL, 8)。flags = SA_SIGINFO | SA_ONSTACK | SA_NODEFER（巻き戻りでハンドラから抜けても次の SIGSEGV を受ける）| SA_RESTORER
    sg := globaladdr(mut st, st.sigG)
    alt := sysMmap(mut st, iconst(mut st, SIG_ALT))
    store(mut st, sg, 0, alt)
    store(mut st, sg, 1, iconst(mut st, 0))
    store(mut st, sg, 2, iconst(mut st, SIG_ALT))
    syscall(mut st, list3(mut st, iconst(mut st, 131), ptoi(mut st, sg), iconst(mut st, 0)))
    h := funcaddr(mut st, st.rtSegv)
    store(mut st, sg, 3, h)
    store(mut st, sg, 4, iconst(mut st, 1275068420))
    store(mut st, sg, 5, h)
    store(mut st, sg, 6, iconst(mut st, 0))
    syscall(mut st, list5(mut st, iconst(mut st, 13), iconst(mut st, 11), ptoi(mut st, gepWord(mut st, sg, iconst(mut st, 3))), iconst(mut st, 0), iconst(mut st, 8)))
}

// rt.segv(): 罠が張られていれば死因（102・種類 PM_STACK）を書いて巻き戻る（task のスタックの溢れ）。張られていなければ
// `panic: StackExceeded{}` を印字してexit 102（mainのスタックの外のSIGSEGV — std/taskを使うプログラムだけがこのインターフェースを持つ）
func buildSegv(st mut St) {
    begin(mut st, st.rtSegv)
    trapDie(mut st, PANIC_MEM, iconst(mut st, PM_STACK))
    meta := globaladdr(mut st, st.meta)
    toStderr(mut st, meta)
    printLit(mut st, "panic: StackExceeded{}\n")
    call(mut st, st.rtFlush, list0(mut st))
    if st.covG != -1 {
        coverDump(mut st)
    }
    exit(mut st, PANIC_MEM)
}

func buildTaskRt(st mut St) {
    buildDeadlineRt(mut st)
    buildTaskNew(mut st)
    buildTaskGo(mut st)
    buildTaskSwitch(mut st)
    if st.rtShLand != -1 && st.areaOn {
        buildShallowLand(mut st)
    }
    buildTaskStart(mut st)
    buildSegv(mut st)
    buildSlotNew(mut st)
    buildSlotGive(mut st)
    buildSlotTrim(mut st)
    buildKidKeep(mut st)
    if st.rtFrameNew != -1 {
        buildFrameNew(mut st)
    }
    begin(mut st, st.rtUnmap)
    syscall(mut st, list3(mut st, iconst(mut st, 11), 0, 1))
    ret(mut st, -1)
    buildSlotTake(mut st)
    buildChanFree(mut st)
    buildMnRt(mut st)
    buildTaskWait(mut st)
    buildCancelRt(mut st)
    buildDeadlock(mut st)
    buildSchedPick(mut st)
    buildTaskPop(mut st)
    buildReadySpill(mut st)
    buildOutRt(mut st)
    buildPstatRt(mut st)
    buildAdmitRt(mut st)
}

// 走れるスタックの環の容量（開発用 --rt-mutant=28 / 29は8 — 溢れのパスを毎回通す検査のbuild・29は溢れの順も崩す）
func rqCap(st mut St) int {
    return if st.rtMut == 28 || st.rtMut == 29 { 8 } else { RQ_CAP }
}

// 環の添字 i の枠の番地
func rqSlot(st mut St, tk int, i int) int {
    return gepWord(mut st, tk, bin(mut st, BAdd, bin(mut st, BShl, bin(mut st, BAnd, i, iconst(mut st, rqCap(mut st) - 1)), iconst(mut st, 1)), iconst(mut st, TK_RQ)))
}

// task tp の期限（TSC）= 積んだ時刻 + D（D = TC_MAXW の ns〔0 = 既定〕を TSC の数へ: × MN_TSCQ ÷ 65536 — 校正の前は TSCQ_DEF = 4 GHz と仮定）
func readyDl(st mut St, tp int, wake int) int {
    mw := load(mut st, tp, TC_MAXW)
    dns := bin(mut st, BAdd, mw, bin(mut st, BMul, cmp(mut st, CEq, mw, iconst(mut st, 0)), iconst(mut st, MN_WAIT_DEF)))
    tq := load(mut st, globaladdr(mut st, st.mnG), MN_TSCQ)
    qe := bin(mut st, BAdd, tq, bin(mut st, BMul, cmp(mut st, CEq, tq, iconst(mut st, 0)), iconst(mut st, TSCQ_DEF)))
    return bin(mut st, BAdd, wake, bin(mut st, BSar, bin(mut st, BMul, dns, qe), iconst(mut st, 16)))
}

// task t（番地のint）を走れるスタックの頭へ。TC_WAKE = 今（ワーカーのWK_NOW — mn_nextが周ごとに1回読むTSC — touch.tsの齢と溢れの列の期限が読む）・枠にも同じ時刻
func readyPush(st mut St, tk int, t int) {
    tp := itop(mut st, t)
    now := load(mut st, globaladdr(mut st, st.wkG), WK_NOW)
    store(mut st, tp, TC_WAKE, now)
    store(mut st, tk, TK_READY, bin(mut st, BAdd, load(mut st, tk, TK_READY), iconst(mut st, 1)))
    h := load(mut st, tk, TK_RQH)
    bF := newBlock(mut st)
    bJ := newBlock(mut st)
    condbr(mut st, cmp(mut st, CGe, bin(mut st, BSub, h, load(mut st, tk, TK_RQT)), iconst(mut st, rqCap(mut st))), bF, -1, bJ, -1)
    setCur(mut st, bF)
    call(mut st, st.rtRdySpill, list0(mut st))
    br(mut st, bJ, -1)
    setCur(mut st, bJ)
    sl := rqSlot(mut st, tk, h)
    store(mut st, sl, 0, t)
    store(mut st, sl, 1, now)
    store(mut st, tk, TK_RQH, bin(mut st, BAdd, h, iconst(mut st, 1)))
}

// 環の底の1本を溢れの列の最新へ移す（環が満杯の押し込み — 低速パス）。ミュータント29（開発用 --rt-mutant — 検査の自己検査）は最古の側へ繋ぐ
// （溢れの列の古い順が崩れる — 底の取り出しが新しい task を先に取り、期限の拾いと LIFO の意味が壊れる）
func readySpill(st mut St, tk int) {
    tl := load(mut st, tk, TK_RQT)
    q := load(mut st, rqSlot(mut st, tk, tl), 0)
    store(mut st, tk, TK_RQT, bin(mut st, BAdd, tl, iconst(mut st, 1)))
    qp := itop(mut st, q)
    zero := iconst(mut st, 0)
    bE := newBlock(mut st)
    bL := newBlock(mut st)
    bJ := newBlock(mut st)
    if st.rtMut == 29 {
        o := load(mut st, tk, TK_SPO)
        store(mut st, qp, TC_PREV, zero)
        store(mut st, qp, TC_NEXT, o)
        condbr(mut st, cmp(mut st, CEq, o, zero), bE, -1, bL, -1)
        setCur(mut st, bE)
        store(mut st, tk, TK_SPN, q)
        br(mut st, bJ, -1)
        setCur(mut st, bL)
        store(mut st, itop(mut st, o), TC_PREV, q)
        br(mut st, bJ, -1)
        setCur(mut st, bJ)
        store(mut st, tk, TK_SPO, q)
        return
    }
    n := load(mut st, tk, TK_SPN)
    store(mut st, qp, TC_NEXT, zero)
    store(mut st, qp, TC_PREV, n)
    condbr(mut st, cmp(mut st, CEq, n, zero), bE, -1, bL, -1)
    setCur(mut st, bE)
    store(mut st, tk, TK_SPO, q)
    br(mut st, bJ, -1)
    setCur(mut st, bL)
    store(mut st, itop(mut st, n), TC_NEXT, q)
    br(mut st, bJ, -1)
    setCur(mut st, bJ)
    store(mut st, tk, TK_SPN, q)
}

// 頭の1本を外して返す（番地のint — 呼び手はTK_READY ≠ 0を確認してから）。環が空なら溢れの列の最新
func readyPopHead(st mut St, tk int) int {
    store(mut st, tk, TK_READY, bin(mut st, BSub, load(mut st, tk, TK_READY), iconst(mut st, 1)))
    h := load(mut st, tk, TK_RQH)
    bR := newBlock(mut st)
    bS := newBlock(mut st)
    bJ := newBlock(mut st)
    v := param(mut st, bJ, TyI64)
    condbr(mut st, cmp(mut st, CNe, h, load(mut st, tk, TK_RQT)), bR, -1, bS, -1)
    setCur(mut st, bR)
    h1 := bin(mut st, BSub, h, iconst(mut st, 1))
    store(mut st, tk, TK_RQH, h1)
    br(mut st, bJ, list1(mut st, load(mut st, rqSlot(mut st, tk, h1), 0)))
    setCur(mut st, bS)
    br(mut st, bJ, list1(mut st, call(mut st, st.rtRdyUnspill, list0(mut st))))
    setCur(mut st, bJ)
    return v
}

// 溢れの低速パスのrtの本体（押し込みのインターフェース・頭の取り出しのインターフェースごとに展開しない — 自己buildのELFの上限値）:
// rt.ready_spill() = 環の底の 1 本を溢れの列の最新へ・rt.ready_unspill() = 溢れの列の最新を外して返す（環が空のときの頭の取り出し）
func buildReadySpill(st mut St) {
    begin(mut st, st.rtRdySpill)
    readySpill(mut st, globaladdr(mut st, st.taskG))
    ret(mut st, -1)
    begin(mut st, st.rtRdyUnspill)
    tk := globaladdr(mut st, st.taskG)
    p := load(mut st, tk, TK_SPN)
    np := load(mut st, itop(mut st, p), TC_PREV)
    store(mut st, tk, TK_SPN, np)
    spillFix(mut st, tk, np, TK_SPO, TC_NEXT)
    ret(mut st, p)
}

// 底の1本を外して返す（呼び手はTK_READY ≠ 0を確認してから）。溢れの列が空でなければその最古
func readyPopTail(st mut St, tk int) int {
    store(mut st, tk, TK_READY, bin(mut st, BSub, load(mut st, tk, TK_READY), iconst(mut st, 1)))
    o := load(mut st, tk, TK_SPO)
    bR := newBlock(mut st)
    bS := newBlock(mut st)
    bJ := newBlock(mut st)
    v := param(mut st, bJ, TyI64)
    condbr(mut st, cmp(mut st, CNe, o, iconst(mut st, 0)), bS, -1, bR, -1)
    setCur(mut st, bS)
    nn := load(mut st, itop(mut st, o), TC_NEXT)
    store(mut st, tk, TK_SPO, nn)
    spillFix(mut st, tk, nn, TK_SPN, TC_PREV)
    br(mut st, bJ, list1(mut st, o))
    setCur(mut st, bR)
    tl := load(mut st, tk, TK_RQT)
    store(mut st, tk, TK_RQT, bin(mut st, BAdd, tl, iconst(mut st, 1)))
    br(mut st, bJ, list1(mut st, load(mut st, rqSlot(mut st, tk, tl), 0)))
    setCur(mut st, bJ)
    return v
}

// 溢れの列の端を外した後の始末: 新しい端xが0なら反対の端のワードotherも0に・でなければxの外した側のチェーン（ワードw）を0に
func spillFix(st mut St, tk int, x int, other int, w int) {
    bZ := newBlock(mut st)
    bN := newBlock(mut st)
    bJ := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, x, iconst(mut st, 0)), bZ, -1, bN, -1)
    setCur(mut st, bZ)
    store(mut st, tk, other, iconst(mut st, 0))
    br(mut st, bJ, -1)
    setCur(mut st, bN)
    store(mut st, itop(mut st, x), w, iconst(mut st, 0))
    br(mut st, bJ, -1)
    setCur(mut st, bJ)
}

// 底の期限（溢れの列が空でなければその最古・でなければ環の底の枠の時刻 + D〔底の TC_MAXW〕）
func readyTailDl(st mut St, tk int) int {
    o := load(mut st, tk, TK_SPO)
    bR := newBlock(mut st)
    bS := newBlock(mut st)
    bJ := newBlock(mut st)
    v := param(mut st, bJ, TyI64)
    condbr(mut st, cmp(mut st, CNe, o, iconst(mut st, 0)), bS, -1, bR, -1)
    setCur(mut st, bS)
    op := itop(mut st, o)
    br(mut st, bJ, list1(mut st, readyDl(mut st, op, load(mut st, op, TC_WAKE))))
    setCur(mut st, bR)
    sl := rqSlot(mut st, tk, load(mut st, tk, TK_RQT))
    br(mut st, bJ, list1(mut st, readyDl(mut st, itop(mut st, load(mut st, sl, 0)), load(mut st, sl, 1))))
    setCur(mut st, bJ)
    return v
}

// task t を走れるスタックに載せる（切り替えない — 今のtaskが待つか終わったときに走る）
func taskWake(st mut St, t int) {
    tk := globaladdr(mut st, st.taskG)
    readyPush(mut st, tk, ptoi(mut st, t))
}

// task t を走れるようにする（M:Nなら持ち主のワーカーへ — rt.mn_wake。協調形はtaskWake）。待ちのウェイクアップする側（チャネル・Close）から
func taskWakeAny(st mut St, t int) {
    bMn := newBlock(mut st)
    bCo := newBlock(mut st)
    bE := newBlock(mut st)
    condbr(mut st, mnOn(mut st), bMn, -1, bCo, -1)
    setCur(mut st, bMn)
    call(mut st, st.rtMnWake, list1(mut st, t))
    br(mut st, bE, -1)
    setCur(mut st, bCo)
    taskWake(mut st, t)
    br(mut st, bE, -1)
    setCur(mut st, bE)
}

// 走れるスタックから次のtaskを取る（無ければrt.deadlock — 全taskが待っている = デッドロック。Kahnにより有無はスケジュールに依らない）
func taskNext(st mut St) int {
    // 高速パス（段階6 P4-6）: 選択の器を使わず走れるスタックが空でなければ、一番上をその場で外す（rt.task_popを呼ばない — 全レジスタの退避を踏まない）
    tk := globaladdr(mut st, st.taskG)
    // netの待ち手がいればスリープしてから取り直す（netpoll.sober — 協調形の眠りの席）
    retry := if netOn(mut st) { newBlock(mut st) } else { BlkRef(-1) }
    if netOn(mut st) {
        br(mut st, retry, -1)
        setCur(mut st, retry)
    }
    head := load(mut st, tk, TK_READY)
    bFast := newBlock(mut st)
    bSlow := newBlock(mut st)
    bGot := newBlock(mut st)
    got := param(mut st, bGot, TyPtr)
    fast := bin(mut st, BAnd, cmp(mut st, CEq, load(mut st, globaladdr(mut st, st.schedG), SCHED_ACT), iconst(mut st, 0)), cmp(mut st, CNe, head, iconst(mut st, 0)))
    condbr(mut st, fast, bFast, -1, bSlow, -1)
    setCur(mut st, bFast)
    br(mut st, bGot, list1(mut st, itop(mut st, readyPopHead(mut st, tk))))
    setCur(mut st, bSlow)
    br(mut st, bGot, list1(mut st, call(mut st, st.rtTaskPop, list0(mut st))))
    setCur(mut st, bGot)
    rp := got
    none := newBlock(mut st)
    ok := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, ptoi(mut st, rp), iconst(mut st, 0)), none, -1, ok, -1)
    setCur(mut st, none)
    if netOn(mut st) {
        bDl := branchIf(mut st, cmp(mut st, CNe, load(mut st, globaladdr(mut st, st.wkG), WK_NETW), iconst(mut st, 0)))
        call(mut st, st.rtUpoll, list1(mut st, iconst(mut st, 1)))
        br(mut st, retry, -1)
        setCur(mut st, bDl)
    }
    call(mut st, st.rtDeadlock, list0(mut st))
    exit(mut st, PANIC)
    setCur(mut st, ok)
    frRec(mut st, FK_RUN, ptoi(mut st, rp), iconst(mut st, 0))
    return rp
}

// rt.task_wait(): 今のtaskを待たせて次の走れるtaskへ切り替える（ウェイクアップされて順番が来たら返る — 呼び手は条件を見直す）
// 切り替える前に今のtaskの死んだ深度を予備へ返す（parkRelease）。rt.task_wait_k（rt.netwaitの待ち）はエリアの予約ページを組むプログラムでだけtrimする
// （空の受けの深度を手放し、ウェイクアップした点でエリアの予約ページから取り直す — 予約ページが無ければ取り直しは予備・小さいスロットへ散る）
func buildTaskWait(st mut St) {
    taskWaitFn(mut st, st.rtTaskWait, true, false)
    if st.rtTaskWaitK != -1 {
        taskWaitFn(mut st, st.rtTaskWaitK, st.areaOn && winArm(mut st), true)
    }
}

func taskWaitFn(st mut St, fnr FnRef, trim bool, kw bool) {
    begin(mut st, fnr)
    me := itop(mut st, load(mut st, globaladdr(mut st, st.taskG), TK_CUR))
    // M:N: 次のtask（自分がウェイクアップされて積まれていれば自分 — 切り替えずに返る）
    bMn := newBlock(mut st)
    bCo := newBlock(mut st)
    condbr(mut st, mnOn(mut st), bMn, -1, bCo, -1)
    setCur(mut st, bMn)
    mx := call(mut st, st.rtMnNext, list0(mut st))
    bSw := newBlock(mut st)
    bRet := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, ptoi(mut st, mx), ptoi(mut st, me)), bRet, -1, bSw, -1)
    setCur(mut st, bSw)
    parkReleaseW(mut st, me, trim, kw)
    call(mut st, st.rtTaskSwitch, list2(mut st, me, mx))
    parkReacquire(mut st)
    br(mut st, bRet, -1)
    setCur(mut st, bRet)
    ret(mut st, -1)
    setCur(mut st, bCo)
    nx := taskNext(mut st)
    parkReleaseW(mut st, me, trim, kw)
    call(mut st, st.rtTaskSwitch, list2(mut st, me, nx))
    parkReacquire(mut st)
    ret(mut st, -1)
}

// parkの手放し。シャロースリープ（rt.task_wait_k）でエリアの予約ページを組むなら: チャンクの予約ページ（WSP_FLAGだけのフィールド — チャンクごとに最初のtaskだけ）があればtrimして
// 返し（以後その深度はエリアの予約ページ）、無ければ死んだ深度だけ（エリアの予約ページの深度は空のまま持ってスリープする）。そのうえでエリアの予約ページの深度に中身があるかを
// TC_ONW の AREA_FULL に置く（rt.task_switch の areaPark が見る）
func parkReleaseW(st mut St, me int, trim bool, kw bool) {
    if !(kw && trim) {
        parkRelease(mut st, me, trim, kw)
        return
    }
    wsp := load(mut st, me, TC_WSP)
    cw := chunkWins(mut st, wsp)
    bT := newBlock(mut st)
    bN := newBlock(mut st)
    bJ := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, cw, iconst(mut st, 0)), bT, -1, bN, -1)
    setCur(mut st, bT)
    parkRelease(mut st, me, true, kw)
    br(mut st, bJ, -1)
    setCur(mut st, bN)
    parkRelease(mut st, me, false, kw)
    br(mut st, bJ, -1)
    setCur(mut st, bJ)
    // エリアの予約ページの深度k = BASE + 1 + r（フィールドにWSP_AREA）の中身: bump ≠ regionの先頭（予約ページなら表の基底 + 大きさ − W・予約ページから移したスロットなら
    // 基底 — 移した後の深度が空なら予約ページのページに残る中身は死んでいる）。ミュータント79 = フィールドr = 0を見ない
    meta := globaladdr(mut st, st.meta)
    sg := globaladdr(mut st, st.slotsG)
    w2 := load(mut st, me, TC_WSP)
    base := load(mut st, me, TC_BASE)
    mut full := iconst(mut st, 0)
    for r <- iter.Range(0, WIN_N) {
        if !(st.rtMut == 79 && r == 0) {
            k := bin(mut st, BAdd, base, iconst(mut st, 1 + r))
            isA := cmp(mut st, CNe, bin(mut st, BAnd, w2, iconst(mut st, WSP_AREA << (16 * (WIN_N - 1 - r)))), iconst(mut st, 0))
            sb := load(mut st, gepWord(mut st, sg, k), 0)
            // ミュータント81 = 予約ページから移した深度も予約ページの始まりで比べる（移した後の空の深度を中身ありと解釈し、毎回深くスリープする）
            st0 := if st.rtMut == 81 { bin(mut st, BAdd, sb, bin(mut st, BSub, load(mut st, meta, W_SLOT_SIZE), iconst(mut st, WIN_SZ))) } else { winAdjT(mut st, meta, sb, ptoi(mut st, me)) }
            ne := cmp(mut st, CNe, load(mut st, gepWord(mut st, meta, k), W_BUMP), st0)
            full = bin(mut st, BOr, full, bin(mut st, BAnd, isA, ne))
        }
    }
    ow := load(mut st, me, TC_ONW)
    store(mut st, me, TC_ONW, bin(mut st, BOr, bin(mut st, BAnd, ow, iconst(mut st, -1 - AREA_FULL)), bin(mut st, BMul, full, iconst(mut st, AREA_FULL))))
}

// 起きた task の手放した空の深度 (own, 今の深度] のスロットを取り直す（parkRelease の trim）。task_switch から
// 戻った直後（自分の文脈・まだ確保していない点）で、d = own + 1 から順に rt.slot_new（予備を採るかプールから）→ bump = 基底（空の region）
// ミュータント20（taskの基底より深いregionを全部手放す — nextgenの自己検査）では取り直さない: 取り直しは手放したスロットを予備から採り直して
// ミューテーションの穴を覆う（L1-Rの穴の形 = 手放した後にウェイクアップしたtaskが他のtaskのスロットを読む — を保つ）
func parkReacquire(st mut St) {
    if st.rtMut == 20 {
        return
    }
    meta := globaladdr(mut st, st.meta)
    sg := globaladdr(mut st, st.slotsG)
    loop := newBlock(mut st)
    d := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, load(mut st, sg, SLOT_OWN), iconst(mut st, 1))))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLe, d, load(mut st, meta, W_DEPTH)), body, -1, done, -1)
    setCur(mut st, body)
    b := slotEnter(mut st, meta, d)
    store(mut st, gepWord(mut st, meta, d), W_BUMP, b)
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, d, iconst(mut st, 1))))
    setCur(mut st, done)
}

// rt.deadlock(): `panic: Deadlock{}` を印字して exit 101（全 task が待っている — 定義された死）
func buildDeadlock(st mut St) {
    begin(mut st, st.rtDeadlock)
    toStderr(mut st, globaladdr(mut st, st.meta))
    printLit(mut st, "panic: Deadlock{}\n")
    call(mut st, st.rtFlush, list0(mut st))
    if st.covG != -1 {
        coverDump(mut st)
    }
    exit(mut st, PANIC)
}

// 今の task の深度 d の region のスロットの基底（std/task を使わないプログラムは今までどおり アリーナ + d × サイズ — IR は不変）
func slotBase(st mut St, meta int, d int) int {
    if st.taskUse {
        return load(mut st, gepWord(mut st, globaladdr(mut st, st.slotsG), d), 0)
    }
    return bin(mut st, BAdd, load(mut st, meta, W_SLOTS), bin(mut st, BMul, d, load(mut st, meta, W_SLOT_SIZE)))
}

// 浅いregionの予約ページ（language.md 11 節「接続のtaskの小さいスロット」）: 小さいスロットのtaskの深度BASE + 1〜BASE + WIN_Nのregionは、
// チャンクの末尾のページ（深度ごとに1ページ — TCB + WIN_OFFから）で始まる。触ったページがチャンクと同じPTEのページに乗る（エリアごとに先頭のページを触ると、
// エリア1本ごとにPTEのページが1枚要る）。表の基底は「予約ページの終わり − 大きさ」（偽の基底）なので、確保のパスの上限の検査（基底 + 大きさ）は
// 無変更で予約ページの終わりを指す。基底をregionの先頭として読むインターフェース（深度の入りのbump・madvise・使用量・返し）はwinAdjで直す。
// 予約ページの溢れはrt.win_spillが本物の小さいスロットへ移す（予約ページの中身は動かさない — 番地は安定）。移した先は普通のスロット（表の基底 = 本物）で、
// bumpを本物 + 予約ページの使った分から始める — region 1つの上限は大きさちょうどのまま。以後その深度は普通のスロットとして入り直し・返し・leaseを通る。
// TC_WSPは深度ごとのフラグ（予約ページを張った・このtaskでは予約ページにしない）だけを持つ。
// 予約ページは予備にならない（parkは予約ページの深度を自前に残す — 予備は同じワーカーの他のtaskが表のフィールドのまま採る）。開発のオプションSOBER_TASK_WIN=0は予約ページを張らない
const WIN_N = 4
const WIN_SZ = 4096
const WIN_OFF = 4096 + TASK_HEAD - AWIN_N * WIN_SZ - TCB_TOP_ROOM - WIN_N * WIN_SZ

// エリアの予約ページ（language.md 11 節「接続のtaskのスタック」）: チャンクの頭の最後のAWIN_Nページは、そのチャンクのスタックの領域がエリアとして持つ予約ページ（エリアの頂上から
// AWIN_OFF — ワーカーのエリアの写像も同じ並び）。フラグつきのtaskが空で手放した予約ページの深度（WSP_NOWIN）は、取り直しで「いま走っているエリア」
// （TC_ONWのbit 1 ? ワーカーのエリア : 所有エリア）の予約ページの空きから取る。中身はエリアと一緒に動く: 深くスリープするtaskはエリアごと持ってスリープし、浅く
// スリープするのはエリアの予約ページの深度が全部空のときだけ（area.sober areaPark）。エリアの予約ページrはチャンクの予約ページrと同じ深度（BASE + 1 + r）・フィールドにWSP_AREA。
// シャロースリープでは予約ページの深度を手放さない（空のまま持ってスリープする）: ウェイクアップした点（rt.shallow_land）でワーカーのエリアがスリープしたときと違えば、予約ページの深度の
// 表の基底とbumpを差分だけ付け替える（空なのでコピーするものは無い）。不変条件 = エリアの予約ページに中身（bump > 始まり・予約ページから移したスロット）を
// 持てるのは、そのエリアの上で走っているtaskか、そのエリアを持って深くスリープしているtaskだけ（浅くスリープしているtaskの予約ページの深度は全部空 — スリープしている間
// 本人以外はそのregionへ書かない）。エリアの予約ページをやめた深度（WSP_NOAREA — ディープスリープでエリアの予約ページに中身を持ち越したとき、空だった深度）は
// 予備・小さいスロットに住み、浅くスリープするときの空の判定の対象から外れる: そのスロットはtaskの自前の深度で、予約ページの深度は予備に乗らないので
// スリープしている間に他のtaskが採らない（中身があってよい — チャンクの予約ページの前の形と同じ）
const AWIN_N = WIN_N
const AWIN_OFF = 4096 + TASK_HEAD - AWIN_N * WIN_SZ

// 基底baseが task tcb の予約ページ（移す前）か: base + 大きさ − (最初の予約ページの終わり) が0, W, 2W, 3Wのどれか（他の写像のスロットは予約ページのページに来ない）。
// エリアの予約ページを組むプログラムは最初の予約ページの終わりを予約ページの錨（TC_WANCH — チャンクの予約ページかエリアの予約ページ）から読む
func isWinT(st mut St, meta int, base int, tcb int) int {
    e := bin(mut st, BAdd, base, load(mut st, meta, W_SLOT_SIZE))
    return cmp(mut st, CUlt, bin(mut st, BSub, e, winAnchor(mut st, tcb)), iconst(mut st, (WIN_N - 1) * WIN_SZ + 1))
}

// task tcb の最初の予約ページの終わり
func winAnchor(st mut St, tcb int) int {
    if st.areaOn {
        return load(mut st, itop(mut st, tcb), TC_WANCH)
    }
    return bin(mut st, BAdd, tcb, iconst(mut st, WIN_OFF + WIN_SZ))
}

// 予約ページのrtを組んだか（予約ページを組むプログラム〔st.winOn〕で名前つきプールを使う — rtの本体を組む時点では両方が確定している）
func winArm(st mut St) bool {
    return st.winOn && st.poolOn
}

func curTcb(st mut St) int {
    return load(mut st, globaladdr(mut st, st.taskG), TK_CUR)
}

// 基底base（今のtaskの予約ページなら偽の基底）からregionの先頭へ: 予約ページなら + (大きさ − W)
func winAdj(st mut St, meta int, base int) int {
    if !winArm(mut st) {
        return base
    }
    return winAdjT(mut st, meta, base, curTcb(mut st))
}

// winAdjのtask（TCBの番地tcb）を渡す形。真偽の0 / 1を全ビットのフラグ（0 − b）にしてANDで選ぶ（乗算をホットパスに置かない）
func winAdjT(st mut St, meta int, base int, tcb int) int {
    on := bin(mut st, BSub, iconst(mut st, 0), isWinT(mut st, meta, base, tcb))
    return bin(mut st, BAdd, base, bin(mut st, BAnd, on, bin(mut st, BSub, load(mut st, meta, W_SLOT_SIZE), iconst(mut st, WIN_SZ))))
}

// TC_WSPのフィールド: 予約ページr（0始まり）は16 × (WIN_N − 1 − r) ビット目から（浅い予約ページほど上 — 最も深いフラグの予約ページがctzで取れる）。
// フィールド = WSP_FLAG（予約ページを張った — 移した後も立てたまま。移したかは表の基底が予約ページでないことで分かる）。WSP_NOWIN = このtaskでは予約ページにしない
// （parkで死んだ深度の予約ページ — リクエストごとのregion。次からはワーカーの予備か小さいスロットで、接続ごとにページを持たない）
const WSP_FLAG = 32768
const WSP_NOWIN = 16384
const WSP_AREA = 8192
const WSP_NOAREA = 4096
// 4フィールドのWSP_AREA / WSP_FLAGの全部
const WSP_AREAS = 2305878194122661888
const WSP_FLAGS = 0 - 9223231297218904064

// チャンクの予約ページを持つフィールド（WSP_FLAGでWSP_AREAでない）のビット — 0ならチャンクの予約ページなし
func chunkWins(st mut St, wsp int) int {
    return bin(mut st, BAnd, bin(mut st, BAnd, wsp, iconst(mut st, WSP_FLAGS)), bin(mut st, BXor, bin(mut st, BShl, bin(mut st, BAnd, wsp, iconst(mut st, WSP_AREAS)), iconst(mut st, 2)), iconst(mut st, -1)))
}

func winSh(st mut St, r int) int {
    return bin(mut st, BMul, bin(mut st, BSub, iconst(mut st, WIN_N - 1), r), iconst(mut st, 16))
}

// 深度kの使用量used（bump − フィールドs）を予約ページの分だけ直す: 移す前の予約ページなら − (大きさ − W)（移した後は本物の基底から — bumpが予約ページの使った分だけ先にあるので予約ページ + スロットの和）
func winUsed(st mut St, meta int, s int, used int, tcb int) int {
    if !winArm(mut st) {
        return used
    }
    return bin(mut st, BSub, used, bin(mut st, BMul, isWinT(mut st, meta, s, tcb), bin(mut st, BSub, load(mut st, meta, W_SLOT_SIZE), iconst(mut st, WIN_SZ))))
}

// 予約ページの有効のフラグ（初回にSOBER_TASK_WINを読む — 何度読んでも同じ値なので競合は無害）
func winOn(st mut St) int {
    g := globaladdr(mut st, st.winG)
    v := load(mut st, g, 0)
    bRd := newBlock(mut st)
    bGo := newBlock(mut st)
    r := param(mut st, bGo, TyI64)
    condbr(mut st, cmp(mut st, CEq, v, iconst(mut st, 0)), bRd, -1, bGo, list1(mut st, v))
    setCur(mut st, bRd)
    e := bin(mut st, BAdd, envMb(mut st, itop(mut st, load(mut st, globaladdr(mut st, st.meta), W_ARGV)), "SOBER_TASK_WIN=", 1, true), iconst(mut st, 1))
    store(mut st, g, 0, e)
    br(mut st, bGo, list1(mut st, e))
    setCur(mut st, bGo)
    return cmp(mut st, CEq, r, iconst(mut st, 2))
}

// rt.slot_newの頭（名前つきプールを使うプログラム）: 小さいスロットのtaskが深度BASE + 1〜BASE + WIN_Nへ入るなら予約ページを張って返る。
// area = エリアの予約ページだけ（空で手放した予約ページの深度〔NOWIN〕を、フラグつきのtaskならいま走っているエリアの予約ページから — 深くスリープするtaskが予備・小さい
// スロットを持ってスリープすると、スロットごとにページ表のページが要る。予備を採った後のパス: 予約ページの深度は予備に乗らない〔parkRelease〕ので先に採られない）。
// areaでなければチャンクの予約ページだけ
func winTry(st mut St, meta int, sg int, d int, area bool) {
    tcb := curTcb(mut st)
    r := bin(mut st, BSub, bin(mut st, BSub, d, load(mut st, itop(mut st, tcb), TC_BASE)), iconst(mut st, 1))
    bQ := newBlock(mut st)
    bW := newBlock(mut st)
    bNo := newBlock(mut st)
    if area {
        // 速い外れ（rt.slot_newの頭 — 毎回通る）: 予約ページの深度で、フィールドがNOWINだけ（NOAREAなし）のときだけ先へ
        bF := newBlock(mut st)
        fv := bin(mut st, BAnd, bin(mut st, BSar, load(mut st, itop(mut st, tcb), TC_WSP), winSh(mut st, r)), iconst(mut st, WSP_NOWIN + WSP_NOAREA + WSP_FLAG))
        condbr(mut st, bin(mut st, BAnd, cmp(mut st, CUlt, r, iconst(mut st, WIN_N)), cmp(mut st, CEq, fv, iconst(mut st, WSP_NOWIN))), bF, -1, bNo, -1)
        setCur(mut st, bF)
    }
    small := cmp(mut st, CLt, load(mut st, meta, W_SLOT_SIZE), load(mut st, meta, W_SLOT_DEF))
    condbr(mut st, bin(mut st, BAnd, small, cmp(mut st, CUlt, r, iconst(mut st, WIN_N))), bQ, -1, bNo, -1)
    setCur(mut st, bQ)
    // このtaskで予約ページを使って死なせた深度（WSP_NOWIN — リクエストごとのregion）はチャンクの予約ページにしない
    nowin := bin(mut st, BAnd, bin(mut st, BSar, load(mut st, itop(mut st, tcb), TC_WSP), winSh(mut st, r)), iconst(mut st, WSP_NOWIN))
    on := winOn(mut st)
    // 格納場所の予約ページの終わりとフィールドの値（チャンクの予約ページ = WSP_FLAG・エリアの予約ページ = WSP_FLAG | WSP_NOWIN | WSP_AREA）
    wend := param(mut st, bW, TyI64)
    wfl := param(mut st, bW, TyI64)
    bC := newBlock(mut st)
    wsp := load(mut st, itop(mut st, tcb), TC_WSP)
    if !area {
        // エリアの予約ページを持つtaskはチャンクの予約ページを張らない（taskの予約ページは一方の種類だけ — 錨は1つ）
        mut ok := bin(mut st, BAnd, on, cmp(mut st, CEq, nowin, iconst(mut st, 0)))
        if st.areaOn {
            ok = bin(mut st, BAnd, ok, cmp(mut st, CEq, bin(mut st, BAnd, wsp, iconst(mut st, WSP_AREAS)), iconst(mut st, 0)))
        }
        condbr(mut st, ok, bC, -1, bNo, -1)
    } else {
        // フラグつきで、空で手放した予約ページの深度（NOWIN・ディープスリープで空になったフラグNOAREAなし）で、チャンクの予約ページを持っていなければ（taskの予約ページは一方の種類だけ）
        tp := itop(mut st, tcb)
        ow := load(mut st, tp, TC_ONW)
        bA2 := newBlock(mut st)
        noa := bin(mut st, BAnd, bin(mut st, BSar, wsp, winSh(mut st, r)), iconst(mut st, WSP_NOAREA))
        ok := bin(mut st, BAnd, bin(mut st, BAnd, on, cmp(mut st, CNe, nowin, iconst(mut st, 0))), bin(mut st, BAnd, cmp(mut st, CEq, noa, iconst(mut st, 0)), cmp(mut st, CEq, chunkWins(mut st, wsp), iconst(mut st, 0))))
        no := bin(mut st, BOr, cmp(mut st, CEq, ok, iconst(mut st, 0)), cmp(mut st, CEq, bin(mut st, BAnd, ow, iconst(mut st, 1)), iconst(mut st, 0)))
        condbr(mut st, no, bNo, -1, bA2, -1)
        setCur(mut st, bA2)
        held := load(mut st, tp, TC_AREA)
        onw := bin(mut st, BAnd, bin(mut st, BSar, ow, iconst(mut st, 1)), iconst(mut st, 1))
        atop := bin(mut st, BAdd, held, bin(mut st, BMul, onw, bin(mut st, BSub, load(mut st, globaladdr(mut st, st.wkG), WK_AREA), held)))
        anc := bin(mut st, BAdd, atop, iconst(mut st, AWIN_OFF + WIN_SZ))
        store(mut st, tp, TC_WANCH, anc)
        br(mut st, bW, list2(mut st, bin(mut st, BAdd, anc, bin(mut st, BMul, r, iconst(mut st, WIN_SZ))), iconst(mut st, WSP_FLAG + WSP_NOWIN + WSP_AREA)))
    }
    setCur(mut st, bC)
    if area {
        br(mut st, bNo, -1)
    } else {
        if st.areaOn {
            store(mut st, itop(mut st, tcb), TC_WANCH, bin(mut st, BAdd, tcb, iconst(mut st, WIN_OFF + WIN_SZ)))
        }
        br(mut st, bW, list2(mut st, winEndOf(mut st, tcb, r), iconst(mut st, WSP_FLAG)))
    }
    setCur(mut st, bW)
    // フィールドdが予備ならプールへ出してから上書きする（bEndと同じ — 予備は他のtaskのスロット）
    bSp := newBlock(mut st)
    bSp2 := newBlock(mut st)
    lo := load(mut st, sg, SLOT_SPLO)
    condbr(mut st, cmp(mut st, CNe, bin(mut st, BAnd, cmp(mut st, CGt, d, lo), cmp(mut st, CLe, d, load(mut st, sg, SLOT_SPHI))), iconst(mut st, 0)), bSp, -1, bSp2, -1)
    setCur(mut st, bSp)
    spareOut(mut st, d, spareSz(mut st, sg, meta))
    br(mut st, bSp2, -1)
    setCur(mut st, bSp2)
    store(mut st, gepWord(mut st, sg, d), 0, bin(mut st, BSub, wend, load(mut st, meta, W_SLOT_SIZE)))
    winSet(mut st, tcb, r, wfl)
    store(mut st, sg, SLOT_OWN, d)
    bLo := newBlock(mut st)
    bLo2 := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, lo, d), bLo, -1, bLo2, -1)
    setCur(mut st, bLo)
    store(mut st, sg, SLOT_SPLO, d)
    br(mut st, bLo2, -1)
    setCur(mut st, bLo2)
    ret(mut st, -1)
    setCur(mut st, bNo)
}

// 予約ページr（0始まり）の終わりの番地
func winEndOf(st mut St, tcb int, r int) int {
    return bin(mut st, BAdd, tcb, bin(mut st, BAdd, iconst(mut st, WIN_OFF + WIN_SZ), bin(mut st, BMul, r, iconst(mut st, WIN_SZ))))
}

// TC_WSPの予約ページrのフィールドをvに
func winSet(st mut St, tcb int, r int, v int) {
    sh := winSh(mut st, r)
    w := load(mut st, itop(mut st, tcb), TC_WSP)
    cl := bin(mut st, BAnd, w, bin(mut st, BXor, bin(mut st, BShl, iconst(mut st, 65535), sh), iconst(mut st, -1)))
    store(mut st, itop(mut st, tcb), TC_WSP, bin(mut st, BOr, cl, bin(mut st, BShl, v, sh)))
}

// parkの予約ページの守り: (dep, own] に予約ページ（フラグつき）があるか — 予約ページrはBASE + 1 + r > dep ⟺ r ≥ m（m = dep − BASE）。
// フィールドの並び（浅い予約ページほど上）からr ≥ mのフィールドは下位16 × (WIN_N − m) ビット
func winDead(st mut St, me int, dep int) int {
    m := imax(mut st, bin(mut st, BSub, dep, load(mut st, me, TC_BASE)), iconst(mut st, 0))
    mc := imin(mut st, m, iconst(mut st, WIN_N - 1))
    s1 := bin(mut st, BSub, bin(mut st, BMul, bin(mut st, BSub, iconst(mut st, WIN_N), mc), iconst(mut st, 16)), iconst(mut st, 1))
    mask := bin(mut st, BXor, bin(mut st, BShl, bin(mut st, BShl, iconst(mut st, -1), s1), iconst(mut st, 1)), iconst(mut st, -1))
    fl := bin(mut st, BAnd, load(mut st, me, TC_WSP), iconst(mut st, 0 - 9223231297218904064))
    return bin(mut st, BMul, bin(mut st, BAnd, fl, mask), cmp(mut st, CLt, m, iconst(mut st, WIN_N)))
}

// rt.win_park(dep): parkで死ぬ（か空で手放す）深度 (dep, own] の予約ページを外す — ページを返してWSP_NOWIN（このtaskでは以後予約ページにしない — リクエストごとのregion）・
// 予約ページから移したスロット（表の基底が予約ページでない）はワーカーの列へ返す。外したフィールドは予約ページの偽の基底に戻す（isWinTが真 — 予備の出しが飛ばす）
func buildWinPark(st mut St) {
    begin(mut st, st.rtWinPark)
    dep := 0
    deep0 := 1
    meta := globaladdr(mut st, st.meta)
    sg := globaladdr(mut st, st.slotsG)
    tcb := curTcb(mut st)
    tp := itop(mut st, tcb)
    base := load(mut st, tp, TC_BASE)
    // ディープスリープで空の予約ページの深度を以後エリアの予約ページにしない（WSP_NOAREA）のは、手放さずに持ち越すエリアの予約ページの深度（中身のあるリクエストのregion — dep以下）が
    // あるときだけ: エリアを持って深くスリープするtaskのリクエストの中の一時の深度。持ち越す中身が無いディープスリープ（送りの待ち等）ではフラグを付けない
    // （付けると、スリープしている接続が予約ページの深度ごとに予備のスロットを持つ）
    m0 := imax(mut st, bin(mut st, BSub, dep, base), iconst(mut st, 0))
    // フィールドr < m（深度 ≤ dep — 浅い予約ページほど上位）の全ビット = 上位16mビット（m = 0なら0）
    mc := imin(mut st, m0, iconst(mut st, WIN_N))
    hi := bin(mut st, BAnd, bin(mut st, BSar, iconst(mut st, 0 - 9223372036854775807 - 1), bin(mut st, BSub, bin(mut st, BMul, mc, iconst(mut st, 16)), iconst(mut st, 1))), bin(mut st, BSub, iconst(mut st, 0), cmp(mut st, CGt, mc, iconst(mut st, 0))))
    kept := cmp(mut st, CNe, bin(mut st, BAnd, load(mut st, tp, TC_WSP), bin(mut st, BAnd, iconst(mut st, WSP_AREAS), hi)), iconst(mut st, 0))
    deep := bin(mut st, BAnd, deep0, kept)
    own := load(mut st, sg, SLOT_OWN)
    sz := load(mut st, meta, W_SLOT_SIZE)
    loop := newBlock(mut st)
    r := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    act := newBlock(mut st)
    nxt := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLt, r, iconst(mut st, WIN_N)), body, -1, done, -1)
    setCur(mut st, body)
    k := bin(mut st, BAdd, bin(mut st, BAdd, base, iconst(mut st, 1)), r)
    f := bin(mut st, BAnd, bin(mut st, BSar, load(mut st, tp, TC_WSP), winSh(mut st, r)), iconst(mut st, 65535))
    live := bin(mut st, BAnd, bin(mut st, BAnd, cmp(mut st, CGt, k, dep), cmp(mut st, CLe, k, own)), cmp(mut st, CNe, bin(mut st, BAnd, f, iconst(mut st, WSP_FLAG)), iconst(mut st, 0)))
    condbr(mut st, live, act, -1, nxt, -1)
    setCur(mut st, act)
    s := load(mut st, gepWord(mut st, sg, k), 0)
    // 予約ページから移したスロット: 返す
    bRet := newBlock(mut st)
    bW := newBlock(mut st)
    condbr(mut st, isWinT(mut st, meta, s, tcb), bW, -1, bRet, -1)
    setCur(mut st, bRet)
    smallPush(mut st, sg, k, s, sz)
    br(mut st, bW, -1)
    setCur(mut st, bW)
    wend := winEndOf(mut st, tcb, r)
    if st.areaOn {
        // エリアの予約ページ: ページはエリアに残す（エリアの持ち主がそのまま使う — 温かい）
        bAw := newBlock(mut st)
        bCw := newBlock(mut st)
        condbr(mut st, cmp(mut st, CNe, bin(mut st, BAnd, f, iconst(mut st, WSP_AREA)), iconst(mut st, 0)), bAw, -1, bCw, -1)
        setCur(mut st, bAw)
        store(mut st, gepWord(mut st, sg, k), 0, bin(mut st, BSub, bin(mut st, BAdd, winAnchor(mut st, tcb), bin(mut st, BMul, r, iconst(mut st, WIN_SZ))), sz))
        // ディープスリープで空になる深度（待ちをまたいで中身を持たない — リクエストの中の一時）は以後エリアの予約ページにしない（予備へ — ワーカーで温かい）。
        // エリアの予約ページに置くと、エリアが巡るたびにどのエリアにもそのページが常駐して残る
        winSet(mut st, tcb, r, bin(mut st, BOr, iconst(mut st, WSP_NOWIN), bin(mut st, BMul, deep, iconst(mut st, WSP_NOAREA))))
        br(mut st, nxt, -1)
        setCur(mut st, bCw)
    }
    // 予約ページのページは前の実体が触ったまま残る（parkの時点で空でも）— 返して、このtaskでは以後予約ページにしない
    syscall(mut st, list4(mut st, iconst(mut st, 28), bin(mut st, BSub, wend, iconst(mut st, WIN_SZ)), iconst(mut st, WIN_SZ), iconst(mut st, 4)))
    atomicXadd(mut st, globaladdr(mut st, st.pstatG), PS_WINREL, iconst(mut st, 1))
    store(mut st, gepWord(mut st, sg, k), 0, bin(mut st, BSub, wend, sz))
    winSet(mut st, tcb, r, if st.areaOn { bin(mut st, BOr, iconst(mut st, WSP_NOWIN), bin(mut st, BMul, deep, iconst(mut st, WSP_NOAREA))) } else { iconst(mut st, WSP_NOWIN) })
    br(mut st, nxt, -1)
    setCur(mut st, nxt)
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, r, iconst(mut st, 1))))
    setCur(mut st, done)
    ret(mut st, -1)
}

// rt.win_spill(d) i64: 今のtaskの深度dが予約ページ（移す前）なら、本物の小さいスロットへ移して1（予約ページの中身は動かさない — 以後の確保はスロットから。
// bump = 本物 + 予約ページの使った分で上限の和は大きさちょうど）。予約ページでなければ0（呼び手は死102かコピーのパスへ）
func buildWinSpill(st mut St) {
    begin(mut st, st.rtWinSpill)
    d := 0
    meta := globaladdr(mut st, st.meta)
    sg := globaladdr(mut st, st.slotsG)
    tcb := curTcb(mut st)
    s := load(mut st, gepWord(mut st, sg, d), 0)
    bY := newBlock(mut st)
    bN := newBlock(mut st)
    condbr(mut st, isWinT(mut st, meta, s, tcb), bY, -1, bN, -1)
    setCur(mut st, bN)
    ret(mut st, iconst(mut st, 0))
    setCur(mut st, bY)
    sz := load(mut st, meta, W_SLOT_SIZE)
    bp := gepWord(mut st, meta, d)
    wu := bin(mut st, BSub, load(mut st, bp, W_BUMP), bin(mut st, BSub, bin(mut st, BAdd, s, sz), iconst(mut st, WIN_SZ)))
    bGot := newBlock(mut st)
    base := param(mut st, bGot, TyI64)
    smallTake(mut st, meta, sg, globaladdr(mut st, st.slotFreeG), d, sz, load(mut st, meta, W_SLOT_DEF), bGot)
    setCur(mut st, bGot)
    store(mut st, gepWord(mut st, sg, d), 0, base)
    store(mut st, bp, W_BUMP, bin(mut st, BAdd, base, wu))
    ret(mut st, iconst(mut st, 1))
}

// rt.win_ralloc(d, n, mode) ptr: 確保の溢れ（rt.region_alloc / region_alloc8の低速パス）— 深度dが予約ページならrt.win_spillで移して確保し直す
// （mode 0 = nワード・1 = nバイトのbyteの列〔bumpは8の粒 — btipは呼び手が置く〕）。予約ページでないか、移した先でも溢れれば死102
func buildWinRalloc(st mut St) {
    begin(mut st, st.rtWinRalloc)
    d := 0
    n := 1
    mode := 2
    meta := globaladdr(mut st, st.meta)
    bp := gepWord(mut st, meta, d)
    bMv := newBlock(mut st)
    bDie := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, call(mut st, st.rtWinSpill, list1(mut st, d)), iconst(mut st, 0)), bMv, -1, bDie, -1)
    setCur(mut st, bDie)
    memPanic(mut st, PM_SLOT)
    setCur(mut st, bMv)
    old := load(mut st, bp, W_BUMP)
    b8 := cmp(mut st, CNe, mode, iconst(mut st, 0))
    adv := bin(mut st, BAdd, bin(mut st, BMul, b8, bin(mut st, BAnd, bin(mut st, BAdd, n, iconst(mut st, 7)), iconst(mut st, -8))), bin(mut st, BMul, bin(mut st, BXor, b8, iconst(mut st, 1)), bin(mut st, BMul, n, iconst(mut st, 8))))
    nw := bin(mut st, BAdd, old, adv)
    bOk := newBlock(mut st)
    bOv := newBlock(mut st)
    condbr(mut st, cmp(mut st, CGt, nw, slotLimit(mut st, meta, d)), bOv, -1, bOk, -1)
    setCur(mut st, bOv)
    memPanic(mut st, PM_SLOT)
    setCur(mut st, bOk)
    store(mut st, bp, W_BUMP, nw)
    ret(mut st, itop(mut st, old))
}

func buildWinRt(st mut St) {
    buildWinSpill(mut st)
    buildWinRalloc(mut st)
    buildWinPark(mut st)
    buildWinCol(mut st)
    buildWinStart(mut st)
    buildWinIs(mut st)
}

// 深度の入り（rt.region_enter）の予約ページの判定は葉の極小関数に出す: region_enterの本体の大きさが予約ページの有無で変わらず（IRインライナーの全展開の
// 上限IL_MAXINSの内側）、展開の予算を使わない組3（葉のコピー）が最後に呼び出しの点へコピーする。本体は分岐で返す形（2ブロック — 1ブロックの
// 関数はoptのP0' がregion_enterを組んだ直後にコピーしてしまう）

// rt.win_start(s) i64: 表の基底sのregionの先頭（今のtaskの予約ページなら予約ページの始まり = s + 大きさ − W・それ以外はs）
func buildWinStart(st mut St) {
    begin(mut st, st.rtWinStart)
    s := 0
    sz := load(mut st, globaladdr(mut st, st.meta), W_SLOT_SIZE)
    tcb := curTcb(mut st)
    x := bin(mut st, BSub, bin(mut st, BAdd, s, sz), winAnchor(mut st, tcb))
    bW := newBlock(mut st)
    bN := newBlock(mut st)
    condbr(mut st, cmp(mut st, CUlt, x, iconst(mut st, (WIN_N - 1) * WIN_SZ + 1)), bW, -1, bN, -1)
    setCur(mut st, bW)
    ret(mut st, bin(mut st, BAdd, s, bin(mut st, BSub, sz, iconst(mut st, WIN_SZ))))
    setCur(mut st, bN)
    ret(mut st, s)
}

// rt.win_is(s) i64: 表の基底sが今のtaskの予約ページか（isWinT — 1 / 0）
func buildWinIs(st mut St) {
    begin(mut st, st.rtWinIs)
    bW := newBlock(mut st)
    bN := newBlock(mut st)
    condbr(mut st, isWinT(mut st, globaladdr(mut st, st.meta), 0, curTcb(mut st)), bW, -1, bN, -1)
    setCur(mut st, bW)
    ret(mut st, iconst(mut st, 1))
    setCur(mut st, bN)
    ret(mut st, iconst(mut st, 0))
}

// rt.win_col(d, out, n): 先端で作る列out（深度d — 今のtaskの予約ページ）をnバイト伸ばすと予約ページを越えるなら、本物の小さいスロットへ移して
// 列 [out[0], 終わり) をコピーし、out[0] を付け替える（列の前の予約ページの中身は動かさない — 予約ページの使った分 = 列の始まり − 予約ページの始まり）
func buildWinCol(st mut St) {
    begin(mut st, st.rtWinCol)
    d := 0
    op := itop(mut st, 1)
    n := 2
    meta := globaladdr(mut st, st.meta)
    sg := globaladdr(mut st, st.slotsG)
    tcb := curTcb(mut st)
    s := load(mut st, gepWord(mut st, sg, d), 0)
    sz := load(mut st, meta, W_SLOT_SIZE)
    o0 := load(mut st, op, 0)
    ln := load(mut st, op, 1)
    nw := bin(mut st, BAnd, bin(mut st, BAdd, bin(mut st, BAdd, bin(mut st, BAdd, o0, ln), n), iconst(mut st, 7)), iconst(mut st, -8))
    bMv := newBlock(mut st)
    bNo := newBlock(mut st)
    condbr(mut st, bin(mut st, BAnd, isWinT(mut st, meta, s, tcb), cmp(mut st, CGt, nw, bin(mut st, BAdd, s, sz))), bMv, -1, bNo, -1)
    setCur(mut st, bNo)
    ret(mut st, -1)
    setCur(mut st, bMv)
    wu := bin(mut st, BSub, o0, bin(mut st, BSub, bin(mut st, BAdd, s, sz), iconst(mut st, WIN_SZ)))
    bGot := newBlock(mut st)
    base := param(mut st, bGot, TyI64)
    smallTake(mut st, meta, sg, globaladdr(mut st, st.slotFreeG), d, sz, load(mut st, meta, W_SLOT_DEF), bGot)
    setCur(mut st, bGot)
    nb := bin(mut st, BAdd, base, wu)
    store(mut st, gepWord(mut st, sg, d), 0, base)
    store(mut st, gepWord(mut st, meta, d), W_BUMP, nb)
    call(mut st, st.rtCopy8, list3(mut st, itop(mut st, nb), itop(mut st, o0), ln))
    store(mut st, op, 0, nb)
    ret(mut st, -1)
}

// 深度 d へ入るときのスロットの基底（d が自前の範囲の外なら rt.slot_new が取って表に置く）
func slotEnter(st mut St, meta int, d int) int {
    if !st.taskUse {
        return slotBase(mut st, meta, d)
    }
    sg := globaladdr(mut st, st.slotsG)
    bNew := newBlock(mut st)
    bOk := newBlock(mut st)
    condbr(mut st, cmp(mut st, CGt, d, load(mut st, sg, SLOT_OWN)), bNew, -1, bOk, -1)
    setCur(mut st, bNew)
    call(mut st, st.rtSlotNew, list1(mut st, d))
    br(mut st, bOk, -1)
    setCur(mut st, bOk)
    s := load(mut st, gepWord(mut st, sg, d), 0)
    return if winArm(mut st) { call(mut st, st.rtWinStart, list1(mut st, s)) } else { s }
}

// rt.slot_new(d): 今の task の深度 d のスロットを取って表に置き、own = d（main はアリーナの d 番目・子はプール）
func buildSlotNew(st mut St) {
    begin(mut st, st.rtSlotNew)
    d := 0
    meta := globaladdr(mut st, st.meta)
    sg := globaladdr(mut st, st.slotsG)
    // 不変条件の検査（常設）: main以外のtaskが入る深度はown + 1のはず。飛ばすと間のフィールド（他のtaskが残した
    // スロット）が自前の範囲に入り、退避・終わりの返しで 2 つの task が同じスロットを持つ — 黙った誤りにせず panic の一行を標準エラーへ出して exit 81（深度の読み違いの定義された死）
    bOk := newBlock(mut st)
    bBad := newBlock(mut st)
    notMain := cmp(mut st, CNe, load(mut st, globaladdr(mut st, st.taskG), TK_CUR), ptoi(mut st, globaladdr(mut st, st.mainTcb)))
    skip := cmp(mut st, CNe, d, bin(mut st, BAdd, load(mut st, sg, SLOT_OWN), iconst(mut st, 1)))
    condbr(mut st, bin(mut st, BAnd, skip, notMain), bBad, -1, bOk, -1)
    setCur(mut st, bBad)
    toStderr(mut st, meta)
    printLit(mut st, "panic: RegionDepthSkipped{} (runtime invariant broken in rt.slot_new — please report)\n")
    call(mut st, st.rtFlush, list0(mut st))
    syscall(mut st, list2(mut st, iconst(mut st, 231), iconst(mut st, 81)))
    br(mut st, bOk, -1)
    setCur(mut st, bOk)
    // 予備を採る（d = own + 1が予備SPLO < d ≤ SPHIで、今のtaskのスロットが既定の大きさ）: 表のフィールドをそのまま自前にする
    bAdopt := newBlock(mut st)
    bTake := newBlock(mut st)
    spare := bin(mut st, BAnd, cmp(mut st, CGt, d, load(mut st, sg, SLOT_SPLO)), cmp(mut st, CLe, d, load(mut st, sg, SLOT_SPHI)))
    // 名前つきプールを使うプログラムは予備の大きさのフラグと同じ大きさのtaskだけ（小さいスロットの予備を既定のtaskが採らない — 逆も）
    defsz := cmp(mut st, CEq, load(mut st, meta, W_SLOT_SIZE), if st.poolOn { load(mut st, sg, SLOT_SPSZ) } else { load(mut st, meta, W_SLOT_DEF) })
    condbr(mut st, cmp(mut st, CNe, bin(mut st, BAnd, spare, defsz), iconst(mut st, 0)), bAdopt, -1, bTake, -1)
    setCur(mut st, bAdopt)
    store(mut st, sg, SLOT_OWN, d)
    store(mut st, sg, SLOT_SPLO, d)
    ret(mut st, -1)
    setCur(mut st, bTake)
    // 予備が無ければ予約ページ（ワーカーの予備はリクエストごとのregionの格納場所 — 先に採る）
    if winArm(mut st) {
        if st.areaOn {
            winTry(mut st, meta, sg, d, true)
        }
        winTry(mut st, meta, sg, d, false)
    }
    fg := globaladdr(mut st, st.slotFreeG)
    curT := load(mut st, globaladdr(mut st, st.taskG), TK_CUR)
    bMain := newBlock(mut st)
    bPool := newBlock(mut st)
    bRefill := newBlock(mut st)
    bPop := newBlock(mut st)
    bEnd := newBlock(mut st)
    base := param(mut st, bEnd, TyI64)
    condbr(mut st, cmp(mut st, CEq, curT, ptoi(mut st, globaladdr(mut st, st.mainTcb))), bMain, -1, bPool, -1)
    setCur(mut st, bMain)
    br(mut st, bEnd, list1(mut st, bin(mut st, BAdd, load(mut st, meta, W_SLOTS), bin(mut st, BMul, d, load(mut st, meta, W_SLOT_SIZE)))))
    setCur(mut st, bPool)
    // 既定より大きい子（budget: の宣言から）は深度ごとに自前の mmap（プールは既定の大きさだけ — 終わりで munmap・slotRelease）
    bOwn := newBlock(mut st)
    bShared := newBlock(mut st)
    sz := load(mut st, meta, W_SLOT_SIZE)
    def := load(mut st, meta, W_SLOT_DEF)
    if st.poolOn {
        bNotDef := newBlock(mut st)
        condbr(mut st, cmp(mut st, CEq, sz, def), bShared, -1, bNotDef, -1)
        setCur(mut st, bNotDef)
        // 既定より小さい子（Serveの接続 — region:）: ワーカーの返された小さいスロットのチェーン → 切り出しの位置 → 既定のスロットの切り出し（SLOT_SMHの注記）
        bSmall := newBlock(mut st)
        condbr(mut st, cmp(mut st, CGt, sz, def), bOwn, -1, bSmall, -1)
        setCur(mut st, bSmall)
        smallTake(mut st, meta, sg, fg, d, sz, def, bEnd)
    } else {
        condbr(mut st, cmp(mut st, CNe, sz, def), bOwn, -1, bShared, -1)
    }
    setCur(mut st, bOwn)
    a := sysMmap(mut st, sz)
    slotVaAdd(mut st, sz)
    pstatVa(mut st, 1)
    mInc(mut st, 15)
    br(mut st, bEnd, list1(mut st, a))
    setCur(mut st, bShared)
    // M:N: 深度ごとのプール（列 d & DP_MASK — 役が揃う）: 手元の列 → 共有の予備の列（rt.dp_take）→ 単体。協調形は列に積まないので mnOn で飛ばす
    bDm := newBlock(mut st)
    bDr := newBlock(mut st)
    bDhit := newBlock(mut st)
    bSingle := newBlock(mut st)
    condbr(mut st, mnOn(mut st), bDm, -1, bSingle, -1)
    setCur(mut st, bDm)
    rr := bin(mut st, BAnd, d, iconst(mut st, DP_MASK))
    br(mut st, bDr, -1)
    setCur(mut st, bDr)
    wkd := globaladdr(mut st, st.wkG)
    cpd := gepWord(mut st, wkd, bin(mut st, BAdd, rr, iconst(mut st, WK_DPC)))
    cd := load(mut st, cpd, 0)
    bDsh := newBlock(mut st)
    bDgot := newBlock(mut st)
    gs := param(mut st, bDgot, TyI64)
    condbr(mut st, cmp(mut st, CNe, cd, iconst(mut st, 0)), bDhit, -1, bDsh, -1)
    setCur(mut st, bDhit)
    c1 := bin(mut st, BSub, cd, iconst(mut st, 1))
    store(mut st, cpd, 0, c1)
    br(mut st, bDgot, list1(mut st, load(mut st, gepWord(mut st, wkd, bin(mut st, BAdd, bin(mut st, BAdd, bin(mut st, BMul, rr, iconst(mut st, DP_CAP)), c1), iconst(mut st, WK_DPS))), 0)))
    // 手元が空: 共有の予備の深度ごとの列（数の和が 0 なら呼ばない）
    setCur(mut st, bDsh)
    bDcall := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, load(mut st, globaladdr(mut st, st.sdpG), 0), iconst(mut st, 0)), bDcall, -1, bSingle, -1)
    setCur(mut st, bDcall)
    ts := call(mut st, st.rtDpTake, list1(mut st, rr))
    condbr(mut st, cmp(mut st, CNe, ts, iconst(mut st, 0)), bDgot, list1(mut st, ts), bSingle, -1)
    setCur(mut st, bDgot)
    mInc(mut st, 2)
    mInc(mut st, 19)
    mPopRes(mut st, gs)
    br(mut st, bEnd, list1(mut st, gs))
    setCur(mut st, bSingle)
    condbr(mut st, cmp(mut st, CEq, load(mut st, fg, 0), iconst(mut st, 0)), bRefill, -1, bPop, -1)
    setCur(mut st, bRefill)
    slotRefill(mut st, meta, fg)
    br(mut st, bPop, -1)
    setCur(mut st, bPop)
    n := load(mut st, fg, 0)
    s := load(mut st, gepWord(mut st, fg, n), 0)
    store(mut st, fg, 0, bin(mut st, BSub, n, iconst(mut st, 1)))
    mInc(mut st, 2)
    mPopRes(mut st, s)
    br(mut st, bEnd, list1(mut st, s))
    setCur(mut st, bEnd)
    // フィールドdが予備（main・既定より大きいtaskは採らない）ならプールへ出してから上書きする。own = d・SPLO ≥ dに保つ
    bSp := newBlock(mut st)
    bSp2 := newBlock(mut st)
    lo := load(mut st, sg, SLOT_SPLO)
    condbr(mut st, cmp(mut st, CNe, bin(mut st, BAnd, cmp(mut st, CGt, d, lo), cmp(mut st, CLe, d, load(mut st, sg, SLOT_SPHI))), iconst(mut st, 0)), bSp, -1, bSp2, -1)
    setCur(mut st, bSp)
    spareOut(mut st, d, spareSz(mut st, sg, meta))
    br(mut st, bSp2, -1)
    setCur(mut st, bSp2)
    store(mut st, gepWord(mut st, sg, d), 0, base)
    store(mut st, sg, SLOT_OWN, d)
    bLo := newBlock(mut st)
    bLo2 := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, lo, d), bLo, -1, bLo2, -1)
    setCur(mut st, bLo)
    store(mut st, sg, SLOT_SPLO, d)
    br(mut st, bLo2, -1)
    setCur(mut st, bLo2)
    ret(mut st, -1)
}

// 小さいスロット（大きさsz）を1本取ってbEndへ（実引数 = 基底）: 手元の列 → 共有の列 → 切り出しの位置 → 既定のスロットの切り出し（SLOT_SMHの注記）
func smallTake(st mut St, meta int, sg int, fg int, d int, sz int, def int, bEnd BlkRef) {
    bScut := newBlock(mut st)
    // 手元の列r（数 = 表のSLOT_SMH + r・基底 = rt.smslotsのr × SM_CAP + i — フラグつき）の末尾が同じ大きさなら1本
    bSh := newBlock(mut st)
    bSpop := newBlock(mut st)
    bSsh := newBlock(mut st)
    rr0 := bin(mut st, BAnd, d, iconst(mut st, DP_MASK))
    hcol := gepWord(mut st, sg, rr0)
    hc := load(mut st, hcol, SLOT_SMH)
    tag := smTag(mut st, sz)
    condbr(mut st, cmp(mut st, CNe, hc, iconst(mut st, 0)), bSh, -1, bSsh, -1)
    setCur(mut st, bSh)
    hc1 := bin(mut st, BSub, hc, iconst(mut st, 1))
    he := load(mut st, gepWord(mut st, globaladdr(mut st, st.smG), bin(mut st, BAdd, bin(mut st, BMul, rr0, iconst(mut st, SM_CAP)), hc1)), 0)
    condbr(mut st, cmp(mut st, CEq, bin(mut st, BAnd, he, iconst(mut st, SM_TAGM)), tag), bSpop, -1, bSsh, -1)
    setCur(mut st, bSpop)
    store(mut st, hcol, SLOT_SMH, hc1)
    br(mut st, bEnd, list1(mut st, bin(mut st, BSub, he, tag)))
    // 手元に無い: 共有の列（rt.ssm — 数の和が 0 なら呼ばない）
    setCur(mut st, bSsh)
    bScall := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, load(mut st, globaladdr(mut st, st.ssmG), 0), iconst(mut st, 0)), bScall, -1, bScut, -1)
    setCur(mut st, bScall)
    sts := call(mut st, st.rtSmTake, list3(mut st, rr0, tag, hc))
    condbr(mut st, cmp(mut st, CNe, sts, iconst(mut st, 0)), bEnd, list1(mut st, sts), bScut, -1)
    // 切り出しの位置に同じ大きさの残りがあれば 1 本（触らない）
    setCur(mut st, bScut)
    bCur := newBlock(mut st)
    bNew := newBlock(mut st)
    smn := load(mut st, sg, SLOT_SMN)
    condbr(mut st, bin(mut st, BAnd, cmp(mut st, CGt, smn, iconst(mut st, 0)), cmp(mut st, CEq, load(mut st, sg, SLOT_SMZ), sz)), bCur, -1, bNew, -1)
    setCur(mut st, bCur)
    smc := load(mut st, sg, SLOT_SMC)
    store(mut st, sg, SLOT_SMC, bin(mut st, BAdd, smc, sz))
    store(mut st, sg, SLOT_SMN, bin(mut st, BSub, smn, iconst(mut st, 1)))
    br(mut st, bEnd, list1(mut st, smc))
    // 既定のスロットを 1 本取って切り出し直す（前の切り出しの残り〔大きさ違い〕は捨てる — 大きさの違う小さい task が混ざるときだけ）
    setCur(mut st, bNew)
    bCr := newBlock(mut st)
    bCp := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, load(mut st, fg, 0), iconst(mut st, 0)), bCr, -1, bCp, -1)
    setCur(mut st, bCr)
    slotRefill(mut st, meta, fg)
    br(mut st, bCp, -1)
    setCur(mut st, bCp)
    cn := load(mut st, fg, 0)
    s0 := load(mut st, gepWord(mut st, fg, cn), 0)
    store(mut st, fg, 0, bin(mut st, BSub, cn, iconst(mut st, 1)))
    mInc(mut st, 2)
    store(mut st, sg, SLOT_SMC, bin(mut st, BAdd, s0, sz))
    store(mut st, sg, SLOT_SMN, bin(mut st, BSub, bin(mut st, BDiv, def, sz), iconst(mut st, 1)))
    store(mut st, sg, SLOT_SMZ, sz)
    br(mut st, bEnd, list1(mut st, s0))
}

// 表のフィールドkのスロット（予備 — 大きさisz）をプールへ出す（小さいスロットはワーカーのチェーンへ）: M:Nは深度ごとの手元の列k & DP_MASK（満杯ならrt.dp_give）・協調形は単体のプール（満杯ならmunmap）。
// madvise はしない（used = 0 — 予備の bump は前の持ち主の値で、スロットの使用量として信用できない）
func spareOut(st mut St, k int, isz int) {
    meta := globaladdr(mut st, st.meta)
    s := load(mut st, gepWord(mut st, globaladdr(mut st, st.slotsG), k), 0)
    bMn := newBlock(mut st)
    bCo := newBlock(mut st)
    bEnd := newBlock(mut st)
    if st.poolOn {
        // 小さいスロット（大きさisz < 既定）はワーカーの小さいスロットのチェーンへ
        bSm := newBlock(mut st)
        bDf := newBlock(mut st)
        condbr(mut st, cmp(mut st, CLt, isz, load(mut st, meta, W_SLOT_DEF)), bSm, -1, bDf, -1)
        setCur(mut st, bSm)
        smallPush(mut st, globaladdr(mut st, st.slotsG), k, s, isz)
        br(mut st, bEnd, -1)
        setCur(mut st, bDf)
    }
    condbr(mut st, mnOn(mut st), bMn, -1, bCo, -1)
    setCur(mut st, bMn)
    wk := globaladdr(mut st, st.wkG)
    r := bin(mut st, BAnd, k, iconst(mut st, DP_MASK))
    cp := gepWord(mut st, wk, bin(mut st, BAdd, r, iconst(mut st, WK_DPC)))
    c := load(mut st, cp, 0)
    bPush := newBlock(mut st)
    bSg := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, c, iconst(mut st, DP_CAP)), bPush, -1, bSg, -1)
    setCur(mut st, bPush)
    store(mut st, gepWord(mut st, wk, bin(mut st, BAdd, bin(mut st, BAdd, bin(mut st, BMul, r, iconst(mut st, DP_CAP)), c), iconst(mut st, WK_DPS))), 0, s)
    store(mut st, cp, 0, bin(mut st, BAdd, c, iconst(mut st, 1)))
    br(mut st, bEnd, -1)
    setCur(mut st, bSg)
    call(mut st, st.rtDpGive, list3(mut st, s, iconst(mut st, 0), r))
    br(mut st, bEnd, -1)
    setCur(mut st, bCo)
    fg := globaladdr(mut st, st.slotFreeG)
    n := load(mut st, fg, 0)
    bKeep := newBlock(mut st)
    bDrop := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, n, iconst(mut st, SLOT_FREE_CAP)), bKeep, -1, bDrop, -1)
    setCur(mut st, bKeep)
    n1 := bin(mut st, BAdd, n, iconst(mut st, 1))
    store(mut st, gepWord(mut st, fg, n1), 0, s)
    store(mut st, fg, 0, n1)
    br(mut st, bEnd, -1)
    setCur(mut st, bDrop)
    syscall(mut st, list3(mut st, iconst(mut st, 11), s, load(mut st, meta, W_SLOT_DEF)))
    if st.poolOn {
        slotVaAdd(mut st, bin(mut st, BSub, iconst(mut st, 0), load(mut st, meta, W_SLOT_DEF)))
    }
    br(mut st, bEnd, -1)
    setCur(mut st, bEnd)
}

// park する task me の死んだ深度 (今の深度, own] を予備にして own を今の深度へ下げる（region の 21 節: 今の深度より深い region は
// 死んでいる — 中身をコピーしない・格納場所を手放すだけ）。予備が空か、今の予備の下端がownにちょうど続くなら範囲を広げるだけ（O(1)）。
// 続かない（間に他のtaskのフィールドがある）ときは返す範囲を1本ずつプールへ出す。main（アリーナ）と既定より大きいスロットのtaskは返さない
//
// trim（rt.task_wait の park）: 今の深度から浅い方へ、使用 0 バイト（bump = 基底）の自前の深度が続く限り下がった深度 j を
// 今の深度の代わりに使う。(j, 今の深度] は生きているが空のregion（21 節 — 中身が無いので格納場所を差し替えても観測できない）で、手放した後の
// task は own < 今の深度 のまま park し、起きた点で parkReacquire が取り直す。予備は own より深い連なりのまま（穴を作らない）
func parkRelease(st mut St, me int, trim bool, kw bool) {
    meta := globaladdr(mut st, st.meta)
    sg := globaladdr(mut st, st.slotsG)
    bSkip := newBlock(mut st)
    bChk := newBlock(mut st)
    bChk2 := newBlock(mut st)
    bGo := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, ptoi(mut st, me), ptoi(mut st, globaladdr(mut st, st.mainTcb))), bSkip, -1, bChk, -1)
    setCur(mut st, bChk)
    // 既定より大きいスロットのtaskは返さない（名前つきプールを使うプログラムは既定より小さいtaskも予備に乗る — 予備の大きさのフラグSLOT_SPSZ）
    if st.poolOn {
        condbr(mut st, cmp(mut st, CGt, load(mut st, meta, W_SLOT_SIZE), load(mut st, meta, W_SLOT_DEF)), bSkip, -1, bChk2, -1)
    } else {
        condbr(mut st, cmp(mut st, CNe, load(mut st, meta, W_SLOT_SIZE), load(mut st, meta, W_SLOT_DEF)), bSkip, -1, bChk2, -1)
    }
    setCur(mut st, bChk2)
    // ミュータント20（scripts/nextgen.shの自己検査）: taskの基底より深いregionを全部死んだと読み違えて手放し、手放すスロットの [基底, bump) を毒で塗る
    own := load(mut st, sg, SLOT_OWN)
    dep0 := if st.rtMut == 20 { load(mut st, me, TC_BASE) } else if trim { parkTrim(mut st, me, own) } else { load(mut st, meta, W_DEPTH) }
    // 予約ページの深度は予備にしない: 予約ページを張るtask（小さいスロット・予約ページが有効）はdepをmin(own, BASE + WIN_N) まで上げる（予約ページから移したスロットも同じく自前に残す）
    dep := dep0
    condbr(mut st, cmp(mut st, CGt, own, dep), bGo, -1, bSkip, -1)
    setCur(mut st, bGo)
    if st.rtMut == 20 {
        parkPoison(mut st, dep, own)
    }
    // 死ぬ深度に予約ページがあれば外してから（低速パス）、残りの本物のスロットを1本ずつ予備の外のプールへ（予約ページのフィールドが間に挟まり予備の連なりにならない）
    bSp := newBlock(mut st)
    bDone := newBlock(mut st)
    if winArm(mut st) {
        bWd := newBlock(mut st)
        condbr(mut st, cmp(mut st, CNe, winDead(mut st, me, dep), iconst(mut st, 0)), bWd, -1, bSp, -1)
        setCur(mut st, bWd)
        call(mut st, st.rtWinPark, list2(mut st, dep, iconst(mut st, if kw { 0 } else { 1 })))
        wl := newBlock(mut st)
        wk := param(mut st, wl, TyI64)
        wb := newBlock(mut st)
        wo := newBlock(mut st)
        wn := newBlock(mut st)
        br(mut st, wl, list1(mut st, bin(mut st, BAdd, dep, iconst(mut st, 1))))
        setCur(mut st, wl)
        condbr(mut st, cmp(mut st, CLe, wk, own), wb, -1, bDone, -1)
        setCur(mut st, wb)
        condbr(mut st, isWinT(mut st, meta, load(mut st, gepWord(mut st, sg, wk), 0), ptoi(mut st, me)), wn, -1, wo, -1)
        setCur(mut st, wo)
        spareOut(mut st, wk, load(mut st, meta, W_SLOT_SIZE))
        br(mut st, wn, -1)
        setCur(mut st, wn)
        br(mut st, wl, list1(mut st, bin(mut st, BAdd, wk, iconst(mut st, 1))))
    } else {
        br(mut st, bSp, -1)
    }
    setCur(mut st, bSp)
    lo := load(mut st, sg, SLOT_SPLO)
    hi := load(mut st, sg, SLOT_SPHI)
    bEmpty := newBlock(mut st)
    bNe := newBlock(mut st)
    bJoin := newBlock(mut st)
    bGap := newBlock(mut st)
    condbr(mut st, cmp(mut st, CGe, lo, hi), bEmpty, -1, bNe, -1)
    setCur(mut st, bEmpty)
    store(mut st, sg, SLOT_SPHI, own)
    if st.poolOn {
        store(mut st, sg, SLOT_SPSZ, load(mut st, meta, W_SLOT_SIZE))
    }
    br(mut st, bJoin, -1)
    setCur(mut st, bNe)
    // 続く（予備の下端 = own）うえに予備の大きさが同じなら伸ばすだけ
    joinable := if st.poolOn { bin(mut st, BAnd, cmp(mut st, CEq, lo, own), cmp(mut st, CEq, load(mut st, sg, SLOT_SPSZ), load(mut st, meta, W_SLOT_SIZE))) } else { cmp(mut st, CEq, lo, own) }
    condbr(mut st, joinable, bJoin, -1, bGap, -1)
    setCur(mut st, bJoin)
    store(mut st, sg, SLOT_SPLO, dep)
    br(mut st, bDone, -1)
    setCur(mut st, bGap)
    loop := newBlock(mut st)
    k := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, dep, iconst(mut st, 1))))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLe, k, own), body, -1, bDone, -1)
    setCur(mut st, body)
    spareOut(mut st, k, load(mut st, meta, W_SLOT_SIZE))
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, k, iconst(mut st, 1))))
    setCur(mut st, bDone)
    store(mut st, sg, SLOT_OWN, dep)
    br(mut st, bSkip, -1)
    setCur(mut st, bSkip)
}

// 今の深度から浅い方へ、自前（TC_BASE より深く own 以下）で使用 0 バイトの深度が続く限り下がった深度。
// ミュータント22（テストの自己検査）: 空の判定を外して今の深度の1レベル下まで手放し、手放す [基底, bump) を毒で塗る
func parkTrim(st mut St, me int, own int) int {
    meta := globaladdr(mut st, st.meta)
    sg := globaladdr(mut st, st.slotsG)
    w := load(mut st, meta, W_DEPTH)
    if st.rtMut == 22 {
        j := bin(mut st, BSub, w, iconst(mut st, 1))
        bP := branchIf(mut st, bin(mut st, BAnd, cmp(mut st, CGt, j, load(mut st, me, TC_BASE)), cmp(mut st, CGe, own, w)))
        parkPoison(mut st, j, own)
        br(mut st, bP, -1)
        setCur(mut st, bP)
        return j
    }
    base := load(mut st, me, TC_BASE)
    loop := newBlock(mut st)
    k := param(mut st, loop, TyI64)
    chk := newBlock(mut st)
    step := newBlock(mut st)
    done := newBlock(mut st)
    j := param(mut st, done, TyI64)
    br(mut st, loop, list1(mut st, w))
    setCur(mut st, loop)
    condbr(mut st, bin(mut st, BAnd, cmp(mut st, CGt, k, base), cmp(mut st, CLe, k, own)), chk, -1, done, list1(mut st, k))
    setCur(mut st, chk)
    empty := cmp(mut st, CEq, load(mut st, gepWord(mut st, meta, k), W_BUMP), winAdj(mut st, meta, load(mut st, gepWord(mut st, sg, k), 0)))
    condbr(mut st, empty, step, -1, done, list1(mut st, k))
    setCur(mut st, step)
    br(mut st, loop, list1(mut st, bin(mut st, BSub, k, iconst(mut st, 1))))
    setCur(mut st, done)
    return j
}

// ミュータント20の毒: (dep, own] の各スロットの [基底, bump) を0x5a… で塗る
func parkPoison(st mut St, dep int, own int) {
    meta := globaladdr(mut st, st.meta)
    sg := globaladdr(mut st, st.slotsG)
    loop := newBlock(mut st)
    k := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, dep, iconst(mut st, 1))))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLe, k, own), body, -1, done, -1)
    setCur(mut st, body)
    e := load(mut st, gepWord(mut st, meta, k), W_BUMP)
    pl := newBlock(mut st)
    p := param(mut st, pl, TyI64)
    pb := newBlock(mut st)
    pd := newBlock(mut st)
    br(mut st, pl, list1(mut st, load(mut st, gepWord(mut st, sg, k), 0)))
    setCur(mut st, pl)
    condbr(mut st, cmp(mut st, CLt, p, e), pb, -1, pd, -1)
    setCur(mut st, pb)
    store(mut st, itop(mut st, p), 0, iconst(mut st, 6510615555426900570))
    br(mut st, pl, list1(mut st, bin(mut st, BAdd, p, iconst(mut st, 8))))
    setCur(mut st, pd)
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, k, iconst(mut st, 1))))
    setCur(mut st, done)
}

// rt.slot_take() i64: プールのスロットを 1 つ取る（空なら SLOT_CHUNK 本ぶんの VA を予約 — rt.slot_new の子の枝と同じ。
// チャネルのペイロードの小アリーナ — 段階6 P4-4 (B4)）
func buildSlotTake(st mut St) {
    begin(mut st, st.rtSlotTake)
    meta := globaladdr(mut st, st.meta)
    fg := globaladdr(mut st, st.slotFreeG)
    bRefill := newBlock(mut st)
    bPop := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, load(mut st, fg, 0), iconst(mut st, 0)), bRefill, -1, bPop, -1)
    setCur(mut st, bRefill)
    slotRefill(mut st, meta, fg)
    br(mut st, bPop, -1)
    setCur(mut st, bPop)
    n := load(mut st, fg, 0)
    s := load(mut st, gepWord(mut st, fg, n), 0)
    store(mut st, fg, 0, bin(mut st, BSub, n, iconst(mut st, 1)))
    mInc(mut st, 13)
    ret(mut st, s)
}

// プール（空）に SLOT_CHUNK 本のスロットを積む（M:N なら共有の予備から先に — mnSlotRefill）
func slotRefill(st mut St, meta int, fg int) {
    bMn := newBlock(mut st)
    bMap := newBlock(mut st)
    bEnd := newBlock(mut st)
    condbr(mut st, mnOn(mut st), bMn, -1, bMap, -1)
    setCur(mut st, bMn)
    got := call(mut st, st.rtSresTake, list0(mut st))
    mAdd(mut st, 7, got)
    condbr(mut st, cmp(mut st, CNe, got, iconst(mut st, 0)), bEnd, -1, bMap, -1)
    setCur(mut st, bMap)
    size := load(mut st, meta, W_SLOT_DEF)
    total := bin(mut st, BMul, size, iconst(mut st, SLOT_CHUNK))
    a := sysMmap(mut st, total)
    slotVaAdd(mut st, total)
    pstatVa(mut st, SLOT_CHUNK)
    mInc(mut st, 4)
    for i <- iter.Range(0, SLOT_CHUNK) {
        store(mut st, fg, 1 + i, bin(mut st, BAdd, a, bin(mut st, BMul, size, iconst(mut st, i))))
    }
    store(mut st, fg, 0, iconst(mut st, SLOT_CHUNK))
    br(mut st, bEnd, -1)
    setCur(mut st, bEnd)
}

// 深度 k が lo < k <= hi の範囲を回す（save = true なら表と bump を t の退避域へ・false なら t から戻す）
func slotRange(st mut St, t int, lo int, hi int, save bool) {
    meta := globaladdr(mut st, st.meta)
    sg := globaladdr(mut st, st.slotsG)
    loop := newBlock(mut st)
    k := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, lo, iconst(mut st, 1))))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLe, k, hi), body, -1, done, -1)
    setCur(mut st, body)
    sv := gepWord(mut st, t, bin(mut st, BMul, k, iconst(mut st, 2)))
    sp := gepWord(mut st, sg, k)
    bp := gepWord(mut st, meta, k)
    if save {
        store(mut st, sv, TC_SAVE, load(mut st, sp, 0))
        store(mut st, sv, TC_SAVE + 1, load(mut st, bp, W_BUMP))
    } else {
        store(mut st, sp, 0, load(mut st, sv, TC_SAVE))
        store(mut st, bp, W_BUMP, load(mut st, sv, TC_SAVE + 1))
    }
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, k, iconst(mut st, 1))))
    setCur(mut st, done)
}

// 今のtask（tcb — 終わった子）の自前のスロットをプールへ返す（先頭からW_MADVを超えて使ったページはMADV_DONTNEED・プールが満杯ならmunmap）
func slotRelease(st mut St, tcb int) int {
    meta := globaladdr(mut st, st.meta)
    sg := globaladdr(mut st, st.slotsG)
    fg := globaladdr(mut st, st.slotFreeG)
    loop := newBlock(mut st)
    k := param(mut st, loop, TyI64)
    acc := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    adv := newBlock(mut st)
    bPush := newBlock(mut st)
    keep := newBlock(mut st)
    next := newBlock(mut st)
    done := newBlock(mut st)
    dacc := param(mut st, done, TyI64)
    hi := load(mut st, sg, SLOT_OWN)
    br(mut st, loop, list2(mut st, bin(mut st, BAdd, load(mut st, tcb, TC_BASE), iconst(mut st, 1)), iconst(mut st, 0)))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLe, k, hi), body, -1, done, list1(mut st, acc))
    setCur(mut st, body)
    s := load(mut st, gepWord(mut st, sg, k), 0)
    used := winUsed(mut st, meta, s, bin(mut st, BSub, load(mut st, gepWord(mut st, meta, k), W_BUMP), s), ptoi(mut st, tcb))
    // 既定より大きいスロット（自前の mmap — slot_new）はプールへ返さず munmap
    bBig := newBlock(mut st)
    bDef := newBlock(mut st)
    sz := load(mut st, meta, W_SLOT_SIZE)
    smallRel(mut st, meta, k, s, used, sz, bBig, bDef, next, tcb)
    setCur(mut st, bBig)
    syscall(mut st, list3(mut st, iconst(mut st, 11), s, sz))
    if st.poolOn {
        slotVaAdd(mut st, bin(mut st, BSub, iconst(mut st, 0), sz))
    }
    br(mut st, next, -1)
    setCur(mut st, bDef)
    // 返すのは先頭から W_MADV を超えた分だけ（region_enter と同じ規則 — task の終わりごとの madvise は M:N で TLB の撃ち落としになる）
    keepB := load(mut st, meta, W_MADV)
    condbr(mut st, cmp(mut st, CGt, used, keepB), adv, -1, bPush, -1)
    setCur(mut st, adv)
    // ミュータント5（開発用）: スロットを返すときのMADV_DONTNEEDを省く
    if st.rtMut != 5 {
        syscall(mut st, list4(mut st, iconst(mut st, 28), bin(mut st, BAdd, s, keepB), bin(mut st, BSub, used, keepB), iconst(mut st, 4)))
    }
    br(mut st, bPush, -1)
    setCur(mut st, bPush)
    n := load(mut st, fg, 0)
    bDrop := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, n, iconst(mut st, SLOT_FREE_CAP)), keep, -1, bDrop, -1)
    setCur(mut st, bDrop)
    syscall(mut st, list3(mut st, iconst(mut st, 11), s, load(mut st, meta, W_SLOT_DEF)))
    if st.poolOn {
        slotVaAdd(mut st, bin(mut st, BSub, iconst(mut st, 0), load(mut st, meta, W_SLOT_DEF)))
    }
    br(mut st, next, -1)
    setCur(mut st, keep)
    n1 := bin(mut st, BAdd, n, iconst(mut st, 1))
    store(mut st, gepWord(mut st, fg, n1), 0, s)
    store(mut st, fg, 0, n1)
    br(mut st, next, -1)
    setCur(mut st, next)
    br(mut st, loop, list2(mut st, bin(mut st, BAdd, k, iconst(mut st, 1)), bin(mut st, BAdd, acc, used)))
    setCur(mut st, done)
    return dacc
}

// rt.slot_trim(): 今のワーカーの手元のプールのうち、上の SLOT_KEEP 本（次に取られる温かい分）を除いて冷えた水位より上のスロットの
// 先頭W_MADV（返すときに残したページ — slotRelease / slot_give）もMADV_DONTNEEDで返し、水位を上げる。M:Nでは加えて共有の予備の
// 水位より上の全部（手元は SLOT_KEEP 本までで、超過は予備へ行く — 予備は全部が超過）。呼ぶのは scope の出口で、刈るのは main の task の scope だけ
// （子の scope の出口ごとに刈ると、予備の鍵を握った madvise の間に他のワーカーが回る — skynet の W8 で cycles +4.8%・命令 +2.0%〔を払っていた〕）。
// taskの終わりごとでない — 撃ち落としを根のscopeの出口でバッチ処理する。意味は変わらない: プールのスロットの中身は死んでいて、取ったtaskは
// bumpの先頭から書き直す（返したページはゼロのページで戻る）
func buildSlotTrim(st mut St) {
    begin(mut st, st.rtSlotTrim)
    bTop := newBlock(mut st)
    bOut0 := newBlock(mut st)
    curT := load(mut st, globaladdr(mut st, st.taskG), TK_CUR)
    condbr(mut st, cmp(mut st, CEq, curT, ptoi(mut st, globaladdr(mut st, st.mainTcb))), bTop, -1, bOut0, -1)
    setCur(mut st, bOut0)
    ret(mut st, -1)
    setCur(mut st, bTop)
    fg := globaladdr(mut st, st.slotFreeG)
    dpDissolve(mut st, globaladdr(mut st, st.wkG), WK_DPC, WK_DPS, DP_CAP, fg, SLOT_FREE_CAP)
    keepB := load(mut st, globaladdr(mut st, st.meta), W_MADV)
    n := load(mut st, fg, 0)
    wm := wmCheck(mut st, fg, n, SLOT_WM)
    hi := bin(mut st, BSub, n, iconst(mut st, SLOT_KEEP))
    bRun := newBlock(mut st)
    loop := newBlock(mut st)
    k := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    fin := newBlock(mut st)
    done := newBlock(mut st)
    condbr(mut st, bin(mut st, BAnd, cmp(mut st, CGt, hi, wm), cmp(mut st, CGt, keepB, iconst(mut st, 0))), bRun, -1, done, -1)
    setCur(mut st, bRun)
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, wm, iconst(mut st, 1))))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLe, k, hi), body, -1, fin, -1)
    setCur(mut st, body)
    syscall(mut st, list4(mut st, iconst(mut st, 28), load(mut st, gepWord(mut st, fg, k), 0), keepB, iconst(mut st, 4)))
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, k, iconst(mut st, 1))))
    setCur(mut st, fin)
    store(mut st, fg, SLOT_WM, hi)
    store(mut st, fg, SLOT_WM + 1, load(mut st, gepWord(mut st, fg, hi), 0))
    br(mut st, done, -1)
    // M:N: 共有の予備（手元の SLOT_KEEP 本を越えた分の行き先 — slot_give）は全部が超過なので、水位より上を全部返す（鍵の下 — 返す間に他のワーカーが取らない）
    setCur(mut st, done)
    bMn := newBlock(mut st)
    bLk := newBlock(mut st)
    sl := newBlock(mut st)
    k2 := param(mut st, sl, TyI64)
    sb := newBlock(mut st)
    sfin := newBlock(mut st)
    out := newBlock(mut st)
    condbr(mut st, mnOn(mut st), bMn, -1, out, -1)
    setCur(mut st, bMn)
    mn := globaladdr(mut st, st.mnG)
    rs := globaladdr(mut st, st.sresG)
    sdp := globaladdr(mut st, st.sdpG)
    sdpAny := cmp(mut st, CNe, load(mut st, sdp, 0), iconst(mut st, 0))
    condbr(mut st, bin(mut st, BAnd, bin(mut st, BOr, cmp(mut st, CNe, load(mut st, rs, 0), load(mut st, rs, SRES_WM)), sdpAny), cmp(mut st, CGt, keepB, iconst(mut st, 0))), bLk, -1, out, -1)
    setCur(mut st, bLk)
    spinLock(mut st, mn, MN_RLOCK)
    // 共有の予備の深度ごとのチェーンを単体の予備へ溶かす（数の上限は合わせてSRES_CAP — 溢れない）。刈りは単体の列の水位で
    dpDissolve(mut st, sdp, 1, SDP_S, SRES_CAP, rs, SRES_CAP)
    store(mut st, sdp, 0, iconst(mut st, 0))
    c := load(mut st, rs, 0)
    br(mut st, sl, list1(mut st, bin(mut st, BAdd, wmCheck(mut st, rs, c, SRES_WM), iconst(mut st, 1))))
    setCur(mut st, sl)
    condbr(mut st, cmp(mut st, CLe, k2, c), sb, -1, sfin, -1)
    setCur(mut st, sb)
    syscall(mut st, list4(mut st, iconst(mut st, 28), load(mut st, gepWord(mut st, rs, k2), 0), keepB, iconst(mut st, 4)))
    br(mut st, sl, list1(mut st, bin(mut st, BAdd, k2, iconst(mut st, 1))))
    setCur(mut st, sfin)
    store(mut st, rs, SRES_WM, c)
    store(mut st, rs, SRES_WM + 1, load(mut st, gepWord(mut st, rs, c), 0))
    store(mut st, mn, MN_RLOCK, iconst(mut st, 0))
    br(mut st, out, -1)
    setCur(mut st, out)
    ret(mut st, -1)
}

// 深度ごとの列（p[cOff + r] が列 r の数・p[eOff + r × stride + i] が基底・r = 0〜DP_MASK）を全部単体の列 a（[数, 基底…] — 容量 cap）へ移す。
// 列が満杯なら残りは munmap（slot_trim の刈りは単体の列の水位で行うので、刈る前に溶かす）
func dpDissolve(st mut St, p int, cOff int, eOff int, stride int, a int, cap int) {
    zero := iconst(mut st, 0)
    one := iconst(mut st, 1)
    def := load(mut st, globaladdr(mut st, st.meta), W_SLOT_DEF)
    rl := newBlock(mut st)
    r := param(mut st, rl, TyI64)
    rb := newBlock(mut st)
    rd := newBlock(mut st)
    il := newBlock(mut st)
    i := param(mut st, il, TyI64)
    ib := newBlock(mut st)
    bPut := newBlock(mut st)
    bDrop := newBlock(mut st)
    bNx := newBlock(mut st)
    id := newBlock(mut st)
    br(mut st, rl, list1(mut st, zero))
    setCur(mut st, rl)
    condbr(mut st, cmp(mut st, CLe, r, iconst(mut st, DP_MASK)), rb, -1, rd, -1)
    setCur(mut st, rb)
    cp := gepWord(mut st, p, bin(mut st, BAdd, r, iconst(mut st, cOff)))
    n := load(mut st, cp, 0)
    br(mut st, il, list1(mut st, zero))
    setCur(mut st, il)
    condbr(mut st, cmp(mut st, CLt, i, n), ib, -1, id, -1)
    setCur(mut st, ib)
    x := load(mut st, gepWord(mut st, p, bin(mut st, BAdd, bin(mut st, BAdd, bin(mut st, BMul, r, iconst(mut st, stride)), i), iconst(mut st, eOff))), 0)
    an := load(mut st, a, 0)
    condbr(mut st, cmp(mut st, CLt, an, iconst(mut st, cap)), bPut, -1, bDrop, -1)
    setCur(mut st, bPut)
    an1 := bin(mut st, BAdd, an, one)
    store(mut st, gepWord(mut st, a, an1), 0, x)
    store(mut st, a, 0, an1)
    br(mut st, bNx, -1)
    setCur(mut st, bDrop)
    syscall(mut st, list3(mut st, iconst(mut st, 11), x, def))
    if st.poolOn {
        slotVaAdd(mut st, bin(mut st, BSub, iconst(mut st, 0), def))
    }
    br(mut st, bNx, -1)
    setCur(mut st, bNx)
    br(mut st, il, list1(mut st, bin(mut st, BAdd, i, one)))
    setCur(mut st, id)
    store(mut st, cp, 0, zero)
    br(mut st, rl, list1(mut st, bin(mut st, BAdd, r, one)))
    setCur(mut st, rd)
}

// プールp（数n・水位のワードw / 番兵のワードw + 1）の水位: 水位が数以下で、水位の位置の番地が番兵と同じなら水位・違えば0（刈り直す）
func wmCheck(st mut St, p int, n int, w int) int {
    wm0 := load(mut st, p, w)
    le := cmp(mut st, CLe, wm0, n)
    same := cmp(mut st, CEq, load(mut st, gepWord(mut st, p, bin(mut st, BMul, wm0, le)), 0), load(mut st, p, w + 1))
    ok := bin(mut st, BAnd, le, bin(mut st, BOr, same, cmp(mut st, CEq, wm0, iconst(mut st, 0))))
    return bin(mut st, BMul, wm0, ok)
}

// rt.slot_give(s, used): スロットs（使った量usedバイト）をプールへ返す（先頭からW_MADVを超えて使ったページはMADV_DONTNEED・プールも予備も満杯ならmunmap）
func buildSlotGive(st mut St) {
    begin(mut st, st.rtSlotGive)
    fg := globaladdr(mut st, st.slotFreeG)
    bAdv := newBlock(mut st)
    bPush := newBlock(mut st)
    keep := newBlock(mut st)
    done := newBlock(mut st)
    // 返すのは先頭から W_MADV を超えた分だけ（region_enter と同じ規則）
    keepB := load(mut st, globaladdr(mut st, st.meta), W_MADV)
    if st.rtMut == 4 {
        mInc(mut st, 3)
        mAdd(mut st, 8, bin(mut st, BSub, 1, bin(mut st, BMul, cmp(mut st, CGt, 1, keepB), bin(mut st, BSub, 1, keepB))))
        mAdd(mut st, 9, 1)
    }
    condbr(mut st, cmp(mut st, CGt, 1, keepB), bAdv, -1, bPush, -1)
    setCur(mut st, bAdv)
    if st.rtMut != 5 {
        syscall(mut st, list4(mut st, iconst(mut st, 28), bin(mut st, BAdd, 0, keepB), bin(mut st, BSub, 1, keepB), iconst(mut st, 4)))
    }
    br(mut st, bPush, -1)
    setCur(mut st, bPush)
    n := load(mut st, fg, 0)
    // 手元の上限: 協調形 = SLOT_FREE_CAP・M:N = SLOT_KEEP（越えた分は共有の予備へ — 他のワーカーの子が使う）
    capV := bin(mut st, BAdd, iconst(mut st, SLOT_FREE_CAP), bin(mut st, BMul, mnOn(mut st), iconst(mut st, SLOT_KEEP - SLOT_FREE_CAP)))
    bShare := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, n, capV), keep, -1, bShare, -1)
    setCur(mut st, keep)
    n1 := bin(mut st, BAdd, n, iconst(mut st, 1))
    store(mut st, gepWord(mut st, fg, n1), 0, 0)
    store(mut st, fg, 0, n1)
    br(mut st, done, -1)
    setCur(mut st, bShare)
    bSh := newBlock(mut st)
    bDrop := newBlock(mut st)
    condbr(mut st, mnOn(mut st), bSh, -1, bDrop, -1)
    setCur(mut st, bSh)
    mn := globaladdr(mut st, st.mnG)
    rs := globaladdr(mut st, st.sresG)
    spinLock(mut st, mn, MN_RLOCK)
    c := load(mut st, rs, 0)
    bPut := newBlock(mut st)
    bFull := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, c, iconst(mut st, SRES_CAP)), bPut, -1, bFull, -1)
    setCur(mut st, bPut)
    c1 := bin(mut st, BAdd, c, iconst(mut st, 1))
    store(mut st, gepWord(mut st, rs, c1), 0, 0)
    store(mut st, rs, 0, c1)
    mInc(mut st, 6)
    store(mut st, mn, MN_RLOCK, iconst(mut st, 0))
    br(mut st, done, -1)
    setCur(mut st, bFull)
    store(mut st, mn, MN_RLOCK, iconst(mut st, 0))
    br(mut st, bDrop, -1)
    // 予備も満杯: munmapでVAとページを返す（捨てるだけだと山のたびにVAが漏れてva_exhaustedに届く）
    setCur(mut st, bDrop)
    mInc(mut st, 5)
    syscall(mut st, list3(mut st, iconst(mut st, 11), 0, load(mut st, globaladdr(mut st, st.meta), W_SLOT_DEF)))
    if st.poolOn {
        slotVaAdd(mut st, bin(mut st, BSub, iconst(mut st, 0), load(mut st, globaladdr(mut st, st.meta), W_SLOT_DEF)))
    }
    br(mut st, done, -1)
    setCur(mut st, done)
    ret(mut st, -1)
}

// rt.frame_new の宣言（handle を捨てた子を生むプログラムだけ — 使わないプログラムの IR は不変）
func needFrameRt(st mut St) {
    lsNeed(mut st, NEED_FRAME, 0)
    if st.rtFrameNew == -1 {
        st.rtFrameNew = addFunc(mut st, int(strLit(mut st, "rt.frame_new")), desugar.ListRef(list0(mut st)), TyPtr)
    }
}

// rt.frame_new() ptr: handleを捨てた子の枠 = 今のワーカーの小さなチャンクのチェーン（rt.kid_keepの預かりの小さなチャンクと同じチェーン・
// KEEP_SMALL バイト）から 1 つ（空なら KEEP_SLAB を mmap して切り分ける）。返すのは子の終わり（frameDrop）か scope の出口（死んだ枠 — deadWalk）で、
// 返す側のワーカーのチェーンへ
func buildFrameNew(st mut St) {
    begin(mut st, st.rtFrameNew)
    wk := globaladdr(mut st, st.wkG)
    zero := iconst(mut st, 0)
    bRem := newBlock(mut st)
    bFill := newBlock(mut st)
    bPop := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, load(mut st, wk, WK_SLAB), zero), bRem, -1, bPop, -1)
    // 自分のチェーンが空: 他のワーカーが返した分を丸ごと取る（無ければ新しいチャンク）
    setCur(mut st, bRem)
    rf := atomicXchg(mut st, wk, WK_RFREE, zero)
    store(mut st, wk, WK_SLAB, rf)
    condbr(mut st, cmp(mut st, CEq, rf, zero), bFill, -1, bPop, -1)
    setCur(mut st, bFill)
    slabFill(mut st, wk)
    br(mut st, bPop, -1)
    setCur(mut st, bPop)
    c0 := load(mut st, wk, WK_SLAB)
    store(mut st, wk, WK_SLAB, load(mut st, itop(mut st, c0), 0))
    // 持ち主（返す先のワーカー）を枠の FR_NEXT へ（handle を捨てた子は error を返さないので FR_NEXT を使わない）
    store(mut st, itop(mut st, c0), FR_NEXT, ptoi(mut st, wk))
    ret(mut st, itop(mut st, c0))
}

// handleを捨てた子の枠fを持ち主のワーカーへ返す（今のワーカーが持ち主なら自分のチェーン・それ以外は持ち主のWK_RFREEへCAS）
func frameFree(st mut St, f int) {
    wk := globaladdr(mut st, st.wkG)
    own := load(mut st, f, FR_NEXT)
    bMine := newBlock(mut st)
    bRem := newBlock(mut st)
    bEnd := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, own, ptoi(mut st, wk)), bMine, -1, bRem, -1)
    setCur(mut st, bMine)
    store(mut st, f, 0, load(mut st, wk, WK_SLAB))
    store(mut st, wk, WK_SLAB, ptoi(mut st, f))
    br(mut st, bEnd, -1)
    setCur(mut st, bRem)
    ow := itop(mut st, own)
    pl := newBlock(mut st)
    br(mut st, pl, -1)
    setCur(mut st, pl)
    h := load(mut st, ow, WK_RFREE)
    store(mut st, f, 0, h)
    o := atomicCas(mut st, ow, WK_RFREE, h, ptoi(mut st, f))
    condbr(mut st, cmp(mut st, CEq, o, h), bEnd, -1, pl, -1)
    setCur(mut st, bEnd)
}

// 今のワーカーの小さなチャンクのチェーン（空）にKEEP_SLABをmmapしてKEEP_SMALLずつ切り分けて積む
func slabFill(st mut St, wk int) {
    sb := sysMmap(mut st, iconst(mut st, KEEP_SLAB))
    for i <- iter.Range(0, KEEP_SLAB / KEEP_SMALL) {
        cp := itop(mut st, bin(mut st, BAdd, sb, iconst(mut st, i * KEEP_SMALL)))
        store(mut st, cp, 0, if i + 1 < KEEP_SLAB / KEEP_SMALL { bin(mut st, BAdd, sb, iconst(mut st, (i + 1) * KEEP_SMALL)) } else { iconst(mut st, 0) })
    }
    store(mut st, wk, WK_SLAB, sb)
}

// 終わる子（枠 frame・scope の記録 rec・死んだか dead）の枠が handle を捨てた子の枠（FR_COL = 2）なら持ち主のワーカーへ返す
// （frameFree）。死んでいれば先に scope の記録の鍵 SR_DLOCK の中で、自分の番号が SR_DMIN より小さければ (番号, 死因) を書く（
// 子は並行に終わる。2ワードの組を割らないための鍵・死のパスだけ）。生きている子の数を減らす前に呼ぶ（出口は数0を見てから2ワードを読む）。handleを捨てた子を生まないプログラムでは何も出さない
func frameDrop(st mut St, frame int, rec int, dead int) {
    if st.rtFrameNew == -1 {
        return
    }
    bD := newBlock(mut st)
    bFree := newBlock(mut st)
    bGone := newBlock(mut st)
    bEnd := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, load(mut st, frame, FR_COL), iconst(mut st, 2)), bD, -1, bEnd, -1)
    setCur(mut st, bD)
    condbr(mut st, cmp(mut st, CNe, dead, iconst(mut st, 0)), bGone, -1, bFree, -1)
    setCur(mut st, bGone)
    spinLock(mut st, rec, SR_DLOCK)
    idx := load(mut st, frame, FR_IDX)
    best := load(mut st, rec, SR_DMIN)
    upd := cmp(mut st, CLt, idx, best)
    oldC := load(mut st, rec, SR_DCAUSE)
    store(mut st, rec, SR_DCAUSE, bin(mut st, BAdd, oldC, bin(mut st, BMul, upd, bin(mut st, BSub, load(mut st, frame, FR_CAUSE), oldC))))
    store(mut st, rec, SR_DMIN, bin(mut st, BAdd, best, bin(mut st, BMul, upd, bin(mut st, BSub, idx, best))))
    atomicXchg(mut st, rec, SR_DLOCK, iconst(mut st, 0))
    br(mut st, bFree, -1)
    setCur(mut st, bFree)
    frameFree(mut st, frame)
    br(mut st, bEnd, -1)
    setCur(mut st, bEnd)
}

// rt.kid_keep(d) ptr（段階6 P4-4 (B1) — 結果にregionを持つ子の関数の出口から。結果は自前の深度dに寄せ済み）: 結果のコピー先 =
// 深度dの使った量（ページに切り上げ・最小1ページ）の小さな無名の領域を確保して枠の預かりのフィールド [基底, 長さ, 次] に書き、scopeの記録のSR_KEEPのチェーンへ
// 積んで基底を返す（呼び手が深度d - 1をそこへ付け替えてコピーする — dのスロットはいつもどおりtaskの終わりにプールへ返る）。
// スロットごと預けると 4 GiB の VA × 子の数で尽きた（1 scope に 10 万の string の子で 102 — 切り詰め〔munmap の尻尾〕は VA を穴だらけにして同じく尽きた）
func buildKidKeep(st mut St) {
    begin(mut st, st.rtKidKeep)
    d := 0
    meta := globaladdr(mut st, st.meta)
    sg := globaladdr(mut st, st.slotsG)
    tcb := itop(mut st, load(mut st, globaladdr(mut st, st.taskG), TK_CUR))
    frame := itop(mut st, load(mut st, tcb, TC_FRAME))
    s0 := load(mut st, gepWord(mut st, sg, d), 0)
    kp := gepWord(mut st, frame, load(mut st, tcb, TC_KOFF))
    used := bin(mut st, BSub, load(mut st, gepWord(mut st, meta, d), W_BUMP), s0)
    // 小さい（使った量 ≤ KEEP_SMALL）なら今のワーカーのチャンクのチェーンから（長さ0 = チャンクのフラグ — 返すのは返す側のワーカーのチェーンへ）・大きければページに切り上げてmmap
    wk := globaladdr(mut st, st.wkG)
    bSmall := newBlock(mut st)
    bBig := newBlock(mut st)
    bGo := newBlock(mut st)
    a := param(mut st, bGo, TyI64)
    alen := param(mut st, bGo, TyI64)
    condbr(mut st, cmp(mut st, CLe, used, iconst(mut st, KEEP_SMALL)), bSmall, -1, bBig, -1)
    setCur(mut st, bSmall)
    bFill := newBlock(mut st)
    bPop := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, load(mut st, wk, WK_SLAB), iconst(mut st, 0)), bFill, -1, bPop, -1)
    setCur(mut st, bFill)
    slabFill(mut st, wk)
    br(mut st, bPop, -1)
    setCur(mut st, bPop)
    c0 := load(mut st, wk, WK_SLAB)
    store(mut st, wk, WK_SLAB, load(mut st, itop(mut st, c0), 0))
    br(mut st, bGo, list2(mut st, c0, iconst(mut st, 0)))
    setCur(mut st, bBig)
    klen := bin(mut st, BAnd, bin(mut st, BAdd, used, iconst(mut st, 4095)), iconst(mut st, -4096))
    br(mut st, bGo, list2(mut st, sysMmap(mut st, klen), klen))
    setCur(mut st, bGo)
    store(mut st, kp, KP_SLOT, a)
    store(mut st, kp, KP_USED, alen)
    // scopeの記録の預かりのチェーンへ積む（子は並行に終わる — CAS）
    rec := itop(mut st, load(mut st, frame, FR_SREC))
    pl := newBlock(mut st)
    pd := newBlock(mut st)
    br(mut st, pl, -1)
    setCur(mut st, pl)
    h := load(mut st, rec, SR_KEEP)
    store(mut st, kp, KP_NEXT, h)
    o := atomicCas(mut st, rec, SR_KEEP, h, ptoi(mut st, kp))
    condbr(mut st, cmp(mut st, CEq, o, h), pd, -1, pl, -1)
    setCur(mut st, pd)
    ret(mut st, itop(mut st, a))
}

// rt.chan_free(ar, n): チャネルの枠の小アリーナn個（[基底, 使った量] の列ar）をプールへ返す（段階6 P4-4 (B4)）
func buildChanFree(st mut St) {
    begin(mut st, st.rtChanFree)
    loop := newBlock(mut st)
    i := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    give := newBlock(mut st)
    next := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLt, i, 1), body, -1, done, -1)
    setCur(mut st, body)
    e := gepWord(mut st, 0, bin(mut st, BMul, i, iconst(mut st, 2)))
    a := load(mut st, e, 0)
    condbr(mut st, cmp(mut st, CNe, a, iconst(mut st, 0)), give, -1, next, -1)
    setCur(mut st, give)
    call(mut st, st.rtSlotGive, list2(mut st, a, load(mut st, e, 1)))
    store(mut st, e, 0, iconst(mut st, 0))
    br(mut st, next, -1)
    setCur(mut st, next)
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, i, iconst(mut st, 1))))
    setCur(mut st, done)
    ret(mut st, -1)
}

// regionBorrowの貸し借りの記録（IRの値: ownerの退避のフィールド・今の表のフィールド・借りる前の今の表の値）
type Loan struct {
    sv int
    sp int
    bp int
    oldS int
    oldB int
}

// 止まっている task owner の自前の深度 d の region（スロットの基底と bump）を owner の退避（R1'）から今の表へ借りる
// （P3b-4 — 子の結果をscopeのregionへ・チャネルのペイロードを記録のregionへコピーするインターフェース。切替はownerの自前の深度を退避から戻すので、
// 今の表に書いただけでは消える — regionReturn が進んだ bump を退避へ書き戻す）。owner は今の task でないこと（今の task なら表が正）
func regionBorrow(st mut St, owner int, d int) Loan {
    meta := globaladdr(mut st, st.meta)
    sv := gepWord(mut st, owner, bin(mut st, BMul, d, iconst(mut st, 2)))
    sp := gepWord(mut st, globaladdr(mut st, st.slotsG), d)
    bp := gepWord(mut st, meta, d)
    oldS := load(mut st, sp, 0)
    oldB := load(mut st, bp, W_BUMP)
    store(mut st, sp, 0, load(mut st, sv, TC_SAVE))
    store(mut st, bp, W_BUMP, load(mut st, sv, TC_SAVE + 1))
    return Loan{sv: sv, sp: sp, bp: bp, oldS: oldS, oldB: oldB}
}

// 借りた深度の進んだ bump を owner の退避へ書き戻し、今の表を借りる前へ戻す
func regionReturn(st mut St, l Loan) {
    store(mut st, l.sv, TC_SAVE + 1, load(mut st, l.bp, W_BUMP))
    store(mut st, l.sp, 0, l.oldS)
    store(mut st, l.bp, W_BUMP, l.oldB)
}

// toの自前の範囲 (…, ownT] に重なる予備 (SPLO, min(ownT, SPHI)] をプールへ出し、SPLO = max(SPLO, ownT)（toの退避がフィールドを上書きする前に —
// 上書きされた予備は宙に浮く）。重ならなければ比べ 1 つ
func spareCover(st mut St, ownT int) {
    sg := globaladdr(mut st, st.slotsG)
    lo := load(mut st, sg, SLOT_SPLO)
    bOv := newBlock(mut st)
    bEnd := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, lo, ownT), bOv, -1, bEnd, -1)
    setCur(mut st, bOv)
    hi := load(mut st, sg, SLOT_SPHI)
    upto := bin(mut st, BAdd, hi, bin(mut st, BMul, cmp(mut st, CLt, ownT, hi), bin(mut st, BSub, ownT, hi)))
    loop := newBlock(mut st)
    k := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, lo, iconst(mut st, 1))))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLe, k, upto), body, -1, done, -1)
    setCur(mut st, body)
    spareOut(mut st, k, spareSz(mut st, sg, globaladdr(mut st, st.meta)))
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, k, iconst(mut st, 1))))
    setCur(mut st, done)
    store(mut st, sg, SLOT_SPLO, ownT)
    br(mut st, bEnd, -1)
    setCur(mut st, bEnd)
}

// 今の task（from）の状態を退避し、to の状態を戻して今の task を to にする。region の自前の深度の範囲
// （(TC_BASE, own]）のスロットの基底と bump も退避 / 復元する（R1' — 中断した task の region に他の task が入らない）
func taskHandover(st mut St, from int, to int) {
    meta := globaladdr(mut st, st.meta)
    tg := globaladdr(mut st, st.trapG)
    sg := globaladdr(mut st, st.slotsG)
    ownF := load(mut st, sg, SLOT_OWN)
    store(mut st, from, TC_OWN, ownF)
    slotRange(mut st, from, load(mut st, from, TC_BASE), ownF, true)
    ownT := load(mut st, to, TC_OWN)
    spareCover(mut st, ownT)
    slotRange(mut st, to, load(mut st, to, TC_BASE), ownT, false)
    store(mut st, sg, SLOT_OWN, ownT)
    store(mut st, meta, W_SLOT_SIZE, load(mut st, to, TC_SLOTSZ))
    store(mut st, meta, W_MAXD, load(mut st, to, TC_DEPTH))
    store(mut st, from, TC_DEPTH, load(mut st, meta, W_DEPTH))
    store(mut st, from, TC_DEST, load(mut st, meta, W_DEST))
    store(mut st, from, TC_ANCHOR, load(mut st, meta, W_ANCHOR))
    store(mut st, from, TC_TRAP, load(mut st, tg, TW_TOP))
    store(mut st, meta, W_DEPTH, load(mut st, to, TC_DEPTH))
    store(mut st, meta, W_DEST, load(mut st, to, TC_DEST))
    store(mut st, meta, W_ANCHOR, load(mut st, to, TC_ANCHOR))
    store(mut st, tg, TW_TOP, load(mut st, to, TC_TRAP))
    store(mut st, globaladdr(mut st, st.taskG), TK_CUR, ptoi(mut st, to))
    // 検査点の見直しのフラグはtaskごと — 打ち切りのフラグが1度でも立ったプログラムなら、切り替えた先は次の検査点で見直す（段階6 P4-5）
    store(mut st, globaladdr(mut st, st.wkG), WK_CUT, load(mut st, globaladdr(mut st, st.cutGenG), 0))
}

// rt.task_new() ptr: プールのチャンクか、新しいチャンク（mmap + ガードページのmprotect）。予約の失敗はregionの超過と同じ死（102）
func buildTaskNew(st mut St) {
    buildTaskNewFn(mut st, st.rtTaskNew, false)
    if st.poolOn {
        buildTaskNewFn(mut st, st.rtTaskNewIn, true)
    }
}

// rt.task_new（inPool = false）と rt.task_new_in（inPool = true — task.SpawnIn の入場: 第 3 実引数 = プールの節・節であふれたら 0 = shed）の本体
func buildTaskNewFn(st mut St, fnr FnRef, inPool bool) {
    begin(mut st, fnr)
    // 親（今のtask）の次のspawn 1回のDのフラグを読んで消す（rt.netop 7 — SpawnでもSpawnInでも。入場でshedしても消す）
    parT := itop(mut st, load(mut st, globaladdr(mut st, st.taskG), TK_CUR))
    mw := load(mut st, parT, TC_NMAXW)
    store(mut st, parT, TC_NMAXW, iconst(mut st, 0))
    // SpawnIn: 親の次のspawn 1回のスロットの大きさのフラグを読んで消す（入場でshedしても消す — rt.netop 6）。
    // コピーしたスロットのVAがVA_SHEDを越えていれば入場の前にshed（va_exhaustedの死の代わり）
    mut mk := -1
    // エリアのフラグ（rt.netop 10 — 親のTC_ONWのbit 2）を読んで消す（入場でshedしても消す）。M:Nのときだけ効かせる（area.sober）
    mut mark := -1
    if st.areaOn && inPool {
        pw := load(mut st, parT, TC_ONW)
        store(mut st, parT, TC_ONW, bin(mut st, BAnd, pw, iconst(mut st, 3)))
        mark = bin(mut st, BAnd, bin(mut st, BAnd, bin(mut st, BSar, pw, iconst(mut st, 2)), iconst(mut st, 1)), mnOn(mut st))
    }
    if inPool {
        mk = load(mut st, parT, TC_NSLOT)
        store(mut st, parT, TC_NSLOT, iconst(mut st, 0))
        mnv := globaladdr(mut st, st.mnG)
        bVaOk := newBlock(mut st)
        bVaShed := newBlock(mut st)
        condbr(mut st, cmp(mut st, CGt, load(mut st, mnv, MN_SLOTVA), iconst(mut st, VA_SHED)), bVaShed, -1, bVaOk, -1)
        setCur(mut st, bVaShed)
        atomicXadd(mut st, mnv, MN_LSHED, iconst(mut st, 1))
        atomicXadd(mut st, itop(mut st, 2), PL_SHED, iconst(mut st, 1))
        ret(mut st, itop(mut st, iconst(mut st, 0)))
        setCur(mut st, bVaOk)
    }
    // 入場（段階6 P5-3 admit.sober — 実引数 = [spawnの点 × 4 + 根だけ × 2 + give（0 = 計上しない〔走らせ直し・ワーカーの起動のチャンク〕）, 宣言の上界（0 = 無し）]。
    // 根だけ = 外の scope の札へ内の budget: の scope の中から spawn する形〔節の寿命が子より短い〕）: 入場できなければ 0（縮退 / shed）
    adm := admitIn(mut st, 0, 1, if inPool { 2 } else { -1 })
    bGot := newBlock(mut st)
    got := param(mut st, bGot, TyPtr)
    tk := globaladdr(mut st, st.taskG)
    // フラグつきのspawnは所有エリアが自分でないチャンクのチェーンから先に引く
    if st.areaOn && inPool {
        bA := newBlock(mut st)
        bN := newBlock(mut st)
        condbr(mut st, cmp(mut st, CNe, mark, iconst(mut st, 0)), bA, -1, bN, -1)
        setCur(mut st, bA)
        fa := load(mut st, tk, TK_FREEA)
        bAr := newBlock(mut st)
        bAs := newBlock(mut st)
        condbr(mut st, cmp(mut st, CNe, fa, iconst(mut st, 0)), bAr, -1, bAs, -1)
        setCur(mut st, bAr)
        store(mut st, tk, TK_FREEA, load(mut st, itop(mut st, fa), TC_NEXT))
        br(mut st, bGot, list1(mut st, itop(mut st, fa)))
        setCur(mut st, bAs)
        ha := mnTcbReserveAt(mut st, TK_FREEA, MN_RTCBA)
        bAh := newBlock(mut st)
        condbr(mut st, cmp(mut st, CNe, ha, iconst(mut st, 0)), bAh, -1, bN, -1)
        setCur(mut st, bAh)
        br(mut st, bGot, list1(mut st, itop(mut st, ha)))
        setCur(mut st, bN)
    }
    f := load(mut st, tk, TK_FREE)
    reuse := newBlock(mut st)
    fresh := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, f, iconst(mut st, 0)), reuse, -1, fresh, -1)
    setCur(mut st, reuse)
    fp := itop(mut st, f)
    store(mut st, tk, TK_FREE, load(mut st, fp, TC_NEXT))
    br(mut st, bGot, list1(mut st, fp))
    setCur(mut st, fresh)
    // M:N: 共有の予備のチャンクを先に（手元が尽きた — 他のワーカーで終わったチャンクが予備へ回る）
    bRes := newBlock(mut st)
    bMap := newBlock(mut st)
    condbr(mut st, mnOn(mut st), bRes, -1, bMap, -1)
    setCur(mut st, bRes)
    h := mnTcbReserve(mut st)
    bHit := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, h, iconst(mut st, 0)), bHit, -1, bMap, -1)
    setCur(mut st, bHit)
    br(mut st, bGot, list1(mut st, itop(mut st, h)))
    setCur(mut st, bMap)
    // 並び（頭の注記）: TCB は スタックの終わり + 2 KiB（ページの途中）・そのページの下半分がスタックの頂上。TC_END × 8はTCBのページの残りとTASK_HEADに収まる
    size := TASK_GUARD + TASK_STACK + 4096 + TASK_HEAD
    tcbOff := TASK_GUARD + TASK_STACK + TCB_TOP_ROOM
    args := listN(mut st, 7)
    desugar.HeapSet(mut st.d, args + 1, iconst(mut st, 9))
    desugar.HeapSet(mut st.d, args + 2, iconst(mut st, 0))
    desugar.HeapSet(mut st.d, args + 3, iconst(mut st, size))
    desugar.HeapSet(mut st.d, args + 4, iconst(mut st, 3))
    desugar.HeapSet(mut st.d, args + 5, iconst(mut st, 16418))
    desugar.HeapSet(mut st.d, args + 6, iconst(mut st, -1))
    desugar.HeapSet(mut st.d, args + 7, iconst(mut st, 0))
    b := syscall(mut st, args)
    bad := newBlock(mut st)
    ok := newBlock(mut st)
    condbr(mut st, cmp(mut st, CUge, b, iconst(mut st, -4095)), bad, -1, ok, -1)
    setCur(mut st, bad)
    memPanic(mut st, PM_VA)
    setCur(mut st, ok)
    // mprotect(チャンクの先頭, TASK_GUARD, PROT_NONE)（失敗 = 写像の数の上限vm.max_map_count — ガードなしで走らせずva_exhaustedで死ぬ）
    pr := syscall(mut st, list4(mut st, iconst(mut st, 10), b, iconst(mut st, TASK_GUARD), iconst(mut st, 0)))
    bBadP := newBlock(mut st)
    okP := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, pr, iconst(mut st, 0)), bBadP, -1, okP, -1)
    setCur(mut st, bBadP)
    memPanic(mut st, PM_VA)
    setCur(mut st, okP)
    bp := itop(mut st, bin(mut st, BAdd, b, iconst(mut st, tcbOff)))
    // 計測のカウンタ: 新しいチャンクの数（共有の予備・手元のチェーンの取りこぼしは入力に比例して増える — 検査）
    atomicXadd(mut st, globaladdr(mut st, st.pstatG), PS_TCBMAP, iconst(mut st, 1))
    // ミュータント47 = スタックの頂上を1 KiB下げる（パスが1 KiB深くなったのと同じ — stackcheckが捕まえる）
    store(mut st, bp, TC_TOP, bin(mut st, BSub, ptoi(mut st, bp), iconst(mut st, if st.rtMut == 47 { 1024 } else { 0 })))
    store(mut st, bp, TC_ENTRY, funcaddr(mut st, st.rtTaskStart))
    if st.areaOn {
        store(mut st, bp, TC_AREA, bin(mut st, BSub, ptoi(mut st, bp), iconst(mut st, TCB_TOP_ROOM)))
    }
    br(mut st, bGot, list1(mut st, bp))
    setCur(mut st, bGot)
    store(mut st, got, TC_ADM, adm.e)
    if st.areaOn {
        store(mut st, got, TC_ONW, if mark >= 0 { mark } else { iconst(mut st, 0) })
    }
    if winArm(mut st) {
        // 予約ページにしないフラグ（WSP_NOWIN — リクエストごとのregionの深度）はチャンクに残す: 予約ページのページを返すmadviseはチャンクごとに初回の1回だけになる
        // （接続ごとに返すとM:NでTLBの撃ち落とし — 下のslotReleaseのW_MADVと同じ規律）。ミュータント46 = 残さない（接続ごとに返す — wincheckの回数の照合が捕まえる）
        keep := if st.rtMut == 46 { 0 } else { 4611756388245323776 }
        store(mut st, got, TC_WSP, bin(mut st, BAnd, load(mut st, got, TC_WSP), iconst(mut st, keep)))
        if st.areaOn {
            store(mut st, got, TC_WANCH, bin(mut st, BAdd, ptoi(mut st, got), iconst(mut st, WIN_OFF + WIN_SZ)))
        }
    }
    store(mut st, got, TC_NODE, adm.node)
    store(mut st, got, TC_CNODE, adm.node)
    store(mut st, got, TC_DECL, 1)
    store(mut st, got, TC_SITE, bin(mut st, BSar, 0, iconst(mut st, 2)))
    // 待ちの上限D（TC_MAXW）: フラグ（net.ServeのmaxWait: — rt.netop 7）があればそれ・無ければ親から継ぐ
    pmw := load(mut st, itop(mut st, load(mut st, globaladdr(mut st, st.taskG), TK_CUR)), TC_MAXW)
    store(mut st, got, TC_MAXW, bin(mut st, BAdd, pmw, bin(mut st, BMul, cmp(mut st, CNe, mw, iconst(mut st, 0)), bin(mut st, BSub, mw, pmw))))
    // 未着手の子の上限は親から継ぐ
    store(mut st, got, TC_BACKLOG, load(mut st, itop(mut st, load(mut st, globaladdr(mut st, st.taskG), TK_CUR)), TC_BACKLOG))
    if inPool {
        store(mut st, got, TC_NSLOT, iconst(mut st, 0))
        // フラグがあればmin(フラグ, 既定)（フラグはstdが2の冪・1 MiB以上に揃えて渡す — net.Serveのregion:）・無ければ宣言から
        bMk := newBlock(mut st)
        bNoMk := newBlock(mut st)
        bSz := newBlock(mut st)
        szv := param(mut st, bSz, TyI64)
        condbr(mut st, cmp(mut st, CNe, mk, iconst(mut st, 0)), bMk, -1, bNoMk, -1)
        setCur(mut st, bMk)
        br(mut st, bSz, list1(mut st, imin(mut st, mk, load(mut st, globaladdr(mut st, st.meta), W_SLOT_DEF))))
        setCur(mut st, bNoMk)
        br(mut st, bSz, list1(mut st, slotSizeFor(mut st, 1)))
        setCur(mut st, bSz)
        store(mut st, got, TC_SLOTSZ, szv)
    } else {
        store(mut st, got, TC_SLOTSZ, slotSizeFor(mut st, 1))
    }
    if awFn(st.rtD3) != 0 {
        store(mut st, got, TC_WAIT, iconst(mut st, 0))
    }
    if dlFn(st.rtD3) != 0 {
        // 期限は親（spawn する今の task）の実効の値を継ぐ（deadline.sober）
        store(mut st, got, TC_DL, load(mut st, itop(mut st, load(mut st, tk, TK_CUR)), TC_DL))
    }
    ret(mut st, got)
}

// 予備のフィールドの大きさ（名前つきプールを使うプログラムはフラグSLOT_SPSZ・使わないプログラムは既定 — フラグを読まない）
func spareSz(st mut St, sg int, meta int) int {
    return if st.poolOn { load(mut st, sg, SLOT_SPSZ) } else { load(mut st, meta, W_SLOT_DEF) }
}

// 深度 k で使った小さいスロット p（大きさ sz）をワーカーの深度ごとの列 r = k & DP_MASK へ積む（数 = 表 sg の SLOT_SMH + r・
// 基底 = rt.smslotsのr × SM_CAP + i — 大きさのフラグsmTagを下位のワードに足す）。列はスロットの外（スロットのページに書かない — チェーンのワードを
// スロットの先頭に書く形は、列を1度通ったスロットの先頭のページを全部常駐させてしまう）。満杯ならrt.sm_give（共有の列 — 越えたらmunmap）
func smallPush(st mut St, sg int, k int, p int, sz int) {
    r := bin(mut st, BAnd, k, iconst(mut st, DP_MASK))
    col := gepWord(mut st, sg, r)
    c := load(mut st, col, SLOT_SMH)
    tag := smTag(mut st, sz)
    bPut := newBlock(mut st)
    bGive := newBlock(mut st)
    bDone := newBlock(mut st)
    condbr(mut st, bin(mut st, BAnd, cmp(mut st, CLt, c, load(mut st, globaladdr(mut st, st.ssmG), SSM_CW)), cmp(mut st, CNe, tag, iconst(mut st, 0))), bPut, -1, bGive, -1)
    setCur(mut st, bPut)
    store(mut st, gepWord(mut st, globaladdr(mut st, st.smG), bin(mut st, BAdd, bin(mut st, BMul, r, iconst(mut st, SM_CAP)), c)), 0, bin(mut st, BAdd, p, tag))
    store(mut st, col, SLOT_SMH, bin(mut st, BAdd, c, iconst(mut st, 1)))
    br(mut st, bDone, -1)
    setCur(mut st, bGive)
    call(mut st, st.rtSmGive, list3(mut st, p, sz, r))
    br(mut st, bDone, -1)
    setCur(mut st, bDone)
}

// 小さいスロットの大きさszのフラグ（sz ÷ 1 MiBの下位12ビット — 基底はページに揃うので下位12ビットに足せる。szは1 MiB以上の2の冪なので
// 4 GiB 未満なら 0 でない。0 = 列に積まない〔rt.sm_give が munmap〕）
func smTag(st mut St, sz int) int {
    return bin(mut st, BAnd, bin(mut st, BSar, sz, iconst(mut st, 20)), iconst(mut st, SM_TAGM))
}

// 小さいスロットの列の宣言（名前つきプールを使うプログラムだけ — needPoolRt から）
func needSmallRt(st mut St) {
    st.smG = addWorkerGlobal(mut st, int(strLit(mut st, "rt.smslots")), (DP_MASK + 1) * SM_CAP)
    st.ssmG = addGlobalInit(mut st, int(strLit(mut st, "rt.ssm")), SSM_CW + 1, -1)
    st.rtSmGive = addFunc(mut st, int(strLit(mut st, "rt.sm_give")), desugar.ListRef(list3(mut st, TyI64, TyI64, TyI64)), -1)
    st.rtSmTake = addFunc(mut st, int(strLit(mut st, "rt.sm_take")), desugar.ListRef(list3(mut st, TyI64, TyI64, TyI64)), TyI64)
    if !st.winOn {
        return
    }
    st.winG = addGlobalInit(mut st, int(strLit(mut st, "rt.win")), 1, -1)
    st.rtWinSpill = addFunc(mut st, int(strLit(mut st, "rt.win_spill")), desugar.ListRef(list1(mut st, TyI64)), TyI64)
    st.rtWinRalloc = addFunc(mut st, int(strLit(mut st, "rt.win_ralloc")), desugar.ListRef(list3(mut st, TyI64, TyI64, TyI64)), TyPtr)
    st.rtWinPark = addFunc(mut st, int(strLit(mut st, "rt.win_park")), desugar.ListRef(list2(mut st, TyI64, TyI64)), -1)
    st.rtWinCol = addFunc(mut st, int(strLit(mut st, "rt.win_col")), desugar.ListRef(list3(mut st, TyI64, TyI64, TyI64)), -1)
    st.rtWinStart = addFunc(mut st, int(strLit(mut st, "rt.win_start")), desugar.ListRef(list1(mut st, TyI64)), TyI64)
    st.rtWinIs = addFunc(mut st, int(strLit(mut st, "rt.win_is")), desugar.ListRef(list1(mut st, TyI64)), TyI64)
}

// rt.sm_give(p, sz, r): 手元の列 r が満杯（上限 SSM_CW）のときの返し — 列の下半分（古い側 c / 2 本）と p（大きさ sz）を共有の列 r へまとめて移し
// （鍵SSM_L — 既定のスロットの鍵MN_RLOCKとは別・全列の和がSSM_CAP本まで）、手元の残りを下へ詰める。1本ずつ移す形は鍵の往復がリクエストの頻度に
// 乗り、keep-alive 4096でcycles +20%。共有も満杯かフラグが0ならpをmunmap（既定のスロットの切り出しは既定のプールへ返さないので、
// 切り出しの 1 本だけを返してよい）。上限が未設定（0 — 最初の呼び出し）なら決めてから、手元に空きがあれば積んで返る
func buildSmGive(st mut St) {
    begin(mut st, st.rtSmGive)
    zero := iconst(mut st, 0)
    one := iconst(mut st, 1)
    sm := globaladdr(mut st, st.ssmG)
    smg := globaladdr(mut st, st.smG)
    sg := globaladdr(mut st, st.slotsG)
    tag := smTag(mut st, 1)
    // 上限（SSM_CWの注記 — 同じ値を書くので競合は無害）
    bInit := newBlock(mut st)
    bGo := newBlock(mut st)
    cw := param(mut st, bGo, TyI64)
    cw0 := load(mut st, sm, SSM_CW)
    condbr(mut st, cmp(mut st, CEq, cw0, zero), bInit, -1, bGo, list1(mut st, cw0))
    setCur(mut st, bInit)
    nw := imax(mut st, load(mut st, globaladdr(mut st, st.mnG), MN_N), one)
    cv := imin(mut st, imax(mut st, bin(mut st, BDiv, iconst(mut st, SM_TOT), nw), iconst(mut st, SM_MIN)), iconst(mut st, SM_CAP))
    store(mut st, sm, SSM_CW, cv)
    br(mut st, bGo, list1(mut st, cv))
    setCur(mut st, bGo)
    col := gepWord(mut st, sg, 2)
    c := load(mut st, col, SLOT_SMH)
    lb := bin(mut st, BMul, 2, iconst(mut st, SM_CAP))
    bLocal := newBlock(mut st)
    bOver := newBlock(mut st)
    condbr(mut st, bin(mut st, BAnd, cmp(mut st, CLt, c, cw), cmp(mut st, CNe, tag, zero)), bLocal, -1, bOver, -1)
    setCur(mut st, bLocal)
    store(mut st, gepWord(mut st, smg, bin(mut st, BAdd, lb, c)), 0, bin(mut st, BAdd, 0, tag))
    store(mut st, col, SLOT_SMH, bin(mut st, BAdd, c, one))
    ret(mut st, -1)
    setCur(mut st, bOver)
    hh := bin(mut st, BSar, c, one)
    bLk := newBlock(mut st)
    bPut := newBlock(mut st)
    bFull := newBlock(mut st)
    bDrop := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, tag, zero), bLk, -1, bDrop, -1)
    setCur(mut st, bLk)
    spinLock(mut st, sm, SSM_L)
    tot := load(mut st, sm, 0)
    condbr(mut st, cmp(mut st, CLe, bin(mut st, BAdd, tot, bin(mut st, BAdd, hh, one)), iconst(mut st, SSM_CAP)), bPut, -1, bFull, -1)
    setCur(mut st, bPut)
    np := gepWord(mut st, sm, bin(mut st, BAdd, 2, one))
    n := load(mut st, np, 0)
    eb := bin(mut st, BAdd, bin(mut st, BAdd, bin(mut st, BMul, 2, iconst(mut st, SSM_CAP)), n), iconst(mut st, SSM_S))
    // 手元の列 r の [0, H) を共有の列 r の末尾へ
    ml := newBlock(mut st)
    mi := param(mut st, ml, TyI64)
    mb := newBlock(mut st)
    md := newBlock(mut st)
    br(mut st, ml, list1(mut st, zero))
    setCur(mut st, ml)
    condbr(mut st, cmp(mut st, CLt, mi, hh), mb, -1, md, -1)
    setCur(mut st, mb)
    store(mut st, gepWord(mut st, sm, bin(mut st, BAdd, eb, mi)), 0, load(mut st, gepWord(mut st, smg, bin(mut st, BAdd, lb, mi)), 0))
    br(mut st, ml, list1(mut st, bin(mut st, BAdd, mi, one)))
    setCur(mut st, md)
    store(mut st, gepWord(mut st, sm, bin(mut st, BAdd, eb, hh)), 0, bin(mut st, BAdd, 0, tag))
    store(mut st, np, 0, bin(mut st, BAdd, n, bin(mut st, BAdd, hh, one)))
    store(mut st, sm, 0, bin(mut st, BAdd, tot, bin(mut st, BAdd, hh, one)))
    store(mut st, sm, SSM_L, zero)
    // 手元の残り [H, c) を [0, c − H) へ詰める（手元は持ち主だけが触る — 鍵の外）
    rest := bin(mut st, BSub, c, hh)
    sl := newBlock(mut st)
    si := param(mut st, sl, TyI64)
    sb := newBlock(mut st)
    sd := newBlock(mut st)
    br(mut st, sl, list1(mut st, zero))
    setCur(mut st, sl)
    condbr(mut st, cmp(mut st, CLt, si, rest), sb, -1, sd, -1)
    setCur(mut st, sb)
    store(mut st, gepWord(mut st, smg, bin(mut st, BAdd, lb, si)), 0, load(mut st, gepWord(mut st, smg, bin(mut st, BAdd, bin(mut st, BAdd, lb, si), hh)), 0))
    br(mut st, sl, list1(mut st, bin(mut st, BAdd, si, one)))
    setCur(mut st, sd)
    store(mut st, col, SLOT_SMH, rest)
    ret(mut st, -1)
    setCur(mut st, bFull)
    store(mut st, sm, SSM_L, zero)
    br(mut st, bDrop, -1)
    setCur(mut st, bDrop)
    syscall(mut st, list3(mut st, iconst(mut st, 11), 0, 1))
    slotVaAdd(mut st, bin(mut st, BSub, iconst(mut st, 0), 1))
    ret(mut st, -1)
}

// rt.sm_take(r, tag, c) i64: 手元の列r（数c）に合う小さいスロットが無いときの取り — 共有の列rの末尾がフラグtagなら1本を返し
// （基底 — フラグを引いた値）、手元が空（c = 0）なら続く同じフラグの分をSM_CAP − 1本まで手元へ移す（鍵を取る回数を減らす）。無ければ0（呼び手は切り出し）
func buildSmTake(st mut St) {
    begin(mut st, st.rtSmTake)
    zero := iconst(mut st, 0)
    one := iconst(mut st, 1)
    sm := globaladdr(mut st, st.ssmG)
    smg := globaladdr(mut st, st.smG)
    sg := globaladdr(mut st, st.slotsG)
    np := gepWord(mut st, sm, bin(mut st, BAdd, 0, one))
    bNone := newBlock(mut st)
    bLk := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, load(mut st, np, 0), zero), bLk, -1, bNone, -1)
    setCur(mut st, bNone)
    ret(mut st, zero)
    setCur(mut st, bLk)
    spinLock(mut st, sm, SSM_L)
    n := load(mut st, np, 0)
    eb := bin(mut st, BAdd, bin(mut st, BMul, 0, iconst(mut st, SSM_CAP)), iconst(mut st, SSM_S))
    bMiss := newBlock(mut st)
    bChk := newBlock(mut st)
    bHit := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, n, zero), bChk, -1, bMiss, -1)
    setCur(mut st, bChk)
    tv := load(mut st, gepWord(mut st, sm, bin(mut st, BAdd, eb, bin(mut st, BSub, n, one))), 0)
    condbr(mut st, cmp(mut st, CEq, bin(mut st, BAnd, tv, iconst(mut st, SM_TAGM)), 1), bHit, -1, bMiss, -1)
    setCur(mut st, bMiss)
    store(mut st, sm, SSM_L, zero)
    ret(mut st, zero)
    setCur(mut st, bHit)
    // 移す本数の上限lim = 手元が空ならmin(n, 上限SSM_CW) − 1・空でなければ0。同じフラグの間だけ移す（上限は共有の列に積んだsm_giveが決め済み）
    mcap := imin(mut st, n, load(mut st, sm, SSM_CW))
    lim := bin(mut st, BMul, cmp(mut st, CEq, 2, zero), bin(mut st, BSub, mcap, one))
    lb := bin(mut st, BMul, 0, iconst(mut st, SM_CAP))
    ml := newBlock(mut st)
    mi := param(mut st, ml, TyI64)
    mb := newBlock(mut st)
    mb2 := newBlock(mut st)
    md := newBlock(mut st)
    mdn := param(mut st, md, TyI64)
    br(mut st, ml, list1(mut st, zero))
    setCur(mut st, ml)
    condbr(mut st, cmp(mut st, CLt, mi, lim), mb, -1, md, list1(mut st, mi))
    setCur(mut st, mb)
    x := load(mut st, gepWord(mut st, sm, bin(mut st, BAdd, eb, bin(mut st, BSub, bin(mut st, BSub, n, iconst(mut st, 2)), mi))), 0)
    condbr(mut st, cmp(mut st, CEq, bin(mut st, BAnd, x, iconst(mut st, SM_TAGM)), 1), mb2, -1, md, list1(mut st, mi))
    setCur(mut st, mb2)
    store(mut st, gepWord(mut st, smg, bin(mut st, BAdd, lb, mi)), 0, x)
    br(mut st, ml, list1(mut st, bin(mut st, BAdd, mi, one)))
    setCur(mut st, md)
    // 手元の数 = 移した本数（手元は空だった — 空でなければ移していない）・共有の列から 1 + 移した本数を引く
    bSet := newBlock(mut st)
    bSet2 := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, mdn, zero), bSet, -1, bSet2, -1)
    setCur(mut st, bSet)
    store(mut st, gepWord(mut st, sg, 0), SLOT_SMH, mdn)
    br(mut st, bSet2, -1)
    setCur(mut st, bSet2)
    took := bin(mut st, BAdd, mdn, one)
    store(mut st, np, 0, bin(mut st, BSub, n, took))
    store(mut st, sm, 0, bin(mut st, BSub, load(mut st, sm, 0), took))
    store(mut st, sm, SSM_L, zero)
    ret(mut st, bin(mut st, BSub, tv, 1))
}

// 終わるtaskの自前の深度kのスロット（フィールドs・使った量used）の返しの分け: 既定の大きさ → bDef・既定より大きい → bBig・
// 小さい → 先頭からW_MADVを超えて使ったページを返してワーカーの小さいスロットのチェーンへ積みnext。名前つきプールを使わないプログラムは小さいスロットが無い
func smallRel(st mut St, meta int, k int, s int, used int, sz int, bBig BlkRef, bDef BlkRef, next BlkRef, tcb int) {
    def := load(mut st, meta, W_SLOT_DEF)
    if !st.poolOn {
        condbr(mut st, cmp(mut st, CNe, sz, def), bBig, -1, bDef, -1)
        return
    }
    keepB := load(mut st, meta, W_MADV)
    bNd := newBlock(mut st)
    bSm := newBlock(mut st)
    bAdv := newBlock(mut st)
    bPut := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, sz, def), bDef, -1, bNd, -1)
    setCur(mut st, bNd)
    condbr(mut st, cmp(mut st, CGt, sz, def), bBig, -1, bSm, -1)
    setCur(mut st, bSm)
    // 予約ページ（移す前）はチャンクの一部 — 返さない。予約ページから移したスロットは普通のスロット
    bSmW := newBlock(mut st)
    tcbI := ptoi(mut st, tcb)
    if winArm(mut st) {
        condbr(mut st, isWinT(mut st, meta, s, tcbI), next, -1, bSmW, -1)
    } else {
        br(mut st, bSmW, -1)
    }
    setCur(mut st, bSmW)
    rs := s
    ru := used
    condbr(mut st, cmp(mut st, CGt, ru, keepB), bAdv, -1, bPut, -1)
    setCur(mut st, bAdv)
    if st.rtMut != 5 {
        syscall(mut st, list4(mut st, iconst(mut st, 28), bin(mut st, BAdd, rs, keepB), bin(mut st, BSub, ru, keepB), iconst(mut st, 4)))
    }
    br(mut st, bPut, -1)
    setCur(mut st, bPut)
    smallPush(mut st, globaladdr(mut st, st.slotsG), k, rs, sz)
    br(mut st, next, -1)
}

// コピーしたスロットのVAのカウンタ（MN_SLOTVA — 名前つきプールを使うプログラムだけ・SpawnInの入場のVA_SHEDが読む）にdeltaバイトを足す
func slotVaAdd(st mut St, delta int) {
    if st.poolOn {
        atomicXadd(mut st, globaladdr(mut st, st.mnG), MN_SLOTVA, delta)
    }
}

// 宣言の上界 decl（バイト — 0 = 無し）の子のスロットの大きさ: 既定 W_SLOT_DEF・decl が既定を超えれば decl 以上の 2 の冪（上限 MAX_SLOT_MB）
func slotSizeFor(st mut St, decl int) int {
    def := load(mut st, globaladdr(mut st, st.meta), W_SLOT_DEF)
    bUp := newBlock(mut st)
    loop := newBlock(mut st)
    s := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    done := newBlock(mut st)
    sz := param(mut st, done, TyI64)
    condbr(mut st, cmp(mut st, CGt, decl, def), bUp, -1, done, list1(mut st, def))
    setCur(mut st, bUp)
    br(mut st, loop, list1(mut st, def))
    setCur(mut st, loop)
    condbr(mut st, bin(mut st, BAnd, cmp(mut st, CLt, s, decl), cmp(mut st, CLt, s, iconst(mut st, MAX_SLOT_MB * 1048576))), body, -1, done, list1(mut st, s))
    setCur(mut st, body)
    br(mut st, loop, list1(mut st, bin(mut st, BShl, s, iconst(mut st, 1))))
    setCur(mut st, done)
    return sz
}

// rt.task_go(me, tcb)（spawn の切替点）: 選択 0 = 子を先に（親 me を積んで子へ切り替える — 既定）・1 = 親を先に（子を積むだけ）
func buildTaskGo(st mut St) {
    begin(mut st, st.rtTaskGo)
    pstatCall(mut st, st.rtPstatSpawn, list0(mut st))
    frRec(mut st, FK_SPAWN, ptoi(mut st, 1), ptoi(mut st, 0))
    // M:N（ワーカー2以上 — 段階6 P4-4）: help-firstの別のパス
    bMn := newBlock(mut st)
    bCo := newBlock(mut st)
    condbr(mut st, mnOn(mut st), bMn, -1, bCo, -1)
    setCur(mut st, bMn)
    call(mut st, st.rtTaskGoMn, list2(mut st, 0, 1))
    ret(mut st, -1)
    setCur(mut st, bCo)
    // 出力の区間（P4-2 (O1)）: 子の区間を親の区間の直後へ — 切替の選択に依らず先に
    outFork(mut st, 0, 1)
    c := schedPickFast(mut st, iconst(mut st, 2))
    kid := newBlock(mut st)
    parB := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, c, iconst(mut st, 0)), kid, -1, parB, -1)
    setCur(mut st, kid)
    taskWake(mut st, 0)
    parkRelease(mut st, 0, false, false)
    call(mut st, st.rtTaskSwitch, list2(mut st, 0, 1))
    ret(mut st, -1)
    setCur(mut st, parB)
    taskWake(mut st, 1)
    ret(mut st, -1)
}

// rt.task_switch(from, to): 引き継いでtoを再開する（まだ走っていなければtoのチャンクのスタックでrt.task_start(to) を始める。
// from へ切り替えて戻ってきたら返る）
func buildTaskSwitch(st mut St) {
    begin(mut st, st.rtTaskSwitch)
    shal := st.areaOn && st.rtShLand != -1
    mut save := 0
    if shal {
        save = areaPark(mut st, 0)
    } else if st.areaOn {
        areaSwap(mut st, 0)
    }
    taskHandover(mut st, 0, 1)
    fresh := newBlock(mut st)
    resume := newBlock(mut st)
    done := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, load(mut st, 1, TC_STARTED), iconst(mut st, 0)), fresh, -1, resume, -1)
    setCur(mut st, fresh)
    store(mut st, 1, TC_STARTED, iconst(mut st, 1))
    tstart(mut st, save, itop(mut st, load(mut st, 1, TC_TOP)), load(mut st, 1, TC_ENTRY), ptoi(mut st, 1))
    br(mut st, done, -1)
    setCur(mut st, resume)
    if shal {
        // 浅くスリープしていたto: ワーカーのエリアの頂上でrt.shallow_land(to) を始める（本体の戻り先へ跳んで戻らない）
        bL := newBlock(mut st)
        bT := newBlock(mut st)
        condbr(mut st, cmp(mut st, CNe, bin(mut st, BAnd, load(mut st, 1, TC_ONW), iconst(mut st, AREA_SPARK)), iconst(mut st, 0)), bL, -1, bT, -1)
        setCur(mut st, bL)
        tstart(mut st, save, itop(mut st, load(mut st, globaladdr(mut st, st.wkG), WK_AREA)), funcaddr(mut st, st.rtShLand), ptoi(mut st, 1))
        br(mut st, done, -1)
        setCur(mut st, bT)
    }
    tswitch(mut st, save, 1)
    br(mut st, done, -1)
    setCur(mut st, done)
    ret(mut st, -1)
}

// SOBER_SCHED（数の列）と SOBER_SCHED_TRACE を @rt.sched へ（入口 — sp = 初期 rsp）
func schedInit(st mut St, sp int) {
    sg := globaladdr(mut st, st.schedG)
    store(mut st, sg, 2, envMb(mut st, sp, "SOBER_SCHED_TRACE=", 0, true))
    // SOBER_SCHED_SEED（schedfuzz）: 列が尽きた後の選択を乱択に（xorshiftの状態 = シード。0 = 使わない — 既定のまま）
    store(mut st, sg, SCHED_SEED, envMb(mut st, sp, "SOBER_SCHED_SEED=", 0, false))
    argc := load(mut st, sp, 0)
    envp := gepWord(mut st, sp, bin(mut st, BAdd, argc, iconst(mut st, 2)))
    scan := newBlock(mut st)
    e := param(mut st, scan, TyPtr)
    chk := newBlock(mut st)
    next := newBlock(mut st)
    got := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, scan, list1(mut st, envp))
    setCur(mut st, scan)
    sv := load(mut st, e, 0)
    condbr(mut st, cmp(mut st, CEq, sv, iconst(mut st, 0)), done, -1, chk, -1)
    setCur(mut st, chk)
    s := itop(mut st, sv)
    key := bytes("SOBER_SCHED=")
    for i <- iter.Range(0, len(key)) {
        okc := newBlock(mut st)
        condbr(mut st, cmp(mut st, CEq, load8(mut st, gepByte(mut st, s, iconst(mut st, i)), 0), iconst(mut st, int(key[i]))), okc, -1, next, -1)
        setCur(mut st, okc)
    }
    br(mut st, got, -1)
    setCur(mut st, next)
    br(mut st, scan, list1(mut st, gepWord(mut st, e, iconst(mut st, 1))))
    // 値の読み: 数字は今の数に足し込み・それ以外（`,`）で区切り・NUL で終わり（列の長さ = 区切った数）
    setCur(mut st, got)
    lp := newBlock(mut st)
    iv := param(mut st, lp, TyI64)
    nv := param(mut st, lp, TyI64)
    cntv := param(mut st, lp, TyI64)
    br(mut st, lp, list3(mut st, iconst(mut st, len(key)), iconst(mut st, 0), iconst(mut st, 0)))
    setCur(mut st, lp)
    ch := load8(mut st, gepByte(mut st, s, iv), 0)
    isEnd := newBlock(mut st)
    notEnd := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, ch, iconst(mut st, 0)), isEnd, -1, notEnd, -1)
    setCur(mut st, isEnd)
    full := newBlock(mut st)
    stEnd := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, cntv, iconst(mut st, SCHED_CAP)), stEnd, -1, full, -1)
    setCur(mut st, stEnd)
    store(mut st, gepWord(mut st, sg, cntv), 3, nv)
    store(mut st, sg, 0, bin(mut st, BAdd, cntv, iconst(mut st, 1)))
    br(mut st, done, -1)
    setCur(mut st, full)
    store(mut st, sg, 0, cntv)
    br(mut st, done, -1)
    setCur(mut st, notEnd)
    isDig := newBlock(mut st)
    isSep := newBlock(mut st)
    condbr(mut st, bin(mut st, BAnd, cmp(mut st, CGe, ch, iconst(mut st, 48)), cmp(mut st, CLe, ch, iconst(mut st, 57))), isDig, -1, isSep, -1)
    setCur(mut st, isDig)
    br(mut st, lp, list3(mut st, bin(mut st, BAdd, iv, iconst(mut st, 1)), bin(mut st, BAdd, bin(mut st, BMul, nv, iconst(mut st, 10)), bin(mut st, BSub, ch, iconst(mut st, 48))), cntv))
    setCur(mut st, isSep)
    sepOk := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, cntv, iconst(mut st, SCHED_CAP)), sepOk, -1, done, -1)
    setCur(mut st, sepOk)
    store(mut st, gepWord(mut st, sg, cntv), 3, nv)
    br(mut st, lp, list3(mut st, bin(mut st, BAdd, iv, iconst(mut st, 1)), iconst(mut st, 0), bin(mut st, BAdd, cntv, iconst(mut st, 1))))
    setCur(mut st, done)
    // 選択の器を使うか（列がある・trace・シード）
    act := bin(mut st, BOr, bin(mut st, BOr, cmp(mut st, CGt, load(mut st, sg, 0), iconst(mut st, 0)), cmp(mut st, CNe, load(mut st, sg, 2), iconst(mut st, 0))), cmp(mut st, CNe, load(mut st, sg, SCHED_SEED), iconst(mut st, 0)))
    store(mut st, sg, SCHED_ACT, act)
}

// 切替点の選択（選択の器を使わなければ rt.sched_pick を呼ばずに 0）
func schedPickFast(st mut St, n int) int {
    bCall := newBlock(mut st)
    bEnd := newBlock(mut st)
    v := param(mut st, bEnd, TyI64)
    condbr(mut st, cmp(mut st, CNe, load(mut st, globaladdr(mut st, st.schedG), SCHED_ACT), iconst(mut st, 0)), bCall, -1, bEnd, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, bCall)
    br(mut st, bEnd, list1(mut st, call(mut st, st.rtSchedPick, list1(mut st, n))))
    setCur(mut st, bEnd)
    return v
}

// rt.sched_pick(n): 選択肢 n（2 以上で切替点）の番号 — 列の次の値 mod n（尽きたら SOBER_SCHED_SEED の乱択か 0）。trace なら `#sched n v` を標準エラーへ
func buildSchedPick(st mut St) {
    begin(mut st, st.rtSchedPick)
    n := 0
    one := newBlock(mut st)
    many := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLe, n, iconst(mut st, 1)), one, -1, many, -1)
    setCur(mut st, one)
    ret(mut st, iconst(mut st, 0))
    setCur(mut st, many)
    sg := globaladdr(mut st, st.schedG)
    c := load(mut st, sg, 1)
    store(mut st, sg, 1, bin(mut st, BAdd, c, iconst(mut st, 1)))
    fromVec := newBlock(mut st)
    pick := newBlock(mut st)
    v := param(mut st, pick, TyI64)
    // 列が尽きたら: シードがあれば乱択（schedfuzz）、無ければ0（既定のスケジュール）
    afterVec := newBlock(mut st)
    rnd := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, c, load(mut st, sg, 0)), fromVec, -1, afterVec, -1)
    setCur(mut st, afterVec)
    seed := load(mut st, sg, SCHED_SEED)
    condbr(mut st, cmp(mut st, CEq, seed, iconst(mut st, 0)), pick, list1(mut st, iconst(mut st, 0)), rnd, -1)
    setCur(mut st, rnd)
    // xorshift64（13・7・17）の 1 歩
    x1 := bin(mut st, BXor, seed, bin(mut st, BShl, seed, iconst(mut st, 13)))
    x2 := bin(mut st, BXor, x1, bin(mut st, BAnd, bin(mut st, BSar, x1, iconst(mut st, 7)), iconst(mut st, 144115188075855871)))
    x3 := bin(mut st, BXor, x2, bin(mut st, BShl, x2, iconst(mut st, 17)))
    store(mut st, sg, SCHED_SEED, x3)
    // 遅延注入のインターフェース（出来事の点で0〜63回の空回し — ワーカー1では順を変えない。P4-4でM:Nの点へ同じインターフェースを置く）
    spinN := bin(mut st, BAnd, bin(mut st, BSar, x3, iconst(mut st, 20)), iconst(mut st, 63))
    sl := newBlock(mut st)
    si := param(mut st, sl, TyI64)
    sb := newBlock(mut st)
    sd := newBlock(mut st)
    br(mut st, sl, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, sl)
    condbr(mut st, cmp(mut st, CLt, si, spinN), sb, -1, sd, -1)
    setCur(mut st, sb)
    br(mut st, sl, list1(mut st, bin(mut st, BAdd, si, iconst(mut st, 1))))
    setCur(mut st, sd)
    br(mut st, pick, list1(mut st, bin(mut st, BRem, bin(mut st, BAnd, x3, iconst(mut st, 2147483647)), n)))
    setCur(mut st, fromVec)
    br(mut st, pick, list1(mut st, bin(mut st, BRem, load(mut st, gepWord(mut st, sg, c), 3), n)))
    setCur(mut st, pick)
    tr := newBlock(mut st)
    out := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, load(mut st, sg, 2), iconst(mut st, 0)), tr, -1, out, -1)
    setCur(mut st, tr)
    meta := globaladdr(mut st, st.meta)
    fd0 := load(mut st, meta, W_FD)
    call(mut st, st.rtFlush, list0(mut st))
    store(mut st, meta, W_FD, iconst(mut st, 2))
    printLit(mut st, "#sched ")
    call(mut st, st.rtPint, list1(mut st, n))
    call(mut st, st.rtPchar, list1(mut st, iconst(mut st, ' ')))
    call(mut st, st.rtPint, list1(mut st, v))
    call(mut st, st.rtPchar, list1(mut st, iconst(mut st, '\n')))
    call(mut st, st.rtFlush, list0(mut st))
    store(mut st, meta, W_FD, fd0)
    br(mut st, out, -1)
    setCur(mut st, out)
    ret(mut st, v)
}

// rt.task_pop() ptr: 走れるスタックから1つ外す（スタックの上からrt.sched_pick(長さ) 番目 — 既定は一番上）。空なら0
func buildTaskPop(st mut St) {
    begin(mut st, st.rtTaskPop)
    tk := globaladdr(mut st, st.taskG)
    nn := load(mut st, tk, TK_READY)
    // 選択の器を使わない（既定のスケジュール）: 一番上を外すだけ（段階6 P4-4）
    bAct := newBlock(mut st)
    bTop := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, load(mut st, globaladdr(mut st, st.schedG), SCHED_ACT), iconst(mut st, 0)), bAct, -1, bTop, -1)
    setCur(mut st, bTop)
    bNone := newBlock(mut st)
    bHead := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, nn, iconst(mut st, 0)), bNone, -1, bHead, -1)
    setCur(mut st, bNone)
    ret(mut st, itop(mut st, iconst(mut st, 0)))
    setCur(mut st, bHead)
    ret(mut st, itop(mut st, readyPopHead(mut st, tk)))
    setCur(mut st, bAct)
    empty := newBlock(mut st)
    some := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, nn, iconst(mut st, 0)), empty, -1, some, -1)
    setCur(mut st, empty)
    ret(mut st, itop(mut st, iconst(mut st, 0)))
    setCur(mut st, some)
    k := call(mut st, st.rtSchedPick, list1(mut st, nn))
    // k番目（上から — 0 = 頭）を外す（選択の器のパス = schedfuzzの試験だけ・O(n)）。環の中なら上の枠を1つずつ下へずらす・溢れの列の中ならチェーンから外す
    h := load(mut st, tk, TK_RQH)
    nr := bin(mut st, BSub, h, load(mut st, tk, TK_RQT))
    store(mut st, tk, TK_READY, bin(mut st, BSub, nn, iconst(mut st, 1)))
    bRing := newBlock(mut st)
    bSp := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, k, nr), bRing, -1, bSp, -1)
    setCur(mut st, bRing)
    at := bin(mut st, BSub, bin(mut st, BSub, h, iconst(mut st, 1)), k)
    got := load(mut st, rqSlot(mut st, tk, at), 0)
    sl := newBlock(mut st)
    j := param(mut st, sl, TyI64)
    sb := newBlock(mut st)
    sd := newBlock(mut st)
    br(mut st, sl, list1(mut st, at))
    setCur(mut st, sl)
    condbr(mut st, cmp(mut st, CLt, j, bin(mut st, BSub, h, iconst(mut st, 1))), sb, -1, sd, -1)
    setCur(mut st, sb)
    dst := rqSlot(mut st, tk, j)
    src := rqSlot(mut st, tk, bin(mut st, BAdd, j, iconst(mut st, 1)))
    store(mut st, dst, 0, load(mut st, src, 0))
    store(mut st, dst, 1, load(mut st, src, 1))
    br(mut st, sl, list1(mut st, bin(mut st, BAdd, j, iconst(mut st, 1))))
    setCur(mut st, sd)
    store(mut st, tk, TK_RQH, bin(mut st, BSub, h, iconst(mut st, 1)))
    ret(mut st, itop(mut st, got))
    // 溢れの列: 最新から TC_PREV で k − nr 歩
    setCur(mut st, bSp)
    wl := newBlock(mut st)
    q := param(mut st, wl, TyI64)
    i := param(mut st, wl, TyI64)
    wb := newBlock(mut st)
    found := newBlock(mut st)
    br(mut st, wl, list2(mut st, load(mut st, tk, TK_SPN), nr))
    setCur(mut st, wl)
    condbr(mut st, cmp(mut st, CEq, i, k), found, -1, wb, -1)
    setCur(mut st, wb)
    br(mut st, wl, list2(mut st, load(mut st, itop(mut st, q), TC_PREV), bin(mut st, BAdd, i, iconst(mut st, 1))))
    setCur(mut st, found)
    qp := itop(mut st, q)
    older := load(mut st, qp, TC_PREV)
    newer := load(mut st, qp, TC_NEXT)
    spillLink(mut st, tk, newer, TC_PREV, older, TK_SPN)
    spillLink(mut st, tk, older, TC_NEXT, newer, TK_SPO)
    ret(mut st, qp)
}

// x（0なら溢れの列の端のワードend）のチェーンのワードwにvを書く（溢れの列の中ほどから1本を外す — 選択の器のパス）
func spillLink(st mut St, tk int, x int, w int, v int, end int) {
    bZ := newBlock(mut st)
    bN := newBlock(mut st)
    bJ := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, x, iconst(mut st, 0)), bZ, -1, bN, -1)
    setCur(mut st, bZ)
    store(mut st, tk, end, v)
    br(mut st, bJ, -1)
    setCur(mut st, bN)
    store(mut st, itop(mut st, x), w, v)
    br(mut st, bJ, -1)
    setCur(mut st, bJ)
}

// rt.task_start(tcb): 罠を張って子を呼び、枠に状態（1 = 完了・2 = 死）と死因を書き、scope の記録の死の数を数え、
// チャンクをプールへ返してウェイクアップする側へ切り替える（戻らない — .llの経路だけは切替が無いので返る）
func buildTaskStart(st mut St) {
    begin(mut st, st.rtTaskStart)
    frame := itop(mut st, load(mut st, 0, TC_FRAME))
    r := trapCall(mut st, load(mut st, 0, TC_KID), fieldPtr(mut st, frame, FR_RES))
    if st.domUse {
        domDiedIn(mut st, 0)
    }
    frRec(mut st, FK_END, ptoi(mut st, 0), r)
    fdDrainCall(mut st)
    orphEnd(mut st, 0)
    // 枠の公開（release / acquireの型: 結果〔子がsretで書き済み〕→ 死因 → 状態の順に書き、読み手は状態から読む。ウェイクアップは公開の後）
    tg := globaladdr(mut st, st.trapG)
    cause := bin(mut st, BOr, bin(mut st, BShl, load(mut st, tg, TW_SITE), iconst(mut st, 8)), load(mut st, tg, TW_CODE))
    store(mut st, frame, FR_CAUSE, cause)
    // 切られた（段階6 P4-5）か死んだか: 罠へ戻ったか打ち切りのフラグが1度でも立ったプログラムだけ低速パス（rt.cut_end — 判定・後ろの兄弟のフラグ・開いているscopeの子を待つ）
    cut := cutEnd(mut st, 0, frame, r)
    dead := bin(mut st, BMul, r, bin(mut st, BSub, iconst(mut st, 1), cut))
    store(mut st, frame, FR_STATE, bin(mut st, BAdd, bin(mut st, BAdd, r, iconst(mut st, 1)), bin(mut st, BMul, cut, bin(mut st, BSub, iconst(mut st, 2), r))))
    rec := itop(mut st, load(mut st, frame, FR_SREC))
    // 死の数は生存数より先に（出口は生存数 0 を見てから死の数を読む）。死因は数えない — 出口が生んだ順に枠を歩く（到着順を捨てる）
    store(mut st, rec, SR_DEAD, bin(mut st, BAdd, load(mut st, rec, SR_DEAD), dead))
    poolDied(mut st, 0, dead)
    // 出力の区間を閉じる（頭ならバッファを出して進める）
    outClose(mut st, 0)
    // 入場で足した量を台帳へ返す（ウェイクアップしたscopeの出口より先に）
    admitReturn(mut st, 0)
    // 待っている親をウェイクアップする: Join / Tryで待つtask（枠のFR_JOINER）・scopeの出口で待つtask（生きている子が0になったら）
    jn := load(mut st, frame, FR_JOINER)
    bJ := newBlock(mut st)
    bJ2 := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, jn, iconst(mut st, 0)), bJ, -1, bJ2, -1)
    setCur(mut st, bJ)
    taskWake(mut st, itop(mut st, jn))
    store(mut st, frame, FR_JOINER, iconst(mut st, 0))
    br(mut st, bJ2, -1)
    setCur(mut st, bJ2)
    frameDrop(mut st, frame, rec, dead)
    // 生きている子の数を減らす（× 2の符号 — 結果が1 = 数0で出口が待っているフラグのときだけウェイクアップする: waitLive）
    live := bin(mut st, BSub, load(mut st, rec, SR_LIVE), iconst(mut st, 2))
    store(mut st, rec, SR_LIVE, live)
    bW := newBlock(mut st)
    bW2 := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, live, iconst(mut st, 1)), bW, -1, bW2, -1)
    setCur(mut st, bW)
    taskWake(mut st, itop(mut st, load(mut st, rec, SR_WAITER)))
    br(mut st, bW2, -1)
    setCur(mut st, bW2)
    pstatCall(mut st, st.rtPstatEnd, list1(mut st, 0))
    admitEnd(mut st, 0, slotRelease(mut st, 0))
    nx := taskNext(mut st)
    tk := globaladdr(mut st, st.taskG)
    store(mut st, 0, TC_NEXT, load(mut st, tk, TK_FREE))
    store(mut st, tk, TK_FREE, ptoi(mut st, 0))
    call(mut st, st.rtTaskSwitch, list2(mut st, 0, nx))
    ret(mut st, -1)
}
