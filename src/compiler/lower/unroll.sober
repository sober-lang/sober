package lower

// 定数上限のループの全展開（展開の便）: B1 の gvn / hdr の後に掛け（見積もりは重複の畳まれた大きさで）、展開した関数は
// gvn を掛け直して後段の bce / licm へ渡す（写しどうしの同じ定数の添字の検査が 1 つの値になり bce の ② が畳む）。
// 対象 = 利用者のループで、頭の終端が `condbr (lt X, U), 本体, 出口`（X は頭の仮引数・U は定数）・入りの X が定数・後ろの辺がちょうど 1 本で X + 1。
// 回数 T = U − 入り（≤ T_MAX）で、展開後の IR 命令が入れ子ごとに UR_BUDGET（2 × CUT_K — 展開の時点の IR での近似）以下（キャンセルの検査点の約束 — 2 つの検査の間の IR 命令 ≤ K — を
// 後ろの辺が消えた直線にもそのまま当てる）。頭は T + 1 回写し（仮引数は値の表で受け渡す — 回数が分かっているので各写しは br で繋ぐ）、
// 本体は T 回写す。出口のブロックは写さず共有し、ループの外の頭の値の使い道は最後の頭の写しの値に付け替える。
// 入れ子は外側から: 内側の入りが外側の X + k・上限が定数なら、外側の各回での内側の回数から入れ子全体の大きさを見積もり、予算内なら外側を展開して
// 定数を畳む（内側の入りが定数になり、次の回で内側が展開される）。2 段まで

import "std/iter"

const UR_TMAX = 16
// 展開の時点の IR での予算（2 × CUT_K — 決定 2026-10-09）: 展開の時点の IR は後段（bce・rtlower・併合・巻き上げ）で縮む
// （nbody の advance で 1,500 → 844 — 約 0.56 倍）ので、最終の直線が K 前後になる見積もり。近似が外れたら urCheckRuns が最終 IR で鳴る
const UR_BUDGET = 2048
// 呼び出しの重み: B1 の呼び出しは後段（rtlower の展開・インライン）で伸びる — 1 と数えると最終の直線が K を超えた（examples/par_chan_hold の
// 15 回の Recv / Send のループ — 最終 1,213 IR 命令。検証器の網が鳴った実例）
const UR_CALLW = 32

// unrollModule はモジュールの全関数に全展開を掛ける
func unrollModule(st mut St) {
    mut f := st.fhead
    while f != -1 {
        if irFnBHead(mut st, f) != -1 {
            unrollFunc(mut st, f)
        }
        f = irFnNext(mut st, f)
    }
}

// unrollFunc は関数 f の定数上限のループを全展開する（先に安い走査 — 利用者のループの頭に lt の比較がある関数だけ）
func unrollFunc(st mut St, f FnRef) {
    if !urCheap(mut st, f) {
        return
    }
    saved := st.fn
    st.fn = f
    mut round := 0
    while round < 32 && urRound(mut st, f) {
        round += 1
        recountPreds(mut st, f)
        optReset(mut st, irFnNVal(mut st, f), irFnNBlk(mut st, f))
        optBlocks(mut st, f)
        optReset(mut st, irFnNVal(mut st, f), irFnNBlk(mut st, f))
        optFold(mut st, f)
        optDce(mut st, f)
        optRenumber(mut st, f)
    }
    if round > 0 {
        gvnFunc(mut st, f)
    }
    st.fn = saved
}

// urCheap は利用者のループの頭の終端の条件が同じブロックの `lt x, c` で、c が入口のブロックか頭の中の定数（1〜T_MAX × 4）か
// （作業域を作らない走査 — 上限が len などの値のループの関数で CFG を組まない。自己 build の判定の費用 +0.10 G）
func urCheap(st mut St, f FnRef) bool {
    entry := irFnBHead(mut st, f)
    mut b := entry
    while b != -1 {
        if irBlkLoop(mut st, b) & 1 == 1 && irBlkTerm(mut st, b) == TmCondbr {
            c := irBlkX1(mut st, b)
            mut i := irBlkIHead(mut st, b)
            while i != -1 {
                if irInsRes(mut st, i) == c && irInsOp(mut st, i) == OpCmp && irInsA(mut st, i) == CLt && (urSmallConst(mut st, entry, irInsC(mut st, i)) || urSmallConst(mut st, b, irInsC(mut st, i))) {
                    return true
                }
                i = irInsNext(mut st, i)
            }
        }
        b = irBlkNext(mut st, b)
    }
    return false
}

// urSmallConst は値 v がブロック b の中の小さい正の定数か
func urSmallConst(st mut St, b BlkRef, v int) bool {
    mut i := irBlkIHead(mut st, b)
    while i != -1 {
        if irInsRes(mut st, i) == v {
            return irInsOp(mut st, i) == OpConst && irInsA(mut st, i) > 0 && irInsA(mut st, i) <= UR_TMAX * 4
        }
        i = irInsNext(mut st, i)
    }
    return false
}

// UrW は 1 回の作業域: 値 → 定義の命令・値 → 定義のブロック番号（関数の仮引数は入口 = 0）・ブロック → ループの印（外側 / 内側の 2 本）
type UrW struct {
    def mut []int
    dblk mut []int
    inl mut []int
    inr mut []int
    mark int
}

// UrL はループの形（頭・前置き・後ろの辺の前任・X の仮引数の位置・入り・上限）
type UrL struct {
    h int
    pre int
    latch int
    ix int
    c0 int
    u int
}

// urRound はループを 1 つ展開したら true（外側から — 逆後順の前から）
func urRound(st mut St, f FnRef) bool {
    nb := irFnNBlk(mut st, f)
    nv := irFnNVal(mut st, f)
    mut w := m2rW{nb: nb, blk: mut []int{}, rpoIx: mut []int{}, rpo: mut []int{}, nrpo: 0, pcnt: mut []int{}, preds: mut []int{}, idom: mut []int{}}
    m2rCfg(mut st, mut w, f)
    mut uw := UrW{def: mut []int{}, dblk: mut []int{}, inl: mut []int{}, inr: mut []int{}, mark: 0}
    xFill(mut uw.def, nv, -1)
    xFill(mut uw.dblk, nv, 0)
    xFill(mut uw.inl, nb, 0)
    xFill(mut uw.inr, nb, 0)
    for bi <- iter.Range(0, nb) {
        b := BlkRef(w.blk[bi])
        if int(b) >= 0 {
            mut p := irBlkPHead(mut st, b)
            while p >= 0 {
                uw.dblk[hget(mut st, p + 1)] = bi
                p = hget(mut st, p)
            }
            mut ins := irBlkIHead(mut st, b)
            while ins != -1 {
                r := irInsRes(mut st, ins)
                if r >= 0 {
                    uw.def[r] = int(ins)
                    uw.dblk[r] = bi
                }
                ins = irInsNext(mut st, ins)
            }
        }
    }
    for k <- iter.Range(0, w.nrpo) {
        h := w.rpo[k]
        if irBlkLoop(mut st, BlkRef(w.blk[h])) & 1 != 1 {
            continue
        }
        l := urShape(mut st, mut w, mut uw, h, -1, 0)
        if l.h < 0 || l.u - l.c0 > UR_TMAX {
            continue
        }
        uw.mark += 1
        loopMark(mut w, mut uw.inl, uw.mark, h)
        if urFits(mut st, mut w, mut uw, l) && urExitsOk(mut st, mut w, mut uw, l) {
            urUnroll(mut st, f, mut w, mut uw, l)
            return true
        }
    }
    return false
}

// urShape は頭 h のループの形（合わなければ h = -1）。xo ≥ 0 なら入りは「定数」の代わりに「xo + k」も受け、c0 = k − OFS（印 — 呼び手が外側の値を足す）
func urShape(st mut St, w mut m2rW, uw mut UrW, h int, xo int, ofs int) UrL {
    bad := UrL{h: -1, pre: -1, latch: -1, ix: -1, c0: 0, u: 0}
    pre := loopPre(mut st, mut w, h)
    hb := BlkRef(w.blk[h])
    if pre < 0 || irBlkTerm(mut st, hb) != TmCondbr {
        return bad
    }
    cd := uw.def[irBlkX1(mut st, hb)]
    if cd < 0 || irInsOp(mut st, InsRef(cd)) != OpCmp || irInsA(mut st, InsRef(cd)) != CLt {
        return bad
    }
    x := irInsB(mut st, InsRef(cd))
    ud := uw.def[irInsC(mut st, InsRef(cd))]
    if uw.def[x] >= 0 || uw.dblk[x] != h || ud < 0 || irInsOp(mut st, InsRef(ud)) != OpConst {
        return bad
    }
    // 本体の側（then）がループの中・出口（else）が外（then の先は h が支配し、else の先は支配の下でも後ろの辺へ戻らない — 印は呼び手が付ける前なので後ろの辺の前任で見る）
    mut ix := 0
    mut p := irBlkPHead(mut st, hb)
    while p >= 0 && hget(mut st, p + 1) != x {
        ix += 1
        p = hget(mut st, p)
    }
    mut latch := -1
    for j <- iter.Range(w.pcnt[h], w.pcnt[h + 1]) {
        q := w.preds[j]
        if q != pre && w.rpoIx[q] >= 0 {
            if latch >= 0 {
                return bad
            }
            latch = q
        }
    }
    if latch < 0 {
        return bad
    }
    lb := BlkRef(w.blk[latch])
    if irBlkTerm(mut st, lb) != TmBr || irBrTo(mut st, lb) != hb {
        return bad
    }
    // 後ろの辺の X = X + 1
    la := irBlkX2(mut st, lb)
    if ix >= xLen(mut st, la) || !urPlus(mut st, mut uw, xAt(mut st, la, ix), x, 1) {
        return bad
    }
    // 入りの X = 定数（xo ≥ 0 なら xo + k も）
    pa := irBlkX2(mut st, BlkRef(w.blk[pre]))
    a := xAt(mut st, pa, ix)
    ad := uw.def[a]
    mut c0 := 0
    if ad >= 0 && irInsOp(mut st, InsRef(ad)) == OpConst {
        c0 = irInsA(mut st, InsRef(ad))
    } else if xo >= 0 && a == xo {
        c0 = ofs
    } else if xo >= 0 && ad >= 0 && irInsOp(mut st, InsRef(ad)) == OpBin && irInsA(mut st, InsRef(ad)) == BAdd && irInsB(mut st, InsRef(ad)) == xo && urConst(mut st, mut uw, irInsC(mut st, InsRef(ad))) {
        c0 = ofs + irInsA(mut st, InsRef(uw.def[irInsC(mut st, InsRef(ad))]))
    } else {
        return bad
    }
    u := irInsA(mut st, InsRef(ud))
    if c0 > u {
        c0 = u
    }
    return UrL{h: h, pre: pre, latch: latch, ix: ix, c0: c0, u: u}
}

// urConst は値 v が定数か（小さい — 足し算の畳みで溢れない範囲）
func urConst(st mut St, uw mut UrW, v int) bool {
    d := uw.def[v]
    return d >= 0 && irInsOp(mut st, InsRef(d)) == OpConst && irInsA(mut st, InsRef(d)) >= -65536 && irInsA(mut st, InsRef(d)) <= 65536
}

// urPlus は値 v が `x + k`（k は定数）か
func urPlus(st mut St, uw mut UrW, v int, x int, k int) bool {
    d := uw.def[v]
    if d < 0 || irInsOp(mut st, InsRef(d)) != OpBin || irInsA(mut st, InsRef(d)) != BAdd {
        return false
    }
    a := irInsB(mut st, InsRef(d))
    b := irInsC(mut st, InsRef(d))
    o := if a == x { b } else if b == x { a } else { -1 }
    return o >= 0 && urConst(mut st, mut uw, o) && irInsA(mut st, InsRef(uw.def[o])) == k
}

// urCount は印 mark の付いたブロックの命令の数（終端を 1・呼び出しを UR_CALLW と数える）
func urCount(st mut St, w mut m2rW, in mut []int, mark int) int {
    mut n := 0
    for bi <- iter.Range(0, w.nb) {
        if in[bi] == mark && w.blk[bi] >= 0 {
            n += 1
            mut i := irBlkIHead(mut st, BlkRef(w.blk[bi]))
            while i != -1 {
                op := irInsOp(mut st, i)
                n += if op == OpCall || op == OpCallI || op == OpSyscall { UR_CALLW } else { 1 }
                i = irInsNext(mut st, i)
            }
        }
    }
    return n
}

// urFits はループ l（印 uw.mark）の展開後の大きさが予算（UR_BUDGET）以内か。中の内側のループは「入りが定数か l の X + k・上限が定数」で回数が
// l の各回で決まるときだけ数え、決まらない内側があれば展開しない（外側だけ写してもコードが増えるだけ）。3 段以上の入れ子は展開しない
func urFits(st mut St, w mut m2rW, uw mut UrW, l UrL) bool {
    t := l.u - l.c0
    total := urCount(mut st, mut w, mut uw.inl, uw.mark)
    hb := BlkRef(w.blk[l.h])
    mut ix := 0
    mut p := irBlkPHead(mut st, hb)
    while ix < l.ix {
        ix += 1
        p = hget(mut st, p)
    }
    xo := hget(mut st, p + 1)
    // 内側のループ（本体の中の頭）
    mut inner := 0
    mut innerSz := 0
    mut extra := 0
    for bi <- iter.Range(0, w.nb) {
        if bi == l.h || uw.inl[bi] != uw.mark || w.blk[bi] < 0 || irBlkLoop(mut st, BlkRef(w.blk[bi])) & 1 != 1 {
            continue
        }
        li := urShape(mut st, mut w, mut uw, bi, xo, 0)
        if li.h < 0 {
            return false
        }
        uw.inr[bi] = 0
        mk := 1000000 + bi
        loopMark(mut w, mut uw.inr, mk, bi)
        sz := urCount(mut st, mut w, mut uw.inr, mk)
        // 3 段目（内側の中のループの頭）は諦める
        for bj <- iter.Range(0, w.nb) {
            if bj != bi && uw.inr[bj] == mk && w.blk[bj] >= 0 && irBlkLoop(mut st, BlkRef(w.blk[bj])) & 1 == 1 {
                return false
            }
        }
        inner += 1
        innerSz += sz
        // 外側の各回 c での内側の回数（入りが定数なら c に依らない）
        pa := irBlkX2(mut st, BlkRef(w.blk[li.pre]))
        dep := xAt(mut st, pa, li.ix) == xo || uw.def[xAt(mut st, pa, li.ix)] < 0 || irInsOp(mut st, InsRef(uw.def[xAt(mut st, pa, li.ix)])) != OpConst
        for c <- iter.Range(l.c0, l.u) {
            s := if dep { li.c0 + c } else { li.c0 }
            ti := if li.u > s { li.u - s } else { 0 }
            if ti > UR_TMAX {
                return false
            }
            extra += ti * sz
        }
    }
    if inner == 0 {
        return t * total + total <= UR_BUDGET
    }
    return t * (total - innerSz) + extra + total <= UR_BUDGET
}

// urExitsOk はループの外がループの中の値を使う形を確かめる: 頭の値（仮引数・命令）だけが外で使われうる（最後の頭の写しへ付け替える）。
// 頭以外の値が外で使われる・頭の値が外で使われるのに頭以外からの出口がある（出口の合流が要る）なら展開しない
func urExitsOk(st mut St, w mut m2rW, uw mut UrW, l UrL) bool {
    mut otherExit := false
    for bi <- iter.Range(0, w.nb) {
        if bi == l.h || uw.inl[bi] != uw.mark || w.blk[bi] < 0 {
            continue
        }
        b := BlkRef(w.blk[bi])
        for k <- iter.Range(0, xNSucc(mut st, b)) {
            s := xSucc(mut st, b, k)
            if uw.inl[s] != uw.mark && irBlkTerm(mut st, BlkRef(w.blk[s])) != TmExit {
                otherExit = true
            }
        }
    }
    for bi <- iter.Range(0, w.nb) {
        if uw.inl[bi] == uw.mark || w.blk[bi] < 0 {
            continue
        }
        b := BlkRef(w.blk[bi])
        uw.inr[bi] = 0
        if urSatellite(mut st, mut w, mut uw, l, bi) {
            uw.inr[bi] = -7
            continue
        }
        mut i := irBlkIHead(mut st, b)
        while i != -1 {
            for k <- iter.Range(0, xNOps(mut st, i)) {
                if !urUseOk(mut uw, l.h, xOpnd(mut st, i, k), otherExit) {
                    return false
                }
            }
            i = irInsNext(mut st, i)
        }
        for k <- iter.Range(0, xNTermOps(mut st, b)) {
            if !urUseOk(mut uw, l.h, xTermOpnd(mut st, b, k), otherExit) {
                return false
            }
        }
    }
    return true
}

// urSatellite はループの外の exit のブロック（panic の点）で、ループの中の値を使い、前任が全部ループの本体（頭以外）のものか — 写しごとに一緒に写す
// （B1 では検査の panic の点が添字・シフト量などの値を引数に取る — 共有できない。仮引数・頭からの辺のあるものは対象外）
func urSatellite(st mut St, w mut m2rW, uw mut UrW, l UrL, bi int) bool {
    b := BlkRef(w.blk[bi])
    if irBlkTerm(mut st, b) != TmExit || irBlkPHead(mut st, b) >= 0 {
        return false
    }
    mut uses := false
    mut i := irBlkIHead(mut st, b)
    while i != -1 {
        for k <- iter.Range(0, xNOps(mut st, i)) {
            v := xOpnd(mut st, i, k)
            if v >= 0 && uw.inl[uw.dblk[v]] == uw.mark {
                uses = true
            }
        }
        i = irInsNext(mut st, i)
    }
    if !uses {
        return false
    }
    for j <- iter.Range(w.pcnt[bi], w.pcnt[bi + 1]) {
        p := w.preds[j]
        if uw.inl[p] != uw.mark || p == l.h {
            return false
        }
    }
    return true
}

// urUseOk はループの外の使い道 v が許されるか（ループの外の値・頭の値〔頭以外の出口が無いとき〕）
func urUseOk(uw mut UrW, h int, v int, otherExit bool) bool {
    if v < 0 || uw.inl[uw.dblk[v]] != uw.mark {
        return true
    }
    return uw.dblk[v] == h && !otherExit
}

// urUnroll はループ l を T 回の本体の写しと T + 1 回の頭の写しに置き換える
func urUnroll(st mut St, f FnRef, w mut m2rW, uw mut UrW, l UrL) {
    t := l.u - l.c0
    nv0 := len(uw.def)
    hb := BlkRef(w.blk[l.h])
    pb := BlkRef(w.blk[l.pre])
    lb := BlkRef(w.blk[l.latch])
    largs := irBlkX2(mut st, lb)
    pargs := irBlkX2(mut st, pb)
    then0 := irCondThen(mut st, hb)
    else0 := irCondElse(mut st, hb)
    // 写しの頭の列（k = 0..T）
    mut hs := mut []int{}
    for k <- iter.Range(0, t + 1) {
        hk := newBlock(mut st)
        irSetBlkLoop(mut st, hk, 2)
        hs = append(hs, int(hk))
    }
    irSetBlkX1(mut st, pb, hs[0])
    irSetBlkX2(mut st, pb, -1)
    mut prev := -1
    for k <- iter.Range(0, t + 1) {
        vm := listN(mut st, nv0)
        for v <- iter.Range(0, nv0) {
            hset(mut st, vm + 1 + v, v)
        }
        // 頭の仮引数 = 入り（k = 0）か前の写しの後ろの辺の実引数
        mut p := irBlkPHead(mut st, hb)
        mut q := 0
        while p >= 0 {
            hset(mut st, vm + 1 + hget(mut st, p + 1), if k == 0 { xAt(mut st, pargs, q) } else { ilMap(mut st, xAt(mut st, largs, q), prev) })
            q += 1
            p = hget(mut st, p)
        }
        // ループの中の命令の結果・本体のブロックの仮引数に新しい値
        mut bm := mut []int{}
        xFill(mut bm, w.nb, -1)
        for bi <- iter.Range(0, w.nb) {
            satl := uw.inr[bi] == -7 && w.blk[bi] >= 0 && k < t
            if !satl && (uw.inl[bi] != uw.mark || w.blk[bi] < 0 || (bi != l.h && k == t)) {
                continue
            }
            b := BlkRef(w.blk[bi])
            if bi != l.h {
                nbk := newBlock(mut st)
                irSetBlkLoop(mut st, nbk, (irBlkLoop(mut st, b) & 1) | 2)
                bm[bi] = int(nbk)
                mut pp := irBlkPHead(mut st, b)
                while pp >= 0 {
                    nvv := newValueIn(mut st, f)
                    hset(mut st, vm + 1 + hget(mut st, pp + 1), nvv)
                    np := rec4(mut st, -1, nvv, hget(mut st, pp + 2), 0)
                    if irBlkPHead(mut st, nbk) < 0 {
                        irSetBlkPHead(mut st, nbk, np)
                    } else {
                        hset(mut st, irBlkPTail(mut st, nbk), np)
                    }
                    irSetBlkPTail(mut st, nbk, np)
                    pp = hget(mut st, pp)
                }
            }
            mut i := irBlkIHead(mut st, b)
            while i != -1 {
                if irInsRes(mut st, i) >= 0 {
                    hset(mut st, vm + 1 + irInsRes(mut st, i), newValueIn(mut st, f))
                }
                i = irInsNext(mut st, i)
            }
        }
        // 頭の写し: 命令を写し、本体へ（k < T）か出口へ（k = T）br
        hk := BlkRef(hs[k])
        mut i := irBlkIHead(mut st, hb)
        while i != -1 {
            _ = ilCopyInst(mut st, hk, i, vm)
            i = irInsNext(mut st, i)
        }
        if k < t {
            ilTerm(mut st, hk, TmBr, urTo(mut st, then0, mut bm), ilList(mut st, irBlkX3(mut st, hb), vm), -1, -1, -1)
        } else {
            ilTerm(mut st, hk, TmBr, int(else0), ilList(mut st, irBlkX5(mut st, hb), vm), -1, -1, -1)
            urRename(mut st, mut w, mut uw, l.h, vm)
        }
        // 本体の写し（k < T）
        if k < t {
            for bi <- iter.Range(0, w.nb) {
                if bi == l.h || bm[bi] < 0 {
                    continue
                }
                b := BlkRef(w.blk[bi])
                nbk := BlkRef(bm[bi])
                mut j := irBlkIHead(mut st, b)
                while j != -1 {
                    _ = ilCopyInst(mut st, nbk, j, vm)
                    j = irInsNext(mut st, j)
                }
                tm := irBlkTerm(mut st, b)
                if tm == TmBr {
                    to := irBrTo(mut st, b)
                    if to == hb {
                        ilTerm(mut st, nbk, TmBr, hs[k + 1], -1, -1, -1, -1)
                    } else {
                        ilTerm(mut st, nbk, TmBr, urTo(mut st, to, mut bm), ilList(mut st, irBlkX2(mut st, b), vm), -1, -1, -1)
                    }
                } else if tm == TmCondbr {
                    ilTerm(mut st, nbk, TmCondbr, ilMap(mut st, irBlkX1(mut st, b), vm), urTo(mut st, irCondThen(mut st, b), mut bm), ilList(mut st, irBlkX3(mut st, b), vm),
                        urTo(mut st, irCondElse(mut st, b), mut bm), ilList(mut st, irBlkX5(mut st, b), vm))
                } else {
                    ilTerm(mut st, nbk, tm, if tm == TmRet && irBlkX1(mut st, b) >= 0 { ilMap(mut st, irBlkX1(mut st, b), vm) } else { irBlkX1(mut st, b) }, -1, -1, -1, -1)
                }
            }
        }
        prev = vm
    }
}

// urTo は行き先 to の写し（本体のブロックなら写し・外ならそのまま）
func urTo(st mut St, to BlkRef, bm mut []int) int {
    id := irBlkId(mut st, to)
    return if id < len(bm) && bm[id] >= 0 { bm[id] } else { int(to) }
}

// urRename はループの外の頭の値の使い道を最後の頭の写しの値（表 vm）に付け替える
func urRename(st mut St, w mut m2rW, uw mut UrW, h int, vm int) {
    for bi <- iter.Range(0, w.nb) {
        if uw.inl[bi] == uw.mark || w.blk[bi] < 0 {
            continue
        }
        b := BlkRef(w.blk[bi])
        mut i := irBlkIHead(mut st, b)
        while i != -1 {
            ks := st.opk[irInsOp(mut st, i)]
            for f3 <- iter.Range(0, 3) {
                urFix(mut st, mut uw, h, int(i) + I_A + f3, ks >> (4 * f3) & 15, vm)
            }
            i = irInsNext(mut st, i)
        }
        tk := termRow(irBlkTerm(mut st, b))
        for f5 <- iter.Range(0, 5) {
            urFix(mut st, mut uw, h, int(b) + B_X1 + f5, tk >> (4 * f5) & 15, vm)
        }
    }
}

// urFix は欄 at（種別 k）の頭の値を付け替える（値の列はその場で — 外の辺どうしで共有していても付け替えは同じ）
func urFix(st mut St, uw mut UrW, h int, at int, k int, vm int) {
    if k == K_VAL || k == K_VOPT {
        v := hget(mut st, at)
        if v >= 0 && v < len(uw.dblk) && uw.dblk[v] == h && uw.inl[h] == uw.mark {
            hset(mut st, at, ilMap(mut st, v, vm))
        }
    } else if k == K_VLIST {
        l := hget(mut st, at)
        if l >= 0 {
            for q <- iter.Range(0, hget(mut st, l)) {
                v := hget(mut st, l + 1 + q)
                if v >= 0 && v < len(uw.dblk) && uw.dblk[v] == h {
                    hset(mut st, l + 1 + q, ilMap(mut st, v, vm))
                }
            }
        }
    }
}

// 最終 IR の検査（verify.sober の vfyRun が最後の段で関数ごとに掛ける）: 全展開の写し（B_LOOP のビット 2）が続く直線の最長の IR 命令数
// （後ろの辺を除いた有向非巡回の道 — 終端を 1 と数える）がキャンセルの検査点の距離 K（CUT_K）以下か（展開の予算は展開の時点の IR での近似 —
// 外れたら内部エラーで鳴る。language.md 11 節の注記）

// urRunMsg は関数 f の全展開の直線が K を超えていれば違反の文面（超えていなければ "" — 段ごとの検証の最後の段〔st.vfyRuns〕だけで測る）
func urRunMsg(st mut St, f FnRef) string {
    if !st.vfyRuns || !urHasRun(mut st, f) {
        return ""
    }
    n := urLongest(mut st, f)
    return if n > CUT_K { "an unrolled straight run of ${n} IR instructions exceeds the cancellation check distance K = ${CUT_K}" } else { "" }
}

// urHasRun は関数に全展開の写しのブロックがあるか
func urHasRun(st mut St, f FnRef) bool {
    mut b := irFnBHead(mut st, f)
    while b != -1 {
        if irBlkLoop(mut st, b) & 2 == 2 {
            return true
        }
        b = irBlkNext(mut st, b)
    }
    return false
}

// urLongest は写しのブロックだけが続く道の、中断点の間の最長の命令数。後ろの辺を除くため深さ優先の後順の逆で辿り、順で前の前任からの辺だけを数える
// （作業域の構造体を組まない — 検証器から届く関数で mut []int の欄の構造体を組むと自己 check の RSS が跳ねる:）
func urLongest(st mut St, f FnRef) int {
    nb := irFnNBlk(mut st, f)
    mut blk := mut []int{}
    xFill(mut blk, nb, -1)
    mut b := irFnBHead(mut st, f)
    while b != -1 {
        blk[irBlkId(mut st, b)] = int(b)
        b = irBlkNext(mut st, b)
    }
    // 後順（反復の深さ優先 — 入口 = 番号 0）
    mut seen := mut []int{}
    xFill(mut seen, nb, 0)
    mut ord := mut []int{}
    xFill(mut ord, nb, -1)
    mut post := mut []int{}
    mut stB := mut []int{}
    xFill(mut stB, nb, 0)
    mut stN := mut []int{}
    xFill(mut stN, nb, 0)
    mut sp := 1
    seen[0] = 1
    while sp > 0 {
        tb := stB[sp - 1]
        ns := xNSucc(mut st, BlkRef(blk[tb]))
        k := stN[sp - 1]
        if k < ns {
            stN[sp - 1] = k + 1
            s2 := xSucc(mut st, BlkRef(blk[tb]), k)
            if seen[s2] == 0 {
                seen[s2] = 1
                stB[sp] = s2
                stN[sp] = 0
                sp += 1
            }
        } else {
            post = append(post, tb)
            sp -= 1
        }
    }
    np := len(post)
    for k <- iter.Range(0, np) {
        ord[post[np - 1 - k]] = k
    }
    // 逆後順で: 写しのブロックの run = 大きさ + 順で前の写しの前任の run の最大
    mut run := mut []int{}
    xFill(mut run, nb, 0)
    mut best := 0
    for k <- iter.Range(0, np) {
        bi := post[np - 1 - k]
        bb := BlkRef(blk[bi])
        if irBlkLoop(mut st, bb) & 2 == 2 {
            // 中断点（task の待ち — Recv / Send / Join・キャンセルの検査・task の切替）は言語の約束の検査点 — そこで数えを 0 に戻す
            mut cn := run[bi]
            mut i := irBlkIHead(mut st, bb)
            while i != -1 {
                cn += 1
                iop := irInsOp(mut st, i)
                if iop == OpTSwitch || (iop == OpCall && (irInsFn(mut st, i) == st.rtTaskWait || irInsFn(mut st, i) == st.rtCancel)) {
                    if cn > best {
                        best = cn
                    }
                    cn = 0
                }
                i = irInsNext(mut st, i)
            }
            run[bi] = cn + 1
            if run[bi] > best {
                best = run[bi]
            }
            // 後続へ流す（順で後ろの写しのブロックだけ）
            for q <- iter.Range(0, xNSucc(mut st, bb)) {
                s2 := xSucc(mut st, bb, q)
                if ord[s2] > k && run[bi] > run[s2] && irBlkLoop(mut st, BlkRef(blk[s2])) & 2 == 2 {
                    run[s2] = run[bi]
                }
            }
        }
    }
    return best
}
