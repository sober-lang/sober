package lower

// 入場と縮退（language.md 11 節「予算と admission」）
// - 入場（rt.task_newの頭 — admitIn）: 台帳の1ワード（rt.mnのMN_LED — バイトのフィールド〔ビット0〜39〕とtaskの数のフィールド〔41〜61〕・それぞれの
//   上にあふれビット〔40・62〕。フィールドの初期値 = フィールドの最大 − 天井）へ見積もり（バイト + 1 << LED_TSHIFT）を鍵なしのxaddで足し、どちらのあふれビットも
//   立たなければ入場（SWAR — フィールドが天井を超えると桁上がりがそのフィールドのあふれビットを立て、上のフィールドへは及ばない）。立ったら足した分を戻して縮退
//   （rt.task_inline）。give: の子は縮退しない — 常に入場して超過を記帳。taskの終わり（admitEnd）で足した分を引く。spawnの点はチャンクが0なら縮退の分岐だけ（spawnの点の値を増やすと
//   呼び手の関数のレジスタ割り当てが崩れて命令が増える — spawnbench で実測）
// - 見積もり = spawn の点ごとの観測した使用量の最大（rt.pest — task の終わりに自前のスロットの使った量の和・台帳に引く形で持つ）。まだ観測が無ければ EST_INIT。
//   観測と宣言に EST_FLOOR（taskの固定費 — task.sober TASK_FIXED）を足す。
//   宣言（budget: — P5-3）> 見積もりの順（宣言のインターフェースはP5-3）
// - 縮退（rt.task_inline）: 入場できない子をその場で今の task の上で呼ぶ（P3a の即時形 — 罠を張って呼び、枠に状態・死因を書く）。
//   子の間は今のチャンクのフィールド（枠・子の関数・預かりのフィールド・番号・開いているscope）を子のものに付け替え、終わったら戻す（kid_keep・死のdrainScopes・
//   検査点が「今のtask」のフィールドを読むため）。縮退した子は切らない（TC_CUTOK = 0 — 切ってよいのは死だけ・切るのは任意）。チャンク・スロット・VAを新しく取らない。
//   出力は今の区間へそのまま（子を先にの順 = 先行順の位置 — O1）。値・死因・stdout は子を先にの 1 つのスケジュールと同じ（Kahn）

import "desugar"
import "std/iter"

const LED_TSHIFT = 41                 // taskの数のフィールドの位置
const LED_OVF = 4611687117939015680   // あふれビット（1 << 40 | 1 << 62）
const LED_BMAX = 1099511627775        // バイトのフィールドの最大（2^40 - 1 = 1 TiB）
const LED_TMAX = 2097151              // taskの数のフィールドの最大（2^21 - 1）
const LED_ONE = 2199023255552         // task 1 つ（1 << LED_TSHIFT）
// TC_ADMの印: 普通のspawn（rt.task_new）で入場したtask。プールの節にはtaskの数を足していない（ledNodeE）。バイトの欄のあふれビットの位置 — 入場の量には立たない
const ADM_PLAIN = 1099511627776
const EST_INIT = 1048576              // 観測の無い spawn の点の見積もり（1 MiB — W_MADV の既定と揃える）
const EST_FLOOR = TASK_FIXED          // 入場の量と終わりの観測に足す固定費（task.sober TASK_FIXED — 配置の定数から導く）
const EST_MARK = 2199024304129        // 観測の前の表の値（EST_INIT + 1 task + 1 — 奇数のマーク: 観測の値は偶数〔確保は8の倍数〕）
const VA_BUDGET = 70368744177664      // task のスロットに使ってよい VA（2^46 = 64 TiB — ユーザー空間 128 TiB の半分）
const VA_SHED = 105553116266496       // SpawnInがshedに回るコピーしたスロットのVA（96 TiB — ユーザー空間128 TiBの3/4。越えた先はva_exhaustedの死の手前）

func needAdmitRt(st mut St) {
    lsNeed(mut st, NEED_ADMIT, 0)
    st.pestG = addGlobalInit(mut st, int(strLit(mut st, "rt.pest")), 1, -1)
    st.rtTaskInline = addFunc(mut st, int(strLit(mut st, "rt.task_inline")), desugar.ListRef(list4(mut st, TyPtr, TyI64, TyI64, TyI64)), -1)
    st.rtEstUp = addFunc(mut st, int(strLit(mut st, "rt.est_up")), desugar.ListRef(list2(mut st, TyPtr, TyI64)), -1)
}

func buildAdmitRt(st mut St) {
    // spawn の点の数はここで決まる（lower の最後 — buildTaskRt）
    desugar.HeapSet(mut st.d, st.pestG + G_WORDS, st.nsite + 1)
    buildTaskInline(mut st)
    buildEstUp(mut st)
    if awFn(st.rtD3) != 0 {
        buildAdmitWake(mut st)
    }
    if st.poolOn {
        buildPoolNew(mut st)
        buildLedger(mut st)
        buildSmGive(mut st)
        buildSmTake(mut st)
        if st.winOn {
            buildWinRt(mut st)
        }
    }
}

// ── 名前つきプール（std/task の NewPool / SpawnIn / Ledger）──
// 節の表rt.pools = [作った数, 節0のワード…, 節1のワード…, …]（POOL_MAX本 × POOL_Wワード・大域 — プールの札はどのregionからも使える）。節の番地 = ワードの先頭 − SR_LEDワード
// （scopeの天井の節の記録と同じ位置に台帳のワードと親の節 — admitInの節の歩き・ledUndo・admitReturnがそのまま乗る）。台帳のワードはtaskの数のフィールドに天井なし
const POOL_MAX = 4096
const POOL_W = 16
const PL_CAP = SR_LED + 2     // 天井（バイト）
const PL_ADMIT = SR_LED + 3   // 入場の数
const PL_SHED = SR_LED + 4    // shed の数
const PL_PIDX = SR_LED + 5    // 親の番号 + 1（0 = 根の下）
const PL_FAIL = SR_LED + 6    // 失敗の数（Serve の handler が error を返した — std/task の par_fail・net 4a-4）
const PL_DIED = SR_LED + 7    // 死の数（この節で入場した task が死んだ — task の出口の poolDied）
const PL_BSUM = SR_LED + 9    // この節の下で今借りている量の和（バイト — ledBorrowAdd。台帳のワードには足さない）
const PL_CUT = SR_LED + 10    // 天井で切った数（この節で入場したtaskが、伸びようとしてプールの節か根の天井を越えて死んだ — borrowIn。PL_DIEDの内数）
// SR_LED + 8 = PL_TOUT（Serveの期限で待ちを切った数。rdl.sober）・SR_LED + 12 = PL_EVICT（入場を待つ接続があるときに枠を取り戻すために切った数。rdl.sober）・SR_LED + 13 = PL_ARETRY（下）。残りは空き（POOL_W = 16は、親の番号の割り算をシフトにするため）
// taskの数の天井（0 = 無し — std/net の Serve の全部の親の節だけ。netring.sober の op 29）: 台帳のワードの task の数のフィールドを LED_TMAX − 天井から数え始める
const PL_TCAP = SR_LED + 11
// net.Serve の受け付けのループが accept の一時的な失敗で受け直した数（netring.sober acceptRetryOp — rt.netop の op 32）
const PL_ARETRY = SR_LED + 13

// 名前つきプールの rt の宣言（NewPool / SpawnIn / Ledger を使うプログラムだけ — 使わないプログラムの IR は不変）
func needPoolRt(st mut St) {
    lsNeed(mut st, NEED_POOL, 0)
    if st.poolOn {
        return
    }
    st.poolOn = true
    st.poolG = addGlobalInit(mut st, int(strLit(mut st, "rt.pools")), 1 + POOL_MAX * POOL_W, -1)
    st.rtTaskNewIn = addFunc(mut st, int(strLit(mut st, "rt.task_new_in")), desugar.ListRef(list3(mut st, TyI64, TyI64, TyI64)), TyPtr)
    st.rtPoolNew = addFunc(mut st, int(strLit(mut st, "rt.pool_new")), desugar.ListRef(list2(mut st, TyI64, TyI64)), TyI64)
    st.rtLedger = addFunc(mut st, int(strLit(mut st, "rt.ledger")), desugar.ListRef(list1(mut st, TyI64)), TyI64)
    needSmallRt(mut st)
}

// rt.pool_new(budget, parent)（std/task の newPool — @intrinsic "par_pool"）: 表から節を 1 つ取って天井 budget バイト・親の節 parent（0 = 無し）で
// 初めの値を書き、節の番地を返す（表が尽きたら -1 — NewPool が PoolLimit の panic）
func buildPoolNew(st mut St) {
    begin(mut st, st.rtPoolNew)
    pg := globaladdr(mut st, st.poolG)
    i := atomicXadd(mut st, pg, 0, iconst(mut st, 1))
    bFull := newBlock(mut st)
    bOk := newBlock(mut st)
    condbr(mut st, cmp(mut st, CGe, i, iconst(mut st, POOL_MAX)), bFull, -1, bOk, -1)
    setCur(mut st, bFull)
    ret(mut st, iconst(mut st, -1))
    setCur(mut st, bOk)
    // 最初の節（i = 0）で1度: 返した小さいスロットに残す常駐（ワーカーごとにRES_CAPまで — task.sober smallPush）は、taskの計上の外にある。
    // 根の計上に定数（ワーカー数 × RES_CAP）として入れる（プールの節の天井には数えない — 常駐はワーカーごとの量で、プールをまたいで共有される）。
    // 小さいスロットはプールから入場するtaskだけが持つので、プールを作らないプログラムには残る常駐が無い。入口（mnInit）では足せない: 入口は本体より先に組むので、
    // プールのrtが要るかがまだ決まっていない
    bFirst := newBlock(mut st)
    bRest := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, i, iconst(mut st, 0)), bFirst, -1, bRest, -1)
    setCur(mut st, bFirst)
    mnR := globaladdr(mut st, st.mnG)
    atomicXadd(mut st, mnR, MN_LED, bin(mut st, BMul, load(mut st, mnR, MN_N), iconst(mut st, RES_CAP)))
    br(mut st, bRest, -1)
    setCur(mut st, bRest)
    slot := gepWord(mut st, pg, bin(mut st, BAdd, bin(mut st, BMul, i, iconst(mut st, POOL_W)), iconst(mut st, 1)))
    b := imin(mut st, imax(mut st, 0, iconst(mut st, 0)), iconst(mut st, LED_BMAX))
    store(mut st, slot, 0, bin(mut st, BSub, iconst(mut st, LED_BMAX), b))
    store(mut st, slot, 1, 1)
    store(mut st, slot, 2, b)
    store(mut st, slot, 3, iconst(mut st, 0))
    store(mut st, slot, 4, iconst(mut st, 0))
    store(mut st, slot, 6, iconst(mut st, 0))
    store(mut st, slot, 7, iconst(mut st, 0))
    store(mut st, slot, 8, iconst(mut st, 0))
    // 親の番号 = (親の節 + SR_LEDワード − 表の節0) ÷ (POOL_Wワード) + 1（親が無ければ0）
    base := bin(mut st, BAdd, ptoi(mut st, pg), iconst(mut st, 8))
    pidx := bin(mut st, BAdd, bin(mut st, BSar, bin(mut st, BSub, bin(mut st, BAdd, 1, iconst(mut st, SR_LED * 8)), base), iconst(mut st, 7)), iconst(mut st, 1))
    store(mut st, slot, 5, bin(mut st, BMul, pidx, cmp(mut st, CNe, 1, iconst(mut st, 0))))
    ret(mut st, bin(mut st, BSub, ptoi(mut st, slot), iconst(mut st, SR_LED * 8)))
}

// rt.ledger(k)（std/taskのledgerWord — @intrinsic "par_ledger"・Ledgerの読みのインターフェース）: k = 0プールの数・1根の天井・2計上中のバイト・
// 3 計上中の task の数・4 縮退・5 天井を超えた入場・6 宣言超過・7 shed・8 ワーカー数・9 wait の待ち・10 待ちの最大（ns — 全ワーカーの WK_MAXW を
// xchgで0に戻して集める）・12未着手の子・13譲った回数・14 CPUの固定の形・15固定した群の数・18 / 19 / 20 / 21シャロースリープ・ディープスリープ・ウィンドウで深くした待ち・シャロースリープの前の交換の数（全ワーカーのWK_PSHAL / WK_PDEEP / WK_PDWIN / WK_PSWAPの和）・22 = ワーカーごとの作業の分（WK_WORK — std/netのServeが天井に ワーカー数 × この値 を足す）・23 + 16p + f = プールpの {0天井, 1計上中のバイト, 2 taskの数,
// 3入場, 4 shed, 5親の番号 + 1, 6失敗, 7死, 8期限で切った数, 9天井で切った数, 10今借りている量の和, 11 taskの数の天井〔0 = 無し〕}（範囲の外は0）・負 = domainの合計の行（-1待っている数・-2到着から入るまでの最大・-3満了・-4毒）
func buildLedger(st mut St) {
    begin(mut st, st.rtLedger)
    k := 0
    pg := globaladdr(mut st, st.poolG)
    mn := globaladdr(mut st, st.mnG)
    cnt := imin(mut st, load(mut st, pg, 0), iconst(mut st, POOL_MAX))
    led := load(mut st, mn, MN_LED)
    usedB := bin(mut st, BAdd, load(mut st, mn, MN_CAP), bin(mut st, BSub, bin(mut st, BAnd, led, iconst(mut st, 2 * LED_BMAX + 1)), iconst(mut st, LED_BMAX)))
    usedT := bin(mut st, BAdd, load(mut st, mn, MN_TCAP), bin(mut st, BSub, bin(mut st, BAnd, bin(mut st, BSar, led, iconst(mut st, LED_TSHIFT)), iconst(mut st, 2 * LED_TMAX + 1)), iconst(mut st, LED_TMAX)))
    rootV := []int{cnt, load(mut st, mn, MN_CAP), usedB, usedT, load(mut st, mn, MN_LINL), load(mut st, mn, MN_LOVER), load(mut st, mn, MN_LDOVER), load(mut st, mn, MN_LSHED), load(mut st, mn, MN_N), load(mut st, mn, MN_LWAIT)}
    ledgerPick(mut st, k, rootV)
    // 16 / 17 = 借りでプールの節か根があふれて死んだtaskの数・scopeの節だけがあふれたtaskの数
    ledgerPick(mut st, bin(mut st, BSub, k, iconst(mut st, 16)), []int{load(mut st, mn, MN_LBORD), load(mut st, mn, MN_LBORS)})
    // 11 = taskの固定費（TASK_FIXED — std/taskのFixed。プールの天井を接続の数から決めるstd/netのServeが読む）
    ledgerPick(mut st, bin(mut st, BSub, k, iconst(mut st, 11)), []int{iconst(mut st, TASK_FIXED)})
    // 22 = ワーカーごとの作業の分（WK_WORK — Serveの天井の余白。ワーカーで走っているtaskの借りと、返したスロットに残す常駐の上限）
    ledgerPick(mut st, bin(mut st, BSub, k, iconst(mut st, 22)), []int{iconst(mut st, WK_WORK)})
    ledgerMax(mut st, k, mn, 10, WK_MAXW)
    ledgerSum(mut st, k, mn, 18, WK_PSHAL)
    ledgerSum(mut st, k, mn, 19, WK_PDEEP)
    ledgerSum(mut st, k, mn, 20, WK_PDWIN)
    ledgerSum(mut st, k, mn, 21, WK_PSWAP)
    ledgerBacklog(mut st, k, mn)
    // 14 = 固定の形（0 なし・1 L3 の群・2 CPU 1 つ・3 L3 の群を頼んだが読めずに CPU 1 つへ縮退したワーカーがある）・15 = 固定した群の数
    pm := load(mut st, mn, MN_PIN)
    pfb := bin(mut st, BAnd, cmp(mut st, CEq, pm, iconst(mut st, 1)), cmp(mut st, CGt, load(mut st, mn, MN_PFALL), iconst(mut st, 0)))
    ledgerPick(mut st, bin(mut st, BSub, k, iconst(mut st, 13)), []int{load(mut st, mn, MN_LYIELD), bin(mut st, BAdd, pm, bin(mut st, BMul, pfb, iconst(mut st, 2))), load(mut st, mn, MN_PGRP)})
    // domain の合計の行（k = -1 待っている数・-2 到着から入るまでの最大〔ns — xchg で 0 に戻す〕・-3 満了・-4 毒）
    bDm := newBlock(mut st)
    bNd := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, k, iconst(mut st, 0)), bDm, -1, bNd, -1)
    setCur(mut st, bDm)
    bMx := newBlock(mut st)
    bOt := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, k, iconst(mut st, -2)), bMx, -1, bOt, -1)
    setCur(mut st, bMx)
    ret(mut st, atomicXchg(mut st, mn, MN_DMAXW, iconst(mut st, 0)))
    setCur(mut st, bOt)
    ledgerPick(mut st, bin(mut st, BSub, iconst(mut st, -1), k), []int{load(mut st, mn, MN_DWAITING), iconst(mut st, 0), load(mut st, mn, MN_DEXP), load(mut st, mn, MN_DPOIS)})
    // -7 / -8 / -9 = 天井の空きを今待っている数・待った回数の累計・待ちの期限で戻った数（ceil.sober）
    ledgerPick(mut st, bin(mut st, BSub, iconst(mut st, -7), k), []int{load(mut st, mn, MN_CWN), load(mut st, mn, MN_CWCNT), load(mut st, mn, MN_CWDIE)})
    // -5 / -6 = 子の応答の溜め（mux.sober）の使っているチャンクの数・その最大（溜めを使わないプログラムは0）
    if st.muxG != -1 {
        mpl := globaladdr(mut st, st.muxG)
        ledgerPick(mut st, bin(mut st, BSub, iconst(mut st, -5), k), []int{mpChunks(mut st, mpUseLive(mut st)), mpChunks(mut st, load(mut st, mpl, MP_PEAK))})
    }
    // -10 / -11 / -12 = ログのwritten・dropped・maxPending（logsink.sober — ログを使わないプログラムは0）
    logLedger(mut st, k)
    ret(mut st, iconst(mut st, 0))
    setCur(mut st, bNd)
    // プールの節
    j := bin(mut st, BSub, k, iconst(mut st, POOL_K0))
    p := bin(mut st, BSar, j, iconst(mut st, 4))
    bA := newBlock(mut st)
    bP := newBlock(mut st)
    bZero := newBlock(mut st)
    condbr(mut st, cmp(mut st, CGe, k, iconst(mut st, POOL_K0)), bA, -1, bZero, -1)
    setCur(mut st, bA)
    condbr(mut st, cmp(mut st, CLt, p, cnt), bP, -1, bZero, -1)
    setCur(mut st, bP)
    slot := gepWord(mut st, pg, bin(mut st, BAdd, bin(mut st, BMul, p, iconst(mut st, POOL_W)), iconst(mut st, 1)))
    pl := load(mut st, slot, 0)
    pc := load(mut st, slot, 2)
    pu := bin(mut st, BAdd, pc, bin(mut st, BSub, bin(mut st, BAnd, pl, iconst(mut st, 2 * LED_BMAX + 1)), iconst(mut st, LED_BMAX)))
    tcap := load(mut st, slot, PL_TCAP - SR_LED)
    pt := poolTasks(mut st, slot, pl)
    ledgerPick(mut st, bin(mut st, BAnd, j, iconst(mut st, 15)), []int{pc, pu, pt, load(mut st, slot, 3), load(mut st, slot, 4), load(mut st, slot, 5), load(mut st, slot, 6), load(mut st, slot, 7), load(mut st, slot, 8), load(mut st, slot, PL_CUT - SR_LED), load(mut st, slot, PL_BSUM - SR_LED), tcap, load(mut st, slot, PL_EVICT - SR_LED), load(mut st, slot, PL_ARETRY - SR_LED)})
    br(mut st, bZero, -1)
    setCur(mut st, bZero)
    ret(mut st, iconst(mut st, 0))
}

// 台帳のワードの番号でプールの節が始まるところ（それより前は根のワード）
const POOL_K0 = 23

// k = kMaxなら全ワーカーのワードwMaxの最大を返す（TSCの数をnsへ・xchgで0に戻す。でなければ次のブロックへ続く）
func ledgerMax(st mut St, k int, mn int, kMax int, wMax int) {
    zero := iconst(mut st, 0)
    bS := newBlock(mut st)
    bN := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, k, iconst(mut st, kMax)), bS, -1, bN, -1)
    setCur(mut st, bS)
    n := load(mut st, mn, MN_N)
    lp := newBlock(mut st)
    i := param(mut st, lp, TyI64)
    acc := param(mut st, lp, TyI64)
    body := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, lp, list2(mut st, zero, zero))
    setCur(mut st, lp)
    condbr(mut st, cmp(mut st, CLt, i, n), body, -1, done, -1)
    setCur(mut st, body)
    // ワーカーが立つ前（rt.mn_startの前 — コンパイラ自身が起動の早いステージでLedger().workersを読む）は番地0: 飛ばす
    wa := load(mut st, gepWord(mut st, mn, i), MN_WK)
    w := itop(mut st, wa)
    bW := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, wa, zero), lp, list2(mut st, bin(mut st, BAdd, i, iconst(mut st, 1)), acc), bW, -1)
    setCur(mut st, bW)
    v := atomicXchg(mut st, w, wMax, zero)
    br(mut st, lp, list2(mut st, bin(mut st, BAdd, i, iconst(mut st, 1)), bin(mut st, BAdd, acc, bin(mut st, BMul, cmp(mut st, CGt, v, acc), bin(mut st, BSub, v, acc)))))
    setCur(mut st, done)
    // TSC の数 → ns（× 65536 ÷ MN_TSCQ — 校正の前は TSCQ_DEF）
    q := load(mut st, mn, MN_TSCQ)
    qe := bin(mut st, BAdd, q, bin(mut st, BMul, cmp(mut st, CEq, q, zero), iconst(mut st, TSCQ_DEF)))
    ret(mut st, bin(mut st, BDiv, bin(mut st, BShl, acc, iconst(mut st, 16)), qe))
    setCur(mut st, bN)
}

// k = kSumなら全ワーカーのワードwSumの和を返す（でなければ次のブロックへ続く）
func ledgerSum(st mut St, k int, mn int, kSum int, wSum int) {
    zero := iconst(mut st, 0)
    bS := newBlock(mut st)
    bN := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, k, iconst(mut st, kSum)), bS, -1, bN, -1)
    setCur(mut st, bS)
    n := load(mut st, mn, MN_N)
    lp := newBlock(mut st)
    i := param(mut st, lp, TyI64)
    acc := param(mut st, lp, TyI64)
    body := newBlock(mut st)
    bW := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, lp, list2(mut st, zero, zero))
    setCur(mut st, lp)
    condbr(mut st, cmp(mut st, CLt, i, n), body, -1, done, -1)
    setCur(mut st, body)
    // ワーカーが立つ前は番地 0: 飛ばす
    wa := load(mut st, gepWord(mut st, mn, i), MN_WK)
    condbr(mut st, cmp(mut st, CEq, wa, zero), lp, list2(mut st, bin(mut st, BAdd, i, iconst(mut st, 1)), acc), bW, -1)
    setCur(mut st, bW)
    br(mut st, lp, list2(mut st, bin(mut st, BAdd, i, iconst(mut st, 1)), bin(mut st, BAdd, acc, load(mut st, itop(mut st, wa), wSum))))
    setCur(mut st, done)
    ret(mut st, acc)
    setCur(mut st, bN)
}

// k = 12 なら未着手の子の数（全ワーカーの列の T − H の和）を返す（でなければ次のブロックへ続く）
func ledgerBacklog(st mut St, k int, mn int) {
    zero := iconst(mut st, 0)
    bS := newBlock(mut st)
    bN := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, k, iconst(mut st, 12)), bS, -1, bN, -1)
    setCur(mut st, bS)
    n := load(mut st, mn, MN_N)
    lp := newBlock(mut st)
    i := param(mut st, lp, TyI64)
    acc := param(mut st, lp, TyI64)
    body := newBlock(mut st)
    bW := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, lp, list2(mut st, zero, zero))
    setCur(mut st, lp)
    condbr(mut st, cmp(mut st, CLt, i, n), body, -1, done, -1)
    setCur(mut st, body)
    // ワーカーが立つ前は番地 0: 飛ばす
    wa := load(mut st, gepWord(mut st, mn, i), MN_WK)
    condbr(mut st, cmp(mut st, CEq, wa, zero), lp, list2(mut st, bin(mut st, BAdd, i, iconst(mut st, 1)), acc), bW, -1)
    setCur(mut st, bW)
    w := itop(mut st, wa)
    d := bin(mut st, BSub, load(mut st, w, WK_DT), load(mut st, w, WK_DH))
    // 盗みと競る読みは一瞬負になりうる — 0 に丸める
    br(mut st, lp, list2(mut st, bin(mut st, BAdd, i, iconst(mut st, 1)), bin(mut st, BAdd, acc, bin(mut st, BMul, d, cmp(mut st, CGt, d, zero)))))
    setCur(mut st, done)
    ret(mut st, acc)
    setCur(mut st, bN)
}

// x == i なら vs[i] を返す枝の列（どれでもなければ次のブロックへ続く）
func ledgerPick(st mut St, x int, vs []int) {
    for i <- iter.Range(0, len(vs)) {
        bY := newBlock(mut st)
        bN := newBlock(mut st)
        condbr(mut st, cmp(mut st, CEq, x, iconst(mut st, i)), bY, -1, bN, -1)
        setCur(mut st, bY)
        ret(mut st, vs[i])
        setCur(mut st, bN)
    }
}

// 小さい方
func imin(st mut St, a int, b int) int {
    return bin(mut st, BSub, a, bin(mut st, BMul, cmp(mut st, CGt, a, b), bin(mut st, BSub, a, b)))
}

// 台帳のワード（天井capバイト・tcap task — 入口で1度。rt.pcap_initから）: フィールド = フィールドの最大 − 天井（天井は0〜フィールドの最大に丸める）
func ledInit(st mut St, capB int, capT int) {
    b := imin(mut st, imax(mut st, capB, iconst(mut st, 0)), iconst(mut st, LED_BMAX))
    t := imin(mut st, imax(mut st, capT, iconst(mut st, 0)), iconst(mut st, LED_TMAX))
    v := bin(mut st, BOr, bin(mut st, BSub, iconst(mut st, LED_BMAX), b), bin(mut st, BShl, bin(mut st, BSub, iconst(mut st, LED_TMAX), t), iconst(mut st, LED_TSHIFT)))
    store(mut st, globaladdr(mut st, st.mnG), MN_LED, v)
}

// 入場の結果（IR の値 — 足した量〔0 = 計上しない〕と天井の節の最内）
type Adm struct {
    e int
    node int
}

// rt.task_new の頭の入場（仮引数の番号: code = spawn の点 × 4 + 根だけ × 2 + give〔0 = 計上しない〕・decl = 宣言の上界〔0 = 無し〕・
// pool = プールの節〔rt.task_new_in — task.SpawnIn。-1 = rt.task_new〕）。
// 足す量e = 宣言があれば宣言（偶数へ丸め）+ 固定費（EST_FLOOR）+ 1 task・無ければspawnの点の見積もり（観測の前はEST_MARK — 奇数のマーク）。天井の節（scopeのbudget: —
// 今の task の TC_CNODE から SR_PNODE を辿る）と根の台帳の全部に足し、どれかがあふれたら足した分を全部戻して rt.task_new から 0 を返す（縮退 — 呼び手が
// rt.task_inline）。give: の子は戻さず超過を記帳して入場（端点を受け取る子は縮退しない）。
// poolの形: 節のチェーン = プールの節から親のプールへ（scopeの天井の節は見ない）・節であふれたら全部戻して0（shed — 呼び手が (nil, Shed{})）・根であふれたら
// 超過で入場（縮退しない — give: と同じ）。入場・shed の数をプールの節（葉）に数える。
// pw（poolの形だけ — 値 0〜3・std/net の Serve の受け付けのループだけ — rt.netop 20）: ビット0 = 節であふれても shed せずに入場の待ちのチェーンで待つ・
// ビット1 = 入れなくても shed に数えない（受け付けを止める前の試し）。
// 待つのは、今の task があふれた節に計上されていないときだけ（計上されていれば shed — 自分の返しを待つデッドロックを構造で避ける）。
// 上界 > 節の天井（自分だけであふれた — 待っても入れない）も shed
func admitIn(st mut St, code int, decl int, pool int, pw int) Adm {
    mn := globaladdr(mut st, st.mnG)
    zero := iconst(mut st, 0)
    one := iconst(mut st, 1)
    bA := newBlock(mut st)
    bJ := newBlock(mut st)
    re := param(mut st, bJ, TyI64)
    rn := param(mut st, bJ, TyI64)
    condbr(mut st, cmp(mut st, CEq, code, zero), bJ, list2(mut st, zero, zero), bA, -1)
    setCur(mut st, bA)
    // 入場の試しの頭（wait の scope の待ちから戻る先。見積もりは試しごとに読み直す）
    bTry := newBlock(mut st)
    br(mut st, bTry, -1)
    setCur(mut st, bTry)
    // 待ち手の取りこぼし防止の番号（試しの前に読む — 試しの後に返しがあれば待たずに試し直す）
    g0 := if awFn(st.rtD3) != 0 { load(mut st, mn, MN_AGEN) } else { zero }
    give := cmp(mut st, CNe, bin(mut st, BAnd, code, one), zero)
    bDecl := newBlock(mut st)
    bEst := newBlock(mut st)
    bE := newBlock(mut st)
    e := param(mut st, bE, TyI64)
    condbr(mut st, cmp(mut st, CGt, decl, zero), bDecl, -1, bEst, -1)
    setCur(mut st, bDecl)
    br(mut st, bE, list1(mut st, bin(mut st, BAdd, bin(mut st, BAdd, decl, bin(mut st, BAnd, decl, one)), iconst(mut st, EST_FLOOR + LED_ONE))))
    setCur(mut st, bEst)
    br(mut st, bE, list1(mut st, load(mut st, gepWord(mut st, globaladdr(mut st, st.pestG), bin(mut st, BSar, code, iconst(mut st, 2))), 0)))
    setCur(mut st, bE)
    // 天井の節 = 今の task の今効いている節（TC_CNODE — budget: の無いプログラムは 0 = 根だけ）。rootOnly = 1 なら根だけ
    mut n0 := pool
    mut me := zero
    if pool < 0 {
        me = itop(mut st, waitSelf(mut st))
        n0 = bin(mut st, BMul, load(mut st, me, TC_CNODE), bin(mut st, BSub, one, bin(mut st, BAnd, bin(mut st, BSar, code, one), one)))
    }
    // 子の入場の打ち消し: 同じ節にこのワーカーの溜めた子の返し（WK_PDEBT — taskの数が1以上・バイトがe以上）があれば、そこからeを引いて入場とする
    // （台帳の語は変わらない — 返した子の量を新しい子が引き継ぐ）。天井を越えている間は打ち消さない: 根とチェーンの節の語のあふれビットを読む（読むだけ）。
    // ミュータント133 = あふれビットを見ない（天井を越えている間も子が入場し、縮退か待ちになるべき子がtaskになる）
    if pool < 0 && st.poolOn && st.areaOn {
        wkA := globaladdr(mut st, st.wkG)
        debt := load(mut st, wkA, WK_PDEBT)
        ok1 := bin(mut st, BAnd, bin(mut st, BAnd, cmp(mut st, CEq, load(mut st, wkA, WK_PNODE), n0), cmp(mut st, CNe, bin(mut st, BSar, debt, iconst(mut st, LED_TSHIFT)), zero)),
            cmp(mut st, CGe, bin(mut st, BAnd, debt, iconst(mut st, LED_BMAX)), bin(mut st, BAnd, e, iconst(mut st, LED_BMAX))))
        bChk := newBlock(mut st)
        bNet := newBlock(mut st)
        bSlow := newBlock(mut st)
        condbr(mut st, ok1, bChk, -1, bSlow, -1)
        setCur(mut st, bChk)
        if ledMut(mut st, 133) {
            br(mut st, bNet, -1)
        } else {
            ol := newBlock(mut st)
            on := param(mut st, ol, TyI64)
            ov := param(mut st, ol, TyI64)
            ob := newBlock(mut st)
            od := newBlock(mut st)
            // 照合のbuildは根の語をあふれて見せる（打ち消しの点に来ないことを照合する — 137だけが来る）
            ov0 := if ledChk(mut st) { iconst(mut st, LED_OVF) } else { bin(mut st, BAnd, load(mut st, mn, MN_LED), iconst(mut st, LED_OVF)) }
            br(mut st, ol, list2(mut st, n0, ov0))
            setCur(mut st, ol)
            condbr(mut st, cmp(mut st, CEq, on, zero), od, -1, ob, -1)
            setCur(mut st, ob)
            onp := itop(mut st, on)
            br(mut st, ol, list2(mut st, load(mut st, onp, SR_PNODE), bin(mut st, BOr, ov, bin(mut st, BAnd, load(mut st, onp, SR_LED), iconst(mut st, LED_OVF)))))
            setCur(mut st, od)
            condbr(mut st, cmp(mut st, CEq, ov, zero), bNet, -1, bSlow, -1)
        }
        setCur(mut st, bNet)
        if ledChk(mut st) {
            ledChkFail(mut st, iconst(mut st, 1), "led-check: a child's admission was netted while the ledger was over its ceiling\n")
        }
        store(mut st, wkA, WK_PDEBT, bin(mut st, BSub, debt, e))
        br(mut st, bJ, list2(mut st, e, n0))
        setCur(mut st, bSlow)
    }
    // 節の歩き: f = 縮退か待ちに決まった（節であふれた — give: でない子は足した分を戻さず残りの節と根にも足す: 縮退分の記帳〔language.md 11 節〕）・
    // c = あふれた節のどれかに spawn した task 自身が計上されている（wait でも待たない — 入れ子の spawn は縮退）・
    // im = あふれた節のどれかが自分だけであふれた（ほかの計上が 0 — 上界 > 節の天井: 待っても入れない）
    loop := newBlock(mut st)
    n := param(mut st, loop, TyI64)
    f := param(mut st, loop, TyI64)
    c := param(mut st, loop, TyI64)
    im := param(mut st, loop, TyI64)
    bNode := newBlock(mut st)
    bRoot := newBlock(mut st)
    br(mut st, loop, list4(mut st, n0, zero, zero, zero))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CEq, n, zero), bRoot, -1, bNode, -1)
    setCur(mut st, bNode)
    np := itop(mut st, n)
    en := ledNodeE(mut st, n, e, if pool < 0 { one } else { zero })
    nw := bin(mut st, BAdd, atomicXadd(mut st, np, SR_LED, en), en)
    bNOk := newBlock(mut st)
    fv := param(mut st, bNOk, TyI64)
    cv := param(mut st, bNOk, TyI64)
    iv := param(mut st, bNOk, TyI64)
    bNOv := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, bin(mut st, BAnd, nw, iconst(mut st, LED_OVF)), zero), bNOk, list3(mut st, f, c, im), bNOv, -1)
    setCur(mut st, bNOv)
    if pool >= 0 {
        // 節であふれた: この節と、ここまでに足した節（n0 から n の手前まで）から戻して shed
        atomicXadd(mut st, np, SR_LED, bin(mut st, BSub, zero, en))
        ledUndo(mut st, n0, n, e, zero)
        if awFn(st.rtD3) != 0 {
            poolWait(mut st, n, nw, bin(mut st, BAnd, pw, one), g0, bTry)
        }
        quiet := cmp(mut st, CNe, bin(mut st, BAnd, pw, iconst(mut st, 2)), zero)
        atomicXadd(mut st, mn, MN_LSHED, bin(mut st, BXor, quiet, one))
        atomicXadd(mut st, itop(mut st, n0), PL_SHED, bin(mut st, BXor, quiet, one))
        if awFn(st.rtD3) != 0 {
            _ = ledWakeG(mut st)
        }
        ret(mut st, itop(mut st, zero))
    } else {
        // give: は超過を記帳して入場・それ以外は縮退か待ちに決めて残りの節と根にも足す
        bNGive := newBlock(mut st)
        bNInl := newBlock(mut st)
        condbr(mut st, give, bNGive, -1, bNInl, -1)
        setCur(mut st, bNGive)
        atomicXadd(mut st, mn, MN_LOVER, one)
        br(mut st, bNOk, list3(mut st, f, c, im))
        setCur(mut st, bNInl)
        if awFn(st.rtD3) != 0 {
            // 自分だけであふれたか（節の計上中のtaskの数 — nodeTasks: taskの数の天井を持つプールの節は起点をずらしてある）・自分がこの節に計上されているか（入場した節から根へのチェーンにnがある）
            // 普通のspawnはプールの節にtaskの数を足さないので、プールの節では自分を除いた数（0）と比べる
            alone := cmp(mut st, CEq, nodeTasks(mut st, n, nw), if st.poolOn { bin(mut st, BSub, one, poolNodeBit(mut st, n)) } else { one })
            // 自分（入場したtask — TC_ADM ≠ 0）の入場した節TC_NODEから根へのチェーンにnがあるか
            cl := newBlock(mut st)
            m := param(mut st, cl, TyI64)
            cb := newBlock(mut st)
            cd := newBlock(mut st)
            cr := param(mut st, cd, TyI64)
            br(mut st, cl, list1(mut st, bin(mut st, BMul, load(mut st, me, TC_NODE), cmp(mut st, CNe, load(mut st, me, TC_ADM), zero))))
            setCur(mut st, cl)
            ch := newBlock(mut st)
            condbr(mut st, cmp(mut st, CEq, m, zero), cd, list1(mut st, zero), ch, -1)
            setCur(mut st, ch)
            condbr(mut st, cmp(mut st, CEq, m, n), cd, list1(mut st, one), cb, -1)
            setCur(mut st, cb)
            br(mut st, cl, list1(mut st, load(mut st, itop(mut st, m), SR_PNODE)))
            setCur(mut st, cd)
            br(mut st, bNOk, list3(mut st, one, bin(mut st, BOr, c, cr), bin(mut st, BOr, im, alone)))
        } else {
            br(mut st, bNOk, list3(mut st, one, c, im))
        }
    }
    setCur(mut st, bNOk)
    br(mut st, loop, list4(mut st, load(mut st, np, SR_PNODE), fv, cv, iv))
    // 根
    setCur(mut st, bRoot)
    if pool >= 0 {
        atomicXadd(mut st, itop(mut st, n0), PL_ADMIT, one)
    }
    rw := bin(mut st, BAdd, atomicXadd(mut st, mn, MN_LED, e), e)
    bOk := newBlock(mut st)
    bNo := newBlock(mut st)
    bFit := newBlock(mut st)
    rOv := cmp(mut st, CNe, bin(mut st, BAnd, rw, iconst(mut st, LED_OVF)), zero)
    condbr(mut st, rOv, bNo, -1, bFit, -1)
    setCur(mut st, bFit)
    condbr(mut st, cmp(mut st, CEq, f, zero), bOk, -1, bNo, -1)
    // 計上の高水位（計測のときだけ — 入場の時点のワードは入場済みの和の上界〔並行に足しかけて戻す途中の分も含む〕で、入場はワードがあふれないときだけなので
    // 高水位 ≤ 天井。天井の外の超過〔give:・縮退〕は over / inline の側）
    setCur(mut st, bOk)
    bS := newBlock(mut st)
    condbr(mut st, pstatOn(mut st), bS, -1, bJ, list2(mut st, e, n0))
    setCur(mut st, bS)
    atomicMax(mut st, mn, MN_LPEAKA, bin(mut st, BAdd, load(mut st, mn, MN_CAP), bin(mut st, BSub, bin(mut st, BAnd, rw, iconst(mut st, LED_BMAX)), iconst(mut st, LED_BMAX))))
    atomicMax(mut st, mn, MN_LPEAKB, bin(mut st, BAdd, load(mut st, mn, MN_CAP), bin(mut st, BSub, bin(mut st, BAnd, rw, iconst(mut st, LED_BMAX)), iconst(mut st, LED_BMAX))))
    atomicMax(mut st, mn, MN_LPEAKT, bin(mut st, BAdd, load(mut st, mn, MN_TCAP), bin(mut st, BSub, bin(mut st, BAnd, bin(mut st, BSar, rw, iconst(mut st, LED_TSHIFT)), iconst(mut st, LED_TMAX)), iconst(mut st, LED_TMAX))))
    br(mut st, bJ, list2(mut st, e, n0))
    setCur(mut st, bNo)
    bGive := newBlock(mut st)
    mut bInl := BlkRef(-1)
    if pool >= 0 {
        br(mut st, bGive, -1)
    } else {
        bInl = newBlock(mut st)
        condbr(mut st, give, bGive, -1, bInl, -1)
    }
    setCur(mut st, bGive)
    atomicXadd(mut st, mn, MN_LOVER, one)
    ledPeakAll(mut st, mn, rw)
    br(mut st, bJ, list2(mut st, e, n0))
    if pool < 0 {
        setCur(mut st, bInl)
        if st.poolOn && st.areaOn {
            // 縮退か待ちに決める前に、自分のワーカーの溜め（台帳を多く見せている分）があれば、足した分を戻して溜めを反映し、1度だけ試し直す
            // （反映の後は溜めが0なので2度目は来ない — 試しの間にこのワーカーで他のtaskは走らない）
            wkR := globaladdr(mut st, st.wkG)
            bRt := newBlock(mut st)
            bRn := newBlock(mut st)
            condbr(mut st, cmp(mut st, CNe, load(mut st, wkR, WK_PDEBT), zero), bRt, -1, bRn, -1)
            setCur(mut st, bRt)
            atomicXadd(mut st, mn, MN_LED, bin(mut st, BSub, zero, e))
            ledUndo(mut st, n0, zero, e, one)
            parkFlush(mut st)
            if awFn(st.rtD3) != 0 {
                _ = ledWakeG(mut st)
            }
            ceilWake(mut st)
            br(mut st, bTry, -1)
            setCur(mut st, bRn)
        }
        if awFn(st.rtD3) != 0 {
            // wait の scope の直接の子（language.md 11 節「wait」）: 今の task が wait の中で、あふれた節（根を含む）のどれにも自分が計上されていなければ待つ。
            // 根であふれたときは「自分が根に計上されている」= 入場した task（TC_ADM ≠ 0）・「自分だけ」= 根の task の数が 1
            rC := bin(mut st, BAnd, rOv, cmp(mut st, CNe, load(mut st, me, TC_ADM), zero))
            rAlone := cmp(mut st, CEq, bin(mut st, BAdd, load(mut st, mn, MN_TCAP), bin(mut st, BSub, bin(mut st, BAnd, bin(mut st, BSar, rw, iconst(mut st, LED_TSHIFT)), iconst(mut st, 2 * LED_TMAX + 1)), iconst(mut st, LED_TMAX))), one)
            cAll := bin(mut st, BOr, c, rC)
            imAll := bin(mut st, BOr, im, bin(mut st, BAnd, rOv, rAlone))
            canW := bin(mut st, BAnd, cmp(mut st, CNe, load(mut st, me, TC_WAIT), zero), cmp(mut st, CEq, cAll, zero))
            bW := newBlock(mut st)
            bInl2 := newBlock(mut st)
            condbr(mut st, canW, bW, -1, bInl2, -1)
            setCur(mut st, bW)
            // 待つ側: 足した分を全部戻す（計上しない — 入れたら試し直しで足す）
            atomicXadd(mut st, mn, MN_LED, bin(mut st, BSub, zero, e))
            ledUndo(mut st, n0, zero, e, one)
            // 自分の戻しも番号を進める（自分の足しで塞がった他の待ち手のため）— 進める前の番号が g0 なら、待ちの照合は自分の 1 つを差し引いた値と
            // （g0 でなければ試しの後に返しがあった — 待たずに試し直す）
            gp := ledWakeG(mut st)
            bImp := newBlock(mut st)
            bWait := newBlock(mut st)
            bEstI := newBlock(mut st)
            condbr(mut st, imAll, bImp, -1, bWait, -1)
            // 上界 > 天井（待っても入れない）: 宣言のある子はspawnの点のpanic（1を返す — 呼び手が明示の診断で死ぬ）・見積もりの子は縮退
            // （見積もりはスケジュールに依るので死の理由にしない）
            setCur(mut st, bImp)
            bPan := newBlock(mut st)
            condbr(mut st, cmp(mut st, CGt, decl, zero), bPan, -1, bEstI, -1)
            setCur(mut st, bPan)
            ret(mut st, itop(mut st, one))
            setCur(mut st, bEstI)
            // 見積もりの子の縮退: 戻した分を記帳し直す（縮退の約束 — 根と節に足す）
            atomicXadd(mut st, mn, MN_LED, e)
            ledUndo(mut st, n0, zero, bin(mut st, BSub, zero, e), one)
            atomicXadd(mut st, mn, MN_LINL, one)
            tkE := globaladdr(mut st, st.taskG)
            store(mut st, tkE, TK_INLE, e)
            store(mut st, tkE, TK_INLN, n0)
            ret(mut st, itop(mut st, zero))
            setCur(mut st, bWait)
            bW2 := newBlock(mut st)
            condbr(mut st, cmp(mut st, CEq, gp, g0), bW2, -1, bTry, -1)
            setCur(mut st, bW2)
            atomicXadd(mut st, mn, MN_LWAIT, one)
            // 待ち: 鍵の下で待ちのチェーンに積み、番号が動いていれば（試しの後に返しがあった）チェーンから自分を外して試し直す（外せなければウェイクアップが来ている —
            // 待って受ける）。動いていなければrt.task_waitで譲る（ワーカーを塞がない — ウェイクアップはrt.admit_wake）
            gw := bin(mut st, BAdd, g0, one)
            spinLock(mut st, mn, MN_ALOCK)
            awPush(mut st, urAdd(mut st, ptoi(mut st, mn), MN_AWAIT * 8), ptoi(mut st, me))
            // 返した後にMN_AGENを読む（返し手の「番号を進める → チェーンを見る」と対）。その読みがxaddなので、返しの柵は要らない
            lockGiveFence(mut st, mn, MN_ALOCK)
            bSleep := newBlock(mut st)
            bOut := newBlock(mut st)
            bDone := newBlock(mut st)
            condbr(mut st, cmp(mut st, CEq, atomicXadd(mut st, mn, MN_AGEN, zero), gw), bSleep, -1, bOut, -1)
            // 番号が動いた: 鍵の下でチェーンから自分を外す（TC_AWPREV = 0ならウェイクアップする側がチェーンごと取った後）
            setCur(mut st, bOut)
            spinLock(mut st, mn, MN_ALOCK)
            bGone := newBlock(mut st)
            wHit := newBlock(mut st)
            pv := load(mut st, me, TC_AWPREV)
            condbr(mut st, cmp(mut st, CEq, pv, zero), bGone, -1, wHit, -1)
            setCur(mut st, wHit)
            awCut(mut st, pv, ptoi(mut st, me))
            // 柵は要らない: 返した後は入場を試し直すかtask_waitするだけ（相手のフラグを読まない）
            lockGiveFence(mut st, mn, MN_ALOCK)
            br(mut st, bDone, -1)
            // チェーンに居ない = ウェイクアップする側が取った（ウェイクアップが来ている／来る — 待って受ける）
            setCur(mut st, bGone)
            lockGiveFence(mut st, mn, MN_ALOCK)
            br(mut st, bSleep, -1)
            setCur(mut st, bSleep)
            call(mut st, st.rtTaskWait, list0(mut st))
            br(mut st, bDone, -1)
            setCur(mut st, bDone)
            br(mut st, bTry, -1)
            setCur(mut st, bInl2)
        }
        // 縮退: 足した量は戻さない（縮退した子の作業域も台帳に載せる — 走っている間は兄弟の入場がそれを見る）。量と節を task の表に置き、
        // 直後の rt.task_inline が子の終わりで返す
        atomicXadd(mut st, mn, MN_LINL, one)
        ledPeakAll(mut st, mn, rw)
        tk := globaladdr(mut st, st.taskG)
        store(mut st, tk, TK_INLE, e)
        store(mut st, tk, TK_INLN, n0)
        ret(mut st, itop(mut st, zero))
    }
    setCur(mut st, bJ)
    return Adm{e: re, node: rn}
}

// プールの節 n（足した後のワード nw）であふれた入場の待ち（admitIn の pw）: pw = 1・自分だけであふれていない・今の task が n から根へのチェーンに
// 計上されていない（TC_ADM = 0 か、入場した節 TC_NODE から根へのチェーンに n が無い）なら、待ちのチェーンに積んで譲り、起きたら bTry で試し直す。
// どれかが成り立たなければ戻る（呼び手が shed）。足した分は呼び手が戻した後
func poolWait(st mut St, n int, nw int, pw int, g0 int, bTry BlkRef) {
    mn := globaladdr(mut st, st.mnG)
    zero := iconst(mut st, 0)
    one := iconst(mut st, 1)
    me := itop(mut st, waitSelf(mut st))
    alone := cmp(mut st, CEq, poolTasks(mut st, gepWord(mut st, itop(mut st, n), iconst(mut st, SR_LED)), nw), one)
    bNo := newBlock(mut st)
    bChk := newBlock(mut st)
    condbr(mut st, bin(mut st, BAnd, cmp(mut st, CNe, pw, zero), cmp(mut st, CEq, alone, zero)), bChk, -1, bNo, -1)
    setCur(mut st, bChk)
    cl := newBlock(mut st)
    m := param(mut st, cl, TyI64)
    cb := newBlock(mut st)
    ch := newBlock(mut st)
    bW := newBlock(mut st)
    br(mut st, cl, list1(mut st, bin(mut st, BMul, load(mut st, me, TC_NODE), cmp(mut st, CNe, load(mut st, me, TC_ADM), zero))))
    setCur(mut st, cl)
    condbr(mut st, cmp(mut st, CEq, m, zero), bW, -1, ch, -1)
    setCur(mut st, ch)
    condbr(mut st, cmp(mut st, CEq, m, n), bNo, -1, cb, -1)
    setCur(mut st, cb)
    br(mut st, cl, list1(mut st, load(mut st, itop(mut st, m), SR_PNODE)))
    setCur(mut st, bW)
    // 自分の戻しも番号を進める（自分の足しで塞がった他の待ち手のため）。進める前の番号が g0 でなければ、試しの後に返しがあった — 待たずに試し直す
    gp := ledWakeG(mut st)
    bW2 := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, gp, g0), bW2, -1, bTry, -1)
    setCur(mut st, bW2)
    atomicXadd(mut st, mn, MN_LWAIT, one)
    gw := bin(mut st, BAdd, g0, one)
    spinLock(mut st, mn, MN_ALOCK)
    awPush(mut st, urAdd(mut st, ptoi(mut st, mn), MN_AWAIT * 8), ptoi(mut st, me))
    lockGiveFence(mut st, mn, MN_ALOCK)
    bSleep := newBlock(mut st)
    bOut := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, atomicXadd(mut st, mn, MN_AGEN, zero), gw), bSleep, -1, bOut, -1)
    setCur(mut st, bOut)
    spinLock(mut st, mn, MN_ALOCK)
    bGone := newBlock(mut st)
    wHit := newBlock(mut st)
    pv := load(mut st, me, TC_AWPREV)
    condbr(mut st, cmp(mut st, CEq, pv, zero), bGone, -1, wHit, -1)
    setCur(mut st, wHit)
    awCut(mut st, pv, ptoi(mut st, me))
    lockGiveFence(mut st, mn, MN_ALOCK)
    br(mut st, bTry, -1)
    setCur(mut st, bGone)
    lockGiveFence(mut st, mn, MN_ALOCK)
    br(mut st, bSleep, -1)
    setCur(mut st, bSleep)
    call(mut st, st.rtTaskWait, list0(mut st))
    br(mut st, bTry, -1)
    setCur(mut st, bNo)
}

// ── taskの数の天井（プールの節の PL_TCAP — std/net の Serve の節だけ）: 台帳のワードの task の数のフィールドの起点を LED_TMAX − 天井 にずらす。
// フィールドの読み（poolTasks・nodeTasks）と天井の書き（poolTcapSet）はここの3つだけが行う ──

// プールの節（slot = 台帳のワードの番地 — 節の番地 + SR_LED ワード）の、台帳のワード w の task の数
func poolTasks(st mut St, slot int, w int) int {
    tc := load(mut st, slot, PL_TCAP - SR_LED)
    f := bin(mut st, BAnd, bin(mut st, BSar, w, iconst(mut st, LED_TSHIFT)), iconst(mut st, 2 * LED_TMAX + 1))
    return bin(mut st, BSub, f, bin(mut st, BMul, bin(mut st, BSub, iconst(mut st, LED_TMAX), tc), cmp(mut st, CNe, tc, iconst(mut st, 0))))
}

// 節nが名前つきプールの節（表rt.poolsの中の番地）なら1（プールを使わないプログラムは0）
func poolNodeBit(st mut St, n int) int {
    if !st.poolOn {
        return iconst(mut st, 0)
    }
    pg := ptoi(mut st, globaladdr(mut st, st.poolG))
    return bin(mut st, BAnd, cmp(mut st, CGe, n, pg), cmp(mut st, CLt, n, bin(mut st, BAdd, pg, iconst(mut st, (1 + POOL_MAX * POOL_W) * 8))))
}

// 節nに足す入場の量: 普通のspawn（plain = 1）はプールの節にtaskの数を足さない（`conns:` = 接続の本数の天井 — プールの節の本数は
// SpawnInで入るtaskだけ。接続のtaskの子〔HTTP/2のストリームなど〕はバイトだけを節に足す）。scopeのbudget:の節と根は今どおり数える
func ledNodeE(st mut St, n int, e int, plain int) int {
    // ミュータント114（検査の自己検査 — std/http/serverのTestH2Conns）: 普通のspawnもプールの節にtaskの数を足す（`conns:` の節がストリームの子で埋まる）
    if st.rtMut == 114 || !st.poolOn {
        return e
    }
    return bin(mut st, BSub, e, bin(mut st, BMul, bin(mut st, BAnd, plain, poolNodeBit(mut st, n)), iconst(mut st, LED_ONE)))
}

// 天井の節 n（scope の budget: の節かプールの節）の、台帳のワード w の task の数。プールの節は表 rt.pools の中の番地で見分ける
// （scope の節の記録には PL_TCAP の語が無いので読まない）
func nodeTasks(st mut St, n int, w int) int {
    f := bin(mut st, BAnd, bin(mut st, BSar, w, iconst(mut st, LED_TSHIFT)), iconst(mut st, 2 * LED_TMAX + 1))
    if !st.poolOn {
        return f
    }
    pg := ptoi(mut st, globaladdr(mut st, st.poolG))
    inPool := bin(mut st, BAnd, cmp(mut st, CGe, n, pg), cmp(mut st, CLt, n, bin(mut st, BAdd, pg, iconst(mut st, (1 + POOL_MAX * POOL_W) * 8))))
    bP := newBlock(mut st)
    bJ := newBlock(mut st)
    r := param(mut st, bJ, TyI64)
    condbr(mut st, inPool, bP, -1, bJ, list1(mut st, f))
    setCur(mut st, bP)
    br(mut st, bJ, list1(mut st, poolTasks(mut st, gepWord(mut st, itop(mut st, n), iconst(mut st, SR_LED)), w)))
    setCur(mut st, bJ)
    return r
}

// プールの節 w の taskの数の天井を n（1 未満は 1）にする: 起点を LED_TMAX − n に（今の起点との差を足す — 入場中の task の数はそのまま）
func poolTcapSet(st mut St, w int, n int) {
    zero := iconst(mut st, 0)
    pn := itop(mut st, w)
    tco := load(mut st, pn, PL_TCAP)
    ob := bin(mut st, BMul, bin(mut st, BSub, iconst(mut st, LED_TMAX), tco), cmp(mut st, CNe, tco, zero))
    nn := imax(mut st, n, iconst(mut st, 1))
    nb := bin(mut st, BSub, iconst(mut st, LED_TMAX), nn)
    atomicXadd(mut st, pn, SR_LED, bin(mut st, BShl, bin(mut st, BSub, nb, ob), iconst(mut st, LED_TSHIFT)))
    store(mut st, pn, PL_TCAP, nn)
}

// 台帳を返した点（task の終わり・縮退の終わり・入場の戻し — wait の scope があるプログラムだけ呼ぶ）の後: 返しの番号を進め、入場を待つ task が
// いればrt.admit_wakeで全部ウェイクアップする（進める前の番号を返す）。返し手は「足す → 番号を進める → チェーンを見る」・待ち手は「チェーンに積む → 番号を見る」の順（どちらかが相手を見る）
func ledWakeG(st mut St) int {
    mn := globaladdr(mut st, st.mnG)
    g := atomicXadd(mut st, mn, MN_AGEN, iconst(mut st, 1))
    bW := newBlock(mut st)
    bD := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, load(mut st, mn, MN_AWAIT), iconst(mut st, 0)), bW, -1, bD, -1)
    setCur(mut st, bW)
    call(mut st, awFn(st.rtD3), list0(mut st))
    br(mut st, bD, -1)
    setCur(mut st, bD)
    if st.muxUse {
        // 入場の空きを待つHTTP/2の接続（muxの記録の登録簿 — mux.sober）にも、空いたことを知らせる。muxUseはneedMuxで立つので、
        // rtの組み立てのときに組む返しの点（taskの終わり・縮退の終わり）では必ず効く。spawnの点で先に下ろした返し（SpawnInのshed）は知らせないことがある
        // （他の返しが知らせる）
        bR := branchIf(mut st, cmp(mut st, CNe, load(mut st, mn, MN_MROOM), iconst(mut st, 0)))
        _ = needMux(mut st)
        call(mut st, st.rtMuxRoom, list0(mut st))
        br(mut st, bR, -1)
        setCur(mut st, bR)
    }
    return g
}

// rt.admit_wake(): 鍵の下で待ちのチェーンを丸ごと取り、全部を走れるようにする（ウェイクアップされたtaskは入場を試し直す — 入れなければまた待つ）
func buildAdmitWake(st mut St) {
    begin(mut st, awFn(st.rtD3))
    mn := globaladdr(mut st, st.mnG)
    zero := iconst(mut st, 0)
    spinLock(mut st, mn, MN_ALOCK)
    h := load(mut st, mn, MN_AWAIT)
    store(mut st, mn, MN_AWAIT, zero)
    // 取った節のTC_AWPREVを鍵の下で0に（番号が動いて自分を外しに来る待ち手に「チェーンに居ない」を見せる）
    cl := newBlock(mut st)
    ct := param(mut st, cl, TyI64)
    cb := newBlock(mut st)
    cd := newBlock(mut st)
    br(mut st, cl, list1(mut st, h))
    setCur(mut st, cl)
    condbr(mut st, cmp(mut st, CEq, ct, zero), cd, -1, cb, -1)
    setCur(mut st, cb)
    store(mut st, itop(mut st, ct), TC_AWPREV, zero)
    br(mut st, cl, list1(mut st, load(mut st, itop(mut st, ct), TC_AWNEXT)))
    setCur(mut st, cd)
    // 柵は要らない: 返した後は取ったチェーン（もう誰も書かない）を歩くだけ
    lockGiveFence(mut st, mn, MN_ALOCK)
    loop := newBlock(mut st)
    t := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, list1(mut st, h))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CEq, t, zero), done, -1, body, -1)
    setCur(mut st, body)
    tp := itop(mut st, t)
    nx := load(mut st, tp, TC_AWNEXT)
    taskWakeAny(mut st, tp)
    br(mut st, loop, list1(mut st, nx))
    setCur(mut st, done)
    ret(mut st, -1)
}

// 計測のときだけ、根のワードrw（足した後）の計上中のバイトでMN_LPEAKAの高水位を上げる（あふれビットを値に含める — 天井を超えた計上も数える）
func ledPeakAll(st mut St, mn int, rw int) {
    bS := newBlock(mut st)
    bD := newBlock(mut st)
    condbr(mut st, pstatOn(mut st), bS, -1, bD, -1)
    setCur(mut st, bS)
    atomicMax(mut st, mn, MN_LPEAKA, bin(mut st, BAdd, load(mut st, mn, MN_CAP), bin(mut st, BSub, bin(mut st, BAnd, rw, iconst(mut st, 2 * LED_BMAX + 1)), iconst(mut st, LED_BMAX))))
    br(mut st, bD, -1)
    setCur(mut st, bD)
}

// 天井の節のチェーンをn0からstopの手前まで辿り、各節からeを引く（plain = 1: 普通のspawnの量 — プールの節ではtaskの数を引かない。ledNodeE。
// プールを使わないプログラムでは読まない — 呼び手は値を作らずに -1 を渡してよい）
func ledUndo(st mut St, n0 int, stop int, e int, plain int) {
    loop := newBlock(mut st)
    n := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, list1(mut st, n0))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CEq, n, stop), done, -1, body, -1)
    setCur(mut st, body)
    np := itop(mut st, n)
    atomicXadd(mut st, np, SR_LED, bin(mut st, BSub, iconst(mut st, 0), ledNodeE(mut st, n, e, plain)))
    br(mut st, loop, list1(mut st, load(mut st, np, SR_PNODE)))
    setCur(mut st, done)
}

// 見積もりの表を全部 EST_MARK に（入口で 1 度 — rt.pcap_init から）
func pestInit(st mut St) {
    pe := globaladdr(mut st, st.pestG)
    for k <- iter.Range(0, st.nsite + 1) {
        store(mut st, pe, k, iconst(mut st, EST_MARK))
    }
}

// rt.task_inline(frame, kid, idx, koff)（縮退 — 入場できない子をその場で）: 今のチャンクのフィールドを子のものへ付け替えて罠を張って呼び、
// 枠に死因・状態を書き、scopeの記録の死の数を数え、フィールドを戻す。生きている子の数・出力の区間・ウェイクアップには触れない（子のhandleはまだ誰も持っていない）
func buildTaskInline(st mut St) {
    begin(mut st, st.rtTaskInline)
    frame := 0
    tk := globaladdr(mut st, st.taskG)
    me := itop(mut st, load(mut st, tk, TK_CUR))
    // 縮退の記帳（admitIn が rt.task_new の中で置いた量と節 — 子の終わりで返す）
    ie := load(mut st, tk, TK_INLE)
    inode := load(mut st, tk, TK_INLN)
    f0 := load(mut st, me, TC_FRAME)
    k0 := load(mut st, me, TC_KID)
    o0 := load(mut st, me, TC_KOFF)
    c0 := load(mut st, me, TC_CUTOK)
    i0 := load(mut st, me, TC_IDX)
    s0 := load(mut st, me, TC_SCOPE)
    cn0 := load(mut st, me, TC_CNODE)
    zero := iconst(mut st, 0)
    // 縮退した子の間は wait の外（子は親の上で走る — 子の中の spawn は待たない。子が wait の scope を開けばその間だけ立つ）
    w0 := if awFn(st.rtD3) != 0 { load(mut st, me, TC_WAIT) } else { zero }
    if awFn(st.rtD3) != 0 {
        store(mut st, me, TC_WAIT, zero)
    }
    // 期限は親の上で走る子もそのまま継ぐ — 子が deadline: の scope の中で死ぬと戻らないので、出口で戻す（TC_CNODE と同じ）
    dl0 := if dlFn(st.rtD3) != 0 { load(mut st, me, TC_DL) } else { zero }
    store(mut st, me, TC_FRAME, ptoi(mut st, frame))
    store(mut st, me, TC_KID, 1)
    store(mut st, me, TC_KOFF, 3)
    store(mut st, me, TC_CUTOK, zero)
    store(mut st, me, TC_IDX, 2)
    store(mut st, me, TC_SCOPE, zero)
    // 罠の前の深度・宛先 / anchor のレジスタ（巻き戻りは子の epilogue を飛ばすので、ここで戻す — P3a の即時形と同じ後始末・trap.sober）
    meta := globaladdr(mut st, st.meta)
    d0 := regionDepth(mut st)
    dest0 := load(mut st, meta, W_DEST)
    anc0 := load(mut st, meta, W_ANCHOR)
    // 子が開くfd・ストリームは今のtask（親）のチェーンに積まれる — 子が死んだら子に入る前の頭まで閉じる（taskの出口のfd_drain / chunk_drainと同じ後始末）
    fh := if st.rtFdDrain != -1 { load(mut st, me, TC_FDS) } else { zero }
    chh := if chF(mut st, CHF_DRAIN) != -1 { load(mut st, me, TC_CHS) } else { zero }
    lh := if st.rtLeaseDrain != -1 { load(mut st, me, TC_LEASE) } else { zero }
    // 子の死の印（rt.task_newが入場できずに残した、今のtaskの次のspawn 1回の印 — この子のもの）
    // 子の間は今のtaskのTC_DIEに置く（子が終わりを兼ねる合図を積むとmuxDieClearがそこで消す — 返った点でTC_DIEを読み直し、親の値に戻す）
    dn := if st.dieOn { load(mut st, me, TC_DNEXT) } else { zero }
    bo := if st.dieOn { load(mut st, me, TC_BLOB) } else { zero }
    dp := if st.dieOn { load(mut st, me, TC_DIE) } else { zero }
    if st.dieOn {
        store(mut st, me, TC_DNEXT, zero)
        store(mut st, me, TC_DIE, dn)
        // 要求の塊の持ち主: 子の間だけ今のtask（親）のTC_BLOBに置き、返った点で返して親の値に戻す
        store(mut st, me, TC_BLOB, load(mut st, me, TC_BNEXT))
        store(mut st, me, TC_BNEXT, zero)
    }
    // 子は親のスタックの上で走る（今のtaskは親のまま）。親が接続のtaskなら、子の間はフラグ（bit 0）とAREA_NEARを消す: 子の本体の入口のprologueは
    // 素通りになり（エリアへ付け替えない。入口がページ0にある前提が成り立たない）、子のrt.netwaitは深くスリープする（浅い着地はワーカーのエリアの頂上で、
    // 親の枠を上書きしうる）。子が止まったときの交換は親の本当の位置（bit 1）で決まる。返った点（死んで罠から戻った点も同じ）で戻す。
    // ミュータント90 = 消さない（子の本体がエリアの付け替えをして、親の枠のあるエリアを交換で渡すか上書きする。areacheckの縮退の相）・92 = 90 + 切り替えの点の照合
    mut onw0 := zero
    if st.areaOn && st.rtMut != 90 && st.rtMut != 92 {
        ow := load(mut st, me, TC_ONW)
        onw0 = bin(mut st, BAnd, ow, iconst(mut st, 1 + AREA_NEAR))
        store(mut st, me, TC_ONW, bin(mut st, BAnd, ow, iconst(mut st, -1 - 1 - AREA_NEAR)))
    }
    mut r := zero
    if st.rtMut == 8 {
        // ミュータント8（検査の自己検査 — parbudget）: 縮退した子の罠を張らない（子の死が親の死に化ける）
        callIndirect(mut st, 1, list1(mut st, fieldPtr(mut st, frame, FR_RES)), -1)
    } else {
        // ミュータント97（rt.segvの検査。segvcheck）: 本体の代わりに不正な番地を読む子を罠の中で呼ぶ
        r = trapCall(mut st, if st.rtMut == 97 { funcaddr(mut st, st.rtSegvProbe) } else { 1 }, fieldPtr(mut st, frame, FR_RES))
    }
    if st.areaOn && st.rtMut != 90 && st.rtMut != 92 {
        store(mut st, me, TC_ONW, bin(mut st, BOr, load(mut st, me, TC_ONW), onw0))
    }
    if st.domUse {
        // 縮退した子は親の TCB の上で走る — 子の本体で死んだら親の TC_DOM に残る
        domDiedIn(mut st, me)
    }
    cellDiedIn(mut st, me)
    if st.dieOn {
        muxDieMark(mut st, load(mut st, me, TC_DIE), r)
        store(mut st, me, TC_DIE, dp)
        blobOwnEnd(mut st, me)
        store(mut st, me, TC_BLOB, bo)
    }
    if st.rtLeaseDrain != -1 {
        call(mut st, st.rtLeaseDrain, list2(mut st, me, lh))
    }
    if chF(mut st, CHF_DRAIN) != -1 {
        call(mut st, chF(mut st, CHF_DRAIN), list2(mut st, me, chh))
    }
    if st.rtFdDrain != -1 {
        call(mut st, st.rtFdDrain, list3(mut st, me, fh, iconst(mut st, 0)))
    }
    regionSetDepth(mut st, d0)
    store(mut st, meta, W_DEST, dest0)
    store(mut st, meta, W_ANCHOR, anc0)
    tg := globaladdr(mut st, st.trapG)
    store(mut st, frame, FR_CAUSE, bin(mut st, BOr, bin(mut st, BShl, load(mut st, tg, TW_SITE), iconst(mut st, 8)), load(mut st, tg, TW_CODE)))
    // 死んだら後ろの兄弟の打ち切りのマーク・開いているscopeの子を待つ（rt.cut_end — 縮退した子は切られる側にならない: TC_CUTOK = 0）
    cut := cutEnd(mut st, me, frame, r)
    dead := bin(mut st, BMul, r, bin(mut st, BSub, iconst(mut st, 1), cut))
    store(mut st, frame, FR_STATE, bin(mut st, BAdd, bin(mut st, BAdd, r, iconst(mut st, 1)), bin(mut st, BMul, cut, bin(mut st, BSub, iconst(mut st, 2), r))))
    rec := itop(mut st, load(mut st, frame, FR_SREC))
    deadAdd(mut st, rec, dead)
    frameDrop(mut st, frame, rec, dead)
    store(mut st, me, TC_FRAME, f0)
    store(mut st, me, TC_KID, k0)
    store(mut st, me, TC_KOFF, o0)
    store(mut st, me, TC_CUTOK, c0)
    store(mut st, me, TC_IDX, i0)
    store(mut st, me, TC_SCOPE, s0)
    // 子が budget: の scope の中で死ぬと今効いている節が戻らない — ここで戻す
    store(mut st, me, TC_CNODE, cn0)
    // 縮退の記帳を返す（子と、子が開いたscopeの子孫は全部終わった後 — ミュータント7は入場したtaskの返しと同じく返さない）
    if awFn(st.rtD3) != 0 {
        store(mut st, me, TC_WAIT, w0)
    }
    if dlFn(st.rtD3) != 0 {
        store(mut st, me, TC_DL, dl0)
    }
    if st.rtMut != 7 {
        atomicXadd(mut st, globaladdr(mut st, st.mnG), MN_LED, bin(mut st, BSub, zero, ie))
        ledUndo(mut st, inode, zero, ie, if st.poolOn { iconst(mut st, 1) } else { 0 - 1 })
        if awFn(st.rtD3) != 0 {
            _ = ledWakeG(mut st)
        }
    }
    ret(mut st, -1)
}

// task tcb の終わり（結果を公開した後・待ち手をウェイクアップする前 — ウェイクアップされたscopeの出口より先に台帳が空く）: 入場で足した量を根と天井の節
// （TC_NODE から）から引く（入場していない task〔走らせ直し〕は 0）
func admitReturn(st mut St, tcb int) {
    if st.rtMut == 7 {
        // ミュータント7（検査の自己検査 — parbudget）: 終わりで台帳へ返さない（漏れ — 入場が細り続け縮退が増える）
        return
    }
    // 借りた量は借りの和から引く（台帳のワードには足していない）。ミュータント109（parbudget・httpcheckの検査）: 借りた分を返さない（こことrt.bor_give）
    if st.rtMut != 109 {
        bor := borAmount(mut st, tcb)
        bB := newBlock(mut st)
        bB2 := newBlock(mut st)
        condbr(mut st, cmp(mut st, CNe, bor, iconst(mut st, 0)), bB, -1, bB2, -1)
        setCur(mut st, bB)
        _ = ledBorrowAdd(mut st, tcb, bin(mut st, BSub, iconst(mut st, 0), bor), iconst(mut st, 0))
        br(mut st, bB2, -1)
        setCur(mut st, bB2)
    }
    a0 := load(mut st, tcb, TC_ADM)
    if st.poolOn {
        // 返し終えた印（parkShrink が見る — 終わりの切り替えで縮めない）
        store(mut st, tcb, TC_ONW, bin(mut st, BOr, load(mut st, tcb, TC_ONW), iconst(mut st, ONW_GONE)))
    }
    // 印ADM_PLAINはプールを使うプログラムだけが付ける
    a := if st.poolOn { bin(mut st, BAnd, a0, iconst(mut st, -1 - ADM_PLAIN)) } else { a0 }
    n0 := load(mut st, tcb, TC_NODE)
    mut bEnd := BlkRef(-1)
    if st.poolOn && st.areaOn {
        // 普通のspawnの子の返しは、待ちの台帳の縮めと同じワーカーごとの未反映の量（WK_PDEBT）に溜める（台帳を本当の値より多く見せる側）。
        // 溜めるのは: 節がWK_PNODEと同じ・待ち手がいない（溜めた返しは待ち手を起こさない）・溜めがPARK_Qに届かない。届かなければ溜めを反映してから今の返し。
        // ミュータント130 = 待ち手がいても溜める（入場の待ちと天井の待ちが、古い台帳のまま起こされない）
        wk := globaladdr(mut st, st.wkG)
        nd := bin(mut st, BAdd, load(mut st, wk, WK_PDEBT), a)
        okD := bin(mut st, BAnd, bin(mut st, BAnd, cmp(mut st, CNe, bin(mut st, BAnd, a0, iconst(mut st, ADM_PLAIN)), iconst(mut st, 0)), cmp(mut st, CEq, load(mut st, wk, WK_PNODE), n0)),
            cmp(mut st, CLt, bin(mut st, BAnd, nd, iconst(mut st, LED_BMAX)), iconst(mut st, PARK_Q)))
        ok := if ledMut(mut st, 130) { okD } else { bin(mut st, BAnd, okD, cmp(mut st, CEq, ledWaiters(mut st), iconst(mut st, 0))) }
        bEnd = newBlock(mut st)
        bD := newBlock(mut st)
        bX := newBlock(mut st)
        condbr(mut st, ok, bD, -1, bX, -1)
        setCur(mut st, bD)
        if ledChk(mut st) {
            ledChkFail(mut st, ledWaiters(mut st), "led-check: a child's return was deferred while a waiter was registered\n")
        }
        store(mut st, wk, WK_PDEBT, nd)
        br(mut st, bEnd, -1)
        setCur(mut st, bX)
        parkFlush(mut st)
    }
    atomicXadd(mut st, globaladdr(mut st, st.mnG), MN_LED, bin(mut st, BSub, iconst(mut st, 0), a))
    bU := newBlock(mut st)
    bU2 := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, n0, iconst(mut st, 0)), bU, -1, bU2, -1)
    setCur(mut st, bU)
    ledUndo(mut st, n0, iconst(mut st, 0), a, if st.poolOn { cmp(mut st, CNe, bin(mut st, BAnd, a0, iconst(mut st, ADM_PLAIN)), iconst(mut st, 0)) } else { 0 - 1 })
    br(mut st, bU2, -1)
    setCur(mut st, bU2)
    if awFn(st.rtD3) != 0 {
        _ = ledWakeG(mut st)
    }
    ceilWake(mut st)
    if bEnd != -1 {
        br(mut st, bEnd, -1)
        setCur(mut st, bEnd)
    }
}

// 照合のbuild（ミュータント134〜137 — scripts/parkres.sh）: 134 = 子の返しの溜めの不変条件の照合だけ・135 / 136 / 137 = 130 / 132 / 133 + 照合。
// 通常のbuildは照合を組まない（IRは不変）
func ledChk(st mut St) bool {
    return st.rtMut >= 134 && st.rtMut <= 137
}

// ミュータント m（130・132・133）か、その照合つきの版（135・136・137）か
func ledMut(st mut St, m int) bool {
    return st.rtMut == m || st.rtMut == (if m == 130 { 135 } else if m == 132 { 136 } else { 137 })
}

// 照合のbuildの破れ: c ≠ 0なら印字して終了コード103
func ledChkFail(st mut St, c int, msg string) {
    bF := newBlock(mut st)
    bJ := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, c, iconst(mut st, 0)), bF, -1, bJ, -1)
    setCur(mut st, bF)
    toStderr(mut st, globaladdr(mut st, st.meta))
    printLit(mut st, msg)
    call(mut st, st.rtFlush, list0(mut st))
    exit(mut st, 103)
    setCur(mut st, bJ)
}

// 台帳の返しを待つ者がいるか（0 = いない）: 入場の待ちのチェーン・HTTP/2の接続の入場の空きの登録簿・天井の待ちの列の頭。どれも書かれるのがまれな語
func ledWaiters(st mut St) int {
    mn := globaladdr(mut st, st.mnG)
    mut w := iconst(mut st, 0)
    if awFn(st.rtD3) != 0 {
        w = bin(mut st, BOr, w, load(mut st, mn, MN_AWAIT))
    }
    if st.muxUse {
        w = bin(mut st, BOr, w, load(mut st, mn, MN_MROOM))
    }
    if st.rdlOn {
        w = bin(mut st, BOr, w, load(mut st, mn, MN_CQH))
    }
    return w
}

// 終わる task tcb の死（dead = 1）を、入場した節（TC_NODE）が名前つきプールの節ならその死の数へ足す（名前つきプールを使うプログラムだけ —
// 高速パスはdeadの比較1つ・死んだときだけ節の番地が表の範囲かを見る〔scopeのbudget: の節は数えない〕）
func poolDied(st mut St, tcb int, dead int) {
    if !st.poolOn {
        return
    }
    bD := newBlock(mut st)
    bEnd := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, dead, iconst(mut st, 0)), bD, -1, bEnd, -1)
    setCur(mut st, bD)
    poolCount(mut st, load(mut st, tcb, TC_NODE), PL_DIED)
    br(mut st, bEnd, -1)
    setCur(mut st, bEnd)
}

// 節n0が名前つきプールの節（表の範囲 — scopeのbudget:の節は数えない）なら、そのワードwへ1足す（名前つきプールを使わないプログラムは何もしない）
func poolCount(st mut St, n0 int, w int) {
    if !st.poolOn {
        return
    }
    bIn := newBlock(mut st)
    bEnd := newBlock(mut st)
    lo := bin(mut st, BSub, bin(mut st, BAdd, ptoi(mut st, globaladdr(mut st, st.poolG)), iconst(mut st, 8)), iconst(mut st, SR_LED * 8))
    off := bin(mut st, BSub, n0, lo)
    condbr(mut st, bin(mut st, BAnd, cmp(mut st, CGe, off, iconst(mut st, 0)), cmp(mut st, CLt, off, iconst(mut st, POOL_MAX * POOL_W * 8))), bIn, -1, bEnd, -1)
    setCur(mut st, bIn)
    atomicXadd(mut st, itop(mut st, n0), w, iconst(mut st, 1))
    br(mut st, bEnd, -1)
    setCur(mut st, bEnd)
}

// task tcb の終わり（acc = 自前のスロットの使った量の和 — slotReleaseの数え）: 観測（acc + EST_FLOOR〔機械スタック・チャンクのページ — 終わりのbumpは
// 数えない〕+ 1 task）が足した量aを超えたかaが観測の前のマーク（奇数）ならrt.est_up（見積もりを上げる・宣言のあるtaskは宣言超過を数える）。
// 高速パスはTCBのaと比べるだけ — 表を読まない
func admitEnd(st mut St, tcb int, acc int) {
    a := if st.poolOn { bin(mut st, BAnd, load(mut st, tcb, TC_ADM), iconst(mut st, -1 - ADM_PLAIN)) } else { load(mut st, tcb, TC_ADM) }
    nwE := bin(mut st, BAdd, acc, iconst(mut st, EST_FLOOR + LED_ONE))
    bW := newBlock(mut st)
    bN := newBlock(mut st)
    // マーク〔奇数〕は2^62を引いて比べる = 最初の観測が必ず勝つ。a = 0（走らせ直し）はspawnの点0へ書く（使わないフィールド）
    condbr(mut st, cmp(mut st, CGt, nwE, bin(mut st, BSub, a, bin(mut st, BShl, bin(mut st, BAnd, a, iconst(mut st, 1)), iconst(mut st, 62)))), bW, -1, bN, -1)
    setCur(mut st, bW)
    call(mut st, st.rtEstUp, list2(mut st, tcb, acc))
    br(mut st, bN, -1)
    setCur(mut st, bN)
}

// rt.est_up(tcb, acc): 宣言のある task は使用量 acc が宣言を超えたら宣言超過を数える（見積もりの表は動かさない — 宣言 > 見積もり）。
// 無ければspawnの点の見積もりをacc + EST_FLOOR + 1 taskへ上げる（今の値がマーク〔奇数〕なら必ず書く・それ以外は大きいときだけ — CAS）
func buildEstUp(st mut St) {
    begin(mut st, st.rtEstUp)
    d := load(mut st, 0, TC_DECL)
    bDecl := newBlock(mut st)
    bEst := newBlock(mut st)
    bOver := newBlock(mut st)
    bRet := newBlock(mut st)
    condbr(mut st, cmp(mut st, CGt, d, iconst(mut st, 0)), bDecl, -1, bEst, -1)
    setCur(mut st, bDecl)
    condbr(mut st, cmp(mut st, CGt, 1, d), bOver, -1, bRet, -1)
    setCur(mut st, bOver)
    atomicXadd(mut st, globaladdr(mut st, st.mnG), MN_LDOVER, iconst(mut st, 1))
    // 高水位の数え（task.sober wmRaiseTo）がまだ数えていなければ、ここで数える（終わりの使用量 ≤ 高水位）
    hwf := bin(mut st, BAnd, load(mut st, 0, TC_HW), iconst(mut st, HW_FLAG))
    bHw := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, hwf, iconst(mut st, 0)), bHw, -1, bRet, -1)
    setCur(mut st, bHw)
    atomicXadd(mut st, globaladdr(mut st, st.mnG), MN_LDOVERHW, iconst(mut st, 1))
    br(mut st, bRet, -1)
    setCur(mut st, bRet)
    ret(mut st, -1)
    setCur(mut st, bEst)
    v := bin(mut st, BAdd, 1, iconst(mut st, EST_FLOOR + LED_ONE))
    pe := gepWord(mut st, globaladdr(mut st, st.pestG), load(mut st, 0, TC_SITE))
    loop := newBlock(mut st)
    bTry := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, -1)
    setCur(mut st, loop)
    o := load(mut st, pe, 0)
    condbr(mut st, cmp(mut st, CGt, v, bin(mut st, BSub, o, bin(mut st, BShl, bin(mut st, BAnd, o, iconst(mut st, 1)), iconst(mut st, 62)))), bTry, -1, done, -1)
    setCur(mut st, bTry)
    r := atomicCas(mut st, pe, 0, o, v)
    condbr(mut st, cmp(mut st, CEq, r, o), done, -1, loop, -1)
    setCur(mut st, done)
    ret(mut st, -1)
}

// budget: の scope の記録 rec を天井の節にして今の task の今効いている節にする（b = 宣言のバイト — 0 以下なら節を作らない〔int? の nil〕）。
// taskの数のフィールドは天井なし（フィールドの最大 − フィールドの最大 = 0）。外の節 = 今効いている節
func ledNodeOpen(st mut St, rec int, b int) {
    me := itop(mut st, load(mut st, globaladdr(mut st, st.taskG), TK_CUR))
    bY := newBlock(mut st)
    bN := newBlock(mut st)
    condbr(mut st, cmp(mut st, CGt, b, iconst(mut st, 0)), bY, -1, bN, -1)
    setCur(mut st, bY)
    bc := imin(mut st, b, iconst(mut st, LED_BMAX))
    store(mut st, rec, SR_LED, bin(mut st, BSub, iconst(mut st, LED_BMAX), bc))
    store(mut st, rec, SR_PNODE, load(mut st, me, TC_CNODE))
    store(mut st, me, TC_CNODE, ptoi(mut st, rec))
    br(mut st, bN, -1)
    setCur(mut st, bN)
}

// budget: の scope の出口（子は全部終わった後）: 今効いている節を外へ戻す（節を作らなかった scope は今効いている節が rec でない — 触らない）
func ledNodeClose(st mut St, rec int) {
    me := itop(mut st, load(mut st, globaladdr(mut st, st.taskG), TK_CUR))
    bY := newBlock(mut st)
    bN := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, load(mut st, me, TC_CNODE), ptoi(mut st, rec)), bY, -1, bN, -1)
    setCur(mut st, bY)
    store(mut st, me, TC_CNODE, load(mut st, rec, SR_PNODE))
    br(mut st, bN, -1)
    setCur(mut st, bN)
}

// ── 借りる・返す（language.md 11 節「予算と admission」— 計上済みの上限の和 + 固定費が入場の量を越えた分）──
// 借りるのは入場したtaskだけ（mainと走らせ直しは台帳の外 — 予約が無い）。プールの節か根の天井を越えたら、借りを戻して死ぬ（RegionExceeded{cause: budget}）。
// scopeのbudget:の節は記帳だけ。TC_BORの下位2ビットは印（BOR_SCOPE = scopeの節だけがあふれた — taskごとに1回だけ数える）。量はBOR_UNITの倍数

const BOR_DIED = 1
const BOR_SCOPE = 2

// 借りた量（印を外したバイト）
func borAmount(st mut St, tp int) int {
    return bin(mut st, BAnd, load(mut st, tp, TC_BOR), iconst(mut st, BOR_AMASK))
}

// TC_BORの上位（BOR_PSHIFTから）= 手元の下限（BOR_UNITの数 — rt.ceil_needが本文の受けの間だけ置く。parkのrt.bor_giveはこの下限を割って返さない）
const BOR_PSHIFT = 44
const BOR_AMASK = 17592186044412
const BOR_PMASK = 262143

func borPin(st mut St, tp int) int {
    return bin(mut st, BMul, bin(mut st, BAnd, bin(mut st, BSar, load(mut st, tp, TC_BOR), iconst(mut st, BOR_PSHIFT)), iconst(mut st, BOR_PMASK)), iconst(mut st, BOR_UNIT))
}

// 借りの量amt（バイト — 負なら返す）を、入場した節（TC_NODE）から根までの借りの和へ足し、
// 「計上（台帳のワード）+ 借りの和」がバイトのフィールドの天井を越えた節の種類を印で返す（プールの節か根 = BOR_DIED・scopeのbudget:の節 = BOR_SCOPE）。
// 借りは台帳のワードに足さない（入場の判定は予約だけで決める）。借りの和を置くのは根（MN_LBSUM）とプールの節（PL_BSUM）。
// scopeの節には置き場が無いので、そのtaskの借りた量の合計（tot）だけで判定する（記帳だけの数え）
func ledBorrowAdd(st mut St, tp int, amt int, tot int) int {
    mn := globaladdr(mut st, st.mnG)
    zero := iconst(mut st, 0)
    ovB := iconst(mut st, LED_BMAX + 1)
    fm := iconst(mut st, 2 * LED_BMAX + 1)
    n0 := load(mut st, tp, TC_NODE)
    loop := newBlock(mut st)
    n := param(mut st, loop, TyI64)
    fl := param(mut st, loop, TyI64)
    bNode := newBlock(mut st)
    bRoot := newBlock(mut st)
    br(mut st, loop, list2(mut st, n0, zero))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CEq, n, zero), bRoot, -1, bNode, -1)
    setCur(mut st, bNode)
    np := itop(mut st, n)
    led := bin(mut st, BAnd, load(mut st, np, SR_LED), fm)
    bNx := newBlock(mut st)
    f2 := param(mut st, bNx, TyI64)
    if st.poolOn {
        lo := bin(mut st, BSub, bin(mut st, BAdd, ptoi(mut st, globaladdr(mut st, st.poolG)), iconst(mut st, 8)), iconst(mut st, SR_LED * 8))
        off := bin(mut st, BSub, n, lo)
        bP := newBlock(mut st)
        bS := newBlock(mut st)
        condbr(mut st, bin(mut st, BAnd, cmp(mut st, CGe, off, zero), cmp(mut st, CLt, off, iconst(mut st, POOL_MAX * POOL_W * 8))), bP, -1, bS, -1)
        setCur(mut st, bP)
        sp := bin(mut st, BAdd, atomicXadd(mut st, np, PL_BSUM, amt), amt)
        br(mut st, bNx, list1(mut st, bin(mut st, BOr, fl, bin(mut st, BMul, cmp(mut st, CNe, bin(mut st, BAnd, bin(mut st, BAdd, led, sp), ovB), zero), iconst(mut st, BOR_DIED)))))
        setCur(mut st, bS)
    }
    br(mut st, bNx, list1(mut st, bin(mut st, BOr, fl, bin(mut st, BMul, cmp(mut st, CNe, bin(mut st, BAnd, bin(mut st, BAdd, led, tot), ovB), zero), iconst(mut st, BOR_SCOPE)))))
    setCur(mut st, bNx)
    br(mut st, loop, list2(mut st, load(mut st, np, SR_PNODE), f2))
    setCur(mut st, bRoot)
    sr := bin(mut st, BAdd, atomicXadd(mut st, mn, MN_LBSUM, amt), amt)
    rl := bin(mut st, BAnd, load(mut st, mn, MN_LED), fm)
    return bin(mut st, BOr, fl, cmp(mut st, CNe, bin(mut st, BAnd, bin(mut st, BAdd, rl, sr), ovB), zero))
}

// 手元 = 入場の量（TC_ADMのバイト）+ 借りた量
func borrowHave(st mut St, tp int) int {
    return bin(mut st, BAdd, bin(mut st, BAnd, load(mut st, tp, TC_ADM), iconst(mut st, LED_BMAX)), borAmount(mut st, tp))
}

// 印の種類kの数えのワードwへ、まだ数えていなければ1足す
func borCount(st mut St, fl int, old int, k int, w int) {
    b := newBlock(mut st)
    b2 := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, bin(mut st, BAnd, bin(mut st, BAnd, fl, bin(mut st, BXor, old, iconst(mut st, -1))), iconst(mut st, k)), iconst(mut st, 0)), b2, -1, b, -1)
    setCur(mut st, b)
    atomicXadd(mut st, globaladdr(mut st, st.mnG), w, iconst(mut st, 1))
    br(mut st, b2, -1)
    setCur(mut st, b2)
}

// 低速パスの終わり（wmRaiseTo — chg = 自前の深度の計上済みの上限の和）: 入場したtaskのchg + 固定費が手元を越えたら、越えた分をBOR_UNITに切り上げて借りる。
// プールの節か根があふれたら、足した借りを戻し、入場した節がプールの節ならその天井で切った数（PL_CUT）と根の数（MN_LBORD）を足して死ぬ
// （RegionExceeded{cause: budget} — 罠の経路は他の102と同じ。Serveの接続は何も送らずに閉じる）。scopeの節だけのあふれは1回だけ数えて続ける（MN_LBORS）
func borrowIn(st mut St, tp int, chg int) {
    need := bin(mut st, BAdd, chg, iconst(mut st, TASK_FIXED))
    short := bin(mut st, BSub, need, borrowHave(mut st, tp))
    bB := newBlock(mut st)
    bE := newBlock(mut st)
    condbr(mut st, bin(mut st, BAnd, cmp(mut st, CGt, short, iconst(mut st, 0)), cmp(mut st, CNe, load(mut st, tp, TC_ADM), iconst(mut st, 0))), bB, -1, bE, -1)
    setCur(mut st, bB)
    b := bin(mut st, BAnd, bin(mut st, BAdd, short, iconst(mut st, BOR_UNIT - 1)), iconst(mut st, -BOR_UNIT))
    old := load(mut st, tp, TC_BOR)
    fl0 := ledBorrowAdd(mut st, tp, b, bin(mut st, BAdd, bin(mut st, BAnd, old, iconst(mut st, -4)), b))
    // ミュータント108（parbudgetの検査）: scopeの節のあふれでも死ぬ
    fl := if st.rtMut == 108 { bin(mut st, BOr, fl0, bin(mut st, BMul, cmp(mut st, CNe, bin(mut st, BAnd, fl0, iconst(mut st, BOR_SCOPE)), iconst(mut st, 0)), iconst(mut st, BOR_DIED))) } else { fl0 }
    bD := newBlock(mut st)
    bL := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, bin(mut st, BAnd, fl, iconst(mut st, BOR_DIED)), iconst(mut st, 0)), bD, -1, bL, -1)
    setCur(mut st, bD)
    _ = ledBorrowAdd(mut st, tp, bin(mut st, BSub, iconst(mut st, 0), b), iconst(mut st, 0))
    atomicXadd(mut st, globaladdr(mut st, st.mnG), MN_LBORD, iconst(mut st, 1))
    poolCount(mut st, load(mut st, tp, TC_NODE), PL_CUT)
    memPanic(mut st, PM_BUDGET)
    setCur(mut st, bL)
    borCount(mut st, fl, old, BOR_SCOPE, MN_LBORS)
    store(mut st, tp, TC_BOR, bin(mut st, BOr, bin(mut st, BAdd, old, b), fl))
    br(mut st, bE, -1)
    setCur(mut st, bE)
}

// rt.bor_give(tcb): parkで自前の範囲を縮めた後（借りた量が0でないtaskだけ — parkRelease）: 手元が計上済みの上限の和 + 固定費を越えた分を
// BOR_UNITに切り下げて（借りた量まで）節へ返す。待っているtaskは要らない借りを持たない（借りと返しの往復は、宣言の内に収まらないtaskの低速パスとparkにしか起きない）
func buildBorGive(st mut St) {
    begin(mut st, st.rtBorGive)
    tp := 0
    meta := globaladdr(mut st, st.meta)
    sg := globaladdr(mut st, st.slotsG)
    need := imax(mut st, bin(mut st, BAdd, wmCharged(mut st, meta, sg, ptoi(mut st, tp)), iconst(mut st, TASK_FIXED)), borPin(mut st, tp))
    ex := bin(mut st, BSub, borrowHave(mut st, tp), need)
    bor := borAmount(mut st, tp)
    r := imin(mut st, bor, bin(mut st, BAnd, imax(mut st, ex, iconst(mut st, 0)), iconst(mut st, -BOR_UNIT)))
    bR := newBlock(mut st)
    bE := newBlock(mut st)
    condbr(mut st, cmp(mut st, CGt, r, iconst(mut st, 0)), bR, -1, bE, -1)
    setCur(mut st, bR)
    if st.rtMut != 109 {
        store(mut st, tp, TC_BOR, bin(mut st, BSub, load(mut st, tp, TC_BOR), r))
        _ = ledBorrowAdd(mut st, tp, bin(mut st, BSub, iconst(mut st, 0), r), iconst(mut st, 0))
        ceilWake(mut st)
    }
    br(mut st, bE, -1)
    setCur(mut st, bE)
    ret(mut st, -1)
}

// 待っている接続の予約の縮め（R2）: 止まる Serve の接続の task（rt.task_switch の頭 — 待ちの形に依らない）の予約を、
// 待っている間だけ PARK_RES（固定費 + 待ちの深さの上界）に縮め、差 d を根の台帳と節のチェーンから引く。d は TC_ONW のビット ONW_DSHIFT〜に置き、
// 再開する点（rt.task_switch の to）で同じ量を足し戻す。足し戻しは天井を見ない（入場した接続は進められる — 越えた分は超過の記帳と同じ扱い。
// 天井を越えている間は新しい入場が止まるので、越える量は同時に起きている接続の数で抑えられる）。Ledger の used は「走っている接続の予約 +
// 待っている接続の PARK_RES」になり、実際の常駐に近づく。ミュータント122: 縮めない（前の形 — scripts/parkres.sh が捕まえる）
const PARK_RES = TASK_FIXED + 8192
// 縮めは台帳へすぐ反映せず、ワーカーごとの未反映の量（WK_PDEBT）に溜める。溜めた縮めは台帳を本当の値より多く見せる側（入場が厳しくなる側）なので、
// 台帳の値は常に「本当の値 + 未反映の量の和」以上になる。戻しは同じ節の未反映の量があればそこから引いて打ち消し、無ければすぐ台帳へ足す（溜めると入場が緩む側）。
// 未反映の量がこの値に達したときと、節が変わるときと、ワーカーが眠る前に反映する。台帳の used のずれは節ごとに最大でワーカー数 × PARK_Q
const PARK_Q = 1048576
const ONW_DSHIFT = 16
// TC_ONW のビット15: 台帳へ返し終えた task（admitReturn が立てる）。終わる task は返した後の最後の切り替えでも areaSwap を通るので、縮めない
const ONW_GONE = 32768

func parkShrink(st mut St, t int) {
    if !st.poolOn || st.rtMut == 122 {
        return
    }
    zero := iconst(mut st, 0)
    a := load(mut st, t, TC_ADM)
    rb := bin(mut st, BAnd, a, iconst(mut st, LED_BMAX))
    onw := load(mut st, t, TC_ONW)
    // 縮めるのは: Serve の接続（bit 0）・まだ返していない（ONW_GONE なし）・縮めていない（d の欄が 0）・予約が PARK_RES より大きい
    ok := bin(mut st, BAnd, bin(mut st, BAnd, cmp(mut st, CGt, rb, iconst(mut st, PARK_RES)), cmp(mut st, CEq, bin(mut st, BAnd, onw, iconst(mut st, -1 - ((1 << ONW_DSHIFT) - 1) + ONW_GONE)), zero)), cmp(mut st, CNe, bin(mut st, BAnd, onw, iconst(mut st, 1)), zero))
    d := bin(mut st, BMul, bin(mut st, BSub, rb, iconst(mut st, PARK_RES)), ok)
    bS := newBlock(mut st)
    bJ := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, d, zero), bS, -1, bJ, -1)
    setCur(mut st, bS)
    wk := globaladdr(mut st, st.wkG)
    n0 := load(mut st, t, TC_NODE)
    bN := branchIf(mut st, cmp(mut st, CNe, load(mut st, wk, WK_PNODE), n0))
    parkFlush(mut st)
    store(mut st, wk, WK_PNODE, n0)
    br(mut st, bN, -1)
    setCur(mut st, bN)
    debt := bin(mut st, BAdd, load(mut st, wk, WK_PDEBT), d)
    store(mut st, wk, WK_PDEBT, debt)
    bQ := branchIf(mut st, cmp(mut st, CGe, debt, iconst(mut st, PARK_Q)))
    parkFlush(mut st)
    br(mut st, bQ, -1)
    setCur(mut st, bQ)
    store(mut st, t, TC_ADM, bin(mut st, BSub, a, d))
    store(mut st, t, TC_ONW, bin(mut st, BOr, onw, bin(mut st, BShl, d, iconst(mut st, ONW_DSHIFT))))
    // 入場を待つ task は起こさない（ここは rt.task_switch の途中 — 起こす処理を切り替えの中で呼ばない）。縮めた分は、次に台帳を返す点〔task の終わり〕の起こしで使われる
    br(mut st, bJ, -1)
    setCur(mut st, bJ)
}

// このワーカーの未反映の縮め（WK_PDEBT）を根と節のチェーン（WK_PNODE から親へ）から引いて0にする。Serve のプールの無いプログラムは何もしない（IR は不変）
func parkFlush(st mut St) {
    if !st.poolOn || !st.areaOn {
        return
    }
    zero := iconst(mut st, 0)
    wk := globaladdr(mut st, st.wkG)
    debt := load(mut st, wk, WK_PDEBT)
    bD := branchIf(mut st, cmp(mut st, CNe, debt, zero))
    store(mut st, wk, WK_PDEBT, zero)
    atomicXadd(mut st, globaladdr(mut st, st.mnG), MN_LED, bin(mut st, BSub, zero, debt))
    // 節のチェーン: 溜めの taskの数のフィールドは子の返し（普通のspawn — プールの節にはtaskの数を足していない）の数なので、プールの節からはバイトだけを引く。
    // ミュータント131 = プールの節からもtaskの数を引く（`conns:` の本数の数えが子の返しの分だけ減り、接続の本数の天井を越えて入る）
    tf := bin(mut st, BShl, bin(mut st, BSar, debt, iconst(mut st, LED_TSHIFT)), iconst(mut st, LED_TSHIFT))
    loop := newBlock(mut st)
    n := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    br(mut st, loop, list1(mut st, load(mut st, wk, WK_PNODE)))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CEq, n, zero), bD, -1, body, -1)
    setCur(mut st, body)
    np := itop(mut st, n)
    en := if st.rtMut == 131 { debt } else { bin(mut st, BSub, debt, bin(mut st, BMul, tf, poolNodeBit(mut st, n))) }
    atomicXadd(mut st, np, SR_LED, bin(mut st, BSub, zero, en))
    br(mut st, loop, list1(mut st, load(mut st, np, SR_PNODE)))
    setCur(mut st, bD)
}

// 照合のbuild: 眠る点で、溜めに子の返し（taskの数のフィールド）が残っていない（暇の点の反映が先に済んでいる）
func ledChkSleep(st mut St) {
    if !ledChk(mut st) || !st.poolOn || !st.areaOn {
        return
    }
    ledChkFail(mut st, bin(mut st, BSar, load(mut st, globaladdr(mut st, st.wkG), WK_PDEBT), iconst(mut st, LED_TSHIFT)), "led-check: a worker went to sleep holding deferred child returns\n")
}

// ワーカーが暇になった点（rt.mn_nextの盗みの手前）: 溜めに子の返し（taskの数のフィールド）があれば反映し、返しの番号を進めて待ち手を起こす。
// 子の返しを溜めている間は待ち手を起こさない（admitReturn）ので、溜めたワーカーが暇になる点で必ず知らせる。反映したら真（呼び手は列を見直す）
func parkFlushIdle(st mut St) int {
    zero := iconst(mut st, 0)
    if !st.poolOn || !st.areaOn {
        return zero
    }
    wk := globaladdr(mut st, st.wkG)
    has := cmp(mut st, CNe, bin(mut st, BSar, load(mut st, wk, WK_PDEBT), iconst(mut st, LED_TSHIFT)), zero)
    bJ := newBlock(mut st)
    r := param(mut st, bJ, TyI64)
    bF := newBlock(mut st)
    condbr(mut st, has, bF, -1, bJ, list1(mut st, zero))
    setCur(mut st, bF)
    parkFlush(mut st)
    if awFn(st.rtD3) != 0 {
        _ = ledWakeG(mut st)
    }
    ceilWake(mut st)
    br(mut st, bJ, list1(mut st, iconst(mut st, 1)))
    setCur(mut st, bJ)
    return r
}

// parkShrink で縮めた予約を、再開する task t に足し戻す（縮めていなければ何もしない — 熱い経路は TC_ONW の読みと比較1つ）
func parkRestore(st mut St, t int) {
    if !st.poolOn {
        return
    }
    zero := iconst(mut st, 0)
    onw := load(mut st, t, TC_ONW)
    d := bin(mut st, BSar, onw, iconst(mut st, ONW_DSHIFT))
    bR := newBlock(mut st)
    bJ := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, d, zero), bR, -1, bJ, -1)
    setCur(mut st, bR)
    store(mut st, t, TC_ONW, bin(mut st, BAnd, onw, iconst(mut st, (1 << ONW_DSHIFT) - 1)))
    store(mut st, t, TC_ADM, bin(mut st, BAdd, load(mut st, t, TC_ADM), d))
    // 同じ節の未反映の量のバイトが d 以上あれば、そこから引いて打ち消す（台帳の値は変わらない）。比べるのはバイトのフィールドだけ: 溜めには子の返しの
    // taskの数が入りうるので、語の整数で比べると、バイトが足りないのにtaskの数のフィールドから借りる
    wk := globaladdr(mut st, st.wkG)
    debt := load(mut st, wk, WK_PDEBT)
    can := bin(mut st, BAnd, cmp(mut st, CEq, load(mut st, wk, WK_PNODE), load(mut st, t, TC_NODE)), cmp(mut st, CGe, bin(mut st, BAnd, debt, iconst(mut st, LED_BMAX)), d))
    bA := newBlock(mut st)
    bC := newBlock(mut st)
    condbr(mut st, can, bC, -1, bA, -1)
    setCur(mut st, bC)
    store(mut st, wk, WK_PDEBT, bin(mut st, BSub, debt, d))
    br(mut st, bJ, -1)
    setCur(mut st, bA)
    atomicXadd(mut st, globaladdr(mut st, st.mnG), MN_LED, d)
    // 節のチェーン（TC_NODE から親へ）に d を足す（ledUndo の逆）
    loop := newBlock(mut st)
    n := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    br(mut st, loop, list1(mut st, load(mut st, t, TC_NODE)))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CEq, n, zero), bJ, -1, body, -1)
    setCur(mut st, body)
    np := itop(mut st, n)
    atomicXadd(mut st, np, SR_LED, d)
    br(mut st, loop, list1(mut st, load(mut st, np, SR_PNODE)))
    setCur(mut st, bJ)
}
