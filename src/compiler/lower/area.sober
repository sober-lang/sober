package lower

import "desugar"
import "std/iter"

// 接続のtaskのスタック（language.md 11 節 — std/netのServeを使うプログラムだけ: st.areaOn）。
// - チャンクはどれも [ガード | スタック1 MiB | ページ0 …]。スタックの領域（頂上 = ページ0の底）を「エリア」と呼び、task 1本（チャンクごとのTC_AREA）とワーカー1本
//   （WK_AREA）がそれぞれちょうど 1 枚持つ
// - フラグつきのtask（rt.netop 10 — 接続）は本体の枠をページ0の余白に置き、本体より下の呼び出しをワーカーのエリアの上で走らせる（本体のprologue
//   — x86.sober xAreaProlog）。そのtaskが止まるとrt.task_switchが所有エリアとワーカーのエリアを入れ替える（スリープするtaskは使っていたエリアを持って
//   スリープし、ワーカーはtaskの所有エリアを受け取る）。エリアの数は保存され、どのエリアも持ち主はちょうど1者
// - 所有エリアが自分でないチャンクは別のチェーン（TK_FREEA / MN_RTCBA）に返し、フラグつきのspawnだけが引く — フラグのないtaskのスタックは今の連続の形のまま
// - 本体の枠が余白に入らないフラグつきのtaskは、枠を作る前に所有エリアの頂上へ移って連続の形で走る（交換しない）

// エリアを1枚コピーする（[ガード | スタックTASK_STACK] — チャンクと同じ旗・ガードはPROT_NONE）→ 頂上の番地。エリアの予約ページを組むプログラムはチャンクと同じ並びで
// 頂上の上にページ0と頭の分のVAも取る（エリアの予約ページが頂上 + AWIN_OFFに来る — 触るのは予約ページだけ）
func areaMap(st mut St) int {
    args := listN(mut st, 7)
    desugar.HeapSet(mut st.d, args + 1, iconst(mut st, 9))
    desugar.HeapSet(mut st.d, args + 2, iconst(mut st, 0))
    desugar.HeapSet(mut st.d, args + 3, iconst(mut st, TASK_GUARD + TASK_STACK + if winArm(mut st) { 4096 + TASK_HEAD } else { 0 }))
    desugar.HeapSet(mut st.d, args + 4, iconst(mut st, 3))
    desugar.HeapSet(mut st.d, args + 5, iconst(mut st, 16418))
    desugar.HeapSet(mut st.d, args + 6, iconst(mut st, -1))
    desugar.HeapSet(mut st.d, args + 7, iconst(mut st, 0))
    b := syscall(mut st, args)
    bad := newBlock(mut st)
    ok := newBlock(mut st)
    condbr(mut st, cmp(mut st, CUge, b, iconst(mut st, -4095)), bad, -1, ok, -1)
    setCur(mut st, bad)
    memPanic(mut st, PM_VA)
    setCur(mut st, ok)
    pr := syscall(mut st, list4(mut st, iconst(mut st, 10), b, iconst(mut st, TASK_GUARD), iconst(mut st, 0)))
    bBadP := newBlock(mut st)
    okP := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, pr, iconst(mut st, 0)), bBadP, -1, okP, -1)
    setCur(mut st, bBadP)
    memPanic(mut st, PM_VA)
    setCur(mut st, okP)
    return bin(mut st, BAdd, b, iconst(mut st, TASK_GUARD + TASK_STACK))
}

// チャンクt（TCBの番地）の所有エリアが自分のスタックの領域か（値は0 / 1）
func areaOwn(st mut St, t int) int {
    return cmp(mut st, CEq, load(mut st, t, TC_AREA), bin(mut st, BSub, ptoi(mut st, t), iconst(mut st, TCB_TOP_ROOM)))
}

// 切り替える task from がワーカーのエリアの上で走っていたら、所有エリアとワーカーのエリアを入れ替える（rt.task_switchの頭）
func areaSwap(st mut St, from int) {
    w := load(mut st, from, TC_ONW)
    bS := newBlock(mut st)
    bJ := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, bin(mut st, BAnd, w, iconst(mut st, 2)), iconst(mut st, 0)), bS, -1, bJ, -1)
    setCur(mut st, bS)
    wk := globaladdr(mut st, st.wkG)
    a := load(mut st, from, TC_AREA)
    // ミュータント63 / 64 = 交換の片側だけ（taskの側だけ / ワーカーの側だけ — areacheckの保存則が捕まえる）
    if st.rtMut != 64 {
        store(mut st, from, TC_AREA, load(mut st, wk, WK_AREA))
    }
    if st.rtMut != 63 {
        store(mut st, wk, WK_AREA, a)
    }
    store(mut st, from, TC_ONW, bin(mut st, BAnd, w, iconst(mut st, -3)))
    store(mut st, wk, WK_PDEEP, bin(mut st, BAdd, load(mut st, wk, WK_PDEEP), iconst(mut st, 1)))
    br(mut st, bJ, -1)
    setCur(mut st, bJ)
}

// 本体が返った（か死んで罠へ戻った）直後のtask t: フラグつきならrspを持つエリアの頂上へ（ワーカーのエリアの上で走っていたならワーカーのエリア・
// でなければ所有エリア）。taskの終わりのスタックがページ0の余白を越えて自分のチャンクのスタックの領域（交換で他人のものでありうる）へ伸びないように
func areaExit(st mut St, t int) {
    w := load(mut st, t, TC_ONW)
    bE := newBlock(mut st)
    bJ := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, bin(mut st, BAnd, w, iconst(mut st, 1)), iconst(mut st, 0)), bE, -1, bJ, -1)
    setCur(mut st, bE)
    held := load(mut st, t, TC_AREA)
    onw := bin(mut st, BAnd, bin(mut st, BSar, w, iconst(mut st, 1)), iconst(mut st, 1))
    sp := bin(mut st, BAdd, held, bin(mut st, BMul, onw, bin(mut st, BSub, load(mut st, globaladdr(mut st, st.wkG), WK_AREA), held)))
    areaSp(mut st, sp)
    br(mut st, bJ, -1)
    setCur(mut st, bJ)
}

// シャロースリープ（rt.task_switchの頭 — rt.netwaitを呼んだ本体が止まる）: fromが記し（AREA_SARM）つきで本体の枠がページ0にある（AREA_NEAR —
// 遠いパスの本体は所有エリアの上の連続の形なので枠ごとエリアにある）なら本体より下の枠は死んでいる —
// 退避しない（退避の先をワーカーの捨てワードへ）・シャロースリープしているマーク。所有エリアの上で走っていた（ディープスリープの後）なら所有エリアとワーカーのエリアを交換してから —
// 起きるとshallow_landがワーカーのエリアの頂上で始まるので、taskはワーカーのエリアの上（bit 1）になる。記しが無ければ今のディープスリープ（交換）。退避の先を返す
func areaPark(st mut St, from int) int {
    w := load(mut st, from, TC_ONW)
    wk := globaladdr(mut st, st.wkG)
    bS := newBlock(mut st)
    bX := newBlock(mut st)
    bY := newBlock(mut st)
    bD := newBlock(mut st)
    bJ := newBlock(mut st)
    sv := param(mut st, bJ, TyPtr)
    // ミュータント71 = AREA_NEARを見ない（遠いパスの本体も浅くスリープして、エリアにあった本体の枠を失う — areacheckの遠いパスの行）
    shv := if st.rtMut == 71 { AREA_SARM } else { AREA_SARM + AREA_NEAR }
    sh := iconst(mut st, shv)
    // エリアの予約ページの深度に中身があれば（AREA_FULL）浅くスリープしない: 予約ページはエリアと一緒にtaskが持ってスリープする。
    // ミュータント78 = エリアの予約ページを見ない（中身を残したまま浅くスリープして、ワーカーのエリアの予約ページを次のtaskが上書きする）
    shm := if st.rtMut == 78 || !winArm(mut st) { sh } else { iconst(mut st, shv + AREA_FULL) }
    condbr(mut st, cmp(mut st, CEq, bin(mut st, BAnd, w, shm), sh), bS, -1, bD, -1)
    setCur(mut st, bS)
    condbr(mut st, cmp(mut st, CNe, bin(mut st, BAnd, w, iconst(mut st, 2)), iconst(mut st, 0)), bY, -1, bX, -1)
    setCur(mut st, bX)
    a := load(mut st, from, TC_AREA)
    store(mut st, from, TC_AREA, load(mut st, wk, WK_AREA))
    store(mut st, wk, WK_AREA, a)
    store(mut st, wk, WK_PSWAP, bin(mut st, BAdd, load(mut st, wk, WK_PSWAP), iconst(mut st, 1)))
    br(mut st, bY, -1)
    setCur(mut st, bY)
    // ミュータント70 = bit 1を立てない（ディープスリープの後の受けから浅くスリープして起きた本体が、ワーカーのエリアの上なのに次のディープスリープで交換しない — areacheckのdeep-againの相）
    on := if st.rtMut == 70 { iconst(mut st, AREA_SPARK) } else { iconst(mut st, AREA_SPARK + 2) }
    store(mut st, from, TC_ONW, bin(mut st, BOr, w, on))
    store(mut st, wk, WK_PSHAL, bin(mut st, BAdd, load(mut st, wk, WK_PSHAL), iconst(mut st, 1)))
    br(mut st, bJ, list1(mut st, gepWord(mut st, wk, iconst(mut st, WK_SJUNK))))
    setCur(mut st, bD)
    if winArm(mut st) {
        // シャロースリープできた点だったがエリアの予約ページに中身があった（LedgerのparkDeepWin）
        bNw := branchIf(mut st, cmp(mut st, CEq, bin(mut st, BAnd, w, sh), sh))
        store(mut st, wk, WK_PDWIN, bin(mut st, BAdd, load(mut st, wk, WK_PDWIN), iconst(mut st, 1)))
        br(mut st, bNw, -1)
        setCur(mut st, bNw)
    }
    // ディープスリープするときは記しを消す: 退避がTC_CTX（記しの戻り先）を上書きするので、同じrt.netwaitの呼び出しの中の次のparkを浅くしない
    store(mut st, from, TC_ONW, bin(mut st, BAnd, w, iconst(mut st, -1 - AREA_SARM)))
    areaSwap(mut st, from)
    br(mut st, bJ, list1(mut st, from))
    setCur(mut st, bJ)
    return sv
}

// rt.shallow_land(t)（浅くスリープしていたtが起きた — rt.task_switchがtstartでワーカーのエリアの頂上に始める）: rt.netwaitの待ちの起きた後
// （nrWaitRt・rt.task_wait_k の park の戻り）を済ませ、値を本体の rt.netwait の呼び出しの結果として戻り先へ跳ぶ: 期限・孤児（負）はその値・
// ウェイクアップされた（0）は1・まだ待ちの値（ウェイクアップする側が別の理由で積んだ）は2（本体はもう一度rt.netwaitを呼ぶ）
func buildShallowLand(st mut St) {
    begin(mut st, st.rtShLand)
    t := 0
    zero := iconst(mut st, 0)
    if st.areaOn && winArm(mut st) {
        awinRebase(mut st, t)
    }
    parkReacquire(mut st)
    // ミュータント72 = 期限のチェーンから外さない（起きたtaskがチェーンに残る — areacheckのdiscardedの相）
    if dlFn(st.rtD3) != 0 && st.rtMut != 72 {
        awUnlink(mut st, ptoi(mut st, t))
    }
    store(mut st, itop(mut st, load(mut st, t, TC_SNP)), NR_WAIT, zero)
    if st.orphOn {
        orphLeave(mut st, ptoi(mut st, t))
    }
    r := load(mut st, t, TC_IORES)
    // ウェイクアップされた（0）→ 1（待った — 本体はread_fdへ・列がまだ空ならread_fdの中で待つ）・まだ待ちの値（見直し）→ 2・負はそのまま
    mut v := bin(mut st, BAdd, r, bin(mut st, BAdd, cmp(mut st, CEq, r, zero), bin(mut st, BMul, cmp(mut st, CEq, r, iconst(mut st, PEND_RT)), iconst(mut st, 2 - PEND_RT))))
    // ミュータント73 = ウェイクアップされた（0）も見直し（2 — 本体がもう一度rt.netwaitを呼ぶパスを毎回踏ませる・保存則も答えも保つ）・74 = ウェイクアップされたを誤り（-9）にする
    // （73の行がこの値のパスを通る証。stdの受けは期限が来ていなければ -110と2の取り違えを読み直しで吸収するので、-110では区別できない）
    if st.rtMut == 73 || st.rtMut == 74 {
        v = bin(mut st, BAdd, v, bin(mut st, BMul, cmp(mut st, CEq, r, zero), bin(mut st, BSub, iconst(mut st, if st.rtMut == 73 { 2 } else { -9 }), v)))
    }
    store(mut st, t, TC_IORES, v)
    store(mut st, t, TC_ONW, bin(mut st, BAnd, load(mut st, t, TC_ONW), iconst(mut st, -1 - AREA_SPARK)))
    areaLand(mut st, ptoi(mut st, t))
    ret(mut st, -1)
}

// read_fd(fd, n, out) の接続の受け（nのマークがringの受け — RFD_DIRECTでPLAINでない）: 先にrt.netwaitで待つ（本体が直に呼ぶ点ならシャロースリープ —
// x86.sober xShCall）。2 = 見直す → もう一度・負 = 期限 / 孤児 → read_fd を呼ばずに同じ終わり（空の列・errno）・他は read_fd
func rfdShallow(st mut St, fd int, n int, out int) {
    nw := needNetWait(mut st)
    bW := newBlock(mut st)
    bChk := newBlock(mut st)
    bRd := newBlock(mut st)
    bErr := newBlock(mut st)
    bJ := newBlock(mut st)
    m := iconst(mut st, RFD_DIRECT + RFD_PLAIN)
    on := cmp(mut st, CEq, bin(mut st, BAnd, n, m), iconst(mut st, RFD_DIRECT))
    condbr(mut st, if st.rtMut == 69 { iconst(mut st, 0) } else { on }, bW, -1, bRd, -1)
    setCur(mut st, bW)
    w := call(mut st, nw, list1(mut st, fd))
    condbr(mut st, cmp(mut st, CEq, w, iconst(mut st, 2)), bW, -1, bChk, -1)
    setCur(mut st, bChk)
    condbr(mut st, cmp(mut st, CLt, w, iconst(mut st, 0)), bErr, -1, bRd, -1)
    setCur(mut st, bErr)
    initOut(mut st, out)
    setErrno(mut st, bin(mut st, BSub, iconst(mut st, 0), w))
    br(mut st, bJ, -1)
    setCur(mut st, bRd)
    call(mut st, st.rtRfd, list3(mut st, fd, n, out))
    br(mut st, bJ, -1)
    setCur(mut st, bJ)
}

// 浅くスリープしていたt（TCBの番地 — ptr）のエリアの予約ページの深度（空のまま持ってスリープした — task.soberエリアの予約ページ）を、いまのワーカーのエリアの予約ページへ付け替える（スリープしている間に他の
// taskが深くスリープしてエリアを持ち去っていれば違う）。空なので表の基底とbumpを差分だけずらす（予約ページから本物のスロットへ移した深度はそのまま）。
// ミュータント80 = 付け替えない
func awinRebase(st mut St, t int) {
    if st.rtMut == 80 {
        return
    }
    tp := t
    w := load(mut st, tp, TC_WSP)
    nw := bin(mut st, BAdd, load(mut st, globaladdr(mut st, st.wkG), WK_AREA), iconst(mut st, AWIN_OFF + WIN_SZ))
    dl := bin(mut st, BSub, nw, load(mut st, tp, TC_WANCH))
    // エリアの予約ページを持たない（チャンクの予約ページか予約ページなし）なら錨はチャンク — 付け替えない
    bGo := branchIf(mut st, bin(mut st, BAnd, cmp(mut st, CNe, dl, iconst(mut st, 0)), cmp(mut st, CNe, bin(mut st, BAnd, w, iconst(mut st, WSP_AREAS)), iconst(mut st, 0))))
    meta := globaladdr(mut st, st.meta)
    sg := globaladdr(mut st, st.slotsG)
    base := load(mut st, tp, TC_BASE)
    for r <- iter.Range(0, WIN_N) {
        k := bin(mut st, BAdd, base, iconst(mut st, 1 + r))
        isA := cmp(mut st, CNe, bin(mut st, BAnd, w, iconst(mut st, WSP_AREA << (16 * (WIN_N - 1 - r)))), iconst(mut st, 0))
        sp := gepWord(mut st, sg, k)
        // 予約ページから移した深度（基底が本物のスロット）は付け替えない
        d := bin(mut st, BMul, bin(mut st, BAnd, isA, isWinT(mut st, meta, load(mut st, sp, 0), ptoi(mut st, tp))), dl)
        store(mut st, sp, 0, bin(mut st, BAdd, load(mut st, sp, 0), d))
        bp := gepWord(mut st, meta, k)
        store(mut st, bp, W_BUMP, bin(mut st, BAdd, load(mut st, bp, W_BUMP), d))
    }
    store(mut st, tp, TC_WANCH, nw)
    br(mut st, bGo, -1)
    setCur(mut st, bGo)
}
