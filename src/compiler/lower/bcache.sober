package lower

import "desugar"
import "loader"
import "elf"
import "std/binary"
import "std/io"
import "std/iter"
import "std/os"
import "std/strings"
import "std/table"
import "x86"

// ── 後段の関数キャッシュの格納場所と値 ──
//
// 格納場所 = 世代のディレクトリ（`<cacheDir>/sober-build-1/<コンパイラの鍵の先頭 16 桁>/` — mainが組んでKnob.bcDirで渡す）にbuildごとに1つの
// パック（`<pid>-<乱数>-<バイト数>.pack` — tmp + rename で公開・書いたら変えない・大きさは一覧〔bcGens〕が stat せずに数えるため）。パック = 値の並び + 索引（varint の [切り口, 鍵 h1, h2, 位置, 長さ,
// 値の検査和]…）+ 尾（マーク8 B・索引の長さ8 B・索引の検査和8 B）。読みは世代の全部のパックの索引を表にして、当たりの値だけを検査和で検証して使う。
// 切り口は 3 つ: α（BC_A — B1 の後の本体）・β1（BC_B1 — B2 の後の呼び出し / 番地取りの相手の列。鍵 = B2 の入力の鍵）・β2（BC_B2 — 機械語・
// 後埋めの列・xmmの組。鍵 = ckBeta）。値の外を指すワードは安定な鍵のハッシュ（正準形）で、読み戻しで今のbuildの記録・番号へ戻す。
// 検証モード（SOBER_CACHE_VERIFY=1）は当たりでも作り直し、作った値と格納場所の値をバイトで比べる（違えば `cache: stale entry` で落ちる）

const BC_A = 0
const BC_B1 = 1
const BC_B2 = 2
const BC_P = 4   // P0 — parse のファイル単位の木（loader/pcache.sober。鍵 = ソースの中身のハッシュ 2 本）
const BC_D = 5   // D — checkの関数単位の判定（checker/defcache.sober。鍵 = K-D・値 = 判定のフラグと落ちの位置の相対）
const BC_PKG = 6 // 工程Bの束（bundle.sober。鍵 = 置く関数の安定な鍵・β2の鍵・事象の列のハッシュ）
const BC_G = 3   // γ — TypeAll の package の区画（desugar/tycache.sober。鍵 = K1・値 = tyValEnc の語の可変長）
const BC_MAGIC = 3550277445330518355 // "SBCPACK1"（LE）
const BC_LOW63 = 9223372036854775807
const BC_LOW57 = 144115188075855871

// 読みの表（子へ渡す — 凍った値だけ）: 切り口ごとの鍵 h1 → 項目（bcProbe の開番地の表）・項目の h2 / パック / 位置 / 長さ / 検査和・
// パックの中身。切り口の表はmapにしない: 親の凍らせたmapをバッチの子が引くと表の番地が0で落ちる（rtのインターフェースの問題）。sliceだけの表なら子の読みはcktのsliceと同じインターフェース
type BcView struct {
    on bool
    vfy bool
    am []int
    bm []int
    cm []int
    gm []int
    km []int   // 束（BC_PKG）の鍵 h1 → 項目
    pm []int   // P0 の鍵 h1 → 項目
    pe []int   // P0 の項目の列（[項目, 鍵 h1] の組 — loader へ全部渡す）
    ge []int   // γ の項目の列（[項目, 鍵 h1] の組 — desugar へ全部渡す。package の数 × 版の数）
    de []int   // D の項目の列（[項目, 鍵 h1] の組 — checker へ全部渡す）
    ek2 []int
    ef []int
    eo []int
    el []int
    eh []int
    fp []string    // パックのパス（efの添字 — α・β1・β2の値は当たったときにここから読む）
    vs [][]byte    // 項目ごとの値（γ・P・Dは読み込みで読んだ値・α・β1・β2は空 — bcVal）
}

func bcNone() BcView {
    return BcView{on: false, vfy: false, am: []int{}, bm: []int{}, cm: []int{}, gm: []int{}, km: []int{}, pm: []int{}, pe: []int{}, ge: []int{}, de: []int{}, ek2: []int{}, ef: []int{}, eo: []int{}, el: []int{}, eh: []int{}, fp: []string{}, vs: [][]byte{}}
}

// バイト列 b の [lo, hi) の検査和（語単位の混ぜ — 64 bit）
func bcSum(b []byte, lo int, hi int) int {
    return loader.PcSum(b, lo, hi)
}

// ── varint（zigzag）──

// ワードwをzigzagのvarintでoutへ
func bcPut(out mut table.Table[byte], w int) {
    mut z := (w << 1) ^ (w >> 63)
    while z < 0 || z >= 128 {
        table.Push(mut out, byte((z & 127) | 128))
        z = (z >> 7) & BC_LOW57
    }
    table.Push(mut out, byte(z))
}

// varint の読み手（b の [at, end) — 範囲を出たら bad）
type BcRd struct {
    b []byte
    at int
    end int
    bad bool
}

// 次のワード（読めなければ0でbadを立てる）
func bcGet(r mut BcRd) int {
    mut z := 0
    mut s := 0
    mut more := true
    while more {
        if r.at >= r.end || s > 63 {
            r.bad = true
            return 0
        }
        x := int(r.b[r.at])
        r.at += 1
        z = z | ((x & 127) << s)
        s += 7
        more = x >= 128
    }
    return ((z >> 1) & BC_LOW63) ^ -(z & 1)
}

// ── 外を指すワードの正準形 ──

// 外を指すワードv（関数・大域の記録 — v < 0は無し）をoutへ: [0, v] か [1, 安定な鍵のh1, h2]
func bcRef(out mut table.Table[byte], t CkTab, v int) {
    if v < 0 {
        bcPut(mut out, 0)
        bcPut(mut out, v)
        return
    }
    i := ckIdx(t.ix, v)
    if i < 0 {
        panic(InvariantBroken{})
    }
    bcPut(mut out, 1)
    bcPut(mut out, t.hs[2 * i])
    bcPut(mut out, t.hs[2 * i + 1])
}

// bcRef の読み戻し（今の build の記録 — 無ければ bad）
func bcRefGet(r mut BcRd, t CkTab) int {
    if bcGet(mut r) == 0 {
        return bcGet(mut r)
    }
    h1 := bcGet(mut r)
    h2 := bcGet(mut r)
    i := ckIdx(t.rv, h1)
    if i < 0 || t.hs[2 * i + 1] != h2 {
        r.bad = true
        return -1
    }
    return t.rec[i]
}

// 札 tag の番号の定数の値 v を out へ: 点の安定な鍵 [h1, h2] + spawn の下 2 bit（値は捨てる — ckNumAt と同じ添字）
func bcNum(out mut table.Table[byte], t CkTab, tag int, v int) {
    k := if tag == CT_PSITE { v - t.off } else { (v >> 2) - t.off - 1 }
    xs := if tag == CT_PSITE { t.ps } else { t.ss }
    if k < 0 || 2 * k + 1 >= len(xs) {
        panic(InvariantBroken{})
    }
    bcPut(mut out, xs[2 * k])
    bcPut(mut out, xs[2 * k + 1])
    bcPut(mut out, if tag == CT_SITE { v & 3 } else { 0 })
}

// bcNum の読み戻し（今の build の番号 — 点が無ければ bad）
func bcNumGet(r mut BcRd, t CkTab, tag int) int {
    h1 := bcGet(mut r)
    h2 := bcGet(mut r)
    low := bcGet(mut r)
    m := if tag == CT_PSITE { t.pv } else { t.sv }
    xs := if tag == CT_PSITE { t.ps } else { t.ss }
    k := ckIdx(m, h1)
    if k < 0 || xs[2 * k + 1] != h2 {
        r.bad = true
        return 0
    }
    return if tag == CT_PSITE { k + t.off } else { ((k + t.off + 1) << 2) | low }
}

// ── α の値 ──

// 詰めた本体pの正準形をoutへ（ワードの数 + ワードの並び。命令のフィールドと終端のフィールドのK_FN / K_GLOBは安定な鍵・OpConstはフィールドb〔札〕を
// 先に書き、札つきならaは点の安定な鍵 — 読み戻しはbを見てからaを読む）。ワードの列を作ってから1本のループでvarintにする（ワードごとの呼び出しを挟まない）
func bcAlphaEnc(out mut table.Table[byte], p []int, opk []int, tmk []int, t CkTab) {
    mut ws := mut []int{}
    ws = append(ws, len(p))
    bOff := MV_HDR + p[MV_NS] * MV_SLOT
    pOff := bOff + p[MV_NB] * BSZ
    iOff := pOff + p[MV_NP] * MV_PAR
    iEnd := iOff + p[MV_NI] * ISZ
    mut w := 0
    while w < bOff {
        ws = append(ws, p[w])
        w += 1
    }
    // ブロック: 終端のフィールドのK_FN / K_GLOBだけ置き換える
    while w < pOff {
        r := tmk[p[w + B_TERM]]
        for k <- iter.Range(0, BSZ) {
            kind := if k >= B_X1 && k <= B_X5 { (r >> (4 * (k - B_X1))) & 15 } else { 0 }
            if kind == K_FN || kind == K_GLOB {
                rv := p[w + k]
                if rv < 0 {
                    ws = append(ws, 0)
                    ws = append(ws, rv)
                } else {
                    ri := bcRi(t, rv)
                    ws = append(ws, 1)
                    ws = append(ws, t.hs[2 * ri])
                    ws = append(ws, t.hs[2 * ri + 1])
                }
            } else {
                ws = append(ws, p[w + k])
            }
        }
        w += BSZ
    }
    while w < iOff {
        ws = append(ws, p[w])
        w += 1
    }
    while w < iEnd {
        ws = append(ws, p[w + I_NEXT])
        ws = append(ws, p[w + I_RES])
        op := p[w + I_OP]
        ws = append(ws, op)
        if op == OpConst {
            tag := p[w + I_B]
            ws = append(ws, tag)
            if tag == CT_PSITE || tag == CT_SITE {
                ntag := tag
                nv := p[w + I_A]
                nk := bcNk(t, ntag, nv)
                ws = append(ws, if ntag == CT_PSITE { t.ps[2 * nk] } else { t.ss[2 * nk] })
                ws = append(ws, if ntag == CT_PSITE { t.ps[2 * nk + 1] } else { t.ss[2 * nk + 1] })
                ws = append(ws, if ntag == CT_SITE { nv & 3 } else { 0 })
            } else {
                ws = append(ws, p[w + I_A])
            }
            ws = append(ws, p[w + I_C])
        } else {
            mut r := opk[op]
            for k <- iter.Range(I_A, ISZ) {
                kind := r & 15
                r = r >> 4
                if kind == K_FN || kind == K_GLOB {
                    rv := p[w + k]
                if rv < 0 {
                    ws = append(ws, 0)
                    ws = append(ws, rv)
                } else {
                    ri := bcRi(t, rv)
                    ws = append(ws, 1)
                    ws = append(ws, t.hs[2 * ri])
                    ws = append(ws, t.hs[2 * ri + 1])
                }
                } else {
                    ws = append(ws, p[w + k])
                }
            }
        }
        w += ISZ
    }
    while w < len(p) {
        ws = append(ws, p[w])
        w += 1
    }
    table.PushAll(mut out, bcVarints(freeze(ws)))
}

// bcAlphaEnc(mvPack(f)) と同じバイト列を、本体を壊さずにヒープから直に作る（W1 の α の書き — 詰めて積み戻す費用を払わない）。
// チェーンのフィールドは歩く順の序数から・ブロック / スロットの参照は関数の中の索引から・列は初出の順（命令の順 → 終端の順 — mvPackと同じ）に置く。
// 末尾のフィールド（B_PTAIL / B_ITAIL・F_BTAIL / F_STAIL）がチェーンの最後でない形は空を返す（呼び手が詰めるパスに落ちる）
func bcAlphaHeap(st mut St, f FnRef, t CkTab) []byte {
    mut ss := mut []int{}
    mut sm := mut map[int]int{}
    mut s0 := irFnSHead(mut st, f)
    while s0 >= 0 {
        sm[s0] = len(ss)
        ss = append(ss, s0)
        s0 = desugar.HeapGet(mut st.d, s0)
    }
    mut bs := mut []int{}
    mut bm := mut map[int]int{}
    mut b0 := irFnBHead(mut st, f)
    while b0 != -1 {
        bm[int(b0)] = len(bs)
        bs = append(bs, int(b0))
        b0 = irBlkNext(mut st, b0)
    }
    nb := len(bs)
    // ブロックごとの引数・命令の序数の範囲 [頭, 数]
    mut pa := mut []int{}
    mut ia := mut []int{}
    mut ps := mut []int{}
    mut is := mut []int{}
    for k <- iter.Range(0, nb) {
        pa = append(pa, len(ps))
        mut q := irBlkPHead(mut st, BlkRef(bs[k]))
        while q >= 0 {
            ps = append(ps, q)
            q = desugar.HeapGet(mut st.d, q)
        }
        pa = append(pa, len(ps) - pa[2 * k])
        ia = append(ia, len(is))
        mut i := irBlkIHead(mut st, BlkRef(bs[k]))
        while i != -1 {
            is = append(is, int(i))
            i = irInsNext(mut st, i)
        }
        ia = append(ia, len(is) - ia[2 * k])
    }
    ns := len(ss)
    np := len(ps)
    ni := len(is)
    sOff := MV_HDR
    bOff := sOff + ns * MV_SLOT
    pOff := bOff + nb * BSZ
    iOff := pOff + np * MV_PAR
    // 列の格納場所（初出の順）— 中身はwlにコピーしておく（最後にwsへ続ける）
    mut lm := mut map[int]int{}
    mut wl := mut []int{}
    lb := iOff + ni * ISZ
    for k <- iter.Range(0, ni) {
        x := is[k]
        mut r := st.opk[desugar.HeapGet(mut st.d, x + I_OP)]
        mut w := x + I_A
        while r != 0 {
            kind := r & 15
            if kind == K_VLIST || kind == K_OLIST {
                l := desugar.HeapGet(mut st.d, w)
                if l >= 0 && lm[l] == nil {
                    lm[l] = lb + len(wl)
                    e := l + 1 + desugar.HeapGet(mut st.d, l)
                    mut q := l
                    while q < e {
                        wl = append(wl, desugar.HeapGet(mut st.d, q))
                        q += 1
                    }
                }
            }
            r = r >> 4
            w += 1
        }
    }
    for k <- iter.Range(0, nb) {
        x := bs[k]
        mut r := st.tmk[desugar.HeapGet(mut st.d, x + B_TERM)]
        mut w := x + B_X1
        while r != 0 {
            if r & 15 == K_VLIST {
                l := desugar.HeapGet(mut st.d, w)
                if l >= 0 && lm[l] == nil {
                    lm[l] = lb + len(wl)
                    e := l + 1 + desugar.HeapGet(mut st.d, l)
                    mut q := l
                    while q < e {
                        wl = append(wl, desugar.HeapGet(mut st.d, q))
                        q += 1
                    }
                }
            }
            r = r >> 4
            w += 1
        }
    }
    lend := lb + len(wl)
    // 末尾のフィールドの検証（チェーンの最後を指すこと）
    fb := desugar.HeapGet(mut st.d, int(f) + F_BTAIL)
    fs := desugar.HeapGet(mut st.d, int(f) + F_STAIL)
    mut ok := (if nb == 0 { fb < 0 } else { fb == bs[nb - 1] }) && (if ns == 0 { fs < 0 } else { fs == ss[ns - 1] })
    for k <- iter.Range(0, nb) {
        pt := desugar.HeapGet(mut st.d, bs[k] + B_PTAIL)
        it := desugar.HeapGet(mut st.d, bs[k] + B_ITAIL)
        n1 := pa[2 * k + 1]
        n2 := ia[2 * k + 1]
        ok = ok && (if n1 == 0 { pt < 0 } else { pt == ps[pa[2 * k] + n1 - 1] }) && (if n2 == 0 { it < 0 } else { it == is[ia[2 * k] + n2 - 1] })
    }
    if !ok {
        return []byte{}
    }
    mut ws := mut []int{}
    ws = append(ws, lend)
    ws = append(ws, ns)
    ws = append(ws, nb)
    ws = append(ws, np)
    ws = append(ws, ni)
    ws = append(ws, desugar.HeapGet(mut st.d, int(f) + F_NVAL))
    ws = append(ws, if nb == 0 { -1 } else { bOff })
    ws = append(ws, if nb == 0 { -1 } else { bOff + (nb - 1) * BSZ })
    ws = append(ws, desugar.HeapGet(mut st.d, int(f) + F_NBLK))
    ws = append(ws, if ns == 0 { -1 } else { sOff })
    ws = append(ws, if ns == 0 { -1 } else { sOff + (ns - 1) * MV_SLOT })
    ws = append(ws, desugar.HeapGet(mut st.d, int(f) + F_NSLOT))
    for k <- iter.Range(0, ns) {
        x := ss[k]
        ws = append(ws, if k + 1 < ns { sOff + (k + 1) * MV_SLOT } else { -1 })
        ws = append(ws, desugar.HeapGet(mut st.d, x + 1))
        ws = append(ws, desugar.HeapGet(mut st.d, x + 2))
        fr := desugar.HeapGet(mut st.d, x + 3)
        mut fo := -1
        if fr >= 0 {
            o := sm[fr]
            if o != nil {
                fo = sOff + o * MV_SLOT
            }
        }
        ws = append(ws, fo)
        ws = append(ws, desugar.HeapGet(mut st.d, x + 4))
    }
    for k <- iter.Range(0, nb) {
        x := bs[k]
        p0 := pa[2 * k]
        n1 := pa[2 * k + 1]
        i0 := ia[2 * k]
        n2 := ia[2 * k + 1]
        ws = append(ws, if k + 1 < nb { bOff + (k + 1) * BSZ } else { -1 })
        ws = append(ws, desugar.HeapGet(mut st.d, x + B_ID))
        ws = append(ws, if n1 == 0 { -1 } else { pOff + p0 * MV_PAR })
        ws = append(ws, if n1 == 0 { -1 } else { pOff + (p0 + n1 - 1) * MV_PAR })
        ws = append(ws, if n2 == 0 { -1 } else { iOff + i0 * ISZ })
        ws = append(ws, if n2 == 0 { -1 } else { iOff + (i0 + n2 - 1) * ISZ })
        tm := desugar.HeapGet(mut st.d, x + B_TERM)
        ws = append(ws, tm)
        r := st.tmk[tm]
        for j <- iter.Range(B_X1, BSZ) {
            v := desugar.HeapGet(mut st.d, x + j)
            kind := if j <= B_X5 { (r >> (4 * (j - B_X1))) & 15 } else { 0 }
            if kind == K_BLK && v >= 0 {
                o := bm[v]
                if o == nil {
                    return []byte{}
                }
                ws = append(ws, bOff + o * BSZ)
            } else if kind == K_VLIST && v >= 0 {
                o := lm[v]
                ws = append(ws, if o != nil { o } else { -1 })
            } else if kind == K_FN || kind == K_GLOB {
                rv := v
                if rv < 0 {
                    ws = append(ws, 0)
                    ws = append(ws, rv)
                } else {
                    ri := bcRi(t, rv)
                    ws = append(ws, 1)
                    ws = append(ws, t.hs[2 * ri])
                    ws = append(ws, t.hs[2 * ri + 1])
                }
            } else {
                ws = append(ws, v)
            }
        }
    }
    for k <- iter.Range(0, nb) {
        p0 := pa[2 * k]
        n1 := pa[2 * k + 1]
        for q <- iter.Range(p0, p0 + n1) {
            x := ps[q]
            ws = append(ws, if q + 1 < p0 + n1 { pOff + (q + 1) * MV_PAR } else { -1 })
            ws = append(ws, desugar.HeapGet(mut st.d, x + 1))
            ws = append(ws, desugar.HeapGet(mut st.d, x + 2))
            ws = append(ws, desugar.HeapGet(mut st.d, x + 3))
        }
    }
    for k <- iter.Range(0, nb) {
        i0 := ia[2 * k]
        n2 := ia[2 * k + 1]
        for q <- iter.Range(i0, i0 + n2) {
            x := is[q]
            ws = append(ws, if q + 1 < i0 + n2 { iOff + (q + 1) * ISZ } else { -1 })
            ws = append(ws, desugar.HeapGet(mut st.d, x + I_RES))
            op := desugar.HeapGet(mut st.d, x + I_OP)
            ws = append(ws, op)
            if op == OpConst {
                tag := desugar.HeapGet(mut st.d, x + I_B)
                ws = append(ws, tag)
                a := desugar.HeapGet(mut st.d, x + I_A)
                if tag == CT_PSITE || tag == CT_SITE {
                    ntag := tag
                    nv := a
                    nk := bcNk(t, ntag, nv)
                    ws = append(ws, if ntag == CT_PSITE { t.ps[2 * nk] } else { t.ss[2 * nk] })
                    ws = append(ws, if ntag == CT_PSITE { t.ps[2 * nk + 1] } else { t.ss[2 * nk + 1] })
                    ws = append(ws, if ntag == CT_SITE { nv & 3 } else { 0 })
                } else {
                    ws = append(ws, a)
                }
                ws = append(ws, desugar.HeapGet(mut st.d, x + I_C))
            } else {
                mut r := st.opk[op]
                for j <- iter.Range(I_A, ISZ) {
                    kind := r & 15
                    r = r >> 4
                    v := desugar.HeapGet(mut st.d, x + j)
                    if (kind == K_VLIST || kind == K_OLIST) && v >= 0 {
                        o := lm[v]
                        ws = append(ws, if o != nil { o } else { -1 })
                    } else if kind == K_FN || kind == K_GLOB {
                        rv := v
                        if rv < 0 {
                            ws = append(ws, 0)
                            ws = append(ws, rv)
                        } else {
                            ri := bcRi(t, rv)
                            ws = append(ws, 1)
                            ws = append(ws, t.hs[2 * ri])
                            ws = append(ws, t.hs[2 * ri + 1])
                        }
                    } else {
                        ws = append(ws, v)
                    }
                }
            }
        }
    }
    for x <- wl {
        ws = append(ws, x)
    }
    return bcVarints(freeze(ws))
}

// ワードの列wsのzigzagのvarintの並び（bcPutをワードごとに呼ぶのと同じバイト — 符号化のインターフェースloader.Varints）
func bcVarints(ws []int) []byte {
    return loader.Varints(ws)
}

// 外を指すワードv（記録）の安定な鍵の添字（表に無ければ鍵が閉じない — 落とす）
func bcRi(t CkTab, v int) int {
    i := ckIdx(t.ix, v)
    if i < 0 {
        panic(InvariantBroken{})
    }
    return i
}

// 札 tag の番号の定数の値 v の点の添字（ckNumAt と同じ）
func bcNk(t CkTab, tag int, v int) int {
    k := if tag == CT_PSITE { v - t.off } else { (v >> 2) - t.off - 1 }
    n := if tag == CT_PSITE { len(t.ps) } else { len(t.ss) }
    if k < 0 || 2 * k + 1 >= n {
        panic(InvariantBroken{})
    }
    return k
}

// bcAlphaEncの読み戻し（今のbuildの記録・番号の詰めた本体 — 読めなければr.bad）。値を一括でワードの列に戻し（loader.Unvarints）、
// ワードの列を添字で読む（1ワードずつ読み手のフィールドを出し入れするbcGetを挟まない）。読めたらr.at = r.end
func bcAlphaDec(r mut BcRd, opk []int, tmk []int, t CkTab) []int {
    ws, wok := loader.Unvarints(r.b, r.at, r.end)
    nw := len(ws)
    n := if nw > 0 { ws[0] } else { -1 }
    if !wok || n < MV_HDR || n > nw {
        r.bad = true
        return []int{}
    }
    mut p := mut []int{}
    for _ <- iter.Range(0, n) {
        p = append(p, 0)
    }
    mut q := 1
    mut bad := false
    for k <- iter.Range(0, MV_HDR) {
        p[k] = ws[q + k]
    }
    q += MV_HDR
    bOff := MV_HDR + p[MV_NS] * MV_SLOT
    pOff := bOff + p[MV_NB] * BSZ
    iOff := pOff + p[MV_NP] * MV_PAR
    iEnd := iOff + p[MV_NI] * ISZ
    if p[MV_NS] < 0 || p[MV_NB] < 0 || p[MV_NP] < 0 || p[MV_NI] < 0 || iEnd > n || q + (bOff - MV_HDR) > nw {
        r.bad = true
        return []int{}
    }
    mut w := MV_HDR
    while w < bOff {
        p[w] = ws[q]
        q += 1
        w += 1
    }
    while w < pOff && !bad {
        for k <- iter.Range(0, BSZ) {
            term := if k > B_TERM { p[w - k + B_TERM] } else { 0 }
            rr := if term >= 0 && term < len(tmk) { tmk[term] } else { 0 }
            kind := if k >= B_X1 && k <= B_X5 { (rr >> (4 * (k - B_X1))) & 15 } else { 0 }
            if q >= nw {
                bad = true
            } else if kind == K_FN || kind == K_GLOB {
                v, q1, b1 := bcRefW(ws, q, t)
                p[w] = v
                q = q1
                bad = bad || b1
            } else {
                p[w] = ws[q]
                q += 1
            }
            w += 1
        }
    }
    while w < iOff && !bad && q < nw {
        p[w] = ws[q]
        q += 1
        w += 1
    }
    while w < iEnd && !bad {
        if q + 3 > nw {
            bad = true
        } else {
            p[w] = ws[q]
            p[w + 1] = ws[q + 1]
            op := ws[q + 2]
            p[w + 2] = op
            q += 3
            w += 3
            if op == OpConst {
                if q + 1 > nw {
                    bad = true
                } else {
                    tag := ws[q]
                    q += 1
                    if tag == CT_PSITE || tag == CT_SITE {
                        v, q1, b1 := bcNumW(ws, q, t, tag)
                        p[w] = v
                        q = q1
                        bad = bad || b1
                    } else if q < nw {
                        p[w] = ws[q]
                        q += 1
                    } else {
                        bad = true
                    }
                    p[w + 1] = tag
                    if q < nw {
                        p[w + 2] = ws[q]
                        q += 1
                    } else {
                        bad = true
                    }
                    w += 3
                }
            } else {
                mut rr := if op >= 0 && op < len(opk) { opk[op] } else { 0 }
                for k <- iter.Range(I_A, ISZ) {
                    kind := rr & 15
                    rr = rr >> 4
                    if q >= nw {
                        bad = true
                    } else if kind == K_FN || kind == K_GLOB {
                        v, q1, b1 := bcRefW(ws, q, t)
                        p[w] = v
                        q = q1
                        bad = bad || b1
                    } else {
                        p[w] = ws[q]
                        q += 1
                    }
                    w += 1
                }
            }
        }
    }
    while w < n && !bad && q < nw {
        p[w] = ws[q]
        q += 1
        w += 1
    }
    if bad || w != n || q != nw {
        r.bad = true
        return []int{}
    }
    r.at = r.end
    return freeze(p)
}

// ワードの列wsのqからの外を指すワード（bcRefの形 [0, v] / [1, h1, h2]）の読み戻し: (記録, 次の位置, 読めない)
func bcRefW(ws []int, q int, t CkTab) (int, int, bool) {
    if q >= len(ws) {
        return -1, q, true
    }
    if ws[q] == 0 {
        if q + 1 >= len(ws) {
            return -1, q + 1, true
        }
        return ws[q + 1], q + 2, false
    }
    if q + 2 >= len(ws) {
        return -1, q + 3, true
    }
    i := ckIdx(t.rv, ws[q + 1])
    if i < 0 || t.hs[2 * i + 1] != ws[q + 2] {
        return -1, q + 3, true
    }
    return t.rec[i], q + 3, false
}

// ワードの列wsのqからの番号の定数（bcNumの形 [h1, h2, 下2 bit]）の読み戻し: (今のbuildの番号, 次の位置, 読めない)
func bcNumW(ws []int, q int, t CkTab, tag int) (int, int, bool) {
    if q + 2 >= len(ws) {
        return 0, q + 3, true
    }
    m := if tag == CT_PSITE { t.pv } else { t.sv }
    xs := if tag == CT_PSITE { t.ps } else { t.ss }
    k := ckIdx(m, ws[q])
    if k < 0 || xs[2 * k + 1] != ws[q + 1] {
        return 0, q + 3, true
    }
    low := ws[q + 2]
    return if tag == CT_PSITE { k + t.off } else { ((k + t.off + 1) << 2) | low }, q + 3, false
}

// ── 格納場所の読み ──

// 世代のディレクトリ dir の全部のパックを読んで表にする（読めないパック・壊れたパックは飛ばす — キャッシュは速さのためだけ）
func bcLoad(dir string, vfy bool) BcView {
    return bcLoadFrom(dir, bcMemPacks(), vfy)
}

// 出どころの違うパックを1つの表に: dir の世代のディレクトリのパック（尾と索引だけを読み、α・β1・β2の値は当たったときに読む）と、
// メモリの上のパック mem（値はバイト列の切り出しでコピーしない — 焼き込みの出どころ）。同じ鍵は先に積んだ方（dir）を使う（値は同じ）
func bcLoadFrom(dir string, mps [][]byte, vfy bool) BcView {
    // P の切り口の値（parse の木と package の仕上げの結果）を当たったときだけ読むか（package の仕上げの結果を使う速い経路 — loader/fastload.sober）
    lazyP := lsEnvInt("SOBER_PKG_FIN") == 1
    mut am := mut map[int]int{}
    mut bm := mut map[int]int{}
    mut cm := mut map[int]int{}
    mut gm := mut map[int]int{}
    mut km := mut map[int]int{}
    mut pm := mut map[int]int{}
    mut ge := mut []int{}
    mut pe := mut []int{}
    mut dm := mut map[int]int{}
    mut de := mut []int{}
    mut ec := mut []int{}
    mut ek1 := mut []int{}
    mut ek2 := mut []int{}
    mut ef := mut []int{}
    mut eo := mut []int{}
    mut el := mut []int{}
    mut eh := mut []int{}
    mut fp := mut []string{}
    mut vs := mut [][]byte{}
    mut srcs := mut []string{}
    if dir != "" {
        es := io.ReadDir(dir) catch []io.DirEntry{}
        for e <- es {
            nb := bytes(e.Name)
            n0 := len(nb)
            if n0 > 5 && nb[n0 - 5] == '.' && nb[n0 - 4] == 'p' && nb[n0 - 3] == 'a' && nb[n0 - 2] == 'c' && nb[n0 - 1] == 'k' {
                srcs = append(srcs, "${dir}/${e.Name}")
            }
        }
    }
    nfile := len(srcs)
    for si <- iter.Range(0, nfile + len(mps)) {
        {
            path := if si < nfile { srcs[si] } else { "" }
            ix := if si < nfile { bcIndexOf(path) } else { bcIndexOfMem(mps[si - nfile]) }
            if len(ix) > 0 {
                e0 := len(ek2)
                fi := len(fp)
                fp = append(fp, path)
                vend := binary.Load64(ix, len(ix) - 8)
                mut r := BcRd{b: ix, at: 0, end: len(ix) - 8, bad: false}
                mut eager := mut []int{}   // このパックの読み込みで読む項目（γ・P・D）
                while r.at < r.end && !r.bad {
                    cut := bcGet(mut r)
                    k1 := bcGet(mut r)
                    k2 := bcGet(mut r)
                    off := bcGet(mut r)
                    n := bcGet(mut r)
                    h := bcGet(mut r)
                    seen := if cut == BC_A { am[k1] != nil } else if cut == BC_B1 { bm[k1] != nil } else if cut == BC_G { gm[k1] != nil } else if cut == BC_P { pm[k1] != nil } else if cut == BC_D { dm[k1] != nil } else if cut == BC_PKG { km[k1] != nil } else { cm[k1] != nil }
                    if !r.bad && !seen && cut >= BC_A && cut <= BC_PKG && off >= 0 && n >= 0 && off + n <= vend {
                        ei := len(ek2)
                        if cut == BC_A {
                            am[k1] = ei
                        } else if cut == BC_B1 {
                            bm[k1] = ei
                        } else if cut == BC_G {
                            gm[k1] = ei
                        } else if cut == BC_P {
                            pm[k1] = ei
                        } else if cut == BC_D {
                            dm[k1] = ei
                        } else if cut == BC_PKG {
                            km[k1] = ei
                        } else {
                            cm[k1] = ei
                        }
                        if cut == BC_G || cut == BC_D || cut == BC_P && !lazyP {
                            eager = append(eager, ei)
                        }
                        ec = append(ec, cut)
                        ek1 = append(ek1, k1)
                        ek2 = append(ek2, k2)
                        ef = append(ef, fi)
                        eo = append(eo, off)
                        el = append(el, n)
                        eh = append(eh, h)
                        vs = append(vs, []byte{})
                    }
                }
                if si < nfile {
                    // γ・P・Dの値は今読む（loader・desugarへ表で渡す）。近い項目はまとめて1回の読みに
                    bcReadEager(path, freeze(eager), freeze(eo), freeze(el), mut vs)
                } else {
                    // メモリの上のパック: 全部の値をバイト列の切り出しで（コピーしない）
                    b := mps[si - nfile]
                    for ei <- iter.Range(e0, len(ek2)) {
                        vs[ei] = b[eo[ei]:eo[ei] + el[ei]]
                    }
                }
            }
        }
    }
    // γ・P・Dの列（検査和の合う値だけ — 合わない項目は表から外す）
    for ei <- iter.Range(0, len(ek2)) {
        cut := ec[ei]
        if cut == BC_P && lazyP && len(vs[ei]) == 0 {
            // 当たったときだけ読む P の項目（検査和は loader が読むときに照らす — pcBytes）
            pe = append(pe, ei)
            pe = append(pe, ek1[ei])
        } else if cut == BC_G || cut == BC_P || cut == BC_D {
            v := vs[ei]
            // 焼き込みのパック（fp = ""）の値は自分の実行ファイルのrodataにあるので検査和を見ない（見ると、読み込みで全部の値の頁に触れて
            // 常駐が焼き込みの大きさだけ増える）。ファイルのパックの値は今どおり検査する
            ok := len(v) == el[ei] && (fp[ef[ei]] == "" || bcSum(v, 0, len(v)) == eh[ei])
            if !ok {
                ec[ei] = -1
            } else if cut == BC_G {
                ge = append(ge, ei)
                ge = append(ge, ek1[ei])
            } else if cut == BC_P {
                pe = append(pe, ei)
                pe = append(pe, ek1[ei])
            } else {
                de = append(de, ei)
                de = append(de, ek1[ei])
            }
        }
    }
    fc := freeze(ec)
    fk := freeze(ek1)
    return BcView{on: true, vfy: vfy, am: bcProbe(fc, fk, BC_A), bm: bcProbe(fc, fk, BC_B1), cm: bcProbe(fc, fk, BC_B2), gm: bcProbe(fc, fk, BC_G), km: bcProbe(fc, fk, BC_PKG), pm: bcProbe(fc, fk, BC_P), pe: freeze(pe), ge: freeze(ge), de: freeze(de), ek2: freeze(ek2), ef: freeze(ef), eo: freeze(eo), el: freeze(el), eh: freeze(eh), fp: freeze(fp), vs: freeze(vs)}
}

// パック path の索引（尾の検査を通ったもの）と、その後ろに値の終わりの位置（8 バイト）。読めない・壊れたパックは空
func bcIndexOf(path string) []byte {
    f := io.Open(path) catch return []byte{}
    defer io.Close(f)
    fi := io.Stat(f) catch return []byte{}
    nb := fi.size
    if nb < 24 {
        return []byte{}
    }
    tail := io.ReadAt(f, nb - 24, 24) catch return []byte{}
    if len(tail) != 24 || binary.Load64(tail, 0) != BC_MAGIC {
        return []byte{}
    }
    il := binary.Load64(tail, 8)
    if il < 0 || il > nb - 24 {
        return []byte{}
    }
    vend := nb - 24 - il
    ix := io.ReadAt(f, vend, il) catch return []byte{}
    if len(ix) != il || bcSum(ix, 0, il) != binary.Load64(tail, 16) {
        return []byte{}
    }
    mut out := mut []byte{}
    for b <- ix {
        out = append(out, b)
    }
    bcLe(mut out, vend)
    return freeze(out)
}

// メモリの上のパック b の索引（尾の検査を通ったもの）と、その後ろに値の終わりの位置（8 バイト — bcIndexOfと同じ形）。壊れていれば空
func bcIndexOfMem(b []byte) []byte {
    nb := len(b)
    if nb < 24 || binary.Load64(b, nb - 24) != BC_MAGIC {
        return []byte{}
    }
    il := binary.Load64(b, nb - 16)
    if il < 0 || il > nb - 24 {
        return []byte{}
    }
    vend := nb - 24 - il
    if bcSum(b, vend, vend + il) != binary.Load64(b, nb - 8) {
        return []byte{}
    }
    mut out := mut []byte{}
    for q <- iter.Range(vend, vend + il) {
        out = append(out, b[q])
    }
    bcLe(mut out, vend)
    return freeze(out)
}

// 焼き込みのパック: stage2.sh の焼き込みの段が、作業の木の bake/ に例題（scripts/bake.list）をビルドして作ったパックを置く。
// src の bake/ は空の仮のファイル1つ（@embed は一致0を拒否する — 尾の検査で読みの表に入らない）。並びはパスのバイト順（同じ鍵の値は同じ）
@embed("bake/*.pack")
const Baked = map[string][]byte{}

func bcMemPacks() [][]byte {
    bs := Baked
    mut out := mut [][]byte{}
    for k <- keys(bs) {
        b := bs[k]
        if b != nil && len(b) > 0 {
            out = append(out, b)
        }
    }
    return freeze(out)
}

// パック path の項目 es（位置の昇順でなくてよい）の値を vs へ読む。位置の近い項目（間が BC_GAP 以下）はまとめて1回の読みにする。読めなければ空のまま
const BC_GAP = 4096

func bcReadEager(path string, es []int, eo []int, el []int, vs mut [][]byte) {
    if len(es) == 0 {
        return
    }
    f := io.Open(path) catch return
    defer io.Close(f)
    mut k := 0
    while k < len(es) {
        lo := eo[es[k]]
        mut hi := lo + el[es[k]]
        mut j := k + 1
        while j < len(es) && eo[es[j]] >= hi && eo[es[j]] <= hi + BC_GAP {
            hi = eo[es[j]] + el[es[j]]
            j += 1
        }
        b := io.ReadAt(f, lo, hi - lo) catch []byte{}
        for q <- iter.Range(k, j) {
            e := es[q]
            o := eo[e] - lo
            if o + el[e] <= len(b) {
                vs[e] = b[o:o + el[e]]
            }
        }
        k = j
    }
}

// 切り口 cut の鍵 [k1, k2] の項目（無い・検査和が合わない = -1）
func bcFind(v BcView, cut int, k1 int, k2 int) int {
    if !v.on {
        return -1
    }
    m := if cut == BC_A { v.am } else if cut == BC_B1 { v.bm } else if cut == BC_G { v.gm } else if cut == BC_P { v.pm } else if cut == BC_PKG { v.km } else { v.cm }
    e := bcProbeGet(m, k1)
    if e < 0 || v.ek2[e] != k2 {
        return -1
    }
    return e
}

// 切り口 cut に1語目が k1 の項目があるか（2語目は問わない — 束の枠が埋まっているか）
func bcHasK1(v BcView, cut int, k1 int) bool {
    return v.on && cut == BC_PKG && bcProbeGet(v.km, k1) >= 0
}

// 切り口 BC_PKG の1語目が k1 の項目の2語目（無ければ偽 — 束の古い枠の要約の鍵を組む）
func bcK2Of(v BcView, k1 int) (int, bool) {
    if !v.on {
        return 0, false
    }
    e := bcProbeGet(v.km, k1)
    return if e < 0 { 0 } else { v.ek2[e] }, e >= 0
}

// 親の引き（bcFind + 値を読んで検査和を確かめる — α・β1・β2の値は当たったときにだけ読む）
func bcFindS(st mut St, cut int, k1 int, k2 int) int {
    e := bcFind(st.bcv, cut, k1, k2)
    if e < 0 {
        return -1
    }
    _, ok := bcVal(mut st, e)
    return if ok { e } else { -1 }
}

// 項目 e の値（γ・P・Dは読み込みで読んだ値・α・β1・β2はパックから読んで検査和を確かめ、st.bcLzに覚える）。読めない・壊れていれば偽
func bcVal(st mut St, e int) ([]byte, bool) {
    v := st.bcv
    if len(v.vs[e]) > 0 {
        return v.vs[e], true
    }
    w := if len(st.bcLzE) > e { st.bcLzE[e] } else { -1 }
    if w >= 0 {
        return st.bcLzV[w], true
    }
    if w == -2 {
        return []byte{}, false
    }
    // 先に読んでいない項目（検証モードの比べなど）はその場で読む
    b := bcReadOne(v.fp[v.ef[e]], v.eo[e], v.el[e])
    ok := len(b) == v.el[e] && bcSum(b, 0, len(b)) == v.eh[e]
    return b, ok
}

// 項目 es（α・β1・β2の候補 — 鍵の索引が一致した項目）の値をまとめて読み、検査和を確かめて st.bcLzE / bcLzV に覚える。
// 項目の番号の順に、同じパックで位置の近い項目（間が BC_GAP 以下）を1回の読みにする
func bcPrefetch(st mut St, es []int) {
    v := st.bcv
    n := len(v.ek2)
    mut wnt := mut []bool{}
    mut ix := mut []int{}
    for e <- iter.Range(0, n) {
        wnt = append(wnt, false)
        ix = append(ix, if len(st.bcLzE) > e { st.bcLzE[e] } else { -1 })
    }
    mut any := false
    for e <- es {
        if e >= 0 && e < n && len(v.vs[e]) == 0 && ix[e] == -1 {
            wnt[e] = true
            any = true
        }
    }
    if !any {
        return
    }
    mut lzv := mut [][]byte{}
    for x <- st.bcLzV {
        lzv = append(lzv, x)
    }
    mut e := 0
    while e < n {
        if !wnt[e] {
            e += 1
            continue
        }
        fi := v.ef[e]
        lo := v.eo[e]
        mut hi := lo + v.el[e]
        mut j := e + 1
        mut grp := mut []int{e}
        while j < n && (!wnt[j] || (v.ef[j] == fi && v.eo[j] >= hi && v.eo[j] <= hi + BC_GAP)) {
            if wnt[j] {
                hi = v.eo[j] + v.el[j]
                grp = append(grp, j)
            }
            j += 1
        }
        b := bcReadOne(v.fp[fi], lo, hi - lo)
        for q <- grp {
            o := v.eo[q] - lo
            if o + v.el[q] <= len(b) && bcSum(b, o, o + v.el[q]) == v.eh[q] {
                ix[q] = len(lzv)
                lzv = append(lzv, b[o:o + v.el[q]])
            } else {
                ix[q] = -2
            }
        }
        e = j
    }
    st.bcLzE = freeze(ix)
    st.bcLzV = freeze(lzv)
}

// 鍵の表（st.ckk のフェーズ stage）の関数の候補の項目を先に読む（bcAlphaW1 / bcB2W1 の前）
func bcPrefetchStage(st mut St, stage int) {
    cut := if stage == 1 { BC_B1 } else { BC_A }
    mut es := mut []int{}
    m := table.Len(mut st.ckk)
    mut q := 0
    while q < m {
        if table.Get(mut st.ckk, q) == stage {
            e := bcFind(st.bcv, cut, table.Get(mut st.ckk, q + 2), table.Get(mut st.ckk, q + 3))
            if e >= 0 {
                es = append(es, e)
            }
        }
        q += 5 + table.Get(mut st.ckk, q + 4)
    }
    bcPrefetch(mut st, freeze(es))
}

// パック path の [off, off + n) を読む（読めなければ空）
func bcReadOne(path string, off int, n int) []byte {
    f := io.Open(path) catch return []byte{}
    defer io.Close(f)
    return io.ReadAt(f, off, n) catch []byte{}
}

// 親の項目 e の値の読み手（bcFindSが当たりを返した項目）
func bcRdS(st mut St, e int) BcRd {
    b, _ := bcVal(mut st, e)
    return BcRd{b: b, at: 0, end: len(b), bad: false}
}

// 項目 e の値の読み手
func bcRdOf(v BcView, e int) BcRd {
    return BcRd{b: v.vs[e], at: 0, end: len(v.vs[e]), bad: false}
}

// 項目 e の値が b（作り直した値）とバイトで同じか（検証モード）
func bcSame(v BcView, e int, b []byte) bool {
    if v.el[e] != len(b) {
        return false
    }
    return bcEq(v.vs[e], b)
}

// 親の項目 e の値が b とバイトで同じか（α・β1・β2も — 検証モード）
func bcSameS(st mut St, e int, b []byte) bool {
    v, ok := bcVal(mut st, e)
    return ok && bcEq(v, b)
}

// ── 格納場所の書き ──

// 作った値vb（切り口cut・鍵 [k1, k2]）を書きのバッチへ。格納場所に同じ鍵があれば書かない — 検証モードではそこで比べる（違えばstaleに積む）
func bcAdd(st mut St, cut int, k1 int, k2 int, vb []byte) {
    e := if st.bcv.vfy { bcFindS(mut st, cut, k1, k2) } else { bcFind(st.bcv, cut, k1, k2) }
    if e >= 0 {
        if st.bcv.vfy && !bcSameS(mut st, e, vb) {
            table.Push(mut st.bcStale, cut)
            table.Push(mut st.bcStale, k1)
            table.Push(mut st.bcStale, k2)
        }
        return
    }
    bcPutV(mut st, cut, k1, k2, vb)
}

// 当否の数（cut の当たり = hit・外れ = !hit）
func bcCount(st mut St, cut int, hit bool) {
    table.Set(mut st.bcCnt, 2 * cut + (if hit { 0 } else { 1 }), table.Get(mut st.bcCnt, 2 * cut + (if hit { 0 } else { 1 })) + 1)
}

// バイト列の一致
func bcEq(a []byte, b []byte) bool {
    if len(a) != len(b) {
        return false
    }
    for k <- iter.Range(0, len(a)) {
        if a[k] != b[k] {
            return false
        }
    }
    return true
}

// 凍らせた表fの中身の連結（chunkごとのコピー — コピーのループの形）
func bcCat(f table.Frozen[byte]) []byte {
    mut out := mut []byte{}
    mut k := 0
    while k * table.CHUNK < f.n {
        c := f.chunks[k]
        e := if f.n - k * table.CHUNK < table.CHUNK { f.n - k * table.CHUNK } else { table.CHUNK }
        mut q := 0
        while q < e {
            out = append(out, c[q])
            q += 1
        }
        k += 1
    }
    return freeze(out)
}

// 読み込みの時点で世代のディレクトリにファイルのパックがあったか（無ければ、焼き込みからの当たりがあっても、この世代の最初の満杯のビルド —
// 世代の大きさの上限〔満杯の4倍〕の基準を書く。当たりの有無だけで判定すると、焼き込みから当たるビルドが満杯と数えられず、上限が床のままで
// 書いた世代を消す）
func bcHadFile(v BcView) bool {
    for p <- v.fp {
        if p != "" {
            return true
        }
    }
    return false
}

// 焼き込みのパックを作るビルド（stage2.sh の焼き込みの段が SOBER_BAKE_STD=1 を立てる）は、std と rt の関数・std のファイル・std の package の値だけを
// 書く（例題自身の値は、配布物を受け取った利用者のプログラムにはほとんど当たらない — report-cold-10）。立っていなければ全部を書く
func bcBakeStd() bool {
    return lsEnvInt("SOBER_BAKE_STD") == 1
}

// 文字列 s が std/ で始まるか（rt も可なら rt. も）
func bcStdName(st mut St, s desugar.StrRef, rt bool) bool {
    n := slen(mut st, s)
    if n > 4 && sat(mut st, s, 0) == 's' && sat(mut st, s, 1) == 't' && sat(mut st, s, 2) == 'd' && sat(mut st, s, 3) == '/' {
        return true
    }
    return rt && n > 3 && sat(mut st, s, 0) == 'r' && sat(mut st, s, 1) == 't' && sat(mut st, s, 2) == '.'
}

// 関数の記録 f の値を書かないか（焼き込みのパックを作るビルドで、std・rt の外の関数）
func bcBakeSkip(st mut St, f int) bool {
    return bcBakeStd() && !bcStdName(mut st, desugar.StrRef(irFnName(mut st, FnRef(f))), true)
}

// bcBakeSkip の凍結の後の形（β2 の値を書く x86 の段 — 名前は凍結の前に作った列 st.bcNames〔関数のチェーンの順・printName の形〕から）
func bcBakeSkipX(st mut St, i int) bool {
    if !bcBakeStd() || i < 0 || i >= len(st.bcNames) {
        return false
    }
    nm := st.bcNames[i]
    mut k := 0
    while k < len(nm) && (nm[k] == '@' || nm[k] == '"') {
        k += 1
    }
    std := len(nm) > k + 4 && nm[k] == 's' && nm[k + 1] == 't' && nm[k + 2] == 'd' && nm[k + 3] == '/'
    rt := len(nm) > k + 3 && nm[k] == 'r' && nm[k + 1] == 't' && nm[k + 2] == '.'
    return !std && !rt
}

// 書きのバッチをパックにして世代のディレクトリへ（tmp + rename）・staleがあれば落とす・SOBER_CACHE_STAT=1なら当否を標準エラーへ
func bcFlush(st mut St) {
    if st.bcAud {
        bcAudReport(mut st)
    }
    ns := table.Len(mut st.bcStale) / 3
    if ns > 0 {
        mut msg := mut []byte{}
        for k <- iter.Range(0, ns) {
            cut := table.Get(mut st.bcStale, 3 * k)
            nm := if cut == BC_A { "alpha" } else if cut == BC_B1 { "beta1" } else if cut == BC_G { "gamma" } else if cut == BC_P { "parse" } else if cut == BC_PKG { "pkg" } else { "beta2" }
            for x <- bytes("cache: stale entry ${nm} ") {
                msg = append(msg, x)
            }
            ckHex2(mut msg, table.Get(mut st.bcStale, 3 * k + 1), table.Get(mut st.bcStale, 3 * k + 2))
            msg = append(msg, ' ')
            for x <- bcStaleName(mut st, cut, table.Get(mut st.bcStale, 3 * k + 1), table.Get(mut st.bcStale, 3 * k + 2)) {
                msg = append(msg, x)
            }
            msg = append(msg, '\n')
        }
        _ = io.WriteStderr(freeze(msg))
        panic(InvariantBroken{})
    }
    ni := table.Len(mut st.bcWi) / 6
    if lsEnvInt("SOBER_CACHE_STAT") == 1 {
        mut c := mut []int{}
        for k <- iter.Range(0, 6) {
            c = append(c, table.Get(mut st.bcCnt, k))
        }
        for k <- iter.Range(9, 13) {
            c = append(c, table.Get(mut st.bcCnt, k))
        }
        mut z := mut []int{0, 0, 0, 0, 0, 0, 0}
        for k <- iter.Range(0, ni) {
            cut := table.Get(mut st.bcWi, 6 * k)
            z[cut] = z[cut] + table.Get(mut st.bcWi, 6 * k + 4)
        }
        _ = io.WriteStderr(bytes("cache: alpha ${c[0]}/${c[0] + c[1]} beta1 ${c[2]}/${c[2] + c[3]} beta2 ${c[4]}/${c[4] + c[5]} gamma ${c[6]}/${c[6] + c[7]} parse ${c[8]}/${c[8] + c[9]} put=${ni} bytes=${table.Len(mut st.bcW)} (${z[0]} / ${z[1]} / ${z[2]} / ${z[3]} / ${z[4]})\n"))
        if st.bx.on {
            _ = io.WriteStderr(bytes("cache: pkg ${table.Get(mut st.bcCnt, 13)}/${table.Get(mut st.bcCnt, 13) + table.Get(mut st.bcCnt, 14)} read=${st.bx.rb} write=${z[BC_PKG]} drop=${st.bx.drop} leak=${table.Get(mut st.bcCnt, 15)} topmiss=${table.Get(mut st.bcCnt, 16)} tdedge=${table.Get(mut st.bcCnt, 17)} tdfact=${table.Get(mut st.bcCnt, 18)}\n"))
        }
    }
    hits := table.Get(mut st.bcCnt, 0) + table.Get(mut st.bcCnt, 2) + table.Get(mut st.bcCnt, 4) + table.Get(mut st.bcCnt, 9)
    if ni == 0 {
        bcAfter(st.bcDir, 0, hits == 0 || !bcHadFile(st.bcv))
        return
    }
    // 値の並び → 索引 → 尾（マーク・索引の長さ・索引の検査和 — 24 B）の順に一時ファイルへ。値のバッチはコピーせずchunkごとに書き足す
    // （os.AppendFile — 1本の列へコピーするとバッチの大きさ分の山が要る）。最初の書きはWriteFile（作り直し）
    f := table.Freeze(mut st.bcW)
    nv := f.n
    mut ix := mut []int{}
    for k <- iter.Range(0, ni) {
        off := table.Get(mut st.bcWi, 6 * k + 3)
        n := table.Get(mut st.bcWi, 6 * k + 4)
        ix = append(ix, table.Get(mut st.bcWi, 6 * k))
        ix = append(ix, table.Get(mut st.bcWi, 6 * k + 1))
        ix = append(ix, table.Get(mut st.bcWi, 6 * k + 2))
        ix = append(ix, off)
        ix = append(ix, n)
        ix = append(ix, table.Get(mut st.bcWi, 6 * k + 5))
    }
    ib := bcVarints(freeze(ix))
    il := len(ib)
    mut tl := mut []byte{}
    bcLe(mut tl, BC_MAGIC)
    bcLe(mut tl, il)
    bcLe(mut tl, bcSum(ib, 0, il))
    tot := nv + il + len(tl)
    bcMkdirs(st.bcDir)
    p := "${st.bcDir}/${TmpTag()}-${tot}.pack"
    tmp := p + ".tmp"
    if io.WriteFile(tmp, []byte{}) != nil {
        return
    }
    mut k0 := 0
    while k0 * table.CHUNK < nv {
        e := if nv - k0 * table.CHUNK < table.CHUNK { nv - k0 * table.CHUNK } else { table.CHUNK }
        if os.AppendFile(tmp, f.chunks[k0][0:e]) != nil {
            _ = os.Remove(tmp)
            return
        }
        k0 += 1
    }
    if os.AppendFile(tmp, ib) != nil || os.AppendFile(tmp, freeze(tl)) != nil {
        _ = os.Remove(tmp)
        return
    }
    _ = os.Rename(tmp, p)
    bcAfter(st.bcDir, tot, hits == 0 || !bcHadFile(st.bcv))
}

// ワードwを8 B（LE）でoutへ
func bcLe(out mut []byte, w int) {
    for j <- iter.Range(0, 8) {
        out = append(out, byte((w >> (8 * j)) & 255))
    }
}

// path のディレクトリを親から順に作る（mkdir -p — 失敗は無視。作れなければ書きが失敗するだけ）
func bcMkdirs(path string) {
    b := bytes(path)
    for i <- iter.Range(1, len(b) + 1) {
        if i == len(b) || b[i] == '/' {
            d := string(b[0:i]) catch return
            _ = os.Mkdir(d)
        }
    }
}

// 一時ファイルの名前のマーク `<pid>-<乱数>`（pid = /proc/self/statの最初のフィールド・乱数 = /proc/sys/kernel/random/uuidの32桁）。
// 同じ格納場所に同時に書く2つのプロセスが同じ一時ファイルを奪い合わない（checkの格納場所cachePutも使う）
func TmpTag() string {
    sb := io.ReadFile("/proc/self/stat") catch []byte{}
    ub := io.ReadFile("/proc/sys/kernel/random/uuid") catch []byte{}
    mut out := mut []byte{}
    mut i := 0
    while i < len(sb) && sb[i] != ' ' {
        out = append(out, sb[i])
        i += 1
    }
    out = append(out, '-')
    for x <- ub {
        if (x >= '0' && x <= '9') || (x >= 'a' && x <= 'f') {
            out = append(out, x)
        }
    }
    return string(freeze(out)) catch "0"
}

// 値vbを書きのバッチの末尾へ積み、索引 [切り口, h1, h2, 位置, 長さ, 検査和] を足す（格納場所に無いと分かっている鍵）
func bcPutV(st mut St, cut int, k1 int, k2 int, vb []byte) {
    table.Push(mut st.bcWi, cut)
    table.Push(mut st.bcWi, k1)
    table.Push(mut st.bcWi, k2)
    table.Push(mut st.bcWi, table.Len(mut st.bcW))
    table.Push(mut st.bcWi, len(vb))
    table.Push(mut st.bcWi, bcSum(vb, 0, len(vb)))
    table.PushAll(mut st.bcW, vb)
}

// ── γ（TypeAll の package の区画）──

// 格納場所の γ の項目をdesugarのTyCacheへ（検査和の合う項目だけ）。コンパイラの鍵 = 世代のディレクトリの名前（コンパイラの鍵の
// 先頭16桁 — 格納場所の根のパスは入れない）
func bcGammaView(st mut St) desugar.TyCache {
    return BcGammaCache(st.bcv, st.bcDir)
}

// 格納場所v（世代のディレクトリdir）の γ の項目をTyCacheへ（buildのbcGammaViewとcheckのanalyzer。
// checkは読むだけ — 値の検査のワードGC_OKはbuildの検査が通ったフラグなのでcheckからは書かない）
func BcGammaCache(v BcView, dir string) desugar.TyCache {
    mut k1 := mut []int{}
    mut k2 := mut []int{}
    mut vs := mut [][]byte{}
    for gi <- iter.Range(0, len(v.ge) / 2) {
        e := v.ge[2 * gi]
        k1 = append(k1, v.ge[2 * gi + 1])
        k2 = append(k2, v.ek2[e])
        vs = append(vs, v.vs[e])
    }
    _, gen := bcSplit(dir)
    vm := lsEnvInt("SOBER_CACHE_VERIFY")
    return desugar.TyCache{on: true, vfy: if vm == 1 { 1 } else if vm == 2 { 2 } else { 0 }, exe: gen, k1: freeze(k1), k2: freeze(k2), vs: freeze(vs)}
}

// TypeAllCの書きの側を検査の後で書きのバッチへ（値の末尾に検査のワード — desugar.TyValSeal・bcAdd — 格納場所に同じ鍵があれば検証モードで
// 比べる）・当否の数（bcCnt 9 / 10）・読み戻しの照合の食い違い（SOBER_CACHE_VERIFY=2）は特定して落ちる
func bcGammaPut(st mut St, p desugar.TyPut) {
    std := bcBakeStd()
    for i <- iter.Range(0, len(p.k1)) {
        if !std || bcStdName(mut st, desugar.PkgPath(mut st.d, p.pk[i]), false) {
            bcAdd(mut st, BC_G, p.k1[i], p.k2[i], desugar.TyValSeal(mut st.d, p.pk[i], p.vs[i]))
        }
    }
    table.Set(mut st.bcCnt, 9, table.Get(mut st.bcCnt, 9) + p.hit)
    table.Set(mut st.bcCnt, 10, table.Get(mut st.bcCnt, 10) + p.miss)
    if len(p.bad) > 0 {
        for nm <- p.bad {
            _ = io.WriteStderr(bytes("cache: gamma readback mismatch "))
            _ = io.WriteStderr(nm)
            _ = io.WriteStderr(bytes("\n"))
        }
        panic(InvariantBroken{})
    }
}

// ── P0（parse のファイル単位の木）──

// 世代のディレクトリdirの格納場所の読み（bcLoad — 検証モードはSOBER_CACHE_VERIFY=1 / 2・dir = "" は格納場所を使わないbuildの空の表）。
// app が parse の前に 1 回読み、parse のキャッシュ（BcParseView）と lower（ElfPassesCache）が同じ表を使う
func BcOpen(dir string) BcView {
    if dir == "" {
        return bcNone()
    }
    vm := lsEnvInt("SOBER_CACHE_VERIFY")
    v := bcLoad(dir, vm == 1 || vm == 2)
    loader.Stage("bcload")
    return v
}

// 格納場所のP0の項目をloaderの読みの表へ（検査和の合う項目だけ — 値はコピーせずパックの中身を指す）
func BcParseView(v BcView) loader.PCache {
    mut k1 := mut []int{}
    mut k2 := mut []int{}
    mut ef := mut []int{}
    mut eo := mut []int{}
    mut el := mut []int{}
    mut fpp := mut []string{}
    mut fof := mut []int{}
    mut fhh := mut []int{}
    for pi <- iter.Range(0, len(v.pe) / 2) {
        e := v.pe[2 * pi]
        fpp = append(fpp, v.fp[v.ef[e]])
        fof = append(fof, v.eo[e])
        fhh = append(fhh, v.eh[e])
        k1 = append(k1, v.pe[2 * pi + 1])
        k2 = append(k2, v.ek2[e])
        ef = append(ef, e)
        eo = append(eo, 0)
        el = append(el, v.el[e])
    }
    return loader.PCache{on: v.on, vfy: v.vfy, pt: loader.PcTable(freeze(k1)), k2: freeze(k2), ef: freeze(ef), eo: freeze(eo), el: freeze(el), fs: v.vs, fpath: freeze(fpp), foff: freeze(fof), fh: freeze(fhh)}
}

// loaderの読みの結果を書きのバッチへ（外れと検証モードの値 — bcAdd・格納場所に同じ鍵があれば検証モードで比べる）・当否の数（bcCnt 11 / 12）・
// 読み戻しの照合の食い違い（検証モード）は特定して落ちる
func bcParsePut(st mut St, ps []loader.PcPut) {
    st.pcPut = ps
    mut bad := 0
    for pp <- ps {
        if pp.st == 1 || pp.st == 3 {
            table.Set(mut st.bcCnt, 11, table.Get(mut st.bcCnt, 11) + 1)
        } else if pp.st == 2 {
            table.Set(mut st.bcCnt, 12, table.Get(mut st.bcCnt, 12) + 1)
        }
        // st 5 = package の仕上げの結果の値（loader/fastload.sober — P の切り口に P と別の塩の鍵で置く）
        if (pp.st == 2 || pp.st == 3 || pp.st == 5) && (!bcBakeStd() || strings.HasPrefix(pp.path, "std/")) {
            bcAdd(mut st, BC_P, pp.k1, pp.k2, pp.v)
        }
        if pp.st == 4 {
            _ = io.WriteStderr(bytes("cache: parse readback mismatch ${pp.path}\n"))
            bad += 1
        }
    }
    if bad > 0 {
        panic(InvariantBroken{})
    }
}

// ── D（check の関数単位の判定）──

// 格納場所のDの項目をcheckerの読みの表へ（loader.PCacheの形 — 検査和の合う項目だけ・値はコピーせずパックの中身を指す）
func BcCheckView(v BcView) loader.PCache {
    mut k1 := mut []int{}
    mut k2 := mut []int{}
    mut ef := mut []int{}
    mut eo := mut []int{}
    mut el := mut []int{}
    for di <- iter.Range(0, len(v.de) / 2) {
        e := v.de[2 * di]
        k1 = append(k1, v.de[2 * di + 1])
        k2 = append(k2, v.ek2[e])
        ef = append(ef, e)
        eo = append(eo, 0)
        el = append(el, v.el[e])
    }
    return loader.PCache{on: v.on, vfy: v.vfy, pt: loader.PcTable(freeze(k1)), k2: freeze(k2), ef: freeze(ef), eo: freeze(eo), el: freeze(el), fs: v.vs, fpath: []string{}, foff: []int{}, fh: []int{}}
}

// checkのパスのparseの読みの結果ps（loaderのPcPut）から格納場所へ書く項目（外れ・検証モードで格納場所に無いもの）を選ぶ。
// 検証モードの読み戻しの照合の食い違い（st = 4）と格納場所の値との食い違い（stale — buildのbcAddと同じ比べ方）は特定して落ちる
func BcParseCheck(v BcView, ps []loader.PcPut) []loader.PcPut {
    mut out := mut []loader.PcPut{}
    mut bad := 0
    for pp <- ps {
        if pp.st == 4 {
            _ = io.WriteStderr(bytes("cache: parse readback mismatch ${pp.path}\n"))
            bad += 1
        } else if pp.st == 2 || pp.st == 3 {
            e := bcFind(v, BC_P, pp.k1, pp.k2)
            if e < 0 {
                out = append(out, pp)
            } else if v.vfy && !bcSame(v, e, pp.v) {
                _ = io.WriteStderr(bytes("cache: stale entry parse ${pp.path}\n"))
                bad += 1
            }
        }
    }
    if bad > 0 {
        panic(InvariantBroken{})
    }
    return freeze(out)
}

// check の書く値（ps — 外れの値・pps — parse の外れの木〔BcParseCheck〕）を 1 つのパックにして世代のディレクトリ dir へ（tmp + rename）・
// 併合と掃除（bcAfter — cold = 当たりが 0）
func BcWriteD(dir string, ps []loader.PcPut, pps []loader.PcPut, cold bool) {
    if dir == "" {
        return
    }
    if len(ps) == 0 && len(pps) == 0 {
        bcAfter(dir, 0, cold)
        return
    }
    mut out := mut []byte{}
    mut ix := mut []int{}
    for q <- iter.Range(0, len(ps) + len(pps)) {
        pp := if q < len(ps) { ps[q] } else { pps[q - len(ps)] }
        ix = append(ix, if q < len(ps) { BC_D } else { BC_P })
        ix = append(ix, pp.k1)
        ix = append(ix, pp.k2)
        ix = append(ix, len(out))
        ix = append(ix, len(pp.v))
        ix = append(ix, bcSum(pp.v, 0, len(pp.v)))
        for x <- pp.v {
            out = append(out, x)
        }
    }
    ib := bcVarints(freeze(ix))
    il := len(ib)
    for x <- ib {
        out = append(out, x)
    }
    bcLe(mut out, BC_MAGIC)
    bcLe(mut out, il)
    bcLe(mut out, bcSum(ib, 0, il))
    bcMkdirs(dir)
    p := "${dir}/${TmpTag()}-${len(out)}.pack"
    tmp := p + ".tmp"
    if io.WriteFile(tmp, freeze(out)) != nil {
        return
    }
    _ = os.Rename(tmp, p)
    bcAfter(dir, len(out), cold)
}

// ── α（B1）──

// バッチを回さないパス（W1）のB1: 関数ごとに α の鍵を引き、当たりは値を読み戻して積み、外れはoptFunc + lB1Func（バッチの子と同じ列）を掛けて
// 値を書く（詰めて積み戻す — 詰めた形が値の素）。ckAll(0) の後に呼ぶ
func bcAlphaW1(st mut St) {
    if !st.bcv.vfy {
        bcPrefetchStage(mut st, 0)
    }
    a0 := ckStage(mut st, 0)
    ab := if st.bcAud { bcAudBase(st.ckt, lParCfg(mut st, false), 1, 0) } else { []int{} }
    mut f := st.fhead
    while f != -1 {
        if irFnBHead(mut st, f) != -1 {
            bcAlphaFn(mut st, f, ckIdx(a0, int(f)), ab)
        }
        f = irFnNext(mut st, f)
    }
}

// bcAlphaW1 の 1 関数（q = st.ckk の位置）
func bcAlphaFn(st mut St, f FnRef, q int, ab []int) {
    k1 := table.Get(mut st.ckk, q + 2)
    k2 := table.Get(mut st.ckk, q + 3)
    if !st.bcv.vfy && bcAlphaHit(mut st, f, k1, k2) {
        return
    }
    bcAlphaMiss(mut st, f, q, ab)
}

// α の鍵 [k1, k2] が当たれば値を読み戻してfの本体にし、当たりを数えて真（外れと壊れた値は何もせず偽）
func bcAlphaHit(st mut St, f FnRef, k1 int, k2 int) bool {
    e := bcFindS(mut st, BC_A, k1, k2)
    if e < 0 {
        return false
    }
    mut r := bcRdS(mut st, e)
    p := bcAlphaDec(mut r, st.opk, st.tmk, st.ckt)
    if r.bad || r.at != r.end {
        return false
    }
    mvUnpack(mut st, f, p)
    bcCount(mut st, BC_A, true)
    return true
}

// α の外れの1関数: optFunc + lB1Func（バッチの子と同じ列）を掛けて値を書く（q = st.ckk の f の鍵の位置）
func bcAlphaMiss(st mut St, f FnRef, q int, ab []int) {
    k1 := table.Get(mut st.ckk, q + 2)
    k2 := table.Get(mut st.ckk, q + 3)
    bcCount(mut st, BC_A, false)
    if st.bcAud {
        bcAudBegin(mut st, BC_A, int(f), q, ab)
    }
    optFunc(mut st, f)
    lB1Func(mut st, f)
    if st.bcAud {
        bcAudEnd(mut st)
    }
    // 値は本体を壊さずに直に（形が合わなければ詰めて積み戻すパス — 検証モードは両方を作って照合）
    if bcBakeSkip(mut st, int(f)) {
        return
    }
    vh := bcAlphaHeap(mut st, f, st.ckt)
    if len(vh) > 0 && !st.bcv.vfy {
        bcPutV(mut st, BC_A, k1, k2, vh)
        return
    }
    p := mvPack(mut st, f, false)
    mvUnpack(mut st, f, p)
    mut out := table.Table[byte]{}
    bcAlphaEnc(mut out, p, st.opk, st.tmk, st.ckt)
    vp := bcCat(table.Freeze(mut out))
    if len(vh) > 0 && !bcEq(vh, vp) {
        panic(InvariantBroken{})
    }
    bcAdd(mut st, BC_A, k1, k2, vp)
}

// バッチの子の1関数の格納場所のフェーズ: 子は格納場所を引かない（常に外れ）。当たりは親が引いて群に入れない（lParBatch）— 値は親だけが読む
func bcKid(bv BcView, stage int, k1 int, k2 int) int {
    return -1
}

// バッチの子が積み戻した結果oの格納場所の分を親へ（α の値の書き / 比べ・β1の当たりの関数のフラグ）。fr[lo..] がoの関数の順
func bcKidPut(st mut St, fr []int, lo int, o LOut, stage int) {
    mut at := 0
    mut va := 0
    for q <- iter.Range(0, len(o.hit)) {
        k1 := o.ks[at]
        k2 := o.ks[at + 1]
        at += 3 + o.ks[at + 2]
        if o.hit[q] >= 0 {
            bcCount(mut st, if stage == 1 { BC_B1 } else { BC_A }, true)
            if stage == 1 {
                table.Push(mut st.bcSkL, fr[lo + q])
                table.Push(mut st.bcSkL, o.hit[q])
            }
        } else {
            bcCount(mut st, if stage == 1 { BC_B1 } else { BC_A }, false)
        }
        n := o.al[q]
        if n > 0 && bcBakeSkip(mut st, fr[lo + q]) {
            va += n
        } else if n > 0 {
            if st.bcv.vfy {
                bcAdd(mut st, BC_A, k1, k2, o.av[va:va + n])
            } else {
                bcPutV(mut st, BC_A, k1, k2, o.av[va:va + n])
            }
            va += n
        }
    }
}

// ── β1（B2 の後の呼び出し・番地取りの相手）──

// バッチを回さないパス（W1）のB2: 関数ごとに β1の鍵（B2の入力の鍵）を引き、当たりはB2を飛ばし（本体は入力のまま — β2が外れたら
// bcPreX86が遅れて掛ける）、外れはlB2Func（バッチの子と同じ列）。ckAll(1) の後に呼ぶ
func bcB2W1(st mut St) {
    if !st.bcv.vfy {
        bcPrefetchStage(mut st, 1)
    }
    b1 := ckStage(mut st, 1)
    ab := if st.bcAud { bcAudBase(st.ckt, lParCfg(mut st, true), 1, 0) } else { []int{} }
    mut f := st.fhead
    while f != -1 {
        if irFnBHead(mut st, f) != -1 {
            q := ckIdx(b1, int(f))
            e := if st.bcv.vfy { -1 } else { bcFindS(mut st, BC_B1, table.Get(mut st.ckk, q + 2), table.Get(mut st.ckk, q + 3)) }
            if e >= 0 {
                table.Push(mut st.bcSkL, int(f))
                table.Push(mut st.bcSkL, e)
                bcCount(mut st, BC_B1, true)
            } else {
                bcCount(mut st, BC_B1, false)
                if st.bcAud {
                    bcAudBegin(mut st, BC_B1, int(f), q, ab)
                }
                lB2Func(mut st, f)
                if st.bcAud {
                    bcAudEnd(mut st)
                }
            }
        }
        f = irFnNext(mut st, f)
    }
}

// 関数fの本体の [フラグ, 相手]…（フラグ0 = OpCall・1 = OpFuncaddr — cutCalleesとxAddrTakenが読む相手）と、切替 / 罠を持つか（末尾の1ワード）
func bcCalls(st mut St, f FnRef) []int {
    mut out := mut []int{}
    mut ctx := 0
    mut b := irFnBHead(mut st, f)
    while b != -1 {
        mut i := irBlkIHead(mut st, b)
        while i != -1 {
            op := irInsOp(mut st, i)
            if op == OpCall || op == OpFuncaddr {
                out = append(out, if op == OpFuncaddr { 1 } else { 0 })
                out = append(out, int(irInsFn(mut st, i)))
            } else if op == OpTSwitch || op == OpTStart || op == OpTrapI {
                ctx = 1
            }
            i = irInsNext(mut st, i)
        }
        b = irBlkNext(mut st, b)
    }
    out = append(out, ctx)
    return freeze(out)
}

// B2 の後（cutInsert の前）: β1 の当たりの関数の値を読み戻して bcSk / bcInf に・外れの関数の値を書く（切替 / 罠を持つ関数は書かない
// — 当たらないので B2 も x86 も毎回）。読み戻せない当たりはその場で B2 を掛けて外れに回す
func bcB1Collect(st mut St) {
    b1 := ckStage(mut st, 1)
    mut sk := mut map[int]int{}
    // 相手の列は表に積む（関数ごとの作業の値と交互に伸ばすsliceは伸ばすたびに丸ごとコピーされる — RSS +770 MB）
    mut inf := table.Table[int]{}
    n := table.Len(mut st.bcSkL) / 2
    for k <- iter.Range(0, n) {
        f := table.Get(mut st.bcSkL, 2 * k)
        mut r := bcRdS(mut st, table.Get(mut st.bcSkL, 2 * k + 1))
        m := bcGet(mut r)
        at := table.Len(mut inf)
        table.Push(mut inf, m)
        for j <- iter.Range(0, if r.bad || m < 0 || m > r.end { 0 } else { m }) {
            table.Push(mut inf, bcGet(mut r))
            table.Push(mut inf, bcRefGet(mut r, st.ckt))
        }
        if r.bad || r.at != r.end {
            // 読み戻せない — 遅れて B2 を掛け、外れとして下で値を書く
            lB2Func(mut st, FnRef(f))
        } else {
            sk[f] = at
        }
    }
    // 全部の関数の相手の列（bcAddr が本体を歩き直さない — 検査点は rt の呼び出ししか足さないので番地取りの相手は B2 の後のまま）
    mut cl := mut map[int]int{}
    for k <- iter.Range(0, n) {
        f1 := table.Get(mut st.bcSkL, 2 * k)
        a1 := sk[f1]
        if a1 != nil {
            cl[f1] = a1
        }
    }
    mut f := st.fhead
    while f != -1 {
        if irFnBHead(mut st, f) != -1 && sk[int(f)] == nil {
            q := ckIdx(b1, int(f))
            cs := bcCalls(mut st, f)
            cl[int(f)] = table.Len(mut inf)
            table.Push(mut inf, (len(cs) - 1) / 2)
            table.PushAll(mut inf, cs[0:len(cs) - 1])
            if q >= 0 {
                if cs[len(cs) - 1] == 0 {
                    mut ws := mut []int{(len(cs) - 1) / 2}
                    mut j := 0
                    while j + 1 < len(cs) {
                        ws = append(ws, cs[j])
                        rv := cs[j + 1]
                        if rv < 0 {
                            ws = append(ws, 0)
                            ws = append(ws, rv)
                        } else {
                            ri := bcRi(st.ckt, rv)
                            ws = append(ws, 1)
                            ws = append(ws, st.ckt.hs[2 * ri])
                            ws = append(ws, st.ckt.hs[2 * ri + 1])
                        }
                        j += 2
                    }
                    if !bcBakeSkip(mut st, int(f)) {
                        bcAdd(mut st, BC_B1, table.Get(mut st.ckk, q + 2), table.Get(mut st.ckk, q + 3), bcVarints(freeze(ws)))
                    }
                }
            }
        }
        f = irFnNext(mut st, f)
    }
    st.bcSk = freeze(sk)
    st.bcCl = freeze(cl)
    st.bcInf = table.Freeze(mut inf)
}

// f が β1 の当たりで B2 を飛ばした関数か（本体は B2 の入力のまま）
func bcSkipped(st mut St, f int) bool {
    return st.bcv.on && st.bcSk[f] != nil
}

// 飛ばした関数fの呼び出し・番地取りの相手（cutCalleesの形 — rtを除くのは呼び手）を [フラグ, 相手]… で
func bcSkCalls(sk map[int]int, inf table.Frozen[int], f int) []int {
    at := sk[f]
    if at == nil {
        return []int{}
    }
    m := table.At(inf, at)
    mut out := mut []int{}
    for k <- iter.Range(at + 1, at + 1 + 2 * m) {
        out = append(out, table.At(inf, k))
    }
    return freeze(out)
}

// ── β2（機械語・後埋め・xmm）──

// xAddrTakenの格納場所の版（凍結の前・本体のある関数はbcB1Collectが集めた相手の列から — 飛ばした関数は β1の値。
// 要約の値を使うモードで要約にある関数は、要約の呼び出しの辺の種類 1 から — 引けない相手があれば本体から）
func bcAddr(st mut St, fr []int, entryRec int, t CkTab) []int {
    mut out := mut []int{}
    xFill(mut out, len(fr), 0)
    out[xIndex(fr, entryRec)] = 1
    use := bxCUse(mut st)
    mut hx := mut map[int]int{}
    if use {
        for k <- iter.Range(0, len(fr)) {
            i := ckIdx(t.ix, fr[k])
            if i >= 0 && hx[t.hs[2 * i]] == nil {
                hx[t.hs[2 * i]] = k
            }
        }
    }
    for k <- iter.Range(0, len(fr)) {
        at := st.bcCl[fr[k]]
        xs := if use && bxCUsed(mut st, FnRef(fr[k])) { bxCAddrs(mut st, FnRef(fr[k]), hx, t, fr) } else { []int{-1} }
        if len(xs) == 0 || xs[0] >= 0 {
            for x <- xs {
                out[x] = 1
            }
        } else if at != nil {
            m := table.At(st.bcInf, at)
            for j <- iter.Range(0, m) {
                if table.At(st.bcInf, at + 1 + 2 * j) == 1 {
                    out[xIndex(fr, table.At(st.bcInf, at + 2 + 2 * j))] = 1
                }
            }
        } else {
            mut b := irFnBHead(mut st, FnRef(fr[k]))
            while b != -1 {
                mut i := irBlkIHead(mut st, b)
                while i != -1 {
                    if irInsOp(mut st, i) == OpFuncaddr {
                        out[xIndex(fr, int(irInsFn(mut st, i)))] = 1
                    }
                    i = irInsNext(mut st, i)
                }
                b = irBlkNext(mut st, b)
            }
        }
    }
    return freeze(out)
}

// 凍結の前の β2のフェーズ: 番地を取られるフラグ（bcAddr）と β2の鍵（ckBeta）を組み、関数ごとに β2を引いて当たりの値を読み戻す
// （bcDp / bcDf / bcDo）。B2 を飛ばした関数で β2 が外れたものは、ここで B2 と置くはずだった検査点を遅れて掛けて検証する（x86 は今までどおり吐く）
func bcPreX86(st mut St, entryRec int, t CkTab) BxPlan {
    fr := fnIds(mut st)
    mut gr0 := mut []int{}
    mut g := st.ghead
    while g >= 0 {
        gr0 = append(gr0, g)
        g = xGlobNext(mut st, g)
    }
    gr := recIds(freeze(gr0))
    st.xAddr = bcAddr(mut st, fr, entryRec, t)
    beta0 := ckBeta(mut st, t, fr)
    // 熱さのプロファイル（profile.sober）: 印の表をここで組み、当たる関数のβ2の鍵に切片を混ぜる（xModuleFrozenは組み直さない）
    if st.xProf.on && len(st.xProf.text) > 0 {
        st.xPf = pfMarks(mut st, st.xPlKeys, ckBetaSeed(mut st, t, fr, PRF_S1, PRF_S2), len(fr))
    }
    beta := if len(st.xPf) > 0 { pfKey(beta0, st.xPf, len(fr)) } else { beta0 }
    st.bcBk = beta
    mut pl := bxNone()
    if st.bx.on {
        loader.Stage("bx-pre")
        pl = bxPlan(mut st, t, fr, beta)
        loader.Stage("bx-plan")
    }
    mut cd := mut map[int]int{}
    for k <- iter.Range(0, table.Len(mut st.bcCutD) / 2) {
        cd[table.Get(mut st.bcCutD, 2 * k)] = table.Get(mut st.bcCutD, 2 * k + 1)
    }
    if !st.bcv.vfy {
        mut es := mut []int{}
        for i <- iter.Range(0, len(fr)) {
            if (beta[2 * i] != 0 || beta[2 * i + 1] != 0) && !(pl.on && pl.vE[i] >= 0) {
                es = append(es, bcFind(st.bcv, BC_B2, beta[2 * i], beta[2 * i + 1]))
            }
        }
        bcPrefetch(mut st, freeze(es))
    }
    mut hx := mut []int{}
    for i <- iter.Range(0, len(fr)) {
        mut e := -1
        if pl.on && pl.vE[i] >= 0 {
            // 当たった束から（読み戻せなければ外れ — 関数ごとの項目は引かない）
            e = pl.vE[i]
            if !bcDecB2(mut st, e, pl.vLo[i], pl.vHi[i], t, fr, gr) {
                e = -1
            }
        } else {
            if !st.bcv.vfy && (beta[2 * i] != 0 || beta[2 * i + 1] != 0) {
                e = bcFindS(mut st, BC_B2, beta[2 * i], beta[2 * i + 1])
            }
            if e >= 0 && !bcDecB2(mut st, e, -1, -1, t, fr, gr) {
                e = -1
            }
        }
        if beta[2 * i] != 0 || beta[2 * i + 1] != 0 {
            bcCount(mut st, BC_B2, e >= 0)
        }
        if e < 0 && bcSkipped(mut st, fr[i]) {
            bcLate(mut st, FnRef(fr[i]), cd[fr[i]])
        }
        hx = append(hx, if e >= 0 { table.Len(mut st.bcDo) / 5 - 1 } else { -1 })
    }
    st.bcHx = freeze(hx)
    // 遅れて B2 を掛けた関数はもう飛ばした関数ではない（xCtxFn・xFnCost が本体を読む）
    mut sk := mut map[int]int{}
    for i <- iter.Range(0, len(fr)) {
        at := st.bcSk[fr[i]]
        if at != nil && hx[i] >= 0 {
            sk[fr[i]] = at
        }
    }
    st.bcSk = freeze(sk)
    return pl
}

// B2 を飛ばしたのに β2 が外れた関数 f に B2 と検査点（c = cutInsert が記録した [自分へ戻る路つき] — nil なら置かない）を掛けて検証する
func bcLate(st mut St, f FnRef, c int?) {
    lB2Func(mut st, f)
    if c != nil {
        cutFunc(mut st, f, c == 1)
    }
    if !st.noVfy {
        msg := vfyFunc(mut st, f, xCountFuncs(mut st))
        if msg != "" {
            mut out := mut []byte{}
            printName(mut st, mut out, irFnName(mut st, f))
            panic(InvalidIR{after: "cache (late)", fn: string(freeze(out)) catch "?", msg: msg})
        }
    }
}

// β2の項目eを読み戻してbcDp（機械語のパック — コピーせずに指す）/ bcDf（後埋め [関数の頭からの位置, 種類, 相手の番号]…）/ bcDo（[機械語のパックの中の位置, 長さ,
// 後埋めの位置, 数, xmm]）に積む。読み戻せなければ何も積まずに false
func bcDecB2(st mut St, e int, lo int, hi int, t CkTab, fr []int, gr []int) bool {
    mut r := bcRdS(mut st, e)
    if lo >= 0 {
        r.at = lo
        r.end = hi
    }
    n := bcGet(mut r)
    if r.bad || n < 0 || n > r.end - r.at {
        return false
    }
    cAt := r.at
    r.at += n
    en := bcGet(mut r)
    m := bcGet(mut r)
    mut fxs := mut []int{}
    mut ok := !r.bad && m >= 0 && m <= r.end - r.at
    mut j := 0
    while ok && j < m {
        pos := bcGet(mut r)
        kind := bcGet(mut r)
        mut id := 0
        if kind == 3 || kind == 4 {
            id = bcNumGet(mut r, t, if kind == 3 { CT_PSITE } else { CT_SITE })
        } else {
            rec := bcRefGet(mut r, t)
            gl := kind == 2 || kind == 5
            id = if r.bad || rec < 0 { -1 } else if gl { xIndex(gr, rec) } else { xIndex(fr, rec) }
            ok = id >= 0 && (if gl { gr[id] == rec } else { fr[id] == rec })
        }
        fxs = append(fxs, pos)
        fxs = append(fxs, kind)
        fxs = append(fxs, id)
        ok = ok && !r.bad && pos >= 0 && pos + 4 <= n && kind >= 0 && kind <= 5
        j += 1
    }
    xmm := bcGet(mut r)
    if !ok || r.bad || r.at != r.end || en < 0 || en > n {
        return false
    }
    table.Push(mut st.bcDf0, en)
    table.Push(mut st.bcDp, e)
    table.Push(mut st.bcDo, cAt)
    table.Push(mut st.bcDo, n)
    table.Push(mut st.bcDo, table.Len(mut st.bcDf))
    table.Push(mut st.bcDo, m)
    table.Push(mut st.bcDo, xmm)
    for x <- fxs {
        table.Push(mut st.bcDf, x)
    }
    return true
}

// x86 の関数の添字 i の機械語が手元にあるか（β2 の当たり・群の子で吐いた外れ）
func bcHave(st mut St, i int) bool {
    return st.bcHx[i] >= 0 || (len(st.bcXi) > 0 && st.bcXi[2 * i] >= 0)
}

// 手元の機械語（bcHave）を c の末尾へ積み、後埋めを fx へ・xmm の組を st.xXmm へ足す（関数の入口の位置を返す — xFunc と同じ。
// 機械語は吐き始め〔整列の後〕からで、入口は線の跨ぎの詰め物の分だけ後ろでありうる）
func bcSplice(st mut St, c mut table.Table[byte], fx mut table.Table[int], i int) int {
    s := x86.Here(mut c)
    h := st.bcHx[i]
    if h >= 0 {
        co := table.Get(mut st.bcDo, 5 * h)
        n := table.Get(mut st.bcDo, 5 * h + 1)
        fo := table.Get(mut st.bcDo, 5 * h + 2)
        m := table.Get(mut st.bcDo, 5 * h + 3)
        // 機械語はパックの中身から一括で（1 バイトずつの Get / Push を挟まない）
        pb, _ := bcVal(mut st, table.Get(mut st.bcDp, h))
        table.PushAll(mut c, pb[co:co + n])
        for j <- iter.Range(fo, fo + 3 * m) {
            if (j - fo) % 3 == 0 {
                xFixAdd(mut fx, s + table.Get(mut st.bcDf, j), table.Get(mut st.bcDf, j + 1), table.Get(mut st.bcDf, j + 2))
            }
        }
        st.xXmm = st.xXmm | table.Get(mut st.bcDo, 5 * h + 4)
        return s + table.Get(mut st.bcDf0, h)
    }
    o := st.bcXp[st.bcXi[2 * i]]
    l := st.bcXi[2 * i + 1]
    a := o.begs[l]
    b := o.ends[l]
    table.PushAll(mut c, o.code[a:b])
    // 群の後埋めは位置の昇順（吐いた順）— a 以上の最初を二分探索
    mut lo := 0
    mut hi := len(o.fix) / 3
    while lo < hi {
        mid := (lo + hi) / 2
        if o.fix[3 * mid] < a {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    while 3 * lo < len(o.fix) && o.fix[3 * lo] < b {
        xFixAdd(mut fx, s + o.fix[3 * lo] - a, o.fix[3 * lo + 1], o.fix[3 * lo + 2])
        lo += 1
    }
    st.xXmm = st.xXmm | o.xmms[l]
    return s + o.starts[l] - a
}

// 吐いた関数 i（c の [s, e)・入口 en・後埋め fx の [f0, f1)・xmm の組 xmm）を β2 の書きの候補に積む（β2 の当たり・鍵の無い関数は積まない）
func bcNote(st mut St, i int, s int, en int, e int, f0 int, f1 int, xmm int) {
    if st.bcHx[i] >= 0 || (st.bcBk[2 * i] == 0 && st.bcBk[2 * i + 1] == 0) {
        return
    }
    xs := []int{i, s, en, e, f0, f1, xmm}
    table.PushAll(mut st.bcCr, xs)
}

// bcNoteの候補の β2の値を書く: 機械語は後埋めの後の ELF exe から切り出し、後埋めのフィールド（4 B）を0に戻す（後埋めは毎回全部を
// 上書きするので、値のフィールドは0で正準）。値 = [長さ, 機械語…, 入口 − s, 後埋めの数, [位置 − s, 種類, 相手]…, xmm]
func bcCaptureAll(st mut St, exe []byte, fx mut table.Table[int], fr []int, gr []int, t CkTab) {
    n := table.Len(mut st.bcCr) / 7
    for k <- iter.Range(0, n) {
        at := 7 * k
        i := table.Get(mut st.bcCr, at)
        s := table.Get(mut st.bcCr, at + 1)
        en := table.Get(mut st.bcCr, at + 2)
        e := table.Get(mut st.bcCr, at + 3)
        f0 := table.Get(mut st.bcCr, at + 4)
        f1 := table.Get(mut st.bcCr, at + 5)
        // 表を関数ごとに作らない（最初の Push の chunk の確保が関数の数だけ掛かる — report の xFitShift の地雷と同じ形）
        mut out := mut []byte{}
        for x <- bcVarints([]int{e - s}) {
            out = append(out, x)
        }
        c0 := len(out)
        lo := elf.CodeOffset + s
        hi := elf.CodeOffset + e
        mut q := lo
        while q < hi {
            out = append(out, exe[q])
            q += 1
        }
        mut ws := mut []int{en - s, (f1 - f0) / 3}
        mut j := f0
        while j < f1 {
            pos := table.Get(mut fx, j) - s
            kind := table.Get(mut fx, j + 1)
            id := table.Get(mut fx, j + 2)
            for b <- iter.Range(0, 4) {
                out[c0 + pos + b] = 0
            }
            ws = append(ws, pos)
            ws = append(ws, kind)
            if kind == 3 || kind == 4 {
                ntag := if kind == 3 { CT_PSITE } else { CT_SITE }
                nv := id
                nk := bcNk(t, ntag, nv)
                ws = append(ws, if ntag == CT_PSITE { t.ps[2 * nk] } else { t.ss[2 * nk] })
                ws = append(ws, if ntag == CT_PSITE { t.ps[2 * nk + 1] } else { t.ss[2 * nk + 1] })
                ws = append(ws, if ntag == CT_SITE { nv & 3 } else { 0 })
            } else {
                ri := ckIdx(t.ix, if kind == 2 || kind == 5 { gr[id] } else { fr[id] })
                if ri < 0 {
                    panic(InvariantBroken{})
                }
                ws = append(ws, 1)
                ws = append(ws, t.hs[2 * ri])
                ws = append(ws, t.hs[2 * ri + 1])
            }
            j += 3
        }
        ws = append(ws, table.Get(mut st.bcCr, at + 6))
        for x <- bcVarints(freeze(ws)) {
            out = append(out, x)
        }
        if !bcBakeSkipX(mut st, i) {
            bcAdd(mut st, BC_B2, st.bcBk[2 * i], st.bcBk[2 * i + 1], freeze(out))
        }
    }
}

// 実行中のコンパイラ（/proc/self/exe）の鍵の32桁（buildの格納場所の世代 — SHA-256のselfKeyより安い語単位の混ぜ2本。読めなければ ""）
func BcExeKey() string {
    b := io.ReadFile("/proc/self/exe") catch return ""
    mut out := mut []byte{}
    ckHex2(mut out, bcSum(b, 0, len(b)), bcSum(b, 1, len(b)) ^ CK_S2)
    return string(freeze(out)) catch ""
}

// ── 扉の監査（SOBER_CACHE_VERIFY=2）──
//
// 関数ごとの作り直し（α = optFunc + lB1Func・β1 = lB2Func・β2 = xFunc）が鍵の外の事実を読んでいないかを、外の事実を読む扉で記録して検証する:
// lFnRet（呼び先の戻りの型 — α / β1）・xRegCc（番地を取られるフラグ — β2）・x86の読みインターフェースxg（ヒープの読み全部 — β2）。鍵に入れた相手 = 自分 +
// 入力の本体の関数の参照（ckFnが歩いた列 — 監査のときは α のフェーズもst.ckkに積む）+ バッチのcfgの関数（β2はx86のcfgも・rtの関数は番地取りの
// フラグだけ — 鍵はrtのフラグの和を持つ）。β2は関数の外のヒープの読みを全部記録する: 許しは鍵に入れた相手の記録の事実のフィールド（ckFact — 関数の
// F_RET / F_MUTP / F_REFP・大域のG_WSLOT）と自分の引数の型の列（specの複製と共有されうる）だけで、他の関数の記録の他のフィールド・本体・引数の型の列・大域の
// 記録の他のフィールドと初期値・持ち主の無いワードははみ出し。はみ出しはbuildの終わり（bcFlush）に `cache: undeclared read <切り口> <関数> → <相手>` で
// 印字して落ちる。監査は検証モード（=1）を含み、バッチ・群の子を外し（親で関数ごとに回す — 扉の記録を親に置く）、x86はヒープを凍らせずに読む
// （xgの遅いパス）。xgの記録（bcAudHeap）は木のxgには書かない: 遅いパスは凍結の前のパスで熱く、分岐1つで自己buildのoffの命令が +0.49 G
// 監査の検査（scripts/cacheaudit.sh）がxgの遅いパスに `if st.bcAud { bcAudHeap(mut st, i) }` を差し込んだ監査用のコンパイラを
// ビルドする。差し込みの無いコンパイラの =2は β2のヒープの読みを見ていないと印字する（bcAudReport）

const BA_RET = 1    // lFnRet の相手（α / β1）
const BA_ADDR = 2   // 番地を取られるフラグの相手（β2 — xRegCc）
const BA_FREC = 10  // 他の関数の記録のフィールド（フィールド = 記録の中の位置）
const BA_FBODY = 11 // 他の関数の本体
const BA_FSIG = 12  // 他の関数の引数の型の列
const BA_NONE = 20  // 持ち主の無いワード
const BA_GREC = 30  // 大域の記録のフィールド
const BA_GINIT = 31 // 大域の初期値の列

// cfgの列の関数の記録 [記録, 値]…（値1 = 戻りの型と番地取りのフラグ・2 = 番地取りのフラグだけ）。mode = 鍵に混ぜないワードの表（0 = lParCfg・
// 1 = xParCfg。ckDrop の表。外したワードの記録は、本体が参照したときだけ呼び先の列から許す・2 = 全部許す）
func bcAudBase(t CkTab, cfg []int, v int, mode int) []int {
    mut out := mut []int{}
    drop := if mode == 2 { ckDrop([]int{}, false) } else { ckDrop(cfg, mode == 1) }
    for k <- iter.Range(0, len(cfg)) {
        w := cfg[k]
        if (mode == 2 || !drop[k]) && ckIsFn(t, w) {
            out = append(out, w)
            out = append(out, v)
        }
    }
    return freeze(out)
}

// 関数 f の切り口 cut の監査を始める（q = st.ckk の f の鍵の位置 — 呼び先の列つき・-1 = 鍵なし・base = bcAudBase の和）
func bcAudBegin(st mut St, cut int, f int, q int, base []int) {
    mut m := mut map[int]int{}
    for k <- iter.Range(0, len(base) / 2) {
        if m[base[2 * k]] == nil {
            m[base[2 * k]] = base[2 * k + 1]
        }
    }
    if q >= 0 {
        n := table.Get(mut st.ckk, q + 4)
        for j <- iter.Range(q + 5, q + 5 + n) {
            m[table.Get(mut st.ckk, j)] = 1
        }
    }
    m[f] = 1
    st.bcDecl = freeze(m)
    st.bcAc = cut
    st.bcAf = f
    st.bcUt = table.Table[int]{}
}

// 監査中の関数のはみ出しを重複を除いて st.bcUnd へ移し、関数の外に戻る
func bcAudEnd(st mut St) {
    n := table.Len(mut st.bcUt) / 4
    mut seen := mut map[int]int{}
    for k <- iter.Range(0, n) {
        kind := table.Get(mut st.bcUt, 4 * k)
        g := table.Get(mut st.bcUt, 4 * k + 1)
        fl := table.Get(mut st.bcUt, 4 * k + 2)
        h := ckM1(ckM1(ckM1(CK_S1, kind), g), fl)
        if seen[h] == nil {
            seen[h] = 1
            table.Push(mut st.bcUnd, st.bcAc)
            table.Push(mut st.bcUnd, st.bcAf)
            table.Push(mut st.bcUnd, kind)
            table.Push(mut st.bcUnd, g)
            table.Push(mut st.bcUnd, fl)
            table.Push(mut st.bcUnd, table.Get(mut st.bcUt, 4 * k + 3))
        }
    }
    table.Set(mut st.bcCnt, 6 + st.bcAc, table.Get(mut st.bcCnt, 6 + st.bcAc) + 1)
    st.bcAf = -1
}

// 監査中の関数のはみ出し 1 つ（同じ相手の続く読みは 1 つに畳む）
func bcAudRec(st mut St, kind int, g int, fl int, at int) {
    n := table.Len(mut st.bcUt)
    if n >= 4 && table.Get(mut st.bcUt, n - 4) == kind && table.Get(mut st.bcUt, n - 3) == g && table.Get(mut st.bcUt, n - 2) == fl {
        return
    }
    table.Push(mut st.bcUt, kind)
    table.Push(mut st.bcUt, g)
    table.Push(mut st.bcUt, fl)
    table.Push(mut st.bcUt, at)
}

// 相手gが鍵に入っているか（need 1 = 戻りの型も・2 = 番地取りのフラグだけで足りる）
func bcAudDecl(st mut St, g int, need int) bool {
    d := st.bcDecl[g]
    if d == nil {
        return false
    }
    return d <= need
}

// 扉 lFnRet の記録（α / β1 — 呼び先 g の戻りの型）
func bcAudRet(st mut St, g int) {
    if st.bcAf >= 0 && !bcAudDecl(mut st, g, 1) {
        bcAudRec(mut st, BA_RET, g, 0, 0)
    }
}

// 扉 xRegCc の記録（β2 — g が番地を取られるか）
func bcAudAddr(st mut St, g int) {
    if st.bcAf >= 0 && !bcAudDecl(mut st, g, 2) {
        bcAudRec(mut st, BA_ADDR, g, 0, 0)
    }
}

// 扉 xg の記録（β2 — ヒープの i 語目の読み。持ち主の符号は bcAudOwn）
func bcAudHeap(st mut St, i int) {
    if st.bcAf < 0 || st.bcAc != BC_B2 {
        return
    }
    st.bcAh = 1
    o := if i >= 0 && i < table.Len(mut st.bcOwn) { table.Get(mut st.bcOwn, i) } else { -1 }
    if o >= 0 {
        g := o >> 2
        k := o & 3
        if g == st.bcAf {
            return
        }
        if k == 0 {
            // 鍵の記録の事実（ckFact）に入れたフィールド
            if (i - g == F_RET || i - g == F_MUTP || i - g == F_REFP) && bcAudDecl(mut st, g, 1) {
                return
            }
            bcAudRec(mut st, BA_FREC, g, i - g, i)
        } else if k == 2 {
            // 引数の型の列は spec の複製と元で共有されうる — 自分の列の中なら自分の読み
            p := desugar.HeapGet(mut st.d, st.bcAf + F_PTYS)
            if p >= 0 && i >= p && i <= p + desugar.HeapGet(mut st.d, p) {
                return
            }
            bcAudRec(mut st, BA_FSIG, g, 0, i)
        } else {
            bcAudRec(mut st, BA_FBODY, g, 0, i)
        }
    } else if o == -1 {
        bcAudRec(mut st, BA_NONE, -1, 0, i)
    } else {
        c := -o - 2
        gr := c >> 1
        if (c & 1) == 0 {
            if i - gr == G_WSLOT && bcAudDecl(mut st, gr, 1) {
                return
            }
            bcAudRec(mut st, BA_GREC, gr, i - gr, i)
        } else {
            bcAudRec(mut st, BA_GINIT, gr, 0, i)
        }
    }
}

// ヒープの [at, at + n) の持ち主を v に（範囲の外は飛ばす）
func bcOwnSet(st mut St, at int, n int, v int) {
    if at < 0 || at + n > table.Len(mut st.bcOwn) {
        return
    }
    for k <- iter.Range(at, at + n) {
        table.Set(mut st.bcOwn, k, v)
    }
}

// 値の列 l（[n, 要素…]）の持ち主を v に
func bcOwnList(st mut St, l int, v int) {
    if l >= 0 && l < desugar.HeapLen(mut st.d) {
        bcOwnSet(mut st, l, 1 + desugar.HeapGet(mut st.d, l), v)
    }
}

// ヒープのワードの持ち主の表（x86の監査 — 凍結の代わりにxModuleが組む）: 関数gの記録 = 4g・本体（スロット・ブロック・引数・命令・
// 命令と終端の値の列 — mvPack が詰める範囲）= 4g + 1・引数の型の列 = 4g + 2・大域 gr の記録 = -(2 + 2gr)・初期値の列 = -(3 + 2gr)・他 = -1。
// β2の鍵に入れたcfgの相手（B2のcfg + x86のcfg + rtの関数の番地取りのフラグ — ckBeta）もst.bcXabに
func bcAudOwn(st mut St, ckt CkTab) {
    st.bcXab = bcAudJoin(bcAudJoin(bcAudBase(ckt, lParCfg(mut st, true), 1, 0), bcAudBase(ckt, xParCfg(mut st), 1, 1)), bcAudBase(ckt, st.ckRt, 2, 2))
    n := desugar.HeapLen(mut st.d)
    st.bcOwn = table.Table[int]{}
    for k <- iter.Range(0, n) {
        table.Push(mut st.bcOwn, -1)
    }
    mut f := st.fhead
    while f != -1 {
        fi := int(f)
        bcOwnSet(mut st, fi, FSZ, 4 * fi)
        bcOwnList(mut st, irFnPtys(mut st, f), 4 * fi + 2)
        mut s := irFnSHead(mut st, f)
        while s >= 0 {
            bcOwnSet(mut st, s, MV_SLOT, 4 * fi + 1)
            s = desugar.HeapGet(mut st.d, s)
        }
        mut b := irFnBHead(mut st, f)
        while b != -1 {
            bi := int(b)
            bcOwnSet(mut st, bi, BSZ, 4 * fi + 1)
            mut p := irBlkPHead(mut st, b)
            while p >= 0 {
                bcOwnSet(mut st, p, MV_PAR, 4 * fi + 1)
                p = desugar.HeapGet(mut st.d, p)
            }
            mut i := irBlkIHead(mut st, b)
            while i != -1 {
                ii := int(i)
                bcOwnSet(mut st, ii, ISZ, 4 * fi + 1)
                mut r := st.opk[desugar.HeapGet(mut st.d, ii + I_OP)]
                mut w := ii + I_A
                while r != 0 {
                    kind := r & 15
                    if kind == K_VLIST || kind == K_OLIST {
                        bcOwnList(mut st, desugar.HeapGet(mut st.d, w), 4 * fi + 1)
                    }
                    r = r >> 4
                    w += 1
                }
                i = irInsNext(mut st, i)
            }
            mut r := st.tmk[desugar.HeapGet(mut st.d, bi + B_TERM)]
            mut w := bi + B_X1
            while r != 0 {
                if (r & 15) == K_VLIST {
                    bcOwnList(mut st, desugar.HeapGet(mut st.d, w), 4 * fi + 1)
                }
                r = r >> 4
                w += 1
            }
            b = irBlkNext(mut st, b)
        }
        f = irFnNext(mut st, f)
    }
    mut g := st.ghead
    while g >= 0 {
        bcOwnSet(mut st, g, GSZ, -(2 + 2 * g))
        bcOwnList(mut st, desugar.HeapGet(mut st.d, g + G_INIT), -(3 + 2 * g))
        g = desugar.HeapGet(mut st.d, g + G_NEXT)
    }
}

// 監査の結果（bcFlush — はみ出しがあれば印字して落ちる・無ければ SOBER_CACHE_STAT=1 で監査した関数の数）
func bcAudReport(st mut St) {
    nu := table.Len(mut st.bcUnd) / 6
    if st.bcAh == 0 && table.Get(mut st.bcCnt, 8) > 0 {
        _ = io.WriteStderr(bytes("cache: audit: beta2 heap reads are not instrumented (build the audit compiler — scripts/cacheaudit.sh)\n"))
    }
    if nu == 0 {
        if lsEnvInt("SOBER_CACHE_STAT") == 1 {
            _ = io.WriteStderr(bytes("cache: audit ok alpha=${table.Get(mut st.bcCnt, 6)} beta1=${table.Get(mut st.bcCnt, 7)} beta2=${table.Get(mut st.bcCnt, 8)} heap=${if st.bcAh == 1 { "on" } else { "off" }}\n"))
        }
        return
    }
    mut msg := mut []byte{}
    for k <- iter.Range(0, nu) {
        cut := table.Get(mut st.bcUnd, 6 * k)
        f := table.Get(mut st.bcUnd, 6 * k + 1)
        kind := table.Get(mut st.bcUnd, 6 * k + 2)
        g := table.Get(mut st.bcUnd, 6 * k + 3)
        fl := table.Get(mut st.bcUnd, 6 * k + 4)
        at := table.Get(mut st.bcUnd, 6 * k + 5)
        nm := if cut == BC_A { "alpha" } else if cut == BC_B1 { "beta1" } else { "beta2" }
        if kind >= 40 {
            // 鍵の感度の検査（ckSens）— 多ければ先頭の 50 行だけ
            if k < 50 {
                for x <- bytes("cache: insensitive key ${nm} ") {
                    msg = append(msg, x)
                }
                printName(mut st, mut msg, irFnName(mut st, FnRef(f)))
                for x <- bytes(if kind == 40 { " (record facts of the callees do not change the key)\n" } else if kind == 43 { " (std/utf8.boundary does not change the key of a function with marked reads)\n" } else if kind == 44 { " (std/utf8.boundary changes the key of a function without marked reads)\n" } else { " (the cfg does not change the key)\n" }) {
                    msg = append(msg, x)
                }
            }
            continue
        }
        for x <- bytes("cache: undeclared read ${nm} ") {
            msg = append(msg, x)
        }
        printName(mut st, mut msg, irFnName(mut st, FnRef(f)))
        for x <- bytes(" → ") {
            msg = append(msg, x)
        }
        if kind == BA_GREC || kind == BA_GINIT {
            for x <- xGlobKey(mut st, g) {
                msg = append(msg, x)
            }
        } else if kind != BA_NONE {
            printName(mut st, mut msg, irFnName(mut st, FnRef(g)))
        }
        d := if kind == BA_RET { " ret" } else if kind == BA_ADDR { " addr" } else if kind == BA_FREC { " field ${fl}" } else if kind == BA_FBODY { " body @${at}" } else if kind == BA_FSIG { " ptys" } else if kind == BA_NONE { "heap @${at}" } else if kind == BA_GREC { " field ${fl}" } else { " init" }
        for x <- bytes(d) {
            msg = append(msg, x)
        }
        msg = append(msg, '\n')
    }
    for x <- bytes("cache: undeclared reads ${nu}\n") {
        msg = append(msg, x)
    }
    _ = io.WriteStderr(freeze(msg))
    panic(InvariantBroken{})
}

// bcAudBase の列の連結（先に出た記録の値が勝つ — bcAudBegin）
func bcAudJoin(a []int, b []int) []int {
    mut out := mut []int{}
    for w <- a {
        out = append(out, w)
    }
    for w <- b {
        out = append(out, w)
    }
    return freeze(out)
}

// 関数のチェーンの順の名前（検証モードのstaleの特定 — 凍結の前にxModuleが組む）
func bcNamesOf(st mut St) [][]byte {
    mut out := mut [][]byte{}
    ids := fnIds(mut st)
    for k <- iter.Range(0, len(ids)) {
        mut nm := mut []byte{}
        printName(mut st, mut nm, irFnName(mut st, FnRef(ids[k])))
        out = append(out, freeze(nm))
    }
    return freeze(out)
}

// staleの鍵 [k1, k2]（切り口cut）の関数の名前（α / β1 = st.ckkのフェーズ0 / 1・β2 = st.bcBk — 関数のチェーンの順の添字。引けなければ `?`）
func bcStaleName(st mut St, cut int, k1 int, k2 int) []byte {
    if cut == BC_PKG {
        // packageの名前はbxWriteが先に印字する
        return bytes("?")
    }
    if cut == BC_P {
        for pp <- st.pcPut {
            if pp.k1 == k1 && pp.k2 == k2 {
                return bytes(pp.path)
            }
        }
        return bytes("?")
    }
    mut ix := -1
    if cut == BC_B2 {
        for i <- iter.Range(0, len(st.bcBk) / 2) {
            if ix < 0 && st.bcBk[2 * i] == k1 && st.bcBk[2 * i + 1] == k2 {
                ix = i
            }
        }
    } else {
        n := table.Len(mut st.ckk)
        mut q := 0
        mut fr := -1
        while q < n && fr < 0 {
            if table.Get(mut st.ckk, q) == cut && table.Get(mut st.ckk, q + 2) == k1 && table.Get(mut st.ckk, q + 3) == k2 {
                fr = table.Get(mut st.ckk, q + 1)
            }
            q += 5 + table.Get(mut st.ckk, q + 4)
        }
        mut f := st.fhead
        mut i := 0
        while int(f) != -1 && fr >= 0 && ix < 0 {
            if int(f) == fr {
                ix = i
            }
            f = xfNext(mut st, f)
            i += 1
        }
    }
    return if ix >= 0 && ix < len(st.bcNames) { st.bcNames[ix] } else { bytes("?") }
}

// 世代のディレクトリdirの検査（開発のオプションSOBER_CACHE_FSCK=1 — 2プロセスの検査）: 全部のパックの尾・索引の検査和・全項目の値の
// 検査和を検証、`cache: fsck packs=… bad-packs=… entries=… bad-entries=… tmp=…` を標準エラーへ（tmp = 書きの途中で止まった一時ファイルの数 —
// 読みは見ない名前なので壊れではない）。読み（bcLoad）は壊れたパック・項目を飛ばすだけなので、壊れはここで数える
func bcFsck(dir string) {
    mut np := 0
    mut bp := 0
    mut ne := 0
    mut be := 0
    mut nt := 0
    es := io.ReadDir(dir) catch []io.DirEntry{}
    for e <- es {
        nb := bytes(e.Name)
        n0 := len(nb)
        if n0 > 4 && nb[n0 - 4] == '.' && nb[n0 - 3] == 't' && nb[n0 - 2] == 'm' && nb[n0 - 1] == 'p' {
            nt += 1
        } else if n0 > 5 && nb[n0 - 5] == '.' && nb[n0 - 4] == 'p' && nb[n0 - 3] == 'a' && nb[n0 - 2] == 'c' && nb[n0 - 1] == 'k' {
            np += 1
            b := io.ReadFile("${dir}/${e.Name}") catch []byte{}
            nb2 := len(b)
            il := if nb2 >= 24 && binary.Load64(b, nb2 - 24) == BC_MAGIC { binary.Load64(b, nb2 - 16) } else { -1 }
            if il >= 0 && il <= nb2 - 24 && bcSum(b, nb2 - 24 - il, nb2 - 24) == binary.Load64(b, nb2 - 8) {
                vend := nb2 - 24 - il
                mut r := BcRd{b: b, at: vend, end: nb2 - 24, bad: false}
                while r.at < r.end && !r.bad {
                    cut := bcGet(mut r)
                    _ = bcGet(mut r)
                    _ = bcGet(mut r)
                    off := bcGet(mut r)
                    n := bcGet(mut r)
                    h := bcGet(mut r)
                    if r.bad {
                        be += 1
                    } else {
                        ne += 1
                        if cut < BC_A || cut > BC_PKG || off < 0 || n < 0 || off + n > vend || bcSum(b, off, off + n) != h {
                            be += 1
                        }
                    }
                }
            } else {
                bp += 1
            }
        }
    }
    _ = io.WriteStderr(bytes("cache: fsck packs=${np} bad-packs=${bp} entries=${ne} bad-entries=${be} tmp=${nt}\n"))
}

// 切り口cutの項目の鍵h1 → 項目の開番地の表（[鍵, 項目 + 1]… — 大きさは2の冪で項目の数の2倍以上・空きのフィールド = 0。cs / ksは項目ごとの
// 切り口と鍵 h1・bcLoad が同じ鍵を 2 度積まない）
func bcProbe(cs []int, ks []int, cut int) []int {
    mut n := 0
    for c <- cs {
        if c == cut {
            n += 1
        }
    }
    mut cap := 16
    while cap < 2 * n {
        cap = cap * 2
    }
    mut t := mut []int{}
    xFill(mut t, 2 * cap, 0)
    for q <- iter.Range(0, len(cs)) {
        if cs[q] == cut {
            mut h := (ckM1(CK_S1, ks[q]) >> 3) & (cap - 1)
            while t[2 * h + 1] != 0 {
                h = (h + 1) & (cap - 1)
            }
            t[2 * h] = ks[q]
            t[2 * h + 1] = q + 1
        }
    }
    return freeze(t)
}

// bcProbe の表 t の鍵 k の項目（無ければ -1）
func bcProbeGet(t []int, k int) int {
    cap := len(t) / 2
    if cap == 0 {
        return -1
    }
    mut h := (ckM1(CK_S1, k) >> 3) & (cap - 1)
    while t[2 * h + 1] != 0 {
        if t[2 * h] == k {
            return t[2 * h + 1] - 1
        }
        h = (h + 1) & (cap - 1)
    }
    return -1
}

// ── 格納場所の一覧と世代のLRUのマーク ──
//
// 格納場所の根 = `<cacheDir>/sober-build-1`・世代 = 根の下の16桁の名前のディレクトリ。LRUの時刻 = 世代のマーク `.used` のmtime（buildの終わりに
// bcTouch が tmp + rename で置き直す。ディレクトリの mtime は使わない — 掃除が他の世代の一時ファイルを消すと進んでしまう）

// 世代 1 つの数（名前・mtime〔ns〕・パック / 一時ファイルの数・大きさの和〔バイト — パックだけ・一時ファイルは数だけ〕・最初の満杯の大きさ〔無ければ -1〕）
type BcGen struct {
    name string
    mt int
    packs int
    tmp int
    bytes int
    full int
}

// 名前 nb が s で終わるか
func bcEnds(nb []byte, s string) bool {
    sb := bytes(s)
    if len(nb) <= len(sb) {
        return false
    }
    for k <- iter.Range(0, len(sb)) {
        if nb[len(nb) - len(sb) + k] != sb[k] {
            return false
        }
    }
    return true
}

// 根の下の項目の名前が世代か（16 桁の 16 進 — 隠した世代 `.<名前>.dead-…` や他の項目は数えない）
func bcIsGen(nb []byte) bool {
    if len(nb) != 16 {
        return false
    }
    for x <- nb {
        if !((x >= '0' && x <= '9') || (x >= 'a' && x <= 'f')) {
            return false
        }
    }
    return true
}

// パックの名前 `<pid>-<乱数>-<バイト数>.pack` の大きさ（名前に大きさが無い古い形・読めない名前は中身を読んで数える）。大きさを名前に
// 持たせるのは、io.Open + io.Statをcompilerの推移的な依存で使うと自己buildの仕事が +2.15 G増えるため（一覧はbuildごとに走る）
func bcPackSize(dir string, nb []byte) int {
    mut e := len(nb) - 5
    mut v := 0
    mut m := 1
    while e > 0 && nb[e - 1] >= '0' && nb[e - 1] <= '9' {
        v += m * (int(nb[e - 1]) - 48)
        m = m * 10
        e -= 1
    }
    if e > 0 && e < len(nb) - 5 && nb[e - 1] == '-' && e - 1 > 0 && bcHasDash(nb, e - 1) {
        return v
    }
    n := string(nb) catch return 0
    b := io.ReadFile("${dir}/${n}") catch return 0
    return len(b)
}

// nb[0:e] に '-' があるか（`<pid>-<乱数>` の区切り — 大きさの無い古い名前 `<pid>-<乱数>.pack` の乱数の桁を大きさと読まない）
func bcHasDash(nb []byte, e int) bool {
    for k <- iter.Range(0, e) {
        if nb[k] == '-' {
            return true
        }
    }
    return false
}

// 世代のディレクトリ `<root>/<name>` の数
func bcGenOf(root string, name string) BcGen {
    dir := "${root}/${name}"
    // LRUの時刻 = マーク `.used` のmtime（ディレクトリのmtimeは掃除が中の一時ファイルを消しても進む — マークの無い古い世代だけディレクトリで）
    d0 := os.ModTime(dir) catch 0
    mt := os.ModTime("${dir}/.used") catch d0
    mut np := 0
    mut nt := 0
    mut nb := 0
    mut full := -1
    es := io.ReadDir(dir) catch []io.DirEntry{}
    for e <- es {
        b := bytes(e.Name)
        if bcEnds(b, ".tmp") {
            nt += 1
        } else if bcEnds(b, ".pack") {
            np += 1
            nb += bcPackSize(dir, b)
        } else if e.Name == ".full" {
            fb := io.ReadFile("${dir}/.full") catch []byte{}
            full = if len(fb) == 8 { binary.Load64(fb, 0) } else { -1 }
        }
    }
    return BcGen{name: name, mt: mt, packs: np, tmp: nt, bytes: nb, full: full}
}

// 根 root の世代の全部（新しい順 — mtime の降順・同じ mtime は名前の順）
func bcGens(root string) []BcGen {
    mut gs := mut []BcGen{}
    es := io.ReadDir(root) catch []io.DirEntry{}
    for e <- es {
        if bcIsGen(bytes(e.Name)) {
            gs = append(gs, bcGenOf(root, e.Name))
        }
    }
    // 挿入の整列（世代の数は数個〜十数個）
    mut i := 1
    while i < len(gs) {
        mut j := i
        while j > 0 && gs[j - 1].mt < gs[j].mt {
            g := gs[j - 1]
            gs[j - 1] = gs[j]
            gs[j] = g
            j -= 1
        }
        i += 1
    }
    return freeze(gs)
}

// 世代の数の上限（SOBER_CACHE_GENS — 既定 8・最低 1）
func bcMaxGens() int {
    n := lsEnvInt("SOBER_CACHE_GENS")
    return if n < 1 { 8 } else { n }
}

// 格納場所全体の大きさのしきい値（SOBER_CACHE_MAX — MiB・既定4096 = 4 GiB）
func bcMaxBytes() int {
    n := lsEnvInt("SOBER_CACHE_MAX")
    return (if n < 1 { 4096 } else { n }) * 1048576
}

// 世代の中のゴミのしきい値の床（SOBER_CACHE_FLOOR — MiB・既定64。検査で小さい格納場所でしきい値を越えさせるオプション）
func bcGenFloor() int {
    n := lsEnvInt("SOBER_CACHE_FLOOR")
    return (if n < 1 { 64 } else { n }) * 1048576
}

// 世代のディレクトリdirのLRUのマークを置き直す（`<pid>-<乱数>.used.tmp` に書いて `.used` へrename — マークのmtime = 今）
func bcTouch(dir string) {
    bcMkdirs(dir)
    tmp := "${dir}/${TmpTag()}.used.tmp"
    if io.WriteFile(tmp, []byte{}) != nil {
        return
    }
    _ = os.Rename(tmp, "${dir}/.used")
}

// `sober cache info`: 格納場所の根rootの世代の一覧（新しい順 — LRUの順位・パック・一時ファイル・大きさ・最初の満杯）と合計・しきい値を
// 標準出力へ。now = 今のコンパイラの世代の名前（マーク `*`）
func BcInfo(root string, now string) {
    gs := bcGens(root)
    println("cache: ${root}")
    mut tot := 0
    for k <- iter.Range(0, len(gs)) {
        g := gs[k]
        tot += g.bytes
        mk := if g.name == now { "*" } else { " " }
        fl := if g.full < 0 { "-" } else { "${g.full}" }
        println("${mk} ${g.name}  lru=${k + 1}  packs=${g.packs}  tmp=${g.tmp}  bytes=${g.bytes}  full=${fl}")
    }
    println("total: gens=${len(gs)} bytes=${tot}  limits: gens=${bcMaxGens()} bytes=${bcMaxBytes()} (SOBER_CACHE_GENS / SOBER_CACHE_MAX in MiB)")
}

// ── 格納場所の併合と掃除 ──
//
// buildの終わり（bcFlush）にbcAfterが1回走る: ① 世代のLRUのマーク ② 満杯の記録（`.full` — 当たりが0のbuild〔冷〕が書いた大きさの最大）
// ③ 世代の中のゴミのしきい値（世代の大きさ > max(満杯 × 4, 床 — SOBER_CACHE_FLOOR MiB・既定64) なら世代ごと捨てる — 次は冷）④ 世代のパックがBC_MERGE個を超えたら1つに
// 併合 ⑤ 根の掃除（世代の数・格納場所の大きさのしきい値・古い一時ファイル・隠した世代の残り）。錠は使わない: 消すのはrenameで隠してから（世代）か、
// 一覧の後に消えても読み手が外れとして扱うもの（パック — bcLoadは読めないパックを飛ばす）だけ。時刻はファイルシステムの時計（今置いたマークのmtime）
// と比べる。③ の満杯を「最初の build の大きさ」にしない: 1 つの世代を小さいプログラムが多数共有すると（例題・std の作業）最初の 1 本の 4 倍を
// すぐ越えて捨て続ける — 冷の最大と床で、自己の世代では最初の冷（28 MB）の 4 倍・小さいプログラムの群では床で止まる）

const BC_MERGE = 32
const BC_TMP_AGE = 600000000000 // 一時ファイルを書きかけの残りとみなす年齢（ns — 10 分。書きは build の終わりの一瞬）

// buildの終わりのマーク・満杯の記録・ゴミのしきい値・併合・掃除（dir = 今の世代のディレクトリ・wrote = このbuildが書いたパックの大きさ・
// cold = 当たりが 0 だったか）
func bcAfter(dir string, wrote int, cold bool) {
    bcTouch(dir)
    root, gen := bcSplit(dir)
    if root == "" {
        return
    }
    g := bcGenOf(root, gen)
    if cold && wrote > g.full {
        bcSetFull(dir, wrote)
    }
    full := if cold && wrote > g.full { wrote } else { g.full }
    fl := bcGenFloor()
    lim := if 4 * full > fl { 4 * full } else { fl }
    if g.bytes > lim {
        bcDropGen(root, gen)
    } else if g.packs > BC_MERGE || (g.packs > 1 && lsEnvInt("SOBER_CACHE_MERGE") == 1) {
        // SOBER_CACHE_MERGE=1: パックが2つ以上なら1つに（stage2.sh の焼き込みの段 — 索引を1か所に寄せる。焼き込みのパックの索引が
        // パックごとに散ると、読み込みで索引に触れるたびにその周りの頁も常駐する — report-cold-11）
        bcMerge(dir)
    }
    _ = bcGc(root, gen, false)
}

// 世代のディレクトリ `<根>/<世代>` を根と世代の名前に割る（割れなければ ""）
func bcSplit(dir string) (string, string) {
    b := bytes(dir)
    mut i := len(b) - 1
    while i > 0 && b[i] != '/' {
        i -= 1
    }
    if i <= 0 {
        return "", ""
    }
    r := string(b[0:i]) catch return "", ""
    n := string(b[i + 1:len(b)]) catch return "", ""
    return r, n
}

// 最初の満杯の大きさ n を世代の `.full` に書く（8 B・tmp + rename）
func bcSetFull(dir string, n int) {
    mut b := mut []byte{}
    bcLe(mut b, n)
    tmp := "${dir}/${TmpTag()}.full.tmp"
    if io.WriteFile(tmp, freeze(b)) != nil {
        return
    }
    _ = os.Rename(tmp, "${dir}/.full")
}

// ファイルシステムの時計の今（世代のディレクトリのマーク `.used` のmtime — bcTouchの直後に読む。読めなければ0 = 年齢で消さない）
func bcNow(dir string) int {
    return os.ModTime("${dir}/.used") catch 0
}

// 世代 dir のパックを全部 1 つにまとめて書き（tmp + rename）、読めた元のパックを消す。同じ鍵は先に読んだ方（値は決定的で同じ）・
// 検査和の合わない項目と壊れたパックは捨てる（壊れたパックも消す — 読みは飛ばしていた）
func bcMerge(dir string) {
    mut am := mut map[int]int{}
    mut bm := mut map[int]int{}
    mut cm := mut map[int]int{}
    mut pm := mut map[int]int{}
    mut gm := mut map[int]int{}
    mut dm := mut map[int]int{}
    mut out := mut []byte{}
    mut ix := mut []int{}
    mut srcs := mut []string{}
    es := io.ReadDir(dir) catch []io.DirEntry{}
    for e <- es {
        if bcEnds(bytes(e.Name), ".pack") {
            path := "${dir}/${e.Name}"
            b := io.ReadFile(path) catch []byte{}
            nb2 := len(b)
            if nb2 > 0 {
                srcs = append(srcs, path)
            }
            il := if nb2 >= 24 && binary.Load64(b, nb2 - 24) == BC_MAGIC { binary.Load64(b, nb2 - 16) } else { -1 }
            if il >= 0 && il <= nb2 - 24 && bcSum(b, nb2 - 24 - il, nb2 - 24) == binary.Load64(b, nb2 - 8) {
                vend := nb2 - 24 - il
                mut r := BcRd{b: b, at: vend, end: nb2 - 24, bad: false}
                while r.at < r.end && !r.bad {
                    cut := bcGet(mut r)
                    k1 := bcGet(mut r)
                    k2 := bcGet(mut r)
                    off := bcGet(mut r)
                    n := bcGet(mut r)
                    h := bcGet(mut r)
                    ok := !r.bad && cut >= BC_A && cut <= BC_D && off >= 0 && n >= 0 && off + n <= vend
                    seen := if cut == BC_A { am[k1] != nil } else if cut == BC_B1 { bm[k1] != nil } else if cut == BC_P { pm[k1] != nil } else if cut == BC_G { gm[k1] != nil } else if cut == BC_D { dm[k1] != nil } else { cm[k1] != nil }
                    if ok && !seen && bcSum(b, off, off + n) == h {
                        if cut == BC_A {
                            am[k1] = 1
                        } else if cut == BC_B1 {
                            bm[k1] = 1
                        } else if cut == BC_P {
                            pm[k1] = 1
                        } else if cut == BC_G {
                            gm[k1] = 1
                        } else if cut == BC_D {
                            dm[k1] = 1
                        } else {
                            cm[k1] = 1
                        }
                        ix = append(ix, cut)
                        ix = append(ix, k1)
                        ix = append(ix, k2)
                        ix = append(ix, len(out))
                        ix = append(ix, n)
                        ix = append(ix, h)
                        mut q := off
                        while q < off + n {
                            out = append(out, b[q])
                            q += 1
                        }
                    }
                }
            }
        }
    }
    if len(srcs) < 2 {
        return
    }
    ib := bcVarints(freeze(ix))
    il := len(ib)
    mut q := 0
    while q < il {
        out = append(out, ib[q])
        q += 1
    }
    bcLe(mut out, BC_MAGIC)
    bcLe(mut out, il)
    bcLe(mut out, bcSum(ib, 0, il))
    p := "${dir}/${TmpTag()}-${len(out)}.pack"
    tmp := p + ".tmp"
    if io.WriteFile(tmp, freeze(out)) != nil {
        return
    }
    if os.Rename(tmp, p) != nil {
        return
    }
    for s <- srcs {
        _ = os.Remove(s)
    }
}

// 世代 `<root>/<gen>` を捨てる: 隠す名前 `.<gen>.dead-<pid>-<乱数>` へ rename してから中身を消す（隠した後は読み手も書き手も
// 見ない — 走っている build の読みは外れになり、書きは世代のディレクトリを作り直す）
func bcDropGen(root string, gen string) {
    hid := "${root}/.${gen}.dead-${TmpTag()}"
    if os.Rename("${root}/${gen}", hid) != nil {
        return
    }
    bcRmDir(hid)
}

// 隠したディレクトリdirの中のファイルを1つずつ明示的に消してからdirを消す（世代の中に下のディレクトリは作らない）
func bcRmDir(dir string) {
    es := io.ReadDir(dir) catch []io.DirEntry{}
    for e <- es {
        _ = os.Remove("${dir}/${e.Name}")
    }
    _ = os.RemoveDir(dir)
}

// 根の下の項目の名前が隠した世代 `.<16 桁>.dead-…` か
func bcIsDead(nb []byte) bool {
    if len(nb) < 23 || nb[0] != '.' || !bcIsGen(nb[1:17]) {
        return false
    }
    return nb[17] == '.' && nb[18] == 'd' && nb[19] == 'e' && nb[20] == 'a' && nb[21] == 'd' && nb[22] == '-'
}

// 根 root の掃除（keep = 消さない世代 — 今の build の世代・"" なら無し）: ① 隠した世代の残り（掃除の途中で止まった分）を消す
// ② 各世代の古い一時ファイル（年齢 > BC_TMP_AGE — 書きの途中で死んだbuildの残り）を消す ③ 世代の数 > 上限か大きさの和 > しきい値なら、古い世代から
// 捨てる（keep は捨てない）。消した世代の数を返す
func bcGc(root string, keep string, verbose bool) int {
    es := io.ReadDir(root) catch []io.DirEntry{}
    for e <- es {
        if bcIsDead(bytes(e.Name)) {
            bcRmDir("${root}/${e.Name}")
        }
    }
    gs := bcGens(root)
    for g <- gs {
        dir := "${root}/${g.name}"
        if g.tmp > 0 {
            now := if g.name == keep { bcNow(dir) } else { bcClock(root) }
            bcTmpSweep(dir, now, verbose)
        }
    }
    mut n := len(gs)
    mut tot := 0
    for g <- gs {
        tot += g.bytes
    }
    mg := bcMaxGens()
    mb := bcMaxBytes()
    mut dropped := 0
    mut k := len(gs) - 1
    while k >= 0 && (n > mg || tot > mb) {
        if gs[k].name != keep {
            if verbose {
                println("cache: drop ${gs[k].name} (lru=${k + 1} bytes=${gs[k].bytes})")
            }
            bcDropGen(root, gs[k].name)
            n -= 1
            tot -= gs[k].bytes
            dropped += 1
        }
        k -= 1
    }
    return dropped
}

// ファイルシステムの時計の今（根にマーク `.now` をtmp + renameで置いてそのmtime — `sober cache gc` と今の世代でない世代の掃除用）
func bcClock(root string) int {
    tmp := "${root}/${TmpTag()}.now.tmp"
    if io.WriteFile(tmp, []byte{}) != nil {
        return 0
    }
    if os.Rename(tmp, "${root}/.now") != nil {
        return 0
    }
    return os.ModTime("${root}/.now") catch 0
}

// 世代 dir の一時ファイルのうち now より BC_TMP_AGE 以上古いものを消す（now = 0 なら何もしない）
func bcTmpSweep(dir string, now int, verbose bool) {
    if now == 0 {
        return
    }
    es := io.ReadDir(dir) catch []io.DirEntry{}
    for e <- es {
        if bcEnds(bytes(e.Name), ".tmp") {
            path := "${dir}/${e.Name}"
            mt := os.ModTime(path) catch now
            if now - mt > BC_TMP_AGE {
                if verbose {
                    println("cache: remove stale ${path}")
                }
                _ = os.Remove(path)
            }
        }
    }
}

// `sober cache gc`: 根rootの掃除（しきい値を越えていれば古い世代から捨てる・古い一時ファイル・隠した世代の残り）。今のコンパイラの世代nowは
// 捨てない
func BcGc(root string, now string) {
    d := bcGc(root, now, true)
    println("cache: gc dropped ${d} generation(s)")
    BcInfo(root, now)
}
