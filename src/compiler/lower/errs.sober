package lower

// 組み込みerror（K1'' — src/stage1/lower_types.zigのerrType / lower.zigのlabelToErr / lower_inline.zigのtryResults / lower_cont.zigのchainPush・causeOfのコピー）。
// - ラベルの型 = 全 error ラベルの union（st.errs — variant の並びは desugar の errv = ロード順 × ファイル順 × 宣言順、タグ = 添字）
// - error = (先頭ラベルのタグ, ラベルの列) の struct（st.errstruct — フィールド #tag / #cells・4 語固定 — 閉世界のラベルの大きさに依らない）。
//   列はimmの []ラベル（セルはregionの中）: 空なら先頭はフィールドなしでcauseなし（確保ゼロ）、空でなければ末尾のセルが先頭・その前がチェーン
//   （包み替えで積んだ内側の error — 外側から積んだ並び）

import "diag"
import "desugar"
import "ast"
import "std/iter"

// ラベルのunionの情報（初出で作る。SI_DECL = -1がマーク）
func errsInfo(st mut St) int {
    x := st.errs
    if x >= 0 {
        return x
    }
    info := recN(mut st, SISZ)
    desugar.HeapSet(mut st.d, info, TUnion)
    desugar.HeapSet(mut st.d, info + SI_DECL, -1)
    desugar.HeapSet(mut st.d, info + SI_PKG, desugar.MainPkg(mut st.d))
    desugar.HeapSet(mut st.d, info + SI_WORDS, 0)
    desugar.HeapSet(mut st.d, info + SI_STATE, LPending)
    desugar.HeapSet(mut st.d, info + SI_TY, rec4(mut st, TUnion, info, 0, 0))
    st.errs = info
    return info
}

// ラベルの union のレイアウト（ラベルのフィールド型は宣言側 package で解決する）
func layoutErrs(st mut St, info int) error? {
    desugar.HeapSet(mut st.d, info + SI_STATE, LLaying)
    saved_env := st.tenv
    st.tenv = -1
    err := layoutErrsBody(mut st, info)
    st.tenv = saved_env
    return err
}

func layoutErrsBody(st mut St, info int) error? {
    n := desugar.NErr(mut st.d)
    vs := listN(mut st, n)
    mut mx := 0
    for i <- iter.Range(0, n) {
        td := desugar.ErrNode(mut st.d, i)
        pk := desugar.ErrPkg(mut st.d, i)
        lay := layoutFields(mut st, pk, int(td), lA(nodeOf(mut st, nC(nodeOf(mut st, td)))))?
        vr := rec4(mut st, nodeOf(mut st, td).a, i, lay.fields, 0)
        desugar.HeapSet(mut st.d, vs + 1 + i, vr)
        if lay.words > mx {
            mx = lay.words
        }
    }
    desugar.HeapSet(mut st.d, info + SI_FIELDS, vs)
    desugar.HeapSet(mut st.d, info + SI_WORDS, 1 + mx)
    desugar.HeapSet(mut st.d, info + SI_STATE, LDone)
    return nil
}

// 型の名前（"N" か "ref.N"）の error ラベルの添字（無ければ -1）。pk は参照側の package（修飾参照は公開の検査つき — desugar.ResolveVariant）
func errLabelOf(st mut St, pk int, name desugar.StrRef) int {
    r := desugar.ResolveVariant(mut st.d, pk, name)
    return if r.kind == desugar.TopVariant && r.idx == desugar.ERRS { r.sub } else { -1 }
}

// 組み込み error の型（初出で作る）
func errType(st mut St) (int, error?) {
    x := st.errstruct
    if x >= 0 {
        return desugar.HeapGet(mut st.d, x + SI_TY), nil
    }
    u := errsInfo(mut st)
    layoutInfo(mut st, u)?
    lt := desugar.HeapGet(mut st.d, u + SI_TY)
    fs := list2(mut st, rec4(mut st, int(strLit(mut st, "#tag")), tInt(mut st), 0, 0), rec4(mut st, int(strLit(mut st, "#cells")), mkSlice(mut st, lt, false), 1, 0))
    info := recN(mut st, SISZ)
    desugar.HeapSet(mut st.d, info, TStruct)
    desugar.HeapSet(mut st.d, info + SI_DECL, -2)
    // 型引数の綴り（typeKey — `Box[error?]` のインスタンスの名前）
    desugar.HeapSet(mut st.d, info + SI_KEY, int(strLit(mut st, "error")))
    desugar.HeapSet(mut st.d, info + SI_PKG, desugar.MainPkg(mut st.d))
    desugar.HeapSet(mut st.d, info + SI_FIELDS, fs)
    desugar.HeapSet(mut st.d, info + SI_WORDS, ERR_WORDS)
    desugar.HeapSet(mut st.d, info + SI_STATE, LDone)
    ty := rec4(mut st, TStruct, info, 0, 0)
    desugar.HeapSet(mut st.d, info + SI_TY, ty)
    st.errstruct = info
    return ty, nil
}

const ERR_WORDS = 4

// ラベルの列のセルの型（全ラベルの union）
func errCellTy(st mut St) int {
    return desugar.HeapGet(mut st.d, errsInfo(mut st) + SI_TY)
}

// t が組み込み error か
func isErr(st mut St, t int) bool {
    x := st.errstruct
    return x >= 0 && isTag(mut st, t, TStruct) && desugar.HeapGet(mut st.d, t + 1) == x
}

func isErrOpt(st mut St, t int) bool {
    return isTag(mut st, t, TOpt) && isErr(mut st, desugar.HeapGet(mut st.d, t + 1))
}

// error ラベルのリテラルの型（全ラベルの union）か
func isLabel(st mut St, t int) bool {
    x := st.errs
    return x >= 0 && isTag(mut st, t, TUnion) && desugar.HeapGet(mut st.d, t + 1) == x
}

// ラベルのunionの値 → error（セルを1つ確保してコピーする）。ラベルのリテラルはcompositeが直にerrorを組むので、ここに来るのは
// union の値として持ち回った形だけ
func labelToErr(st mut St, t int, v int) (Val, error?) {
    et := errType(mut st)?
    lw := tWords(mut st, t)
    d := regionDepth(mut st)
    cell := regionAlloc(mut st, d, iconst(mut st, lw))
    storeVal(mut st, cell, 0, t, v)
    p := newAgg(mut st, et)
    store(mut st, p, 0, load(mut st, v, 0))
    store(mut st, p, 1, ptoi(mut st, cell))
    store(mut st, p, 2, iconst(mut st, 1))
    store(mut st, p, 3, d)
    return Val{t: et, v: p}, nil
}

// error のラベルのリテラルの先頭のセル（region）を取る。inner >= 0 なら包み替え: 内側の error（inner 番地）の列の後ろに 1 セル足した新しい列
// （immのappend — 最内regionへ全コピー + 1セル。内側の列が空〔フィールドなし・causeなし〕なら内側のタグだけのセルを先に置く）。
// inner < 0でフィールドなし（has = false）ならセルは取らない（-1）。inner < 0でフィールドありは -2 — 呼び手がerrFreshでerrorの値ごと組む。(セル, 列の先頭〔i64〕, 列の長さ, 深度)
func errCells(st mut St, inner int, has bool) (int, int, int, int) {
    lw := tWords(mut st, errCellTy(mut st))
    if inner < 0 {
        if !has {
            return -1, iconst(mut st, 0), iconst(mut st, 0), iconst(mut st, 0)
        }
        return -2, 0, 0, 0
    }
    d := regionDepth(mut st)
    ih := fieldPtr(mut st, inner, 1)
    ln := load(mut st, ih, 1)
    join := newBlock(mut st)
    np := param(mut st, join, TyPtr)
    cell := param(mut st, join, TyPtr)
    nl := param(mut st, join, TyI64)
    empty := newBlock(mut st)
    some := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, ln, iconst(mut st, 0)), empty, -1, some, -1)
    setCur(mut st, empty)
    p2 := regionAlloc(mut st, d, iconst(mut st, 2 * lw))
    store(mut st, p2, 0, load(mut st, inner, 0))
    br(mut st, join, list3(mut st, p2, fieldPtr(mut st, p2, lw), iconst(mut st, 2)))
    setCur(mut st, some)
    gp, gd := grow(mut st, ih, lw, d, false)
    br(mut st, join, list3(mut st, gp, gd, bin(mut st, BAdd, ln, iconst(mut st, 1))))
    setCur(mut st, join)
    return cell, ptoi(mut st, np), nl, d
}

// フィールドを持つラベル1つのerror（列 = 確保した1セル）: 値を組み、セルの番地を返す。確保はrtの呼び出し（作る関数の本体に
// regionのopを置かない — インライナーの形の規則に効かせない）。toRetならreturn文の値（関数の戻りへ行く）で、セルは戻りのコピー先の深度
// （呼び手の深度 — retFloor）にrt.err_allocで直に作る（宛先構築。戻りのコピーと同じ配置先なので、作る関数のregionに確保が載らない）。
// 他は今の深度に rt.region_alloc
func errFresh(st mut St, tag int, toRet bool) (Val, int, error?) {
    et := errType(mut st)?
    p := newAgg(mut st, et)
    store(mut st, p, 0, tag)
    d := if toRet { st.retFloor } else { regionDepth(mut st) }
    g := if toRet && st.errMark { needErrAlloc(mut st) } else { st.rtRalloc }
    cell := call(mut st, g, list2(mut st, d, iconst(mut st, tWords(mut st, errCellTy(mut st)))))
    store(mut st, p, 1, ptoi(mut st, cell))
    store(mut st, p, 2, iconst(mut st, 1))
    store(mut st, p, 3, d)
    return Val{t: et, v: p}, cell, nil
}

// rt.err_alloc(d, w) を（初出なら）宣言する（本体は programRt の buildErrAlloc — rt.region_alloc を呼ぶだけ）。return 文の error ラベルの
// セルだけがこれを通る: 呼んだパスは非nilのerrorを返すパスなので、regionの解析（rlight）が「失敗の戻りのパスだけで確保する関数」を見分けるマークになる
func needErrAlloc(st mut St) FnRef {
    lsNeed(mut st, NEED_ERRALLOC, 0)
    if st.rtErrAlloc == -1 {
        st.rtErrAlloc = addFunc(mut st, int(strLit(mut st, "rt.err_alloc")), desugar.ListRef(list2(mut st, TyI64, TyI64)), TyPtr)
    }
    return st.rtErrAlloc
}

func buildErrAlloc(st mut St) {
    if st.rtErrAlloc == -1 {
        return
    }
    begin(mut st, st.rtErrAlloc)
    ret(mut st, call(mut st, st.rtRalloc, list2(mut st, 0, 1)))
}

// rt.err_alloc の呼び出しを rt.region_alloc に置き換える（llight の後）
func errAllocLower(st mut St) {
    if st.rtErrAlloc == -1 {
        return
    }
    mut f := st.fhead
    while f != -1 {
        mut b := irFnBHead(mut st, f)
        while b != -1 {
            mut i := irBlkIHead(mut st, b)
            while i != -1 {
                if irInsOp(mut st, i) == OpCall && irInsFn(mut st, i) == st.rtErrAlloc {
                    irSetInsA(mut st, i, int(st.rtRalloc))
                }
                i = irInsNext(mut st, i)
            }
            b = irBlkNext(mut st, b)
        }
        f = irFnNext(mut st, f)
    }
}

// (タグ, 列) の error の値を組む
func errMake(st mut St, tag int, np int, nl int, d int) (Val, error?) {
    et := errType(mut st)?
    p := newAgg(mut st, et)
    store(mut st, p, 0, tag)
    store(mut st, p, 1, np)
    store(mut st, p, 2, nl)
    store(mut st, p, 3, d)
    return Val{t: et, v: p}, nil
}

// error（e番地）の先頭ラベルのセルの番地（列の末尾 — フィールドを持つラベルなら列は空でない）
func errTop(st mut St, e int) int {
    lw := tWords(mut st, errCellTy(mut st))
    return cellAt(mut st, itop(mut st, load(mut st, e, 1)), bin(mut st, BSub, load(mut st, e, 2), iconst(mut st, 1)), lw)
}

// error の cause: e（error の値のアドレス）の 1 つ内側の error?。列の長さが 1 以下なら nil、
// でなければ (列[len-2] のタグ, 列[0 : len-1])（部分列はビュー — 同じセル・同じ深度）
func causeOf(st mut St, e int, et int, lt int) int {
    ot := optOf(mut st, et)
    out := newAgg(mut st, ot)
    lw := tWords(mut st, lt)
    ln := load(mut st, e, 2)
    some := newBlock(mut st)
    none := newBlock(mut st)
    join := newBlock(mut st)
    condbr(mut st, cmp(mut st, CGt, ln, iconst(mut st, 1)), some, -1, none, -1)
    setCur(mut st, none)
    store(mut st, out, 0, iconst(mut st, 0))
    br(mut st, join, -1)
    setCur(mut st, some)
    store(mut st, out, 0, iconst(mut st, 1))
    n1 := bin(mut st, BSub, ln, iconst(mut st, 1))
    prev := cellAt(mut st, itop(mut st, load(mut st, e, 1)), bin(mut st, BSub, ln, iconst(mut st, 2)), lw)
    store(mut st, out, 1, load(mut st, prev, 0))
    store(mut st, out, 2, load(mut st, e, 1))
    store(mut st, out, 3, n1)
    store(mut st, out, 4, load(mut st, e, 3))
    br(mut st, join, -1)
    setCur(mut st, join)
    return out
}

// 後置 `?`: 呼び出しの最後の結果 error? のタグが非 0 なら、関数の結果へゼロ値 + err（`? L{…}` なら包み替え）を書いて
// 出口の後半（defer → relocate → 深度復元 → ret）へ。一致側は残りの結果の列
func tryResults(st mut St, e desugar.NodeRef) (int, error?) {
    at := e
    call0 := nA(nodeOf(mut st, e))
    if kindN(mut st, call0) != ast.ECall {
        return 0, diag.Unsupported{at: posOf(mut st, at)}
    }
    ctx := desugar.HeapGet(mut st.d, st.rets + 1)
    rts := if ctx >= 0 { hgetL(mut st, ctx + IC_RESULTS) } else { desugar.ListRef(infoAt(mut st, st.info).results) }
    n := lenL(mut st, rts)
    if n == 0 || !isErrOpt(mut st, latI(mut st, rts, n - 1)) {
        return 0, diag.Mismatch{at: posOf(mut st, at)}
    }
    mut i := 0
    while i < n - 1 {
        requireZero(mut st, latI(mut st, rts, i), at)?
        i += 1
    }
    r := evalMulti(mut st, call0)?
    if r < 0 {
        return r, nil
    }
    k := desugar.HeapGet(mut st.d, r)
    if k == 0 || !isErrOpt(mut st, desugar.HeapGet(mut st.d, r + 1 + (k - 1) * 2)) {
        return 0, diag.Mismatch{at: posOf(mut st, at)}
    }
    errt := desugar.HeapGet(mut st.d, r + 1 + (k - 1) * 2)
    errv := desugar.HeapGet(mut st.d, r + 2 + (k - 1) * 2)
    err_b := newBlock(mut st)
    ok_b := newBlock(mut st)
    tagv := load(mut st, errv, 0)
    condbr(mut st, cmp(mut st, CNe, tagv, iconst(mut st, 0)), err_b, -1, ok_b, -1)
    // エラー側: ゼロ値（ワードを0埋め → slice / mapは空ヘッダ）+ errを結果の配置先へ（結果はerror? を含むので常にsret）
    setCur(mut st, err_b)
    dst := if ctx >= 0 { desugar.HeapGet(mut st.d, ctx + IC_SLOT) } else { st.sret }
    mut off := 0
    zero := iconst(mut st, 0)
    i = 0
    while i < n - 1 {
        rt := latI(mut st, rts, i)
        mut w := 0
        while w < tWords(mut st, rt) {
            store(mut st, dst, off + w, zero)
            w += 1
        }
        zeroFill(mut st, dst, off, rt)
        off += tWords(mut st, rt)
        i += 1
    }
    wrap := nB(nodeOf(mut st, e))
    if wrap != -1 {
        // 包み替え: 内側の error の列の後ろに W{…} のセルを足した列を作る。フィールドはエラーの経路でだけ評価する
        if errLabelOf(mut st, st.curPkg, sA(nodeOf(mut st, wrap))) < 0 {
            return 0, diag.Mismatch{at: posOf(mut st, at)}
        }
        ev := compositeIn(mut st, wrap, fieldPtr(mut st, errv, 1))?
        if isTag(mut st, ev.t, TNever) {
            return -1, nil
        }
        c := coerce(mut st, ev.t, ev.v, latI(mut st, rts, n - 1), at)?
        storeVal(mut st, dst, off, c.t, c.v)
    } else {
        storeVal(mut st, dst, off, errt, errv)
    }
    if ctx >= 0 {
        inlineExit(mut st, ctx, at)?
    } else {
        funcExit(mut st, -1, at)?
    }
    setCur(mut st, ok_b)
    out := listN(mut st, (k - 1) * 2)
    desugar.HeapSet(mut st.d, out, k - 1)
    i = 0
    while i < (k - 1) * 2 {
        desugar.HeapSet(mut st.d, out + 1 + i, desugar.HeapGet(mut st.d, r + 1 + i))
        i += 1
    }
    return out, nil
}

// 開発用の計装（st.traceErrs — 関数の出口の後半の入口）: 最後の結果が error? で非 nil（error なら常に）なら
// `#errtrace <関数の表の添字> <ラベルのタグ>` を標準出力へ（println と同じ行バッファ）。持ち上げたラムダ・インスタンス（fn = -1）は出さない。
// error? の値は [opt のタグ, error（先頭ラベルのタグ, 列）] — 結果は error を含むので常に sret
func traceErr(st mut St) {
    fx := infoAt(mut st, st.info)
    rs := fx.results
    n := lenL(mut st, rs)
    if fx.fn < 0 || n == 0 || !infoSret(mut st) {
        return
    }
    mut off := 0
    for i <- iter.Range(0, n - 1) {
        off += tWords(mut st, latI(mut st, rs, i))
    }
    t := latI(mut st, rs, n - 1)
    mut tagAt := off
    if isErrOpt(mut st, t) {
        tagAt = off + 1
    } else if !isErr(mut st, t) {
        return
    }
    yes := newBlock(mut st)
    done := newBlock(mut st)
    present := if isErrOpt(mut st, t) { cmp(mut st, CNe, load(mut st, st.sret, off), iconst(mut st, 0)) } else { iconst(mut st, 1) }
    condbr(mut st, present, yes, -1, done, -1)
    setCur(mut st, yes)
    printChars(mut st, "#errtrace ")
    call(mut st, st.rtPint, list1(mut st, iconst(mut st, fx.fn)))
    printChars(mut st, " ")
    call(mut st, st.rtPint, list1(mut st, load(mut st, st.sret, tagAt)))
    printChars(mut st, "\n")
    br(mut st, done, -1)
    setCur(mut st, done)
}

// 開発用の計装（st.traceEffs — 関数の本体の頭と出口の後半）: `<w><関数の表の添字> <task>` の行（持ち上げたラムダ・インスタンスは出さない。
// task = 今のtaskのTCBの番地〔std/taskを使わないプログラムは0〕— 判定はtaskごとに呼び出しのスタックを組み直す）
func traceEff(st mut St, w string) {
    fx := infoAt(mut st, st.info)
    if fx.fn < 0 {
        return
    }
    printChars(mut st, w)
    call(mut st, st.rtPint, list1(mut st, iconst(mut st, fx.fn)))
    traceTask(mut st)
}

// 開発用の計装（st.traceEffs）: エフェクトの葉b（loader.Eff* のビット — 0は出さない）の `#effleaf <ビット> <task>` の行
func traceLeaf(st mut St, b int) {
    if !st.traceEffs || b == 0 {
        return
    }
    printChars(mut st, "#effleaf ")
    call(mut st, st.rtPint, list1(mut st, iconst(mut st, b)))
    traceTask(mut st)
}

// ` <今の task の TCB の番地>` と改行
func traceTask(st mut St) {
    printChars(mut st, " ")
    call(mut st, st.rtPint, list1(mut st, if st.taskUse { load(mut st, globaladdr(mut st, st.taskG), TK_CUR) } else { iconst(mut st, 0) }))
    printChars(mut st, "\n")
}

// 開発用の計装（st.traceErrs）: errorのswitchのsubject（値v — 先頭ラベルのタグがワード0）ごとに
// `#errsw <ファイル> <字句> <ラベルのタグ>` を標準出力へ（仮引数・cause の集合の照合 — 戻りの計装では見えない）
func traceSwitch(st mut St, sw desugar.NodeRef, v int) {
    at := posOf(mut st, sw)
    printChars(mut st, "#errsw ")
    call(mut st, st.rtPint, list1(mut st, iconst(mut st, at.file)))
    printChars(mut st, " ")
    call(mut st, st.rtPint, list1(mut st, iconst(mut st, at.tok)))
    printChars(mut st, " ")
    call(mut st, st.rtPint, list1(mut st, load(mut st, v, 0)))
    printChars(mut st, "\n")
}
