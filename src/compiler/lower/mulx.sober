package lower

// 多倍長のチャンク（std/crypto/rsaのmontMulが使う）: 組み込みの鍵2つ。cpumulx = この機械でチャンクを使えるか（0 / 1 — rt.cpuのフラグのbit 3
// 〔CPUID.7.0:EBX の bit 8 = BMI2 の MULX かつ bit 19 = ADX の ADCX / ADOX — clmul.sober の rt.cpu_probe〕・SOBER_NOMULX=1 で 0）・montmul(d, a, b, m, m0i, n)（引数は全部番地と int —
// 64 bit limb のMontgomeryの積1回まるごと〔行ごとにa·bとf·mの2本の積和・行末・condSub — x86.sober xMontMul〕。書くのはdのn + 1ワードだけ）。
// IRはOpSyscallのb = MM_B（c = 種類）: 番地を通して読み書きする不透明なop（aes.soberと同じ理由 — エフェクトの扱いはsyscallと同じ）。x86の最適化の
// バックエンドのELFのパスでだけチャンクになり（x86.sober xMontMul）、IRテキストには `mm.<種類>` で出る（stage1の語彙の外）・.llでは0。
// hwのパスでない出力ではcpumulx = 0のフラグ（MK_CPU）を出すだけで、stdの分岐がチャンクを呼ばない（倒れ先 = SoberのmontMul — チャンクの照合の相手）

const MM_B = 3

// 種類（OpSyscall の c）
const MK_CPU = 0    // a = [] → 0（hwのパスでない出力のcpumulxのフラグ）
const MK_MUL = 1    // a = [d, a, b, m, m0i, n]
const MK_SEL = 2    // a = [d, t, idx, n, stride, cnt]（mmsel — 表の定数時間の選び）
const MK_SQR = 3    // a = [d, a, m, m0i, n]（montsqr — 2 乗の専用の形）
const MK_FE = 4     // a = [d, a, b]（femul — x25519 の体の積）
const MK_SHA = 5    // a = [h, p, n, k]（sha256blk — SHA-NI の圧縮 n ブロック）

// 種類が xmm を作業に使うか（x86.sober の xHasXmmBlk — その関数は xmm に値を置かず、呼び手の xmm2〜15 を入口で退避する）
func xMmXmm(kind int) bool {
    return kind == MK_SEL || kind == MK_SHA
}

// cpumulxの値（hwのパス: rt.cpuのフラグのbit 3）
func cpuMulx(st mut St) int {
    if !st.hwFold {
        return push(mut st, true, OpSyscall, list0(mut st), MM_B, MK_CPU)
    }
    return bin(mut st, BAnd, bin(mut st, BSar, cpuMarks(mut st), iconst(mut st, 3)), iconst(mut st, 1))
}

// cpushaの値（hwのパス: rt.cpuのフラグのbit 4 — 他の出力はMK_CPUのフラグ〔0〕）
func cpuSha(st mut St) int {
    if !st.hwFold {
        return push(mut st, true, OpSyscall, list0(mut st), MM_B, MK_CPU)
    }
    return bin(mut st, BAnd, bin(mut st, BSar, cpuMarks(mut st), iconst(mut st, 4)), iconst(mut st, 1))
}

// montmul（vs = 引数の列）
func mmOp(st mut St, kind int, vs int) int {
    return push(mut st, true, OpSyscall, vs, MM_B, kind)
}

// IR テキストの綴り
func mmName(kind int) string {
    return if kind == MK_CPU { "mm.cpu " } else if kind == MK_MUL { "mm.mul " } else if kind == MK_SEL { "mm.sel " } else if kind == MK_SQR { "mm.sqr " } else if kind == MK_FE { "mm.fe " } else { "mm.sha " }
}
