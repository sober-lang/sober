const VOPEN = 1099511627776

// ── ヒープの読み書き（desugarのフィールドh = std/tableのTable）──
// 呼び出し点でdesugar.HeapGet / HeapSet / HeapPush / HeapLen(mut st.d, …) を直に呼ぶ（他のpackageのフィールドは書けず、mutの中身を持つフィールドは読めない —
// language.md 20 節）。lowerに包み（hget系）を残してdesugarのインターフェースを呼ぶ形は、IRインライナが1レベルしか畳まないので呼び出しが1レベル残り
// 自己 build の命令が目立って増える

// ── ヒープの小道具（展開される — 呼び出し点ごとに小さい）──

func put(st mut St, x int) {
    desugar.HeapPush(mut st.d, x)
}

func top(st mut St) int {
    return desugar.HeapLen(mut st.d)
}

// nワードの記録を確保する（中身は -1 — 呼び手が埋める）
func recN(st mut St, n int) int {
    at := desugar.HeapLen(mut st.d)
    for i <- iter.Range(0, n) {
        desugar.HeapPush(mut st.d, -1)
    }
    return at
}

func rec4(st mut St, a int, b int, c int, d int) int {
    at := desugar.HeapLen(mut st.d)
    desugar.HeapPush(mut st.d, a)
    desugar.HeapPush(mut st.d, b)
    desugar.HeapPush(mut st.d, c)
    desugar.HeapPush(mut st.d, d)
    return at
}

// 長さ n の列（中身は 0）
func listN(st mut St, n int) int {
    at := desugar.HeapLen(mut st.d)
    desugar.HeapPush(mut st.d, n)
    for i <- iter.Range(0, n) {
        desugar.HeapPush(mut st.d, 0)
    }
    return at
}

func list0(st mut St) int {
    at := desugar.HeapLen(mut st.d)
    desugar.HeapPush(mut st.d, 0)
    return at
}

func list1(st mut St, x int) int {
    at := desugar.HeapLen(mut st.d)
    desugar.HeapPush(mut st.d, 1)
    desugar.HeapPush(mut st.d, x)
    return at
}

func list2(st mut St, x int, y int) int {
    at := desugar.HeapLen(mut st.d)
    desugar.HeapPush(mut st.d, 2)
    desugar.HeapPush(mut st.d, x)
    desugar.HeapPush(mut st.d, y)
    return at
}

func list3(st mut St, x int, y int, z int) int {
    at := desugar.HeapLen(mut st.d)
    desugar.HeapPush(mut st.d, 3)
    desugar.HeapPush(mut st.d, x)
    desugar.HeapPush(mut st.d, y)
    desugar.HeapPush(mut st.d, z)
    return at
}

func list4(st mut St, x int, y int, z int, w int) int {
    at := desugar.HeapLen(mut st.d)
    desugar.HeapPush(mut st.d, 4)
    desugar.HeapPush(mut st.d, x)
    desugar.HeapPush(mut st.d, y)
    desugar.HeapPush(mut st.d, z)
    desugar.HeapPush(mut st.d, w)
    return at
}

func list5(st mut St, x int, y int, z int, w int, v int) int {
    at := desugar.HeapLen(mut st.d)
    desugar.HeapPush(mut st.d, 5)
    desugar.HeapPush(mut st.d, x)
    desugar.HeapPush(mut st.d, y)
    desugar.HeapPush(mut st.d, z)
    desugar.HeapPush(mut st.d, w)
    desugar.HeapPush(mut st.d, v)
    return at
}

// 生の1ワード（文字列のバイト — 木の文字列もヒープの文字列も読める。desugar.Dat）
func dat(st mut St, x int) int {
    return desugar.Dat(mut st.d, x)
}

// ── 文字列（[n, バイト…]）──

func strLit(st mut St, w string) desugar.StrRef {
    b := bytes(w)
    at := desugar.StrRef(desugar.HeapLen(mut st.d))
    desugar.HeapPush(mut st.d, len(b))
    for i <- iter.Range(0, len(b)) {
        desugar.HeapPush(mut st.d, int(b[i]))
    }
    return at
}

// strCat は文字列 a + "." + b（関数・型のキー "pkg_path.Name"）
func strDot(st mut St, a desugar.StrRef, b desugar.StrRef) desugar.StrRef {
    na := slen(mut st, a)
    nb := slen(mut st, b)
    at := desugar.StrRef(desugar.HeapLen(mut st.d))
    desugar.HeapPush(mut st.d, na + 1 + nb)
    for i <- iter.Range(0, na) {
        desugar.HeapPush(mut st.d, sat(mut st, a, i))
    }
    desugar.HeapPush(mut st.d, 46)
    for i <- iter.Range(0, nb) {
        desugar.HeapPush(mut st.d, sat(mut st, b, i))
    }
    return at
}

// 文字列 s のバイト [lo, hi) を新しい文字列にする
func strPart(st mut St, s desugar.StrRef, lo int, hi int) desugar.StrRef {
    at := desugar.StrRef(desugar.HeapLen(mut st.d))
    desugar.HeapPush(mut st.d, hi - lo)
    for i <- iter.Range(lo, hi) {
        desugar.HeapPush(mut st.d, sat(mut st, s, i))
    }
    return at
}

func strEq(st mut St, a desugar.StrRef, b desugar.StrRef) bool {
    return desugar.StrEq(mut st.d, a, b)
}

func strIs(st mut St, a desugar.StrRef, w string) bool {
    return desugar.StrIs(mut st.d, a, w)
}

// 文字列 a と、文字列 s のバイト [lo, hi) の一致
func strEqPart(st mut St, a desugar.StrRef, s desugar.StrRef, lo int, hi int) bool {
    return desugar.StrEqPart(mut st.d, a, s, lo, hi)
}

// 文字列 s の最初の '.' の位置（無ければ -1）
func dotAt(st mut St, s desugar.StrRef) int {
    mut i := 0
    while i < slen(mut st, s) {
        if sat(mut st, s, i) == '.' {
            return i
        }
        i += 1
    }
    return -1
}

// ── 表層 AST の読み出し（desugar と同じ — 木か合成の表の節を ast.Node で読む。参照は desugar/astref.sober）──

// EVal（評価済みの値の合成節）の番号は ast.EVal（種類の番号の表と 1 か所で管理）
const EVal = ast.EVal

// 表層 AST の節を足す（lower が合成する — 補間の連結の連鎖・pipe の値。位置 = 節 at — 字句とファイルを継ぐ）
func node(st mut St, k int, at desugar.NodeRef, a int, b int, c int, d int) int {
    return desugar.SynNode(mut st.d, ast.Node{kind: k, tok: desugar.TokAt(mut st.d, int(at)), a: a, b: b, c: c, d: d, e: 0, f: 0}, at)
}

// 節 n の位置（拒否の位置 — desugar.PosOf）
func posOf(st mut St, n desugar.NodeRef) diag.Pos {
    return desugar.PosOf(mut st.d, n)
}

// ── 型付きの読みのインターフェース（desugar.NodeRef / ListRef — desugarのstate.soberと同じ並び）──

func nodeOf(st mut St, n desugar.NodeRef) ast.Node {
    return desugar.NodeOf(mut st.d, n)
}

func kindN(st mut St, n desugar.NodeRef) int {
    return desugar.KindN(mut st.d, n)
}

func tokN(st mut St, n desugar.NodeRef) int {
    return desugar.TokAt(mut st.d, int(n))
}

func lenL(st mut St, l desugar.ListRef) int {
    return desugar.LenL(mut st.d, l)
}

func latI(st mut St, l desugar.ListRef, i int) int {
    return desugar.LatI(mut st.d, l, i)
}

func latN(st mut St, l desugar.ListRef, i int) desugar.NodeRef {
    return desugar.NodeRef(desugar.LatI(mut st.d, l, i))
}

func latL(st mut St, l desugar.ListRef, i int) desugar.ListRef {
    return desugar.ListRef(desugar.LatI(mut st.d, l, i))
}

func lput(st mut St, l desugar.ListRef, i int, v int) {
    desugar.HeapSet(mut st.d, int(l) + 1 + i, v)
}

func slen(st mut St, s desugar.StrRef) int {
    return desugar.Dat(mut st.d, int(s))
}

func sat(st mut St, s desugar.StrRef, i int) int {
    return desugar.Dat(mut st.d, int(s) + 1 + i)
}

func sput(st mut St, s desugar.StrRef, i int, v int) {
    desugar.HeapSet(mut st.d, int(s) + 1 + i, v)
}

func latS(st mut St, l desugar.ListRef, i int) desugar.StrRef {
    return desugar.StrRef(desugar.LatI(mut st.d, l, i))
}

func hgetS(st mut St, i int) desugar.StrRef {
    return desugar.StrRef(desugar.HeapGet(mut st.d, i))
}

func sA(x ast.Node) desugar.StrRef {
    return desugar.StrRef(x.a)
}

func sB(x ast.Node) desugar.StrRef {
    return desugar.StrRef(x.b)
}

func sC(x ast.Node) desugar.StrRef {
    return desugar.StrRef(x.c)
}

func sD(x ast.Node) desugar.StrRef {
    return desugar.StrRef(x.d)
}

func sE(x ast.Node) desugar.StrRef {
    return desugar.StrRef(x.e)
}

func hgetN(st mut St, i int) desugar.NodeRef {
    return desugar.NodeRef(desugar.HeapGet(mut st.d, i))
}

func hgetL(st mut St, i int) desugar.ListRef {
    return desugar.ListRef(desugar.HeapGet(mut st.d, i))
}

func nA(x ast.Node) desugar.NodeRef {
    return desugar.NodeRef(x.a)
}

func nB(x ast.Node) desugar.NodeRef {
    return desugar.NodeRef(x.b)
}

func nC(x ast.Node) desugar.NodeRef {
    return desugar.NodeRef(x.c)
}

func nD(x ast.Node) desugar.NodeRef {
    return desugar.NodeRef(x.d)
}

func nE(x ast.Node) desugar.NodeRef {
    return desugar.NodeRef(x.e)
}

func lA(x ast.Node) desugar.ListRef {
    return desugar.ListRef(x.a)
}

func lB(x ast.Node) desugar.ListRef {
    return desugar.ListRef(x.b)
}

func lC(x ast.Node) desugar.ListRef {
    return desugar.ListRef(x.c)
}

func lD(x ast.Node) desugar.ListRef {
    return desugar.ListRef(x.d)
}

func lE(x ast.Node) desugar.ListRef {
    return desugar.ListRef(x.e)
}

// ── 表: package（[path, name, flo, fhi, imports（[n, (ref, pkg)…]）, 0]）・ファイル（[根, package]）・関数・const ──

func pkgPath(st mut St, pk int) desugar.StrRef {
    return desugar.PkgPath(mut st.d, pk)
}

func pkgFlo(st mut St, pk int) int {
    return desugar.PkgFlo(mut st.d, pk)
}

func pkgFhi(st mut St, pk int) int {
    return desugar.PkgFhi(mut st.d, pk)
}

func fileRoot(st mut St, f int) desugar.NodeRef {
    return desugar.FileRoot(mut st.d, f)
}

// package pk の import の参照名（文字列 s のバイト [lo, hi)）の行き先 package（無ければ -1）
func importOf(st mut St, pk int, s desugar.StrRef, lo int, hi int) int {
    return desugar.ImportOf(mut st.d, pk, s, lo, hi)
}

func isStdPkg(st mut St, pk int) bool {
    return desugar.IsStdPkg(mut st.d, pk)
}

func nfn(st mut St) int {
    return desugar.Nfn(mut st.d)
}

func fnNode(st mut St, i int) desugar.NodeRef {
    return desugar.NodeRef(desugar.FnAt(mut st.d, i).node)
}

func fnPkg(st mut St, i int) int {
    return desugar.FnAt(mut st.d, i).pkg
}

func fnExpands(st mut St, i int) bool {
    return desugar.FnAt(mut st.d, i).expands
}

// 関数 i を region 透過の実体関数として呼ぶか（`--passes` のときの、関数型の引数を持たない展開関数）
func fnTransparent(st mut St, i int) bool {
    return st.transparent && desugar.FnAt(mut st.d, i).closed
}

func fnMutDef(st mut St, i int) bool {
    return desugar.FnAt(mut st.d, i).mutDef
}

// 関数宣言のフィールド（KFuncDecl: a = 名前, b = type_params, c = params, d = results, e = body, f = 付加 [bodiless, …]）
func fnName(st mut St, i int) desugar.StrRef {
    return sA(nodeOf(mut st, fnNode(mut st, i)))
}

func fnTParams(st mut St, i int) desugar.ListRef {
    return lB(nodeOf(mut st, fnNode(mut st, i)))
}

func fnParams(st mut St, i int) int {
    return nodeOf(mut st, fnNode(mut st, i)).c
}

func fnResults(st mut St, i int) int {
    return nodeOf(mut st, fnNode(mut st, i)).d
}

func fnBody(st mut St, i int) int {
    return nodeOf(mut st, fnNode(mut st, i)).e
}

func fnBodiless(st mut St, i int) bool {
    x := desugar.ListRef(nodeOf(mut st, fnNode(mut st, i)).f)
    return x != -1 && latI(mut st, x, 0) != 0
}

func ncon(st mut St) int {
    return desugar.Ncon(mut st.d)
}

func conNode(st mut St, i int) desugar.NodeRef {
    return desugar.ConNode(mut st.d, i)
}

func conPkg(st mut St, i int) int {
    return desugar.ConPkg(mut st.d, i)
}

func conValue(st mut St, i int) int {
    return desugar.ConValue(mut st.d, i)
}

func conHas(st mut St, i int) bool {
    return desugar.ConHas(mut st.d, i)
}

func conDict(st mut St, i int) bool {
    return desugar.ConDict(mut st.d, i)
}

// トップレベル名の解決（desugar.ResolveTop / ResolveSel — build と check の共有）が関数ならその関数の表の添字（でなければ -1）
func fnOf(r desugar.TopRef) int {
    return if r.kind == desugar.TopFn { r.idx } else { -1 }
}
