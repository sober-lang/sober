package lower

// 表層型検査器（desugar/typer.sober — C1 B1）の差分オラクル: lower が下ろした式ごとに、表層型を lower の型と突き合わせて数える
// （`sober build --typer-diff`）。表層型 → lower の型の写像はここの yMatch が正

import "desugar"
import "ast"
import "std/iter"
import "std/table"

const YLOGMAX = 40

// yCompare は式 e の lower の型 t を表層型の表と突き合わせる
func yCompare(st mut St, e desugar.NodeRef, t int) {
    if int(e) >= desugar.SBASE && int(e) < desugar.LBASE {
        // 合成の節（脱糖器の書き換え・lower の持ち上げ — 表層 AST に無い）は比べない
        st.yskip += 1
        return
    }
    y := desugar.YTypeOf(mut st.d, desugar.NodeRef(e))
    if y < 0 {
        st.yabs += 1
        if table.Len(mut st.yabsk) == 0 {
            for _ <- iter.Range(0, 100) {
                table.Push(mut st.yabsk, 0)
            }
        }
        k := kindN(mut st, e)
        if k >= 0 && k < 100 {
            table.Set(mut st.yabsk, k, table.Get(mut st.yabsk, k) + 1)
        }
        if table.Len(mut st.ylog) < YLOGMAX * 4 * 2 {
            // 表に無い式も位置を残す（種類は負の数で区別 — 表層型の種類の欄に -節の種類）
            table.Push(mut st.ylog, desugar.FileOf(mut st.d, e))
            table.Push(mut st.ylog, tokN(mut st, e))
            table.Push(mut st.ylog, 0 - k)
            table.Push(mut st.ylog, desugar.HeapGet(mut st.d, t))
        }
        return
    }
    if desugar.YHasHole(mut st.d, y) || isTag(mut st, t, TNever) {
        st.yskip += 1
        return
    }
    r := yMatch(mut st, y, t)
    if r == 1 {
        st.ymatch += 1
    } else if r == 0 {
        st.ymis += 1
        if table.Len(mut st.ylog) < YLOGMAX * 4 * 3 {
            table.Push(mut st.ylog, desugar.FileOf(mut st.d, e))
            table.Push(mut st.ylog, tokN(mut st, e))
            table.Push(mut st.ylog, desugar.YAt(mut st.d, y).k)
            table.Push(mut st.ylog, desugar.HeapGet(mut st.d, t))
        }
    } else {
        st.yskip += 1
    }
}

// yMatch は表層型 y と lower の型 t が同じ型か（1 = 同じ・0 = 違う・-1 = 比べない）
func yMatch(st mut St, y int, t int) int {
    x := desugar.YAt(mut st.d, y)
    k := x.k
    switch k {
    case desugar.YInt:
        return b2i(isTag(mut st, t, TInt))
    case desugar.YBool:
        return b2i(isTag(mut st, t, TBool))
    case desugar.YByte:
        return b2i(isTag(mut st, t, TByte))
    case desugar.YFloat:
        return b2i(isTag(mut st, t, TFloat))
    case desugar.YString:
        return b2i(isString(mut st, t))
    case desugar.YNone:
        return b2i(isTag(mut st, t, TNone))
    case desugar.YNever:
        return b2i(isTag(mut st, t, TNever))
    case desugar.YNil:
        return b2i(isTag(mut st, t, TNil))
    case desugar.YErr:
        return b2i(isTag(mut st, t, TStruct) && desugar.HeapGet(mut st.d, t + 1) == st.errstruct)
    case desugar.YLabel:
        return b2i(isTag(mut st, t, TUnion) && desugar.HeapGet(mut st.d, t + 1) == st.errs)
    case desugar.YSlice:
        if !isTag(mut st, t, TSlice) || isString(mut st, t) || desugar.HeapGet(mut st.d, t + 2) != x.b {
            return 0
        }
        return yMatch(mut st, x.a, desugar.HeapGet(mut st.d, t + 1))
    case desugar.YMap:
        if !isTag(mut st, t, TMap) || desugar.HeapGet(mut st.d, t + 3) != x.c {
            return 0
        }
        return yAnd(yMatch(mut st, x.a, desugar.HeapGet(mut st.d, t + 1)), yMatch(mut st, x.b, desugar.HeapGet(mut st.d, t + 2)))
    case desugar.YOpt:
        return if isTag(mut st, t, TOpt) { yMatch(mut st, x.a, desugar.HeapGet(mut st.d, t + 1)) } else { 0 }
    case desugar.YDecl:
        if isTag(mut st, t, TNamed) {
            return b2i(desugar.HeapGet(mut st.d, t + 2) == x.a)
        }
        if isTag(mut st, t, TFnv) {
            return -1
        }
        if isClosT(mut st, t) {
            // 値の位置の named fn type の閉包の struct（closure.sober）— 宣言 K で照合
            return b2i(desugar.HeapGet(mut st.d, desugar.HeapGet(mut st.d, desugar.HeapGet(mut st.d, t + 1) + CL_K) + 1) == x.a)
        }
        if !isTag(mut st, t, TStruct) && !isTag(mut st, t, TUnion) {
            return 0
        }
        info := desugar.HeapGet(mut st.d, t + 1)
        if desugar.HeapGet(mut st.d, info + SI_DECL) != x.a {
            return 0
        }
        ta := hgetL(mut st, info + SI_TARGS)
        if x.c < 0 || ta == -1 {
            return b2i(x.c < 0 && ta == -1)
        }
        return yMatchList(mut st, desugar.ListRef(x.c), ta)
    case desugar.YVar:
        // 型パラメータは今の型環境（ジェネリック関数のインスタンス・展開）で名前から引いた型と比べる
        b := envLookup(mut st, st.tenv, desugar.StrRef(x.b))
        return if b < 0 { -1 } else { b2i(tEql(mut st, b, t)) }
    case desugar.YFn:
        if !isTag(mut st, t, TFnv) && !isClosT(mut st, t) {
            return 0
        }
        ft := if isClosT(mut st, t) { closFt(mut st, t) } else { desugar.HeapGet(mut st.d, t + 1) }
        return yAnd(yMatchList(mut st, desugar.ListRef(x.a), hgetL(mut st, ft)), yMatchList(mut st, desugar.ListRef(x.b), hgetL(mut st, ft + 1)))
    }
    return -1
}

func yMatchList(st mut St, yl desugar.ListRef, tl desugar.ListRef) int {
    if lenL(mut st, yl) != lenL(mut st, tl) {
        return 0
    }
    mut r := 1
    for i <- iter.Range(0, lenL(mut st, tl)) {
        r = yAnd(r, yMatch(mut st, latI(mut st, yl, i), latI(mut st, tl, i)))
    }
    return r
}

// yAnd は突き合わせの結果の積（どれかが違えば違う・でなくどれかを比べなければ比べない）
func yAnd(a int, b int) int {
    if a == 0 || b == 0 {
        return 0
    }
    return if a == -1 || b == -1 { -1 } else { 1 }
}

func b2i(b bool) int {
    return if b { 1 } else { 0 }
}

// yReport は突き合わせの報告: [一致, 不一致, 表に無い, 比べない, 記録の数 n, 表に無い式の種類ごとの数（100 語）, (ファイル, 字句, 表層型の種類, lower の型の種類) × n]
func yReport(st mut St, out mut []int) {
    out = append(out, st.ymatch)
    out = append(out, st.ymis)
    out = append(out, st.yabs)
    out = append(out, st.yskip)
    n := table.Len(mut st.ylog) / 4
    out = append(out, n)
    // 表に無い式の節の種類ごとの数（100 語 — 検査器の断片を広げる順の目安）
    for k <- iter.Range(0, 100) {
        out = append(out, if table.Len(mut st.yabsk) == 0 { 0 } else { table.Get(mut st.yabsk, k) })
    }
    for i <- iter.Range(0, n * 4) {
        out = append(out, table.Get(mut st.ylog, i))
    }
}

// yLower は表層型 y（desugar/typer.sober の表）の lower の型（写せなければ -1 — 多値・名前付き関数型・不明の成分）。
// 型パラメータは今の型環境から名前で引く
func yLower(st mut St, y int, at desugar.NodeRef) (int, error?) {
    if y < 0 {
        return -1, nil
    }
    x := desugar.YAt(mut st.d, y)
    k := x.k
    switch k {
    case desugar.YInt:
        return tInt(mut st), nil
    case desugar.YBool:
        return tBool(mut st), nil
    case desugar.YByte:
        return tByte(mut st), nil
    case desugar.YFloat:
        return tFloat(mut st), nil
    case desugar.YString:
        return mkString(mut st), nil
    case desugar.YNone:
        return tNone(mut st), nil
    case desugar.YNever:
        return tNever(mut st), nil
    case desugar.YNil:
        return tNil(mut st), nil
    case desugar.YErr:
        return errType(mut st)
    case desugar.YLabel:
        u := errsInfo(mut st)
        layoutInfo(mut st, u)?
        return desugar.HeapGet(mut st.d, u + SI_TY), nil
    case desugar.YVar:
        return envLookup(mut st, st.tenv, desugar.StrRef(x.b)), nil
    case desugar.YSlice:
        e := yLower(mut st, x.a, at)?
        return if e < 0 { -1 } else { mkSlice(mut st, e, x.b == 1) }, nil
    case desugar.YMap:
        kt := yLower(mut st, x.a, at)?
        vt := yLower(mut st, x.b, at)?
        return if kt < 0 || vt < 0 { -1 } else { mkMap(mut st, kt, vt, x.c == 1) }, nil
    case desugar.YOpt:
        p := yLower(mut st, x.a, at)?
        return if p < 0 { -1 } else { rec4(mut st, TOpt, p, 1 + tWords(mut st, p), 0) }, nil
    case desugar.YFn:
        pl := yLowerList(mut st, desugar.ListRef(x.a), at)?
        rl := yLowerList(mut st, desugar.ListRef(x.b), at)?
        return if pl == -1 || rl == -1 { -1 } else { rec4(mut st, TFnv, rec4(mut st, int(pl), int(rl), 0, 0), 0, 0) }, nil
    case desugar.YDecl:
        bk := kindN(mut st, nC(nodeOf(mut st, desugar.NodeRef(x.a))))
        if bk == ast.BDefined {
            return namedTy(mut st, desugar.NodeRef(x.a)), nil
        }
        if bk != ast.BStruct && bk != ast.BUnion {
            return -1, nil
        }
        mut info := -1
        // error を返す task の handle（Task[(T, error?)] — P3b 残穴1）: lower の handle の型は Task[T]（T = 1 つ目 — parSpawnTy と同じ）
        y0 := desugar.ParTaskTupleY(mut st.d, y, 0)
        if x.c < 0 {
            info = infoOf(mut st, x.a)
        } else if y0 >= 0 {
            t0 := yLower(mut st, y0, at)?
            if t0 < 0 {
                return -1, nil
            }
            info = instStructTys(mut st, desugar.NodeRef(x.a), x.b, desugar.ListRef(list1(mut st, t0)), at)?
        } else {
            targs := yLowerList(mut st, desugar.ListRef(x.c), at)?
            if targs == -1 {
                return -1, nil
            }
            info = instStructTys(mut st, desugar.NodeRef(x.a), x.b, targs, at)?
        }
        if info < 0 {
            return -1, nil
        }
        layoutInfo(mut st, info)?
        return desugar.HeapGet(mut st.d, info + SI_TY), nil
    }
    return -1, nil
}

func yLowerList(st mut St, l desugar.ListRef, at desugar.NodeRef) (desugar.ListRef, error?) {
    n := lenL(mut st, l)
    out := desugar.ListRef(listN(mut st, n))
    for i <- iter.Range(0, n) {
        t := yLower(mut st, latI(mut st, l, i), at)?
        if t < 0 {
            return -1, nil
        }
        lput(mut st, out, i, t)
    }
    return out, nil
}

