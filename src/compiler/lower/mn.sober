package lower

// M:N の rt（段 6 P4-4・6 節・language.md 11 節「P4 の意味の裁定」）: ワーカー = OS のスレッド（clone — syscall 直）。
// - ワーカー数 = sched_getaffinity のコア数（SOBER_WORKERS は試験と計測の口 — 1 なら今の協調形のまま〔子を先に・SOBER_SCHED の全列挙〕で何も起こさない）。
//   ワーカー 1〜N-1 は最初の M:N の spawn で起こす（rt.mn_start — std/task を使って spawn しないプログラムはスレッドを持たない）
// - 走り始めた task はワーカーに固定（TC_WORKER）。spawn = 子を自分の列の底へ（ワーカーごとの両端の列 — THE 規約・持ち主は鍵なし。あふれは
//   共有の積み〔スピンロック + LIFO〕へ）— 親は先へ進む（help-first）。暇なワーカーは他の列の頭から未着手の子だけを盗む（段 6 Skynet 回収 (a)）
// - 待ち = 自分の走れる積み → 受け箱（他のワーカーからの起こし — Treiber の CAS）→ 自分の列の底 → 共有の積み → 盗み → 回る → 眠る
//   （futex — 眠りの語そのものが futex の語）
// - 起こし = 持ち主のワーカーが自分なら積み・他なら受け箱 + 眠っていれば起こす（眠りの語を 1 → 0 に CAS した側が暇の数を減らす）
// - 暇の数 = N（全ワーカーが眠りの手前）で全受け箱と共有の積みと全ワーカーの列が空・暇の数を読み直しても N ならデッドロック（定義された死 — Kahn により有無はスケジュールに依らない）
// - プール: 塊（TCB + スタック）とスロットはワーカーごと + 共有の予備（スピンロック）。終わった塊は「次に終わる task」が返す（自分が乗っているスタックを
//   他のワーカーに渡さない — WK_ZOMBIE）
// - 遅延注入の口（schedfuzz — SOBER_SCHED_SEED）: spawn・自分の列の底から取る・盗み・起こし・枠の公開・チャネルの枠の点で 0〜255 回の空回し
//   （ときどき sched_yield）

import "desugar"
import "std/iter"

// @rt.mn（プロセスに 1 つ）
// 語の置き場（段 6 Skynet 回収 手 1）: 読むだけの語・書かれる語の群を互いに 8 語以上離す（表の先頭は 64 B に揃っていないので、
// どこで行が切れても別の群と同じ行に乗らない距離）。spawn / 取るたびに読む語（N・TRACE・STARTED）が鍵の行と跳ね合っていた（偽共有）
const MN_N = 0
const MN_TRACE = 1
const MN_STARTED = 2
const MN_STATS = 3    // 1 = 計測（SOBER_PAR_STATS — 段 6 P5-1 pstat.sober）
const MN_CAP = 4      // 根の天井（バイト — 入口で 1 度・P5-2 から入場の判定に）
const MN_CAPSRC = 5   // その出どころ（1 = cgroup の memory.max・2 = MemTotal・3 = 試験の口 SOBER_BUDGET_MB）
const MN_RSS0 = 6     // 入口の RSS（バイト）
const MN_CPUQ = 7     // cgroup の cpu.max から出るワーカーの上限（0 = 制限なし）
const MN_AFFC = 8     // sched_getaffinity のコア数（MN_N を決める前の値 — 計測の表示）
const MN_PIN = 13     // 1 = ワーカーを許可の CPU へ 1:1 で固定する（report-1161 — rt.mn_pin・mnInit が決める）
const MN_TCAP = 9     // 生きている task の数の天井（VA の上界 — 段 6 P5-2 admit.sober: VA_BUDGET ÷ スロットの大きさ ÷ 2）
const MN_PLOCK = 16
const MN_PHEAD = 17
const MN_PTAIL = 18   // （使わない — 段 6 P4-6 で pull 列を積みにした。数え口〔変異 4〕が別ワーカーへの起こしの数に借りる）
const MN_IDLE = 32
const MN_SPINN = 33   // 眠る前に回っているワーカーの数（段 6 P4-6 — 回るのは MN_SPINMAX 本まで・回る者がいれば spawn は起こさない）
const MN_SPINMAX = 2
const MN_OLOCK = 48   // 出力の区間（out.sober）の鍵
const MN_EXIT = 49    // 終わりの drain を始めた印
const MN_RLOCK = 64   // 共有の予備（塊・スロット）の鍵
const MN_RTCB = 65    // 共有の予備の塊の鎖（TC_NEXT）
const MN_TID = 80     // task の通し番号（trace）
const MN_EV = 81      // 出来事の通し番号（trace）
const MN_CNT_CROSS = 96   // 数え口（変異 4）: spawn した task と別のワーカーで走り始めた数
const MN_CNT_START = 97   // 同: 走り始めた task の数
const MN_AFF = 112    // sched_getaffinity の作業域（16 語 = 1024 CPU — 入口で 1 度だけ）
const MN_WK = 136     // ワーカー k の rt.wk の番地（mn_start の後は読むだけ）
const MAXW = 64
// 入場の台帳（段 6 P5-2 admit.sober — 全ワーカーが xadd で書く群。読むだけの MN_WK の表から 16 語離す）
const MN_LED = MN_WK + MAXW + 16   // 天井の残り（ガードビットつきの 2 欄 — admit.sober の LED_*）
const MN_LINL = MN_LED + 1          // 縮退した子の数
const MN_LOVER = MN_LED + 2         // 天井を超えて入場した子の数（give: の子 — 常に入場）
const MN_LDOVER = MN_LED + 3        // 宣言（budget:）を超えて使った task の数（段 6 P5-3 — 記帳だけ・強制は後便）
const MN_LPEAKB = MN_LED + 4        // 計上中のバイトの高水位（計測のときだけ — rt.pstat_spawn）
const MN_LPEAKT = MN_LED + 5        // 計上中の task の数の高水位（計測のときだけ）
const MN_LSHED = MN_LED + 6         // SpawnIn の shed の数（段 6 P5-4）
const MN_LPEAKA = MN_LED + 7        // 計上中のバイトの高水位 — 天井を超えた計上（give: の超過・縮退の記帳）込み（計測のときだけ — 段 3 の ② の網: 計上 ≥ 実使用）
const MN_LWAIT = MN_LED + 8         // wait の scope で入場を待った回数（段 3 の ③ — Ledger の 9・#par admit waits）
const MN_AWAIT = MN_LED + 9         // 入場の待ちの鎖の頭（TC_AWNEXT で繋ぐ — 鍵 MN_ALOCK の下で積む・取る）
const MN_ALOCK = MN_LED + 10
const MN_AGEN = MN_LED + 11         // 台帳の返しの通し番号（待ち手の取りこぼし防止 — 返し手は足してから鎖を見る・待ち手は積んでから番号を見る）
const MN_SLOTVA = MN_LED + 12      // 写したスロットの VA（バイト — 名前つきプールを使うプログラムだけ数える。SpawnIn の入場は VA_SHED を越えたら shed — report-1077 A4）
// 飽和下の待ちの上限（language.md 28 節 ring の道 — report-1141 / 1142）: TSC の周波数の校正（MN_TSCQ = TSC の数 / ns × 65536・0 = まだ〔TSCQ_DEF と仮定〕）。
// 最初に積みの底を見たワーカーが MN_TSC0 / MN_NS0 に 1 点目を置き、TSC が 2^25（≈ 10 ms）進んだら CLOCK_MONOTONIC と 2 点目で割る（MN_TSC0 = -1 で済み）。
// 台帳の語（MN_LED〜 — spawn のたびに書く）と同じ行に置かない（深いときの周ごとに MN_TSCQ を読む）
const MN_TSCQ = MN_LED + 16
const MN_TSC0 = MN_LED + 17
const MN_NS0 = MN_LED + 18
const MN_WORDS = MN_LED + 24
const MN_WAIT_DEF = 100000000 // 既定の D（ns — net.Serve の maxWait: の既定と同じ）
const TSCQ_DEF = 262144        // 校正の前の仮定（4 GHz — D は長めに出る側）
// 受け箱の先読み（積みが空でなくても受け箱を先に取り込む — report-1132 (b)）は MN_INBOX_EVERY 周に 1 回。毎周だと積みが空まで掃ける周期を壊して
// 底を沈める（64vcpu の本家形で p99 が D に貼り付いた読み — report-1149 / 1150）。受け箱の未着手の延びは高々この周の数。2 の冪
const MN_INBOX_EVERY = 256
// @rt.sres（共有の予備のスロット — [数, 基底…]）。上限は rt.sdp（深度ごとの共有の列 — 32 列 × SRES_CAP 語の bss・触った分だけ常駐）と合わせての本数。
// 65536 = 同時に寝る task の数 × park で返す深度の数（L1-R — 32000 接続 × 数本）を溢れない大きさ（4096 では async の 16000 接続で溢れて
// munmap と写し足しが往復した — report-1066 / 1067）
const SRES_CAP = 65536
// 予備の冷えた水位（rt.sres の SRES_WM 語 = 下から何本を先頭の W_MADV まで返し済みか・SRES_WM + 1 語 = そのときの水位の位置のスロット — 番兵。rt.slot_trim）
const SRES_WM = 1 + SRES_CAP
// @rt.wk（ワーカーの表）
const WK_ID = 0
const WK_SLEEP = 1    // 1 = 眠っている（futex の語）・2 = ring で眠っている（IO 便 段 1 — uring.sober）
const WK_INBOX = 2    // 受け箱（TC_INEXT の鎖）
const WK_ZOMBIE = 3   // 終わった task の塊（次に終わる task が返す）
// 語 4 = WK_NETW（netpoll.sober — 旧 WK_NFREE の空き）
const WK_RND = 5      // 遅延注入の乱択の状態（0 = 注入しない）
const WK_RLAB = 6     // 写しの印の上書き（0 = 無し — チャネルの小アリーナ (B4)）
const WK_SLAB = 7     // 預かりの小さな塊（KEEP_SMALL バイト）の空きの鎖（(B1) — 結果の小さい子の預かり）
const WK_SS = 8       // 代替スタックの stack_t（3 語）
const WK_CUT = 11     // 1 = 今の task は打ち切りの印を見直す（検査点の速い道が読む — 印を立てたら全ワーカーに・切替で「印が 1 度でも立ったか」。段 6 P4-5）
// ワーカーごとの両端の列（段 6 Skynet 回収 (a): Cilk-5 の THE 規約）: spawn された未着手の子だけが入る・添字 H ≤ T は単調・
// 環の位置 = 添字 & (DQ_CAP − 1)。持ち主は底（T）で積む / 取る（鍵なし）・暇なワーカーは頭（H）から盗む（盗み手どうしは WK_DLOCK で直列化）。
// 語の置き場は行を分ける（T = 持ち主だけが書く・鍵と H = 盗み手が書く）。あふれ（T − H ≥ DQ_CAP − 1）は共有の積み（MN_PHEAD）へ
const WK_DT = 16
// 置き場の印（report-709〜711・1172 — 持ち主だけが書く行に同居）: PLOWN = 印を置いた task（その task の次の spawn 1 回が消費）・PLTO = 行き先
// （k ≥ 0 = 自分を除いた k 番目のワーカー・-1 = 自分の走れる積み）
const WK_PLOWN = 17
const WK_PLTO = 18
const WK_DLOCK = 24
const WK_DH = 25
const WK_DQ = 32
const DQ_CAP = 256
const DQ_NEED = 4   // spawn が起こしに行く「溜まっていた」の閾値（自分の列の長さ — 盗みは 1 つずつ遅れて追うので 1 以上は常態）
// 他のワーカーが返した枠の塊の鎖（report-697 — handle を捨てた子の枠: 子は盗まれて別のワーカーで終わるので、終わった側が持ち主のこの鎖へ CAS で積み、
// 持ち主は自分の鎖が空のときに xchg で丸ごと取る。行を分ける — 両端の列の後ろの行）
const WK_RFREE = WK_DQ + DQ_CAP
// 深度ごとのプール（report-1018 — 終わった子のスロットを深度 k & DP_MASK ごとの手元の列へ。次の子は深度 d に列 d & DP_MASK から取る: 同じ種類の子は生まれる
// 深度が同じなので深度の役が揃い、W_MADV 以下の触った頁〔返さない〕を別の役へ持ち回らない — report-1016 の ③）。持ち主だけが読み書き:
// WK_DPC + r = 列 r の数（DP_CAP まで）・WK_DPS + r × DP_CAP + i = 基底。列はスロットの外（取りの道で冷えたスロットを読まない）。
// 手元の列が満杯なら共有の予備の深度ごとの列（@rt.sdp — 鍵 MN_RLOCK・予備の単体 @rt.sres と合わせて SRES_CAP 本まで・越えたら munmap）へ。
// 取りは手元の列 → 共有の列（1 本を渡し、DP_CAP − 1 本まで手元へ移す）→ 単体のプール。他のワーカーが CAS で書く WK_RFREE の行と分ける
const DP_MASK = 31
// 列の深さ 16（4 から — report-1062: park で死んだ深度の予備が続かないときの出し入れが共有の列 rt.dp_give / dp_take へ溢れていた）
const DP_CAP = 16
// 持ち主が rt.mn_next の周ごとに書く語（report-1161 — 盗み手の行〔WK_DLOCK / WK_DH〕から移した: 眠る前の見直し〔rt.mn_anydq〕が全ワーカーの
// WK_DH を読むので、同じ行に周ごとの書きがあると W 本ぶんの変更済みの行を眠りのたびに跨 CCX で引いた）。WK_RFREE（他のワーカーが CAS で書く）から 8 語離す
const WK_HOT = WK_RFREE + 8
const WK_NOW = WK_HOT   // 今（TSC — mn_next が周の頭で 1 回読む。積む口〔task.sober readyPush〕はこの値を時刻に使う — 誤差は 1 回の走り）
const WK_AGED = WK_HOT + 1  // 待ちの上限が効いて積みの底から取った回数（Ledger の aged — 持ち主だけが足す）
const WK_MAXW = WK_HOT + 2  // 走れる積みから取った task の待ちの最大（TSC の数 — Ledger の maxWait が xchg で 0 に戻して集める）
const WK_PICK = WK_HOT + 3  // rt.mn_next の周の数（持ち主だけが書く — 受け箱の先読み〔MN_INBOX_EVERY〕の間引きの位相）
const WK_DPC = WK_HOT + 8
const WK_DPS = WK_DPC + DP_MASK + 1
const WK_WORDS = WK_DPS + (DP_MASK + 1) * DP_CAP
// @rt.sdp = [数の和, 列 r の数 × 32, 列 r の基底 × SRES_CAP × 32]
const SDP_S = 2 + DP_MASK
// 計器の数え口（開発用 --rt-mutant=4 だけ — report-699/701。表を WK_KN 語だけ延ばす・通常の build の IR は不変）: ワーカーごと・鍵なしの 16 語
// 0 run（mn_next が返した task）・1 steal（うち盗み）・2 flush（溜めのあった提出の enter）・3 rsleep / 4 rsleep_ns（ring の眠り）・
// 5 fsleep / 6 fsleep_ns（futex の眠り）・7 cqe・8 acc・9 recv（取り込んだ CQE とうち accept / recv）・10 sqe・11 enter・
// 12 startN / 13 start_ns（子の起動遅れ — spawn → task_start_mn の入口）・14 spawn・15 hold_ns（溜めの最初の SQE → 提出）。
// WK_KHOLD = 溜めの最初の SQE の時刻（0 = 溜め無し）。出力は rt.out_drain の `#w <k> <16 語>`（bench/httparena/tools/kstat.sh が集計）
const WK_K0 = WK_WORDS
const WK_KHOLD = WK_K0 + 16
const WK_KMC = WK_K0 + 17 // mincore の作業域（32 語 = 1 MiB 分の頁の印 — スロットの数え口の 16〜17 — report-1016）
// 追加の 5 語（report-1161 — latency 系の取り込みの窓の計器。`#w` の行の 17〜21 列目）: 0 pbuse（受けの環の使用中のスロットの最大）・1 enobufs（受けの ENOBUFS）・
// 2 tmo（眠りの enter が timeout で起きた回数）・3 gap_ns / 4 gapmax_ns（CQE を 1 つ以上取り込んだ回の、前の取り込みからの間隔の和と最大 — 取り込んだ完了の待ちの上界）。
// WK_KXT = 前の取り込みの時刻
const WK_KX = WK_K0 + 17 + 32
const WK_KXN = 5
const WK_KXT = WK_KX + WK_KXN
const WK_KN = 17 + 32 + WK_KXN + 1
// カオスの変異（開発用 --rt-mutant=30 だけ — report-1175。表を 1 語だけ延ばす・通常の build の IR は不変）: WK_CHS = ワーカーごとの xorshift の状態
// （SOBER_CHAOS_SEED — 既定 1・0 = 注入しない。ワーカー 1 以上はワーカーの番号で散らす）。注入点 = 非 ring の道の送り・受け・accept（偽の EAGAIN と短い書き / 読み —
// どれも非ブロックの socket で合法な返り）と rt.ep_poll（受け皿の縮めと sched_yield）。chRoll の値 r の下 3 ビット: 1 = EAGAIN・2 = 短い（1〜1024 バイト）
// 変異 31 / 32（飛行記録の検収の網 — report-1176・scripts/flightcheck.sh）は同じ状態で壊す: 31 = epoll の道の起こし（epWake）を 1/2048 で落とす
// （待ち手は起きない — 要求が時間切れ）・32 = 非 ring の道の送りを 1/256 で 1〜1024 B に縮めて頼んだ長さを返す（データの欠け）
const WK_CHS = WK_WORDS
const TC_KT0 = TC_END // spawn の時刻（変異 4 だけ — 子の塊の記録の退避の列の後ろ〔TASK_HEAD の頁の中〕。語 36 は孤児の登録簿 TC_ORG — orphan.sober）
// スロットの数え口（変異 4 だけ — report-1016。@rt.mn を MK_N 語だけ延ばす・通常の build の IR は不変）: 全ワーカーの和（lock xadd）
// 0 印（MK_MAGIC）・1 時刻・2 pop（プールから子の深度へ）・3 give（子の終わりの返し）・4 refill（SLOT_CHUNK 本の mmap の回数）・5 drop（munmap）・
// 6 予備へ出した数・7 予備から移した数・8 give の Σ min(used, W_MADV)（プールへ持ち込む常駐）・9 give の Σ used・10 生きている子の数・
// 11 予備の数（写しの時点 — 単体 + 深度ごとの鎖）・12 前回の写しの時刻・13 slot_take（チャネルの小アリーナ）・14 spawn の和・15 既定より大きいスロットの mmap・
// 16 pop で受け継いだ常駐の頁の和（スロットの先頭 1 MiB を mincore — 前の持ち主たちが触って返さなかった頁）・17 その pop の数・
// 18 深度ごとのプールへ返した数・19 深度ごとのプールから取った数（report-1018）。
// 写し = mn_next が 256 回ごとに時刻を見て 100 ms 経っていれば 16 語を write(2) で生のまま出す（bench/httparena/tools/slotts.ts が読む）
const MK0 = MN_WORDS
const MK_N = 20
const MK_MAGIC = 6074321610230353747 // "SOBERSLT"

// mAdd はスロットの数え口の語 k に v を足す（変異 4 だけ — v を作る命令は呼び手が変異 4 の中で作る）
func mAdd(st mut St, k int, v int) {
    if st.rtMut != 4 {
        return
    }
    atomicXadd(mut st, globaladdr(mut st, st.mnG), MK0 + k, v)
}

// mInc はスロットの数え口の語 k に 1 を足す（変異 4 だけ）
func mInc(st mut St, k int) {
    if st.rtMut == 4 {
        mAdd(mut st, k, iconst(mut st, 1))
    }
}

// mPopRes はプールから取ったスロット s の先頭 1 MiB の常駐の頁を mincore で数えて語 16 / 17 へ（変異 4 だけ）
func mPopRes(st mut St, s int) {
    if st.rtMut != 4 {
        return
    }
    wk := globaladdr(mut st, st.wkG)
    syscall(mut st, list4(mut st, iconst(mut st, 27), s, iconst(mut st, 1048576), ptoi(mut st, gepWord(mut st, wk, iconst(mut st, WK_KMC)))))
    lo := iconst(mut st, 72340172838076673) // 0x0101010101010101 — 頁の印（各バイトの最下位ビット）の和を掛け算で上の 1 バイトへ
    mut acc := iconst(mut st, 0)
    for i <- iter.Range(0, 32) {
        w := bin(mut st, BAnd, load(mut st, wk, WK_KMC + i), lo)
        acc = bin(mut st, BAdd, acc, bin(mut st, BSar, bin(mut st, BMul, w, lo), iconst(mut st, 56)))
    }
    mAdd(mut st, 16, acc)
    mInc(mut st, 17)
}

// kSnap はスロットの数え口の写し（変異 4 だけ — 自分の run の数が 256 の倍数のときに時刻を見て、前回から 100 ms 経っていれば取った 1 本が write(2)）
func kSnap(st mut St) {
    if st.rtMut != 4 {
        return
    }
    wk := globaladdr(mut st, st.wkG)
    mn := globaladdr(mut st, st.mnG)
    bC := newBlock(mut st)
    bW := newBlock(mut st)
    bW2 := newBlock(mut st)
    bE := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, bin(mut st, BAnd, load(mut st, wk, WK_K0), iconst(mut st, 255)), iconst(mut st, 0)), bC, -1, bE, -1)
    setCur(mut st, bC)
    now := clockNs(mut st)
    last := load(mut st, mn, MK0 + 12)
    condbr(mut st, cmp(mut st, CGe, bin(mut st, BSub, now, last), iconst(mut st, 100000000)), bW, -1, bE, -1)
    setCur(mut st, bW)
    o := atomicCas(mut st, mn, MK0 + 12, last, now)
    condbr(mut st, cmp(mut st, CEq, o, last), bW2, -1, bE, -1)
    setCur(mut st, bW2)
    store(mut st, mn, MK0, iconst(mut st, MK_MAGIC))
    store(mut st, mn, MK0 + 1, now)
    store(mut st, mn, MK0 + 11, bin(mut st, BAdd, load(mut st, globaladdr(mut st, st.sresG), 0), load(mut st, globaladdr(mut st, st.sdpG), 0)))
    syscall(mut st, list4(mut st, iconst(mut st, 1), iconst(mut st, 2), ptoi(mut st, gepWord(mut st, mn, iconst(mut st, MK0))), iconst(mut st, 8 * MK_N)))
    br(mut st, bE, -1)
    setCur(mut st, bE)
}

// chRoll はカオスの乱択の 1 歩（変異 30 だけ — ワーカーの WK_CHS の xorshift。状態 0 は 0 のまま = どの注入点も当たらない）
func chRoll(st mut St) int {
    wk := globaladdr(mut st, st.wkG)
    seed := load(mut st, wk, WK_CHS)
    x1 := bin(mut st, BXor, seed, bin(mut st, BShl, seed, iconst(mut st, 13)))
    x2 := bin(mut st, BXor, x1, bin(mut st, BAnd, bin(mut st, BSar, x1, iconst(mut st, 7)), iconst(mut st, 144115188075855871)))
    x3 := bin(mut st, BXor, x2, bin(mut st, BShl, x2, iconst(mut st, 17)))
    store(mut st, wk, WK_CHS, x3)
    return x3
}

// chIo は非 ring の道の io の syscall の前の注入（変異 30 だけ — 呼び手は st.rtMut == 30 で呼ぶ）: 1/8 で -11（EAGAIN — 呼び手の again が readiness を待つ）を返し、
// 1/8 で長さ n を 1〜1024 バイトに縮めた値を返す（それ以外は n）
func chIo(st mut St, n int) int {
    r := chRoll(mut st)
    k := bin(mut st, BAnd, r, iconst(mut st, 7))
    bNo := branchIf(mut st, cmp(mut st, CEq, k, iconst(mut st, 1)))
    ret(mut st, iconst(mut st, -11))
    setCur(mut st, bNo)
    sh := imin(mut st, n, bin(mut st, BAdd, bin(mut st, BAnd, bin(mut st, BSar, r, iconst(mut st, 8)), iconst(mut st, 1023)), iconst(mut st, 1)))
    return bin(mut st, BAdd, n, bin(mut st, BMul, cmp(mut st, CEq, k, iconst(mut st, 2)), bin(mut st, BSub, sh, n)))
}

// kAdd は計器の語 k に v を足す（変異 4 だけ — v を作る命令は呼び手が変異 4 の中で作る）
func kAdd(st mut St, k int, v int) {
    if st.rtMut != 4 {
        return
    }
    wk := globaladdr(mut st, st.wkG)
    store(mut st, wk, WK_K0 + k, bin(mut st, BAdd, load(mut st, wk, WK_K0 + k), v))
}

// kxAdd / kxMax は追加の計器の語 k（WK_KX + k）に v を足す / v との最大にする（変異 4 だけ）
func kxAdd(st mut St, k int, v int) {
    if st.rtMut != 4 {
        return
    }
    wk := globaladdr(mut st, st.wkG)
    store(mut st, wk, WK_KX + k, bin(mut st, BAdd, load(mut st, wk, WK_KX + k), v))
}

func kxMax(st mut St, k int, v int) {
    if st.rtMut != 4 {
        return
    }
    wk := globaladdr(mut st, st.wkG)
    store(mut st, wk, WK_KX + k, imax(mut st, load(mut st, wk, WK_KX + k), v))
}

// kInc は計器の語 k に 1 を足す（変異 4 だけ — それ以外は何も出さない）
func kInc(st mut St, k int) {
    if st.rtMut == 4 {
        kAdd(mut st, k, iconst(mut st, 1))
    }
}

const TCB_KEEP = 16
const KEEP_SMALL = 256 // 預かりの小さな塊の大きさ（使った量がこれ以下の子の結果は塊に — 1 頁ずつの mmap を避ける）
const KEEP_SLAB = 65536 // 塊の補充の単位（mmap 1 回）
const MN_SPIN = 20000  // 眠る前に回る回数（読み 2 つ × 2 万 ≈ 数十 µs）
const SLOT_KEEP = 16

// needMnRt は宣言（needTaskRt から）
func needMnRt(st mut St) {
    lsNeed(mut st, NEED_MN, 0)
    st.mnG = addGlobalInit(mut st, int(strLit(mut st, "rt.mn")), MN_WORDS + (if st.rtMut == 4 { MK_N } else { 0 }), -1)
    st.sresG = addGlobalInit(mut st, int(strLit(mut st, "rt.sres")), 3 + SRES_CAP, -1)
    st.sdpG = addGlobalInit(mut st, int(strLit(mut st, "rt.sdp")), SDP_S + (DP_MASK + 1) * SRES_CAP, -1)
    st.wkG = addWorkerGlobal(mut st, int(strLit(mut st, "rt.wk")), WK_WORDS + (if st.rtMut == 4 { WK_KN } else if st.rtMut >= 30 && st.rtMut <= 32 { 1 } else { 0 }))
    st.rtMnStart = addFunc(mut st, int(strLit(mut st, "rt.mn_start")), desugar.ListRef(list0(mut st)), -1)
    st.rtWorkerMain = addFunc(mut st, int(strLit(mut st, "rt.worker_main")), desugar.ListRef(list1(mut st, TyPtr)), -1)
    st.rtTaskGoMn = addFunc(mut st, int(strLit(mut st, "rt.task_go_mn")), desugar.ListRef(list2(mut st, TyPtr, TyPtr)), -1)
    st.rtTaskStartMn = addFunc(mut st, int(strLit(mut st, "rt.task_start_mn")), desugar.ListRef(list1(mut st, TyPtr)), -1)
    st.rtMnNext = addFunc(mut st, int(strLit(mut st, "rt.mn_next")), desugar.ListRef(list0(mut st)), TyPtr)
    st.rtMnWake = addFunc(mut st, int(strLit(mut st, "rt.mn_wake")), desugar.ListRef(list1(mut st, TyPtr)), -1)
    st.rtMnKick = addFunc(mut st, int(strLit(mut st, "rt.mn_kick")), desugar.ListRef(list0(mut st)), -1)
    st.rtMnDelay = addFunc(mut st, int(strLit(mut st, "rt.mn_delay")), desugar.ListRef(list0(mut st)), -1)
    st.rtSresTake = addFunc(mut st, int(strLit(mut st, "rt.sres_take")), desugar.ListRef(list0(mut st)), TyI64)
    st.rtDpGive = addFunc(mut st, int(strLit(mut st, "rt.dp_give")), desugar.ListRef(list3(mut st, TyI64, TyI64, TyI64)), -1)
    st.rtDpTake = addFunc(mut st, int(strLit(mut st, "rt.dp_take")), desugar.ListRef(list1(mut st, TyI64)), TyI64)
    st.rtMnPullPop = addFunc(mut st, int(strLit(mut st, "rt.mn_pull_pop")), desugar.ListRef(list0(mut st)), TyPtr)
    st.rtMnSteal = addFunc(mut st, int(strLit(mut st, "rt.mn_steal")), desugar.ListRef(list0(mut st)), TyPtr)
    st.rtMnAnyDq = addFunc(mut st, int(strLit(mut st, "rt.mn_anydq")), desugar.ListRef(list0(mut st)), TyI64)
    st.rtMnTrace = addFunc(mut st, int(strLit(mut st, "rt.mn_trace")), desugar.ListRef(list2(mut st, TyI64, TyI64)), -1)
    st.rtTcbFree = addFunc(mut st, int(strLit(mut st, "rt.tcb_free")), desugar.ListRef(list1(mut st, TyPtr)), -1)
    st.rtMnPin = addFunc(mut st, int(strLit(mut st, "rt.mn_pin")), desugar.ListRef(list1(mut st, TyI64)), -1)
    needUringRt(mut st)
}

func buildMnRt(st mut St) {
    buildWorkerMain(mut st)
    buildTaskGoMn(mut st)
    buildTaskStartMn(mut st)
    buildMnNext(mut st)
    buildMnWake(mut st)
    buildMnKick(mut st)
    buildMnDelay(mut st)
    buildSresTake(mut st)
    buildDpGive(mut st)
    buildDpTake(mut st)
    buildMnPullPop(mut st)
    buildMnSteal(mut st)
    buildMnAnyDq(mut st)
    buildMnTrace(mut st)
    buildTcbFree(mut st)
    buildMnPin(mut st)
    buildUringInit(mut st)
    buildUio(mut st)
    buildUpoll(mut st)
}

// mnOn は M:N か（ワーカー数 > 1 — 値は 0 / 1）
func mnOn(st mut St) int {
    return cmp(mut st, CGt, load(mut st, globaladdr(mut st, st.mnG), MN_N), iconst(mut st, 1))
}

// spinLock は p[off] の鍵を取る（xchg で 1 を置き、取れなければ 0 になるまで読んで待つ）
func spinLock(st mut St, p int, off int) {
    lk := newBlock(mut st)
    spin := newBlock(mut st)
    got := newBlock(mut st)
    br(mut st, lk, -1)
    setCur(mut st, lk)
    o := atomicXchg(mut st, p, off, iconst(mut st, 1))
    condbr(mut st, cmp(mut st, CEq, o, iconst(mut st, 0)), got, -1, spin, -1)
    setCur(mut st, spin)
    atomicPause(mut st)
    condbr(mut st, cmp(mut st, CNe, load(mut st, p, off), iconst(mut st, 0)), spin, -1, lk, -1)
    setCur(mut st, got)
}

// mnDelayPoint は遅延注入の口（ワーカーの乱択の状態が 0 でなければ rt.mn_delay — schedfuzz）
func mnDelayPoint(st mut St) {
    if !st.taskUse {
        return
    }
    bD := newBlock(mut st)
    bE := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, load(mut st, globaladdr(mut st, st.wkG), WK_RND), iconst(mut st, 0)), bD, -1, bE, -1)
    setCur(mut st, bD)
    call(mut st, st.rtMnDelay, list0(mut st))
    br(mut st, bE, -1)
    setCur(mut st, bE)
}

// mnInit は入口でワーカー数を決める（taskInitMain から — sp = 初期 rsp）: SOBER_WORKERS（1〜MAXW）か sched_getaffinity のビットの数
func mnInit(st mut St, sp int) {
    mn := globaladdr(mut st, st.mnG)
    wk := globaladdr(mut st, st.wkG)
    n0 := envMb(mut st, sp, "SOBER_WORKERS=", 0, false)
    // 台帳の器（段 6 P5-1）: 計測の印と、プロセスの天井（cgroup の cpu.max / memory.max・MemTotal・入口の RSS — rt.pcap_init）
    store(mut st, mn, MN_STATS, envMb(mut st, sp, "SOBER_PAR_STATS=", 0, true))
    call(mut st, st.rtPcapInit, list1(mut st, envMb(mut st, sp, "SOBER_BUDGET_MB=", -1, true)))
    // io_uring の probe の口（IO 便 段 0 — uring.sober）
    store(mut st, mn, MN_IOMODE, envMb(mut st, sp, "SOBER_IO=", 0, true))
    store(mut st, mn, MN_IOTR, envMb(mut st, sp, "SOBER_IO_TRACE=", 0, true))
    bAff := newBlock(mut st)
    bSet := newBlock(mut st)
    nv := param(mut st, bSet, TyI64)
    condbr(mut st, cmp(mut st, CEq, n0, iconst(mut st, 0)), bAff, -1, bSet, list1(mut st, n0))
    setCur(mut st, bAff)
    // sched_getaffinity(0, 128, 作業域) = 書いたバイト数（失敗は負 — 1 ワーカー）
    r := syscall(mut st, list4(mut st, iconst(mut st, 204), iconst(mut st, 0), iconst(mut st, 128), ptoi(mut st, gepWord(mut st, mn, iconst(mut st, MN_AFF)))))
    nw := bin(mut st, BMul, bin(mut st, BSar, r, iconst(mut st, 3)), cmp(mut st, CGt, r, iconst(mut st, 0)))
    wl := newBlock(mut st)
    wi := param(mut st, wl, TyI64)
    wc := param(mut st, wl, TyI64)
    wb := newBlock(mut st)
    bl := newBlock(mut st)
    bx := param(mut st, bl, TyI64)
    bc := param(mut st, bl, TyI64)
    bb := newBlock(mut st)
    bn := newBlock(mut st)
    wd := newBlock(mut st)
    br(mut st, wl, list2(mut st, iconst(mut st, 0), iconst(mut st, 0)))
    setCur(mut st, wl)
    condbr(mut st, cmp(mut st, CLt, wi, nw), wb, -1, wd, -1)
    setCur(mut st, wb)
    br(mut st, bl, list2(mut st, load(mut st, gepWord(mut st, mn, bin(mut st, BAdd, wi, iconst(mut st, MN_AFF))), 0), wc))
    setCur(mut st, bl)
    condbr(mut st, cmp(mut st, CEq, bx, iconst(mut st, 0)), bn, -1, bb, -1)
    setCur(mut st, bb)
    br(mut st, bl, list2(mut st, bin(mut st, BAnd, bx, bin(mut st, BSub, bx, iconst(mut st, 1))), bin(mut st, BAdd, bc, iconst(mut st, 1))))
    setCur(mut st, bn)
    br(mut st, wl, list2(mut st, bin(mut st, BAdd, wi, iconst(mut st, 1)), bc))
    setCur(mut st, wd)
    // ワーカー数 = min(affinity, ⌈cpu.max⌉)（段 6 P5-1 — cgroup のクォータとコア数の乖離〔Go の GOMAXPROCS の folklore〕を初日から）
    store(mut st, mn, MN_AFFC, wc)
    cq := load(mut st, mn, MN_CPUQ)
    lim := bin(mut st, BAnd, cmp(mut st, CGt, cq, iconst(mut st, 0)), cmp(mut st, CLt, cq, wc))
    br(mut st, bSet, list1(mut st, bin(mut st, BAdd, wc, bin(mut st, BMul, lim, bin(mut st, BSub, cq, wc)))))
    setCur(mut st, bSet)
    // 1 ≤ n ≤ MAXW
    lo := imax(mut st, nv, iconst(mut st, 1))
    n0w := bin(mut st, BAdd, lo, bin(mut st, BMul, cmp(mut st, CGt, lo, iconst(mut st, MAXW)), bin(mut st, BSub, iconst(mut st, MAXW), lo)))
    // Serve のプログラムの印（置き場の印〔rt.netop 5〕を使う — 即値は cutPatch が決める・入口は本体より先に組む）: CPU の固定の既定だけが読む。
    // ワーカーは足さない（report-1172 — accept はワーカーごとの listener〔SO_REUSEPORT〕で各ワーカーが自分の ring で受ける。旧形〔report-997〕は
    // acceptor 1 本のためにワーカーを 1 本足していた）
    ex := iconst(mut st, 0)
    st.mnExtra = int(irBlkITail(mut st, st.cur))
    n := n0w
    store(mut st, mn, MN_N, n)
    // ワーカーの CPU の固定（report-1161 — thread-per-core の定石: 走れるワーカーが同じ CPU に重なって時間片〔≈ 3 ms〕を待つ形を無くす）。
    // 既定は Serve のプログラム（置き場の印 = ex）で、ワーカー数を affinity から決めたとき（SOBER_WORKERS なし）— 箱を占有するサーバの形。
    // 一般のプログラム（コンパイラ自身・並走する網）を固定すると、同じ箱の別のプロセスが同じ CPU の並びに重なる。SOBER_PIN=1 で強制・0 で切る
    pv := envMb(mut st, sp, "SOBER_PIN=", -1, true)
    // 既定はスレッド数 ≤ 許可の数のときだけ（許可の数を越えると、浮いた 1 本が固定したワーカーのどれかと必ず重なり、
    // 固定したワーカーは逃げられない — 手元 W12 + 1 で churn −47%・W11 + 1〔全部固定〕は churn / keep-alive とも退行なし — report-1161。
    // ワーカーを足さなくなった後〔report-1172〕は affinity から決めた数なら常に収まる — cpu.max で減らした数も ≤ 許可の数）
    pfit := cmp(mut st, CLe, n, load(mut st, mn, MN_AFFC))
    pdef := bin(mut st, BAnd, bin(mut st, BAnd, bin(mut st, BAnd, cmp(mut st, CEq, pv, iconst(mut st, -1)), ex), cmp(mut st, CEq, n0, iconst(mut st, 0))), pfit)
    pin := bin(mut st, BOr, cmp(mut st, CEq, pv, iconst(mut st, 1)), pdef)
    store(mut st, mn, MN_PIN, pin)
    // SOBER_WORKERS があると上で affinity を読んでいない — 固定するなら読む
    bPa := branchIf(mut st, bin(mut st, BAnd, pin, cmp(mut st, CNe, n0, iconst(mut st, 0))))
    syscall(mut st, list4(mut st, iconst(mut st, 204), iconst(mut st, 0), iconst(mut st, 128), ptoi(mut st, gepWord(mut st, mn, iconst(mut st, MN_AFF)))))
    br(mut st, bPa, -1)
    setCur(mut st, bPa)

    store(mut st, mn, MN_WK, ptoi(mut st, wk))
    sg := globaladdr(mut st, st.schedG)
    store(mut st, mn, MN_TRACE, load(mut st, sg, 2))
    // 遅延注入はワーカー 2 以上で種があるときだけ（ワーカー 1 は sched_pick の乱択 — 今までどおり）
    store(mut st, wk, WK_RND, bin(mut st, BMul, load(mut st, sg, SCHED_SEED), cmp(mut st, CGt, n, iconst(mut st, 1))))
    if st.rtMut >= 30 && st.rtMut <= 32 {
        store(mut st, wk, WK_CHS, envMb(mut st, sp, "SOBER_CHAOS_SEED=", 1, true))
    }
    // 飛行記録（flight.sober — SOBER_FLIGHT）
    frInit(mut st, sp, n)
}

// buildMnStart は rt.mn_start()（最初の M:N の spawn — ワーカー 0 から）: ワーカー 1〜N-1 の表を確保して記録を組み、塊のスタックで rt.worker_main を
// clone で起こす。表の中身: meta と sched はワーカー 0 の写し（深度の bump・行バッファの長さ・深度・宛先 / anchor は 0 — 先端の照合が他の task の
// region に当たらないように）・それ以外は 0（mmap）。program の最後に組む（表の数と大きさがそこで決まる — buildWorkerInit から）
func buildMnStart(st mut St) {
    begin(mut st, st.rtMnStart)
    mn := globaladdr(mut st, st.mnG)
    store(mut st, mn, MN_STARTED, iconst(mut st, 1))
    mnPinPoint(mut st)
    call(mut st, st.rtUringInit, list0(mut st))
    mut total := 0
    mut g := st.ghead
    while g >= 0 {
        if desugar.HeapGet(mut st.d, g + G_WSLOT) >= 0 {
            total += desugar.HeapGet(mut st.d, g + G_WORDS) * 8
        }
        g = desugar.HeapGet(mut st.d, g + G_NEXT)
    }
    recw := if st.nwslot > 0 { st.nwslot } else { 1 }
    loop := newBlock(mut st)
    k := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, list1(mut st, iconst(mut st, 1)))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLt, k, load(mut st, mn, MN_N)), body, -1, done, -1)
    setCur(mut st, body)
    base := sysMmap(mut st, iconst(mut st, total + recw * 8))
    rec := itop(mut st, bin(mut st, BAdd, base, iconst(mut st, total)))
    mut off := 0
    g = st.ghead
    while g >= 0 {
        ws := desugar.HeapGet(mut st.d, g + G_WSLOT)
        if ws >= 0 {
            words := desugar.HeapGet(mut st.d, g + G_WORDS)
            a := itop(mut st, bin(mut st, BAdd, base, iconst(mut st, off)))
            store(mut st, rec, ws, ptoi(mut st, a))
            if g == st.meta || g == st.schedG {
                call(mut st, st.rtCopy, list3(mut st, a, globaladdrRaw(mut st, g), iconst(mut st, words)))
            }
            if g == st.meta {
                zero := iconst(mut st, 0)
                for d <- iter.Range(0, MAX_DEPTH + 1) {
                    store(mut st, a, W_BUMP + d, zero)
                }
                store(mut st, a, W_LINE_LEN, zero)
                store(mut st, a, W_DEPTH, zero)
                store(mut st, a, W_MAXD, zero)
                store(mut st, a, W_DEST, zero)
                store(mut st, a, W_ANCHOR, zero)
            }
            if g == st.wkG {
                store(mut st, a, WK_ID, k)
                // 乱択の状態 = ワーカー 0 の種をワーカーの番号で散らす（0 のままなら注入しない）
                s0 := load(mut st, globaladdrRaw(mut st, g), WK_RND)
                mix := bin(mut st, BXor, s0, bin(mut st, BMul, k, iconst(mut st, 40503)))
                store(mut st, a, WK_RND, bin(mut st, BMul, mix, cmp(mut st, CNe, s0, iconst(mut st, 0))))
                frWorker(mut st, a, k)
                if st.rtMut >= 30 && st.rtMut <= 32 {
                    c0 := load(mut st, globaladdrRaw(mut st, g), WK_CHS)
                    cmix := bin(mut st, BXor, c0, bin(mut st, BMul, k, iconst(mut st, 40503)))
                    store(mut st, a, WK_CHS, bin(mut st, BMul, cmix, cmp(mut st, CNe, c0, iconst(mut st, 0))))
                }
                store(mut st, gepWord(mut st, mn, bin(mut st, BAdd, k, iconst(mut st, MN_WK))), 0, ptoi(mut st, a))
            }
            off += words * 8
        }
        g = desugar.HeapGet(mut st.d, g + G_NEXT)
    }
    // 起動の塊（ワーカー k の最初の文脈 — 戻ってこない task）
    tcb := call(mut st, st.rtTaskNew, list2(mut st, iconst(mut st, 0), iconst(mut st, 0)))
    zero := iconst(mut st, 0)
    store(mut st, tcb, TC_STARTED, iconst(mut st, 1))
    store(mut st, tcb, TC_WORKER, k)
    store(mut st, tcb, TC_DEPTH, zero)
    store(mut st, tcb, TC_BASE, zero)
    store(mut st, tcb, TC_OWN, zero)
    store(mut st, tcb, TC_DEST, zero)
    store(mut st, tcb, TC_ANCHOR, zero)
    store(mut st, tcb, TC_TRAP, zero)
    store(mut st, tcb, TC_SEG, zero)
    tid := threadClone(mut st, itop(mut st, load(mut st, tcb, TC_TOP)), funcaddr(mut st, st.rtWorkerMain), ptoi(mut st, tcb), ptoi(mut st, rec))
    bad := newBlock(mut st)
    ok := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, tid, iconst(mut st, 0)), bad, -1, ok, -1)
    setCur(mut st, bad)
    memPanic(mut st, PM_SLOT)
    setCur(mut st, ok)
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, k, iconst(mut st, 1))))
    setCur(mut st, done)
    ret(mut st, -1)
}

// buildWorkerMain は rt.worker_main(tcb)（新しいスレッドの入口 — %fs は clone が置いた記録）: 代替スタックを張り、今の task を起動の塊にして
// 走れる task を待っては切り替える（起動の塊は二度と再開しない）
func buildWorkerMain(st mut St) {
    begin(mut st, st.rtWorkerMain)
    wk := globaladdr(mut st, st.wkG)
    alt := sysMmap(mut st, iconst(mut st, SIG_ALT))
    store(mut st, wk, WK_SS, alt)
    store(mut st, wk, WK_SS + 1, iconst(mut st, 0))
    store(mut st, wk, WK_SS + 2, iconst(mut st, SIG_ALT))
    syscall(mut st, list3(mut st, iconst(mut st, 131), ptoi(mut st, gepWord(mut st, wk, iconst(mut st, WK_SS))), iconst(mut st, 0)))
    store(mut st, globaladdr(mut st, st.taskG), TK_CUR, ptoi(mut st, 0))
    mnPinPoint(mut st)
    call(mut st, st.rtUringInit, list0(mut st))
    loop := newBlock(mut st)
    br(mut st, loop, -1)
    setCur(mut st, loop)
    nx := call(mut st, st.rtMnNext, list0(mut st))
    call(mut st, st.rtTaskSwitch, list2(mut st, 0, nx))
    br(mut st, loop, -1)
}

// mnPinPoint は MN_PIN なら自分（WK_ID）を固定する（ワーカーの入口 — 1〜N-1 は rt.worker_main の頭・0 は rt.mn_start の頭）
func mnPinPoint(st mut St) {
    bP := branchIf(mut st, cmp(mut st, CNe, load(mut st, globaladdr(mut st, st.mnG), MN_PIN), iconst(mut st, 0)))
    call(mut st, st.rtMnPin, list1(mut st, load(mut st, globaladdr(mut st, st.wkG), WK_ID)))
    br(mut st, bP, -1)
    setCur(mut st, bP)
}

// buildMnPin は rt.mn_pin(i): 許可の CPU（MN_AFF のビット — 番号の昇順）の i 番目の 1 つへ sched_setaffinity。i ≥ 許可の数（SOBER_WORKERS で許可の数を越えたワーカー）は
// 固定しない（許可の全体）。
// 昇順の割り当ては、兄弟の番号が N と N + 物理コア数の箱（本家 3995WX・多くのサーバ）ではワーカー数 ≤ 物理コア数のとき別々のコアに乗る。兄弟が隣り合う
// 番号の箱（WSL2 等）で SOBER_WORKERS < 許可の数のときは 0 と 1 が同じコアに乗る（既定のワーカー数 = 許可の数なら全 CPU を使うので差は無い）。
// io-wq のワーカー（iou-wrk）はカーネルが cpuset から作るので、この固定に縛られない
func buildMnPin(st mut St) {
    begin(mut st, st.rtMnPin)
    mn := globaladdr(mut st, st.mnG)
    zero := iconst(mut st, 0)
    one := iconst(mut st, 1)
    lp := newBlock(mut st)
    c := param(mut st, lp, TyI64)
    rem := param(mut st, lp, TyI64)
    bd := newBlock(mut st)
    bHit := newBlock(mut st)
    bNx := newBlock(mut st)
    bAll := newBlock(mut st)
    bEnd := newBlock(mut st)
    br(mut st, lp, list2(mut st, zero, 0))
    setCur(mut st, lp)
    condbr(mut st, cmp(mut st, CLt, c, iconst(mut st, 1024)), bd, -1, bAll, -1)
    setCur(mut st, bd)
    w := load(mut st, gepWord(mut st, mn, bin(mut st, BAdd, bin(mut st, BSar, c, iconst(mut st, 6)), iconst(mut st, MN_AFF))), 0)
    bit := bin(mut st, BAnd, bin(mut st, BSar, w, bin(mut st, BAnd, c, iconst(mut st, 63))), one)
    bOn := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, bit, zero), bOn, -1, bNx, list1(mut st, rem))
    setCur(mut st, bOn)
    condbr(mut st, cmp(mut st, CEq, rem, zero), bHit, -1, bNx, list1(mut st, bin(mut st, BSub, rem, one)))
    setCur(mut st, bNx)
    r2 := param(mut st, bNx, TyI64)
    br(mut st, lp, list2(mut st, bin(mut st, BAdd, c, one), r2))
    setCur(mut st, bHit)
    m := newSlotAddr(mut st, 16)
    for k <- iter.Range(0, 16) {
        store(mut st, m, k, zero)
    }
    store(mut st, gepWord(mut st, m, bin(mut st, BSar, c, iconst(mut st, 6))), 0, bin(mut st, BShl, one, bin(mut st, BAnd, c, iconst(mut st, 63))))
    syscall(mut st, list4(mut st, iconst(mut st, 203), zero, iconst(mut st, 128), ptoi(mut st, m)))
    br(mut st, bEnd, -1)
    // 固定しないワーカー: clone はワーカー 0（固定済み）の affinity を継ぐので許可の全体へ戻す
    setCur(mut st, bAll)
    syscall(mut st, list4(mut st, iconst(mut st, 203), zero, iconst(mut st, 128), ptoi(mut st, gepWord(mut st, mn, iconst(mut st, MN_AFF)))))
    br(mut st, bEnd, -1)
    setCur(mut st, bEnd)
    ret(mut st, -1)
}

// buildTaskGoMn は rt.task_go_mn(me, tcb)（M:N の spawn の点 — rt.task_go の頭から）: 子の区間を差し込み（鍵の中）、子を pull 列へ積み、
// 暇なワーカーがいれば起こす。親は先へ進む（help-first）
func buildTaskGoMn(st mut St) {
    begin(mut st, st.rtTaskGoMn)
    mn := globaladdr(mut st, st.mnG)
    bS := newBlock(mut st)
    bGo := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, load(mut st, mn, MN_STARTED), iconst(mut st, 0)), bS, -1, bGo, -1)
    setCur(mut st, bS)
    call(mut st, st.rtMnStart, list0(mut st))
    br(mut st, bGo, -1)
    setCur(mut st, bGo)
    store(mut st, 1, TC_ENTRY, funcaddr(mut st, st.rtTaskStartMn))
    if st.rtMut == 4 {
        store(mut st, 1, TC_KT0, clockNs(mut st))
        kInc(mut st, 14)
        mInc(mut st, 14)
        mInc(mut st, 10)
    }
    // 通し番号は trace のときだけ（共有の語への xadd を spawn ごとに踏まない — 段 6 P4-6）
    bTid := newBlock(mut st)
    bTid2 := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, load(mut st, mn, MN_TRACE), iconst(mut st, 0)), bTid, -1, bTid2, -1)
    setCur(mut st, bTid)
    store(mut st, 1, TC_ID, bin(mut st, BAdd, atomicXadd(mut st, mn, MN_TID, iconst(mut st, 1)), iconst(mut st, 1)))
    br(mut st, bTid2, -1)
    setCur(mut st, bTid2)
    // 区間を持たない子（純な子 — outNoSeg）は鍵を取らない（段 6 P4-6）
    bOf := newBlock(mut st)
    bOf2 := newBlock(mut st)
    condbr(mut st, outNoSeg(mut st, 0, 1), bOf2, -1, bOf, -1)
    setCur(mut st, bOf)
    spinLock(mut st, mn, MN_OLOCK)
    outFork(mut st, 0, 1)
    store(mut st, mn, MN_OLOCK, iconst(mut st, 0))
    br(mut st, bOf2, -1)
    setCur(mut st, bOf2)
    store(mut st, 1, TC_SEG, bin(mut st, BMul, load(mut st, 1, TC_SEG), cmp(mut st, CEq, outNoSeg(mut st, 0, 1), iconst(mut st, 0))))
    mnDelayPoint(mut st)
    // 置き場の印（net_op 5 — Serve。report-709〜711・1172）: 印の持ち主が今の親なら子を印の行き先へ（盗まれない置き場 — 盗みは列の未着手の子だけ）。
    // 行き先 k ≥ 0 = 自分を除いた k 番目のワーカーの受け箱（Serve の accept の輪をワーカーごとに 1 本）・-1 = 自分の走れる積み（accept の輪が受けた
    // 接続の task — 受け箱・起こしを通らない。rt.mn_wake の自分の道）。盗み任せは接続の走り始めを時間的に散らし（盗みは 1 つずつ追う）、
    // keep-alive では偏りが接続の寿命いっぱい固定される（走り始めた task は盗めない）— 配分はカーネルの SO_REUSEPORT の振り分けが決める。
    // 一斉の到着で 1 ワーカーに積まれた新しい接続は LIFO の積みの中ほどに沈み D の期限で拾われる（走り出しの遅れ ≈ D — 立ち上がりの尾）。
    // 新しい task の FIFO を積みより先に見る形は試して棄てた（report-1173 — 底の D を先にする限り飽和では FIFO も D まで待ち、FIFO を先にすると D の約束が破れる）
    pw := globaladdr(mut st, st.wkG)
    bPl := newBlock(mut st)
    bNoPl := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, load(mut st, pw, WK_PLOWN), ptoi(mut st, 0)), bPl, -1, bNoPl, -1)
    setCur(mut st, bPl)
    store(mut st, pw, WK_PLOWN, iconst(mut st, 0))
    pto := load(mut st, pw, WK_PLTO)
    me := load(mut st, pw, WK_ID)
    pk0 := bin(mut st, BRem, pto, bin(mut st, BSub, load(mut st, mn, MN_N), iconst(mut st, 1)))
    pk1 := bin(mut st, BAdd, pk0, cmp(mut st, CGe, pk0, me))
    pk := bin(mut st, BAdd, pk1, bin(mut st, BMul, cmp(mut st, CLt, pto, iconst(mut st, 0)), bin(mut st, BSub, me, pk1)))
    store(mut st, 1, TC_WORKER, pk)
    // 自分の走れる積みへ積むときは今（WK_NOW）を読み直す: 積む時刻は WK_NOW で、それは rt.mn_next の周の頭でしか進まない — Serve を呼んだ task が
    // 起動から一度も譲っていないと 0 のまま（底から取られた待ちが TSC の絶対値になり Ledger の maxWait の換算〔× 65536〕が桁あふれした — report-1173）
    bNw := branchIf(mut st, cmp(mut st, CLt, pto, iconst(mut st, 0)))
    store(mut st, pw, WK_NOW, tscOp(mut st))
    br(mut st, bNw, -1)
    setCur(mut st, bNw)
    call(mut st, st.rtMnWake, list1(mut st, 1))
    ret(mut st, -1)
    setCur(mut st, bNoPl)
    // 子は自分の列の底へ（段 6 Skynet 回収 (a) — 持ち主は鍵なし）。持ち主が底から取るので木の spawn は深さ優先のまま（段 6 P4-6 の積みの理由 —
    // 生んだ順の FIFO だと Skynet が幅優先に走り待つ task が 10 万を越えてスロットの VA が尽きた）。盗み手は頭（古い = 根に近い子）から取る
    wk := globaladdr(mut st, st.wkG)
    dt := load(mut st, wk, WK_DT)
    had := bin(mut st, BSub, dt, load(mut st, wk, WK_DH))
    bDq := newBlock(mut st)
    bOv := newBlock(mut st)
    bPushed := newBlock(mut st)
    t := param(mut st, bPushed, TyI64)
    // DQ_CAP − 1 まで（盗み手が H を進めてから q[h] を読むまでに、同じ位置〔添字 h + DQ_CAP〕へ積まない — buildMnSteal）
    condbr(mut st, cmp(mut st, CLt, had, iconst(mut st, DQ_CAP - 1)), bDq, -1, bOv, -1)
    setCur(mut st, bDq)
    store(mut st, gepWord(mut st, wk, bin(mut st, BAdd, bin(mut st, BAnd, dt, iconst(mut st, DQ_CAP - 1)), iconst(mut st, WK_DQ))), 0, ptoi(mut st, 1))
    // T を xchg で進める（全順序の柵 — 公開してから暇の数を読む: 眠る側は暇の数を足してから列を見る）
    atomicXchg(mut st, wk, WK_DT, bin(mut st, BAdd, dt, iconst(mut st, 1)))
    br(mut st, bPushed, list1(mut st, cmp(mut st, CGe, had, iconst(mut st, DQ_NEED))))
    // あふれ（1 scope に DQ_CAP を越える子 — 平らな幅広の形）は共有の積みへ
    // 起こしの判断の「溜まっていた」はここでは共有の積みが空でなかったか（列は満杯のまま盗まれるのを待つので、列の長さで見ると spawn ごとに起こす —
    // 1 scope に 100 万の子で futex が 18 万回）
    setCur(mut st, bOv)
    spinLock(mut st, mn, MN_PLOCK)
    oh := load(mut st, mn, MN_PHEAD)
    store(mut st, 1, TC_NEXT, oh)
    store(mut st, mn, MN_PHEAD, ptoi(mut st, 1))
    // 鍵を xchg で外す（全順序の柵 — 同上）
    atomicXchg(mut st, mn, MN_PLOCK, iconst(mut st, 0))
    br(mut st, bPushed, list1(mut st, cmp(mut st, CNe, oh, iconst(mut st, 0))))
    setCur(mut st, bPushed)
    bK := newBlock(mut st)
    bR := newBlock(mut st)
    // 回っているワーカーがいれば起こさない（回る者が pull 列を見て拾う — 回るのをやめて眠る側は眠りの手前で pull 列を見直す。
    // 柵: 鍵の xchg の後に読む / 回る側は数を減らす xadd〔柵〕の後に pull 列を見る — 段 6 P4-6）
    // さらに、列に既に溜まっている（積む前に自分の列が空でない）か起きているのが自分だけのときだけ（消費が追いついている間は起こさない —
    // 1 scope に 100 万の子で、余ったワーカーが眠りと起こしを子ごとに往復していた）
    idle := load(mut st, mn, MN_IDLE)
    need := bin(mut st, BOr, cmp(mut st, CNe, t, iconst(mut st, 0)), cmp(mut st, CGe, idle, bin(mut st, BSub, load(mut st, mn, MN_N), iconst(mut st, 1))))
    kick := bin(mut st, BAnd, bin(mut st, BAnd, cmp(mut st, CGt, idle, iconst(mut st, 0)), cmp(mut st, CEq, load(mut st, mn, MN_SPINN), iconst(mut st, 0))), need)
    condbr(mut st, kick, bK, -1, bR, -1)
    setCur(mut st, bK)
    call(mut st, st.rtMnKick, list0(mut st))
    br(mut st, bR, -1)
    setCur(mut st, bR)
    ret(mut st, -1)
}

// buildMnPullPop は rt.mn_pull_pop() ptr: pull 列の頭（空なら 0）
func buildMnPullPop(st mut St) {
    begin(mut st, st.rtMnPullPop)
    mn := globaladdr(mut st, st.mnG)
    spinLock(mut st, mn, MN_PLOCK)
    h := load(mut st, mn, MN_PHEAD)
    bT := newBlock(mut st)
    bT2 := newBlock(mut st)
    bE := newBlock(mut st)
    bU := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, h, iconst(mut st, 0)), bT, -1, bU, -1)
    setCur(mut st, bT)
    nx := load(mut st, itop(mut st, h), TC_NEXT)
    store(mut st, mn, MN_PHEAD, nx)
    br(mut st, bT2, -1)
    setCur(mut st, bT2)
    br(mut st, bE, -1)
    setCur(mut st, bE)
    br(mut st, bU, -1)
    setCur(mut st, bU)
    store(mut st, mn, MN_PLOCK, iconst(mut st, 0))
    ret(mut st, itop(mut st, h))
}

// buildMnSteal は rt.mn_steal() ptr（暇なワーカーから — 段 6 Skynet 回収 (a)）: 自分の次の番号から一巡し、列が空でない被害者の頭から未着手の子を 1 つ盗む
// （無ければ 0）。被害者の鍵の中で h = H・T > h を見て、H = h + 1 を xchg（柵）して T を読み直す: T ≤ h なら持ち主が底から取った（衝突）—
// H = h に戻して退く。取れたら q[h] をその後で読む（前に読むと、持ち主が h を底から取って同じ h に積み直す間に古い子を掴む — 子が 2 回走り、
// 終わった塊が再開されて rt.task_start_mn が戻る〔 で踏んだ〕）。持ち主は T − H < DQ_CAP − 1 までしか積まない — H を進めた盗み手が
// 読む前に添字 h + DQ_CAP（同じ位置）へ積まれない
func buildMnSteal(st mut St) {
    begin(mut st, st.rtMnSteal)
    mn := globaladdr(mut st, st.mnG)
    me := load(mut st, globaladdr(mut st, st.wkG), WK_ID)
    n := load(mut st, mn, MN_N)
    zero := iconst(mut st, 0)
    loop := newBlock(mut st)
    i := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    bTry := newBlock(mut st)
    bRd := newBlock(mut st)
    bOk := newBlock(mut st)
    bBack := newBlock(mut st)
    bFail := newBlock(mut st)
    next := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, list1(mut st, iconst(mut st, 1)))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLt, i, n), body, -1, done, -1)
    setCur(mut st, body)
    v0 := bin(mut st, BAdd, me, i)
    v := bin(mut st, BSub, v0, bin(mut st, BMul, n, cmp(mut st, CGe, v0, n)))
    // 表がまだ無いワーカー（mn_start が順に起こしている途中 — 番地 0）は飛ばす
    wa := load(mut st, gepWord(mut st, mn, bin(mut st, BAdd, v, iconst(mut st, MN_WK))), 0)
    bHas := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, wa, zero), bHas, -1, next, -1)
    setCur(mut st, bHas)
    wp := itop(mut st, wa)
    condbr(mut st, cmp(mut st, CGt, load(mut st, wp, WK_DT), load(mut st, wp, WK_DH)), bTry, -1, next, -1)
    setCur(mut st, bTry)
    // 変異 6（開発用 — 盗みの網の自己検査）: 盗み手が被害者の鍵を取らない（盗み手どうしが同じ h を取る — 子が 2 回走る）
    if st.rtMut != 6 {
        spinLock(mut st, wp, WK_DLOCK)
    }
    h := load(mut st, wp, WK_DH)
    condbr(mut st, cmp(mut st, CGt, load(mut st, wp, WK_DT), h), bRd, -1, bFail, -1)
    setCur(mut st, bRd)
    mnDelayPoint(mut st)
    atomicXchg(mut st, wp, WK_DH, bin(mut st, BAdd, h, iconst(mut st, 1)))
    condbr(mut st, cmp(mut st, CGt, load(mut st, wp, WK_DT), h), bOk, -1, bBack, -1)
    setCur(mut st, bBack)
    store(mut st, wp, WK_DH, h)
    br(mut st, bFail, -1)
    setCur(mut st, bFail)
    store(mut st, wp, WK_DLOCK, zero)
    br(mut st, next, -1)
    // 取れた: q[h] は確認の後・鍵の中で読む（持ち主は添字 h へ底から届けば衝突で鍵を待つ — それまで h の位置は動かない）
    setCur(mut st, bOk)
    t := load(mut st, gepWord(mut st, wp, bin(mut st, BAdd, bin(mut st, BAnd, h, iconst(mut st, DQ_CAP - 1)), iconst(mut st, WK_DQ))), 0)
    store(mut st, wp, WK_DLOCK, zero)
    ret(mut st, itop(mut st, t))
    setCur(mut st, next)
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, i, iconst(mut st, 1))))
    setCur(mut st, done)
    ret(mut st, itop(mut st, zero))
}

// buildMnAnyDq は rt.mn_anydq() i64: どれかのワーカーの列が空でないか（素の読み — 回る者・眠る前の見直し・デッドロックの判定から。表がまだ無いワーカーは飛ばす）
func buildMnAnyDq(st mut St) {
    begin(mut st, st.rtMnAnyDq)
    mn := globaladdr(mut st, st.mnG)
    loop := newBlock(mut st)
    k := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    yes := newBlock(mut st)
    next := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLt, k, load(mut st, mn, MN_N)), body, -1, done, -1)
    setCur(mut st, body)
    wa := load(mut st, gepWord(mut st, mn, bin(mut st, BAdd, k, iconst(mut st, MN_WK))), 0)
    bHas := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, wa, iconst(mut st, 0)), bHas, -1, next, -1)
    setCur(mut st, bHas)
    wp := itop(mut st, wa)
    condbr(mut st, cmp(mut st, CGt, load(mut st, wp, WK_DT), load(mut st, wp, WK_DH)), yes, -1, next, -1)
    setCur(mut st, yes)
    ret(mut st, iconst(mut st, 1))
    setCur(mut st, next)
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, k, iconst(mut st, 1))))
    setCur(mut st, done)
    ret(mut st, iconst(mut st, 0))
}

// tscCalibrate は TSC の周波数の校正の 1 歩（MN_TSC0 = 0 なら 1 点目を置く・2^25 進んでいたら 2 点目で MN_TSCQ を決めて MN_TSC0 = -1 — 複数のワーカーが
// 同時に踏んでも近い値を書くだけ）。clock_gettime はプロセスで 2 回
func tscCalibrate(st mut St, mn int, now int) {
    zero := iconst(mut st, 0)
    t0 := load(mut st, mn, MN_TSC0)
    b1 := newBlock(mut st)
    b2 := newBlock(mut st)
    bQ := newBlock(mut st)
    bE := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, t0, zero), b1, -1, b2, -1)
    setCur(mut st, b1)
    store(mut st, mn, MN_NS0, clockNs(mut st))
    store(mut st, mn, MN_TSC0, now)
    br(mut st, bE, -1)
    setCur(mut st, b2)
    dc := bin(mut st, BSub, now, t0)
    condbr(mut st, cmp(mut st, CGt, dc, iconst(mut st, 1 << 25)), bQ, -1, bE, -1)
    setCur(mut st, bQ)
    dn := bin(mut st, BSub, clockNs(mut st), load(mut st, mn, MN_NS0))
    // dn > 0 は TSC が 2^25 進んだ後なので成り立つ（単調時計）。商が 0 なら仮定のまま
    store(mut st, mn, MN_TSCQ, bin(mut st, BDiv, bin(mut st, BShl, dc, iconst(mut st, 16)), bin(mut st, BAdd, dn, cmp(mut st, CEq, dn, zero))))
    store(mut st, mn, MN_TSC0, iconst(mut st, -1))
    br(mut st, bE, -1)
    setCur(mut st, bE)
}

// buildMnNext は rt.mn_next() ptr: 次に走らせる task（自分の走れる積み → 受け箱 → 自分の列の底 → 共有の積み → 盗み → 回る → 眠る）。全ワーカーが眠りの手前で仕事が無ければデッドロック
func buildMnNext(st mut St) {
    begin(mut st, st.rtMnNext)
    mn := globaladdr(mut st, st.mnG)
    wk := globaladdr(mut st, st.wkG)
    tk := globaladdr(mut st, st.taskG)
    zero := iconst(mut st, 0)
    loop := newBlock(mut st)
    br(mut st, loop, -1)
    setCur(mut st, loop)
    // 今（TSC — 周ごとに 1 回: この周で積む task の時刻と、取り出しの期限の比較に使う。眠りの明けもこの頭へ戻るので古い値で積まない）
    now := tscOp(mut st)
    store(mut st, wk, WK_NOW, now)
    // ring に task の io があれば提出と完了の取り込み（IO 便 段 1 — 無ければ分岐 1 本）
    bIo := newBlock(mut st)
    bGo := newBlock(mut st)
    condbr(mut st, ioBusy(mut st, wk, zero), bIo, -1, bGo, -1)
    setCur(mut st, bIo)
    call(mut st, st.rtUpoll, list1(mut st, zero))
    br(mut st, bGo, -1)
    setCur(mut st, bGo)
    r := load(mut st, tk, TK_READY)
    pick := load(mut st, wk, WK_PICK)
    store(mut st, wk, WK_PICK, bin(mut st, BAdd, pick, iconst(mut st, 1)))
    bR := newBlock(mut st)
    bI := newBlock(mut st)
    bRc := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, r, zero), bRc, -1, bI, -1)
    setCur(mut st, bRc)
    // 受け箱が空でなければ積みが空でなくても先に取り込む（Serve の accept の輪・他のワーカーからの起こしを積みの底に沈めない — report-1132 (b)）。
    // 見るのは MN_INBOX_EVERY 周に 1 回（受け箱の語は他のワーカーが書く — 毎周の読みと xchg の値段を払わない・未着手の延びは高々その周の数 — report-1150）。
    // 変異 24（開発用 --rt-mutant — gate starve の検出率の確認: HEAD〔da59f340〕の形）は先取りなし
    if st.rtMut == 24 {
        br(mut st, bR, -1)
    } else {
        bIb := newBlock(mut st)
        condbr(mut st, cmp(mut st, CEq, bin(mut st, BAnd, pick, iconst(mut st, MN_INBOX_EVERY - 1)), zero), bIb, -1, bR, -1)
        setCur(mut st, bIb)
        condbr(mut st, cmp(mut st, CEq, load(mut st, wk, WK_INBOX), zero), bR, -1, bI, -1)
    }
    setCur(mut st, bR)
    // 飽和下の待ちの上限（language.md 28 節 ring の道）: 積みの底の期限が過ぎていたら底から 1 本・でなければ頭（LIFO — 直前に動いた task を熱いうちに）。
    // 期限は枠に持つ（積むときに計算 — 底の TCB を読まない・report-1168）
    deep := cmp(mut st, CGe, r, iconst(mut st, 2))
    // TSC の校正（2 本以上積まれた最初の頃だけ — MN_TSC0 = -1 で済み）
    bCal := newBlock(mut st)
    bCk := newBlock(mut st)
    condbr(mut st, bin(mut st, BAnd, deep, cmp(mut st, CGe, load(mut st, mn, MN_TSC0), zero)), bCal, -1, bCk, -1)
    setCur(mut st, bCal)
    tscCalibrate(mut st, mn, now)
    br(mut st, bCk, -1)
    setCur(mut st, bCk)
    // 積みが浅い（1 本）なら比べない
    bDp := newBlock(mut st)
    bAg := newBlock(mut st)
    ag := param(mut st, bAg, TyI64)
    condbr(mut st, deep, bDp, -1, bAg, list1(mut st, zero))
    setCur(mut st, bDp)
    br(mut st, bAg, list1(mut st, cmp(mut st, CGt, bin(mut st, BSub, now, readyTailDl(mut st, tk)), zero)))
    setCur(mut st, bAg)
    // 変異 23 / 24（開発用 --rt-mutant — gate starve の検出率の確認）: 上限を切る（底から取らない）
    aged := if st.rtMut == 23 || st.rtMut == 24 { iconst(mut st, 0) } else { ag }
    bOld := newBlock(mut st)
    bNew := newBlock(mut st)
    bTk := newBlock(mut st)
    rq := param(mut st, bTk, TyI64)
    bot := param(mut st, bTk, TyI64)
    condbr(mut st, aged, bOld, -1, bNew, -1)
    setCur(mut st, bOld)
    store(mut st, wk, WK_AGED, bin(mut st, BAdd, load(mut st, wk, WK_AGED), iconst(mut st, 1)))
    br(mut st, bTk, list2(mut st, readyPopTail(mut st, tk), iconst(mut st, 1)))
    setCur(mut st, bNew)
    // 積みが 1 本なら頭 = 底（待ちの最大に数える）
    br(mut st, bTk, list2(mut st, readyPopHead(mut st, tk), cmp(mut st, CEq, r, iconst(mut st, 1))))
    setCur(mut st, bTk)
    rp := itop(mut st, rq)
    // 待ちの最大（Ledger の maxWait）: 底を取った回だけ比べる — 積みは頭に積むので底がいちばん古く、深いときに頭から取った task の待ちは
    // そのときの底の待ち以下（底は期限か、浅くなって頭として必ず取られる — report-1150）
    bMw := newBlock(mut st)
    bRet := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, bot, zero), bMw, -1, bRet, -1)
    setCur(mut st, bMw)
    wt := bin(mut st, BSub, now, load(mut st, rp, TC_WAKE))
    mx := load(mut st, wk, WK_MAXW)
    store(mut st, wk, WK_MAXW, bin(mut st, BAdd, mx, bin(mut st, BMul, cmp(mut st, CGt, wt, mx), bin(mut st, BSub, wt, mx))))
    br(mut st, bRet, -1)
    setCur(mut st, bRet)
    call(mut st, st.rtMnTrace, list2(mut st, iconst(mut st, 2), load(mut st, rp, TC_ID)))
    kInc(mut st, 0)
    kSnap(mut st)
    frRec(mut st, FK_RUN, ptoi(mut st, rp), iconst(mut st, 0))
    ret(mut st, rp)
    // 受け箱を全部取って走れる積みへ
    setCur(mut st, bI)
    ib := atomicXchg(mut st, wk, WK_INBOX, zero)
    bMv := newBlock(mut st)
    bP := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, ib, zero), bMv, -1, bP, -1)
    setCur(mut st, bMv)
    ml := newBlock(mut st)
    q := param(mut st, ml, TyI64)
    mb := newBlock(mut st)
    condbrTo(mut st, ml, list1(mut st, ib))
    setCur(mut st, ml)
    condbr(mut st, cmp(mut st, CEq, q, zero), loop, -1, mb, -1)
    setCur(mut st, mb)
    qp := itop(mut st, q)
    nq := load(mut st, qp, TC_INEXT)
    readyPush(mut st, tk, q)
    br(mut st, ml, list1(mut st, nq))
    // 自分の列の底（段 6 Skynet 回収 (a) — THE 規約の持ち主の取る）: T − H ≤ 0 なら空（盗み手が最後の 1 つを取り中でも空で正しい）。
    // でなければ T = b（= T − 1）を xchg（柵）してから H を読む: H ≤ b なら q[b] は持ち主のもの（盗み手は H を進めてから T を読み、H > T で退く）。
    // H > b なら衝突 — 自分の列の鍵を取って確定した H で決める（H ≤ b なら取る・でなければ T = H に戻して空）
    setCur(mut st, bP)
    bGot := newBlock(mut st)
    gp := param(mut st, bGot, TyPtr)
    gkind := param(mut st, bGot, TyI64)
    bSleep := newBlock(mut st)
    bSpin := newBlock(mut st)
    bOwn := newBlock(mut st)
    bOwnC := newBlock(mut st)
    bOwnL := newBlock(mut st)
    bOwnE := newBlock(mut st)
    bShared := newBlock(mut st)
    bStl := newBlock(mut st)
    ot := load(mut st, wk, WK_DT)
    condbr(mut st, cmp(mut st, CGt, ot, load(mut st, wk, WK_DH)), bOwn, -1, bShared, -1)
    setCur(mut st, bOwn)
    ob := bin(mut st, BSub, ot, iconst(mut st, 1))
    atomicXchg(mut st, wk, WK_DT, ob)
    mnDelayPoint(mut st)
    oslot := gepWord(mut st, wk, bin(mut st, BAdd, bin(mut st, BAnd, ob, iconst(mut st, DQ_CAP - 1)), iconst(mut st, WK_DQ)))
    condbr(mut st, cmp(mut st, CLe, load(mut st, wk, WK_DH), ob), bOwnC, -1, bOwnL, -1)
    setCur(mut st, bOwnC)
    br(mut st, bGot, list2(mut st, itop(mut st, load(mut st, oslot, 0)), iconst(mut st, 1)))
    setCur(mut st, bOwnL)
    spinLock(mut st, wk, WK_DLOCK)
    oh := load(mut st, wk, WK_DH)
    bOwnLT := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLe, oh, ob), bOwnLT, -1, bOwnE, -1)
    setCur(mut st, bOwnLT)
    op := load(mut st, oslot, 0)
    store(mut st, wk, WK_DLOCK, zero)
    br(mut st, bGot, list2(mut st, itop(mut st, op), iconst(mut st, 1)))
    setCur(mut st, bOwnE)
    store(mut st, wk, WK_DT, oh)
    store(mut st, wk, WK_DLOCK, zero)
    br(mut st, bShared, -1)
    // 共有の積み（あふれ）
    setCur(mut st, bShared)
    bChain := newBlock(mut st)
    cp := param(mut st, bChain, TyPtr)
    ckind := param(mut st, bChain, TyI64)
    p := call(mut st, st.rtMnPullPop, list0(mut st))
    condbr(mut st, cmp(mut st, CNe, ptoi(mut st, p), zero), bChain, list2(mut st, p, iconst(mut st, 1)), bStl, -1)
    // 盗む（他のワーカーの列の頭 — 未着手の子だけ）
    setCur(mut st, bStl)
    sp := call(mut st, st.rtMnSteal, list0(mut st))
    condbr(mut st, cmp(mut st, CNe, ptoi(mut st, sp), zero), bChain, list2(mut st, sp, iconst(mut st, 3)), bSpin, -1)
    // 起こしの連鎖（Go の resetspinning → wakep の流儀）: 他の列か共有の積みから取った者は、まだ仕事が見えて・暇がいて・回る者がいなければ次を起こす
    // （spawn の起こしは spawn している間しか来ない — 64 の子を一気に積んで Join に入ると、起きた 3 本以外は眠ったままだった）
    setCur(mut st, bChain)
    bKc := newBlock(mut st)
    bKc2 := newBlock(mut st)
    quiet := bin(mut st, BAnd, cmp(mut st, CGt, load(mut st, mn, MN_IDLE), zero), cmp(mut st, CEq, load(mut st, mn, MN_SPINN), zero))
    condbr(mut st, quiet, bKc, -1, bGot, list2(mut st, cp, ckind))
    setCur(mut st, bKc)
    more := bin(mut st, BOr, cmp(mut st, CNe, load(mut st, mn, MN_PHEAD), zero), call(mut st, st.rtMnAnyDq, list0(mut st)))
    condbr(mut st, more, bKc2, -1, bGot, list2(mut st, cp, ckind))
    setCur(mut st, bKc2)
    call(mut st, st.rtMnKick, list0(mut st))
    br(mut st, bGot, list2(mut st, cp, ckind))
    // 眠る前に少し回る（受け箱と pull 列を読むだけ — 仕事が数 µs で来る形〔spawn → Join の往復〕で futex の眠りと起こしの往復を避ける。
    // 回っている間は暇の数に入らない — spawn は起こしに行かない）
    // 回るのは MN_SPINMAX 本まで（段 6 P4-6 — 全員が回ると spawn ごとに pull 列の鍵へ殺到して W8 で往復 2.8 µs）。越えたら回らずに眠る
    setCur(mut st, bSpin)
    // ring に task の io があれば回らずに眠りへ（ring で眠る — 完了か起こしで起きる）
    bSpinGo := newBlock(mut st)
    condbr(mut st, ioBusy(mut st, wk, zero), bSleep, -1, bSpinGo, -1)
    setCur(mut st, bSpinGo)
    spl := newBlock(mut st)
    spi := param(mut st, spl, TyI64)
    spb := newBlock(mut st)
    spn := newBlock(mut st)
    spSeen := newBlock(mut st)
    spOut := newBlock(mut st)
    spFull := newBlock(mut st)
    spGo := newBlock(mut st)
    so := atomicXadd(mut st, mn, MN_SPINN, iconst(mut st, 1))
    condbr(mut st, cmp(mut st, CLt, so, iconst(mut st, MN_SPINMAX)), spGo, -1, spFull, -1)
    setCur(mut st, spFull)
    atomicXadd(mut st, mn, MN_SPINN, iconst(mut st, -1))
    br(mut st, bSleep, -1)
    setCur(mut st, spGo)
    br(mut st, spl, list1(mut st, zero))
    setCur(mut st, spl)
    condbr(mut st, cmp(mut st, CLt, spi, iconst(mut st, MN_SPIN)), spb, -1, spOut, -1)
    setCur(mut st, spb)
    seen0 := bin(mut st, BOr, cmp(mut st, CNe, load(mut st, wk, WK_INBOX), zero), cmp(mut st, CNe, load(mut st, mn, MN_PHEAD), zero))
    seen := bin(mut st, BOr, seen0, call(mut st, st.rtMnAnyDq, list0(mut st)))
    condbr(mut st, seen, spSeen, -1, spn, -1)
    setCur(mut st, spn)
    atomicPause(mut st)
    br(mut st, spl, list1(mut st, bin(mut st, BAdd, spi, iconst(mut st, 1))))
    setCur(mut st, spSeen)
    atomicXadd(mut st, mn, MN_SPINN, iconst(mut st, -1))
    br(mut st, loop, -1)
    setCur(mut st, spOut)
    atomicXadd(mut st, mn, MN_SPINN, iconst(mut st, -1))
    br(mut st, bSleep, -1)
    // 走り始める task（種類 1 = 自分の列か共有の積みから・3 = 盗んだ）
    setCur(mut st, bGot)
    store(mut st, gp, TC_WORKER, load(mut st, wk, WK_ID))
    call(mut st, st.rtMnTrace, list2(mut st, gkind, load(mut st, gp, TC_ID)))
    if st.rtMut == 4 {
        kInc(mut st, 0)
        kAdd(mut st, 1, cmp(mut st, CEq, gkind, iconst(mut st, 3)))
        kSnap(mut st)
    }
    frRec(mut st, FK_RUN, ptoi(mut st, gp), iconst(mut st, 1))
    ret(mut st, gp)
    // 眠る: 眠りの語 = 1・暇の数 + 1 → 見直し
    setCur(mut st, bSleep)
    bRing := newBlock(mut st)
    bFutex := newBlock(mut st)
    condbr(mut st, ioBusy(mut st, wk, zero), bRing, -1, bFutex, -1)
    // ring で眠る（IO 便 段 1）: 眠りの語 = 2・暇の数には入らない（ring の完了が必ず来るのでデッドロックの判定の外 — 判定は io の無いワーカーが眠るときに）。
    // 起こし手は眠りの語を 2 → 0 に取って eventfd へ書く（mnClaim）。走れる task が出来たか眠りの語が 0 になったら回り直す
    setCur(mut st, bRing)
    atomicXchg(mut st, wk, WK_SLEEP, iconst(mut st, 2))
    rUn := newBlock(mut st)
    rl := newBlock(mut st)
    rb := newBlock(mut st)
    rwork0 := bin(mut st, BOr, cmp(mut st, CNe, load(mut st, wk, WK_INBOX), zero), cmp(mut st, CNe, load(mut st, mn, MN_PHEAD), zero))
    condbr(mut st, bin(mut st, BOr, rwork0, call(mut st, st.rtMnAnyDq, list0(mut st))), rUn, -1, rl, -1)
    // 起きて走れる task が無い: まだ ring に完了を待つ io があれば ring で眠り直す。無ければ（最後の接続の CLOSE の完了を取り込んだ等）眠りの語を戻して
    // 回り直す — 次の眠りは futex の側（暇の数に入る = spawn の起こしが届く）。ring で眠り直すと、来る完了が無く暇の数にも入らないので誰にも起こされず、
    // 盗みに加われないまま眠り続けた（report-672 — 4096 接続の一斉の閉じの後に 1 本のワーカーだけが働く形）
    setCur(mut st, rl)
    condbr(mut st, bin(mut st, BAnd, cmp(mut st, CEq, load(mut st, wk, WK_SLEEP), iconst(mut st, 2)), ioBusy(mut st, wk, zero)), rb, -1, rUn, -1)
    setCur(mut st, rb)
    kt0 := if st.rtMut == 4 { clockNs(mut st) } else { 0 }
    call(mut st, st.rtUpoll, list1(mut st, iconst(mut st, 1)))
    if st.rtMut == 4 {
        kInc(mut st, 3)
        kAdd(mut st, 4, bin(mut st, BSub, clockNs(mut st), kt0))
    }
    condbr(mut st, cmp(mut st, CNe, load(mut st, tk, TK_READY), zero), rUn, -1, rl, -1)
    setCur(mut st, rUn)
    atomicCas(mut st, wk, WK_SLEEP, iconst(mut st, 2), zero)
    br(mut st, loop, -1)
    setCur(mut st, bFutex)
    atomicXchg(mut st, wk, WK_SLEEP, iconst(mut st, 1))
    n := bin(mut st, BAdd, atomicXadd(mut st, mn, MN_IDLE, iconst(mut st, 1)), iconst(mut st, 1))
    unsleep := newBlock(mut st)
    bChk := newBlock(mut st)
    work0 := bin(mut st, BOr, cmp(mut st, CNe, load(mut st, wk, WK_INBOX), zero), cmp(mut st, CNe, load(mut st, mn, MN_PHEAD), zero))
    work := bin(mut st, BOr, work0, call(mut st, st.rtMnAnyDq, list0(mut st)))
    condbr(mut st, work, unsleep, -1, bChk, -1)
    setCur(mut st, bChk)
    bAll := newBlock(mut st)
    bWait := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, n, load(mut st, mn, MN_N)), bAll, -1, bWait, -1)
    // 全ワーカーが眠りの手前: 全受け箱と pull 列が空で、暇の数を読み直しても N ならデッドロック
    setCur(mut st, bAll)
    sl := newBlock(mut st)
    sk := param(mut st, sl, TyI64)
    sb := newBlock(mut st)
    sn := newBlock(mut st)
    sd := newBlock(mut st)
    br(mut st, sl, list1(mut st, zero))
    setCur(mut st, sl)
    condbr(mut st, cmp(mut st, CLt, sk, load(mut st, mn, MN_N)), sb, -1, sd, -1)
    setCur(mut st, sb)
    wkp := itop(mut st, load(mut st, gepWord(mut st, mn, bin(mut st, BAdd, sk, iconst(mut st, MN_WK))), 0))
    condbr(mut st, cmp(mut st, CNe, load(mut st, wkp, WK_INBOX), zero), unsleep, -1, sn, -1)
    setCur(mut st, sn)
    br(mut st, sl, list1(mut st, bin(mut st, BAdd, sk, iconst(mut st, 1))))
    setCur(mut st, sd)
    bDl := newBlock(mut st)
    still0 := bin(mut st, BAnd, cmp(mut st, CEq, load(mut st, mn, MN_PHEAD), zero), cmp(mut st, CEq, load(mut st, mn, MN_IDLE), load(mut st, mn, MN_N)))
    still := bin(mut st, BAnd, still0, cmp(mut st, CEq, call(mut st, st.rtMnAnyDq, list0(mut st)), zero))
    condbr(mut st, still, bDl, -1, unsleep, -1)
    setCur(mut st, bDl)
    call(mut st, st.rtDeadlock, list0(mut st))
    exit(mut st, PANIC)
    // futex で眠る（起こし手が眠りの語を 0 にするまで）
    setCur(mut st, bWait)
    fl := newBlock(mut st)
    fw := newBlock(mut st)
    br(mut st, fl, -1)
    setCur(mut st, fl)
    condbr(mut st, cmp(mut st, CEq, load(mut st, wk, WK_SLEEP), iconst(mut st, 1)), fw, -1, loop, -1)
    setCur(mut st, fw)
    args := listN(mut st, 5)
    desugar.HeapSet(mut st.d, args + 1, iconst(mut st, 202))
    desugar.HeapSet(mut st.d, args + 2, ptoi(mut st, gepWord(mut st, wk, iconst(mut st, WK_SLEEP))))
    desugar.HeapSet(mut st.d, args + 3, iconst(mut st, 128))
    desugar.HeapSet(mut st.d, args + 4, iconst(mut st, 1))
    desugar.HeapSet(mut st.d, args + 5, iconst(mut st, 0))
    kf0 := if st.rtMut == 4 { clockNs(mut st) } else { 0 }
    syscall(mut st, args)
    if st.rtMut == 4 {
        kInc(mut st, 5)
        kAdd(mut st, 6, bin(mut st, BSub, clockNs(mut st), kf0))
    }
    br(mut st, fl, -1)
    // 眠りをやめる（眠りの語を 1 → 0 に取れたら自分で暇の数を減らす — 取れなければ起こし手が減らした）
    setCur(mut st, unsleep)
    o := atomicCas(mut st, wk, WK_SLEEP, iconst(mut st, 1), zero)
    bDec := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, o, iconst(mut st, 1)), bDec, -1, loop, -1)
    setCur(mut st, bDec)
    atomicXadd(mut st, mn, MN_IDLE, iconst(mut st, -1))
    br(mut st, loop, -1)
}

// condbrTo は無条件の分岐（引数つき — br の別名）
func condbrTo(st mut St, b BlkRef, args int) {
    br(mut st, b, args)
}

// mnClaim は眠っているワーカー（rt.wk の番地 wp）を起こす: 眠りの語を 1 → 0 に CAS で取れたら暇の数を減らして futex_wake（値 = 取れたか）
// 眠りの語が 2（ring で眠っている — IO 便 段 1）なら 2 → 0 に取って、そのワーカーの eventfd へ 1 を書く（暇の数には入っていない）
func mnClaim(st mut St, wp int, done BlkRef, miss BlkRef) {
    mn := globaladdr(mut st, st.mnG)
    bTry := newBlock(mut st)
    bGot := newBlock(mut st)
    bF := newBlock(mut st)
    bR := newBlock(mut st)
    v := load(mut st, wp, WK_SLEEP)
    condbr(mut st, cmp(mut st, CNe, v, iconst(mut st, 0)), bTry, -1, miss, -1)
    setCur(mut st, bTry)
    o := atomicCas(mut st, wp, WK_SLEEP, v, iconst(mut st, 0))
    condbr(mut st, cmp(mut st, CEq, o, v), bGot, -1, miss, -1)
    setCur(mut st, bGot)
    condbr(mut st, cmp(mut st, CEq, v, iconst(mut st, 1)), bF, -1, bR, -1)
    setCur(mut st, bR)
    // net の記録があればそちらの eventfd（epoll で眠っている — netpoll.sober）
    r0 := load(mut st, wp, WK_RING)
    epr := if netOn(mut st) { load(mut st, wp, WK_EP) } else { 0 }
    rec := itop(mut st, if netOn(mut st) { bin(mut st, BAdd, r0, bin(mut st, BMul, cmp(mut st, CNe, epr, iconst(mut st, 0)), bin(mut st, BSub, epr, r0))) } else { r0 })
    syscall(mut st, list4(mut st, iconst(mut st, 1), load(mut st, rec, UR_EFD), ptoi(mut st, gepWord(mut st, rec, iconst(mut st, UR_ONE))), iconst(mut st, 8)))
    br(mut st, done, -1)
    setCur(mut st, bF)
    atomicXadd(mut st, mn, MN_IDLE, iconst(mut st, -1))
    syscall(mut st, list4(mut st, iconst(mut st, 202), ptoi(mut st, gepWord(mut st, wp, iconst(mut st, WK_SLEEP))), iconst(mut st, 129), iconst(mut st, 1)))
    br(mut st, done, -1)
}

// buildMnKick は rt.mn_kick(): 眠っているワーカーを 1 つ起こす（pull 列に積んだ後）
func buildMnKick(st mut St) {
    begin(mut st, st.rtMnKick)
    mn := globaladdr(mut st, st.mnG)
    loop := newBlock(mut st)
    k := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    next := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLt, k, load(mut st, mn, MN_N)), body, -1, done, -1)
    setCur(mut st, body)
    wp := itop(mut st, load(mut st, gepWord(mut st, mn, bin(mut st, BAdd, k, iconst(mut st, MN_WK))), 0))
    mnClaim(mut st, wp, done, next)
    setCur(mut st, next)
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, k, iconst(mut st, 1))))
    setCur(mut st, done)
    ret(mut st, -1)
}

// buildMnWake は rt.mn_wake(t): task t を持ち主のワーカーで走れるようにする（自分なら走れる積み・他なら受け箱 + 眠っていれば起こす）
func buildMnWake(st mut St) {
    begin(mut st, st.rtMnWake)
    mnDelayPoint(mut st)
    mn := globaladdr(mut st, st.mnG)
    wk := globaladdr(mut st, st.wkG)
    tk := globaladdr(mut st, st.taskG)
    w := load(mut st, 0, TC_WORKER)
    bSelf := newBlock(mut st)
    bOther := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, w, load(mut st, wk, WK_ID)), bSelf, -1, bOther, -1)
    setCur(mut st, bSelf)
    readyPush(mut st, tk, ptoi(mut st, 0))
    ret(mut st, -1)
    setCur(mut st, bOther)
    if st.rtMut == 4 {
        // 数え口: 別のワーカーの task を起こした数（rt.mn[MN_PTAIL] — 使っていない語を借りる）
        atomicXadd(mut st, mn, MN_PTAIL, iconst(mut st, 1))
    }
    wp := itop(mut st, load(mut st, gepWord(mut st, mn, bin(mut st, BAdd, w, iconst(mut st, MN_WK))), 0))
    pl := newBlock(mut st)
    pd := newBlock(mut st)
    br(mut st, pl, -1)
    setCur(mut st, pl)
    h := load(mut st, wp, WK_INBOX)
    store(mut st, 0, TC_INEXT, h)
    o := atomicCas(mut st, wp, WK_INBOX, h, ptoi(mut st, 0))
    condbr(mut st, cmp(mut st, CEq, o, h), pd, -1, pl, -1)
    setCur(mut st, pd)
    done := newBlock(mut st)
    mnClaim(mut st, wp, done, done)
    setCur(mut st, done)
    ret(mut st, -1)
}

// buildMnDelay は rt.mn_delay(): 遅延注入（xorshift の 1 歩 → 0〜255 回の空回し・8 回に 1 回 sched_yield）
func buildMnDelay(st mut St) {
    begin(mut st, st.rtMnDelay)
    wk := globaladdr(mut st, st.wkG)
    seed := load(mut st, wk, WK_RND)
    x1 := bin(mut st, BXor, seed, bin(mut st, BShl, seed, iconst(mut st, 13)))
    x2 := bin(mut st, BXor, x1, bin(mut st, BAnd, bin(mut st, BSar, x1, iconst(mut st, 7)), iconst(mut st, 144115188075855871)))
    x3 := bin(mut st, BXor, x2, bin(mut st, BShl, x2, iconst(mut st, 17)))
    store(mut st, wk, WK_RND, x3)
    spinN := bin(mut st, BAnd, bin(mut st, BSar, x3, iconst(mut st, 20)), iconst(mut st, 255))
    sl := newBlock(mut st)
    si := param(mut st, sl, TyI64)
    sb := newBlock(mut st)
    sd := newBlock(mut st)
    br(mut st, sl, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, sl)
    condbr(mut st, cmp(mut st, CLt, si, spinN), sb, -1, sd, -1)
    setCur(mut st, sb)
    // 空回しの 1 回（load を挟む — 最適化器が消さない形）
    load(mut st, wk, WK_ID)
    br(mut st, sl, list1(mut st, bin(mut st, BAdd, si, iconst(mut st, 1))))
    setCur(mut st, sd)
    bY := newBlock(mut st)
    bE := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, bin(mut st, BAnd, bin(mut st, BSar, x3, iconst(mut st, 40)), iconst(mut st, 7)), iconst(mut st, 0)), bY, -1, bE, -1)
    setCur(mut st, bY)
    syscall(mut st, list1(mut st, iconst(mut st, 24)))
    br(mut st, bE, -1)
    setCur(mut st, bE)
    ret(mut st, -1)
}

// buildDpGive は rt.dp_give(s, used, r): 手元の列 r が満杯のときの返し（report-1018）— 先頭から W_MADV を超えて使った頁を返し、共有の予備の列 r へ
// （予備の単体と合わせて SRES_CAP 本まで）。満杯なら munmap（slot_give の満杯と同じ）
func buildDpGive(st mut St) {
    begin(mut st, st.rtDpGive)
    meta := globaladdr(mut st, st.meta)
    if st.rtMut == 4 {
        mInc(mut st, 3)
        mAdd(mut st, 9, 1)
    }
    keepB := load(mut st, meta, W_MADV)
    bAdv := newBlock(mut st)
    bGo := newBlock(mut st)
    condbr(mut st, cmp(mut st, CGt, 1, keepB), bAdv, -1, bGo, -1)
    setCur(mut st, bAdv)
    if st.rtMut != 5 {
        syscall(mut st, list4(mut st, iconst(mut st, 28), bin(mut st, BAdd, 0, keepB), bin(mut st, BSub, 1, keepB), iconst(mut st, 4)))
    }
    br(mut st, bGo, -1)
    setCur(mut st, bGo)
    mn := globaladdr(mut st, st.mnG)
    rs := globaladdr(mut st, st.sresG)
    sd := globaladdr(mut st, st.sdpG)
    spinLock(mut st, mn, MN_RLOCK)
    tot := load(mut st, sd, 0)
    bPut := newBlock(mut st)
    bFull := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, bin(mut st, BAdd, tot, load(mut st, rs, 0)), iconst(mut st, SRES_CAP)), bPut, -1, bFull, -1)
    setCur(mut st, bPut)
    np := gepWord(mut st, sd, bin(mut st, BAdd, 2, iconst(mut st, 1)))
    n := load(mut st, np, 0)
    store(mut st, gepWord(mut st, sd, bin(mut st, BAdd, bin(mut st, BAdd, bin(mut st, BMul, 2, iconst(mut st, SRES_CAP)), n), iconst(mut st, SDP_S))), 0, 0)
    store(mut st, np, 0, bin(mut st, BAdd, n, iconst(mut st, 1)))
    store(mut st, sd, 0, bin(mut st, BAdd, tot, iconst(mut st, 1)))
    store(mut st, mn, MN_RLOCK, iconst(mut st, 0))
    mInc(mut st, 6)
    ret(mut st, -1)
    setCur(mut st, bFull)
    store(mut st, mn, MN_RLOCK, iconst(mut st, 0))
    mInc(mut st, 5)
    syscall(mut st, list3(mut st, iconst(mut st, 11), 0, load(mut st, meta, W_SLOT_DEF)))
    if st.poolOn {
        slotVaAdd(mut st, bin(mut st, BSub, iconst(mut st, 0), load(mut st, meta, W_SLOT_DEF)))
    }
    ret(mut st, -1)
}

// buildDpTake は rt.dp_take(r) i64: 手元の列 r が空のときの取り（report-1018）— 共有の予備の列 r の末尾から 1 本を返し、続く DP_CAP − 1 本まで
// 手元の列 r へ移す（鍵を取る回数を減らす）。共有の列も空なら 0（呼び手は単体のプールから）
func buildDpTake(st mut St) {
    begin(mut st, st.rtDpTake)
    zero := iconst(mut st, 0)
    one := iconst(mut st, 1)
    mn := globaladdr(mut st, st.mnG)
    sd := globaladdr(mut st, st.sdpG)
    wk := globaladdr(mut st, st.wkG)
    np := gepWord(mut st, sd, bin(mut st, BAdd, 0, one))
    bNone := newBlock(mut st)
    bLk := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, load(mut st, np, 0), zero), bLk, -1, bNone, -1)
    setCur(mut st, bNone)
    ret(mut st, zero)
    setCur(mut st, bLk)
    spinLock(mut st, mn, MN_RLOCK)
    n := load(mut st, np, 0)
    bMiss := newBlock(mut st)
    bHit := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, n, zero), bHit, -1, bMiss, -1)
    setCur(mut st, bMiss)
    store(mut st, mn, MN_RLOCK, zero)
    ret(mut st, zero)
    setCur(mut st, bHit)
    // m = min(n, DP_CAP) 本を取る: 末尾の 1 本を返し、残りの m − 1 本を手元の列へ（手元は空 — 呼び手が空を見て呼ぶ）
    m := bin(mut st, BAdd, n, bin(mut st, BMul, cmp(mut st, CGt, n, iconst(mut st, DP_CAP)), bin(mut st, BSub, iconst(mut st, DP_CAP), n)))
    eb := bin(mut st, BAdd, bin(mut st, BMul, 0, iconst(mut st, SRES_CAP)), iconst(mut st, SDP_S))
    lb := bin(mut st, BAdd, bin(mut st, BMul, 0, iconst(mut st, DP_CAP)), iconst(mut st, WK_DPS))
    res := load(mut st, gepWord(mut st, sd, bin(mut st, BAdd, eb, bin(mut st, BSub, n, one))), 0)
    ml := newBlock(mut st)
    mi := param(mut st, ml, TyI64)
    mb := newBlock(mut st)
    md := newBlock(mut st)
    br(mut st, ml, list1(mut st, zero))
    setCur(mut st, ml)
    condbr(mut st, cmp(mut st, CLt, mi, bin(mut st, BSub, m, one)), mb, -1, md, -1)
    setCur(mut st, mb)
    store(mut st, gepWord(mut st, wk, bin(mut st, BAdd, lb, mi)), 0, load(mut st, gepWord(mut st, sd, bin(mut st, BAdd, eb, bin(mut st, BSub, bin(mut st, BSub, n, iconst(mut st, 2)), mi))), 0))
    br(mut st, ml, list1(mut st, bin(mut st, BAdd, mi, one)))
    setCur(mut st, md)
    store(mut st, gepWord(mut st, wk, bin(mut st, BAdd, 0, iconst(mut st, WK_DPC))), 0, bin(mut st, BSub, m, one))
    store(mut st, np, 0, bin(mut st, BSub, n, m))
    store(mut st, sd, 0, bin(mut st, BSub, load(mut st, sd, 0), m))
    store(mut st, mn, MN_RLOCK, zero)
    ret(mut st, res)
}

// buildSresTake は rt.sres_take() i64: 共有の予備のスロットを手元のプール（空）へ最大 SLOT_CHUNK 本移す（移した数 — 0 = 予備も空）
func buildSresTake(st mut St) {
    begin(mut st, st.rtSresTake)
    mn := globaladdr(mut st, st.mnG)
    rs := globaladdr(mut st, st.sresG)
    fg := globaladdr(mut st, st.slotFreeG)
    spinLock(mut st, mn, MN_RLOCK)
    c := load(mut st, rs, 0)
    m := bin(mut st, BAdd, c, bin(mut st, BMul, cmp(mut st, CGt, c, iconst(mut st, SLOT_CHUNK)), bin(mut st, BSub, iconst(mut st, SLOT_CHUNK), c)))
    loop := newBlock(mut st)
    i := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    done := newBlock(mut st)
    br(mut st, loop, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLt, i, m), body, -1, done, -1)
    setCur(mut st, body)
    store(mut st, gepWord(mut st, fg, bin(mut st, BAdd, i, iconst(mut st, 1))), 0, load(mut st, gepWord(mut st, rs, bin(mut st, BSub, c, i)), 0))
    br(mut st, loop, list1(mut st, bin(mut st, BAdd, i, iconst(mut st, 1))))
    setCur(mut st, done)
    store(mut st, rs, 0, bin(mut st, BSub, c, m))
    store(mut st, fg, 0, m)
    store(mut st, mn, MN_RLOCK, iconst(mut st, 0))
    ret(mut st, m)
}

// buildTcbFree は rt.tcb_free(t): 塊を手元の鎖へ。手元が 2 × TCB_KEEP 本を越えたら、先頭の TCB_KEEP 本を 1 束にして共有の予備（束の鎖 —
// 束の頭の TC_INEXT。空きの塊は受け箱に居ない）へ出す。手元の長さは鎖の節が持つ（TC_FLEN — 取りの道〔rt.task_new〕は触らない）。
// t のスタックの上で走っていないこと。束の長さを固定する理由: 1 本ずつ鍵を取ると、生む側と終わる側のワーカーが違う木（Skynet）で
// 鍵の取り合いが W8 の cycles の 15% だった。手元の鎖を丸ごと束にすると束が雪だるま式に膨らみ（100 万 task で平均 287 本）、取った 1 つの
// ワーカーが抱えて他が尽き、新しい塊の mmap が入力に比例した
func buildTcbFree(st mut St) {
    begin(mut st, st.rtTcbFree)
    mn := globaladdr(mut st, st.mnG)
    tk := globaladdr(mut st, st.taskG)
    h0 := load(mut st, tk, TK_FREE)
    bH := newBlock(mut st)
    bJ := newBlock(mut st)
    n0 := param(mut st, bJ, TyI64)
    condbr(mut st, cmp(mut st, CNe, h0, iconst(mut st, 0)), bH, -1, bJ, list1(mut st, iconst(mut st, 0)))
    setCur(mut st, bH)
    br(mut st, bJ, list1(mut st, load(mut st, itop(mut st, h0), TC_FLEN)))
    setCur(mut st, bJ)
    nf := bin(mut st, BAdd, n0, iconst(mut st, 1))
    store(mut st, 0, TC_FLEN, nf)
    store(mut st, 0, TC_NEXT, h0)
    store(mut st, tk, TK_FREE, ptoi(mut st, 0))
    bL := newBlock(mut st)
    bS := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLe, nf, iconst(mut st, 2 * TCB_KEEP)), bL, -1, bS, -1)
    setCur(mut st, bL)
    ret(mut st, -1)
    setCur(mut st, bS)
    // 先頭の TCB_KEEP 本（t から）を切り離す: 尾 = TCB_KEEP 本目。残りの節の TC_FLEN はそのまま正しい（尾までの本数）
    lp := newBlock(mut st)
    p := param(mut st, lp, TyI64)
    i := param(mut st, lp, TyI64)
    lb := newBlock(mut st)
    ld := newBlock(mut st)
    br(mut st, lp, list2(mut st, ptoi(mut st, 0), iconst(mut st, 1)))
    setCur(mut st, lp)
    pn := load(mut st, itop(mut st, p), TC_NEXT)
    condbr(mut st, bin(mut st, BAnd, cmp(mut st, CLt, i, iconst(mut st, TCB_KEEP)), cmp(mut st, CNe, pn, iconst(mut st, 0))), lb, -1, ld, -1)
    setCur(mut st, lb)
    br(mut st, lp, list2(mut st, pn, bin(mut st, BAdd, i, iconst(mut st, 1))))
    setCur(mut st, ld)
    store(mut st, tk, TK_FREE, pn)
    store(mut st, itop(mut st, p), TC_NEXT, iconst(mut st, 0))
    spinLock(mut st, mn, MN_RLOCK)
    store(mut st, 0, TC_INEXT, load(mut st, mn, MN_RTCB))
    store(mut st, mn, MN_RTCB, ptoi(mut st, 0))
    store(mut st, mn, MN_RLOCK, iconst(mut st, 0))
    ret(mut st, -1)
}

// mnTcbReserve は共有の予備の束を 1 つ取り、頭を返して残りを手元の鎖にする（無ければ 0 — rt.task_new の新しい塊の道の手前・手元が尽きたとき
// だけ・M:N のときだけ）。束の節の TC_FLEN は出したときの手元の長さのままなので、残りの節に尾までの本数を振り直す（束の長さ ≤ TCB_KEEP）
func mnTcbReserve(st mut St) int {
    mn := globaladdr(mut st, st.mnG)
    spinLock(mut st, mn, MN_RLOCK)
    h := load(mut st, mn, MN_RTCB)
    bT := newBlock(mut st)
    bE := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, h, iconst(mut st, 0)), bT, -1, bE, -1)
    setCur(mut st, bT)
    store(mut st, mn, MN_RTCB, load(mut st, itop(mut st, h), TC_INEXT))
    br(mut st, bE, -1)
    setCur(mut st, bE)
    store(mut st, mn, MN_RLOCK, iconst(mut st, 0))
    bR := newBlock(mut st)
    bX := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, h, iconst(mut st, 0)), bR, -1, bX, -1)
    setCur(mut st, bR)
    rest := load(mut st, itop(mut st, h), TC_NEXT)
    store(mut st, globaladdr(mut st, st.taskG), TK_FREE, rest)
    // 残りの本数を数えてから、頭から尾までの本数を振る（2 周 — 高々 TCB_KEEP − 1 本）
    c1 := newBlock(mut st)
    cp := param(mut st, c1, TyI64)
    cn := param(mut st, c1, TyI64)
    c2 := newBlock(mut st)
    c3 := newBlock(mut st)
    br(mut st, c1, list2(mut st, rest, iconst(mut st, 0)))
    setCur(mut st, c1)
    condbr(mut st, cmp(mut st, CNe, cp, iconst(mut st, 0)), c2, -1, c3, -1)
    setCur(mut st, c2)
    br(mut st, c1, list2(mut st, load(mut st, itop(mut st, cp), TC_NEXT), bin(mut st, BAdd, cn, iconst(mut st, 1))))
    setCur(mut st, c3)
    s1 := newBlock(mut st)
    sp := param(mut st, s1, TyI64)
    sn := param(mut st, s1, TyI64)
    s2 := newBlock(mut st)
    br(mut st, s1, list2(mut st, rest, cn))
    setCur(mut st, s1)
    condbr(mut st, cmp(mut st, CNe, sp, iconst(mut st, 0)), s2, -1, bX, -1)
    setCur(mut st, s2)
    store(mut st, itop(mut st, sp), TC_FLEN, sn)
    br(mut st, s1, list2(mut st, load(mut st, itop(mut st, sp), TC_NEXT), bin(mut st, BSub, sn, iconst(mut st, 1))))
    setCur(mut st, bX)
    return h
}

// buildTaskStartMn は rt.task_start_mn(tcb)（M:N の子の入口 — rt.task_start の M:N 版）: 罠を張って子を呼び、枠を公開し（結果 → 死因 → 状態）、
// scope の記録を原子的に数え、区間を閉じ（鍵の中）、待ち手を起こし、自前のスロットを返して次の task へ切り替える（戻らない）
func buildTaskStartMn(st mut St) {
    begin(mut st, st.rtTaskStartMn)
    if st.rtMut == 4 {
        // 数え口（開発用）: 走り始めた task の数（MN_CNT_START）と、spawn した task と別のワーカーで走り始めた数（MN_CNT_CROSS）
        mnS := globaladdr(mut st, st.mnG)
        atomicXadd(mut st, mnS, MN_CNT_START, iconst(mut st, 1))
        crossS := cmp(mut st, CNe, load(mut st, itop(mut st, load(mut st, 0, TC_WAKER)), TC_WORKER), load(mut st, globaladdr(mut st, st.wkG), WK_ID))
        atomicXadd(mut st, mnS, MN_CNT_CROSS, crossS)
    }
    if st.rtMut == 4 {
        kAdd(mut st, 13, bin(mut st, BSub, clockNs(mut st), load(mut st, 0, TC_KT0)))
        kInc(mut st, 12)
    }
    frame := itop(mut st, load(mut st, 0, TC_FRAME))
    r := trapCall(mut st, load(mut st, 0, TC_KID), fieldPtr(mut st, frame, FR_RES))
    frRec(mut st, FK_END, ptoi(mut st, 0), r)
    fdDrainCall(mut st)
    orphEnd(mut st, 0)
    tg := globaladdr(mut st, st.trapG)
    cause := bin(mut st, BOr, bin(mut st, BShl, load(mut st, tg, TW_SITE), iconst(mut st, 8)), load(mut st, tg, TW_CODE))
    store(mut st, frame, FR_CAUSE, cause)
    // 切られた（段 6 P4-5）か死んだか: 罠へ戻ったか打ち切りの印が 1 度でも立ったプログラムだけ遅い道（rt.cut_end — 判定・後ろの兄弟の印・開いている scope の子を待つ）
    cut := cutEnd(mut st, 0, frame, r)
    dead := bin(mut st, BMul, r, bin(mut st, BSub, iconst(mut st, 1), cut))
    mnDelayPoint(mut st)
    store(mut st, frame, FR_STATE, bin(mut st, BAdd, bin(mut st, BAdd, r, iconst(mut st, 1)), bin(mut st, BMul, cut, bin(mut st, BSub, iconst(mut st, 2), r))))
    rec := itop(mut st, load(mut st, frame, FR_SREC))
    if st.rtMut == 1 {
        // 変異 1: 完了した error の子で err が nil でなければ、到着順で最初の失敗として記録へ
        eoff := load(mut st, frame, FR_EOFF)
        failed := bin(mut st, BAnd, bin(mut st, BAnd, cmp(mut st, CEq, r, iconst(mut st, 0)), cmp(mut st, CNe, eoff, iconst(mut st, 0))),
            cmp(mut st, CNe, load(mut st, gepWord(mut st, frame, bin(mut st, BAdd, eoff, iconst(mut st, FR_RES))), 0), iconst(mut st, 0)))
        bF := newBlock(mut st)
        bF2 := newBlock(mut st)
        condbr(mut st, failed, bF, -1, bF2, -1)
        setCur(mut st, bF)
        atomicCas(mut st, rec, SRSZ, iconst(mut st, 0), ptoi(mut st, frame))
        br(mut st, bF2, -1)
        setCur(mut st, bF2)
    }
    atomicXadd(mut st, rec, SR_DEAD, dead)
    poolDied(mut st, 0, dead)
    mn := globaladdr(mut st, st.mnG)
    bOc := newBlock(mut st)
    bOc2 := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, load(mut st, 0, TC_SEG), iconst(mut st, 0)), bOc2, -1, bOc, -1)
    setCur(mut st, bOc)
    spinLock(mut st, mn, MN_OLOCK)
    outClose(mut st, 0)
    store(mut st, mn, MN_OLOCK, iconst(mut st, 0))
    br(mut st, bOc2, -1)
    setCur(mut st, bOc2)
    // 入場で足した量を台帳へ返す（段 6 P5-2 — 起こした scope の出口より先に）
    admitReturn(mut st, 0)
    // Join / Try で待つ task（取って起こす — 待ちの型の起こし手）
    mut jn := 0
    if st.rtMut == 2 {
        // 変異 2: 起こし手の取り出しを素の load / store に
        jn = load(mut st, frame, FR_JOINER)
        store(mut st, frame, FR_JOINER, iconst(mut st, 0))
    } else {
        jn = atomicXchg(mut st, frame, FR_JOINER, iconst(mut st, 0))
    }
    bJ := newBlock(mut st)
    bJ2 := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, jn, iconst(mut st, 0)), bJ, -1, bJ2, -1)
    setCur(mut st, bJ)
    call(mut st, st.rtMnWake, list1(mut st, itop(mut st, jn)))
    br(mut st, bJ2, -1)
    setCur(mut st, bJ2)
    frameDrop(mut st, frame, rec, dead)
    // 生きている子の数（× 2）を減らす: 結果 1 = 数 0 で出口が待っている — その時だけ記録に触れて起こす（waitLive）
    live := bin(mut st, BSub, atomicXadd(mut st, rec, SR_LIVE, iconst(mut st, -2)), iconst(mut st, 2))
    bW := newBlock(mut st)
    bW2 := newBlock(mut st)
    condbr(mut st, cmp(mut st, CEq, live, iconst(mut st, 1)), bW, -1, bW2, -1)
    setCur(mut st, bW)
    call(mut st, st.rtMnWake, list1(mut st, itop(mut st, load(mut st, rec, SR_WAITER))))
    br(mut st, bW2, -1)
    setCur(mut st, bW2)
    pstatCall(mut st, st.rtPstatEnd, list1(mut st, 0))
    if st.rtMut == 4 {
        mAdd(mut st, 10, iconst(mut st, -1))
    }
    admitEnd(mut st, 0, slotReleaseMn(mut st, 0))
    nx := call(mut st, st.rtMnNext, list0(mut st))
    // 前に終わった塊を返し、自分を次に返す側へ（自分のスタックの上では返さない）
    wk := globaladdr(mut st, st.wkG)
    z := load(mut st, wk, WK_ZOMBIE)
    bZ := newBlock(mut st)
    bZ2 := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, z, iconst(mut st, 0)), bZ, -1, bZ2, -1)
    setCur(mut st, bZ)
    call(mut st, st.rtTcbFree, list1(mut st, itop(mut st, z)))
    br(mut st, bZ2, -1)
    setCur(mut st, bZ2)
    store(mut st, wk, WK_ZOMBIE, ptoi(mut st, 0))
    call(mut st, st.rtTaskSwitch, list2(mut st, 0, nx))
    ret(mut st, -1)
}

// slotReleaseMn は終わる task（tcb）の自前のスロットをプールへ返す（M:N — 返す深度の bump を 0 にして世代を進める: このワーカーの表の古い先端が
// 他の task に渡ったスロットの番地と一致して先端の伸長・幾何成長の照合に当たらないように）
func slotReleaseMn(st mut St, tcb int) int {
    meta := globaladdr(mut st, st.meta)
    sg := globaladdr(mut st, st.slotsG)
    loop := newBlock(mut st)
    k := param(mut st, loop, TyI64)
    acc := param(mut st, loop, TyI64)
    body := newBlock(mut st)
    done := newBlock(mut st)
    dacc := param(mut st, done, TyI64)
    hi := load(mut st, sg, SLOT_OWN)
    br(mut st, loop, list2(mut st, bin(mut st, BAdd, load(mut st, tcb, TC_BASE), iconst(mut st, 1)), iconst(mut st, 0)))
    setCur(mut st, loop)
    condbr(mut st, cmp(mut st, CLe, k, hi), body, -1, done, list1(mut st, acc))
    setCur(mut st, body)
    s := load(mut st, gepWord(mut st, sg, k), 0)
    bp := gepWord(mut st, meta, k)
    used := bin(mut st, BSub, load(mut st, bp, W_BUMP), s)
    // 既定より大きいスロット（自前の mmap — slot_new）はプールへ返さず munmap
    bBig := newBlock(mut st)
    bDef := newBlock(mut st)
    bGo := newBlock(mut st)
    sz := load(mut st, meta, W_SLOT_SIZE)
    // 既定より小さいスロット（task.sober smallRel）はワーカーの小さいスロットの鎖へ
    smallRel(mut st, meta, k, s, used, sz, bBig, bDef, bGo)
    setCur(mut st, bBig)
    syscall(mut st, list3(mut st, iconst(mut st, 11), s, sz))
    if st.poolOn {
        slotVaAdd(mut st, bin(mut st, BSub, iconst(mut st, 0), sz))
    }
    br(mut st, bGo, -1)
    setCur(mut st, bDef)
    // 列 r = k & DP_MASK に空きがあれば手元の列へ（返すのは先頭から W_MADV を超えた分だけ — slot_give と同じ規則）・満杯なら rt.dp_give（共有の列）
    wk := globaladdr(mut st, st.wkG)
    r := bin(mut st, BAnd, k, iconst(mut st, DP_MASK))
    cp := gepWord(mut st, wk, bin(mut st, BAdd, r, iconst(mut st, WK_DPC)))
    c := load(mut st, cp, 0)
    bDp3 := newBlock(mut st)
    bAdv := newBlock(mut st)
    bPush := newBlock(mut st)
    bSg := newBlock(mut st)
    condbr(mut st, cmp(mut st, CLt, c, iconst(mut st, DP_CAP)), bDp3, -1, bSg, -1)
    setCur(mut st, bDp3)
    keepB := load(mut st, meta, W_MADV)
    condbr(mut st, cmp(mut st, CGt, used, keepB), bAdv, -1, bPush, -1)
    setCur(mut st, bAdv)
    if st.rtMut != 5 {
        syscall(mut st, list4(mut st, iconst(mut st, 28), bin(mut st, BAdd, s, keepB), bin(mut st, BSub, used, keepB), iconst(mut st, 4)))
    }
    br(mut st, bPush, -1)
    setCur(mut st, bPush)
    store(mut st, gepWord(mut st, wk, bin(mut st, BAdd, bin(mut st, BAdd, bin(mut st, BMul, r, iconst(mut st, DP_CAP)), c), iconst(mut st, WK_DPS))), 0, s)
    store(mut st, cp, 0, bin(mut st, BAdd, c, iconst(mut st, 1)))
    if st.rtMut == 4 {
        mInc(mut st, 3)
        mAdd(mut st, 18, iconst(mut st, 1))
    }
    br(mut st, bGo, -1)
    setCur(mut st, bSg)
    call(mut st, st.rtDpGive, list3(mut st, s, used, r))
    br(mut st, bGo, -1)
    setCur(mut st, bGo)
    store(mut st, bp, W_BUMP, iconst(mut st, 0))
    genBump(mut st, k)
    br(mut st, loop, list2(mut st, bin(mut st, BAdd, k, iconst(mut st, 1)), bin(mut st, BAdd, acc, used)))
    setCur(mut st, done)
    return dacc
}

// buildMnTrace は rt.mn_trace(kind, id)（SOBER_SCHED_TRACE=1 のとき — ワーカー 2 以上の出来事の列）: 標準エラーへ `#sched ev <通し番号> <ワーカー> <種類> <task>`
// （種類 1 = 走り始め・2 = 再開）。再生はワーカー 1 で（p4-draft 3.3 — 強制再生は需要待ち）
func buildMnTrace(st mut St) {
    begin(mut st, st.rtMnTrace)
    mn := globaladdr(mut st, st.mnG)
    bT := newBlock(mut st)
    bE := newBlock(mut st)
    condbr(mut st, cmp(mut st, CNe, load(mut st, mn, MN_TRACE), iconst(mut st, 0)), bT, -1, bE, -1)
    setCur(mut st, bT)
    seq := atomicXadd(mut st, mn, MN_EV, iconst(mut st, 1))
    meta := globaladdr(mut st, st.meta)
    fd0 := load(mut st, meta, W_FD)
    store(mut st, meta, W_FD, iconst(mut st, 2))
    printLit(mut st, "#sched ev ")
    call(mut st, st.rtPint, list1(mut st, seq))
    call(mut st, st.rtPchar, list1(mut st, iconst(mut st, ' ')))
    call(mut st, st.rtPint, list1(mut st, load(mut st, globaladdr(mut st, st.wkG), WK_ID)))
    call(mut st, st.rtPchar, list1(mut st, iconst(mut st, ' ')))
    call(mut st, st.rtPint, list1(mut st, 0))
    call(mut st, st.rtPchar, list1(mut st, iconst(mut st, ' ')))
    call(mut st, st.rtPint, list1(mut st, 1))
    call(mut st, st.rtPchar, list1(mut st, iconst(mut st, '\n')))
    call(mut st, st.rtFlush, list0(mut st))
    store(mut st, meta, W_FD, fd0)
    br(mut st, bE, -1)
    setCur(mut st, bE)
    ret(mut st, -1)
}
