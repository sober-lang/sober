package lower

// 移し器: 関数 1 つの本体の IR を番地 0 起点の詰めた []int へ移し（mvPack）、
// 詰めた形を今のヒープの末尾へ積んで関数の記録の頭を付け替える（mvUnpack）。バッチ（B1 = optimizeSsa・B2 = 展開の後のcfgClean〜cmpDup）を
// 群の子へ配る前提の形 — 子は詰めた形を自前のヒープに積んでバッチを回し、同じ形で詰め直して返す。
// - 動かすもの = 関数の本体: スロット [next, 語数, 番号, 空きのチェーン, 値]・ブロック [B_*]・ブロックの引数 [next, 値, 型, 0]・命令 [I_*]・値の列 [n, …]
// - 動かさないもの = 関数の記録そのもの（他の関数の呼び出し〔K_FN〕・関数のチェーンが番地で指す — 頭の本体のフィールドだけ書き換える）と外の参照
//   （K_FN・K_GLOB・F_NAME・F_PTYS — 不透明にそのまま運ぶ）
// - 付け替えるフィールド = 記録のチェーン（スロットのnext・ブロックのB_NEXT / B_PHEAD / B_PTAIL / B_IHEAD / B_ITAIL・引数のnext・命令のI_NEXT）と、
//   フィールドの種別の表（ir.soberのopRow / termRow）がK_BLK / K_VLIST / K_OLISTとするフィールド。値の番号（K_VAL）は関数ごとの通しなので付け替えない
// - 値の列は命令・終端の間で共有されうる（optのvlistが同じ列を2度書かないフラグを付けるのはそのため）— 1つの列は1回だけ移す
// - 旧い番地 → 詰めた番地は、コピーし終えた旧い記録（と列の頭）の先頭のワードに転送先の符号（mvCode — 負・持ち主の関数つき）を書いて引く
//   （詰めた後の旧い本体は死ぬ — 親は子の結果を積み直す・roundtrip は積み直す。ハッシュの表を引く形は自己 build で 1.2 G 命令）
// 詰めた形: [頭MV_HDRワード][スロットMV_SLOTワード…][ブロックBSZワード…][引数MV_PARワード…][命令ISZワード…][値の列…]（各々チェーンの順）

import "desugar"
import "std/iter"
import "std/table"
import "std/task"

const MV_SLOT = 5
const MV_PAR = 4
// 頭: [スロット数, ブロック数, 引数数, 命令数, F_NVAL, F_BHEAD, F_BTAIL, F_NBLK, F_SHEAD, F_STAIL, F_NSLOT]
const MV_NS = 0
const MV_NB = 1
const MV_NP = 2
const MV_NI = 3
const MV_FN = 4  // 関数の記録の本体のフィールドのコピー（F_NVAL〜F_NSLOTの7ワード — MV_FN + k = 下のmvFnField(k)）
const MV_HDR = 11

// 頭にコピーする関数の記録のフィールド（k = 0〜6）
func mvFnField(k int) int {
    return switch k {
    case 0: F_NVAL
    case 1: F_BHEAD
    case 2: F_BTAIL
    case 3: F_NBLK
    case 4: F_SHEAD
    case 5: F_STAIL
    default: F_NSLOT
    }
}

// 頭の関数のフィールドkが記録を指すか（チェーンの頭・尾 — 付け替える）
func mvFnRef(k int) bool { return k == 1 || k == 2 || k == 4 || k == 5 }

// 転送先の符号の持ち主の桁（詰めた番地 < 2^24ワード）
const MV_OWN = 16777216

// 関数fの詰めた番地offへの転送先の符号（≤ -2 — チェーンの -1〔無し〕・列の長さ〔≥ 0〕と重ならない）
func mvCode(f FnRef, off int) int { return -(2 + off + int(f) * MV_OWN) }

// 旧い番地xの先頭のワードが関数fの転送先の符号か
func mvOwn(st mut St, f FnRef, x int) bool {
    c := desugar.HeapGet(mut st.d, x)
    return c <= -2 && (-c - 2) / MV_OWN == int(f)
}

// 旧い番地xの詰めた番地（-1 = 無しはそのまま）。転送先の符号が無ければ詰めの抜け（本体の外を指すチェーン・列 — roundtripの検査が落とす形）
func mvFwd(st mut St, f FnRef, x int) int {
    if x < 0 {
        return x
    }
    if !mvOwn(mut st, f, x) {
        panic(Unreachable{})
    }
    return -desugar.HeapGet(mut st.d, x) - 2 - int(f) * MV_OWN
}

// 値の列lを（初出なら）outの末尾へコピーして詰めた番地を返す（旧い列の頭に転送先を書く・毒のために [番地, 長さ] を残す）
func mvListMove(st mut St, f FnRef, out mut []int, lists mut []int, l int) int {
    if l < 0 {
        return l
    }
    n := desugar.HeapGet(mut st.d, l)
    if n <= -2 {
        return mvFwd(mut st, f, l)
    }
    off := len(out)
    mvCopy(mut st, mut out, l, 1 + n)
    desugar.HeapSet(mut st.d, l, mvCode(f, off))
    lists = append(lists, l)
    lists = append(lists, n)
    return off
}

// 旧い記録xのnワードをoutの末尾へ。ワードごとにヒープのAPI（desugar.HeapGet）で読む — Tableのchunkを直に読む高速パス
// （copyloop.soberが一括のコピーにしていた形）は、他のpackageのmutの中身を持つフィールドの読みなので外した（language.md 20 節）。
// 一括の読みAPI（std/tableにchunk単位のコピー）はチェーンの行が要る — 積み
func mvCopy(st mut St, out mut []int, x int, n int) {
    mut a := x
    end := x + n
    while a < end {
        out = append(out, desugar.HeapGet(mut st.d, a))
        a += 1
    }
}

// 関数fの本体を詰めた形にする。旧い本体の記録の先頭のワードは転送先の符号で潰れる（poisonなら記録と列の全部を毒で — roundtrip）
func mvPack(st mut St, f FnRef, poison bool) []int {
    mut ss := mut []int{}
    mut bs := mut []int{}
    mut ps := mut []int{}
    mut is := mut []int{}
    mut s := irFnSHead(mut st, f)
    while s >= 0 {
        ss = append(ss, s)
        s = desugar.HeapGet(mut st.d, s)
    }
    mut b := irFnBHead(mut st, f)
    while b != -1 {
        bs = append(bs, int(b))
        b = irBlkNext(mut st, b)
    }
    for k <- iter.Range(0, len(bs)) {
        mut p := irBlkPHead(mut st, BlkRef(bs[k]))
        while p >= 0 {
            ps = append(ps, p)
            p = desugar.HeapGet(mut st.d, p)
        }
        mut i := irBlkIHead(mut st, BlkRef(bs[k]))
        while i != -1 {
            is = append(is, int(i))
            i = irInsNext(mut st, i)
        }
    }
    sOff := MV_HDR
    bOff := sOff + len(ss) * MV_SLOT
    pOff := bOff + len(bs) * BSZ
    iOff := pOff + len(ps) * MV_PAR
    // 頭（関数のフィールドは最後に付け替える）と記録の生のコピー
    mut out := mut []int{}
    out = append(out, len(ss))
    out = append(out, len(bs))
    out = append(out, len(ps))
    out = append(out, len(is))
    for k <- iter.Range(0, 7) {
        out = append(out, desugar.HeapGet(mut st.d, int(f) + mvFnField(k)))
    }
    for k <- iter.Range(0, len(ss)) {
        mvCopy(mut st, mut out, ss[k], MV_SLOT)
    }
    for k <- iter.Range(0, len(bs)) {
        mvCopy(mut st, mut out, bs[k], BSZ)
    }
    for k <- iter.Range(0, len(ps)) {
        mvCopy(mut st, mut out, ps[k], MV_PAR)
    }
    for k <- iter.Range(0, len(is)) {
        mvCopy(mut st, mut out, is[k], ISZ)
    }
    // 転送先（コピーし終えたので旧い記録の先頭のワードを潰してよい）
    for k <- iter.Range(0, len(ss)) {
        desugar.HeapSet(mut st.d, ss[k], mvCode(f, sOff + k * MV_SLOT))
    }
    for k <- iter.Range(0, len(bs)) {
        desugar.HeapSet(mut st.d, bs[k], mvCode(f, bOff + k * BSZ))
    }
    for k <- iter.Range(0, len(ps)) {
        desugar.HeapSet(mut st.d, ps[k], mvCode(f, pOff + k * MV_PAR))
    }
    for k <- iter.Range(0, len(is)) {
        desugar.HeapSet(mut st.d, is[k], mvCode(f, iOff + k * ISZ))
    }
    // 値の列（命令の順 → 終端の順に初出でコピーする）と付け替え
    mut lists := mut []int{}
    for k <- iter.Range(0, len(is)) {
        at := iOff + k * ISZ
        out[at + I_NEXT] = mvFwd(mut st, f, out[at + I_NEXT])
        mut r := st.opk[out[at + I_OP]]
        mut fa := at + I_A
        while r != 0 {
            kind := r & 15
            if kind == K_VLIST || kind == K_OLIST {
                out[fa] = mvListMove(mut st, f, mut out, mut lists, out[fa])
            }
            r = r >> 4
            fa += 1
        }
    }
    for k <- iter.Range(0, len(bs)) {
        at := bOff + k * BSZ
        out[at + B_NEXT] = mvFwd(mut st, f, out[at + B_NEXT])
        out[at + B_PHEAD] = mvFwd(mut st, f, out[at + B_PHEAD])
        out[at + B_PTAIL] = mvFwd(mut st, f, out[at + B_PTAIL])
        out[at + B_IHEAD] = mvFwd(mut st, f, out[at + B_IHEAD])
        out[at + B_ITAIL] = mvFwd(mut st, f, out[at + B_ITAIL])
        mut r := st.tmk[out[at + B_TERM]]
        mut fa := at + B_X1
        while r != 0 {
            kind := r & 15
            if kind == K_BLK {
                out[fa] = mvFwd(mut st, f, out[fa])
            } else if kind == K_VLIST {
                out[fa] = mvListMove(mut st, f, mut out, mut lists, out[fa])
            }
            r = r >> 4
            fa += 1
        }
    }
    for k <- iter.Range(0, len(ss)) {
        at := sOff + k * MV_SLOT
        out[at] = mvFwd(mut st, f, out[at])
        // 空きのチェーン（lowerの間だけ使う — beginが関数ごとに空にする）は同じ関数のスロットなら付け替え・外なら無し
        fr := out[at + 3]
        out[at + 3] = if fr >= 0 && mvOwn(mut st, f, fr) { mvFwd(mut st, f, fr) } else { -1 }
    }
    for k <- iter.Range(0, len(ps)) {
        at := pOff + k * MV_PAR
        out[at] = mvFwd(mut st, f, out[at])
    }
    for k <- iter.Range(0, 7) {
        if mvFnRef(k) {
            out[MV_FN + k] = mvFwd(mut st, f, out[MV_FN + k])
        }
    }
    if poison {
        mvFillAll(mut st, mut ss, MV_SLOT)
        mvFillAll(mut st, mut bs, BSZ)
        mvFillAll(mut st, mut ps, MV_PAR)
        mvFillAll(mut st, mut is, ISZ)
        for k <- iter.Range(0, len(lists) / 2) {
            mvFill(mut st, lists[k * 2], 1 + lists[k * 2 + 1])
        }
    }
    return freeze(out)
}

// 詰めた形pを内側の参照を + 基底で付け替えたコピーにして今のヒープの末尾へチャンクで積み、関数fの記録の本体のフィールドを書き換える
// （旧い本体の記録はヒープにゴミとして残る）
func mvUnpack(st mut St, f FnRef, p []int) {
    base := desugar.HeapLen(mut st.d)
    mut q := mut []int{}
    pn := len(p)
    mut w := 0
    while w < pn {
        q = append(q, p[w])
        w += 1
    }
    mut at := MV_HDR
    for k <- iter.Range(0, p[MV_NS]) {
        mvRel(mut q, at, base)
        mvRel(mut q, at + 3, base)
        at += MV_SLOT
    }
    for k <- iter.Range(0, p[MV_NB]) {
        mvRel(mut q, at + B_NEXT, base)
        mvRel(mut q, at + B_PHEAD, base)
        mvRel(mut q, at + B_PTAIL, base)
        mvRel(mut q, at + B_IHEAD, base)
        mvRel(mut q, at + B_ITAIL, base)
        mut r := st.tmk[q[at + B_TERM]]
        mut x := at + B_X1
        while r != 0 {
            kind := r & 15
            if kind == K_BLK || kind == K_VLIST {
                mvRel(mut q, x, base)
            }
            r = r >> 4
            x += 1
        }
        at += BSZ
    }
    for k <- iter.Range(0, p[MV_NP]) {
        mvRel(mut q, at, base)
        at += MV_PAR
    }
    for k <- iter.Range(0, p[MV_NI]) {
        mvRel(mut q, at + I_NEXT, base)
        mut r := st.opk[q[at + I_OP]]
        mut x := at + I_A
        while r != 0 {
            kind := r & 15
            if kind == K_VLIST || kind == K_OLIST {
                mvRel(mut q, x, base)
            }
            r = r >> 4
            x += 1
        }
        at += ISZ
    }
    desugar.HeapPushAll(mut st.d, freeze(q))
    for k <- iter.Range(0, 7) {
        v := p[MV_FN + k]
        desugar.HeapSet(mut st.d, int(f) + mvFnField(k), if mvFnRef(k) && v >= 0 { v + base } else { v })
    }
}

// q[at] が詰めた番地なら + base（-1 = 無しはそのまま）
func mvRel(q mut []int, at int, base int) {
    if q[at] >= 0 {
        q[at] = q[at] + base
    }
}

// roundtrip が旧い本体の記録に書く毒（ヒープの外の番地 — 付け替え忘れの参照を読めば添字の範囲外で落ちる・値として使えば ELF が変わる）
const MV_POISON = 1125899906842624

func mvFillAll(st mut St, xs mut []int, n int) {
    for k <- iter.Range(0, len(xs)) {
        mvFill(mut st, xs[k], n)
    }
}

func mvFill(st mut St, at int, n int) {
    for k <- iter.Range(0, n) {
        desugar.HeapSet(mut st.d, at + k, MV_POISON)
    }
}

// 全関数の本体を詰め、旧い本体を毒で潰して積み直す（バッチを回さない — 移し器の検査: SOBER_BUILD_PAR=roundtripで、
// ELF ≡ 移さない経路。毒は付け替え忘れのフィールド・本体の外から本体の記録を番地で持ち越す表を落とす）
func mvRoundtripModule(st mut St) {
    mut f := st.fhead
    while f != -1 {
        if irFnBHead(mut st, f) != -1 {
            p := mvPack(mut st, f, true)
            mvUnpack(mut st, f, p)
        }
        f = irFnNext(mut st, f)
    }
}

// ── バッチの群の子 ──
// バッチ（B1 = optimizeSsaのsroa〜depth・B2 = 展開の後のcfgClean〜cmpDup）の関数ごとのパスを、関数を命令の数で群に分けて群の子で回す:
// 親が関数の本体を詰め（mvPack — 旧い本体は死ぬ）、子は自前のStのヒープに関数の記録を新しく組んで積み（mvUnpack）、バッチのパスを関数ごとに
// 全部掛けて詰め直して返す。親は群の順に積み直す。バッチの各Moduleは関数ごとのループだけ（パスの順 × 関数の順を、関数の順 × パスの順に
// 入れ替えても同じ — selfparの1本の経路 ≡ W8のELFの照合が検査）。子が読むStのフィールドはlParCfg（scripts/lparcfg.tsが推移的な依存を棚卸しする）と、
// 呼び先の戻りの型の表（lret — valueTypes が呼び出しの結果の型を引く: lFnRet）だけ。
// ワーカー 1・群 1 つ以下・1 本の経路（xseq）・roundtrip では移さず今までの Module の列（呼び手）

const LG_COST = 25000  // 群の目標の太さ（命令の数 — x86の群と同じ基準。Wで割らない）

// 1 つの群（親の関数の記録・詰めた本体・引数の型の列・戻りの型）
type LGroup struct {
    fns []int
    bodies [][]int
    ptys [][]int
    rets []int
    mutp []int
    refp []int
}

// 子のStにコピーするフィールド（scripts/lparcfg.tsの許しの表のcfg）
// （winOnの4 = 予約ページを使うか — 子の展開の予算の数え〔unroll.soberのUR_RALLOCW〕が読む。関数キャッシュの鍵〔cfgの正準形〕も分ける）
func lParCfg(st mut St, b2 bool) []int {
    return mfCfg(mut st, []int{int(st.rtPanic), int(st.rtPanicMem), int(st.rtMapfind), int(st.rtRenterL), int(st.rtRenterLL), (if st.noVec { 1 } else { 0 }) | (if st.taskUse { 2 } else { 0 }) | (if st.winOn { 4 } else { 0 }) | (if st.areaOn { 8 } else { 0 }), if b2 { 1 } else if st.optInB1 { 2 } else { 0 }, int(st.ubCheck), int(st.ubBound), int(st.rtGrow), int(st.rtGrow8), int(st.rtRalloc), int(st.rtAlloc8), st.meta, int(st.rtStreq), int(st.rtMatchLen), int(st.rtJClean)})
}

// 呼び先の戻りの型の表 [関数の記録, F_RET]…（記録の番地の昇順 — lFnRetが二分探索で引く。チェーンの順とは限らないのでfnIdsで並べる）
func lRets(st mut St) []int {
    mut out := mut []int{}
    ids := fnIds(mut st)
    for k <- iter.Range(0, len(ids)) {
        out = append(out, ids[k])
        out = append(out, irFnRet(mut st, FnRef(ids[k])))
    }
    return freeze(out)
}

// 関数 g の戻りの型（群の子は親の表 st.lret から・他はヒープの記録から）
func lFnRet(st mut St, g FnRef) int {
    if !st.lkid {
        if st.bcAud {
            bcAudRet(mut st, int(g))
        }
        return irFnRet(mut st, g)
    }
    mut lo := 0
    mut hi := len(st.lret) / 2 - 1
    while lo <= hi {
        m := (lo + hi) / 2
        a := st.lret[m * 2]
        if a == int(g) {
            return st.lret[m * 2 + 1]
        }
        if a < int(g) {
            lo = m + 1
        } else {
            hi = m - 1
        }
    }
    panic(Unreachable{})
}

// バッチを群の子で回す形か（ワーカー1・1本の経路・roundtripでない）
func lParOn(st mut St) bool {
    return !st.xseq && !st.mvRound && !st.bcAud && task.Ledger().workers > 1
}

// バッチb2（偽 = B1・真 = B2）を群の子で回す。回さない形（ワーカー1・群1つ以下・1本の経路・roundtrip）なら何もせずfalse
func lParBatch(st mut St, b2 bool) bool {
    if !lParOn(mut st) {
        return false
    }
    mut fr := mut []int{}
    mut cut := mut []int{0}   // 群の境（fr の添字）
    mut acc := 0
    mut f := st.fhead
    while f != -1 {
        if irFnBHead(mut st, f) != -1 {
            fr = append(fr, int(f))
            acc += xFnCost(mut st, f)
            if acc >= LG_COST {
                cut = append(cut, len(fr))
                acc = 0
            }
        }
        f = irFnNext(mut st, f)
    }
    if acc > 0 {
        cut = append(cut, len(fr))
    }
    if len(cut) <= 2 {
        return false
    }
    lret := lRets(mut st)
    cfg := lParCfg(mut st, b2)
    ckt := if st.ckOn { ckTab(mut st, cfg) } else { ckNone() }
    // 親が後で読む表も同じもの（格納場所の β1の書き / 読み戻し — bcB1Collect）
    if st.ckOn {
        st.ckt = ckt
    }
    frz := freeze(fr)
    ct := freeze(cut)
    // 流し込み: 群ごとに詰めて、チャネルを作り give: で子を起こしてから送る — 親の詰めが先に起こした子の走りに重なる。
    // 積み戻しは起こした順（= 群の順 — 終わった順でなく）に Join して 1 群ずつ — 尻の子の走りに重なる。群の割り方と積み戻しの順は全部を詰めてから
    // task.Map で回していた形と同じなので出力は変わらない（ワーカー数に依らない）
    if !lStream(mut st, frz, ct, cfg, lret, ckt, st.bcv) {
        return panic(InvariantBroken{})
    }
    return true
}

// 流し込みの scope（切り出し — lParBatch の本体を展開の重複から離す）。子が死ねば false
func lStream(st mut St, frz []int, ct []int, cfg []int, lret []int, ckt CkTab, bv BcView) bool {
    _, serr := task.Run((s task.Scope) => {
        mut hs := mut []task.Handle[LOut]{}
        mut k := 0
        while k < len(ct) - 1 {
            g := lPack(mut st, frz, ct[k], ct[k + 1])
            // budget: = 群の詰めた語数 × 128 B + 8 MiB（子のヒープ〔パスが積む記録で伸びる〕と作業域 — コピーは親の分で子は数えない）
            bud := lWords(g) * 128 + 8 * task.MB
            tx, rx := task.NewChannel[LGroup](cap: 1)
            h := task.Spawn(s, (inp) => {
                gi := task.Recv(inp)
                if gi != nil { lParGroup(gi, cfg, lret, ckt, bv) } else { LOut{bodies: [][]int{}, ks: []int{}, hit: []int{}, av: []byte{}, al: []int{}} }
            }, give: rx, budget: bud)
            hs = append(hs, h)
            task.Send(tx, g)
            k += 1
        }
        mut j := 0
        while j < len(hs) {
            o := task.Join(hs[j])
            lUnpack(mut st, frz, ct[j], o, if cfg[6] == 1 { 1 } else { 0 })
            j += 1
        }
        0
    })
    return serr == nil
}

// 群の子の結果（群の中の関数の順の詰めた本体 — handle の型引数に [][]int を直に書けない綴りの都合で包む）
type LOut struct {
    bodies [][]int
    ks []int   // 段階3の鍵（関数ごとに [h1, h2, 呼び先の数, 呼び先…] — 鍵を計算しないパスは空）
    hit []int  // 段階3の格納場所（R2）: 関数ごとの当たりの項目（-1 = 外れ）・α の値の並び・関数ごとの α の値の長さ（格納場所を使わないパスは空）
    av []byte
    al []int
}

// 群の子の結果o（frの添字loから続く関数の詰めた本体）を積み戻す（scopeの本体でJoinの結果のフィールドを直に読む形はcheckの
// コアの範囲の外 — struct ごと渡す）
func lUnpack(st mut St, fr []int, lo int, o LOut, stage int) {
    for q <- iter.Range(0, len(o.bodies)) {
        mvUnpack(mut st, FnRef(fr[lo + q]), o.bodies[q])
    }
    // 段階3の鍵（鍵を計算しないパスは空）— stage = 0 = α・1 = B2
    if len(o.ks) > 0 {
        ckPut(mut st, stage, fr, lo, o.ks)
    }
    if len(o.hit) > 0 {
        bcKidPut(mut st, fr, lo, o, stage)
    }
}

// frの添字 [lo, hi) の関数を詰めた群（署名の型の列・戻り・mut仮引数のフラグと本体）
func lPack(st mut St, fr []int, lo int, hi int) LGroup {
    mut fns := mut []int{}
    mut bodies := mut [][]int{}
    mut ptys := mut [][]int{}
    mut rets := mut []int{}
    mut mutp := mut []int{}
    mut refp := mut []int{}
    for j <- iter.Range(lo, hi) {
        g := FnRef(fr[j])
        fns = append(fns, fr[j])
        pt := irFnPtys(mut st, g)
        mut pv := mut []int{}
        for q <- iter.Range(0, desugar.HeapGet(mut st.d, pt)) {
            pv = append(pv, desugar.HeapGet(mut st.d, pt + 1 + q))
        }
        ptys = append(ptys, freeze(pv))
        rets = append(rets, irFnRet(mut st, g))
        mutp = append(mutp, irFnMutP(mut st, g))
        refp = append(refp, irFnRefP(mut st, g))
        bodies = append(bodies, mvPack(mut st, g, false))
    }
    return LGroup{fns: freeze(fns), bodies: freeze(bodies), ptys: freeze(ptys), rets: freeze(rets), mutp: freeze(mutp), refp: freeze(refp)}
}

// 群の詰めた語数
func lWords(g LGroup) int {
    mut w := 0
    for b <- g.bodies {
        w += len(b)
    }
    return w
}

// 子の本体: 自前のStのヒープに群の関数を積み、バッチのパスを関数ごとに掛けて詰め直す
func lParGroup(g LGroup, cfg []int, lret []int, ckt CkTab, bv BcView) LOut {
    mut st := St{}
    kindsInit(mut st)
    st.rtPanic = FnRef(cfg[0])
    st.rtPanicMem = FnRef(cfg[1])
    st.rtMapfind = FnRef(cfg[2])
    st.rtRenterL = FnRef(cfg[3])
    st.rtRenterLL = FnRef(cfg[4])
    st.noVec = cfg[5] & 1 == 1
    // task を使うプログラムには SLP を掛けない（slp.sober — キャンセルの検査点が v128 の区間を跨ぎうる）
    st.taskUse = cfg[5] & 2 == 2
    st.winOn = cfg[5] & 4 == 4
    st.areaOn = cfg[5] & 8 == 8
    st.lkid = true
    st.lret = lret
    desugar.HeapPush(mut st.d, 0)
    st.ubCheck = FnRef(cfg[7])
    st.ubBound = FnRef(cfg[8])
    // ヘッダのループ昇格（hloop.sober）が許す rt の呼び出し・確保の根
    st.rtGrow = FnRef(cfg[9])
    st.rtGrow8 = FnRef(cfg[10])
    st.rtRalloc = FnRef(cfg[11])
    st.rtAlloc8 = FnRef(cfg[12])
    // 展開後の上限の巻き上げ（rlim.sober）のシードの番地 @rt.meta
    st.meta = cfg[13]
    // コピーの転送（cpfwd.sober）が読むだけとみなすrt.str_eq
    st.rtStreq = FnRef(cfg[14])
    // 手書きの本体に置き換える rt.matchlen（確保しない・読むだけの rt — rlight / cancel の表）
    st.rtMatchLen = FnRef(cfg[15])
    st.rtJClean = FnRef(cfg[16])
    mfCfgSet(mut st, cfg, 17)
    st.ckt = ckt
    mut out := mut [][]int{}
    mut ks := mut []int{}
    mut hit := mut []int{}
    mut av := table.Table[byte]{}
    mut al := mut []int{}
    stage := if cfg[6] == 1 { 1 } else { 0 }
    for j <- iter.Range(0, len(g.fns)) {
        cf := FnRef(recN(mut st, FSZ))
        pl := listN(mut st, len(g.ptys[j]))
        for q <- iter.Range(0, len(g.ptys[j])) {
            desugar.HeapSet(mut st.d, pl + 1 + q, g.ptys[j][q])
        }
        desugar.HeapSet(mut st.d, int(cf) + F_PTYS, pl)
        desugar.HeapSet(mut st.d, int(cf) + F_RET, g.rets[j])
        desugar.HeapSet(mut st.d, int(cf) + F_MUTP, g.mutp[j])
        desugar.HeapSet(mut st.d, int(cf) + F_REFP, g.refp[j])
        mvUnpack(mut st, cf, g.bodies[j])
        // 段階3の鍵（ckey.sober — 積み戻した記録を全体のパスと同じ歩きで）
        mut e := -1
        if ckt.on {
            k := ckFn(mut st, cf, stage)
            for x <- k {
                ks = append(ks, x)
            }
            // 段階3の格納場所（bcache.sober）: α の当たりは値を読み戻してB1を飛ばす・β1の当たりはB2を飛ばして入力のまま返す
            if bv.on {
                e = bcKid(bv, stage, k[0], k[1])
                if e >= 0 && stage == 0 {
                    mut r := bcRdOf(bv, e)
                    p := bcAlphaDec(mut r, st.opk, st.tmk, ckt)
                    if r.bad || r.at != r.end {
                        e = -1
                    } else {
                        out = append(out, p)
                    }
                } else if e >= 0 {
                    out = append(out, g.bodies[j])
                }
                hit = append(hit, e)
            }
        }
        if e < 0 {
            if cfg[6] == 1 {
                lB2Func(mut st, cf)
            } else {
                // 2 = 設計整合パスの関数ごとのフェーズを頭で（elfOutStがoptPreだけを済ませた形）
                if cfg[6] == 2 {
                    optFunc(mut st, cf)
                }
                lB1Func(mut st, cf)
            }
            p := mvPack(mut st, cf, false)
            out = append(out, p)
            if bv.on && stage == 0 {
                a0 := table.Len(mut av)
                bcAlphaEnc(mut av, p, st.opk, st.tmk, ckt)
                al = append(al, table.Len(mut av) - a0)
            } else {
                al = append(al, 0)
            }
        } else {
            al = append(al, 0)
        }
    }
    return LOut{bodies: freeze(out), ks: freeze(ks), hit: freeze(hit), av: bcCat(table.Freeze(mut av)), al: freeze(al)}
}

// B1（optimizeSsa）の関数ごとのパスの列
func lB1Func(st mut St, f FnRef) {
    sroaFunc(mut st, f, false)
    m2rFunc(mut st, f)
    gvnFunc(mut st, f)
    hdrFunc(mut st, f)
    hloopFunc(mut st, f)
    cpfwdFunc(mut st, f)
    unrollFunc(mut st, f)
    bceFunc(mut st, f)
    licmFunc(mut st, f)
    depthFlowFunc(mut st, f)
}

// B2（展開の後の cfgClean〜cmpDup）の関数ごとのパスの列
func lB2Func(st mut St, f FnRef) {
    cfgCleanFunc(mut st, f)
    if st.rtMapfind != -1 {
        mfFunc(mut st, f)
    }
    sroaFunc(mut st, f, true)
    p0 := ccNParams(mut st, f)
    m2rFunc(mut st, f)
    if ccNParams(mut st, f) > p0 {
        ccDeadAfterM2r(mut st, f)
        ccPostFold(mut st, f)
    }
    lb := lbScan(mut st, f)
    if lb & 1 != 0 {
        rlimBody(mut st, f)
    }
    if lb & 2 != 0 {
        ldhoistFunc(mut st, f)
    }
    _ = ubfFunc(mut st, f)
    if !st.noVec {
        _ = vecFunc(mut st, f)
        slpFunc(mut st, f)
    }
    _ = cmpDupFunc(mut st, f)
}
