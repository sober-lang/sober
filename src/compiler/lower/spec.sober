package lower

// 定数引数の特化: 呼び出し点の引数が定数（const・globaladdr とその ptoi / itop）なら、小さい callee を
// 「その仮引数を定数に置き換えた複製」に差し替える。複製は普通の関数なので、optimizeSsa の関数ごとのパス（opt の畳み・gvn・unroll・bce・licm）を
// 掛け直せば畳める（`HasPrefix(p, ":")` → hasPrefixAt のループが 1 周に・比較が定数に）。畳んで小さくなった複製は rtlower の後の irinl の
// TINYの規則がそのままコピーする。コピーでなく複製なのでregionのopを持つcalleeでも意味は元の関数と同じ（同じ関数を1つの引数を固定して呼ぶだけ）。
// 配置先 = optimizeSsaの後（定数はgvnのstoreの転送で初めて呼び出しの引数に届く）・最適化のバックエンドの経路だけ（`--no-spec` で外す）。
// 規則: calleeは自分でない・入口でない・rt. とUTF-8の境界のインターフェース（validPrefix / Check / boundary — 名前で引く後段のマーク）でない・task / 罠のopを
// 持たない・命令 SP_MAX 以下。定数の仮引数は比較・算術・gep・itop・load・呼び出しの引数のどれかで使われる。(callee, 定数の組) ごとに複製 1 つ
// （表で引く）。複製を畳んだ後の大きさが元より小さくなければ捨てる（呼び出しは元のまま）。複製の中の呼び出しにも同じ規則（深さ SP_DEPTH まで）。
// 複製は呼び手の関数の直前に置く — irinlは関数のチェーンの順にコピーするので、深い複製が先に呼び手の複製へコピーされ、コピーした本体ごと呼び手へコピーされる

import "desugar"
import "std/iter"
import "std/sort"
import "std/table"

const SP_MAX = 32
const SP_DEPTH = 3
// 畳んだ複製をspecの中で呼び手へコピーする大きさの上限（熱い命令 — panicの点〔exitで終わるブロック〕を数えない）
const SP_INL = 12
// 内側の複製をコピーした後の複製を残す・呼び手へコピーする大きさの上限（熱い命令）
const SP_KEEP = 24
// 同じ組の中の、同じ callee の複製の数の上限（違う定数の組）
const SP_PER = 4
// 表の記録: [組, callee, 定数の数 n, (仮引数の位置, 種類〔0 = 整数・1 = globaladdr〕, 値) × n, 複製〔-1 = 捨てた〕]
// 組 = 呼び手のpackage（-2 - package。packageの関数）か、呼び手の関数の記録（インスタンス・ラムダ・子・rt）。複製の作り直しと上限は組の中だけで数え、
// 組をまたいで複製を共有しない: あるpackageの特化が、ほかのpackageの呼び出しの並びに依らない（packageの単位でlower以降を飛ばす前提）。
// 複製はそれを作った呼び手の組に属し、複製の中の呼び出しも同じ組で数える
const SP_K_INT = 0
const SP_K_GLOB = 1

// モジュールの呼び出し点を特化する（作った複製の数を返す）
func specModule(st mut St) int {
    save := st.fn
    mut tab := mut []int{}
    mut work := mut []int{}
    // 関数の記録 → 組（packageの関数だけ。表に無い関数は自分が組）
    mut grp := mut map[int]int{}
    for i <- iter.Range(0, table.Len(mut st.infos)) {
        x := infoAt(mut st, i)
        if int(x.ir) >= 0 && x.fn >= 0 {
            grp[int(x.ir)] = -2 - x.pkg
        }
    }
    // 作業列は名前の順（packageの関数の安定な鍵 — チェーンの順は発見の順で、ほかのpackageの呼び出しの並びで変わる。組の中の表の引きと
    // 上限SP_PERの枠の取り合いを並びに依らせない）。SOBER_SPEC_ORDER=1 = 並べる前の入力を逆に（撹拌の検査 — 結果は並びに依らない）
    mut orig := mut []int{}
    mut f := st.fhead
    while f != -1 {
        if irFnBHead(mut st, f) != -1 {
            orig = append(orig, int(f))
        }
        f = irFnNext(mut st, f)
    }
    if ilEnvInt("SOBER_SPEC_ORDER") == 1 {
        for i <- iter.Range(0, len(orig) / 2) {
            t := orig[i]
            orig[i] = orig[len(orig) - 1 - i]
            orig[len(orig) - 1 - i] = t
        }
    }
    ofr := freeze(orig)
    mut nms := mut [][]byte{}
    for r <- ofr {
        mut nm := mut []byte{}
        printName(mut st, mut nm, irFnName(mut st, FnRef(r)))
        nms = append(nms, freeze(nm))
    }
    nmf := freeze(nms)
    for k <- sort.Order(len(ofr), (a, b) => spBytesLess(nmf[a], nmf[b])) {
        work = append(work, ofr[k])
        work = append(work, 0)
        g0 := grp[ofr[k]]
        work = append(work, if g0 != nil { g0 } else { ofr[k] })
    }
    // 資格の表（元の関数 — 番地の昇順〔spFindが二分探索で引く。チェーンの順とは限らないのでfnIdsで並べる — チェーンの順で集めると規則順のチェーンで
    // 引きが外れ、全呼び出し点が資格を歩き直して引き金のマークなしで複製を試すことになる〕。複製は呼ぶたびに数える）
    fl := fnIds(mut st)
    // 要約の値を使うモード: 要約にある関数は、使い道のマークと引き金のマークの周ごとの値（BX_SPEC・BX_SPRND）を要約から置き、中継の周で
    // 求め直さない（呼び手の周 r は呼び先の周 r - 1 の値を読む — 周ごとの値が要る。sv = [使い道, 中継の前, 1周, 2周, 3周] か空）
    use := bxCUse(mut st)
    mut svs := mut [][]int{}
    for k <- iter.Range(0, len(fl)) {
        svs = append(svs, if use { spSumVals(mut st, FnRef(fl[k])) } else { []int{} })
    }
    sv := freeze(svs)
    mut fi0 := mut []int{}
    for k <- iter.Range(0, len(fl)) {
        fi0 = append(fi0, if len(sv[k]) > 0 { sv[k][0] } else { spInfo(mut st, FnRef(fl[k])) })
    }
    finfo := freeze(fi0)
    // 引き金のマーク（比較に効く仮引数 — 直に・算術1レベルを経て・比較に効くcalleeの仮引数へ渡る〔小さい関数の間の不動点3周〕）。複製は
    // 定数の引数がこのマークに当たるときだけ作る（使い道のマークfinfoだけで作ると、定数を受けても畳めない関数の複製を作って捨てる費用が判定の仕事 +1.4 G）
    mut fs0 := mut []int{}
    for k <- iter.Range(0, len(fl)) {
        fs0 = append(fs0, if len(sv[k]) > 0 { sv[k][1] } else if finfo[k] > 0 { spSens(mut st, FnRef(fl[k])) } else { 0 })
    }
    mut fsens := freeze(fs0)
    mut rnd := mut []int{}
    for k <- iter.Range(0, 3 * len(fl)) {
        rnd = append(rnd, 0)
    }
    for k <- iter.Range(0, len(fl)) {
        rnd[3 * k] = fsens[k]
    }
    for r <- iter.Range(0, 3) {
        mut nx := mut []int{}
        for k <- iter.Range(0, len(fl)) {
            nx = append(nx, if len(sv[k]) > 0 { sv[k][2 + r] } else if finfo[k] > 0 { fsens[k] | spRelayMask(mut st, FnRef(fl[k]), fl, fsens) } else { 0 })
        }
        fsens = freeze(nx)
        if r < 2 {
            for k <- iter.Range(0, len(fl)) {
                rnd[3 * k + 1 + r] = fsens[k]
            }
        }
    }
    // 境の要約の事実 [使い道のマーク, 引き金のマーク] と、複製の元になりうる関数（使い道のマークがある — SP_MAX 以下）の処理の前の本体
    if st.bx.on {
        bt := bxTab(mut st)
        for k <- iter.Range(0, len(fl)) {
            bxFact(mut st, FnRef(fl[k]), BX_SPEC, finfo[k], fsens[k], 0)
            if bxCOn(mut st) {
                zcv, zch := bxCSpec(mut st, FnRef(fl[k]))
                bxCCmp(mut st, FnRef(fl[k]), BX_SPEC, zcv, zch, []int{finfo[k], fsens[k]})
            }
            if finfo[k] > 0 {
                bxFact(mut st, FnRef(fl[k]), BX_SPRND, rnd[3 * k], rnd[3 * k + 1], rnd[3 * k + 2])
                if bxCOn(mut st) {
                    zcv, zch := bxCSprnd(mut st, FnRef(fl[k]))
                    bxCCmp(mut st, FnRef(fl[k]), BX_SPRND, zcv, zch, []int{rnd[3 * k], rnd[3 * k + 1], rnd[3 * k + 2]})
                }
            }
            if finfo[k] > 0 && irFnBHead(mut st, FnRef(fl[k])) != -1 {
                // 要約の値を使うモード: 複製の元になる本体を、この時点（処理の前）の要約の本体（BX_SPPRE）にする
                if len(sv[k]) > 0 {
                    spSumBody(mut st, FnRef(fl[k]), bt)
                }
                bxBody(mut st, FnRef(fl[k]), BX_SPPRE, bt)
            }
        }
    }
    // 枠の割り当て（並びに依らない）: 元の関数の呼び出し点の (組, callee, 定数の組) を数え、組 × callee ごとに呼び出し点の多い順（同数は鍵の値の順）に
    // SP_PERの枠を与える。複製の中の呼び出し（ここに現れない定数の組）は、名前の順の作業列での先着で残りの枠を取る
    pre := spPreCount(mut st, mut work, fl, finfo, fsens)
    mut made := 0
    mut clones := mut []int{}
    mut origs := mut []int{}
    mut callers := mut []int{}
    // 元の関数を呼び手として処理したときの呼び出しの付け替え（関数 → [序数, 元の callee, 複製]…）。複製はいつも処理の前の本体から作る
    // （付け替えを戻して複製し、元へ付け直す）: 別の呼び手が複製する本体が、その関数を先に処理したか — 名前の順 — に依らない。
    // 中の呼び出しは、複製を呼び手として処理するときに複製の組で特化し直す
    mut mods := mut map[int][]int{}
    // 本体を下ろさなかった関数の複製が要約の本体を読む鍵の表（1回だけ組む — 要約の本体が指すのは元の関数で、作った複製は指さない）
    sbt := if use { bxTab(mut st) } else { ckNone() }
    mut w := 0
    while w < len(work) {
        cf := FnRef(work[w])
        depth := work[w + 1]
        gr := work[w + 2]
        w += 3
        st.fn = cf
        // 定義の表は最初の候補の呼び出しで作る（候補の無い関数で値の表を組まない）
        mut defs := []int{}
        mut touched := false
        mut ordn := 0
        isOrig := spFind(fl, int(cf)) >= 0
        mut b := irFnBHead(mut st, cf)
        while b != -1 {
            mut ins := if irBlkTerm(mut st, b) == TmExit { InsRef(-1) } else { irBlkIHead(mut st, b) }
            while ins != -1 {
                g := if irInsOp(mut st, ins) == OpCall { irInsFn(mut st, ins) } else { FnRef(-1) }
                gi := if int(g) >= 0 && g != cf { spFind(fl, int(g)) } else { -1 }
                mask := if int(g) < 0 || g == cf { -1 } else if gi >= 0 { finfo[gi] } else { spInfo(mut st, g) }
                sens := if gi >= 0 { fsens[gi] } else { mask }
                if mask > 0 && sens > 0 {
                    if len(defs) == 0 {
                        defs = spDefs(mut st, cf)
                    }
                    key := spKey(mut st, defs, g, ins, mask)
                    if len(key) > 2 && spTrig(key, sens) {
                        // 束の自分の分へ: 特化の候補の呼び出しを持つ関数（本体を下ろさないモードでは本体を捨てない — 複製と枠の割り当て〔spPreCount〕は
                        // 候補の呼び出しの全部で決まる）
                        if isOrig {
                            bxFact(mut st, cf, BX_SPMK, int(cf), 0, 0)
                        }
                        // 表を引く（同じ callee・同じ定数の組）
                        mut found := -2
                        mut per := 0
                        mut t := 0
                        while t < len(tab) && found == -2 {
                            n := tab[t + 2]
                            mine := tab[t] == gr && tab[t + 1] == key[0]
                            if mine {
                                per += 1
                            }
                            mut same := mine && n == key[1]
                            for k <- iter.Range(0, 3 * n) {
                                if same && tab[t + 3 + k] != key[2 + k] {
                                    same = false
                                }
                            }
                            if same {
                                found = tab[t + 3 + 3 * n]
                            }
                            t += 4 + 3 * n
                        }
                        if found == -2 {
                            // 同じ callee の違う定数の組は SP_PER まで（strLit・iconst のように多くの定数で呼ばれる関数を複製で増やさない）
                            pr := spPreFind(pre, gr, key)
                            adm := if pr >= 0 { pre.recs[pr + 5 + 3 * key[1]] == 1 } else { per < SP_PER }
                            if !adm || spHopeless(tab, gr, key) {
                                found = -1
                            }
                        }
                        if found == -2 {
                            mg := mods[int(g)]
                            if mg != nil {
                                spSetCalls(mut st, g, mg, 1)
                            }
                            c := spClone(mut st, g, cf, key, gr, sbt)
                            if mg != nil {
                                spSetCalls(mut st, g, mg, 2)
                            }
                            tab = append(tab, gr)
                            for k <- iter.Range(0, len(key)) {
                                tab = append(tab, key[k])
                            }
                            tab = append(tab, int(c))
                            found = int(c)
                            if int(c) != -1 {
                                made += 1
                                clones = append(clones, int(c))
                                origs = append(origs, int(g))
                                if depth + 1 < SP_DEPTH {
                                    work = append(work, int(c))
                                    work = append(work, depth + 1)
                                    work = append(work, gr)
                                }
                            }
                            st.fn = cf
                        }
                        if found >= 0 {
                            if isOrig {
                                mut m0 := mods[int(cf)]
                                mut m1 := mut []int{}
                                if m0 != nil {
                                    for v <- m0 {
                                        m1 = append(m1, v)
                                    }
                                }
                                m1 = append(m1, ordn)
                                m1 = append(m1, int(g))
                                m1 = append(m1, found)
                                mods[int(cf)] = freeze(m1)
                            }
                            irSetInsA(mut st, ins, found)
                            if !touched {
                                touched = true
                                callers = append(callers, int(cf))
                            }
                        }
                    }
                }
                ins = irInsNext(mut st, ins)
                ordn += 1
            }
            b = irBlkNext(mut st, b)
        }
    }
    // 畳んで小さくなった複製（熱い命令SP_INL以下・コピーできる形）は呼び手へコピーする: 後に作った（深い）複製から — 2レベルの連鎖（HasPrefix → hasPrefixAt）の
    // 内側を先に外側の複製へコピーし、コピーした後の外側を呼び手へコピーする（rtlowerの後のirinlはコピーの中の呼び出しをコピーしない — 1レベル）
    cl := freeze(clones)
    mut ci := len(cl) - 1
    while ci >= 0 {
        spInline(mut st, FnRef(cl[ci]), cl)
        ci -= 1
    }
    // 残すのはコピーできる大きさまで畳めた複製だけ（中継ぎの複製も、内側をコピーした後で小さくなっていれば残る）。残さない複製の呼び出しは元のcalleeへ
    // 戻し、関数のチェーンから外す（定数を受けても畳めない関数〔strLit・iconst …〕の複製で自己buildのIRが +30%・判定の仕事 +14 Gだった）
    mut keep0 := mut []int{}
    for k <- iter.Range(0, len(cl)) {
        c := FnRef(cl[k])
        keep0 = append(keep0, if spHot(mut st, c) <= SP_KEEP && ilShape(mut st, c, ilSize(mut st, c)) == 1 { 1 } else { 0 })
    }
    keep := freeze(keep0)
    og := freeze(origs)
    mut f3 := st.fhead
    mut prev := FnRef(-1)
    while f3 != -1 {
        nx := irFnNext(mut st, f3)
        x := spFind(cl, int(f3))
        if x >= 0 && keep[x] == 0 {
            // チェーンから外す
            if int(prev) == -1 {
                st.fhead = nx
            } else {
                irSetFnNext(mut st, prev, nx)
            }
            if st.ftail == f3 {
                st.ftail = prev
            }
        } else {
            prev = f3
        }
        f3 = nx
    }
    // 呼び出しを書き換えた関数だけを戻し・コピーの対象に（全関数のIRを歩かない）
    // 残した複製も（内側の複製のコピーを受けている — コピーの中に残さない複製の呼び出しがありうる）
    cs := freeze(callers)
    for k <- iter.Range(0, len(cs)) {
        if spFind(cl, cs[k]) < 0 {
            spRedirect(mut st, FnRef(cs[k]), cl, keep, og)
        }
    }
    for k <- iter.Range(0, len(cl)) {
        if keep[k] == 1 {
            spRedirect(mut st, FnRef(cl[k]), cl, keep, og)
        }
    }
    // 残した複製を元の関数の呼び出し点へコピーする
    for k <- iter.Range(0, len(cs)) {
        if spFind(cl, cs[k]) < 0 {
            spInline(mut st, FnRef(cs[k]), cl)
        }
    }
    st.fn = save
    return made
}

// 要約にある関数の特化の値 [使い道のマーク, 引き金のマークの中継の前, 1周, 2周, 3周]（使い道のマークが無ければ引き金のマークは全部 0。読めなければ空）
func spSumVals(st mut St, f FnRef) []int {
    v := bxCPeek(mut st, f, BX_SPEC, 0)
    if len(v) == 0 {
        return []int{}
    }
    if v[0] <= 0 {
        return []int{v[0], 0, 0, 0, 0}
    }
    r := bxCPeek(mut st, f, BX_SPRND, 0)
    if len(r) == 0 {
        return []int{}
    }
    return []int{v[0], r[0], r[1], r[2], v[1]}
}

// 要約にある関数の本体を、要約の処理の前の本体（BX_SPPRE）にする（読めなければ今の本体のまま）
func spSumBody(st mut St, f FnRef, t CkTab) {
    v := bxCPeek(mut st, f, BX_SPPRE, 0)
    if len(v) == 0 {
        return
    }
    p := bxCBodyV(mut st, v, t)
    if len(p) > 1 {
        mvUnpack(mut st, f, p)
    }
}

// 枠の割り当ての表: recs = [組, callee, n, (位置, 種類, 値) × n, 呼び出し点の数, 同数の比べの値, 枠を得たか]…・ix = 鍵のハッシュ → recsの位置（開番地）。
// 同数の比べの値 = 定数の組のハッシュ（大域は記録の番地でなく安定な鍵 — 番地は発見の順に依る）
type SpPre struct {
    recs []int
    ix map[int]int
}

func spPreHash(gr int, key []int, salt int) int {
    mut h := ckM1(CK_S1, gr)
    for w <- key {
        h = ckM1(h, w)
    }
    return ckM1(h, salt)
}

// 表の (組, 鍵) の位置（無ければ -1）
func spPreFind(pre SpPre, gr int, key []int) int {
    mut salt := 0
    while true {
        at := pre.ix[spPreHash(gr, key, salt)]
        if at == nil {
            return -1
        }
        if spPreSame(pre.recs, at, gr, key) {
            return at
        }
        salt += 1
    }
    return -1
}

func spPreSame(recs []int, at int, gr int, key []int) bool {
    if recs[at] != gr || recs[at + 1] != key[0] || recs[at + 2] != key[1] {
        return false
    }
    for k <- iter.Range(0, 3 * key[1]) {
        if recs[at + 3 + k] != key[2 + k] {
            return false
        }
    }
    return true
}


// 元の関数（作業列 work の [関数, 深さ, 組]…）の呼び出し点を数えて、組 × callee ごとに多い順の SP_PER 個に枠を与える
func spPreCount(st mut St, work mut []int, fl []int, finfo []int, fsens []int) SpPre {
    mut recs := mut []int{}
    mut ix := mut map[int]int{}
    mut w := 0
    while w < len(work) {
        cf := FnRef(work[w])
        gr := work[w + 2]
        w += 3
        mut defs := []int{}
        mut b := irFnBHead(mut st, cf)
        while b != -1 {
            mut ins := if irBlkTerm(mut st, b) == TmExit { InsRef(-1) } else { irBlkIHead(mut st, b) }
            while ins != -1 {
                g := if irInsOp(mut st, ins) == OpCall { irInsFn(mut st, ins) } else { FnRef(-1) }
                gi := if int(g) >= 0 && g != cf { spFind(fl, int(g)) } else { -1 }
                mask := if int(g) < 0 || g == cf { -1 } else if gi >= 0 { finfo[gi] } else { spInfo(mut st, g) }
                sens := if gi >= 0 { fsens[gi] } else { mask }
                if mask > 0 && sens > 0 {
                    if len(defs) == 0 {
                        st.fn = cf
                        defs = spDefs(mut st, cf)
                    }
                    key := spKey(mut st, defs, g, ins, mask)
                    if len(key) > 2 && spTrig(key, sens) {
                        mut salt := 0
                        mut done := false
                        while !done {
                            h := spPreHash(gr, key, salt)
                            at := ix[h]
                            if at == nil {
                                ix[h] = len(recs)
                                recs = append(recs, gr)
                                for v <- key {
                                    recs = append(recs, v)
                                }
                                recs = append(recs, 1)
                                recs = append(recs, spTie(mut st, key))
                                recs = append(recs, 0)
                                done = true
                            } else {
                                mut same := recs[at] == gr && recs[at + 1] == key[0] && recs[at + 2] == key[1]
                                for k <- iter.Range(0, 3 * key[1]) {
                                    if same && recs[at + 3 + k] != key[2 + k] {
                                        same = false
                                    }
                                }
                                if same {
                                    recs[at + 3 + 3 * key[1]] += 1
                                    done = true
                                } else {
                                    salt += 1
                                }
                            }
                        }
                    }
                }
                ins = irInsNext(mut st, ins)
            }
            b = irBlkNext(mut st, b)
        }
    }
    // 組 × callee ごとに、数の多い順（同数は鍵の値の順）の先頭 SP_PER 個に枠
    mut offs := mut []int{}
    mut q := 0
    while q < len(recs) {
        offs = append(offs, q)
        q += 6 + 3 * recs[q + 2]
    }
    of := freeze(offs)
    rf := freeze(recs)
    ord := sort.Order(len(of), (a, b) => spPreLess(rf, of[a], of[b]))
    mut adm := mut []int{}
    xFill(mut adm, len(of), 0)
    mut run := 0
    for k <- iter.Range(0, len(ord)) {
        at := of[ord[k]]
        if k > 0 {
            pv := of[ord[k - 1]]
            run = if rf[pv] == rf[at] && rf[pv + 1] == rf[at + 1] { run + 1 } else { 0 }
        }
        if run < SP_PER {
            adm[ord[k]] = 1
        }
    }
    mut out := mut []int{}
    for k <- iter.Range(0, len(of)) {
        at := of[k]
        n := rf[at + 2]
        for j <- iter.Range(0, 5 + 3 * n) {
            out = append(out, rf[at + j])
        }
        out = append(out, adm[k])
    }
    return SpPre{recs: freeze(out), ix: freeze(ix)}
}

// 枠の順: 組・callee の昇順 → 呼び出し点の数の降順 → 定数の組（数・位置・種類・値）の昇順
func spPreLess(r []int, a int, b int) bool {
    if r[a] != r[b] {
        return r[a] < r[b]
    }
    if r[a + 1] != r[b + 1] {
        return r[a + 1] < r[b + 1]
    }
    ca := r[a + 3 + 3 * r[a + 2]]
    cb := r[b + 3 + 3 * r[b + 2]]
    if ca != cb {
        return ca > cb
    }
    return r[a + 4 + 3 * r[a + 2]] < r[b + 4 + 3 * r[b + 2]]
}

// 定数の組の安定なハッシュ（大域の値は安定な鍵のハッシュに替える）
func spTie(st mut St, key []int) int {
    mut h := ckM1(CK_S2, key[1])
    for j <- iter.Range(0, key[1]) {
        h = ckM1(h, key[2 + 3 * j])
        h = ckM1(h, key[3 + 3 * j])
        if key[3 + 3 * j] == SP_K_GLOB {
            mut gh := mut []int{}
            ckBytesTo(mut gh, xGlobKey(mut st, key[4 + 3 * j]))
            h = ckM1(h, gh[0])
        } else {
            h = ckM1(h, key[4 + 3 * j])
        }
    }
    return h
}

// バイト列の辞書順
func spBytesLess(a []byte, b []byte) bool {
    mut i := 0
    while i < len(a) && i < len(b) {
        if a[i] != b[i] {
            return a[i] < b[i]
        }
        i += 1
    }
    return len(a) < len(b)
}

// f の中の残さない複製の呼び出しを元の callee へ戻す
func spRedirect(st mut St, f FnRef, cl []int, keep []int, og []int) {
    mut b := irFnBHead(mut st, f)
    while b != -1 {
        mut i := irBlkIHead(mut st, b)
        while i != -1 {
            if irInsOp(mut st, i) == OpCall {
                x := spFind(cl, irInsA(mut st, i))
                if x >= 0 && keep[x] == 0 {
                    irSetInsA(mut st, i, og[x])
                }
            }
            i = irInsNext(mut st, i)
        }
        b = irBlkNext(mut st, b)
    }
}

// fの中の複製（clones）の呼び出しのうち、複製がSP_INL以下でコピーできる形（irinlのilShape = 1）ならコピーする
func spInline(st mut St, f FnRef, clones []int) {
    st.fn = f
    mut blks := mut []int{}
    mut b := irFnBHead(mut st, f)
    while b != -1 {
        blks = append(blks, int(b))
        b = irBlkNext(mut st, b)
    }
    mut any := false
    for k <- iter.Range(0, len(blks)) {
        mut blk := BlkRef(blks[k])
        mut ins := if irBlkTerm(mut st, blk) == TmExit { InsRef(-1) } else { irBlkIHead(mut st, blk) }
        while ins != -1 {
            nx := irInsNext(mut st, ins)
            if irInsOp(mut st, ins) == OpCall {
                g := irInsFn(mut st, ins)
                if g != f && spFind(clones, int(g)) >= 0 {
                    n := ilSize(mut st, g)
                    if spHot(mut st, g) <= SP_KEEP && ilShape(mut st, g, n) == 1 {
                        blk = ilCall(mut st, f, blk, ins, g)
                        any = true
                    }
                }
            }
            ins = nx
        }
    }
    if any {
        optFunc(mut st, f)
    }
}

// f の値 → 定義の命令の表
func spDefs(st mut St, f FnRef) []int {
    mut d := mut []int{}
    xFill(mut d, irFnNVal(mut st, f), -1)
    mut b := irFnBHead(mut st, f)
    while b != -1 {
        mut i := irBlkIHead(mut st, b)
        while i != -1 {
            r := irInsRes(mut st, i)
            if r >= 0 && r < len(d) {
                d[r] = int(i)
            }
            i = irInsNext(mut st, i)
        }
        b = irBlkNext(mut st, b)
    }
    return freeze(d)
}

// gの特化の資格: -1 = 対象外（形・大きさ）・他 = 定数が効く仮引数のマーク（ビットk = 仮引数kが比較・算術・gep・itop / ptoi・load・
// 呼び出しの引数のどれかで使われる — k < 62）。1 回の走査で、命令が SP_MAX を超えたら打ち切る（大きい callee を呼び出し点ごとに歩かない）
func spInfo(st mut St, g FnRef) int {
    if irFnBHead(mut st, g) == -1 || xIsEntry(mut st, g) {
        return -1
    }
    nm := desugar.StrRef(irFnName(mut st, g))
    if (slen(mut st, nm) > 3 && sat(mut st, nm, 0) == 114 && sat(mut st, nm, 1) == 116 && sat(mut st, nm, 2) == 46) || strIs(mut st, nm, "std/strings.validPrefix") || strIs(mut st, nm, "std/utf8.Check") || strIs(mut st, nm, "std/utf8.boundary") {
        return -1
    }
    np := lenL(mut st, desugar.ListRef(irFnPtys(mut st, g)))
    mut n := 0
    mut mask := 0
    mut b := irFnBHead(mut st, g)
    while b != -1 {
        mut i := irBlkIHead(mut st, b)
        while i != -1 {
            op := irInsOp(mut st, i)
            if op != OpDead {
                n += 1
                if n > SP_MAX {
                    return -1
                }
            }
            if op == OpTrapI || op == OpTSwitch || op == OpTStart || op == OpAtomic || op == OpClone || op == OpUnwind || op == OpArea || op == OpScanB || op == OpCrcFold || op == OpPMem || op == OpPArith || op == OpCallI {
                return -1
            }
            if op == OpCmp || op == OpBin {
                mask = mask | spBit(irInsB(mut st, i), np) | spBit(irInsC(mut st, i), np)
            } else if op == OpGepW || op == OpGepB {
                mask = mask | spBit(irInsA(mut st, i), np) | spBit(irInsB(mut st, i), np)
            } else if op == OpItop || op == OpPtoi || op == OpLoad || isNarrowLd(op) {
                mask = mask | spBit(irInsA(mut st, i), np)
            } else if op == OpCall {
                args := irInsB(mut st, i)
                for a <- iter.Range(0, xLen(mut st, args)) {
                    mask = mask | spBit(xAt(mut st, args, a), np)
                }
            }
            i = irInsNext(mut st, i)
        }
        b = irBlkNext(mut st, b)
    }
    return mask
}

// 鍵keyと同じcallee・同じ定数の位置の組の複製が一度捨てられたか（表の記録の複製のフィールドが -1 — 定数の値が違っても畳み方は同じ
// 見込み・試す費用を払わない。位置の組が違えば別 — hasPrefixAt の at だけの定数と p まで定数とは畳め方が違う）
func spHopeless(tab []int, gr int, key []int) bool {
    mut t := 0
    while t < len(tab) {
        n := tab[t + 2]
        if tab[t] == gr && tab[t + 1] == key[0] && n == key[1] && tab[t + 3 + 3 * n] == -1 {
            mut same := true
            for j <- iter.Range(0, n) {
                if tab[t + 3 + 3 * j] != key[2 + 3 * j] {
                    same = false
                }
            }
            if same {
                return true
            }
        }
        t += 4 + 3 * n
    }
    return false
}

// 鍵の定数の仮引数のどれかが引き金のマークsensに当たるか
func spTrig(key []int, sens int) bool {
    for j <- iter.Range(0, key[1]) {
        k := key[2 + 3 * j]
        if k < 62 && (sens >> k) & 1 == 1 {
            return true
        }
    }
    return false
}

// gの仮引数のうち比較に効くもののマーク（比較の被演算子・比較の被演算子を作る算術の被演算子）
func spSens(st mut St, g FnRef) int {
    np := lenL(mut st, desugar.ListRef(irFnPtys(mut st, g)))
    mut mk := mut []int{}
    xFill(mut mk, irFnNVal(mut st, g), 0)
    for r <- iter.Range(0, 2) {
        mut b := irFnBHead(mut st, g)
        while b != -1 {
            mut i := irBlkIHead(mut st, b)
            while i != -1 {
                op := irInsOp(mut st, i)
                x := irInsB(mut st, i)
                y := irInsC(mut st, i)
                if op == OpCmp || (op == OpBin && irInsRes(mut st, i) >= 0 && mk[irInsRes(mut st, i)] == 1) {
                    if x >= 0 && x < len(mk) {
                        mk[x] = 1
                    }
                    if y >= 0 && y < len(mk) {
                        mk[y] = 1
                    }
                }
                i = irInsNext(mut st, i)
            }
            b = irBlkNext(mut st, b)
        }
    }
    mut m := 0
    for k <- iter.Range(0, np) {
        if k < 62 && k < len(mk) && mk[k] == 1 {
            m = m | (1 << k)
        }
    }
    return m
}

// gの仮引数のうち、比較に効くcalleeの仮引数（fs — flと同じ並びのマーク）へそのまま渡るもののマーク
func spRelayMask(st mut St, g FnRef, fl []int, fs []int) int {
    np := lenL(mut st, desugar.ListRef(irFnPtys(mut st, g)))
    mut m := 0
    mut b := irFnBHead(mut st, g)
    while b != -1 {
        mut i := irBlkIHead(mut st, b)
        while i != -1 {
            if irInsOp(mut st, i) == OpCall {
                h := spFind(fl, irInsA(mut st, i))
                if h >= 0 && fs[h] > 0 {
                    args := irInsB(mut st, i)
                    for a <- iter.Range(0, xLen(mut st, args)) {
                        if a < 62 && (fs[h] >> a) & 1 == 1 {
                            m = m | spBit(xAt(mut st, args, a), np)
                        }
                    }
                }
            }
            i = irInsNext(mut st, i)
        }
        b = irBlkNext(mut st, b)
    }
    return m
}

// 値vが仮引数（v < np・62未満）ならそのマーク
func spBit(v int, np int) int {
    return if v >= 0 && v < np && v < 62 { 1 << v } else { 0 }
}

// 昇順の列 xs の x の位置（無ければ -1）
func spFind(xs []int, x int) int {
    mut lo := 0
    mut hi := len(xs)
    while lo < hi {
        m := (lo + hi) / 2
        if xs[m] < x {
            lo = m + 1
        } else {
            hi = m
        }
    }
    return if lo < len(xs) && xs[lo] == x { lo } else { -1 }
}

// 呼び手の値 v の定数の形: (種類, 値)・種類 -1 = 定数でない。ptoi / itop は透かす
func spConst(st mut St, defs []int, v int) (int, int) {
    mut x := v
    mut k := 0
    while k < 3 {
        if x < 0 || x >= len(defs) || defs[x] < 0 {
            return -1, 0
        }
        i := InsRef(defs[x])
        op := irInsOp(mut st, i)
        if op == OpConst {
            return SP_K_INT, irInsA(mut st, i)
        }
        if op == OpGlobal {
            return SP_K_GLOB, irInsA(mut st, i)
        }
        if op != OpPtoi && op != OpItop {
            return -1, 0
        }
        x = irInsA(mut st, i)
        k += 1
    }
    return -1, 0
}

// 呼び出しins（callee g・資格のマークmask）の特化の鍵 [g, n, (位置, 種類, 値) × n]（定数の効く仮引数が無ければ長さ2）
func spKey(st mut St, defs []int, g FnRef, ins InsRef, mask int) []int {
    mut key := mut []int{}
    key = append(key, int(g))
    key = append(key, 0)
    args := irInsB(mut st, ins)
    na := xLen(mut st, args)
    for k <- iter.Range(0, na) {
        if k < 62 && (mask >> k) & 1 == 1 {
            ck, cv := spConst(mut st, defs, xAt(mut st, args, k))
            if ck >= 0 {
                key = append(key, k)
                key = append(key, ck)
                key = append(key, cv)
                key[1] = key[1] + 1
            }
        }
    }
    return freeze(key)
}

// gの呼び出しの付け替え m（[序数, 元の callee, 複製]…・序数の昇順 — 作業列の歩きと同じ: exitで終わるブロックの命令は数えない）の
// 行き先を、which = 1 なら元の callee へ・2 なら複製へ置く
func spSetCalls(st mut St, g FnRef, m []int, which int) {
    mut ordn := 0
    mut q := 0
    mut b := irFnBHead(mut st, g)
    while b != -1 && q < len(m) {
        mut ins := if irBlkTerm(mut st, b) == TmExit { InsRef(-1) } else { irBlkIHead(mut st, b) }
        while ins != -1 && q < len(m) {
            if m[q] == ordn {
                irSetInsA(mut st, ins, m[q + which])
                q += 3
            }
            ins = irInsNext(mut st, ins)
            ordn += 1
        }
        b = irBlkNext(mut st, b)
    }
}

// gの複製を作り、keyの仮引数を定数に置き換えて畳む。畳んだ後が元より小さくなければ捨てて -1。複製は関数のチェーンの末尾に積む
func spClone(st mut St, g FnRef, cf FnRef, key []int, gr int, bt CkTab) FnRef {
    // 本体のコピー: 詰めて（元の本体は転送のマークで潰れる）元へも複製へも積み直す。本体を下ろさなかった関数は要約の処理の前の本体（BX_SPPRE）から
    mut pk := []int{}
    if irFnBHead(mut st, g) == -1 && bxCSelf(mut st, g) >= 0 {
        v := bxCPeek(mut st, g, BX_SPPRE, 0)
        pk = if len(v) > 0 { bxCBodyV(mut st, v, bt) } else { []int{-1} }
        if len(pk) <= 1 {
            panic(InvariantBroken{})
        }
    } else {
        pk = mvPack(mut st, g, false)
        mvUnpack(mut st, g, pk)
    }
    c := FnRef(recN(mut st, FSZ))
    for k <- iter.Range(0, FSZ) {
        desugar.HeapSet(mut st.d, int(c) + k, desugar.HeapGet(mut st.d, int(g) + k))
    }
    irSetFnName(mut st, c, int(strCat(mut st, strCat(mut st, desugar.StrRef(irFnName(mut st, g)), strLit(mut st, "$s")), decimal(mut st, int(c)))))
    irSetFnExport(mut st, c, 0)
    // 安定な鍵の材料: 複製 = (組, callee, 定数の組) — 名前の `$s<番地>` はヒープの並びに依る。組が違えば同じ (callee, 定数の組) の別の複製
    table.Push(mut st.sk, SK_SPEC)
    table.Push(mut st.sk, 2 + len(key))
    table.Push(mut st.sk, int(c))
    table.Push(mut st.sk, gr)
    for w <- key {
        table.Push(mut st.sk, w)
    }
    mvUnpack(mut st, c, pk)
    // 入口の頭に定数を足し、仮引数の値をそれへ付け替える（opt の別名 → 番号の詰め直しで被演算子を書き換える）
    st.fn = c
    entry := irFnBHead(mut st, c)
    n := key[1]
    mut vs := mut []int{}
    for j <- iter.Range(0, n) {
        ck := key[3 + 3 * j]
        cv := key[4 + 3 * j]
        r := newValueIn(mut st, c)
        if ck == SP_K_INT {
            spLinkHead(mut st, entry, mkInst(mut st, r, OpConst, cv, 0, 0))
            vs = append(vs, r)
        } else {
            ga := newValueIn(mut st, c)
            // チェーンの頭へ逆順に足す（globaladdr → ptoiの順に並ぶ）
            spLinkHead(mut st, entry, mkInst(mut st, r, OpPtoi, ga, 0, 0))
            spLinkHead(mut st, entry, mkInst(mut st, ga, OpGlobal, cv, 0, 0))
            vs = append(vs, r)
        }
    }
    optReset(mut st, irFnNVal(mut st, c), irFnNBlk(mut st, c))
    for j <- iter.Range(0, n) {
        owSet(mut st, key[2 + 3 * j], OW_AL, vs[j])
    }
    optRenumber(mut st, c)
    // 畳む（optimizeSsa の関数ごとの列の gvn 以降 + 前後に opt の畳み）
    optFunc(mut st, c)
    gvnFunc(mut st, c)
    hdrFunc(mut st, c)
    unrollFunc(mut st, c)
    bceFunc(mut st, c)
    licmFunc(mut st, c)
    depthFlowFunc(mut st, c)
    if spFoldRo(mut st, c) {
        bceFunc(mut st, c)
    }
    optFunc(mut st, c)
    // 残す = コピーできる大きさ（熱い命令SP_INL以下）まで畳めたもの。HasPrefixのように畳める中身がcalleeの側にある中継ぎの複製も、それ自身が小さければ
    // 残る（内側の複製をコピーした後の大きさはSP_KEEPで見る）
    if spHot(mut st, c) > SP_INL {
        return -1
    }
    // チェーンの末尾へ（関数の記録は番地の昇順 — x86のxIndexが二分探索で引く）
    irSetFnNext(mut st, c, -1)
    irSetFnNext(mut st, st.ftail, c)
    st.ftail = c
    return c
}

// f の熱い命令の数（exit で終わるブロックを数えない）
func spHot(st mut St, f FnRef) int {
    mut n := 0
    mut b := irFnBHead(mut st, f)
    while b != -1 {
        if irBlkTerm(mut st, b) != TmExit {
            mut i := irBlkIHead(mut st, b)
            while i != -1 {
                if irInsOp(mut st, i) != OpDead {
                    n += 1
                }
                i = irInsNext(mut st, i)
            }
        }
        b = irBlkNext(mut st, b)
    }
    return n
}

// 文字列リテラル（str.N — rodata・書かれない）の定数の位置の load8 を定数のバイトに畳む（特化で番地と添字が定数になった読み —
// `p[0]` の ':'）。番地 = gep.byte(リテラルの番地, 定数)・リテラルの番地 = globaladdr か ptoi / itop を通したもの。畳んだら true
func spFoldRo(st mut St, c FnRef) bool {
    defs := spDefs(mut st, c)
    mut any := false
    mut b := irFnBHead(mut st, c)
    while b != -1 {
        mut i := irBlkIHead(mut st, b)
        while i != -1 {
            if irInsOp(mut st, i) == OpLoad8 {
                a := irInsA(mut st, i)
                d := if a >= 0 && a < len(defs) { defs[a] } else { -1 }
                if d >= 0 && irInsOp(mut st, InsRef(d)) == OpGepB {
                    gk, gv := spConst(mut st, defs, irInsA(mut st, InsRef(d)))
                    ik, iv := spConst(mut st, defs, irInsB(mut st, InsRef(d)))
                    at := iv + irInsB(mut st, i)
                    if gk == SP_K_GLOB && ik == SP_K_INT && at >= 0 && spStrGlobal(mut st, gv) && at < 8 * desugar.HeapGet(mut st.d, gv + G_WORDS) {
                        ws := desugar.HeapGet(mut st.d, gv + G_INIT)
                        word := desugar.HeapGet(mut st.d, ws + 1 + at / 8)
                        irSetInsOp(mut st, i, OpConst)
                        irSetInsA(mut st, i, (word >> (8 * (at % 8))) & 255)
                        irSetInsB(mut st, i, 0)
                        irSetInsC(mut st, i, 0)
                        any = true
                    }
                }
            }
            i = irInsNext(mut st, i)
        }
        b = irBlkNext(mut st, b)
    }
    return any
}

// グローバル g が文字列リテラルの rodata（名前 str.N・初期値あり）か
func spStrGlobal(st mut St, g int) bool {
    nm := desugar.StrRef(desugar.HeapGet(mut st.d, g + G_NAME))
    return desugar.HeapGet(mut st.d, g + G_INIT) >= 0 && slen(mut st, nm) > 4 && sat(mut st, nm, 0) == 115 && sat(mut st, nm, 1) == 116 && sat(mut st, nm, 2) == 114 && sat(mut st, nm, 3) == 46
}

// 命令rをブロックbの命令のチェーンの頭へつなぐ
func spLinkHead(st mut St, b BlkRef, r InsRef) {
    h := irBlkIHead(mut st, b)
    irSetInsNext(mut st, r, h)
    irSetBlkIHead(mut st, b, r)
    if h == -1 {
        irSetBlkITail(mut st, b, r)
    }
}
