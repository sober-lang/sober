package lower

// SLPのまとめ（slp.sober）の検査一式: IRを手で組んで直に見る（`cd src/compiler && ../../bin/sober test lower`）。
// 出力の検査（examples/opt_slp）で見えない形 — 16 Bのstoreを遅い側へ寄せる間に早い側のワードを読むloadがある形（Soberのプログラムでは
// 直線の中の読み直しが store の値に転送されて残らない）— をここで固定する

import "desugar"

// `f(p ptr, a, c)` の 1 ブロックに `p[0] = p[2] + a * c; [kind 1: t = load p[0]]; p[1] = p[3] + (t か a) * c` を組んで SLP を掛け、
// 残った16 Bのstoreの数を返す（1 = まとめた・0 = まとめない）
func slT(kind int) int {
    mut st := St{}
    initScalars(mut st)
    desugar.HeapPush(mut st.d, 0)
    pt := listN(mut st, 3)
    desugar.HeapSet(mut st.d, pt + 1, TyPtr)
    desugar.HeapSet(mut st.d, pt + 2, TyI64)
    desugar.HeapSet(mut st.d, pt + 3, TyI64)
    f := addFunc(mut st, 0, desugar.ListRef(pt), -1)
    st.fn = f
    entry := newBlock(mut st)
    st.cur = entry
    v0 := push(mut st, true, OpBin, BFAdd, load(mut st, 0, 2), push(mut st, true, OpBin, BFMul, 1, 2))
    store(mut st, 0, 0, v0)
    t := if kind == 1 { load(mut st, 0, 0) } else { 1 }
    v1 := push(mut st, true, OpBin, BFAdd, load(mut st, 0, 3), push(mut st, true, OpBin, BFMul, t, 2))
    store(mut st, 0, 1, v1)
    ret(mut st, -1)
    slpFunc(mut st, f)
    mut n := 0
    mut k := irBlkIHead(mut st, entry)
    while k != -1 {
        if irInsOp(mut st, k) == OpPMem && irInsRes(mut st, k) < 0 {
            n += 1
        }
        k = irInsNext(mut st, k)
    }
    return n
}

func TestSlpPairRead() {
    // 0: 間に読みが無ければまとめる（16 Bのload p[2..3]・pack (a, a) でなくsplat a・pmul・padd・16 Bのstore）
    assert(slT(0) == 1)
    // 1: 間に早い側のワードp[0] の読みがあればまとめない（局所の検査と並びの照合の両方が止める — ミュータントは両方を外すとここで落ちる）
    assert(slT(1) == 0)
}
