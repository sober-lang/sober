package lower

// switch（src/stage1/lower_switch.zigのコピー）: subjectの評価、caseの順次照合（定数・束縛・`_`・型パターン）、分岐の合流

import "diag"
import "desugar"
import "ast"
import "std/iter"

// package pk のトップレベル名（const・関数・型・union の variant）か
func hasTopName(st mut St, pk int, name desugar.StrRef) bool {
    return desugar.HasTopName(mut st.d, pk, name)
}

// パターン位置の裸の識別子が束縛か
func isBindingPattern(st mut St, name desugar.StrRef) bool {
    return lookup(mut st, name) < 0 && !strIs(mut st, name, "true") && !strIs(mut st, name, "false") && !hasTopName(mut st, st.curPkg, name)
}

func hasWildcard(st mut St, alts desugar.ListRef) bool {
    for i <- iter.Range(0, lenL(mut st, alts)) {
        a := latN(mut st, alts, i)
        if kindN(mut st, a) == ast.EIdent && strIs(mut st, sA(nodeOf(mut st, a)), "_") {
            return true
        }
    }
    return false
}

// パターンの選択が裸の束縛 1 つか
func isBindAlt(st mut St, alts desugar.ListRef) bool {
    if lenL(mut st, alts) != 1 {
        return false
    }
    a := latN(mut st, alts, 0)
    return kindN(mut st, a) == ast.EIdent && isBindingPattern(mut st, sA(nodeOf(mut st, a)))
}

// 型パターンの名前 pn（"V" か "ref.V"）が union の型 ut の何番目の variant か（でなければ -1）。名前は desugar.ResolveVariant
// （checkと同じ解決 — 修飾・公開の検査つき）で引き、utの宣言（errorなら全ラベルのunion）のvariantであることを確認する
func patVariant(st mut St, pn desugar.StrRef, ut int) int {
    if !isTag(mut st, ut, TUnion) {
        return -1
    }
    r := desugar.ResolveVariant(mut st.d, st.curPkg, pn)
    if r.kind != desugar.TopVariant {
        return -1
    }
    d := desugar.HeapGet(mut st.d, desugar.HeapGet(mut st.d, ut + 1) + SI_DECL)
    ud := if d == -1 { desugar.ERRS } else { d }
    return if r.idx == ud { r.sub } else { -1 }
}

// 束縛のチェーン = [head, tail]、項 = [next, name, 型, 値]
func bindAdd(st mut St, bs int, name int, t int, v int) {
    en := rec4(mut st, -1, name, t, v)
    if desugar.HeapGet(mut st.d, bs + 1) < 0 {
        desugar.HeapSet(mut st.d, bs, en)
    } else {
        desugar.HeapSet(mut st.d, desugar.HeapGet(mut st.d, bs + 1), en)
    }
    desugar.HeapSet(mut st.d, bs + 1, en)
}

// subject を 1 回だけ評価し、case を上から順に照合する（不一致は次の case へ）。default 無しで全部外れたら値はゼロ
func switchExpr(st mut St, sw desugar.NodeRef) (Val, error?) {
    at := sw
    cw := st.swW - 1
    st.swW = 0
    subjects := lA(nodeOf(mut st, sw))
    cases := lB(nodeOf(mut st, sw))
    dflt := nC(nodeOf(mut st, sw))
    ns := lenL(mut st, subjects)
    mut subj := 0
    if ns == 1 {
        subj = evalMulti(mut st, latN(mut st, subjects, 0))?
    } else {
        subj = listN(mut st, ns * 2)
        desugar.HeapSet(mut st.d, subj, ns)
        mut i := 0
        while i < ns {
            x := expr(mut st, latN(mut st, subjects, i))?
            if isTag(mut st, x.t, TNever) {
                return Val{t: x.t, v: 0}, nil
            }
            desugar.HeapSet(mut st.d, subj + 1 + i * 2, x.t)
            desugar.HeapSet(mut st.d, subj + 2 + i * 2, x.v)
            i += 1
        }
    }
    if subj < 0 {
        return Val{t: tNever(mut st), v: 0}, nil
    }
    nsub := desugar.HeapGet(mut st.d, subj)
    if ns > 0 && nsub == 0 {
        return Val{}, diag.Mismatch{at: posOf(mut st, at)}
    }
    if st.traceErrs && nsub == 1 && isErr(mut st, desugar.HeapGet(mut st.d, subj + 1)) {
        traceSwitch(mut st, sw, desugar.HeapGet(mut st.d, subj + 2))
    }
    nc := lenL(mut st, cases)
    ends := endsNew(mut st, nc + 1)
    nilSw := nilCaseL(mut st, sw)
    mut t := -1
    for ci <- iter.Range(0, nc) {
        c := latN(mut st, cases, ci)
        pats := lA(nodeOf(mut st, c))
        np := lenL(mut st, pats)
        wantp := if nsub > 1 { nsub } else { 1 }
        if np != wantp {
            return Val{}, diag.Mismatch{at: posOf(mut st, c)}
        }
        bs := rec4(mut st, -1, -1, 0, 0)
        nx := newBlock(mut st)
        mut i := 0
        while i < np && cur(mut st) != -1 {
            if nsub == 0 {
                matchPattern(mut st, latN(mut st, pats, i), -1, 0, nx, bs)?
            } else {
                matchPattern(mut st, latN(mut st, pats, i), desugar.HeapGet(mut st.d, subj + 1 + i * 2), desugar.HeapGet(mut st.d, subj + 2 + i * 2), nx, bs)?
            }
            i += 1
        }
        pushScope(mut st)
        mut b := desugar.HeapGet(mut st.d, bs)
        while b >= 0 {
            declareNew(mut st, hgetS(mut st, b + 1), LVal, desugar.HeapGet(mut st.d, b + 2), desugar.HeapGet(mut st.d, b + 3), c)?
            b = desugar.HeapGet(mut st.d, b)
        }
        mut av := armTail(mut st, lA(nodeOf(mut st, nB(nodeOf(mut st, c)))))?
        popScope(mut st)
        // 期待型がbyte / named scalar なら、末尾が型なしの定数の分岐をそれに割り当てる（if式の分岐と同じ規則）
        if cw >= 0 && cur(mut st) != -1 && armUntyped(mut st, nB(nodeOf(mut st, c))) && armFits(mut st, cw, av.t, nB(nodeOf(mut st, c))) {
            av = Val{t: cw, v: av.v}
        }
        t = joinTypeN(mut st, t, if cur(mut st) == -1 { tNever(mut st) } else { av.t }, nilSw, c)?
        if cur(mut st) != -1 {
            endsAdd(mut st, ends, cur(mut st), av.t, av.v)
        }
        setCur(mut st, nx)
    }
    // error の switch（単一の subject）は網羅を要求しない — 網羅は analyzer が導出集合で判定し（language.md 13 節・error 網羅 analyzer A5）、
    // buildはanalyzerを走らせないので、覆っていないラベルが来たらexit 101（決定E4-B — 下の外れの分岐）
    // （リンク集合の全ラベルを覆うerrorのswitchは今までどおり — 外れの分岐はゼロ値のまま、IRは変わらない）
    mut errGap := false
    isErrSw := nsub == 1 && isErr(mut st, desugar.HeapGet(mut st.d, subj + 1))
    // 網羅を見る subject の型（error の switch はリンク集合の全ラベルの union）
    cty := if isErrSw { desugar.HeapGet(mut st.d, errsInfo(mut st) + SI_TY) } else if nsub == 1 && ns <= 1 { desugar.HeapGet(mut st.d, subj + 1) } else { tNone(mut st) }
    if isErrSw && dflt == -1 {
        errGap = checkCover(mut st, sw, cty, t) != nil
    } else if ns <= 1 && dflt == -1 {
        checkCover(mut st, sw, cty, t)?
    }
    if dflt != -1 {
        mut dv := armValue(mut st, lA(nodeOf(mut st, dflt)))?
        if cw >= 0 && cur(mut st) != -1 && armUntyped(mut st, dflt) && armFits(mut st, cw, dv.t, dflt) {
            dv = Val{t: cw, v: dv.v}
        }
        t = joinTypeN(mut st, t, if cur(mut st) == -1 { tNever(mut st) } else { dv.t }, nilSw, at)?
        if cur(mut st) != -1 {
            endsAdd(mut st, ends, cur(mut st), dv.t, dv.v)
        }
    } else if errGap {
        // 覆っていないラベル（到達しない分岐 — コアのunreachと同じpanic）
        if cur(mut st) != -1 {
            panicSite(mut st, PK_UNREACH, at)
        }
    } else if t >= 0 && isTag(mut st, t, TNever) && switchCovers(mut st, sw, cty) {
        // 分岐が全部戻らず（return等）、分岐が値を全部覆う: 外れには来ない（コアのunreachと同じpanic — 外れのブロックを終端なしで残さない）
        if cur(mut st) != -1 {
            panicSite(mut st, PK_UNREACH, at)
        }
    } else {
        // 外れの経路は「何もせず抜ける」— 分岐が全部Neverでも、覆っていなければ外れはunitで後ろへ続く（全部Neverを外れにも反映すると
        // switch の後ろを落とし、外れのブロックが終端なしで残る — Zig 版の時代からの穴。B-3 の検証器が拾った）
        rt := if t < 0 || isTag(mut st, t, TNever) { tNone(mut st) } else { t }
        t = joinType(mut st, t, rt, at)?
        zv := if isScalar(mut st, rt) { iconst(mut st, 0) } else if isAggregate(mut st, rt) { newAgg(mut st, rt) } else { 0 }
        endsAdd(mut st, ends, cur(mut st), rt, zv)
    }
    jt, jv := joinArms(mut st, ends, if t < 0 { tNone(mut st) } else { t })
    return Val{t: jt, v: jv}, nil
}

// 網羅の規則（check に揃える）: union の型パターンの switch は全 variant を覆うか `_` / default を持つ。
// それ以外で default も全域の case（`_`・束縛）も無い switch は、値が unit でなければ拒否
func checkCover(st mut St, sw desugar.NodeRef, sty int, t int) error? {
    if switchCovers(mut st, sw, sty) {
        return nil
    }
    if isTag(mut st, sty, TUnion) && typePatRows(mut st, sw) > 0 {
        // 網羅漏れは特定する（落ちているvariant — checkと同じdesugar.MissingVariant）
        ud := desugar.HeapGet(mut st.d, desugar.HeapGet(mut st.d, sty + 1) + SI_DECL)
        if ud == -1 {
            return diag.Mismatch{at: posOf(mut st, sw)}
        }
        mut ps := mut []int{}
        cases := lB(nodeOf(mut st, sw))
        for ci <- iter.Range(0, lenL(mut st, cases)) {
            pats := lA(nodeOf(mut st, latN(mut st, cases, ci)))
            for i <- iter.Range(0, lenL(mut st, pats)) {
                ps = append(ps, latI(mut st, pats, i))
            }
        }
        // 特定するのは同じpackageのunionだけ（checkと同じ — 別packageの宣言はソースが引けない場合がある）
        mv := if desugar.HeapGet(mut st.d, desugar.HeapGet(mut st.d, sty + 1) + SI_PKG) == st.curPkg { desugar.MissingVariant(mut st.d, st.curPkg, desugar.NodeRef(ud), freeze(ps)) } else { desugar.NodeRef(-1) }
        return diag.NonExhaustive{at: posOf(mut st, sw), missing: if mv == desugar.NodeRef(-1) { diag.None() } else { posOf(mut st, mv) }}
    }
    if t < 0 {
        return nil
    }
    if !isTag(mut st, t, TNone) && !isTag(mut st, t, TNever) {
        return diag.Mismatch{at: posOf(mut st, sw)}
    }
    return nil
}

// 型パターン1つだけの分岐の数
func typePatRows(st mut St, sw desugar.NodeRef) int {
    cases := lB(nodeOf(mut st, sw))
    mut n := 0
    for ci <- iter.Range(0, lenL(mut st, cases)) {
        pats := lA(nodeOf(mut st, latN(mut st, cases, ci)))
        if lenL(mut st, pats) == 1 && kindN(mut st, latN(mut st, pats, 0)) == ast.KPType {
            n += 1
        }
    }
    return n
}

// defaultなしのswitchの分岐が値を全部覆うか（全域のcase — `_`・束縛 — があるか、subject styがunionで型パターンの分岐が
// 全variantを入れ子のフィールドまで覆う）
func switchCovers(st mut St, sw desugar.NodeRef, sty int) bool {
    cases := lB(nodeOf(mut st, sw))
    for ci <- iter.Range(0, lenL(mut st, cases)) {
        pats := lA(nodeOf(mut st, latN(mut st, cases, ci)))
        for i <- iter.Range(0, lenL(mut st, pats)) {
            p := latN(mut st, pats, i)
            if kindN(mut st, p) == ast.KPConst && (hasWildcard(mut st, lA(nodeOf(mut st, p))) || isBindAlt(mut st, lA(nodeOf(mut st, p)))) {
                return true
            }
        }
    }
    if isTag(mut st, sty, TUnion) {
        // 型パターンの分岐の行列（1列 = subject）が全variantを入れ子のフィールドまで覆うか（パターン行列 — checkと共有のdesugar.PmUseful1）
        mut n := 0
        for ci <- iter.Range(0, lenL(mut st, cases)) {
            pats := lA(nodeOf(mut st, latN(mut st, cases, ci)))
            if lenL(mut st, pats) == 1 && kindN(mut st, latN(mut st, pats, 0)) == ast.KPType {
                n += 1
            }
        }
        if n > 0 {
            rows := desugar.PmList(mut st.d, n)
            mut r := 0
            for ci <- iter.Range(0, lenL(mut st, cases)) {
                pats := lA(nodeOf(mut st, latN(mut st, cases, ci)))
                if lenL(mut st, pats) == 1 && kindN(mut st, latN(mut st, pats, 0)) == ast.KPType {
                    desugar.PmSet(mut st.d, rows, r, latI(mut st, pats, 0))
                    r += 1
                }
            }
            info := desugar.HeapGet(mut st.d, sty + 1)
            // error の全ラベルの union は宣言を持たない（SI_DECL = -1）— ラベル集合の領域（リンク集合の全ラベル）
            ud := desugar.HeapGet(mut st.d, info + SI_DECL)
            dom := if ud == -1 { desugar.PmAllErr(mut st.d, 0) } else { desugar.PmCol{kind: desugar.PmSum, a: ud, b: desugar.HeapGet(mut st.d, info + SI_PKG), h: 0} }
            return !desugar.PmUseful1(mut st.d, st.curPkg, rows, n, desugar.NodeRef(-1), dom, desugar.ListRef(-1))
        }
    }
    return false
}

// パターン 1 つを値 (sty, sv) に照合する（sty = -1 は subject 無し switch の bool 条件）。
// 不一致なら nx へ跳び、一致なら続きのブロックを cur にする
func matchPattern(st mut St, p desugar.NodeRef, sty int, sv int, nx BlkRef, bs int) error? {
    if kindN(mut st, p) == ast.KPConst {
        alts := lA(nodeOf(mut st, p))
        if hasWildcard(mut st, alts) {
            return nil
        }
        // 裸の識別子でスコープに無い名前は値の束縛。既存の名前は比較
        if isBindAlt(mut st, alts) {
            if sty < 0 {
                return diag.UndefinedName{at: posOf(mut st, latN(mut st, alts, 0))}
            }
            bindAdd(mut st, bs, nodeOf(mut st, latN(mut st, alts, 0)).a, sty, sv)
            return nil
        }
        if sty >= 0 && !isScalar(mut st, sty) {
            return diag.Mismatch{at: posOf(mut st, latN(mut st, alts, 0))}
        }
        ok := newBlock(mut st)
        n := lenL(mut st, alts)
        for i <- iter.Range(0, n) {
            alt := latN(mut st, alts, i)
            // 定数パターンは subject の型を期待型に（型なしの定数を named scalar の subject に合わせる — language.md 32 節）
            ax := if sty >= 0 { exprExpecting(mut st, alt, sty, alt)? } else { expr(mut st, alt)? }
            if isTag(mut st, ax.t, TNever) {
                return nil
            }
            mut c := ax.v
            if sty >= 0 {
                if !tEql(mut st, ax.t, sty) {
                    return diag.Mismatch{at: posOf(mut st, alt)}
                }
                c = cmp(mut st, CEq, sv, ax.v)
            } else {
                want(mut st, ax.t, tBool(mut st), alt)?
            }
            miss := if i + 1 < n { newBlock(mut st) } else { nx }
            condbr(mut st, c, ok, -1, miss, -1)
            setCur(mut st, miss)
        }
        setCur(mut st, ok)
        return nil
    }
    // 型パターン `[x] Variant{f, g: p}`: タグを比べ、フィールドを束縛か下位パターンで照合する
    at := p
    if sty < 0 {
        return diag.Mismatch{at: posOf(mut st, at)}
    }
    // error: 先頭ラベルのタグ（ワード0）で照合し、フィールドは列の末尾のセルから・`cause` は列から作る1つ内側のerror?
    is_err := isErr(mut st, sty)
    sty0 := sty
    ut := if is_err { desugar.HeapGet(mut st.d, errsInfo(mut st) + SI_TY) } else { sty0 }
    if !isTag(mut st, ut, TUnion) {
        return diag.Mismatch{at: posOf(mut st, at)}
    }
    vs := hgetL(mut st, desugar.HeapGet(mut st.d, ut + 1) + SI_FIELDS)
    vi := patVariant(mut st, sB(nodeOf(mut st, p)), ut)
    if vi < 0 {
        return diag.Mismatch{at: posOf(mut st, at)}
    }
    vr := latI(mut st, vs, vi)
    ok := newBlock(mut st)
    tagv := load(mut st, sv, 0)
    condbr(mut st, cmp(mut st, CEq, tagv, iconst(mut st, desugar.HeapGet(mut st.d, vr + 1))), ok, -1, nx, -1)
    setCur(mut st, ok)
    if nodeOf(mut st, p).a >= 0 {
        bindAdd(mut st, bs, nodeOf(mut st, p).a, sty0, sv)
    }
    fps := lC(nodeOf(mut st, p))
    mut pv := sv
    for i <- iter.Range(0, lenL(mut st, fps)) {
        fp := latN(mut st, fps, i)
        f := findField(mut st, hgetL(mut st, vr + 2), sA(nodeOf(mut st, fp)))
        mut ft := 0
        mut fv := 0
        if f >= 0 {
            if is_err && pv == sv {
                pv = errTop(mut st, sv)
            }
            ft = desugar.HeapGet(mut st.d, f + 1)
            fv = loadVal(mut st, pv, 1 + desugar.HeapGet(mut st.d, f + 2), ft)
            if isBox(mut st, ft) {
                fv = openBox(mut st, ft, fv)
                ft = surfTy(mut st, ft)
            }
        } else if is_err && strIs(mut st, sA(nodeOf(mut st, fp)), "cause") {
            ft = optOf(mut st, sty0)
            fv = causeOf(mut st, sv, sty0, ut)
        } else {
            return diag.UndefinedField{at: posOf(mut st, fp)}
        }
        if nodeOf(mut st, fp).b >= 0 {
            sub := nB(nodeOf(mut st, fp))
            if f < 0 && kindN(mut st, sub) == ast.KPType {
                // cause の型パターン（`cause: A{…}`）: nil なら外れ、でなければ 1 つ内側の error（opt のペイロード）を照合する
                some := newBlock(mut st)
                condbr(mut st, cmp(mut st, CNe, load(mut st, fv, 0), iconst(mut st, 0)), some, -1, nx, -1)
                setCur(mut st, some)
                matchPattern(mut st, sub, sty0, fieldPtr(mut st, fv, 1), nx, bs)?
            } else {
                matchPattern(mut st, sub, ft, fv, nx, bs)?
            }
            if cur(mut st) == -1 {
                return nil
            }
        } else if !strIs(mut st, sA(nodeOf(mut st, fp)), "_") {
            bindAdd(mut st, bs, nodeOf(mut st, fp).a, ft, fv)
        }
    }
    return nil
}

// switchの分岐（defaultを含む）のどれかがnilで終わるか
func nilCaseL(st mut St, sw desugar.NodeRef) bool {
    cs := lB(nodeOf(mut st, sw))
    for i <- iter.Range(0, lenL(mut st, cs)) {
        if nilTailL(mut st, lA(nodeOf(mut st, nB(nodeOf(mut st, latN(mut st, cs, i)))))) {
            return true
        }
    }
    dflt := nC(nodeOf(mut st, sw))
    return dflt != -1 && nilTailL(mut st, lA(nodeOf(mut st, dflt)))
}
