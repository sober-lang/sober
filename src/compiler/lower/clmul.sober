package lower

// CRC-32 の PCLMULQDQ の折り畳み（report-774 — std/hash/crc32.Sum の 64 バイト以上の本文）: 組み込みの鍵 2 つ。
// cpuclmul = この機械で折り畳みの道を使えるか（0 / 1）・crcfold(b, k, crc) = b[0:k]（k は 64 以上の 16 の倍数 — 境界は std が見る）を反転済みの crc に畳んだ値。
// 道は x86 の最適化のバックエンドの ELF だけ（st.hwFold）: IR テキスト・.ll・写しのバックエンドでは cpuclmul = 定数 0 で、crcfold は std の分岐で呼ばれない。
// 判定は CPUID.1:ECX（bit 1 = PCLMULQDQ — 最後の 32 ビットの取り出しは SSE2 の範囲で済ませるので SSE4.1 は要らない）を初回の cpuclmul / cpuaes で
// 1 回だけ取り、rt.cpu（判定の印 + 1・0 = まだ — 印の bit 0 = crc32 の折り畳み・bit 1 = AES-GCM の塊〔aes.sober — AES-NI bit 25・SSSE3 bit 9・PCLMULQDQ〕）に置く
// （CPUID は仮想機械で hypervisor へ抜ける — 毎回は叩かない。ワーカーが同時に引いても同じ値を書くだけ — rt.vdso の前例）。
// SOBER_NOCLMUL=1 / SOBER_NOAES=1 はそれぞれの印を 0 に（同じ実行ファイルの倒れ先の道を網で照合する口）

import "desugar"

// OpCrcFold の種類（c）
const CF_FOLD = 0    // a = [p, k, crc] → 畳んだ crc
const CF_PCLMUL = 1  // a = [] → CPUID.1:ECX（32 ビット全部 — rt.cpu_probe の中だけ）
const CF_CPUID7 = 2  // a = [] → CPUID.7.0:EBX（32 ビット全部 — bit 8 = BMI2〔MULX〕・bit 19 = ADX〔ADCX / ADOX〕・rt.cpu_probe の中だけ — mulx.sober）

// cpuClmul は cpuclmul の値（hw の道: rt.cpu の印の bit 0）
func cpuClmul(st mut St) int {
    if !st.hwFold {
        return iconst(mut st, 0)
    }
    return bin(mut st, BAnd, cpuMarks(mut st), iconst(mut st, 1))
}

// cpuMarks は rt.cpu の印（rt.cpu を読み、0 なら rt.cpu_probe で判定して置く — 印 = 値 - 1）
func cpuMarks(st mut St) int {
    needCpu(mut st)
    zero := iconst(mut st, 0)
    bInit := newBlock(mut st)
    bHave := newBlock(mut st)
    v := param(mut st, bHave, TyI64)
    v0 := load(mut st, globaladdr(mut st, st.cpuG), 0)
    condbr(mut st, cmp(mut st, CEq, v0, zero), bInit, -1, bHave, list1(mut st, v0))
    setCur(mut st, bInit)
    br(mut st, bHave, list1(mut st, call(mut st, st.rtCpuProbe, list0(mut st))))
    setCur(mut st, bHave)
    return bin(mut st, BSub, v, iconst(mut st, 1))
}

// crcFold は crcfold(p, k, crc) の値（p = バイト列の先頭の番地。hw の道でない出力では std の分岐が呼ばない — 0）
func crcFold(st mut St, p int, k int, crc int) int {
    if !st.hwFold {
        return iconst(mut st, 0)
    }
    return push(mut st, true, OpCrcFold, list3(mut st, p, k, crc), 0, CF_FOLD)
}

// needCpu は rt.cpu と rt.cpu_probe を（初出なら）宣言する
func needCpu(st mut St) {
    lsNeed(mut st, NEED_CPU, 0)
    if st.cpuG == -1 {
        st.cpuG = addGlobalInit(mut st, int(strLit(mut st, "rt.cpu")), 1, -1)
        st.rtCpuProbe = addFunc(mut st, int(strLit(mut st, "rt.cpu_probe")), desugar.ListRef(list0(mut st)), TyI64)
    }
}

// buildCpuProbe は rt.cpu_probe() → 印 + 1 を rt.cpu に置いて返す（印の bit 0 = PCLMULQDQ かつ SOBER_NOCLMUL でない・bit 1 = AES-NI・SSSE3・
// PCLMULQDQ が揃い SOBER_NOAES でない・bit 2 = BMI2・bit 3 = BMI2 かつ ADX — bit 2 / 3 は SOBER_NOMULX で 0）
func buildCpuProbe(st mut St) {
    if st.cpuG == -1 {
        return
    }
    begin(mut st, st.rtCpuProbe)
    nc := envMb(mut st, itop(mut st, load(mut st, globaladdr(mut st, st.meta), W_ARGV)), "SOBER_NOCLMUL=", 0, true)
    na := envMb(mut st, itop(mut st, load(mut st, globaladdr(mut st, st.meta), W_ARGV)), "SOBER_NOAES=", 0, true)
    ecx := push(mut st, true, OpCrcFold, list0(mut st), 0, CF_PCLMUL)
    clm := bin(mut st, BAnd, bin(mut st, BSar, ecx, iconst(mut st, 1)), iconst(mut st, 1))
    aes := bin(mut st, BAnd, bin(mut st, BAnd, clm, bin(mut st, BSar, ecx, iconst(mut st, 25))), bin(mut st, BSar, ecx, iconst(mut st, 9)))
    m0 := bin(mut st, BMul, clm, cmp(mut st, CEq, nc, iconst(mut st, 0)))
    m1 := bin(mut st, BMul, bin(mut st, BAnd, aes, iconst(mut st, 1)), cmp(mut st, CEq, na, iconst(mut st, 0)))
    nm := envMb(mut st, itop(mut st, load(mut st, globaladdr(mut st, st.meta), W_ARGV)), "SOBER_NOMULX=", 0, true)
    ebx7 := push(mut st, true, OpCrcFold, list0(mut st), 0, CF_CPUID7)
    m2 := bin(mut st, BMul, bin(mut st, BAnd, bin(mut st, BSar, ebx7, iconst(mut st, 8)), iconst(mut st, 1)), cmp(mut st, CEq, nm, iconst(mut st, 0)))
    // bit 3 = 64 bit の塊（BMI2 かつ ADX〔EBX bit 19 — ADCX / ADOX〕・SOBER_NOMULX でない — RSA の続き (イ-b)）
    m3 := bin(mut st, BAnd, m2, bin(mut st, BSar, ebx7, iconst(mut st, 19)))
    r := urAdd(mut st, bin(mut st, BOr, bin(mut st, BOr, m0, bin(mut st, BShl, m1, iconst(mut st, 1))), bin(mut st, BOr, bin(mut st, BShl, m2, iconst(mut st, 2)), bin(mut st, BShl, m3, iconst(mut st, 3)))), 1)
    store(mut st, globaladdr(mut st, st.cpuG), 0, r)
    ret(mut st, r)
}
