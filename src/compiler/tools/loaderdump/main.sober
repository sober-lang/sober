package main

// loaderdump: 標準入力のManifestからProgramをloadし、loaderゴールデンのJSON（Zig版 `sober parse --loader-json` と同じバイト列）を
// 標準出力に書く。selfhost の loader 差分オラクル（scripts/selfhost_load.sh）の Sober 側。
// Manifestの形（argvとreaddirが無いための代役）: 1行目 = entry、2行目 = stdの格納場所（`std/…` を読む根）、
// 3行目以降 = ルート（cwd）相対のファイル一覧（ファイル名順。`std/…` はstdの格納場所の相対）

import "std/io"
import "loader"
import "diag"


func main() {
    src, err := io.ReadFile("/dev/stdin")
    if err != nil {
        println("loaderdump: cannot read /dev/stdin")
        return
    }
    m, valid := loader.ManifestOf(src)
    if !valid {
        println("loaderdump: bad manifest")
        return
    }
    p, lerr := loader.Load(m)
    if lerr != nil {
        _ = io.WriteFile("/dev/stdout", bytes(diag.Format(lerr, "")))
        println("")
        println("loaderdump: load error")
        return
    }
    _ = io.WriteFile("/dev/stdout", loader.Json(p))
}
