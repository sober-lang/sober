package main

// x86 エンコーダの照合用の列（scripts/x86enc.sh — GNU as との照合）。1 行に 1 命令: 「hex<TAB>Intel 構文の asm」。
// エンコーダの公開関数を全レジスタ（と disp / imm の境界値）の組み合わせで吐く。rel32 の形（jmp / jcc / call）は as が短い形を選ぶので
// 照合しない（固定長の形 — ELF のバイト一致 elfeq が見る）

import "std/iter"
import "std/table"
import "x86"

func regName(r int) string {
    names := []string{"rax", "rcx", "rdx", "rbx", "rsp", "rbp", "rsi", "rdi", "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15"}
    return names[r]
}

func reg32Name(r int) string {
    names := []string{"eax", "ecx", "edx", "ebx", "esp", "ebp", "esi", "edi", "r8d", "r9d", "r10d", "r11d", "r12d", "r13d", "r14d", "r15d"}
    return names[r]
}

func reg8Name(r int) string {
    names := []string{"al", "cl", "dl", "bl", "spl", "bpl", "sil", "dil", "r8b", "r9b", "r10b", "r11b", "r12b", "r13b", "r14b", "r15b"}
    return names[r]
}

func condName(k int) string {
    conds := []int{x86.CondE, x86.CondNe, x86.CondL, x86.CondGe, x86.CondLe, x86.CondG, x86.CondB, x86.CondAe, x86.CondA, x86.CondP, x86.CondNp}
    names := []string{"e", "ne", "l", "ge", "le", "g", "b", "ae", "a", "p", "np"}
    mut i := 0
    while conds[i] != k {
        i += 1
    }
    return names[i]
}

func mem(base int, disp int) string {
    return if disp == 0 { "[${regName(base)}]" } else if disp < 0 { "[${regName(base)}-${0 - disp}]" } else { "[${regName(base)}+${disp}]" }
}

// sibMem は [base+index*倍率±disp] の Intel 構文
func sibMem(base int, index int, f int, disp int) string {
    d := if disp == 0 { "" } else if disp < 0 { "-${0 - disp}" } else { "+${disp}" }
    return "[${regName(base)}+${regName(index)}*${f}${d}]"
}

func hexDigit(n int) byte {
    return byte(if n < 10 { 48 + n } else { 87 + n })
}

// line は c の [from, 末尾) の hex と asm を 1 行に印字する
func line(c mut table.Table[byte], from int, asm string) {
    mut out := mut []byte{}
    for i <- iter.Range(from, table.Len(mut c)) {
        b := int(table.Get(mut c, i))
        out = append(out, hexDigit(b >> 4))
        out = append(out, hexDigit(b & 15))
    }
    h, err := string(freeze(out))
    if err == nil {
        println("${h}\t${asm}")
    }
}

func main() {
    mut c := table.Table[byte]{}
    disps := []int{0, -8, 127, 128, -128, -129, 4096}
    imms := []int{0, 1, -1, 127, -128, 128, -129, 65536, -2147483648, 2147483647}
    for a <- iter.Range(0, 16) {
        mut at := x86.Here(mut c)
        x86.PushReg(mut c, a)
        line(mut c, at, "push ${regName(a)}")
        at = x86.Here(mut c)
        x86.PopReg(mut c, a)
        line(mut c, at, "pop ${regName(a)}")
        at = x86.Here(mut c)
        x86.NegReg(mut c, a)
        line(mut c, at, "neg ${regName(a)}")
        at = x86.Here(mut c)
        x86.ShlRegCl(mut c, a)
        line(mut c, at, "shl ${regName(a)}, cl")
        at = x86.Here(mut c)
        x86.SarRegCl(mut c, a)
        line(mut c, at, "sar ${regName(a)}, cl")
        for k <- iter.Range(0, 4) {
            sh := if k == 0 { 1 } else if k == 1 { 13 } else if k == 2 { 31 } else { 63 }
            at = x86.Here(mut c)
            x86.SarRegImm(mut c, a, sh)
            line(mut c, at, "sar ${regName(a)}, ${sh}")
        }
        for k <- iter.Range(0, 4) {
            sh := if k == 0 { 1 } else if k == 1 { 2 } else if k == 2 { 62 } else { 63 }
            at = x86.Here(mut c)
            x86.ShrRegImm(mut c, a, sh)
            line(mut c, at, "shr ${regName(a)}, ${sh}")
        }
        // mulx（RSA の続き — report-864）: hi × lo × src の全組（hi ≠ lo）
        for b2 <- iter.Range(0, 16) {
            for s2 <- iter.Range(0, 16) {
                if b2 != a {
                    at = x86.Here(mut c)
                    x86.MulxRRR(mut c, a, b2, s2)
                    line(mut c, at, "mulx ${regName(a)}, ${regName(b2)}, ${regName(s2)}")
                }
            }
        }
        // adcx / adox / sbb（RSA の続き (イ-b) — report-866）: 全組
        for s2 <- iter.Range(0, 16) {
            at = x86.Here(mut c)
            x86.AdcxRR(mut c, a, s2)
            line(mut c, at, "adcx ${regName(a)}, ${regName(s2)}")
            at = x86.Here(mut c)
            x86.AdoxRR(mut c, a, s2)
            line(mut c, at, "adox ${regName(a)}, ${regName(s2)}")
            at = x86.Here(mut c)
            x86.SbbRegReg(mut c, a, s2)
            line(mut c, at, "sbb ${regName(a)}, ${regName(s2)}")
        }
        at = x86.Here(mut c)
        x86.IdivReg(mut c, a)
        line(mut c, at, "idiv ${regName(a)}")
        at = x86.Here(mut c)
        x86.MulReg(mut c, a)
        line(mut c, at, "mul ${regName(a)}")
        at = x86.Here(mut c)
        x86.CallReg(mut c, a)
        line(mut c, at, "call ${regName(a)}")
        for k <- iter.Range(0, len(imms)) {
            n := imms[k]
            at = x86.Here(mut c)
            x86.MovRegImm32(mut c, a, n)
            line(mut c, at, "mov ${regName(a)}, ${n}")
            at = x86.Here(mut c)
            x86.AddRegImm(mut c, a, n)
            line(mut c, at, "add ${regName(a)}, ${n}")
            at = x86.Here(mut c)
            x86.SubRegImm(mut c, a, n)
            line(mut c, at, "sub ${regName(a)}, ${n}")
            at = x86.Here(mut c)
            x86.CmpRegImm(mut c, a, n)
            line(mut c, at, "cmp ${regName(a)}, ${n}")
            at = x86.Here(mut c)
            x86.AndRegImm(mut c, a, n)
            line(mut c, at, "and ${regName(a)}, ${n}")
        }
        at = x86.Here(mut c)
        x86.MovRegImm64(mut c, a, 81985529216486895)
        line(mut c, at, "movabs ${regName(a)}, 81985529216486895")
        at = x86.Here(mut c)
        x86.MovRegImm64(mut c, a, -2)
        line(mut c, at, "movabs ${regName(a)}, -2")
        for b <- iter.Range(0, 16) {
            at = x86.Here(mut c)
            x86.MovRegReg(mut c, a, b)
            line(mut c, at, "mov ${regName(a)}, ${regName(b)}")
            at = x86.Here(mut c)
            x86.AddRegReg(mut c, a, b)
            line(mut c, at, "add ${regName(a)}, ${regName(b)}")
            at = x86.Here(mut c)
            x86.SubRegReg(mut c, a, b)
            line(mut c, at, "sub ${regName(a)}, ${regName(b)}")
            at = x86.Here(mut c)
            x86.AndRegReg(mut c, a, b)
            line(mut c, at, "and ${regName(a)}, ${regName(b)}")
            at = x86.Here(mut c)
            x86.OrRegReg(mut c, a, b)
            line(mut c, at, "or ${regName(a)}, ${regName(b)}")
            at = x86.Here(mut c)
            x86.XorRegReg(mut c, a, b)
            line(mut c, at, "xor ${regName(a)}, ${regName(b)}")
            at = x86.Here(mut c)
            x86.CmpRegReg(mut c, a, b)
            line(mut c, at, "cmp ${regName(a)}, ${regName(b)}")
            at = x86.Here(mut c)
            x86.ImulRegReg(mut c, a, b)
            line(mut c, at, "imul ${regName(a)}, ${regName(b)}")
            for k <- iter.Range(0, len(imms)) {
                at = x86.Here(mut c)
                x86.ImulRegRegImm(mut c, a, b, imms[k])
                line(mut c, at, "imul ${regName(a)}, ${regName(b)}, ${imms[k]}")
            }
            if b != x86.Rsp {
                at = x86.Here(mut c)
                x86.LeaRegSib(mut c, a, a, b, x86.Scale8)
                line(mut c, at, "lea ${regName(a)}, [${regName(a)}+${regName(b)}*8]")
            }
            if a != x86.Rsp {
                at = x86.Here(mut c)
                x86.LeaRegSib(mut c, b, b, a, x86.Scale1)
                line(mut c, at, "lea ${regName(b)}, [${regName(b)}+${regName(a)}*1]")
            }
            for k <- iter.Range(0, len(disps)) {
                d := disps[k]
                at = x86.Here(mut c)
                x86.MovRegMem(mut c, a, b, d)
                line(mut c, at, "mov ${regName(a)}, qword ptr ${mem(b, d)}")
                at = x86.Here(mut c)
                x86.LeaRegMem(mut c, a, b, d)
                line(mut c, at, "lea ${regName(a)}, ${mem(b, d)}")
                at = x86.Here(mut c)
                x86.MovMemReg(mut c, b, d, a)
                line(mut c, at, "mov qword ptr ${mem(b, d)}, ${regName(a)}")
                at = x86.Here(mut c)
                x86.MovMem8Reg(mut c, b, d, a)
                line(mut c, at, "mov byte ptr ${mem(b, d)}, ${reg8Name(a)}")
                at = x86.Here(mut c)
                x86.MovzxRegMem8(mut c, a, b, d)
                line(mut c, at, "movzx ${regName(a)}, byte ptr ${mem(b, d)}")
                at = x86.Here(mut c)
                x86.AddRegMem(mut c, a, b, d)
                line(mut c, at, "add ${regName(a)}, qword ptr ${mem(b, d)}")
                at = x86.Here(mut c)
                x86.SubRegMem(mut c, a, b, d)
                line(mut c, at, "sub ${regName(a)}, qword ptr ${mem(b, d)}")
                at = x86.Here(mut c)
                x86.AndRegMem(mut c, a, b, d)
                line(mut c, at, "and ${regName(a)}, qword ptr ${mem(b, d)}")
                at = x86.Here(mut c)
                x86.OrRegMem(mut c, a, b, d)
                line(mut c, at, "or ${regName(a)}, qword ptr ${mem(b, d)}")
                at = x86.Here(mut c)
                x86.XorRegMem(mut c, a, b, d)
                line(mut c, at, "xor ${regName(a)}, qword ptr ${mem(b, d)}")
                at = x86.Here(mut c)
                x86.CmpRegMem(mut c, a, b, d)
                line(mut c, at, "cmp ${regName(a)}, qword ptr ${mem(b, d)}")
                at = x86.Here(mut c)
                x86.ImulRegMem(mut c, a, b, d)
                line(mut c, at, "imul ${regName(a)}, qword ptr ${mem(b, d)}")
                at = x86.Here(mut c)
                x86.AdcxRM(mut c, a, b, -1, 0, d)
                line(mut c, at, "adcx ${regName(a)}, qword ptr ${mem(b, d)}")
                at = x86.Here(mut c)
                x86.AdoxRM(mut c, a, b, -1, 0, d)
                line(mut c, at, "adox ${regName(a)}, qword ptr ${mem(b, d)}")
                if a != b {
                    at = x86.Here(mut c)
                    x86.MulxRM(mut c, a, b, b, -1, 0, d)
                    line(mut c, at, "mulx ${regName(a)}, ${regName(b)}, qword ptr ${mem(b, d)}")
                    at = x86.Here(mut c)
                    x86.MulxRM(mut c, b, a, b, -1, 0, d)
                    line(mut c, at, "mulx ${regName(b)}, ${regName(a)}, qword ptr ${mem(b, d)}")
                }
            }
        }
        // SIB の load / store（性能投資 第二便 M7）: reg × base × index（rsp を除く）× 倍率 1 / 8 × disp 0 / -8 / 4096
        for b <- iter.Range(0, 16) {
            for ix <- iter.Range(0, 16) {
                if ix != x86.Rsp {
                    for si <- iter.Range(0, 2) {
                        sc := if si == 0 { x86.Scale1 } else { x86.Scale8 }
                        f := if si == 0 { 1 } else { 8 }
                        for k <- iter.Range(0, 3) {
                            d := if k == 0 { 0 } else if k == 1 { -8 } else { 4096 }
                            m := sibMem(b, ix, f, d)
                            at = x86.Here(mut c)
                            x86.MovRegMemSib(mut c, a, b, ix, sc, d)
                            line(mut c, at, "mov ${regName(a)}, qword ptr ${m}")
                            at = x86.Here(mut c)
                            x86.MovMemRegSib(mut c, b, ix, sc, d, a)
                            line(mut c, at, "mov qword ptr ${m}, ${regName(a)}")
                            at = x86.Here(mut c)
                            x86.MovzxRegMem8Sib(mut c, a, b, ix, sc, d)
                            line(mut c, at, "movzx ${regName(a)}, byte ptr ${m}")
                            at = x86.Here(mut c)
                            x86.MovMem8RegSib(mut c, b, ix, sc, d, a)
                            line(mut c, at, "mov byte ptr ${m}, ${reg8Name(a)}")
                            at = x86.Here(mut c)
                            x86.AdoxRM(mut c, a, b, ix, sc, d)
                            line(mut c, at, "adox ${regName(a)}, qword ptr ${m}")
                            at = x86.Here(mut c)
                            x86.AdcxRM(mut c, a, b, ix, sc, d)
                            line(mut c, at, "adcx ${regName(a)}, qword ptr ${m}")
                            lo2 := (a + 1 + ix) % 16
                            if lo2 != a {
                                at = x86.Here(mut c)
                                x86.MulxRM(mut c, a, lo2, b, ix, sc, d)
                                line(mut c, at, "mulx ${regName(a)}, ${regName(lo2)}, qword ptr ${m}")
                            }
                        }
                    }
                }
            }
        }
        for k <- iter.Range(0, len(disps)) {
            at = x86.Here(mut c)
            x86.MovMemImm32(mut c, a, disps[k], -5)
            line(mut c, at, "mov qword ptr ${mem(a, disps[k])}, -5")
        }
    }
    // fs 相対の読み（段 6 P4-3 — ワーカーの記録の表: mov r, fs:[disp32]）: 16 レジスタ × disp の境界値
    fsDisps := []int{0, 8, 127, 128, 4096, 2147483640}
    for a <- iter.Range(0, 16) {
        for k <- iter.Range(0, len(fsDisps)) {
            at := x86.Here(mut c)
            x86.MovRegFs(mut c, a, fsDisps[k])
            line(mut c, at, "mov ${regName(a)}, qword ptr fs:[${fsDisps[k]}]")
        }
    }
    // 原子の op（段 6 P4-4 — rt の中だけ）: lock xadd / xchg / lock cmpxchg × 16 レジスタ × base 16 × disp の境界値・mfence・pause
    atDisps := []int{0, 8, -8, 127, 128, 4096}
    for a <- iter.Range(0, 16) {
        for b <- iter.Range(0, 16) {
            for k <- iter.Range(0, len(atDisps)) {
                d := atDisps[k]
                mut at := x86.Here(mut c)
                x86.LockXaddMemReg(mut c, b, d, a)
                line(mut c, at, "lock xadd qword ptr ${mem(b, d)}, ${regName(a)}")
                at = x86.Here(mut c)
                x86.XchgMemReg(mut c, b, d, a)
                line(mut c, at, "xchg qword ptr ${mem(b, d)}, ${regName(a)}")
                at = x86.Here(mut c)
                x86.LockCmpxchgMemReg(mut c, b, d, a)
                line(mut c, at, "lock cmpxchg qword ptr ${mem(b, d)}, ${regName(a)}")
            }
        }
    }
    atF := x86.Here(mut c)
    x86.Mfence(mut c)
    line(mut c, atF, "mfence")
    atP := x86.Here(mut c)
    x86.Pause(mut c)
    line(mut c, atP, "pause")
    atC := x86.Here(mut c)
    x86.Cpuid(mut c)
    line(mut c, atC, "cpuid")
    // SSE2（第三便のベクトル化スパイク）: xmm × xmm の 6 形・pmovmskb / movq の xmm × 汎用・movdqu の [base + index]・bsf
    for a <- iter.Range(0, 16) {
        for b <- iter.Range(0, 16) {
            mut at := x86.Here(mut c)
            x86.MovdqaXX(mut c, a, b)
            line(mut c, at, "movdqa xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.PcmpeqbXX(mut c, a, b)
            line(mut c, at, "pcmpeqb xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.PcmpgtbXX(mut c, a, b)
            line(mut c, at, "pcmpgtb xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.PxorXX(mut c, a, b)
            line(mut c, at, "pxor xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.PorXX(mut c, a, b)
            line(mut c, at, "por xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.PunpcklqdqXX(mut c, a, b)
            line(mut c, at, "punpcklqdq xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.PandnXX(mut c, a, b)
            line(mut c, at, "pandn xmm${a}, xmm${b}")
            // CRC-32 の折り畳み（report-774）: pand・pclmulqdq の imm の 4 形
            at = x86.Here(mut c)
            x86.PandXX(mut c, a, b)
            line(mut c, at, "pand xmm${a}, xmm${b}")
            for im <- iter.Range(0, 4) {
                imm := (im & 1) | ((im >> 1) << 4)
                at = x86.Here(mut c)
                x86.PclmulqdqXXI(mut c, a, b, imm)
                line(mut c, at, "pclmulqdq xmm${a}, xmm${b}, ${imm}")
            }
            // AES-GCM（report-796）: aesenc / aesenclast / pshufb・aeskeygenassist と pshufd の imm・32 ビットのレーンのずらし
            at = x86.Here(mut c)
            x86.AesencXX(mut c, a, b)
            line(mut c, at, "aesenc xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.AesenclastXX(mut c, a, b)
            line(mut c, at, "aesenclast xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.PadddXX(mut c, a, b)
            line(mut c, at, "paddd xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.PshufbXX(mut c, a, b)
            line(mut c, at, "pshufb xmm${a}, xmm${b}")
            rcons := []int{1, 2, 4, 8, 16, 32, 64, 128, 27, 54, 0, 255}
            at = x86.Here(mut c)
            x86.AeskeygenassistXXI(mut c, a, b, rcons[b % 12])
            line(mut c, at, "aeskeygenassist xmm${a}, xmm${b}, ${rcons[b % 12]}")
            at = x86.Here(mut c)
            x86.PshufdXXI(mut c, a, b, (a * 16 + b * 7) & 255)
            line(mut c, at, "pshufd xmm${a}, xmm${b}, ${(a * 16 + b * 7) & 255}")
            at = x86.Here(mut c)
            x86.PslldXI(mut c, a, b * 2)
            line(mut c, at, "pslld xmm${a}, ${b * 2}")
            at = x86.Here(mut c)
            x86.PsrldXI(mut c, a, b * 2 + 1)
            line(mut c, at, "psrld xmm${a}, ${b * 2 + 1}")
            at = x86.Here(mut c)
            x86.PsradXI(mut c, a, b * 2)
            line(mut c, at, "psrad xmm${a}, ${b * 2}")
            at = x86.Here(mut c)
            x86.PmovmskbRX(mut c, a, b)
            line(mut c, at, "pmovmskb ${reg32Name(a)}, xmm${b}")
            at = x86.Here(mut c)
            x86.MovqXR(mut c, a, b)
            line(mut c, at, "movq xmm${a}, ${regName(b)}")
            // float の段: scalar double の xmm × xmm・movq / cvt の xmm × 汎用
            at = x86.Here(mut c)
            x86.MovqRX(mut c, a, b)
            line(mut c, at, "movq ${regName(a)}, xmm${b}")
            at = x86.Here(mut c)
            x86.MovapdXX(mut c, a, b)
            line(mut c, at, "movapd xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.AddsdXX(mut c, a, b)
            line(mut c, at, "addsd xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.SubsdXX(mut c, a, b)
            line(mut c, at, "subsd xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.MulsdXX(mut c, a, b)
            line(mut c, at, "mulsd xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.DivsdXX(mut c, a, b)
            line(mut c, at, "divsd xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.SqrtsdXX(mut c, a, b)
            line(mut c, at, "sqrtsd xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.UcomisdXX(mut c, a, b)
            line(mut c, at, "ucomisd xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.Cvtsi2sdXR(mut c, a, b)
            line(mut c, at, "cvtsi2sd xmm${a}, ${regName(b)}")
            at = x86.Here(mut c)
            x86.Cvttsd2siRX(mut c, a, b)
            line(mut c, at, "cvttsd2si ${regName(a)}, xmm${b}")
            // packed double（段 4②a）
            at = x86.Here(mut c)
            x86.AddpdXX(mut c, a, b)
            line(mut c, at, "addpd xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.SubpdXX(mut c, a, b)
            line(mut c, at, "subpd xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.MulpdXX(mut c, a, b)
            line(mut c, at, "mulpd xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.DivpdXX(mut c, a, b)
            line(mut c, at, "divpd xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.SqrtpdXX(mut c, a, b)
            line(mut c, at, "sqrtpd xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.UnpcklpdXX(mut c, a, b)
            line(mut c, at, "unpcklpd xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.UnpckhpdXX(mut c, a, b)
            line(mut c, at, "unpckhpd xmm${a}, xmm${b}")
            at = x86.Here(mut c)
            x86.BsfRR(mut c, a, b)
            line(mut c, at, "bsf ${regName(a)}, ${regName(b)}")
            for ix <- iter.Range(0, 16) {
                if ix != x86.Rsp {
                    at = x86.Here(mut c)
                    x86.MovdquXMemSib(mut c, a, b, ix)
                    line(mut c, at, "movdqu xmm${a}, xmmword ptr [${regName(b)}+${regName(ix)}*1]")
                }
            }
        }
    }
    // UTF-8 の検査器: pslldq / psrldq の即値・movdqu の [base + disp] の読み書き
    for a <- iter.Range(0, 16) {
        for k <- iter.Range(1, 16) {
            mut at := x86.Here(mut c)
            x86.PslldqXI(mut c, a, k)
            line(mut c, at, "pslldq xmm${a}, ${k}")
            at = x86.Here(mut c)
            x86.PsrldqXI(mut c, a, k)
            line(mut c, at, "psrldq xmm${a}, ${k}")
            at = x86.Here(mut c)
            x86.PsrlqXI(mut c, a, k * 4)
            line(mut c, at, "psrlq xmm${a}, ${k * 4}")
        }
        for b <- iter.Range(0, 16) {
            for k <- iter.Range(0, len(disps)) {
                d := disps[k]
                mut at := x86.Here(mut c)
                x86.MovdquXMem(mut c, a, b, d)
                line(mut c, at, "movdqu xmm${a}, xmmword ptr ${mem(b, d)}")
                at = x86.Here(mut c)
                x86.MovdquMemX(mut c, b, d, a)
                line(mut c, at, "movdqu xmmword ptr ${mem(b, d)}, xmm${a}")
                at = x86.Here(mut c)
                x86.MovupdXMem(mut c, a, b, d)
                line(mut c, at, "movupd xmm${a}, xmmword ptr ${mem(b, d)}")
                at = x86.Here(mut c)
                x86.MovupdMemX(mut c, b, d, a)
                line(mut c, at, "movupd xmmword ptr ${mem(b, d)}, xmm${a}")
            }
        }
    }
    // float の load / store を xmm へ直に（1.0× アタック便）: movsd の [base + disp] と SIB
    for a <- iter.Range(0, 16) {
        for b <- iter.Range(0, 16) {
            for k <- iter.Range(0, len(disps)) {
                d := disps[k]
                mut at := x86.Here(mut c)
                x86.MovsdXMem(mut c, a, b, d)
                line(mut c, at, "movsd xmm${a}, qword ptr ${mem(b, d)}")
                at = x86.Here(mut c)
                x86.MovsdMemX(mut c, b, d, a)
                line(mut c, at, "movsd qword ptr ${mem(b, d)}, xmm${a}")
            }
            for ix <- iter.Range(0, 16) {
                if ix != x86.Rsp {
                    for si <- iter.Range(0, 2) {
                        sc := if si == 0 { x86.Scale1 } else { x86.Scale8 }
                        f := if si == 0 { 1 } else { 8 }
                        for k <- iter.Range(0, 3) {
                            d := if k == 0 { 0 } else if k == 1 { -8 } else { 4096 }
                            m := sibMem(b, ix, f, d)
                            mut at := x86.Here(mut c)
                            x86.MovsdXMemSib(mut c, a, b, ix, sc, d)
                            line(mut c, at, "movsd xmm${a}, qword ptr ${m}")
                            at = x86.Here(mut c)
                            x86.MovsdMemXSib(mut c, b, ix, sc, d, a)
                            line(mut c, at, "movsd qword ptr ${m}, xmm${a}")
                        }
                    }
                }
            }
        }
    }
    conds := []int{x86.CondE, x86.CondNe, x86.CondL, x86.CondGe, x86.CondLe, x86.CondG, x86.CondB, x86.CondAe, x86.CondA, x86.CondP, x86.CondNp}
    for k <- iter.Range(0, len(conds)) {
        mut at := x86.Here(mut c)
        x86.SetccAl(mut c, conds[k])
        line(mut c, at, "set${condName(conds[k])} al")
        at = x86.Here(mut c)
        x86.SetccCl(mut c, conds[k])
        line(mut c, at, "set${condName(conds[k])} cl")
    }
    mut at0 := x86.Here(mut c)
    x86.AndAlCl(mut c)
    line(mut c, at0, "and al, cl")
    at0 = x86.Here(mut c)
    x86.OrAlCl(mut c)
    line(mut c, at0, "or al, cl")
    mut at := x86.Here(mut c)
    x86.MovzxRaxAl(mut c)
    line(mut c, at, "movzx rax, al")
    at = x86.Here(mut c)
    x86.RepStosq(mut c)
    line(mut c, at, "rep stosq")
    at = x86.Here(mut c)
    x86.RepMovsb(mut c)
    line(mut c, at, "rep movsb")
    at = x86.Here(mut c)
    x86.RepMovsq(mut c)
    line(mut c, at, "rep movsq")
    at = x86.Here(mut c)
    x86.Cqo(mut c)
    line(mut c, at, "cqo")
    at = x86.Here(mut c)
    x86.Leave(mut c)
    line(mut c, at, "leave")
    at = x86.Here(mut c)
    x86.Ret(mut c)
    line(mut c, at, "ret")
    at = x86.Here(mut c)
    x86.Syscall(mut c)
    line(mut c, at, "syscall")
    at = x86.Here(mut c)
    x86.Ud2(mut c)
    line(mut c, at, "ud2")
}
