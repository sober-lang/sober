func DivsdXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0xf2, false, 0x5e, x, y)
}

// sqrtsd x, y — F2 0F 51 /r
func SqrtsdXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0xf2, false, 0x51, x, y)
}

// ucomisd x, y（unordered なら ZF = PF = CF = 1）— 66 0F 2E /r
func UcomisdXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0x66, false, 0x2e, x, y)
}

// cvtsi2sd x, r64 — F2 REX.W 0F 2A /r（reg = xmm・rm = 汎用）
func Cvtsi2sdXR(c mut table.Table[byte], x int, r int) {
    sseRR(mut c, 0xf2, true, 0x2a, x, r)
}

// cvttsd2si r64, x（0 方向の切り捨て・NaN と範囲外は i64 の最小値）— F2 REX.W 0F 2C /r（reg = 汎用・rm = xmm）
func Cvttsd2siRX(c mut table.Table[byte], r int, x int) {
    sseRR(mut c, 0xf2, true, 0x2c, r, x)
}

// setcc cl — 0F 9x C1
func SetccCl(c mut table.Table[byte], cond int) {
    put(mut c, 0x0f)
    put(mut c, 144 | cond)
    put(mut c, 0xc1)
}

// and al, cl — 20 C8
func AndAlCl(c mut table.Table[byte]) {
    put(mut c, 0x20)
    put(mut c, 0xc8)
}

// or al, cl — 08 C8
func OrAlCl(c mut table.Table[byte]) {
    put(mut c, 0x08)
    put(mut c, 0xc8)
}

// [pre] [REX] 0F op /r のメモリ形 [base + disp]（reg = xmm）
func sseMem(c mut table.Table[byte], pre int, op int, reg int, base int, disp int) {
    put(mut c, pre)
    rex(mut c, false, hi(reg), 0, hi(base), false)
    put(mut c, 0x0f)
    put(mut c, op)
    memOperand(mut c, lo(reg), base, disp)
}

// [pre] [REX] 0F op /r のメモリ形 [base + index * scale + disp]（opSib と同じ ModRM + SIB + disp の最短）
func sseSib(c mut table.Table[byte], pre int, op int, reg int, base int, index int, scale int, disp int) {
    put(mut c, pre)
    rex(mut c, false, hi(reg), hi(index), hi(base), false)
    put(mut c, 0x0f)
    put(mut c, op)
    mod := if disp == 0 && lo(base) != 5 { 0 } else if disp >= -128 && disp <= 127 { 1 } else { 2 }
    table.Push(mut c, modrm(mod, lo(reg), 4))
    put(mut c, scale << 6 | lo(index) << 3 | lo(base))
    if mod == 1 {
        put(mut c, disp & 255)
    } else if mod == 2 {
        imm32(mut c, disp)
    }
}

// movsd x, qword ptr [base + disp] — F2 0F 10 /r（float の load を xmm へ直に）
func MovsdXMem(c mut table.Table[byte], x int, base int, disp int) {
    sseMem(mut c, 0xf2, 0x10, x, base, disp)
}

// movsd qword ptr [base + disp], x — F2 0F 11 /r
func MovsdMemX(c mut table.Table[byte], base int, disp int, x int) {
    sseMem(mut c, 0xf2, 0x11, x, base, disp)
}

// movsd x, qword ptr [base + index * scale + disp] — F2 0F 10 /r + SIB
func MovsdXMemSib(c mut table.Table[byte], x int, base int, index int, scale int, disp int) {
    sseSib(mut c, 0xf2, 0x10, x, base, index, scale, disp)
}

// movsd qword ptr [base + index * scale + disp], x — F2 0F 11 /r + SIB
func MovsdMemXSib(c mut table.Table[byte], base int, index int, scale int, disp int, x int) {
    sseSib(mut c, 0xf2, 0x11, x, base, index, scale, disp)
}

// movdqu x, xmmword ptr [base + index * 1] — F3 0F 6F /r + SIB
func MovdquXMemSib(c mut table.Table[byte], x int, base int, index int) {
    put(mut c, 0xf3)
    rex(mut c, false, hi(x), hi(index), hi(base), false)
    put(mut c, 0x0f)
    put(mut c, 0x6f)
    mod := if lo(base) == 5 { 1 } else { 0 }
    table.Push(mut c, modrm(mod, lo(x), 4))
    put(mut c, lo(index) << 3 | lo(base))
    if mod == 1 {
        put(mut c, 0)
    }
}

// movdqu x, xmmword ptr [base + disp] — F3 0F 6F /r
func MovdquXMem(c mut table.Table[byte], x int, base int, disp int) {
    sseMem(mut c, 0xf3, 0x6f, x, base, disp)
}

// movdqu xmmword ptr [base + disp], x — F3 0F 7F /r
func MovdquMemX(c mut table.Table[byte], base int, disp int, x int) {
    sseMem(mut c, 0xf3, 0x7f, x, base, disp)
}

// MovdquXSib / MovdquSibX は movdqu の [base + index * 1 + disp] の読み / 書き — F3 0F 6F / 7F（rt.copy8 の短い写し — d-3）
func MovdquXSib(c mut table.Table[byte], x int, base int, index int, disp int) {
    sseSib(mut c, 0xf3, 0x6f, x, base, index, Scale1, disp)
}

func MovdquSibX(c mut table.Table[byte], base int, index int, disp int, x int) {
    sseSib(mut c, 0xf3, 0x7f, x, base, index, Scale1, disp)
}

// MovqXMem / MovqMemX は movq x, qword ptr [base + disp] / その逆 — F3 0F 7E /r・66 0F D6 /r（Sib は [base + index * 1 + disp]）
func MovqXMem(c mut table.Table[byte], x int, base int, disp int) {
    sseMem(mut c, 0xf3, 0x7e, x, base, disp)
}

func MovqMemX(c mut table.Table[byte], base int, disp int, x int) {
    sseMem(mut c, 0x66, 0xd6, x, base, disp)
}

func MovqXSib(c mut table.Table[byte], x int, base int, index int, disp int) {
    sseSib(mut c, 0xf3, 0x7e, x, base, index, Scale1, disp)
}

func MovqSibX(c mut table.Table[byte], base int, index int, disp int, x int) {
    sseSib(mut c, 0x66, 0xd6, x, base, index, Scale1, disp)
}

// MovdXMem / MovdMemX は movd x, dword ptr [base + disp] / その逆 — 66 0F 6E /r・66 0F 7E /r（Sib は [base + index * 1 + disp]）
func MovdXMem(c mut table.Table[byte], x int, base int, disp int) {
    sseMem(mut c, 0x66, 0x6e, x, base, disp)
}

func MovdMemX(c mut table.Table[byte], base int, disp int, x int) {
    sseMem(mut c, 0x66, 0x7e, x, base, disp)
}

func MovdXSib(c mut table.Table[byte], x int, base int, index int, disp int) {
    sseSib(mut c, 0x66, 0x6e, x, base, index, Scale1, disp)
}

func MovdSibX(c mut table.Table[byte], base int, index int, disp int, x int) {
    sseSib(mut c, 0x66, 0x7e, x, base, index, Scale1, disp)
}

// ── SSE2 packed double（packed f64 の語彙。SSE3 以上は使わない）──

// movupd x, xmmword ptr [base + disp]（非整列）— 66 0F 10 /r
func MovupdXMem(c mut table.Table[byte], x int, base int, disp int) {
    sseMem(mut c, 0x66, 0x10, x, base, disp)
}

// movupd xmmword ptr [base + disp], x — 66 0F 11 /r
func MovupdMemX(c mut table.Table[byte], base int, disp int, x int) {
    sseMem(mut c, 0x66, 0x11, x, base, disp)
}

// addpd x, y — 66 0F 58 /r
func AddpdXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0x66, false, 0x58, x, y)
}

// subpd x, y — 66 0F 5C /r
func SubpdXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0x66, false, 0x5c, x, y)
}

// mulpd x, y — 66 0F 59 /r
func MulpdXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0x66, false, 0x59, x, y)
}

// divpd x, y — 66 0F 5E /r
func DivpdXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0x66, false, 0x5e, x, y)
}

// sqrtpd x, y — 66 0F 51 /r
func SqrtpdXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0x66, false, 0x51, x, y)
}

// unpcklpd x, y（x = [x.lo, y.lo]）— 66 0F 14 /r
func UnpcklpdXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0x66, false, 0x14, x, y)
}

// unpckhpd x, y（x = [x.hi, y.hi]）— 66 0F 15 /r
func UnpckhpdXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0x66, false, 0x15, x, y)
}

// bsf dst, src — REX.W 0F BC /r
func BsfRR(c mut table.Table[byte], dst int, src int) {
    opRR(mut c, 0x0f, 0xbc, dst, src)
}

// rax を rdx:rax に符号拡張（idiv の前）— 48 99
func Cqo(c mut table.Table[byte]) {
    put(mut c, rexW)
    put(mut c, 0x99)
}

// mul reg — rax × reg（符号なし）→ rdx:rax — REX.W F7 /4
func MulReg(c mut table.Table[byte], reg int) {
    opExt(mut c, 0xf7, 4, reg)
}

// imul reg（1 オペランド）— rax × reg（符号つき）→ rdx:rax — REX.W F7 /5
func ImulReg1(c mut table.Table[byte], reg int) {
    opExt(mut c, 0xf7, 5, reg)
}

// idiv reg — rdx:rax / reg → 商 rax、余り rdx — REX.W F7 /7
func IdivReg(c mut table.Table[byte], reg int) {
    opExt(mut c, 0xf7, 7, reg)
}

// setcc al — 0F 9x C0（比較結果を 0 / 1 に）
func SetccAl(c mut table.Table[byte], cond int) {
    put(mut c, 0x0f)
    put(mut c, 144 | cond)
    put(mut c, 0xc0)
}

// movzx rax, al — 48 0F B6 C0
func MovzxRaxAl(c mut table.Table[byte]) {
    put(mut c, rexW)
    put(mut c, 0x0f)
    put(mut c, 0xb6)
    put(mut c, 0xc0)
}

// ── 制御 ─────────────────────────────────────────────────────────

// jmp rel32 — E9 cd。rel32 の位置（後埋め用）を返す
func JmpRel32(c mut table.Table[byte]) int {
    put(mut c, 0xe9)
    imm32(mut c, 0)
    return Here(mut c) - 4
}

// jcc rel32 — 0F 8x cd。rel32 の位置を返す
func JccRel32(c mut table.Table[byte], cond int) int {
    put(mut c, 0x0f)
    put(mut c, 128 | cond)
    imm32(mut c, 0)
    return Here(mut c) - 4
}

// jcc rel8 — 7x cb。rel8 の位置を返す（PatchRel8 で埋める — 前方 127 バイトまで）
func JccRel8(c mut table.Table[byte], cond int) int {
    put(mut c, 0x70 | cond)
    put(mut c, 0)
    return Here(mut c) - 1
}

// call rel32 — E8 cd。rel32 の位置を返す
func CallRel32(c mut table.Table[byte]) int {
    put(mut c, 0xe8)
    imm32(mut c, 0)
    return Here(mut c) - 4
}

// call r64 — FF /2（間接呼び出し）
func CallReg(c mut table.Table[byte], reg int) {
    rex(mut c, false, 0, 0, hi(reg), false)
    put(mut c, 0xff)
    put(mut c, 0xd0 | lo(reg))
}

// leave — C9（mov rsp, rbp; pop rbp）
func Leave(c mut table.Table[byte]) {
    put(mut c, 0xc9)
}

// ret — C3
func Ret(c mut table.Table[byte]) {
    put(mut c, 0xc3)
}

// syscall — 0F 05
func Syscall(c mut table.Table[byte]) {
    put(mut c, 0x0f)
    put(mut c, 0x05)
}

// ud2 — 0F 0B（到達しない印。_start の入口呼び出しの後ろ）
func Ud2(c mut table.Table[byte]) {
    put(mut c, 0x0f)
    put(mut c, 0x0b)
}

// 位置 at の 4 バイトを v（下位 32 bit・リトルエンディアン）で書き換える
func PatchImm32(c mut table.Table[byte], at int, v int) {
    table.Set(mut c, at, byte(v & 255))
    table.Set(mut c, at + 1, byte(v >> 8 & 255))
    table.Set(mut c, at + 2, byte(v >> 16 & 255))
    table.Set(mut c, at + 3, byte(v >> 24 & 255))
}

// 位置 at の rel32 を target への相対値（at + 4 からの差）で埋める
func PatchRel32(c mut table.Table[byte], at int, target int) {
    PatchImm32(mut c, at, target - (at + 4))
}
