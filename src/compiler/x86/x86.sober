package x86

// x86_64 の命令エンコーダ（src/stage1/arch/x86_64.zig の写し — 正規バックエンドの Sober 化）。IR を知らない。
// 書き先はバイトの表（table.Table[byte] — 追記と、call / jmp の rel32・番地の imm32 の後埋め）。
// 正しさは GNU as との照合（scripts/x86enc.sh — 全レジスタの組み合わせ）と、ELF のバイト一致（elfeq）で見る。
// ビットの詰め（REX・ModRM・SIB・opcode | reg）は int のシフトで書く — @layout のビット粒度は入れない（language.md 36 節）。
// オペコードは 16 進のリテラル（`0x89` — 注釈の綴り `REX.W 89 /r` と同じ字面）

import "std/table"

// レジスタ（番号 = エンコードの値。r8〜r15 は REX の拡張 bit で届く）
const Rax = 0
const Rcx = 1
const Rdx = 2
const Rbx = 3
const Rsp = 4
const Rbp = 5
const Rsi = 6
const Rdi = 7
const R8 = 8
const R9 = 9
const R10 = 10
const R11 = 11
const R12 = 12
const R13 = 13
const R14 = 14
const R15 = 15

// 条件コード（jcc / setcc の下位 4 bit）
const CondE = 4
const CondNe = 5
const CondL = 12
const CondGe = 13
const CondLe = 14
const CondG = 15
const CondB = 2  // 符号なし <
const CondAe = 3 // 符号なし >=
const CondA = 7  // 符号なし >
const CondBe = 6 // 符号なし <=
const CondP = 10  // パリティ（ucomisd の unordered — float の段）
const CondNp = 11

// SIB の倍率（2 bit）
const Scale1 = 0
const Scale8 = 3

const rexW = 0x48

func lo(r int) int {
    return r & 7
}

func hi(r int) int {
    return r >> 3
}

func modrm(mod int, reg int, rm int) byte {
    return byte(mod << 6 | reg << 3 | rm)
}

func put(c mut table.Table[byte], b int) {
    table.Push(mut c, byte(b))
}

// 今のコードの位置（ラベル・後埋めの位置）
func Here(c mut table.Table[byte]) int {
    return table.Len(mut c)
}

// REX 接頭辞（W = 64 bit、r = ModRM.reg の拡張、x = SIB.index の拡張、b = ModRM.rm / SIB.base / opcode の拡張）。
// 0x40 だけのとき（W も拡張も無い）は force のときだけ出す（spl / bpl / sil / dil のバイトレジスタ）
func rex(c mut table.Table[byte], w bool, r int, x int, b int, force bool) {
    v := 0x40 | (if w { 8 } else { 0 }) | r << 2 | x << 1 | b
    if v != 0x40 || force {
        put(mut c, v)
    }
}

func imm32(c mut table.Table[byte], v int) {
    put(mut c, v & 255)
    put(mut c, v >> 8 & 255)
    put(mut c, v >> 16 & 255)
    put(mut c, v >> 24 & 255)
}

// REX.W op /r のレジスタ形（reg = ModRM.reg、rm = ModRM.rm）。op2 は 2 バイト目（無ければ -1）
func opRR(c mut table.Table[byte], op1 int, op2 int, reg int, rm int) {
    rex(mut c, true, hi(reg), 0, hi(rm), false)
    put(mut c, op1)
    if op2 != -1 {
        put(mut c, op2)
    }
    table.Push(mut c, modrm(3, lo(reg), lo(rm)))
}

// REX.W op /ext のレジスタ形
func opExt(c mut table.Table[byte], op int, ext int, rm int) {
    rex(mut c, true, 0, 0, hi(rm), false)
    put(mut c, op)
    table.Push(mut c, modrm(3, ext, lo(rm)))
}

// ModRM(+SIB)(+disp) のメモリオペランド [base + disp]。as と同じく disp は 0 / disp8 / disp32 の最短を選ぶ。
// 下位 3 bit が 5（rbp / r13）は mod=00 が RIP 相対になるので disp8 以上、4（rsp / r12）は SIB（0x24）が要る
func memOperand(c mut table.Table[byte], reg int, base int, disp int) {
    rm := lo(base)
    mod := if disp == 0 && rm != 5 { 0 } else if disp >= -128 && disp <= 127 { 1 } else { 2 }
    table.Push(mut c, modrm(mod, reg, rm))
    if rm == 4 {
        put(mut c, 0x24)
    }
    if mod == 1 {
        put(mut c, disp & 255)
    } else if mod == 2 {
        imm32(mut c, disp)
    }
}

// op のメモリ形 [base + disp]。w = REX.W、reg は ModRM.reg に入るレジスタ番号（/ext なら ext）。op2 は 2 バイト目（無ければ -1）
func opMem(c mut table.Table[byte], w bool, op1 int, op2 int, reg int, base int, disp int, force bool) {
    rex(mut c, w, hi(reg), 0, hi(base), force)
    put(mut c, op1)
    if op2 != -1 {
        put(mut c, op2)
    }
    memOperand(mut c, lo(reg), base, disp)
}

// ── mov ──────────────────────────────────────────────────────────

// mov reg, imm32（64 bit に符号拡張）— REX.W C7 /0 id
func MovRegImm32(c mut table.Table[byte], reg int, imm int) {
    opExt(mut c, 0xc7, 0, reg)
    imm32(mut c, imm)
}

// movabs reg, imm64 — REX.W B8+r io
func MovRegImm64(c mut table.Table[byte], reg int, imm int) {
    rex(mut c, true, 0, 0, hi(reg), false)
    put(mut c, 0xb8 | lo(reg))
    imm32(mut c, imm)
    imm32(mut c, imm >> 32)
}

// mov dst, src — REX.W 89 /r（reg = src, rm = dst）
func MovRegReg(c mut table.Table[byte], dst int, src int) {
    opRR(mut c, 0x89, -1, src, dst)
}

// mov dst32, src32（上位 32 ビットを 0 に — `and x, 0xffffffff` の形）— 89 /r（REX.W なし）
func MovRegReg32(c mut table.Table[byte], dst int, src int) {
    rex(mut c, false, hi(src), 0, hi(dst), false)
    put(mut c, 0x89)
    table.Push(mut c, modrm(3, lo(src), lo(dst)))
}

// mov dst, [base + disp] — REX.W 8B /r
func MovRegMem(c mut table.Table[byte], dst int, base int, disp int) {
    opMem(mut c, true, 0x8b, -1, dst, base, disp, false)
}

// mov dst, qword ptr fs:[disp] — 64 REX.W 8B /r + SIB（base も index も無い disp32 の形）。ワーカーの記録の表を引く（IR の fsaddr）
func MovRegFs(c mut table.Table[byte], dst int, disp int) {
    put(mut c, 0x64)
    rex(mut c, true, hi(dst), 0, 0, false)
    put(mut c, 0x8b)
    table.Push(mut c, modrm(0, lo(dst), 4))
    put(mut c, 0x25)
    imm32(mut c, disp)
}

// ── 原子の op（IR の atomic。rt の中だけ）──
// LockXaddMemReg は lock xadd qword ptr [base + disp], src — F0 REX.W 0F C1 /r（src = 古い値）
func LockXaddMemReg(c mut table.Table[byte], base int, disp int, src int) {
    put(mut c, 0xf0)
    opMem(mut c, true, 0x0f, 0xc1, src, base, disp, false)
}

// xchg qword ptr [base + disp], src — REX.W 87 /r（メモリとの xchg は暗黙に lock — 全順序の柵）
func XchgMemReg(c mut table.Table[byte], base int, disp int, src int) {
    opMem(mut c, true, 0x87, -1, src, base, disp, false)
}

// lock cmpxchg qword ptr [base + disp], src — F0 REX.W 0F B1 /r（rax と比べて等しければ src を書く・rax = 古い値）
func LockCmpxchgMemReg(c mut table.Table[byte], base int, disp int, src int) {
    put(mut c, 0xf0)
    opMem(mut c, true, 0x0f, 0xb1, src, base, disp, false)
}

// mfence — 0F AE F0
func Mfence(c mut table.Table[byte]) {
    put(mut c, 0x0f)
    put(mut c, 0xae)
    put(mut c, 0xf0)
}

// lfence — 0F AE E8（前の命令が終わるまで後ろの命令を始めない — 計時の柵）
func Lfence(c mut table.Table[byte]) {
    put(mut c, 0x0f)
    put(mut c, 0xae)
    put(mut c, 0xe8)
}

// rdtscp — 0F 01 F9（edx:eax = 時刻の計数器・ecx = プロセッサの印 — 前の命令が終わってから読む）
func Rdtscp(c mut table.Table[byte]) {
    put(mut c, 0x0f)
    put(mut c, 0x01)
    put(mut c, 0xf9)
}

// rdtsc — 0F 31（edx:eax = 時刻の計数器 — 前後の命令と並べ替わりうる。順序の要らない粗い時計の口 — rt のスケジューラ）
func Rdtsc(c mut table.Table[byte]) {
    put(mut c, 0x0f)
    put(mut c, 0x31)
}

// pause — F3 90（スピンの待ちの 1 回）
func Pause(c mut table.Table[byte]) {
    put(mut c, 0xf3)
    put(mut c, 0x90)
}

// lea dst, [base + disp] — REX.W 8D /r
func LeaRegMem(c mut table.Table[byte], dst int, base int, disp int) {
    opMem(mut c, true, 0x8d, -1, dst, base, disp, false)
}

// mov [base + disp], src — REX.W 89 /r
func MovMemReg(c mut table.Table[byte], base int, disp int, src int) {
    opMem(mut c, true, 0x89, -1, src, base, disp, false)
}

// mov qword ptr [base + disp], imm32（符号拡張）— REX.W C7 /0 id
func MovMemImm32(c mut table.Table[byte], base int, disp int, imm int) {
    opMem(mut c, true, 0xc7, -1, 0, base, disp, false)
    imm32(mut c, imm)
}

// lea dst, [base + index * scale] — REX.W 8D /r + SIB（gep）。index に rsp は置けない。
// base の下位 3 bit が 5（rbp / r13）は mod=00 が「base 無し + disp32」になるので disp8 = 0 を付ける
func LeaRegSib(c mut table.Table[byte], dst int, base int, index int, scale int) {
    rex(mut c, true, hi(dst), hi(index), hi(base), false)
    put(mut c, 0x8d)
    sib := scale << 6 | lo(index) << 3 | lo(base)
    if lo(base) == 5 {
        table.Push(mut c, modrm(1, lo(dst), 4))
        put(mut c, sib)
        put(mut c, 0)
    } else {
        table.Push(mut c, modrm(0, lo(dst), 4))
        put(mut c, sib)
    }
}

// op のメモリ形 [base + index * scale + disp]（ModRM rm=100 + SIB — gep と load / store の融合）。
// index に rsp は置けない（SIB.index=100 + REX.X=0 が「index 無し」）。disp は as と同じく 0 / disp8 / disp32 の最短 —
// base の下位 3 bit が 5（rbp / r13）は mod=00 が「base 無し + disp32」なので disp8 以上
func opSib(c mut table.Table[byte], w bool, op1 int, op2 int, reg int, base int, index int, scale int, disp int, force bool) {
    rex(mut c, w, hi(reg), hi(index), hi(base), force)
    put(mut c, op1)
    if op2 != -1 {
        put(mut c, op2)
    }
    mod := if disp == 0 && lo(base) != 5 { 0 } else if disp >= -128 && disp <= 127 { 1 } else { 2 }
    table.Push(mut c, modrm(mod, lo(reg), 4))
    put(mut c, scale << 6 | lo(index) << 3 | lo(base))
    if mod == 1 {
        put(mut c, disp & 255)
    } else if mod == 2 {
        imm32(mut c, disp)
    }
}

// mov dst, qword ptr [base + index * scale + disp] — REX.W 8B /r + SIB
func MovRegMemSib(c mut table.Table[byte], dst int, base int, index int, scale int, disp int) {
    opSib(mut c, true, 0x8b, -1, dst, base, index, scale, disp, false)
}

// mov qword ptr [base + index * scale + disp], src — REX.W 89 /r + SIB
func MovMemRegSib(c mut table.Table[byte], base int, index int, scale int, disp int, src int) {
    opSib(mut c, true, 0x89, -1, src, base, index, scale, disp, false)
}

// movzx dst, byte ptr [base + index * scale + disp] — REX.W 0F B6 /r + SIB
func MovzxRegMem8Sib(c mut table.Table[byte], dst int, base int, index int, scale int, disp int) {
    opSib(mut c, true, 0x0f, 0xb6, dst, base, index, scale, disp, false)
}

// mov byte ptr [base + index * scale + disp], src8 — 88 /r + SIB（spl / bpl / sil / dil は REX 付き）
func MovMem8RegSib(c mut table.Table[byte], base int, index int, scale int, disp int, src int) {
    opSib(mut c, false, 0x88, -1, src, base, index, scale, disp, src >= 4 && src < 8)
}

// mov byte ptr [base + disp], src8 — 88 /r。spl / bpl / sil / dil と r8b〜 は REX 付き（as と同じ）
func MovMem8Reg(c mut table.Table[byte], base int, disp int, src int) {
    opMem(mut c, false, 0x88, -1, src, base, disp, src >= 4 && src < 8)
}

// MovChMem8 / MovMem8Ch は mov ch, byte ptr [base + disp] / その逆 — 8A /5・88 /5（REX なし — base は rax〜rdi だけ。rt.copy8 の短い写しが
// rcx の下の長さを残したまま 1 バイトを運ぶ — d-3）
func MovChMem8(c mut table.Table[byte], base int, disp int) {
    opMem(mut c, false, 0x8a, -1, 5, base, disp, false)
}

func MovMem8Ch(c mut table.Table[byte], base int, disp int) {
    opMem(mut c, false, 0x88, -1, 5, base, disp, false)
}

// movzx dst, byte ptr [base + disp] — REX.W 0F B6 /r
func MovzxRegMem8(c mut table.Table[byte], dst int, base int, disp int) {
    opMem(mut c, true, 0x0f, 0xb6, dst, base, disp, false)
}

// rep stosq — F3 48 AB（rcx 語を rdi から rax で埋める。フレームスロットの入口ゼロ初期化）
func RepStosq(c mut table.Table[byte]) {
    put(mut c, 0xf3)
    put(mut c, rexW)
    put(mut c, 0xab)
}

// rep movsb — F3 A4（rcx バイトを rsi から rdi へ。rt.copy8 の呼び出しの代わり）
func RepMovsb(c mut table.Table[byte]) {
    put(mut c, 0xf3)
    put(mut c, 0xa4)
}

// rep movsq — F3 48 A5（rcx 語を rsi から rdi へ。rt.copy の呼び出しの代わり）
func RepMovsq(c mut table.Table[byte]) {
    put(mut c, 0xf3)
    put(mut c, rexW)
    put(mut c, 0xa5)
}

// ── スタック ─────────────────────────────────────────────────────

// push reg — 50+r
func PushReg(c mut table.Table[byte], reg int) {
    rex(mut c, false, 0, 0, hi(reg), false)
    put(mut c, 0x50 | lo(reg))
}

// pop reg — 58+r
func PopReg(c mut table.Table[byte], reg int) {
    rex(mut c, false, 0, 0, hi(reg), false)
    put(mut c, 0x58 | lo(reg))
}

// ── 算術・論理（reg, reg。REX.W op /r、reg = src rm = dst） ──────

// add dst, src — 01 /r
func AddRegReg(c mut table.Table[byte], dst int, src int) {
    opRR(mut c, 0x01, -1, src, dst)
}

// sub dst, src — 29 /r
func SubRegReg(c mut table.Table[byte], dst int, src int) {
    opRR(mut c, 0x29, -1, src, dst)
}

// and dst, src — 21 /r
func AndRegReg(c mut table.Table[byte], dst int, src int) {
    opRR(mut c, 0x21, -1, src, dst)
}

// or dst, src — 09 /r
func OrRegReg(c mut table.Table[byte], dst int, src int) {
    opRR(mut c, 0x09, -1, src, dst)
}

// xor dst, src — 31 /r
func XorRegReg(c mut table.Table[byte], dst int, src int) {
    opRR(mut c, 0x31, -1, src, dst)
}

// cmp dst, src — 39 /r
func CmpRegReg(c mut table.Table[byte], dst int, src int) {
    opRR(mut c, 0x39, -1, src, dst)
}

// imul dst, src — REX.W 0F AF /r（reg = dst, rm = src）
func ImulRegReg(c mut table.Table[byte], dst int, src int) {
    opRR(mut c, 0x0f, 0xaf, dst, src)
}

// ── 算術・論理・比較（reg, [base + disp]。REX.W op /r、reg = dst — 読み元が spill 先のときの形）──

// add dst, [base + disp] — 03 /r
func AddRegMem(c mut table.Table[byte], dst int, base int, disp int) {
    opMem(mut c, true, 0x03, -1, dst, base, disp, false)
}

// sub dst, [base + disp] — 2B /r
func SubRegMem(c mut table.Table[byte], dst int, base int, disp int) {
    opMem(mut c, true, 0x2b, -1, dst, base, disp, false)
}

// and dst, [base + disp] — 23 /r
func AndRegMem(c mut table.Table[byte], dst int, base int, disp int) {
    opMem(mut c, true, 0x23, -1, dst, base, disp, false)
}

// or dst, [base + disp] — 0B /r
func OrRegMem(c mut table.Table[byte], dst int, base int, disp int) {
    opMem(mut c, true, 0x0b, -1, dst, base, disp, false)
}

// xor dst, [base + disp] — 33 /r
func XorRegMem(c mut table.Table[byte], dst int, base int, disp int) {
    opMem(mut c, true, 0x33, -1, dst, base, disp, false)
}

// cmp dst, [base + disp] — 3B /r
func CmpRegMem(c mut table.Table[byte], dst int, base int, disp int) {
    opMem(mut c, true, 0x3b, -1, dst, base, disp, false)
}

// imul dst, [base + disp] — REX.W 0F AF /r
func ImulRegMem(c mut table.Table[byte], dst int, base int, disp int) {
    opMem(mut c, true, 0x0f, 0xaf, dst, base, disp, false)
}

// imul dst, src, imm — as と同じ最短形: imm8 に収まれば REX.W 6B /r ib・それ以外は REX.W 69 /r id（reg = dst, rm = src・imm は 64 ビットへ符号拡張）
func ImulRegRegImm(c mut table.Table[byte], dst int, src int, imm int) {
    if imm >= -128 && imm <= 127 {
        opRR(mut c, 0x6b, -1, dst, src)
        put(mut c, imm & 255)
    } else {
        opRR(mut c, 0x69, -1, dst, src)
        imm32(mut c, imm)
    }
}

// op reg, imm — as と同じ最短形を選ぶ:
// imm8 に収まれば 83 /ext ib、rax なら短縮形（ext × 8 + 5）id、それ以外は 81 /ext id
func aluRegImm(c mut table.Table[byte], ext int, reg int, imm int) {
    if imm >= -128 && imm <= 127 {
        opExt(mut c, 0x83, ext, reg)
        put(mut c, imm & 255)
    } else {
        if reg == Rax {
            put(mut c, rexW)
            put(mut c, ext * 8 + 5)
        } else {
            opExt(mut c, 0x81, ext, reg)
        }
        imm32(mut c, imm)
    }
}

// add reg, imm
func AddRegImm(c mut table.Table[byte], reg int, imm int) {
    aluRegImm(mut c, 0, reg, imm)
}

// sub reg, imm
func SubRegImm(c mut table.Table[byte], reg int, imm int) {
    aluRegImm(mut c, 5, reg, imm)
}

// cmp reg, imm
func CmpRegImm(c mut table.Table[byte], reg int, imm int) {
    aluRegImm(mut c, 7, reg, imm)
}

// n バイトの詰め物（推奨の多バイト nop — 0F 1F /0 の形を 9 バイトまで・それ以上は 9 バイトずつ）。ループの頭・関数の先頭の整列
func Nop(c mut table.Table[byte], n int) {
    mut r := n
    while r > 0 {
        k := if r > 9 { 9 } else { r }
        if k == 1 {
            put(mut c, 0x90)
        } else if k == 2 {
            put(mut c, 0x66)
            put(mut c, 0x90)
        } else {
            if k == 6 || k == 9 {
                put(mut c, 0x66)
            }
            put(mut c, 0x0f)
            put(mut c, 0x1f)
            m := if k == 3 { 0 } else if k == 4 { 1 } else if k == 5 || k == 6 { 2 } else if k == 7 { 3 } else { 4 }
            if m == 0 {
                put(mut c, 0x00)
            } else if m == 1 {
                put(mut c, 0x40)
                put(mut c, 0x00)
            } else if m == 2 {
                put(mut c, 0x44)
                put(mut c, 0x00)
                put(mut c, 0x00)
            } else if m == 3 {
                put(mut c, 0x80)
                imm32(mut c, 0)
            } else {
                put(mut c, 0x84)
                put(mut c, 0x00)
                imm32(mut c, 0)
            }
        }
        r -= k
    }
}

// 位置 base + Here を a（2 の冪）の倍数へ nop で詰める
func AlignTo(c mut table.Table[byte], base int, a int) {
    Nop(mut c, (a - (base + Here(mut c)) % a) % a)
}

// test reg, imm32 — REX.W F7 /0 id（rax は REX.W A9 id）。imm8 の形は無い
func TestRegImm(c mut table.Table[byte], reg int, imm int) {
    if reg == Rax {
        put(mut c, rexW)
        put(mut c, 0xa9)
    } else {
        opExt(mut c, 0xf7, 0, reg)
    }
    imm32(mut c, imm)
}

// and reg, imm
func AndRegImm(c mut table.Table[byte], reg int, imm int) {
    aluRegImm(mut c, 4, reg, imm)
}

// neg reg — REX.W F7 /3
func NegReg(c mut table.Table[byte], reg int) {
    opExt(mut c, 0xf7, 3, reg)
}

// shl reg, cl — REX.W D3 /4（量は cl の下位 6 bit — IR の shl と同じ意味）
func ShlRegCl(c mut table.Table[byte], reg int) {
    opExt(mut c, 0xd3, 4, reg)
}

// sar reg, cl — REX.W D3 /7（算術右シフト）
func SarRegCl(c mut table.Table[byte], reg int) {
    opExt(mut c, 0xd3, 7, reg)
}

// shl reg, imm8 — REX.W C1 /4 ib（量 1 は REX.W D1 /4）
func ShlRegImm(c mut table.Table[byte], reg int, imm int) {
    if imm == 1 {
        opExt(mut c, 0xd1, 4, reg)
        return
    }
    opExt(mut c, 0xc1, 4, reg)
    put(mut c, imm & 255)
}

// shr reg, imm8 — REX.W C1 /5 ib（量 1 は REX.W D1 /5）（論理のずらし — 多倍長の塊 mulx.sober で使用）
func ShrRegImm(c mut table.Table[byte], reg int, imm int) {
    if imm == 1 {
        opExt(mut c, 0xd1, 5, reg)
        return
    }
    opExt(mut c, 0xc1, 5, reg)
    put(mut c, imm & 255)
}

// mulx hi, lo, src — rdx × src（符号なし）→ hi:lo・フラグを変えない（BMI2 — VEX.LZ.F2.0F38.W1 F6 /r: ModRM.reg = hi・VEX.vvvv = lo・
// ModRM.rm = src。多倍長の塊 mulx.sober で使用）
func MulxRRR(c mut table.Table[byte], hiR int, loR int, src int) {
    put(mut c, 0xc4)
    put(mut c, ((1 - hi(hiR)) << 7) | (1 << 6) | ((1 - hi(src)) << 5) | 0x02)
    put(mut c, 0x80 | ((15 - loR) << 3) | 3)
    put(mut c, 0xf6)
    table.Push(mut c, modrm(3, lo(hiR), lo(src)))
}

// 多倍長の塊の 64 bit の形: MULX のメモリ形・ADCX / ADOX（BMI2 / ADX — 2 本の独立な
// 繰り上がりの鎖 CF / OF）・SBB・JRCXZ（フラグを読まないループの戻り — 鎖の途中で add / cmp を使えない）。メモリは [base + disp]（index = -1）か
// [base + index * scale + disp]（index に rsp は置けない）

// ModRM(+SIB)(+disp) のメモリオペランド（index = -1 は memOperand の [base + disp]・それ以外は opSib と同じ SIB の形）
func memTail(c mut table.Table[byte], reg int, base int, index int, scale int, disp int) {
    if index < 0 {
        memOperand(mut c, reg, base, disp)
        return
    }
    mod := if disp == 0 && lo(base) != 5 { 0 } else if disp >= -128 && disp <= 127 { 1 } else { 2 }
    table.Push(mut c, modrm(mod, reg, 4))
    put(mut c, scale << 6 | lo(index) << 3 | lo(base))
    if mod == 1 {
        put(mut c, disp & 255)
    } else if mod == 2 {
        imm32(mut c, disp)
    }
}

// mulx hi, lo, qword ptr [mem] — rdx × [mem]（MulxRRR のメモリ形 — VEX.X / VEX.B が index / base の拡張）
func MulxRM(c mut table.Table[byte], hiR int, loR int, base int, index int, scale int, disp int) {
    xh := if index < 0 { 0 } else { hi(index) }
    put(mut c, 0xc4)
    put(mut c, ((1 - hi(hiR)) << 7) | ((1 - xh) << 6) | ((1 - hi(base)) << 5) | 0x02)
    put(mut c, 0x80 | ((15 - loR) << 3) | 3)
    put(mut c, 0xf6)
    memTail(mut c, lo(hiR), base, index, scale, disp)
}

// [pre] REX.W 0F 38 F6 /r（adcx = 66・adox = F3）のレジスタ形（rm >= 0 で mem = false）かメモリ形
func op38f6(c mut table.Table[byte], pre int, dst int, mem bool, rm int, index int, scale int, disp int) {
    put(mut c, pre)
    xh := if index < 0 { 0 } else { hi(index) }
    rex(mut c, true, hi(dst), if mem { xh } else { 0 }, hi(rm), false)
    put(mut c, 0x0f)
    put(mut c, 0x38)
    put(mut c, 0xf6)
    if mem {
        memTail(mut c, lo(dst), rm, index, scale, disp)
    } else {
        table.Push(mut c, modrm(3, lo(dst), lo(rm)))
    }
}

// adcx dst, src — dst += src + CF（CF だけを読み書き — 66 REX.W 0F 38 F6 /r）
func AdcxRR(c mut table.Table[byte], dst int, src int) {
    op38f6(mut c, 0x66, dst, false, src, -1, 0, 0)
}

// adox dst, src — dst += src + OF（OF だけを読み書き — F3 REX.W 0F 38 F6 /r）
func AdoxRR(c mut table.Table[byte], dst int, src int) {
    op38f6(mut c, 0xf3, dst, false, src, -1, 0, 0)
}

// adcx dst, qword ptr [mem]
func AdcxRM(c mut table.Table[byte], dst int, base int, index int, scale int, disp int) {
    op38f6(mut c, 0x66, dst, true, base, index, scale, disp)
}

// adox dst, qword ptr [mem]
func AdoxRM(c mut table.Table[byte], dst int, base int, index int, scale int, disp int) {
    op38f6(mut c, 0xf3, dst, true, base, index, scale, disp)
}

// sbb dst, src — dst -= src + CF（REX.W 19 /r）
func SbbRegReg(c mut table.Table[byte], dst int, src int) {
    opRR(mut c, 0x19, -1, src, dst)
}

// jrcxz rel8 — E3 cb（rcx = 0 なら跳ぶ・フラグを読まない）。rel8 の位置を返す（PatchRel8 で埋める — 前方 127 バイトまで）
func JrcxzRel8(c mut table.Table[byte]) int {
    put(mut c, 0xe3)
    put(mut c, 0)
    return Here(mut c) - 1
}

// 位置 at の rel8 を target への相対値（at + 1 からの差）で埋める（-128〜127 に収まることは呼び手が守る）
func PatchRel8(c mut table.Table[byte], at int, target int) {
    table.Set(mut c, at, byte((target - (at + 1)) & 255))
}

// sar reg, imm8 — REX.W C1 /7 ib（量 1 は as と同じく REX.W D1 /7）（2 のべき乗の定数での div / rem のシフト列で使用）
func SarRegImm(c mut table.Table[byte], reg int, imm int) {
    if imm == 1 {
        opExt(mut c, 0xd1, 7, reg)
        return
    }
    opExt(mut c, 0xc1, 7, reg)
    put(mut c, imm & 255)
}

// ── SSE2（整数 — ベクトル化向け。xmm の番号 0〜15・8 以上は REX の拡張）──

// [pre] [REX] 0F op /r のレジスタ形（reg = ModRM.reg・rm = ModRM.rm — どちらも xmm か汎用の番号）。w = REX.W
func sseRR(c mut table.Table[byte], pre int, w bool, op int, reg int, rm int) {
    put(mut c, pre)
    rex(mut c, w, hi(reg), 0, hi(rm), false)
    put(mut c, 0x0f)
    put(mut c, op)
    table.Push(mut c, modrm(3, lo(reg), lo(rm)))
}

// movdqa x, y — 66 0F 6F /r
func MovdqaXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0x66, false, 0x6f, x, y)
}

// pcmpeqb x, y — 66 0F 74 /r
func PcmpeqbXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0x66, false, 0x74, x, y)
}

// pcmpgtb x, y（符号つき）— 66 0F 64 /r
func PcmpgtbXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0x66, false, 0x64, x, y)
}

// pxor x, y — 66 0F EF /r
func PxorXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0x66, false, 0xef, x, y)
}

// por x, y — 66 0F EB /r
func PorXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0x66, false, 0xeb, x, y)
}

// psubb x, y（バイトごとの引き算 — 66 0F F8 /r）
func PsubbXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0x66, false, 0xf8, x, y)
}

// psadbw x, y（8 バイトずつの差の絶対値の和を 2 つの 64 ビットに — 66 0F F6 /r）
func PsadbwXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0x66, false, 0xf6, x, y)
}

// punpcklqdq x, y — 66 0F 6C /r
func PunpcklqdqXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0x66, false, 0x6c, x, y)
}

// punpckldq x, y（下位 2 つの 32 ビットのレーンを交互に — rt.jclean の 4〜7 バイトの道）— 66 0F 62 /r
func PunpckldqXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0x66, false, 0x62, x, y)
}

// pminub x, y（符号なしバイトごとの小さい方 — rt.jclean の 0x20 未満の判定）— 66 0F DA /r
func PminubXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0x66, false, 0xda, x, y)
}

// pmovmskb r32, x（各バイトの最上位 bit → 下位 16 bit）— 66 0F D7 /r（reg = 汎用・rm = xmm）
func PmovmskbRX(c mut table.Table[byte], r int, x int) {
    sseRR(mut c, 0x66, false, 0xd7, r, x)
}

// pandn x, y（x = ~x & y）— 66 0F DF /r（UTF-8 の検査器）
func PandnXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0x66, false, 0xdf, x, y)
}

// pslldq x, k（128 ビットを k バイト左へ — 下位側に 0）— 66 0F 73 /7 ib
func PslldqXI(c mut table.Table[byte], x int, k int) {
    sseRR(mut c, 0x66, false, 0x73, 7, x)
    put(mut c, k & 255)
}

// psrldq x, k（128 ビットを k バイト右へ — 上位側に 0）— 66 0F 73 /3 ib
func PsrldqXI(c mut table.Table[byte], x int, k int) {
    sseRR(mut c, 0x66, false, 0x73, 3, x)
    put(mut c, k & 255)
}

// pand x, y — 66 0F DB /r（CRC-32 の折り畳みの 32 ビットの印）
func PandXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0x66, false, 0xdb, x, y)
}

// psrlq x, k（64 ビットのレーンごとに k ビット右へ）— 66 0F 73 /2 ib
func PsrlqXI(c mut table.Table[byte], x int, k int) {
    sseRR(mut c, 0x66, false, 0x73, 2, x)
    put(mut c, k & 255)
}

// pclmulqdq x, y, imm（繰り上がりのない 64 × 64 → 128 ビットの積 — imm の bit 0 が x の・bit 4 が y の 64 ビットを選ぶ）—
// 66 [REX] 0F 3A 44 /r ib（PCLMULQDQ の CPU だけ — 使う側は CPUID の判定の後ろに置く）
func PclmulqdqXXI(c mut table.Table[byte], x int, y int, imm int) {
    put(mut c, 0x66)
    rex(mut c, false, hi(x), 0, hi(y), false)
    put(mut c, 0x0f)
    put(mut c, 0x3a)
    put(mut c, 0x44)
    table.Push(mut c, modrm(3, lo(x), lo(y)))
    put(mut c, imm & 255)
}

// 66 [REX] 0F 38 op /r（SSSE3 / AES-NI の 3 バイトの op の xmm × xmm）
func sse38(c mut table.Table[byte], op int, x int, y int) {
    put(mut c, 0x66)
    rex(mut c, false, hi(x), 0, hi(y), false)
    put(mut c, 0x0f)
    put(mut c, 0x38)
    put(mut c, op)
    table.Push(mut c, modrm(3, lo(x), lo(y)))
}

// aesenc x, y（AES の 1 段 — AES-NI の CPU だけ。std/crypto/aesgcm で使用）— 66 [REX] 0F 38 DC /r
func AesencXX(c mut table.Table[byte], x int, y int) {
    sse38(mut c, 0xdc, x, y)
}

// aesenclast x, y（最後の段）— 66 [REX] 0F 38 DD /r
func AesenclastXX(c mut table.Table[byte], x int, y int) {
    sse38(mut c, 0xdd, x, y)
}

// pshufb x, y（バイトの並べ替え — SSSE3。GHASH のバイト順の反転）— 66 [REX] 0F 38 00 /r
func PshufbXX(c mut table.Table[byte], x int, y int) {
    sse38(mut c, 0x00, x, y)
}

// aeskeygenassist x, y, imm（AES の鍵の展開の補助 — imm = rcon）— 66 [REX] 0F 3A DF /r ib
func AeskeygenassistXXI(c mut table.Table[byte], x int, y int, imm int) {
    put(mut c, 0x66)
    rex(mut c, false, hi(x), 0, hi(y), false)
    put(mut c, 0x0f)
    put(mut c, 0x3a)
    put(mut c, 0xdf)
    table.Push(mut c, modrm(3, lo(x), lo(y)))
    put(mut c, imm & 255)
}

// pshufd x, y, imm（32 ビットのレーンの並べ替え）— 66 [REX] 0F 70 /r ib
func PshufdXXI(c mut table.Table[byte], x int, y int, imm int) {
    sseRR(mut c, 0x66, false, 0x70, x, y)
    put(mut c, imm & 255)
}

// PslldXI / PsrldXI / PsradXI は 32 ビットのレーンごとの k ビットのずらし（左 / 論理右 / 算術右）— 66 [REX] 0F 72 /6 /2 /4 ib
func PslldXI(c mut table.Table[byte], x int, k int) {
    sseRR(mut c, 0x66, false, 0x72, 6, x)
    put(mut c, k & 255)
}

func PsrldXI(c mut table.Table[byte], x int, k int) {
    sseRR(mut c, 0x66, false, 0x72, 2, x)
    put(mut c, k & 255)
}

func PsradXI(c mut table.Table[byte], x int, k int) {
    sseRR(mut c, 0x66, false, 0x72, 4, x)
    put(mut c, k & 255)
}

// paddd x, y（32 ビットのレーンごとの和 — CTR の計数器）— 66 [REX] 0F FE /r
func PadddXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0x66, false, 0xfe, x, y)
}

// cpuid — 0F A2（eax の葉 → eax / ebx / ecx / edx を壊す）
func Cpuid(c mut table.Table[byte]) {
    put(mut c, 0x0f)
    put(mut c, 0xa2)
}

// movq x, r64 — 66 REX.W 0F 6E /r（reg = xmm・rm = 汎用）
func MovqXR(c mut table.Table[byte], x int, r int) {
    sseRR(mut c, 0x66, true, 0x6e, x, r)
}

// ── SSE2 scalar double（float の段 — language.md 37 節。値は汎用レジスタの binary64 のビット列 ⇄ xmm を movq で行き来）──

// movq r64, x — 66 REX.W 0F 7E /r（reg = xmm・rm = 汎用）
func MovqRX(c mut table.Table[byte], r int, x int) {
    sseRR(mut c, 0x66, true, 0x7e, x, r)
}

// movapd x, y（xmm の値の写し — opt バックエンドの float のレジスタ同士）— 66 0F 28 /r
func MovapdXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0x66, false, 0x28, x, y)
}

// addsd x, y — F2 0F 58 /r
func AddsdXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0xf2, false, 0x58, x, y)
}

// subsd x, y — F2 0F 5C /r
func SubsdXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0xf2, false, 0x5c, x, y)
}

// mulsd x, y — F2 0F 59 /r
func MulsdXX(c mut table.Table[byte], x int, y int) {
    sseRR(mut c, 0xf2, false, 0x59, x, y)
}

