    }
    // FS.Ty.renR.eq_19
    return mkLike4(mut st, a2, TMuRs, rmap(a0, a1, (tA(mut st, a2))), (tB(mut st, a2)), (tC(mut st, a2)), (tD(mut st, a2)))
}

// FS.Ty.relocA（方程式 22 本）
func relocA(st mut S, a0 int, a1 int, a2 int) int {
    switch tg(mut st, a2) {
    case TInt:
