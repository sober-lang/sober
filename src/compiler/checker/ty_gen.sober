// List.all の特殊化（tyArgOk）
func all_tyArgOk(st mut S, ts int) bool {
    if ts < 0 {
        return true
    }
    for i <- iter.Range(0, table.Get(mut st.h, ts)) {
        if !tyArgOk(mut st, table.Get(mut st.h, ts + 1 + i)) {
            return false
        }
    }
    return true
}

