    case TRef:
        // FS.Ty.renR.eq_10
        v_rho0 := a0
        v_delta := a1
        return mkLike(mut st, a2, TRef, b2i((tA(mut st, a2) != 0)), rmap(v_rho0, v_delta, (tB(mut st, a2))), renR(mut st, v_rho0, v_delta, (tC(mut st, a2))))
    case TSl:
        // FS.Ty.renR.eq_11
        v_rho0 := a0
        v_delta := a1
        return mkLike(mut st, a2, TSl, b2i((tA(mut st, a2) != 0)), rmap(v_rho0, v_delta, (tB(mut st, a2))), renR(mut st, v_rho0, v_delta, (tC(mut st, a2))))
    case TMp:
        // FS.Ty.renR.eq_12
        v_rho0 := a0
        v_delta := a1
        return mkLike(mut st, a2, TMp, b2i((tA(mut st, a2) != 0)), rmap(v_rho0, v_delta, (tB(mut st, a2))), renR(mut st, v_rho0, v_delta, (tC(mut st, a2))))
    case TChan:
        // FS.Ty.renR.eq_13
        v_rho0 := a0
        v_delta := a1
        return mkLike(mut st, a2, TChan, rmap(v_rho0, v_delta, (tA(mut st, a2))), renR(mut st, v_rho0, v_delta, (tB(mut st, a2))), 0)
    case TDom:
        // FS.Ty.renR.eq_14
        v_rho0 := a0
        v_delta := a1
        return mkLike(mut st, a2, TDom, rmap(v_rho0, v_delta, (tA(mut st, a2))), renR(mut st, v_rho0, v_delta, (tB(mut st, a2))), 0)
    case TFn:
        // FS.Ty.renR.eq_15
        return a2
    case TMuS:
        // FS.Ty.renR.eq_16
        return a2
    case TRVar:
        // FS.Ty.renR.eq_17
        return a2
    case TOwn:
