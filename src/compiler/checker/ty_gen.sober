    case TUn:
        // FS.Ty.renR.eq_8
        v_rho0 := a0
        v_delta := a1
        return mkLike(mut st, a2, TUn, renR(mut st, v_rho0, v_delta, (tA(mut st, a2))), renR(mut st, v_rho0, v_delta, (tB(mut st, a2))), 0)
