package main

// a1dumpの断片の外の負例: 再帰の値のフィールドをmut実引数に渡す（`mut k.next`）— A1の値は表と根で、フィールドをmutの場所として渡す形が無い。a1dumpはexit 2で拒否する（scripts/a1oracle.shの負例の列）

type K struct {
    v int
    next K?
}

func setTail(n mut K?, v int) {
    n = K{v: v, next: nil}
}

func main() {
    mut k := K{v: 1, next: nil}
    setTail(mut k.next, 2)
    nx := k.next
    if nx != nil {
        println(nx.v)
    }
}
