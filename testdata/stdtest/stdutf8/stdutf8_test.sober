package stdutf8

// std/utf8 の black-box の表駆動テスト（Go のオラクル scripts/utf8_oracle.ts と併存。`bin/sober test testdata/stdtest/stdutf8`）。
// std/utf8 の中に置けないのは、std/testing → std/io → std/utf8 の import の循環のため

import "std/iter"
import "std/strings"

type Case struct {
    b []byte
    at int
}

func TestIndexInvalid() {
    cases := []Case{
        Case{b: []byte{}, at: 0 - 1},
        Case{b: []byte{104, 105}, at: 0 - 1},
        Case{b: []byte{195, 169}, at: 0 - 1},
        Case{b: []byte{192, 128}, at: 0},
        Case{b: []byte{194}, at: 0},
        Case{b: []byte{65, 227, 129, 65}, at: 1},
        Case{b: []byte{237, 160, 128}, at: 0},
        Case{b: []byte{240, 159, 152, 128}, at: 0 - 1},
        Case{b: []byte{244, 144, 128, 128}, at: 0},
        Case{b: []byte{97, 98, 128, 99}, at: 2},
    }
    for i <- iter.Range(0, len(cases)) {
        c := cases[i]
        got := strings.IndexInvalid(c.b)
        assert(got == c.at)
        assert(strings.Valid(c.b) == (c.at < 0))
    }
}

func TestParse() {
    s, err := string([]byte{104, 105})
    assert(err == nil)
    assert(s == "hi")
    _, bad := string([]byte{97, 255})
    assert(bad != nil)
}
