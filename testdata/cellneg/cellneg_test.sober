package cellneg

// checkキャッシュのパスの文面の検査: 脱糖の拒否diag.Cell（関数値を貯めるcell — kind 11）が配置先の当たり・外れのどちらでも同じ文面（diag.Wordsのtag 14）

import "std/testing/cell"

type F func(n int) int

const C = testing.cell.Cell[F]{init: (n) => n}

func TestHoldsFunction() {
    testing.cell.Set(C, (n) => n + 1)
    assert(One() == 1)
}
