package main

import "testdata/fix/lib"

func Shown(x int) {
    println(testdata.fix.lib.Pure(x))
}

func main() {
    v, e := testdata.fix.lib.Check(3)
    w, e2 := testdata.fix.lib.Strict(4)
    testdata.fix.lib.Wide(v + w)
    testdata.fix.lib.Nap(0)
    Shown(testdata.fix.lib.Quiet(1))
    if e != nil || e2 != nil {
        println(-1)
    }
}
