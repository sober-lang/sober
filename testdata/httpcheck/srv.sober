package main

// HttpArena の題材のサーバ（gate httpcheck の相手 — srv <port>〔0 = 空いている番号〕）: /baseline11・/pipeline・/delay/{ms}・/json/{count}?m=・
// /stream/{n}・/file（応答の stream — report-763）・/sse・/sse-body（SSE — 便 8 の段 8-3）・/static/*（http.server.Static — STATIC_ROOT の下・precompressed — report-956）・POST /echo（要求の本文をそのまま返す — HttpArena の 8gbit の端点・CL と chunked の受けの byte 一致の網 — report-848）・POST /upload（http.server.Multipart の部分の列を
// 1 行 1 部分〔name TAB filename か - TAB Content-Type TAB 長さ TAB 本文の和〕で返す — 読めなければ 400・report-1022）。
// "ready <port>" を出してから受ける（bench/httparena/main.sober と同じ route — /json の dataset は DATASET_PATH〔httpcheck.sh が testdata/httpcheck/dataset.json を渡す〕）。
// 応答の gzip は既定の level（compression: http.server.Gzip{} — json-comp の検査は check.ts の jsonComp・SRV_FRESH が空でなければ Gzip{fresh: true} = 接続ごとの記録なし）。SRV_WORK が空でなければ符号器の作業域を
// ワーカー局所の lease で借りる（ServeConn の work: — report-720。httpcheck.sh が両方の構成で回す）。SRV_MAXBODY（バイト）があれば ServeConn の maxBody:
// （既定 16 KiB — httpcheck.sh の echo の大きい本文の構成〔8gbit の検査の 100 KB と上限 128 KiB〕だけが渡す）
// SRV_TLS_PORT があれば平文の代わりに TLS で 127.0.0.1:<SRV_TLS_PORT> に立つ（tls.Serve + ServeWith の put: = `(b) => tls.Put(c, b)` — bench/httparena の
// TLS の形。"tls-ready <port>" を出してから待ち受ける・httpcheck.sh の SRV_TLS=1 の構成 + check.ts --tls）

import "std/compress/flate"
import "std/convert"
import "std/http"
import "std/http/server"
import "std/io"
import "std/iter"
import "std/json"
import "std/net"
import "std/os"
import "std/strings"
import "std/task"
import "std/tls"

// num は数でなければ 0（go-stdlib と同じ寛容さ）
func num(s string?) int {
    if s == nil {
        return 0
    }
    v, e := convert.ParseInt(s)
    return if e != nil { 0 } else { v }
}

type Rating struct {
    score int
    count int
}

// Item は dataset の 1 本
type Item struct {
    id int
    name string
    category string
    price int
    quantity int
    active bool
    tags []string
    rating Rating
}

// Processed は応答の 1 本（Item の欄 + total）
type Processed struct {
    id int
    name string
    category string
    price int
    quantity int
    active bool
    tags []string
    rating Rating
    total int
}

type Body struct {
    items []Processed
    count int
}

// dpath は dataset の置き場（DATASET_PATH — 無ければ /data/dataset.json）
func dpath() string {
    p, _ := os.Getenv("DATASET_PATH")
    return if p != nil { p } else { "/data/dataset.json" }
}

// load は dataset（JSON の配列）を読む（読めない・形が違えば空 — go-stdlib と同じくサーバは立つ）
func load() []Item {
    b := io.ReadFile(dpath()) catch return []Item{}
    d := json.Parse(b) catch return []Item{}
    ns := json.Items(d, json.Root(d)) catch return []Item{}
    mut xs := mut []Item{}
    mut i := 0
    while i < len(ns) {
        x, e := json.Decode[Item](d, ns[i])
        if e != nil {
            return []Item{}
        }
        xs = append(xs, x)
        i += 1
    }
    return freeze(xs)
}

// items は /json/{count}?m= の応答（毎要求で組んで直列化する）
func items(ds []Item, r http.server.Request) http.server.Response {
    c := num(strings.TrimPrefix(r.path, "/json/"))
    n := if c < 0 { 0 } else if c > len(ds) { len(ds) } else { c }
    m0 := num(http.server.Query(r, "m"))
    m := if m0 == 0 { 1 } else { m0 }
    mut out := mut []Processed{}
    for i <- iter.Range(0, n) {
        d := ds[i]
        out = append(out, Processed{id: d.id, name: d.name, category: d.category, price: d.price, quantity: d.quantity, active: d.active, tags: d.tags, rating: d.rating, total: d.price * d.quantity * m})
    }
    return http.server.Json(json.Encode[Body](Body{items: freeze(out), count: n}))
}

// genBytes は /stream/{n} の本文: 'a' + i % 26 の n バイトを 1000 バイトずつ emit する（stream の閉包の網 — report-763）
func genBytes(n int, out mut http.server.Out, emit func(out mut http.server.Out, b []byte) error?) error? {
    mut i := 0
    while i < n {
        k := if n - i < 1000 { n - i } else { 1000 }
        mut b := mut []byte{}
        for j <- iter.Range(0, k) {
            b = append(b, byte(97 + (i + j) % 26))
        }
        emit(mut out, freeze(b))?
        i += k
    }
    return nil
}

// sendFile は /file の本文: path を stream の中で開いて切片ごとに emit する（File は閉包に捕捉させない — 28 節）
func sendFile(path string, out mut http.server.Out, emit func(out mut http.server.Out, b []byte) error?) error? {
    f := io.Open(path)?
    defer io.Close(f)
    for b <- io.Chunks(f)? {
        emit(mut out, io.Raw(b))?
    }
    return nil
}

// stream は /stream/{n}（n バイトの生成）と /file（dataset を stream で — 長さは起動時に読んだ大きさ）の応答
func stream(dp string, dl int, r http.server.Request) http.server.Response {
    if r.path == "/file" {
        return http.server.Response{status: 200, contentType: "application/json", length: dl, stream: (out, emit) => sendFile(dp, mut out, emit)}
    }
    n0 := num(strings.TrimPrefix(r.path, "/stream/"))
    n := if n0 < 0 { 0 } else { n0 }
    return http.server.Response{status: 200, contentType: "text/plain", length: n, stream: (out, emit) => genBytes(n, mut out, emit)}
}

// chunked は /chunked/{n}?k=&e=&fail= の応答（長さ不定の stream — chunked で送る・HTTP/1.0 は閉じで区切る — 便 8 の段 8-2）: 'a' + i % 26 の n バイトを
// k バイト（既定 1000）ずつ emit・e=1 なら各 emit の前に空の emit を挟む（送られないこと）・fail=m なら m バイト送った後で誤りを返す（終端を書かずに閉じる）。
// len=L なら長さ既知（length: L — n と食い違えば合計の検査で閉じる・compress + stream の段 8-5）・bin=1 なら application/octet-stream（圧縮しない Content-Type）
func chunked(r http.server.Request) http.server.Response {
    n0 := num(strings.TrimPrefix(r.path, "/chunked/"))
    n := if n0 < 0 { 0 } else { n0 }
    k0 := num(http.server.Query(r, "k"))
    k := if k0 <= 0 { 1000 } else { k0 }
    em := http.server.Query(r, "e") != nil
    fl := if http.server.Query(r, "fail") != nil { num(http.server.Query(r, "fail")) } else { 0 - 1 }
    ct := if http.server.Query(r, "bin") != nil { "application/octet-stream" } else { "text/plain" }
    if http.server.Query(r, "len") != nil {
        ln := num(http.server.Query(r, "len"))
        return http.server.Response{status: 200, contentType: ct, length: ln, stream: (out, emit) => genChunks(n, k, em, fl, mut out, emit)}
    }
    return http.server.Response{status: 200, contentType: ct, stream: (out, emit) => genChunks(n, k, em, fl, mut out, emit)}
}

// genChunks は chunked の本文（genBytes の切り方を k で・空の emit・途中の誤り）
func genChunks(n int, k int, em bool, fl int, out mut http.server.Out, emit func(out mut http.server.Out, b []byte) error?) error? {
    mut i := 0
    while i < n {
        if fl >= 0 && i >= fl {
            return io.Other{errno: 5}
        }
        m := if n - i < k { n - i } else { k }
        mut b := mut []byte{}
        for j <- iter.Range(0, m) {
            b = append(b, byte(97 + (i + j) % 26))
        }
        if em {
            emit(mut out, []byte{})?
        }
        emit(mut out, freeze(b))?
        i += m
    }
    return nil
}

// slow は /chunked-slow の応答（"first" を emit してから 300 ms 待って "second" — emit 1 回 = 送り 1 回の網: 受け手は stream が返る前に 1 つ目を受ける）
func slow(r http.server.Request) http.server.Response {
    return http.server.Response{status: 200, contentType: "text/plain", stream: (out, emit) => slowBody(mut out, emit)}
}

func slowBody(out mut http.server.Out, emit func(out mut http.server.Out, b []byte) error?) error? {
    emit(mut out, bytes("first"))?
    os.Sleep(300)
    emit(mut out, bytes("second"))?
    return nil
}

// sse は /sse?n= の応答（Server-Sent Events — 便 8 の段 8-3）: Last-Event-ID の次の番号から n 個（既定 2）のイベント（event: tick・data は 2 行・id = 番号）。
// 1 つ目の後に 300 ms 待つ（到着の網: 1 つ目は stream が返る前に届く）・最後に retry: 100 の終わりのイベント。保存させない（NoStore）
func sse(r http.server.Request) http.server.Response {
    n0 := num(http.server.Query(r, "n"))
    n := if n0 <= 0 { 2 } else { n0 }
    from := num(http.server.Header(r, "Last-Event-ID"))
    return http.server.Response{status: 200, contentType: "text/event-stream", cache: http.server.NoStore{}, stream: (out, emit) => sseBody(from, n, mut out, emit)}
}

func sseBody(from int, n int, out mut http.server.Out, emit func(out mut http.server.Out, b []byte) error?) error? {
    mut i := from + 1
    while i <= from + n {
        emit(mut out, bytes(http.server.FormatEvent(http.server.Event{event: "tick", data: "n=${i}\r\nsq=${i * i}", id: convert.FormatInt(i)})))?
        if i == from + 1 {
            os.Sleep(300)
        }
        i += 1
    }
    emit(mut out, bytes(http.server.FormatEvent(http.server.Event{event: "end", data: "", retry: 100})))?
    return nil
}

// sseFlat は /sse-body の応答（text/event-stream の body 2000 バイト — compression: の対象外: Content-Encoding も Vary も付かない）
func sseFlat(r http.server.Request) http.server.Response {
    mut b := mut []byte{}
    for x <- bytes(": pad\n\n") {
        b = append(b, x)
    }
    while len(b) < 2000 {
        for x <- bytes(http.server.FormatEvent(http.server.Event{data: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"})) {
            b = append(b, x)
        }
    }
    return http.server.Response{status: 200, contentType: "text/event-stream", body: freeze(b)}
}

// me は認証に届く応答（Cookie の sid を返す — 共有の宣言をしない: 既定の private。出所の動的オラクルの「網が鳴る」側 — check.ts の originEp）
func me(r http.server.Request) http.server.Response {
    s := http.server.Cookie(r, "sid")
    return http.server.Text("sid=${if s != nil { s } else { "-" }}")
}

// sharedRoutes は共有キャッシュも保存してよいルート（Static の Shared・動的な Fresh — 認証に届かない: analyzer が受理する）と /me
func sharedRoutes(root string) []http.server.Route {
    pub := []http.server.Route{http.server.Route{method: "GET", path: "/pub", handler: (r) => http.server.Text("pub ${if http.server.Query(r, "x") != nil { "x" } else { "-" }}"), cache: http.server.Fresh{maxAge: 60}},
        http.server.Route{method: "GET", path: "/me", handler: me}}
    return http.server.Merge(http.server.Static("/shared", root, cache: http.server.Shared{maxAge: 60, sMaxAge: 600}), pub)
}

func route(ds []Item, st []http.server.Route, sh []http.server.Route, dp string, dl int, r http.server.Request) http.server.Response {
    return switch {
    case strings.HasPrefix(r.path, "/static/"): http.server.Dispatch(st, r)
    case strings.HasPrefix(r.path, "/shared/") || r.path == "/pub" || r.path == "/me": http.server.Dispatch(sh, r)
    case r.path == "/file" || strings.HasPrefix(r.path, "/stream/"): stream(dp, dl, r)
    case strings.HasPrefix(r.path, "/chunked/"): chunked(r)
    case r.path == "/chunked-slow": slow(r)
    case r.path == "/sse": sse(r)
    case r.path == "/sse-body": sseFlat(r)
    case r.path == "/pipeline": http.server.Text("ok")
    case r.path == "/upload": if r.method == "POST" { upload(r) } else { http.server.Status(405) }
    case r.path == "/echo": if r.method == "POST" { http.server.Response{status: 200, contentType: "application/octet-stream", body: r.body} } else { http.server.Status(405) }
    case r.path == "/baseline11": {
        body := if r.method == "POST" { num(string(r.body) catch "") } else { 0 }
        http.server.Text(convert.FormatInt(num(http.server.Query(r, "a")) + num(http.server.Query(r, "b")) + body))
    }
    case strings.HasPrefix(r.path, "/delay/"): {
        ms := num(strings.TrimPrefix(r.path, "/delay/"))
        os.Sleep(ms)
        http.server.Text(convert.FormatInt(ms))
    }
    case strings.HasPrefix(r.path, "/json/"): items(ds, r)
    default: http.server.Status(404)
    }
}

// upload は POST /upload の応答（部分ごとに name・filename〔nil は "-"〕・Content-Type・本文の長さ・本文の和〔Σ b[i] × (i + 1) mod 1000000007〕の 1 行）
func upload(r http.server.Request) http.server.Response {
    parts := http.server.Multipart(r) catch return http.server.Status(http.BadRequest)
    mut out := ""
    for i <- iter.Range(0, len(parts)) {
        p := parts[i]
        f := p.filename
        fname := if f == nil { "-" } else { f }
        mut sum := 0
        for k <- iter.Range(0, len(p.body)) {
            sum = (sum + int(p.body[k]) * (k + 1)) % 1000000007
        }
        out = out + "${p.name}\t${fname}\t${p.contentType}\t${convert.FormatInt(len(p.body))}\t${convert.FormatInt(sum)}\n"
    }
    return http.server.Text(out)
}

// workOf は work: の値（SRV_WORK が無いか空なら nil — 要求ごとに作業域を取る形）
func workOf(sw string?, g task.Local) task.Local? {
    if sw == nil || sw == "" {
        return nil
    }
    return g
}

func run(port string) error? {
    ds := load()
    dp := dpath()
    dl := len(io.ReadFile(dp) catch []byte{})
    sw := os.Getenv("SRV_WORK") catch nil
    wk := workOf(sw, task.NewLocal((w mut compress.flate.Work) => compress.flate.NewWork(mut w)))
    mb0 := num(os.Getenv("SRV_MAXBODY") catch nil)
    mb := if mb0 > 0 { mb0 } else { 16384 }
    sr := os.Getenv("STATIC_ROOT") catch nil
    st := http.server.Static("/static", if sr != nil { sr } else { "/nonexistent" }, precompressed: true)
    sh := sharedRoutes(if sr != nil { sr } else { "/nonexistent" })
    tp := os.Getenv("SRV_TLS_PORT") catch nil
    if tp == nil || tp == "" {
        return plain(port, ds, st, sh, dp, dl, mb, wk)
    }
    // TLS の構成: 同じ route を tls.Serve の上の ServeWith（put: = tls.Put — 応答の列を積む口）で 127.0.0.1:<SRV_TLS_PORT> に立てる（平文の待ち受けは立てない）
    cfg := tls.Load("testdata/crypto/httparena-server.crt", "testdata/crypto/httparena-server.key")?
    println("tls-ready ${tp}")
    return serveTls(tp, cfg, ds, if sr != nil { sr } else { "/nonexistent" }, dp, dl, mb)
}

func plain(port string, ds []Item, st []http.server.Route, sh []http.server.Route, dp string, dl int, mb int, wk task.Local?) error? {
    for l <- net.Listen("0.0.0.0:${port}")? {
        println("ready ${net.Port(l)}")
        fz := os.Getenv("SRV_FRESH") catch nil
        fresh := fz != nil && fz != ""
        net.Serve(l, (c net.Conn) => http.server.ServeConn(c, (r http.server.Request) => route(ds, st, sh, dp, dl, r), maxBody: mb, compression: http.server.Gzip{fresh: fresh}, work: wk), conns: 40000)?
    }
    return nil
}

// TLS の構成の待ち受け（符号器の作業域は要求ごと — work: は平文の構成だけが見る・route の表は接続ごとに組む — Handler の閉包は平たい値だけを捕捉する）
func serveTls(tp string, cfg tls.Config, ds []Item, root string, dp string, dl int, mb int) error? {
    return tls.Serve("127.0.0.1:${tp}", cfg, (c tls.Conn) => serveTlsConn(c, ds, root, dp, dl, mb))
}

func serveTlsConn(c tls.Conn, ds []Item, root string, dp string, dl int, mb int) error? {
    st := http.server.Static("/static", root, precompressed: true)
    sh := sharedRoutes(root)
    return http.server.ServeWith((k) => tls.Recv(c, k), (b) => tls.Send(c, b), (r http.server.Request) => route(ds, st, sh, dp, dl, r), maxBody: mb, compression: http.server.Gzip{},
        put: (b) => tls.Put(c, b))
}

func main() int {
    args := os.Args() catch return 2
    if len(args) != 2 {
        return 2
    }
    e := run(args[1])
    return if e != nil { 1 } else { 0 }
}
