package main

// HttpArena の題材のサーバ（gate httpcheck の相手 — srv <port>〔0 = 空いている番号〕）: /baseline11・/pipeline・/delay/{ms}・/json/{count}?m=・
// /stream/{n}・/file（応答の stream — report-763）・POST /echo（要求の本文をそのまま返す — HttpArena の 8gbit の端点・CL と chunked の受けの byte 一致の網 — report-848）。
// "ready <port>" を出してから受ける（bench/httparena/main.sober と同じ route — /json の dataset は DATASET_PATH〔httpcheck.sh が testdata/httpcheck/dataset.json を渡す〕）。
// 応答の gzip は既定の level（compress: http.Gzip{} — json-comp の検査は check.ts の jsonComp）。SRV_WORK が空でなければ符号器の作業域を
// ワーカー局所の lease で借りる（ServeConn の work: — report-720。httpcheck.sh が両方の構成で回す）。SRV_MAXBODY（バイト）があれば ServeConn の maxBody:
// （既定 16 KiB — httpcheck.sh の echo の大きい本文の構成〔8gbit の検査の 100 KB と上限 128 KiB〕だけが渡す）

import "std/compress/flate"
import "std/convert"
import "std/http"
import "std/io"
import "std/iter"
import "std/json"
import "std/net"
import "std/os"
import "std/task"
import "std/strings"

// num は数でなければ 0（go-stdlib と同じ寛容さ）
func num(s string?) int {
    if s == nil {
        return 0
    }
    v, e := convert.ParseInt(s)
    return if e != nil { 0 } else { v }
}

type Rating struct {
    score int
    count int
}

// Item は dataset の 1 本
type Item struct {
    id int
    name string
    category string
    price int
    quantity int
    active bool
    tags []string
    rating Rating
}

// Processed は応答の 1 本（Item の欄 + total）
type Processed struct {
    id int
    name string
    category string
    price int
    quantity int
    active bool
    tags []string
    rating Rating
    total int
}

type Body struct {
    items []Processed
    count int
}

// dpath は dataset の置き場（DATASET_PATH — 無ければ /data/dataset.json）
func dpath() string {
    p, _ := os.Getenv("DATASET_PATH")
    return if p != nil { p } else { "/data/dataset.json" }
}

// load は dataset（JSON の配列）を読む（読めない・形が違えば空 — go-stdlib と同じくサーバは立つ）
func load() []Item {
    b := io.ReadFile(dpath()) catch return []Item{}
    d := json.Parse(b) catch return []Item{}
    ns := json.Items(d, json.Root(d)) catch return []Item{}
    mut xs := mut []Item{}
    mut i := 0
    while i < len(ns) {
        x, e := json.Decode[Item](d, ns[i])
        if e != nil {
            return []Item{}
        }
        xs = append(xs, x)
        i += 1
    }
    return freeze(xs)
}

// items は /json/{count}?m= の応答（毎要求で組んで直列化する）
func items(ds []Item, r http.Request) http.Response {
    c := num(strings.TrimPrefix(r.path, "/json/"))
    n := if c < 0 { 0 } else if c > len(ds) { len(ds) } else { c }
    m0 := num(http.Query(r, "m"))
    m := if m0 == 0 { 1 } else { m0 }
    mut out := mut []Processed{}
    for i <- iter.Range(0, n) {
        d := ds[i]
        out = append(out, Processed{id: d.id, name: d.name, category: d.category, price: d.price, quantity: d.quantity, active: d.active, tags: d.tags, rating: d.rating, total: d.price * d.quantity * m})
    }
    return http.Json(json.Encode[Body](Body{items: freeze(out), count: n}))
}

// genBytes は /stream/{n} の本文: 'a' + i % 26 の n バイトを 1000 バイトずつ emit する（stream の閉包の網 — report-763）
func genBytes(n int, emit func(b []byte) error?) error? {
    mut i := 0
    while i < n {
        k := if n - i < 1000 { n - i } else { 1000 }
        mut b := mut []byte{}
        for j <- iter.Range(0, k) {
            b = append(b, byte(97 + (i + j) % 26))
        }
        emit(freeze(b))?
        i += k
    }
    return nil
}

// sendFile は /file の本文: path を stream の中で開いて切片ごとに emit する（File は閉包に捕捉させない — 28 節）
func sendFile(path string, emit func(b []byte) error?) error? {
    f := io.Open(path)?
    defer io.Close(f)
    for b <- io.Chunks(f)? {
        emit(io.Raw(b))?
    }
    return nil
}

// stream は /stream/{n}（n バイトの生成）と /file（dataset を stream で — 長さは起動時に読んだ大きさ）の応答
func stream(dp string, dl int, r http.Request) http.Response {
    if r.path == "/file" {
        return http.Response{status: 200, contentType: "application/json", length: dl, stream: (emit) => sendFile(dp, emit)}
    }
    n0 := num(strings.TrimPrefix(r.path, "/stream/"))
    n := if n0 < 0 { 0 } else { n0 }
    return http.Response{status: 200, contentType: "text/plain", length: n, stream: (emit) => genBytes(n, emit)}
}

func route(ds []Item, dp string, dl int, r http.Request) http.Response {
    return switch {
    case r.path == "/file" || strings.HasPrefix(r.path, "/stream/"): stream(dp, dl, r)
    case r.path == "/pipeline": http.Text("ok")
    case r.path == "/echo": if r.method == "POST" { http.Response{status: 200, contentType: "application/octet-stream", body: r.body} } else { http.Status(405) }
    case r.path == "/baseline11": {
        body := if r.method == "POST" { num(string(r.body) catch "") } else { 0 }
        http.Text(convert.FormatInt(num(http.Query(r, "a")) + num(http.Query(r, "b")) + body))
    }
    case strings.HasPrefix(r.path, "/delay/"): {
        ms := num(strings.TrimPrefix(r.path, "/delay/"))
        os.Sleep(ms)
        http.Text(convert.FormatInt(ms))
    }
    case strings.HasPrefix(r.path, "/json/"): items(ds, r)
    default: http.Status(404)
    }
}

// workOf は work: の値（SRV_WORK が無いか空なら nil — 要求ごとに作業域を取る形）
func workOf(sw string?, g task.Local) task.Local? {
    if sw == nil || sw == "" {
        return nil
    }
    return g
}

func run(port string) error? {
    ds := load()
    dp := dpath()
    dl := len(io.ReadFile(dp) catch []byte{})
    sw := os.Getenv("SRV_WORK") catch nil
    wk := workOf(sw, task.NewLocal((w mut flate.Work) => flate.Prepare(mut w)))
    mb0 := num(os.Getenv("SRV_MAXBODY") catch nil)
    mb := if mb0 > 0 { mb0 } else { 16384 }
    for l <- net.Listen("0.0.0.0:${port}")? {
        println("ready ${net.Port(l)}")
        net.Serve(l, (c net.Conn) => http.ServeConn(c, (r http.Request) => route(ds, dp, dl, r), maxBody: mb, compress: http.Gzip{}, work: wk), conns: 40000)?
    }
    return nil
}

func main() int {
    args := os.Args() catch return 2
    if len(args) != 2 {
        return 2
    }
    e := run(args[1])
    return if e != nil { 1 } else { 0 }
}
