package main

// 読まない相手への常駐の検査（scripts/httpcheck.sh）: /big は256 KiBの本文。"ready <port>" を出してから受ける

import "std/http/server"
import "std/net"

func big() []byte {
    mut b := mut []byte{}
    mut i := 0
    while i < 262144 {
        b = append(b, 97)
        i += 1
    }
    return freeze(b)
}

func route(r http.server.Request) http.server.Response {
    if r.path == "/big" {
        return http.server.Response{status: 200, contentType: "text/plain", body: big()}
    }
    return http.server.Text("ok\n")
}

func app(c net.Conn) error? {
    return http.server.ServeConn(c, route)
}

func serve() error? {
    for l <- net.Listen("127.0.0.1:0")? {
        println("ready ${net.Port(l)}")
        net.Serve(l, app)?
    }
    return nil
}

func main() int {
    return if serve() == nil { 0 } else { 1 }
}
