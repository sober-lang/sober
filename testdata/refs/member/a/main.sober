package main

// refsのフィールド・仮引数の負例（report-885）: testdata.refs.member.m.Handleの仮引数scaleを名前つきで渡す呼び出しと、同名の仮引数を持つ別の関数otherへの名前つき実引数
// （補間の穴の中と外の両方）。
// 最後の testdata.refs.member.m.Check は panic ラベル testdata.refs.member.m.Oops を印字して終わる（ラベルの改名で ELF が変わり alphacheck V3 が実行の写像まで降りる形）

import "testdata/refs/member/m"

func other(scale int) int {
    return scale + 1
}

func main() {
    q := testdata.refs.member.m.Req{code: 2, path: "/x"}
    r := testdata.refs.member.m.Handle(q, scale: 3)
    println("${r.code} ${q.code} ${r.body} ${other(scale: 1)} ${testdata.refs.member.m.Handle(q, scale: 2).code}")
    println(other(scale: 4))
    println(testdata.refs.member.m.Render(testdata.refs.member.m.Wire{code: r.code, inner: testdata.refs.member.m.Inner{tag: "t"}}))
    testdata.refs.member.m.Check(code: q.code - 10)
}
