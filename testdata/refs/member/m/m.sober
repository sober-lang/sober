package m

// refsのフィールド・仮引数の負例（report-885）: 同綴りのフィールドcodeを3つの型（Req・Resp・panicラベルOops）に置く — 対象は1つの持ち主のフィールドだけ。
// Wire / Innerはjson.Encodeに届く型（フィールド名 = JSONのキー — 改名はwireの互換を変える）・Req / Respは届かない

import "std/json"

type Req struct {
    code int
    path string
}

type Resp struct {
    code int
    body string
}

type Wire struct {
    code int
    inner Inner
}

type Inner struct {
    tag string
}

type Oops panic {
    code int
}

func Handle(req Req, scale int) Resp {
    r := Resp{code: req.code * scale, body: req.path}
    return r
}

func Render(w Wire) string {
    return json.Encode[Wire](w)
}

func Check(code int) {
    if code < 0 {
        panic(Oops{code: code})
    }
}
