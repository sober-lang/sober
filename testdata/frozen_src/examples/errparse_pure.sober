package main

// V4-4e の突き合わせの対（Lean 側: Examples.lean の v46）。errparse.sober から出力を抜いた形。
// 各入力の結果を 1 語に符号化して畳み込み、main の末尾の値 r を codegen は println で、Lean は脱糖したコアを機械で走らせて照合する

type UnexpectedChar error {
    pos int
}

type UnexpectedEnd error {
    pos int
}

// want はトークンの種類（0 = 項、5 = ')'、6 = 入力の終わり）
type Expected error {
    pos int
    want int
}

// 包み替えの行き先。K3 なので内側の位置は捨てられ、何番目の入力かだけが残る
type BadInput error {
    which int
}

// kind: 0 = 数、1 = '+'、2 = '-'、3 = '*'、4 = '('、5 = ')'、6 = 入力の終わり
type Token struct {
    kind, pos, val int
}

func isDigit(c int) bool {
    return c >= 48 && c <= 57
}

func punct(c int, at int) (int, error?) {
    if c == 43 { return 1, nil }
    if c == 45 { return 2, nil }
    if c == 42 { return 3, nil }
    if c == 40 { return 4, nil }
    if c == 41 { return 5, nil }
    return 0, UnexpectedChar{pos: at}
}

// ループ内の ? — slice の結果成分のゼロ値（空 slice）は関数入口で束縛される（Z1）
func lex(text string) ([]Token, error?) {
    src := bytes(text)
    mut toks := mut []Token{}
    mut i := 0
    while i < len(src) {
        c := src[i]
        if c == 32 || c == 10 {
            i += 1
        } else if isDigit(c) {
            mut j := i
            mut v := 0
            while j < len(src) && isDigit(src[j]) {
                v = v * 10 + src[j] - 48
                j += 1
            }
            toks = append(toks, Token{0, i, v})
            i = j
        } else {
            k := punct(c, i)?
            toks = append(toks, Token{k, i, 0})
            i += 1
        }
    }
    toks = append(toks, Token{6, len(src), 0})
    return freeze(toks), nil
}

// factor := 数 | '-' factor | '(' expr ')'。結果は（値, 次の位置, err）の 3 成分
func factor(ts []Token, i int) (int, int, error?) {
    t := ts[i]
    if t.kind == 0 {
        return t.val, i + 1, nil
    }
    if t.kind == 2 {
        v, j := factor(ts, i + 1)?
        return 0 - v, j, nil
    }
    if t.kind == 4 {
        v, j := expr(ts, i + 1)?
        if ts[j].kind != 5 {
            return 0, 0, Expected{pos: ts[j].pos, want: 5}
        }
        return v, j + 1, nil
    }
    if t.kind == 6 {
        return 0, 0, UnexpectedEnd{pos: t.pos}
    }
    return 0, 0, Expected{pos: t.pos, want: 0}
}

// term := factor ('*' factor)*
func term(ts []Token, i int) (int, int, error?) {
    v0, j0 := factor(ts, i)?
    mut v := v0
    mut j := j0
    while ts[j].kind == 3 {
        r, k := factor(ts, j + 1)?
        v = v * r
        j = k
    }
    return v, j, nil
}

// expr := term (('+' | '-') term)*
func expr(ts []Token, i int) (int, int, error?) {
    v0, j0 := term(ts, i)?
    mut v := v0
    mut j := j0
    while ts[j].kind == 1 || ts[j].kind == 2 {
        r, k := term(ts, j + 1)?
        v = if ts[j].kind == 1 { v + r } else { v - r }
        j = k
    }
    return v, j, nil
}

func run(text string) (int, error?) {
    ts := lex(text)?
    v, j := expr(ts, 0)?
    if ts[j].kind != 6 {
        return 0, Expected{pos: ts[j].pos, want: 6}
    }
    return v, nil
}

// トップの包み替え: どちらの入力で落ちたかに置き換える
func sum2(a string, b string) (int, error?) {
    x := run(a)? BadInput{which: 1}
    y := run(b)? BadInput{which: 2}
    return x + y, nil
}

// バイトオフセット → (line, col)。どちらも 1 始まり
func lineCol(text string, pos int) (int, int) {
    src := bytes(text)
    mut line := 1
    mut col := 1
    mut i := 0
    while i < pos {
        if src[i] == 10 {
            line += 1
            col = 1
        } else {
            col += 1
        }
        i += 1
    }
    return line, col
}

func errPos(e error) int {
    return switch e {
    case UnexpectedChar{pos}: pos
    case UnexpectedEnd{pos}: pos
    case Expected{pos, want}: pos
    case BadInput{which}: 0
    }
}

// 結果の符号化: 成功は値、失敗は 種類 * 100000 + want * 10000 + line * 100 + col（包み替えは 900000 + which）
func code(text string) int {
    v, err := run(text)
    return if err != nil {
        l, c := lineCol(text, errPos(err))
        switch err {
        case UnexpectedChar{pos}: 100000 + l * 100 + c
        case UnexpectedEnd{pos}: 200000 + l * 100 + c
        case Expected{pos, want}: 300000 + want * 10000 + l * 100 + c
        case BadInput{which}: 900000 + which
        }
    } else {
        v
    }
}

func codeSum(a string, b string) int {
    v, err := sum2(a, b)
    return if err != nil {
        switch err {
        case BadInput{which}: 900000 + which
        case UnexpectedChar{pos}: 0 - 1
        case UnexpectedEnd{pos}: 0 - 1
        case Expected{pos, want}: 0 - 1
        }
    } else {
        v
    }
}

func main() {
    mut r := 0
    r = r * 31 + code("1 + 2 * (3 - 4)")
    r = r * 31 + code("12 * 3\n  + 4 * -5")
    r = r * 31 + code("1 + $")
    r = r * 31 + code("2 * (3 + 4")
    r = r * 31 + code("7 +\n\n")
    r = r * 31 + code("1 2")
    r = r * 31 + code("3 *\n + 1")
    r = r * 31 + codeSum("1+1", "2*")
    r = r * 31 + codeSum("5", "(6)")
    println(r)
    r
}
