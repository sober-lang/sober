package main

// Go の unicode/utf8 との突き合わせ。生成物 — scripts/utf8_oracle.ts から再生成する

import "std/utf8"

func show(b []int) {
    s, err := string(b)
    if err != nil {
        switch err {
        case utf8.InvalidUtf8{pos}: println("bad", pos)
        }
    } else {
        println("ok", s)
    }
}

func main() {
    println(utf8.Invalid([]int{}), utf8.Valid([]int{}))
    show([]int{})
    println(utf8.Invalid([]int{104, 105}), utf8.Valid([]int{104, 105}))
    show([]int{104, 105})
    println(utf8.Invalid([]int{0}), utf8.Valid([]int{0}))
    show([]int{0})
    println(utf8.Invalid([]int{127}), utf8.Valid([]int{127}))
    show([]int{127})
    println(utf8.Invalid([]int{195, 169}), utf8.Valid([]int{195, 169}))
    show([]int{195, 169})
    println(utf8.Invalid([]int{194, 128}), utf8.Valid([]int{194, 128}))
    show([]int{194, 128})
    println(utf8.Invalid([]int{223, 191}), utf8.Valid([]int{223, 191}))
    show([]int{223, 191})
    println(utf8.Invalid([]int{192, 128}), utf8.Valid([]int{192, 128}))
    show([]int{192, 128})
    println(utf8.Invalid([]int{193, 191}), utf8.Valid([]int{193, 191}))
    show([]int{193, 191})
    println(utf8.Invalid([]int{194}), utf8.Valid([]int{194}))
    show([]int{194})
    println(utf8.Invalid([]int{194, 65}), utf8.Valid([]int{194, 65}))
    show([]int{194, 65})
    println(utf8.Invalid([]int{224, 160, 128}), utf8.Valid([]int{224, 160, 128}))
    show([]int{224, 160, 128})
    println(utf8.Invalid([]int{224, 159, 191}), utf8.Valid([]int{224, 159, 191}))
    show([]int{224, 159, 191})
    println(utf8.Invalid([]int{227, 129, 130}), utf8.Valid([]int{227, 129, 130}))
    show([]int{227, 129, 130})
    println(utf8.Invalid([]int{237, 159, 191}), utf8.Valid([]int{237, 159, 191}))
    show([]int{237, 159, 191})
    println(utf8.Invalid([]int{237, 160, 128}), utf8.Valid([]int{237, 160, 128}))
    show([]int{237, 160, 128})
    println(utf8.Invalid([]int{238, 128, 128}), utf8.Valid([]int{238, 128, 128}))
    show([]int{238, 128, 128})
    println(utf8.Invalid([]int{239, 191, 191}), utf8.Valid([]int{239, 191, 191}))
    show([]int{239, 191, 191})
    println(utf8.Invalid([]int{239, 191, 189}), utf8.Valid([]int{239, 191, 189}))
    show([]int{239, 191, 189})
    println(utf8.Invalid([]int{227, 129}), utf8.Valid([]int{227, 129}))
    show([]int{227, 129})
    println(utf8.Invalid([]int{65, 227, 129, 65}), utf8.Valid([]int{65, 227, 129, 65}))
    show([]int{65, 227, 129, 65})
    println(utf8.Invalid([]int{240, 144, 128, 128}), utf8.Valid([]int{240, 144, 128, 128}))
    show([]int{240, 144, 128, 128})
    println(utf8.Invalid([]int{240, 143, 191, 191}), utf8.Valid([]int{240, 143, 191, 191}))
    show([]int{240, 143, 191, 191})
    println(utf8.Invalid([]int{240, 159, 152, 128}), utf8.Valid([]int{240, 159, 152, 128}))
    show([]int{240, 159, 152, 128})
    println(utf8.Invalid([]int{244, 143, 191, 191}), utf8.Valid([]int{244, 143, 191, 191}))
    show([]int{244, 143, 191, 191})
    println(utf8.Invalid([]int{244, 144, 128, 128}), utf8.Valid([]int{244, 144, 128, 128}))
    show([]int{244, 144, 128, 128})
    println(utf8.Invalid([]int{245, 128, 128, 128}), utf8.Valid([]int{245, 128, 128, 128}))
    show([]int{245, 128, 128, 128})
    println(utf8.Invalid([]int{240, 159, 152}), utf8.Valid([]int{240, 159, 152}))
    show([]int{240, 159, 152})
    println(utf8.Invalid([]int{255}), utf8.Valid([]int{255}))
    show([]int{255})
    println(utf8.Invalid([]int{254}), utf8.Valid([]int{254}))
    show([]int{254})
    println(utf8.Invalid([]int{128}), utf8.Valid([]int{128}))
    show([]int{128})
    println(utf8.Invalid([]int{191}), utf8.Valid([]int{191}))
    show([]int{191})
    println(utf8.Invalid([]int{97, 195, 169, 226, 130, 172, 240, 159, 152, 128}), utf8.Valid([]int{97, 195, 169, 226, 130, 172, 240, 159, 152, 128}))
    show([]int{97, 195, 169, 226, 130, 172, 240, 159, 152, 128})
    println(utf8.Invalid([]int{97, 98, 128, 99}), utf8.Valid([]int{97, 98, 128, 99}))
    show([]int{97, 98, 128, 99})
}
