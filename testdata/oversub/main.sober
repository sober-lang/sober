package main

// oversub（scripts/oversub.sh）の題材: ワーカーの数がCPUより多い形で、rtの鍵とdomainを取り合う仕事が決まった時間の内に終わるか。
// 5つの仕事を同時に走らせ、数だけを印字する（スケジュールに依らない）。仕事は domainの取り合い（Update）・Awaitで借りて返すプール・
// チャネルの送り手と受け手の対・spawnとJoinの木・net.Serveへの往復（ハンドラがdomainを更新する）

import "std/iter"
import "std/net"
import "std/task"

type Ctr struct {
    n int
}

type Pool struct {
    idle int
    used int
}

const nTasks = 32
const nUpd = 200000
const nPool = 4
const nBorrow = 2000
const nPairs = 8
const nMsg = 20000
const nConns = 16
const nReq = 500

func main() {
    println(run() catch "listen failed")
}

func run() (string, error?) {
    mut out := ""
    for l <- net.Listen("127.0.0.1:0")? {
        port := net.Port(l)
        r, e := task.Run((s task.Scope) => {
            hits := task.NewDomain(s, Ctr{n: 0})
            a := task.Spawn(s, () => updates())
            b := task.Spawn(s, () => borrows())
            c := task.Spawn(s, () => pipes())
            t := task.Spawn(s, () => tree(12))
            mut cs := mut []task.Handle[int]{}
            for k <- iter.Range(0, nConns) {
                cs = append(cs, task.Spawn(s, () => client(port, k)))
            }
            _, _ = task.Run((s2 task.Scope) => {
                _ = net.Serve(l, (cn net.Conn) => echo(cn, hits))
                0
            }, deadline: 3000 * task.MS)
            mut got := 0
            for v <- task.Gather(cs) {
                got += v
            }
            "update ${task.Join(a)} borrow ${task.Join(b)} chan ${task.Join(c)} tree ${task.Join(t)} serve ${got} hits ${task.Read(hits, (x Ctr) => x.n)}"
        }, deadline: 60000 * task.MS)
        out = if e == nil { r } else { "died" }
    }
    return out, nil
}

// nTasks本のtaskが1つのdomainをnUpd回ずつ更新する
func updates() int {
    r, _ := task.Run((s task.Scope) => {
        d := task.NewDomain(s, Ctr{n: 0})
        _, _ = task.Run((s2 task.Scope) => {
            for k <- iter.Range(0, nTasks) {
                _ = task.Spawn(s2, () => {
                    for i <- iter.Range(0, nUpd) {
                        _ = task.Update(d, (x mut Ctr) => {
                            x.n += 1
                            0
                        })
                    }
                    0
                })
            }
            0
        })
        task.Read(d, (x Ctr) => x.n)
    })
    return r
}

// nTasks本のtaskが、nPool本の枠をAwaitで借りて返す（std/pgのプールの形）
func borrows() int {
    r, _ := task.Run((s task.Scope) => {
        d := task.NewDomain(s, Pool{idle: nPool, used: 0}, wait: 30000 * task.MS)
        _, _ = task.Run((s2 task.Scope) => {
            for k <- iter.Range(0, nTasks) {
                _ = task.Spawn(s2, () => {
                    for i <- iter.Range(0, nBorrow) {
                        _, _ = task.Await(d, (x mut Pool) => {
                            x.idle -= 1
                            x.used += 1
                            0
                        }, when: (x Pool) => x.idle > 0)
                        _ = task.Update(d, (x mut Pool) => {
                            x.idle += 1
                            0
                        })
                    }
                    0
                })
            }
            0
        })
        task.Read(d, (x Pool) => x.used)
    })
    return r
}

// nPairs組のチャネルでnMsg個ずつ送って受けた和
func pipes() int {
    r, _ := task.Run((s task.Scope) => {
        mut hs := mut []task.Handle[int]{}
        for k <- iter.Range(0, nPairs) {
            hs = append(hs, task.Spawn(s, () => pair()))
        }
        mut sum := 0
        for v <- task.Gather(hs) {
            sum += v
        }
        sum
    })
    return r
}

// 送り手を1本spawnし、自分が受ける
func pair() int {
    r, _ := task.Run((s task.Scope) => {
        tx, rx := task.NewChannel[int](cap: 16)
        _ = task.Spawn(s, (out) => {
            for i <- iter.Range(0, nMsg) {
                task.Send(out, 1)
            }
            task.Close(out)
            0
        }, give: tx)
        mut n := 0
        task.RecvAll(rx, (v int) => {
            n += v
        })
        n
    })
    return r
}

// 深さdの二分木のspawnとJoin（葉の数）
func tree(d int) int {
    if d == 0 {
        return 1
    }
    r, _ := task.Run((s task.Scope) => {
        x := task.Spawn(s, () => tree(d - 1))
        y := task.Spawn(s, () => tree(d - 1))
        task.Join(x) + task.Join(y)
    })
    return r
}

// 1バイトを受けるたびにdomainを更新して1バイト返す
func echo(c net.Conn, hits task.Domain[Ctr]) error? {
    for chunk <- net.Recv(c)? {
        _ = task.Update(hits, (x mut Ctr) => {
            x.n += 1
            0
        })
        net.Send(c, chunk)?
    }
    return nil
}

// nReq回の往復（返った回数・失敗なら0）
func client(port int, k int) int {
    return ask(port) catch 0
}

func ask(port int) (int, error?) {
    mut n := 0
    for a <- net.Dial("127.0.0.1:${port}")? {
        for i <- iter.Range(0, nReq) {
            net.Send(a, bytes("x"))?
            for chunk <- net.Recv(a)? {
                n += len(chunk)
                break
            }
        }
    }
    return n, nil
}
