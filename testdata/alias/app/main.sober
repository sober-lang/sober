package main

// 利用者の形: wrap の公開の名前だけを書く（実体の package lib は import しない — loader が合成の import を足す）

import "testdata/alias/wrap"
// （双子の alias_x はここで lib を import する — 行を揃える）

func main() {
    mut w := wrap.Work{}
    xs := []int{3, 5, 10}
    for x <- xs {
        wrap.Feed(mut w, x)
    }
    r := wrap.Mean(w)
    println(wrap.Value(r), wrap.Value(wrap.Mean(wrap.Work{})))
    println(wrap.Twice((x int) => x * 3, 2))
    a := wrap.NewAcc(9)
    println(wrap.Last(a))
    mut ws := mut []wrap.W2{}
    ws = append(ws, w)
    println(len(ws), other(ws[0]))
}
