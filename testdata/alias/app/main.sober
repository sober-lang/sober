package main

// 利用者の形: wrap の公開の名前だけを書く（実体の package lib は import しない — loader が合成の import を足す）

import "testdata/alias/wrap"
// （双子の alias_x はここで lib を import する — 行を揃える）

func main() {
    mut w := testdata.alias.wrap.Work{}
    xs := []int{3, 5, 10}
    for x <- xs {
        testdata.alias.wrap.Feed(mut w, x)
    }
    r := testdata.alias.wrap.Mean(w)
    println(testdata.alias.wrap.Value(r), testdata.alias.wrap.Value(testdata.alias.wrap.Mean(testdata.alias.wrap.Work{})))
    println(testdata.alias.wrap.Twice((x int) => x * 3, 2))
    a := testdata.alias.wrap.NewAcc(9)
    println(testdata.alias.wrap.Last(a))
    mut ws := mut []testdata.alias.wrap.W2{}
    ws = append(ws, w)
    println(len(ws), other(ws[0]))
}
