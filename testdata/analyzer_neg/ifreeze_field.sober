package main

// フィールドをimmのsliceのリテラルの要素にした後、兄弟のフィールドから書く（暗黙のfreeze・U2 — フィールドの凍結は根ごと）

type B struct {
    xs mut []byte
    ys mut []byte
}

func main() int {
    mut b := B{xs: mut []byte{65, 66, 67}, ys: mut []byte{}}
    b.ys = b.xs
    ls := [][]byte{b.xs}
    b.ys[0] = 200
    println("${int(ls[0][0])}")
    return 0
}
