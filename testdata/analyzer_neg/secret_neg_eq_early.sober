package main

// ctcheckの負例negEqEarly（testdata/ctcheck/app.sober — 機械語の検査が分岐を数える見本）のanalyzer版: 食い違いで早く抜ける比較は拒否（crypto.Equalの形にする）

import "std/iter"

@secret(a, b)
func negEqEarly(a []byte, b []byte) bool {
    if len(a) != len(b) {
        return false
    }
    for i <- iter.Range(0, len(a)) {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

func main() {
    println(negEqEarly([]byte{1, 2}, []byte{1, 3}))
}
