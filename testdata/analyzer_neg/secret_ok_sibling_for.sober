package main

// analyzerの秘密の流れ: 兄弟のforの同じ名前のループ変数を混同しない（後のforの公開の添字の分岐は秘密でない）

import "std/iter"

@secret(k)
func f(k []byte, n int) int {
    mut acc := 0
    for i <- k {
        acc = acc ^ int(i)
    }
    mut c := 0
    for i <- iter.Range(0, 3) {
        if i < n {
            c += 1
        }
    }
    return acc + c
}

func main() {
    println(f([]byte{1, 2}, 2))
}
