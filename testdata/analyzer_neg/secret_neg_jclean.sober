package main

// 可変時間の組み込みへの秘密（SIMD の核 段 2 — report-1165）: json の文字列の書き出しは最初のエスケープの要るバイトで止まる走査（rt.jclean）を通るので、
// 秘密の文字列を JSON に書くと拒否

import "std/builder"
import "std/json"

@secret(a)
func negQuote(a string) int {
    mut o := builder.Builder[byte]{}
    json.PutString(mut o, a)
    return builder.Len(mut o)
}

func main() {
    println(negQuote("token"))
}
