package main

import "std/http/server"

// 外で組んだSet-Cookieを捕獲したハンドラを、方針Sharedのルートに置く
func main() {
    c := http.server.SetCookie{name: "lang", value: "en"}
    rs := []http.server.Route{http.server.Route{method: "GET", path: "/", handler: (r) => http.server.Response{status: 200, contentType: "text/plain", body: bytes("hi"), cookies: []http.server.SetCookie{c}}, cache: http.server.Shared{maxAge: 60}}}
    println(len(rs))
}
