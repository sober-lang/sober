package main

// ループで持ち越す秘密: 外のループの本体で宣言した名前に内のループで秘密を書き、次の周で分岐に読む（宣言ごとの項目でも拒否のまま）

import "std/iter"

@secret(k)
func f(k []byte, n int) int {
    mut c := 0
    for a <- iter.Range(0, n) {
        mut x := 0
        for b <- iter.Range(0, 2) {
            if x > 0 {
                c += 1
            }
            x = int(k[0])
        }
    }
    return c
}

func main() {
    println(f([]byte{1, 2}, 2))
}
