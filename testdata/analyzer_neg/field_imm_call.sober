package main

// immのフィールドに、暗黙のfreezeの点にならないmutのコンテナ（局所のラムダの呼び出し — 捕捉したmの別名）を置く形。
// コアのstructはフィールドの型を持たないので、checkが受理しbuildのlowerだけが落としていた

type H struct {
    xs []int
    k int
}

func main() int {
    mut m := mut []int{1, 2}
    g := () => m
    h := H{xs: g(), k: 0}
    m[0] = 9
    return h.xs[0]
}
