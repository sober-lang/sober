package main

// 呼び先がmutの仮引数の中身を別のmutの仮引数のフィールドへ持ち出す（U3）— 凍結はmapのリテラルの値（暗黙のfreeze）

type S struct {
    xs mut []int
}

func keep(s mut S, x mut []int) {
    s.xs = x
}

func main() int {
    mut s := S{xs: mut []int{}}
    mut m := mut []int{1, 2}
    keep(mut s, mut m)
    mm := map[string][]int{"a": m}
    s.xs[0] = 9
    println("${len(mm)}")
    return 0
}
