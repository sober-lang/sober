package main

// secret_ok_sibling_forの対: 秘密の列を回すforの同じ名前のループ変数の分岐は拒否のまま

import "std/iter"

@secret(k)
func f(k []byte, n int) int {
    mut c := 0
    for i <- iter.Range(0, n) {
        c += i
    }
    for i <- k {
        if i > 0 {
            c += 1
        }
    }
    return c
}

func main() {
    println(f([]byte{1, 2}, 2))
}
