package main

// 欄の freeze の後の書き（U2 — 欄の freeze は根ごと: 兄弟の欄が同じ buffer を指しうる）

type B struct {
    xs mut []byte
    ys mut []byte
}

func main() int {
    mut b := B{xs: mut []byte{65, 66, 67}, ys: mut []byte{}}
    b.ys = b.xs
    im := freeze(b.xs)
    b.ys[0] = 200
    println("${int(im[0])}")
    return 0
}
