package main

// analyzerの秘密の流れ: 兄弟のブロックの同じ名前の束縛を混同しない（後のブロックの公開の値の分岐は秘密でない）

@secret(k)
func f(k []byte, n int) int {
    mut acc := 0
    if n > 0 {
        x := int(k[0])
        acc = acc ^ x
    }
    mut c := 0
    if n > 1 {
        x := n
        if x < 5 {
            c += 1
        }
    }
    return acc + c
}

func main() {
    println(f([]byte{1, 2}, 2))
}
