package main

// analyzer の負例（scripts/analyzer_neg.sh — 期待は errors_switch.err）: error の switch の網羅（error 網羅 analyzer A5）。
// 網羅の対象は subject の導出集合。覆わないラベルを名指して拒否・導出できない（TOP）subject は default を要求。
// 到達しない腕（subject が持ちえないラベルの腕）と到達しない default（腕が導出集合を覆っているのに default）も拒否（ユーザー裁定 E4-d (ii)）。
// build は analyzer を走らせない（ユーザー裁定 E4-B）ので受理し、覆っていないラベルが来たら exit 101（errors_switch.exit）

type A error {
    n int
}

type B error

type C error

// D はどこからも返らない（腕を書くと到達しない腕）
type D error

func f(n int) (int, error?) {
    if n < 0 {
        return 0, A{n: n}
    }
    if n == 0 {
        return 0, B{}
    }
    if n > 100 {
        return 0, C{}
    }
    return n, nil
}

// 導出できない subject（slice の要素の読み — TOP）
func pick(i int) error? {
    es := []error?{A{n: 1}, nil}
    return es[i]
}

// 到達しない腕（D）と到達しない default（A・B・C を覆った上の default）— main からは呼ばない
func dead(k int) int {
    _, e := f(k)
    if e != nil {
        x := switch e {
        case A{n}: 1
        case B{}: 2
        case C{}: 3
        case D{}: 4
        }
        y := switch e {
        case A{n}: 1
        case B{}: 2
        case C{}: 3
        default: 0
        }
        return x + y
    }
    return 0
}

func main() {
    _, e1 := f(-1)
    if e1 != nil {
        switch e1 {
        case A{n}: println("A", n)
        case C{}: println("C")
        }
    }
    e2 := pick(1)
    if e2 != nil {
        switch e2 {
        case A{n}: println("A", n)
        }
    }
    _, e3 := f(0)
    if e3 != nil {
        switch e3 {
        case A{n}: println("A", n)
        case C{}: println("C")
        }
    }
}
