package main

// secret_ok_sibling_ifの対: 秘密の値を束縛したブロックの同じ名前の分岐は拒否のまま

@secret(k)
func f(k []byte, n int) int {
    mut c := 0
    if n > 1 {
        x := n
        c += x
    }
    if n > 0 {
        x := int(k[0])
        if x < 5 {
            c += 1
        }
    }
    return c
}

func main() {
    println(f([]byte{1, 2}, 2))
}
