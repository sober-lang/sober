package main

// 負例（analyzer — checkが拒否・buildは受理して外れた値でpanic = E4-B）: nilの分岐があっても、残りの分岐が全ラベルを覆わなければdefaultが要る（language.md 13 節）
type NotFound error
type Bad error

func find(k int) error? {
    return if k == 0 { nil } else if k == 1 { NotFound{} } else { Bad{} }
}

func main() {
    println(switch find(2) {
    case nil: "ok"
    case NotFound{}: "nf"
    })
}
