package main

// leaseのウィンドウの性能lint（警告 — 受理は変えない。analyzer/lease.sober）: ウィンドウの中の待ち（blockエフェクトの導出 — 推移的に）と、同じLocalの入れ子のウィンドウ。
// 鳴らない形: 純なウィンドウ・違うLocalの入れ子・ウィンドウの中でspawnした子の待ち（別のtask）・ウィンドウの外の待ち。
// 名前付き関数型の値の呼び出しは型の値の合併（関数のエフェクトの導出 — language.md 12 節「関数のエフェクトの宣言」）: 待つWaiterの値がどこかにあれば鳴る

import "std/iter"
import "std/os"
import "std/task"
import "std/pool"

type Work struct {
    n int
    tab pool.Scratch
}

func sum(w mut Work) int {
    mut t := 0
    for i <- iter.Range(0, 8) {
        pool.Store(mut w.tab, i, i)
        t += pool.Load(mut w.tab, i)
    }
    return t
}

// nap は推移的に待つ（os.Sleep → rt の sleep）
func nap(ms int) int {
    os.Sleep(ms)
    return ms
}

type Waiter func(ms int) int

// 鳴る: 名前付き関数型の値の待ち（どこかの Waiter の値が待つ — MayBlock の頃は関数値の呼び出しを見ずに抜けていた形）
func waitVia(lw task.Local, wt Waiter) int {
    return task.Lease(lw, (w mut Work) => sum(mut w) + wt(0))
}

func main() {
    lw := task.NewLocal((w mut Work) => pool.NewScratch(mut w.tab, 8))
    lv := task.NewLocal((w mut Work) => pool.NewScratch(mut w.tab, 8))
    // 鳴る: 直の待ち
    a := task.Lease(lw, (w mut Work) => {
        os.Sleep(0)
        sum(mut w)
    })
    // 鳴る: 推移的な待ち（1つのウィンドウに1回だけ）
    b := task.Lease(lw, (w mut Work) => sum(mut w) + nap(0) + nap(0))
    // 鳴る: 同じ Local の入れ子
    c := task.Lease(lw, (w mut Work) => sum(mut w) + task.Lease(lw, (u mut Work) => sum(mut u)))
    // 鳴らない: 違うLocalの入れ子・純なウィンドウ・ウィンドウの外の待ち
    d := task.Lease(lw, (w mut Work) => sum(mut w) + task.Lease(lv, (u mut Work) => sum(mut u)))
    os.Sleep(0)
    // 鳴らない: ウィンドウの中でspawnした子の待ち（scopeはウィンドウの外）
    r, err := task.Run((s) => {
        task.Lease(lw, (w mut Work) => {
            _ = task.Spawn(s, () => nap(0))
            sum(mut w)
        })
    })
    println(a + b + c + d + r + waitVia(lw, (ms) => nap(ms)))
    if err != nil {
        println(-1)
    }
}
