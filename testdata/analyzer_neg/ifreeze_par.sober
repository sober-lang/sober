package main

// 子が imm を読み、親が古い別名で書く — データ競合（凍結は composite の imm の欄 — 暗黙の freeze・U2）

import "std/task"

type H struct {
    xs []int
}

func main() {
    r, e := task.Run((s task.Scope) => {
        mut m := mut []int{0}
        h := H{xs: m}
        t := task.Spawn(s, () => h.xs[0])
        m[0] = 7
        task.Join(t)
    })
    if e != nil {
        println("err")
    } else {
        println("${r}")
    }
}
