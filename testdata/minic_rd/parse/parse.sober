package parse

// minic の構文: expr := term (('+' | '-') term)*、term := unary (('*' | '/') unary)*、unary := '-' unary | 数 | '(' expr ')'。
// 再帰下降版（region多相の決定R2の検証例 — testdata/minicの演算子順位法を書き直した形）。
// expr / term / unary は相互再帰し、Builder と字句の Cursor を mut 引数で引き回す。mut 引数の関数でも
// 再帰のループに入るものはDefとして呼ばれる（K-a — 呼び出しはanchorつき）。木は []Node + 添字参照で、
// 子が親より先に並ぶ（後置順 = そのままスタック機械の順。演算子順位法版と同じ並びになる）

import "std/builder"
import "testdata/minic_rd/lex"
import "testdata/minic_rd/diag"

// 節の種類
const Lit = 0
const Neg = 1
const Add = 2
const Sub = 3
const Mul = 4
const Div = 5

// l / r は子の添字（無ければ -1）、pos は字句の位置（Div の実行時エラーの位置になる）
type Node struct {
    kind, val, pos, l, r int
}

// peekは次の字句を読むだけ（Cursorのコピーを進める）
func peek(c mut testdata.minic_rd.lex.Cursor) testdata.minic_rd.lex.Token {
    mut d := c
    return testdata.minic_rd.lex.Next(mut d)
}

// node は節を積んで添字を返す
func node(nb mut builder.Builder[Node], n Node) int {
    builder.Push(mut nb, n)
    return builder.Len(mut nb) - 1
}

// expr := term (('+' | '-') term)*
func expr(nb mut builder.Builder[Node], c mut testdata.minic_rd.lex.Cursor) (int, error?) {
    mut l := term(mut nb, mut c)?
    mut more := true
    while more {
        t := peek(mut c)
        if t.kind == testdata.minic_rd.lex.Plus || t.kind == testdata.minic_rd.lex.Minus {
            testdata.minic_rd.lex.Next(mut c)
            r := term(mut nb, mut c)?
            k := if t.kind == testdata.minic_rd.lex.Plus { Add } else { Sub }
            l = node(mut nb, Node{k, 0, t.pos, l, r})
        } else {
            more = false
        }
    }
    return l, nil
}

// term := unary (('*' | '/') unary)*
func term(nb mut builder.Builder[Node], c mut testdata.minic_rd.lex.Cursor) (int, error?) {
    mut l := unary(mut nb, mut c)?
    mut more := true
    while more {
        t := peek(mut c)
        if t.kind == testdata.minic_rd.lex.Star || t.kind == testdata.minic_rd.lex.Slash {
            testdata.minic_rd.lex.Next(mut c)
            r := unary(mut nb, mut c)?
            k := if t.kind == testdata.minic_rd.lex.Star { Mul } else { Div }
            l = node(mut nb, Node{k, 0, t.pos, l, r})
        } else {
            more = false
        }
    }
    return l, nil
}

// unary := '-' unary | 数 | '(' expr ')'
func unary(nb mut builder.Builder[Node], c mut testdata.minic_rd.lex.Cursor) (int, error?) {
    t := testdata.minic_rd.lex.Next(mut c)
    if t.kind == testdata.minic_rd.lex.Minus {
        v := unary(mut nb, mut c)?
        return node(mut nb, Node{Neg, 0, t.pos, 0 - 1, v}), nil
    }
    if t.kind == testdata.minic_rd.lex.Num {
        return node(mut nb, Node{Lit, t.val, t.pos, 0 - 1, 0 - 1}), nil
    }
    if t.kind == testdata.minic_rd.lex.LParen {
        e := expr(mut nb, mut c)?
        u := testdata.minic_rd.lex.Next(mut c)
        if u.kind == testdata.minic_rd.lex.RParen {
            return e, nil
        }
        if u.kind == testdata.minic_rd.lex.End {
            return 0, testdata.minic_rd.diag.Expected{pos: u.pos, want: 5}
        }
        return 0, testdata.minic_rd.diag.Expected{pos: u.pos, want: 1}
    }
    if t.kind == testdata.minic_rd.lex.End {
        return 0, testdata.minic_rd.diag.UnexpectedEnd{pos: t.pos}
    }
    return 0, testdata.minic_rd.diag.Expected{pos: t.pos, want: 0}
}

// Parse は 1 行の字句列を木にする（根は最後の節）
@errors(testdata.minic_rd.diag.UnexpectedEnd, testdata.minic_rd.diag.Expected, testdata.minic_rd.diag.Unbalanced)
func Parse(ts []testdata.minic_rd.lex.Token) ([]Node, error?) {
    mut nb := builder.Builder[Node]{}
    mut c := testdata.minic_rd.lex.Start(ts)
    // 別packageの再帰するmut関数（.sobiでは本体なし）をコピーのCursorで呼ぶ — 結果は使わない（R2の分割検査の経路）
    mut d := c
    testdata.minic_rd.lex.Remaining(mut d)
    expr(mut nb, mut c)?
    t := testdata.minic_rd.lex.Next(mut c)
    if t.kind == testdata.minic_rd.lex.RParen {
        return []Node{}, testdata.minic_rd.diag.Unbalanced{pos: t.pos}
    }
    if t.kind != testdata.minic_rd.lex.End {
        return []Node{}, testdata.minic_rd.diag.Expected{pos: t.pos, want: 1}
    }
    return builder.Build(mut nb), nil
}
