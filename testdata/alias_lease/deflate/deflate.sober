package deflate

// 型の別名の第一顧客の縮図（stdの8-4の形 — std/internal/deflateの位置）: 作業域の型と核。フィールドはこのpackageでだけ書ける

import "std/pool"

type Work struct {
    tab pool.Scratch
    n int
}

func NewWork(w mut Work) {
    pool.NewScratch(mut w.tab, 64)
}

func EncodeWith(w mut Work, x int) int {
    if pool.Cap(mut w.tab) == 0 {
        pool.NewScratch(mut w.tab, 64)
    }
    pool.Store(mut w.tab, x & 63, x)
    w.n += 1
    return pool.Load(mut w.tab, x & 63) * 10 + w.n
}
