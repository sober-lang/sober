package main

// 利用者の形（http・bench の位置）: 公開の名前 testdata.alias_lease.flate.Work だけで lease の窓を書く（実体の package は import しない）

import "std/task"
import "testdata/alias_lease/flate"

func main() {
    println(testdata.alias_lease.flate.Encode(3))
    lw := task.NewLocal((w mut testdata.alias_lease.flate.Work) => testdata.alias_lease.flate.NewWork(mut w))
    a := task.Lease(lw, (w mut testdata.alias_lease.flate.Work) => testdata.alias_lease.flate.EncodeWith(mut w, 5))
    b := task.Lease(lw, (w mut testdata.alias_lease.flate.Work) => testdata.alias_lease.flate.EncodeWith(mut w, 7))
    println(a, b)
    lr := task.NewLocal((w mut testdata.alias_lease.flate.Work) => testdata.alias_lease.flate.Ready(mut w))
    println(task.Lease(lr, (w mut testdata.alias_lease.flate.Work) => testdata.alias_lease.flate.EncodeWith(mut w, 9)))
}
