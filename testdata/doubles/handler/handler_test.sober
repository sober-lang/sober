@doubles("testdata/doubles/store/fake")
package handler

import "testdata/doubles/store/fake"

func TestLookup() {
    c := testdata.doubles.store.fake.With([]testdata.doubles.store.fake.Row{testdata.doubles.store.fake.Row{k: "a", v: "1"}})
    assert(Lookup(c, "a") == "1")
    assert(Lookup(c, "b") == "none")
}

func TestSaveDenied() {
    assert(!Save(testdata.doubles.store.fake.Denying(), "a", "1"))
}
