@doubles("testdata/doubles/logger/spy")
package greet

import "std/testing/cell"
import "testdata/doubles/logger/spy"

func TestGreetLogs() {
    assert(Greet("a") == "hello, a")
    assert(Greet("b") == "hello, b")
    lines := testing.cell.Get(testdata.doubles.logger.spy.Lines)
    assert(len(lines) == 2)
    assert(lines[1] == "hello, b")
}

func TestFreshPerTest() {
    assert(len(testing.cell.Get(testdata.doubles.logger.spy.Lines)) == 0)
}
