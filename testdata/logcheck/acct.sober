package main

// logcheckの題材: 落ちる記録（40,000バイト）を交ぜ、眠った後のLedger().logsで written + dropped = 呼んだ数（30）を見る
import "std/os"
import "std/print"
import "std/task"

type Small struct {
    n int
}

type Big struct {
    s string
}

func rep(n int) string {
    mut s := "x"
    while len(bytes(s)) < n {
        s = s + s
    }
    return s
}

func main() {
    big := rep(40000)
    _, e := task.Run((s task.Scope) => {
        mut i := 0
        while i < 20 {
            print.Log[Small](Small{n: i})
            if i % 2 == 0 {
                print.Log[Big](Big{s: big})
            }
            i += 1
        }
        0
    })
    _ = e
    os.Sleep(50)
    l := task.Ledger().logs
    println("${l.written} ${l.dropped}")
}
