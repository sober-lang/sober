package shapes

func must(ok bool) {
    if !ok {
        none := []int{}
        println(none[0])
    }
}

func TestSquare() {
    must(Area(0, 3, 0) == 9)
}

func TestRect() {
    must(Area(1, 2, 3) == 6)
}

func TestClampLow() {
    must(Clamp(-1, 0, 10) == 0)
}

// 102（regionの深度の上限）で死ぬ — フラグは終わりのパスで書き出される
func TestDeep() {
    must(Depth(100000) > 0)
}

// 101で死ぬ — Clampの真ん中の分岐を踏んでから
func TestBroken() {
    must(Clamp(5, 0, 10) == 6)
}
