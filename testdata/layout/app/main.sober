package main

// 他 package（testdata/layout/wire）の @layout の struct を、import の別名つきで 2 つのファイルから読み書きする

import "std/builder"
import "std/iter"
import "std/layout"
import "testdata/layout/wire"

func main() {
    mut out := builder.Builder[byte]{}
    layout.Encode[wire.Frame](mut out, wire.Ping(7))
    writeData(mut out, 300)
    b := builder.Build(mut out)
    println(len(b))
    println(layout.Size[wire.Frame])
    for i <- iter.Range(0, 2) {
        f := layout.DecodeAt[wire.Frame](b, 0, i)
        if f != nil {
            println(f.kind)
            println(f.len)
            println(f.seq)
        }
    }
}
