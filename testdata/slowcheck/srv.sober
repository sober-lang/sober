package main

// 受けと送りの期限の検査（scripts/slowcheck.sh）のサーバー。conns: 4で立て、期限を短くする（頭1秒・本文2秒・送りの間隔1秒）。
// budgetは/bigの応答（1 MiB）を覆う2 MiB（天井に空きがある構成）。SLOW_FULLがあれば既定の64 KiB（天井 = 4本の予約で埋まる構成 —
// 予約を越えて伸びる接続は天井を越えて死に、Ledgerのcutに数えられる）
// SLOW_TLS_PORTがあれば、平文の代わりにTLSで127.0.0.1:<SLOW_TLS_PORT> に立つ（"tls-ready <port>" を出してから待ち受ける）。平文は "ready <port>"
//   /       → "ok\n"
//   /big    → 1 MiBの本文
//   /sleep  → ハンドラが2.5秒眠ってから "slept\n"（routeの実行中は期限が効かない）
//   /delay  → Delayed(2500)の "late\n"（満了の後から次の頭の期限を数える）
//   /echo   → 受けた本文の長さ
//   /ledger → 全部のプールの節の「timeoutの和 shedの和 tasksの和 failの和」（Serveの期限で切った接続の数・入れずに閉じた接続の数・今いる接続のtaskの数・
//             handlerが誤りを返した接続の数）
//   /ledger → 全部のプールの節のtimeoutの和（Serveの期限で切った接続の数）
//   /cut    → 全部のプールの節の "cut died" の和・根の節の borrowed の和（borrowed は下の節を含む）とワーカー数

import "std/convert"
import "std/http/server"
import "std/io"
import "std/net"
import "std/os"
import "std/task"
import "std/tls"

func big() []byte {
    mut b := mut []byte{}
    mut i := 0
    while i < 1048576 {
        b = append(b, 97)
        i += 1
    }
    return freeze(b)
}

func route(r http.server.Request) http.server.Response {
    if r.path == "/big" {
        return http.server.Response{status: 200, contentType: "text/plain", body: big()}
    }
    if r.path == "/sleep" {
        os.Sleep(2500)
        return http.server.Text("slept\n")
    }
    if r.path == "/delay" {
        return http.server.Delayed(2500, http.server.Text("late\n"))
    }
    if r.path == "/ledger" {
        mut n := 0
        mut sh := 0
        mut fl := 0
        mut tk := 0
        mut ev := 0
        for p <- task.Ledger().pools {
            n += p.timeout
            ev += p.evicted
            sh += p.shed
            tk += p.tasks
            fl += p.fail
        }
        return http.server.Text("${convert.FormatInt(n)} ${convert.FormatInt(sh)} ${convert.FormatInt(tk)} ${convert.FormatInt(fl)} ${convert.FormatInt(ev)}\n")
    }
    if r.path == "/cut" {
        mut c := 0
        mut d := 0
        mut b := 0
        for p <- task.Ledger().pools {
            c += p.cut
            d += p.died
            // borrowed は節とその下の節の和なので、根の行（parent = -1）だけを足す（cut と died は入場した節だけに数える）
            if p.parent < 0 {
                b += p.borrowed
            }
        }
        return http.server.Text("${convert.FormatInt(c)} ${convert.FormatInt(d)} ${convert.FormatInt(b)} ${convert.FormatInt(task.Ledger().workers)}\n")
    }
    if r.path == "/echo" {
        return http.server.Text("${convert.FormatInt(len(r.body))}\n")
    }
    return http.server.Text("ok\n")
}

func app(c net.Conn) error? {
    return http.server.ServeConn(c, route, headWait: 1000 * task.MS, bodyWait: 2000 * task.MS, sendWait: 1000 * task.MS)
}

// 天井に空きがある構成は /big の応答（1 MiB）を覆う 2 MiB。天井が埋まる構成（SLOW_FULL）と一斉の到着の試し（SLOW_CONNS — 箱から導いた入場の上限を
// 既定の 1本の量で見る）は既定の 64 KiB
func budget() int {
    f := os.Getenv("SLOW_FULL") catch nil
    c := os.Getenv("SLOW_CONNS") catch nil
    return if (f == nil || f == "") && (c == nil || c == "") { 2 * task.MB } else { 64 * task.KB }
}

func plain() error? {
    for l <- net.Listen("127.0.0.1:0")? {
        println("ready ${net.Port(l)}")
        // SLOW_CONNS（一斉の到着の試し）があればその上限
        cs := os.Getenv("SLOW_CONNS") catch nil
        n := if cs == nil { 4 } else { convert.ParseInt(cs) catch 4 }
        net.Serve(l, app, budget: budget(), conns: n)?
    }
    return nil
}

func tlsConn(c tls.Conn) error? {
    return http.server.ServeWith((k) => tls.Recv(c, k), (b) => tls.Send(c, b), route, headWait: 1000 * task.MS, bodyWait: 2000 * task.MS, sendWait: 1000 * task.MS, put: (b) => tls.Put(c, b))
}

func run() error? {
    tp := os.Getenv("SLOW_TLS_PORT") catch nil
    if tp == nil || tp == "" {
        return plain()
    }
    cfg := tls.Load("testdata/crypto/httparena-server.crt", "testdata/crypto/httparena-server.key")?
    println("tls-ready ${tp}")
    cs := os.Getenv("SLOW_CONNS") catch nil
    n := if cs == nil { 4 } else { convert.ParseInt(cs) catch 4 }
    return tls.Serve("127.0.0.1:${tp}", cfg, tlsConn, budget: budget(), conns: n, headWait: 1000 * task.MS)
}

// net.Waiting の読みと、プールの evicted の和が変わるたびに "waiting <待っている数> <上限>" / "evicted <和>" を stderr へ出す（stdout は task の順に並ぶので、
// 終わらない task からは出さない。slowcheck.sh が、wait-full の間に待っている数が 2 以上になったか、待っている接続のために枠を取り戻した〔evicted ≥ 1〕ことを見る —
// io_uring の経路では待ちが次の期限の走査までで短く、2 ms ごとの読みでも見逃しうる）
func watch() int {
    mut prev := -1
    mut pe := 0
    while true {
        v := net.Waiting()
        if v.waiting * 1000000000 + v.limit != prev {
            _ = io.WriteStderr(bytes("waiting ${v.waiting} ${v.limit}\n"))
            prev = v.waiting * 1000000000 + v.limit
        }
        mut ev := 0
        for p <- task.Ledger().pools {
            ev += p.evicted
        }
        if ev != pe {
            _ = io.WriteStderr(bytes("evicted ${ev}\n"))
            pe = ev
        }
        os.Sleep(2)
    }
    return 0
}

func main() int {
    r, _ := task.Run((s task.Scope) => {
        // SOBER_BUDGET_MB=0（箱の試し）では子が縮退してその場で回り続けるので、立てない
        if (os.Getenv("SLOW_NOWATCH") catch nil) == nil {
            _ = task.Spawn(s, () => watch())
        }
        if run() == nil { 0 } else { 1 }
    })
    return r
}
