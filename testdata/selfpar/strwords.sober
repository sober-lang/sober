package main

// ワードに詰めると同じで長さだけ違うstringの字面（"/" と "/\0"・"ab" と "ab\0\0"）— rodataの大域がワードの列で名前で参照される（関数の格納場所の鍵）ので、
// 別の大域にすると温の格納場所 + lowerの分割で参照が入れ替わる（scripts/selfpar.shのj_strwords — 1本道 ≡ 冷 ≡ 温のELF）

func a() string {
    return "/"
}

func b() string {
    return "/\0"
}

func c() string {
    return "ab\0\0"
}

func d() string {
    return "ab"
}

func main() {
    println(len(bytes(a())), len(bytes(b())), len(bytes(c())), len(bytes(d())), a() == b(), c() == d())
}
