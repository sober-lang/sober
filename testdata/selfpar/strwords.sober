package main

// 語に詰めると同じで長さだけ違う string の字面（"/" と "/\0"・"ab" と "ab\0\0"）— rodata の大域が語の列で名指される（関数の置き場の鍵）ので、
// 別の大域にすると温の置き場 + lower の分割で参照が入れ替わる（scripts/selfpar.sh の j_strwords — 1 本道 ≡ 冷 ≡ 温の ELF）

func a() string {
    return "/"
}

func b() string {
    return "/\0"
}

func c() string {
    return "ab\0\0"
}

func d() string {
    return "ab"
}

func main() {
    println(len(bytes(a())), len(bytes(b())), len(bytes(c())), len(bytes(d())), a() == b(), c() == d())
}
