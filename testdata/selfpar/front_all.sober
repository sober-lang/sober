package main

// selfpar 4（段 6 P6-2 — checkFront）: ParCheck の拒否（mut の捕獲 — diag.Par kind 4）・analyzer の指摘（公開関数の @errors なし）・
// 検査の def error（int を返す関数が string を返す）を全部持つ。逐次の優先順では ParCheck の拒否だけが出る

import "std/task"

type A error

func Missing(n int) (int, error?) {
    if n < 0 {
        return 0, A{}
    }
    return n, nil
}

func bad(n int) int {
    return "no"
}

func main() {
    mut c := 1
    r, e := task.Run((s task.Scope) => task.Join(task.Spawn(s, () => c + 1)))
    println(r)
    println(bad(1))
}
