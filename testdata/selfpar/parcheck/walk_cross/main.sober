func last() int {
    r, _ := task.Run((s) => {
        h := task.Spawn(s, () => 1)
        h2 := task.Spawn(s, () => {
            _ = h
            2
        })
        task.Join(h2)
    })
    return r
}

func main() {
    println(first() + last() + 0)
    _ = io.Stdout
}
