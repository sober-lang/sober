package main

// selfparのparcheckの区間の子のテスト群（pcpar.sober）: 拒否を関数の表の離れた2か所（walk4 → walk6）に置き、間に関数を挟んで別の区間の子に分ける。
// 逐次の歩きの選び方（fileCheck → pcWalk → deCheck の順・その中は最小の関数）と同じ1件が出る

import "std/io"
import "std/task"

type C struct {
    n int
}

type App struct {
    d task.Domain[C]
}

func first() int {
    mut x := 1
    x += 1
    r, _ := task.Run((s) => {
        h := task.Spawn(s, () => x + 1)
        task.Join(h)
    })
    return r
}

