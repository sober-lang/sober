package mid

import "testdata/named_qual/lib"

// F は別 package の named scalar への変換 `testdata.named_qual.lib.R(x)`（修飾つき）を使う。
// 呼び手（app）は lib を import しない — lower は変換の行き先を mid の import 表で引く（以前は脱糖器の文脈の package で引いて Undefined）
func F(x int) int {
    r := testdata.named_qual.lib.R(x)
    return testdata.named_qual.lib.Next(r) + testdata.named_qual.lib.Next(testdata.named_qual.lib.R(x + 1))
}
