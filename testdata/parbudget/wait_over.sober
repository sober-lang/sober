package main

// parbudgetのwaitの負例（段階3の③）: waitのscopeの天井8 MBに宣言16 MBの子 — 待っても入れないのでspawnの点で明示のpanic（101）

import "std/task"

func main() int {
    r, e := task.Run((s task.Scope) => {
        h := task.Spawn(s, () => 1, budget: 16 * task.MB)
        task.Join(h)
    }, budget: 8 * task.MB, wait: true)
    println(r)
    return 0
}
