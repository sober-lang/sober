package main

// starve（gate — 飽和下の待ちの上限の検査・language.md 28 節io_uringのパス・report-1142）: 同じプロセスにechoのnet.Serveと閉ループの客512本を立て、
// 少ないワーカー（検査はSOBER_WORKERS=2）でスタックを深くして飽和させる。Serveの期限（3秒）の後にtask.Ledger() のmaxWait（ms）とagedを出す。
// 検査の判定はscripts/starve.sh（aged > 0 = 飽和した・maxWait ≤ 1 s）。接続のtaskのDは10 ms（期限の拾いのパスを
// 短い Serve の間に確実に通す — report-1150 / 1154）

import "std/net"
import "std/task"

func echo(c net.Conn) error? {
    for chunk <- net.Recv(c)? {
        net.Send(c, chunk)?
    }
    return nil
}

// talk は接続 1 本で 32 バイトを送って受け返すのを、相手が閉じるか期限が切れるまで繰り返す
func talk(port int, msg []byte) error? {
    for c <- net.Dial("127.0.0.1:${port}")? {
        while true {
            net.Send(c, msg)?
            mut got := 0
            for chunk <- net.Recv(c)? {
                got += len(chunk)
                if got >= len(msg) {
                    break
                }
            }
            if got < len(msg) {
                return nil
            }
        }
    }
    return nil
}

func main() {
    msg := bytes("0123456789abcdef0123456789abcdef")
    _ = net.Listen("127.0.0.1:0", (l) => {
        port := net.Port(l)
        _, _ = task.Run((s task.Scope) => {
            mut i := 0
            while i < 512 {
                _ = task.Spawn(s, () => talk(port, msg) != nil)
                i += 1
            }
            _, _ = task.Run((s2 task.Scope) => net.Serve(l, echo, conns: 1024, maxWait: 10 * task.MS), deadline: 3000 * task.MS)
            0
        }, deadline: 6000 * task.MS)
    })
    lg := task.Ledger()
    println("maxWait_ms=${lg.maxWait / task.MS} aged=${lg.aged}")
    println("late=${lg.late} maxLate_ms=${lg.maxLate / task.MS}")
}
