package main

// starve（gate: 実行待ちの列のFIFOの保証の検査）: 同じプロセスにechoのnet.Serveと閉ループの客512本を立て、少ないワーカー
// （検査はSOBER_WORKERS=2）で実行待ちの列を深くして飽和させる。Serveの期限（3秒）の後に、task.Ledger() のmaxWait（µs）と、
// 往復の数の和・1回以上往復した客の数を出す。1周の時間（往復1回の平均 = 期限 × 往復した客の数 ÷ 往復の和）と待ちの最大を比べる
// 判定はscripts/starve.sh。M:Nでは、列が空にならない間は未着手の客が走り始めないので、往復しない客が残る（往復した客の数で割る理由）

import "std/net"
import "std/task"

const CLIENTS = 512
const SERVE_MS = 3000

func echo(c net.Conn) error? {
    for chunk <- net.Recv(c)? {
        net.Send(c, chunk)?
    }
    return nil
}

// 接続 1 本で 32 バイトを送って受け返すのを、相手が閉じるか期限が切れるまで繰り返す。往復の数を n に足す
func talkOn(port int, msg []byte, n mut int) error? {
    for c <- net.Dial("127.0.0.1:${port}")? {
        while true {
            net.Send(c, msg)?
            mut got := 0
            for chunk <- net.Recv(c)? {
                got += len(chunk)
                if got >= len(msg) {
                    break
                }
            }
            if got < len(msg) {
                return nil
            }
            n += 1
        }
    }
    return nil
}

func talk(port int, msg []byte) int {
    mut n := 0
    _ = talkOn(port, msg, mut n)
    return n
}

func main() {
    msg := bytes("0123456789abcdef0123456789abcdef")
    _ = net.Listen("127.0.0.1:0", (l) => {
        port := net.Port(l)
        _, _ = task.Run((s task.Scope) => {
            mut hs := mut []task.Handle[int]{}
            mut i := 0
            while i < CLIENTS {
                hs = append(hs, task.Spawn(s, () => talk(port, msg)))
                i += 1
            }
            _, _ = task.Run((s2 task.Scope) => net.Serve(l, echo, conns: 1024), deadline: SERVE_MS * task.MS)
            lg := task.Ledger()
            vs := task.Gather(hs)
            mut sum := 0
            mut act := 0
            mut j := 0
            while j < len(vs) {
                sum += vs[j]
                if vs[j] > 0 {
                    act += 1
                }
                j += 1
            }
            println("maxWait_us=${lg.maxWait / 1000} rounds=${sum} active=${act} serve_ms=${SERVE_MS}")
            0
        }, deadline: 6000 * task.MS)
    })
}
