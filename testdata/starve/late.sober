// 浅い積みの越え（Ledger の late / maxLate の網 — scripts/starve.sh）: 同時に起きる 3 本の task がそれぞれ CPU を 300 ms 以上握る。
// 同じワーカーで後に走る側は D を越えて待つ — late ≥ 1・maxLate > 0 を出す。
// 3 本はワーカー 2 本（starve.sh）より多い: 眠りから覚めた task は盗まれないので、どれか 2 本は同じワーカーで起きる
// （2 本だと、未着手のうちに盗まれて 2 本が別のワーカーで並んで走り、誰も待たない回がある）
package main

import "std/os"
import "std/task"

func spin(n int) int {
    mut x := 0
    mut i := 0
    while i < n {
        x = (x * 31 + i) % 1000003
        i += 1
    }
    return x
}

func main() {
    _, _ = task.Run((s task.Scope) => {
        a := task.Spawn(s, () => {
            os.Sleep(5)
            spin(100000000)
        })
        b := task.Spawn(s, () => {
            os.Sleep(5)
            spin(100000000)
        })
        c := task.Spawn(s, () => {
            os.Sleep(5)
            spin(100000000)
        })
        task.Join(a) + task.Join(b) + task.Join(c)
    })
    lg := task.Ledger()
    println("late=${lg.late} maxLate_ms=${lg.maxLate / task.MS} aged=${lg.aged}")
}
