package main

// TLSの接続（tls.Serveが渡すnet.Conn）のnet.Send / net.Put / net.Flushの送りの失敗の返り方の題材（scripts/httpcheck.sh）。handlerは最初に1行送り、相手はそれを受けてから1行送って
// RSTで切る。handlerは相手が切った後に送り、各呼び出しが返した値を印字する。
// TLSERR_MODE: L = 受けを1回で抜けて、handlerの最後のnet.Sendの結果をhandlerが返す・F = 受けを1回で抜けて、net.Putとnet.Flush・
// R = net.Recvのkの中でnet.Put（受けの中のFlushが送る）。どれも送りの完了を待ち、失敗をその呼び出し（Rは net.Recv）が返す

import "std/io"
import "std/net"
import "std/os"
import "std/tls"

// 印字の代わりにTLSERR_OUTのファイルへ1行足す（接続のtaskの印字は、待ち受けのtaskが終わるまで出ないことがある）
func say(s string) {
    p := os.Getenv("TLSERR_OUT") catch nil
    if p != nil {
        _ = os.AppendFile(p, bytes("${s}\n"))
    }
}

func show(e error?) string {
    return switch e {
        case nil: "ok"
        case io.Closed{}: "closed"
        case io.Timeout{}: "timeout"
        case io.Expired{}: "expired"
        case io.Denied{}: "denied"
        case io.Other{errno}: "other ${errno}"
    }
}

// 受けを1回で抜ける
func first(c net.Conn) error? {
    for b <- net.Recv(c)? {
        break
    }
    return nil
}

func last(c net.Conn) error? {
    net.Send(c, bytes("hi\n"))?
    e0 := first(c)
    if e0 != nil {
        say("recv: ${show(e0)}")
        return e0
    }
    os.Sleep(300)
    e := net.Send(c, bytes("last\n"))
    say("L send: ${show(e)}")
    return e
}

func putFlush(c net.Conn) error? {
    net.Send(c, bytes("hi\n"))?
    e0 := first(c)
    if e0 != nil {
        say("recv: ${show(e0)}")
        return e0
    }
    os.Sleep(300)
    e1 := net.Put(c, bytes("put\n"))
    e2 := net.Flush(c)
    say("F put: ${show(e1)} flush: ${show(e2)}")
    return e2
}

func inRecv(c net.Conn) error? {
    net.Send(c, bytes("hi\n"))?
    e := net.Recv(c, (b) => {
        os.Sleep(300)
        say("R put: ${show(net.Put(c, b))}")
    })
    say("R recv: ${show(e)}")
    return e
}

func run(mode string, port string) error? {
    cfg := tls.Load("testdata/crypto/httparena-server.crt", "testdata/crypto/httparena-server.key")?
    println("tls-ready ${port}")
    addr := "127.0.0.1:${port}"
    if mode == "L" {
        return tls.Serve(addr, cfg, last)
    }
    if mode == "F" {
        return tls.Serve(addr, cfg, putFlush)
    }
    return tls.Serve(addr, cfg, inRecv)
}

func main() int {
    mode := os.Getenv("TLSERR_MODE") catch nil
    port := os.Getenv("TLSERR_PORT") catch nil
    if mode == nil || port == nil {
        return 2
    }
    return if run(mode, port) == nil { 0 } else { 1 }
}
