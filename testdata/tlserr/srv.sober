package main

// 公開のtls.Send / tls.Put / tls.Flushの送りの失敗の返り方の題材（scripts/httpcheck.sh）。handlerは最初に1行送り、相手はそれを受けてから1行送って
// RSTで切る。handlerは相手が切った後に送り、各呼び出しが返した値を印字する。
// TLSERR_MODE: L = 受けを1回で抜けて、handlerの最後のtls.Sendの結果をhandlerが返す・F = 受けを1回で抜けて、tls.Putとtls.Flush・
// R = tls.Recvのkの中でtls.Put（Recvの中のFlushが送る）。どれも送りの完了を待ち、失敗をその呼び出し（Rは tls.Recv）が返す

import "std/os"
import "std/tls"

// 印字の代わりにTLSERR_OUTのファイルへ1行足す（接続のtaskの印字は、待ち受けのtaskが終わるまで出ないことがある）
func say(s string) {
    p := os.Getenv("TLSERR_OUT") catch nil
    if p != nil {
        _ = os.AppendFile(p, bytes("${s}\n"))
    }
}

func show(e error?) string {
    return switch e {
        case nil: "ok"
        case tls.Closed{}: "closed"
        case tls.BadRecord{}: "bad record"
    }
}

// 受けを1回で抜ける
func first(c tls.Conn) error? {
    for b <- tls.Recv(c)? {
        break
    }
    return nil
}

func last(c tls.Conn) error? {
    tls.Send(c, bytes("hi\n"))?
    e0 := first(c)
    if e0 != nil {
        say("recv: ${show(e0)}")
        return e0
    }
    os.Sleep(300)
    e := tls.Send(c, bytes("last\n"))
    say("L send: ${show(e)}")
    return e
}

func putFlush(c tls.Conn) error? {
    tls.Send(c, bytes("hi\n"))?
    e0 := first(c)
    if e0 != nil {
        say("recv: ${show(e0)}")
        return e0
    }
    os.Sleep(300)
    e1 := tls.Put(c, bytes("put\n"))
    e2 := tls.Flush(c)
    say("F put: ${show(e1)} flush: ${show(e2)}")
    return e2
}

func inRecv(c tls.Conn) error? {
    tls.Send(c, bytes("hi\n"))?
    e := tls.Recv(c, (b) => {
        os.Sleep(300)
        say("R put: ${show(tls.Put(c, b))}")
    })
    say("R recv: ${show(e)}")
    return e
}

func run(mode string, port string) error? {
    cfg := tls.Load("testdata/crypto/httparena-server.crt", "testdata/crypto/httparena-server.key")?
    println("tls-ready ${port}")
    addr := "127.0.0.1:${port}"
    if mode == "L" {
        return tls.Serve(addr, cfg, last)
    }
    if mode == "F" {
        return tls.Serve(addr, cfg, putFlush)
    }
    return tls.Serve(addr, cfg, inRecv)
}

func main() int {
    mode := os.Getenv("TLSERR_MODE") catch nil
    port := os.Getenv("TLSERR_PORT") catch nil
    if mode == nil || port == nil {
        return 2
    }
    return if run(mode, port) == nil { 0 } else { 1 }
}
