package main

// if式・appendの結果のfreeze（値の末尾のパスごとに凍る — F-ap）の正例: 凍らせた後は分岐の束縛へ書かない（uniqfreezeの代表 — analyzerとLeanの述語がともに受理）

func main() int {
    mut m := mut []int{1, 2}
    mut n := mut []int{3, 4}
    c := len(m) > 1
    im := freeze(if c { m } else { n })
    mut k := mut []int{5}
    ik := freeze(append(k, 6))
    println("${im[0]} ${ik[1]}")
    return 0
}
