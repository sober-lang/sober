package main

// 利用者の形: wrap の公開の名前だけを書く（実体の package lib は import しない — loader が合成の import を足す）

import "testdata/alias_x/wrap"
import "testdata/alias_x/lib"

func main() {
    mut w := testdata.alias_x.lib.Work{}
    xs := []int{3, 5, 10}
    for x <- xs {
        testdata.alias_x.wrap.Feed(mut w, x)
    }
    r := testdata.alias_x.wrap.Mean(w)
    println(testdata.alias_x.wrap.Value(r), testdata.alias_x.wrap.Value(testdata.alias_x.wrap.Mean(testdata.alias_x.lib.Work{})))
    println(testdata.alias_x.wrap.Twice((x int) => x * 3, 2))
    a := testdata.alias_x.wrap.NewAcc(9)
    println(testdata.alias_x.wrap.Last(a))
    mut ws := mut []testdata.alias_x.lib.Work{}
    ws = append(ws, w)
    println(len(ws), other(ws[0]))
}
