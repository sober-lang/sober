package main

// 利用者の形: wrap の公開の名前だけを書く（実体の package lib は import しない — loader が合成の import を足す）

import "testdata/alias_x/wrap"
import "testdata/alias_x/lib"

func main() {
    mut w := lib.Work{}
    xs := []int{3, 5, 10}
    for x <- xs {
        wrap.Feed(mut w, x)
    }
    r := wrap.Mean(w)
    println(wrap.Value(r), wrap.Value(wrap.Mean(lib.Work{})))
    println(wrap.Twice((x int) => x * 3, 2))
    a := wrap.NewAcc(9)
    println(wrap.Last(a))
    mut ws := mut []lib.Work{}
    ws = append(ws, w)
    println(len(ws), other(ws[0]))
}
