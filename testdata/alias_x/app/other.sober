package main

// 実体の package を import するファイル: 別名は既存の参照名で実体へ写る（合成の import は足さない）

import "testdata/alias_x/lib"
import "testdata/alias_x/wrap"

func other(w testdata.alias_x.lib.Work) int {
    v := testdata.alias_x.lib.Work{n: 1, sum: 4}
    return keep(w) + keep(v)
}

func keep(w testdata.alias_x.lib.Work) int {
    return w.sum
}
