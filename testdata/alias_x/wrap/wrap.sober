package wrap

// 公開のpackage: 実体の型を別名で約束の面に出す（フィールドは書けない — 別名は宣言のpackageを変えない。関数は包みにする）

import "testdata/alias_x/lib"

// (別名の行)
// (別名の行)
// (別名の行)

// 公開の別名が非公開の型を指す
// (別名の行)

type acc struct {
    last int
}

// 別名の別名（packageをまたぐチェーン）
// (別名の行)

func Feed(w mut testdata.alias_x.lib.Work, x int) {
    testdata.alias_x.lib.Feed(mut w, x)
}

func Mean(w testdata.alias_x.lib.Work) testdata.alias_x.lib.Res {
    return testdata.alias_x.lib.Mean(w)
}

// Value は testdata.alias_x.lib.Res の値（union の variant は実体の package の名前で書く — 利用者は lib を書けないので、分解は包みの関数に置く）
func Value(r testdata.alias_x.lib.Res) int {
    return switch r {
    case testdata.alias_x.lib.Ok{v}: v
    default: -1
    }
}

func Twice(s testdata.alias_x.lib.Step, x int) int {
    return s(s(x))
}

func Last(a acc) int {
    return a.last
}

func NewAcc(x int) acc {
    return acc{last: x}
}
