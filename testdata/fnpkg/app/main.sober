package main

// 別packageの名前付き関数型（署名に宣言側の型を含む）を結果・仮引数・フィールド・ジェネリックの型引数つきで使う — checkとbuildの両方が受理する（scripts/fnpkg.sh）

import "testdata/fnpkg/p"

type H struct {
    f testdata.fnpkg.p.F
}

func adder(k int) testdata.fnpkg.p.F {
    return (r) => testdata.fnpkg.p.N(r) + k
}

func use(f testdata.fnpkg.p.F) int {
    return f(testdata.fnpkg.p.Make(1))
}

func twice(g testdata.fnpkg.p.G[int]) int {
    return g(testdata.fnpkg.p.Make(2), g(testdata.fnpkg.p.Make(3), 5))
}

func main() {
    println(use(adder(10)))
    h := H{f: adder(20)}
    f := h.f
    println(f(testdata.fnpkg.p.Make(2)))
    println(twice((r, x) => x * testdata.fnpkg.p.N(r)))
}
