package main

// ctcheck の題材（scripts/ctcheck.sh — report-791 / 984）: 秘密の値の流れの導出の表 T（testdata/secretdump/std.txt）の関数を全部呼んで ELF に載せる（tls の handshake は走らない枝から参照）。中身の値は見ない（見るのは機械語の条件分岐）。
// neg* は規律を破った形の見本（秘密の mask で if・食い違いで早く抜ける比較）— 網が分岐を数えられることの負例として黄金に載せる

import "std/binary"
import "std/crypto"
import "std/crypto/aesgcm"
import "std/crypto/chacha20"
import "std/crypto/chacha20poly1305"
import "std/crypto/hkdf"
import "std/crypto/hmac"
import "std/crypto/poly1305"
import "std/crypto/x25519"
import "std/crypto/pem"
import "std/crypto/rsa"
import "std/crypto/sha256"
import "std/iter"
import "std/tls"
import "std/tls/record"

@embed("testdata/crypto/rsa2048.key")
const Keys = map[string]string{}

// 負例（analyzer も拒否する — testdata/analyzer_neg/secret_neg_select_if）
@secret(m)
func negSelectIf(m int, a int, b int) int {
    return if m != 0 { a } else { b }
}

// 負例（analyzer も拒否する — testdata/analyzer_neg/secret_neg_eq_early）
@secret(a, b)
func negEqEarly(a []byte, b []byte) bool {
    if len(a) != len(b) {
        return false
    }
    for i <- iter.Range(0, len(a)) {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

// 負例（analyzer も拒否する — testdata/analyzer_neg/secret_neg_matchlen）: 可変時間の rt.matchlen を呼ぶ（ctcheck.sh の可変時間の rt の照合が捕まえる見本）
@secret(a)
func negPrefix(a []byte) int {
    return binary.MatchLen(a, 0, 8, 8)
}

// serveOne は接続 1 本で 1 回受けて送る（ctcheck の題材 — ELF に tls の受けと送りを載せる）
func serveOne(c tls.Conn, a []byte) error? {
    for p <- tls.Recv(c)? {
        println(len(p))
    }
    return tls.Send(c, a)
}

func main() {
    a := crypto.Rand(16)
    b := crypto.Rand(16)
    m := crypto.NonZero(int(a[0]))
    mut w := mut []byte{1, 2, 3}
    crypto.Wipe(mut w)
    k := crypto.Rand(32)
    n := crypto.Rand(12)
    t := poly1305.Sum(k, a)
    c := chacha20.XorKeyStream(k, n, 1, a)
    sealed, _ := chacha20poly1305.Seal(k, n, b, a)
    opened, _ := chacha20poly1305.Open(k, n, b, sealed)
    xs := x25519.Shared(k, x25519.Base(a))
    ga, _ := aesgcm.Seal(a, n, b, k)
    gp, _ := aesgcm.Open(a, n, b, ga)
    println(len(gp))
    gk, _ := aesgcm.Prepare(a)
    go, _ := aesgcm.OpenAt(gk, n, b, ga, 0, len(ga))
    println(len(ga) + len(go))
    mut rw, _ := record.NewDir(record.ChaCha, k)
    mut rr, _ := record.NewDir(record.ChaCha, k)
    rec := record.Seal(mut rw, record.CtApp, a, 3)
    rct, rpt, _ := record.Open(mut rr, record.Frame{b: rec, off: 0, n: len(rec)})
    println(rct + len(rpt))
    _ = record.Update(mut rw)
    println(len(record.Pack(rw)) + len(record.ExpandLabel(k, "key", b, 16)))
    prk := hkdf.Extract(b, k)
    okm, _ := hkdf.Expand(prk, b, 32)
    println(len(okm) + len(hmac.Sum256(k, a)) + len(sha256.Sum256(a)) + binary.Load64(k, 0))
    // tls（hs・Conn の送り）は走らない枝から参照する（ELF に載せるだけ）
    if len(a) == 1000 {
        cfg, _ := tls.Parse("", "")
        _ = tls.Serve(":0", cfg, (tc) => serveOne(tc, a))
    }
    ks := Keys
    kt := ks["testdata/crypto/rsa2048.key"]
    if kt != nil {
        bs, _ := pem.Parse(kt)
        if len(bs) == 1 {
            pk, _ := rsa.ParsePKCS8(bs[0].der)
            sig, _ := rsa.SignPSS(pk, a, b)
            println(len(sig))
        }
    }
    println(len(xs) + len(t) + len(c) + len(opened) + len(chacha20.Block(k, n, 0)) == 0)
    println(crypto.Equal(a, b) || negEqEarly(a, b) || crypto.Select(m, 1, 2) + negSelectIf(m, 1, 2) + negPrefix(k) == 0 || int(w[0]) == 9)
}
