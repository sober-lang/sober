            k := if v != nil { v } else { -1 }
            w := io.WriteStdout(bytes("run ${k}\n"))
            k
        }, give: r2)
        t3, r3 := task.NewChannel[int](cap: 1)
        h3 := task.Spawn(s, (inp) => {
            v := task.Recv(inp)
            k := if v != nil { v } else { -1 }
            w := io.WriteStdout(bytes("run ${k}\n"))
            k
        }, give: r3)
        t4, r4 := task.NewChannel[int](cap: 1)
        h4 := task.Spawn(s, (inp) => {
            v := task.Recv(inp)
            k := if v != nil { v } else { -1 }
            w := io.WriteStdout(bytes("run ${k}\n"))
            k
        }, give: r4)
        t5, r5 := task.NewChannel[int](cap: 1)
        h5 := task.Spawn(s, (inp) => {
            v := task.Recv(inp)
            k := if v != nil { v } else { -1 }
            w := io.WriteStdout(bytes("run ${k}\n"))
            k
        }, give: r5)
        t6, r6 := task.NewChannel[int](cap: 1)
        h6 := task.Spawn(s, (inp) => {
            v := task.Recv(inp)
            k := if v != nil { v } else { -1 }
            w := io.WriteStdout(bytes("run ${k}\n"))
            k
        }, give: r6)
        t7, r7 := task.NewChannel[int](cap: 1)
        h7 := task.Spawn(s, (inp) => {
            v := task.Recv(inp)
            k := if v != nil { v } else { -1 }
            w := io.WriteStdout(bytes("run ${k}\n"))
            k
        }, give: r7)
        t8, r8 := task.NewChannel[int](cap: 1)
        h8 := task.Spawn(s, (inp) => {
            v := task.Recv(inp)
            k := if v != nil { v } else { -1 }
            w := io.WriteStdout(bytes("run ${k}\n"))
            k
        }, give: r8)
        t9, r9 := task.NewChannel[int](cap: 1)
        h9 := task.Spawn(s, (inp) => {
            v := task.Recv(inp)
            k := if v != nil { v } else { -1 }
            w := io.WriteStdout(bytes("run ${k}\n"))
            k
        }, give: r9)
        t10, r10 := task.NewChannel[int](cap: 1)
        h10 := task.Spawn(s, (inp) => {
            v := task.Recv(inp)
            k := if v != nil { v } else { -1 }
            w := io.WriteStdout(bytes("run ${k}\n"))
            k
        }, give: r10)
        t11, r11 := task.NewChannel[int](cap: 1)
        h11 := task.Spawn(s, (inp) => {
            v := task.Recv(inp)
            k := if v != nil { v } else { -1 }
            w := io.WriteStdout(bytes("run ${k}\n"))
            k
        }, give: r11)
        t12, r12 := task.NewChannel[int](cap: 1)
        h12 := task.Spawn(s, (inp) => {
            v := task.Recv(inp)
            k := if v != nil { v } else { -1 }
            w := io.WriteStdout(bytes("run ${k}\n"))
            k
        }, give: r12)
        t13, r13 := task.NewChannel[int](cap: 1)
        h13 := task.Spawn(s, (inp) => {
            v := task.Recv(inp)
            k := if v != nil { v } else { -1 }
            w := io.WriteStdout(bytes("run ${k}\n"))
            k
        }, give: r13)
        t14, r14 := task.NewChannel[int](cap: 1)
        h14 := task.Spawn(s, (inp) => {
            v := task.Recv(inp)
            k := if v != nil { v } else { -1 }
            w := io.WriteStdout(bytes("run ${k}\n"))
            k
        }, give: r14)
        t15, r15 := task.NewChannel[int](cap: 1)
        h15 := task.Spawn(s, (inp) => {
