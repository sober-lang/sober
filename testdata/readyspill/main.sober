            k := if v != nil { v } else { -1 }
            w := io.WriteStdout(bytes("run ${k}\n"))
            k
        }, give: r18)
        t19, r19 := task.NewChannel[int](cap: 1)
        h19 := task.Spawn(s, (inp) => {
            v := task.Recv(inp)
            k := if v != nil { v } else { -1 }
            w := io.WriteStdout(bytes("run ${k}\n"))
            k
        }, give: r19)
        task.Send(t0, 0)
        task.Send(t1, 1)
        task.Send(t2, 2)
        task.Send(t3, 3)
        task.Send(t4, 4)
        task.Send(t5, 5)
        task.Send(t6, 6)
        task.Send(t7, 7)
        task.Send(t8, 8)
        task.Send(t9, 9)
        task.Send(t10, 10)
        task.Send(t11, 11)
        task.Send(t12, 12)
        task.Send(t13, 13)
        task.Send(t14, 14)
        task.Send(t15, 15)
        task.Send(t16, 16)
        task.Send(t17, 17)
        task.Send(t18, 18)
        task.Send(t19, 19)
        task.Join(h0) + task.Join(h1) + task.Join(h2) + task.Join(h3) + task.Join(h4) + task.Join(h5) + task.Join(h6) + task.Join(h7) + task.Join(h8) + task.Join(h9) + task.Join(h10) + task.Join(h11) + task.Join(h12) + task.Join(h13) + task.Join(h14) + task.Join(h15) + task.Join(h16) + task.Join(h17) + task.Join(h18) + task.Join(h19)
    })
    println(r)
