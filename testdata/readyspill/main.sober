        }, give: r16)
        t17, r17 := task.NewChannel[int](cap: 1)
        h17 := task.Spawn(s, (inp) => {
            v := task.Recv(inp)
            k := if v != nil { v } else { -1 }
            w := io.WriteStdout(bytes("run ${k}\n"))
