package main

// 走れる積みの溢れの道の網（report-1168 — 環の容量を 8 にした開発用の build〔--rt-mutant=28〕で、溢れの列が LIFO の順を保つこと）:
// 20 本の子がそれぞれ自分のチャネルの受けで待ち、親が 0〜19 の順に送って 20 本を一度に走れるようにしてから Join で待つ。子は走り出した順に
// 直書き（io.WriteStdout — 実行の順がそのまま出る）で番号を書く。積みは LIFO なので 19 → 0 の順（ワーカー 1）。環の容量 8 では 12 本が溢れの列に
// 入るので、溢れの列の順が崩れる（変異 29）と順が変わる。scripts/schedfuzz.sh の自己検査が「28 ≡ 通常・29 ≢ 通常」を見る
// （送り手は slice に置けないので 20 本を書き下す — このファイルは手で直さず、本数を変えるなら同じ形で書き下す）

import "std/io"
import "std/task"

func main() {
    r, e := task.Run((s task.Scope) => {
        t0, r0 := task.NewChannel[int](cap: 1)
        h0 := task.Spawn(s, (inp) => {
            v := task.Recv(inp)
            k := if v != nil { v } else { -1 }
            w := io.WriteStdout(bytes("run ${k}\n"))
            k
        }, give: r0)
        t1, r1 := task.NewChannel[int](cap: 1)
        h1 := task.Spawn(s, (inp) => {
            v := task.Recv(inp)
            k := if v != nil { v } else { -1 }
            w := io.WriteStdout(bytes("run ${k}\n"))
            k
        }, give: r1)
