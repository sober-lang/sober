package main

// 反復の中で作った値を外の束縛へ運ぶ（反復のregionから外への境界のコピー — コピーの間は元とコピーが両方ある）
func carry() []int {
    mut keep := []int{0}
    mut i := 0
    while i < 3 {
        t := []int{i, i + 1, i + 2, i + 3}
        keep = if t[0] == 2 { t } else { keep }
        i += 1
    }
    return keep
}

func main() {
    k := carry()
    println(k[3])
}
