package asserts

import "std/iter"

func TestPass() {
    assert(Double(2) == 4)
    assert(Name(1) == "one")
    assert(Even(4))
    assert(!Even(3))
    v := Opt("2")
    assert(v != nil && v == "2")
}

func TestCompareFails() {
    x := 3
    assert(Double(x) == x + 1)
}

func TestStringFails() {
    assert(Name(2) == "one")
}

func TestCallFails() {
    assert(Even(Double(1) + 1))
}

func TestBoolFails() {
    ok := Double(1) > 5
    assert(ok)
}

type Pair struct {
    a int
    b int
}

// 印字できない型（byte・struct）の値の行は出さない（補間の穴を諦める — 式と印字できる値だけ）
func TestUnprintableSkipped() {
    c := byte(65)
    p := Pair{a: 1, b: 2}
    n := 5
    assert(c == 'B' && p.a + n == 6)
}

// 関数型の名前は束縛せずに渡す（閉包の値の行は出さない）
func applyFails(f func(int) bool) {
    assert(Apply(f, 3))
}

func TestFnArgFails() {
    applyFails((x) => x > 5)
}

func twiceFails(f func() bool) {
    assert(Twice(f) == 1)
}

func TestFnArgCompareFails() {
    twiceFails(() => true)
}

func TestMutArgFails() {
    mut x := 0
    assert(Inc(mut x))
}

// catch の写しは見出しと値の行に元の綴りで出る
func TestCatchFails() {
    assert((Parse("") catch 7) == Double(1))
}

// ラベル（第 2 実引数）は見出しに出る — テーブル駆動で落ちたケースを名指す
func TestLabelFails() {
    names := []string{"zero", "one", "two"}
    for i <- iter.Range(0, len(names)) {
        assert(Double(i) == i + i + i, "case ${names[i]}")
    }
}

// ラベルは偽のときだけ評価する（通る assert のラベルの式は走らない）
func TestLabelLazy() {
    mut n := 0
    assert(Double(2) == 4, "never ${Inc(mut n)}")
    assert(n == 0)
}
