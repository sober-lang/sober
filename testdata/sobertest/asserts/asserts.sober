package asserts

// power assert の題材（testdata/sobertest — scripts/sobertest.sh。T5）
func Double(n int) int {
    return n * 2
}

func Name(n int) string {
    return if n == 1 { "one" } else { "many" }
}

func Even(n int) bool {
    return n % 2 == 0
}

func Apply(f func(int) bool, x int) bool {
    return f(x)
}

func Twice(f func() bool) int {
    return if f() { 2 } else { 0 }
}

func Inc(x mut int) bool {
    x = x + 1
    return x > 5
}

type Bad error

@errors(Bad)
func Parse(s string) (int, error?) {
    if s == "" {
        return 0, Bad{}
    }
    return 1, nil
}

func Opt(s string) string? {
    return s
}
