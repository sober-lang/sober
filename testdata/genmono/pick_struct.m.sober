package main

// 総称関数の版（pick_struct.g.sober）の型引数を手で代入した単相の版。関数の対応（単相 = 総称の単相コピーの名前）
// genmono: pick = pick[main.Pair]

type Pair struct {
    name string
    xs []int
}

func pick(a Pair, b Pair, first bool) Pair {
    return if first { a } else { b }
}

func main() {
    p := pick(Pair{name: "a", xs: []int{1}}, Pair{name: "b", xs: []int{2, 3}}, false)
    println(p.name, len(p.xs))
}
