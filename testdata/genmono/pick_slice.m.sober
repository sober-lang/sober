package main

// 総称関数の版（pick_slice.g.sober）の型引数を手で代入した単相の版。関数の対応（単相 = 総称の単相コピーの名前）
// genmono: pickS = pick[[]int]
// genmono: pickT = pick[string]

func pickS(a []int, b []int, first bool) []int {
    return if first { a } else { b }
}

func pickT(a string, b string, first bool) string {
    return if first { a } else { b }
}

func main() {
    s := pickS([]int{1, 2, 3}, []int{4}, true)
    t := pickT("left", "right", false)
    println(len(s), t)
}
