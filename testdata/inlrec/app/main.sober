package main

import "testdata/inlrec/lib"

type U struct {
    s testdata.inlrec.lib.S
    k int
}

func llen(u mut U, l int) int {
    return testdata.inlrec.lib.Llen(mut u.s, l)
}

func main() {
    ts := []testdata.inlrec.lib.T{testdata.inlrec.lib.T{xs: []int{7, 8}}}
    mut u := U{s: testdata.inlrec.lib.Mk(ts), k: 0}
    println(llen(mut u, 101))
    println(llen(mut u, 1))
}
