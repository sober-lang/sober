package model

// json.Decode[T] のTが別packageのstruct（フィールドの型も別packageの名前を含む — 合成ファイルは参照名 $jt<i> でimportする）

import "testdata/jsonpkg/geo"

type User struct {
    id int
    name string
    home testdata.jsonpkg.geo.Pt
    visits []testdata.jsonpkg.geo.Pt
    boss Ref?
}

type Ref struct {
    id int
}
