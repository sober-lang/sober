package lib

// sober fix の網（scripts/fixcheck.sh — effect の波 段 5a-3）: 宣言の無い公開関数・古い正の列挙・古い @errors・否定形と漏れ（触らない）

import "std/os"

type Bad error {
    n int
}

type Gone error {
}

@errors(Bad)
@effects()
func Check(k int) (int, error?) {
    return if k > 0 { k } else { 0 }, if k > 0 { nil } else { Bad{n: k} }
}

@errors(Bad)
@effects()
func Strict(k int) (int, error?) {
    return if k > 0 { k } else { 0 }, if k > 0 { nil } else { Bad{n: k} }
}

@effects()
func Pure(x int) int {
    return x * 2
}

@effects(io)
func Wide(x int) {
    println(x)
}

@effects(!block)
func Quiet(x int) int {
    return x + 1
}

@effects(block)
func Nap(ms int) {
    os.Sleep(ms)
}

func helper(x int) int {
    return x
}
