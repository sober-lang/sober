package main

// errtrace のコーパス: error? を slice の要素に置いて取り出す（添字の読みは導出で TOP）

import "std/iter"

type A error {
    n int
}

type B error

func pick(i int) (int, error?) {
    es := []error?{A{n: 7}, B{}, nil}
    e := es[i]
    if e != nil {
        return 0, e
    }
    return i, nil
}

func main() {
    for i <- iter.Range(0, 3) {
        _, err := pick(i)
        if err != nil {
            x := switch err {
            case A{n}: n
            case B{}: 2
            }
            println(x)
        } else {
            println("nil")
        }
    }
}
