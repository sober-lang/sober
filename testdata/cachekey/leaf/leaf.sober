package leaf

// キャッシュの鍵のゲート（scripts/cachekey.sh — 3'' 第 2 段 C1）の題材: 葉の package。本体だけの編集・署名の編集・@embed のファイルの編集で、
// どの package の鍵が変わるかを見る

@embed("testdata/cachekey/leaf/data/*.txt")
const Data = map[string]string{}

// Inc は 1 足す
func Inc(x int) int {
    return x + 1
}

// Count は埋め込んだファイルの数
func Count() int {
    return len(Data)
}
