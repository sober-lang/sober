package main

// 回帰例（language.md 32 節）: package 修飾の型なしの const（`testdata.constpkg.lib.Five`）は文脈の named に割り当てられる
// min int の const（testdata.constpkg.lib.Min）は package をまたいで .sobi の読み戻し〔check --split〕でも通ること（report-878）
// （check は表層型検査器の表を読むようになって拒否しかけた・build は前から拒否していた — isUntypedConst が選択子を見ていなかった。C1 B3）

import "testdata/constpkg/lib"

type N int

func main() {
    mut n := N(1)
    n = testdata.constpkg.lib.Five
    m := N(testdata.constpkg.lib.Five)
    if n == testdata.constpkg.lib.Five && m == n {
        println(int(n))
    }
    k := if n == m { testdata.constpkg.lib.Five } else { n }
    println(int(k))
    println(testdata.constpkg.lib.Min)
}
