package main

// 別のpackageのTの格納場所を子taskが借りる（Localはimmのデータとして捕獲で渡る — 出力はWに依らない）

import "std/iter"
import "std/task"
import "testdata/lease/wk"

// countはウィンドウ1つ（Localはimmのデータとして実引数でも渡る）
func count(lw task.Local, i int) int {
    return task.Lease(lw, (w mut testdata.lease.wk.Work) => testdata.lease.wk.Count(mut w, []int{i}))
}

func main() {
    lw := task.NewLocal((w mut testdata.lease.wk.Work) => testdata.lease.wk.Prep(mut w))
    rs, err := task.Run((s) => {
        mut hs := mut []task.Handle[int]{}
        for i <- iter.Range(0, 8) {
            hs = append(hs, task.Spawn(s, () => task.Lease(lw, (w mut testdata.lease.wk.Work) => testdata.lease.wk.Count(mut w, []int{i, i, 3, i % 2}))))
        }
        vs := task.Gather(hs)
        vs
    })
    for i <- iter.Range(0, len(rs)) {
        println(rs[i])
    }
    println(err == nil, count(lw, 5))
}
