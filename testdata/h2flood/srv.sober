package main

// HTTP/2の攻撃の照合（scripts/h2spec.shのh2floodの段）のサーバー。127.0.0.1の空いたポートでproto: H2に応じ（"ready <port>" を出してから待ち受ける）、
// 期限を短くする（頭2秒・送りの間隔1秒）。`srv tls <port>` はTLS（testdataの証明書・ALPN h2 / http/1.1・TLS 1.2も受ける — DangerouslyAllowTls12）で127.0.0.1:<port> に立つ
// （"tls-ready <port>" を出してから待ち受ける — h2specの段のTLSの回とh2floodのTLSの回）
//   /       → "ok\n"
//   /big    → 40000バイトの本文（窓を開けない相手には送り切れない）
//   /shed   → 全部のプールの節のshedの和（GOAWAY〔ENHANCE_YOUR_CALM〕で閉じた接続はshedに数える）

import "std/convert"
import "std/http/server"
import "std/io"
import "std/net"
import "std/os"
import "std/task"
import "std/tls"

func route(r http.server.Request) http.server.Response {
    if r.path == "/big" {
        mut b := mut []byte{}
        while len(b) < 40000 {
            b = append(b, byte(97 + len(b) % 26))
        }
        return http.server.Response{status: 200, contentType: "text/plain", body: freeze(b)}
    }
    if r.path == "/shed" {
        mut sh := 0
        for p <- task.Ledger().pools {
            sh += p.shed
        }
        return http.server.Text("${convert.FormatInt(sh)}\n")
    }
    return http.server.Text("ok\n")
}

func conn(c net.Conn) error? {
    return http.server.ServeConn(c, route, headWait: 2000 * task.MS, sendWait: 1000 * task.MS, proto: http.server.H2)
}

func run() error? {
    for l <- net.Listen("127.0.0.1:0")? {
        io.WriteStdout(bytes("ready ${net.Port(l)}\n"))?
        net.Serve(l, conn)?
    }
    return nil
}

// TLSの接続の予算: ストリームの子の予算は接続の予約と同じなので、/bigの本文（40000バイト）を作る子が入る大きさを宣言する
func runTls(port string) error? {
    cfg0 := tls.Load("testdata/crypto/httparena-server.crt", "testdata/crypto/httparena-server.key")?
    io.WriteStdout(bytes("tls-ready ${port}\n"))?
    return tls.Serve("127.0.0.1:${port}", tls.DangerouslyAllowTls12(tls.Alpn(cfg0, []string{"h2", "http/1.1"})), conn, budget: 1048576)
}

func main() int {
    args := os.Args() catch return 1
    if len(args) == 3 && args[1] == "tls" {
        return if runTls(args[2]) == nil { 0 } else { 1 }
    }
    return if run() == nil { 0 } else { 1 }
}
