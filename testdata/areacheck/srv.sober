package main

// gate areacheck の相手（scripts/areacheck.sh）: 接続のtask（エリアの形）に4つのパスを踏ませる — /okは普通に返る・/sleep/{ms} はディープスリープの後に返る・
// /big/{n} はnバイトの本文（予約ページから小さいスロットへ移る深度を作る）・/hold/{ms}/{マーク} は深くスリープした後にリクエストのpath（受けのregionの中身）をそのまま返す（エリアの予約ページの中身がスリープしている間に守られる証）・
// /panicはhandlerの中で死ぬ・/sleepの長い待ちはServeの期限でスリープしたまま捨てられる・/ledgerはLedgerの待ちの形の数。"ready <port>" を出してから受け、Serveの期限
// （argv[1] ms）でServeが返ったら "drained" を出してargv[2] ms生きている（外からエリアの持ち主を数える間）。argv[3] がfarなら本体の太い
// 形（ServeConnの圧縮・作業域 — 本体の枠がチャンクのページ0の余白に入らず遠いパスを通る — 計測用のhalmと同じ太り方）

import "std/compress/flate"
import "std/convert"
import "std/http/server"
import "std/iter"
import "std/net"
import "std/os"
import "std/strings"
import "std/task"

type Boom panic {}

func num(s string?) int {
    return if s == nil { 0 } else { convert.ParseInt(s) catch 0 }
}

func route(r http.server.Request) http.server.Response {
    return switch {
    case r.path == "/ok": http.server.Text("ok")
    case r.path == "/panic": panic(Boom{})
    case r.path == "/ledger": ledgerText()
    case strings.HasPrefix(r.path, "/big/"): http.server.Text(big(num(strings.TrimPrefix(r.path, "/big/"))))
    case strings.HasPrefix(r.path, "/hold/"): {
        ms, _, _ := strings.Cut(strings.TrimPrefix(r.path, "/hold/"), "/")
        os.Sleep(num(ms))
        http.server.Text(r.path)
    }
    case strings.HasPrefix(r.path, "/sleep/"): {
        ms := num(strings.TrimPrefix(r.path, "/sleep/"))
        os.Sleep(ms)
        http.server.Text(convert.FormatInt(ms))
    }
    default: http.server.Status(404)
    }
}

// nバイトの本文（リクエストのregionに作る — 予約ページの1ページを越えると予約ページから小さいスロットへ移る）
func big(n int) string {
    mut b := mut []byte{}
    for i <- iter.Range(0, n) {
        b = append(b, byte('a' + i % 26))
    }
    return string(freeze(b)) catch ""
}

func ledgerText() http.server.Response {
    l := task.Ledger()
    return http.server.Text("aged=${l.aged} late=${l.late} maxLate=${l.maxLate} maxWait=${l.maxWait} backlog=${l.backlog} shed=${l.shed} parkShallow=${l.parkShallow} parkDeep=${l.parkDeep} parkSwap=${l.parkSwap} parkDeepWin=${l.parkDeepWin}")
}

// 本体の枠の太り（farの題材の前提 — 本体の枠がチャンクのページ0の余白〔TCB_TOP_ROOM〕に入らないこと）: ServeConnの呼び出しをまたいで生きる64ワードの値。
// ServeConnの側の枠だけに頼ると、コンパイラの改善で枠が縮んだとき題材が近いパスへ移る（far bodyの行が近いパスの値で赤になる）
type P8 struct {
    a int
    b int
    c int
    d int
    e int
    f int
    g int
    h int
}

type Pad struct {
    a P8
    b P8
    c P8
    d P8
    e P8
    f P8
    g P8
    h P8
}

func p8(x int) P8 {
    return P8{a: x, b: x + 1, c: x + 2, d: x + 3, e: x + 4, f: x + 5, g: x + 6, h: x + 7}
}

func pad(x int) Pad {
    return Pad{a: p8(x), b: p8(x + 8), c: p8(x + 16), d: p8(x + 24), e: p8(x + 32), f: p8(x + 40), g: p8(x + 48), h: p8(x + 56)}
}

func p8Sum(q P8) int {
    return q.a + q.b + q.c + q.d + q.e + q.f + q.g + q.h
}

func padSum(p Pad) int {
    return p8Sum(p.a) + p8Sum(p.b) + p8Sum(p.c) + p8Sum(p.d) + p8Sum(p.e) + p8Sum(p.f) + p8Sum(p.g) + p8Sum(p.h)
}

func serve(serveMs int, far bool) error? {
    gzw := task.NewLocal((w mut compress.flate.Work) => compress.flate.NewWork(mut w))
    for l <- net.Listen("127.0.0.1:0")? {
        println("ready ${net.Port(l)}")
        if far {
            _, _ = task.Run((s task.Scope) => net.Serve(l, (c net.Conn) => {
                p := pad(serveMs)
                e := http.server.ServeConn(c, (r http.server.Request) => if r.path == "/ledger" { ledgerText() } else { route(r) }, maxBody: 65536, compression: http.server.Gzip{}, work: gzw)
                if padSum(p) == 0 - 1 {
                    println("pad")
                }
                e
            }, conns: 40000, maxWait: 100 * task.MS), deadline: serveMs * task.MS)
        } else {
            _, _ = task.Run((s task.Scope) => net.Serve(l, (c net.Conn) => http.server.ServeConn(c, (r http.server.Request) => route(r))), deadline: serveMs * task.MS)
        }
    }
    return nil
}

func main() int {
    args := os.Args() catch return 2
    if len(args) != 3 && len(args) != 4 {
        return 2
    }
    e := serve(num(args[1]), len(args) == 4 && args[3] == "far")
    println("drained")
    os.Sleep(num(args[2]))
    return if e != nil { 1 } else { 0 }
}
