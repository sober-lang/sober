package main

import "testdata/constlit/lib"

const Mine = []testdata.constlit.lib.Flag{testdata.constlit.lib.Flag{name: "x", on: true}}

const Tag = testdata.constlit.lib.Version

func main() {
    println(testdata.constlit.lib.Version, Tag, testdata.constlit.lib.Debug, testdata.constlit.lib.Ratio)
    println(len(testdata.constlit.lib.Sizes), testdata.constlit.lib.Sizes[2], testdata.constlit.lib.Defaults[1].name)
    println(testdata.constlit.lib.Count(testdata.constlit.lib.Defaults), testdata.constlit.lib.Count(Mine))
}
