package main

// 段 6 P3b: give: で子へ移した送り端を親が使う = 失効した別名（定義された panic — 持ち主は記録の印・失効は親のプログラム順だけで決まる）

import "std/par"

func main() {
    r, e := par.Scope((s par.S) => {
        tx, rx := par.NewChan[int](cap: 2)
        h := par.Spawn(s, (out) => {
            par.Send(out, 1)
            1
        }, give: tx)
        par.Send(tx, 5)
        par.Join(h)
    })
    println(r)
}
