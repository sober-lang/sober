package main

// 部分リテラル（language.md 15 節）: 名前つきで一部のフィールドだけ書き、
// 省いたフィールドはゼロ値（`T{}` と同じ — int 0・string ""・mutのsliceは空・入れ子のstructはそのフィールドごと）。書いた値は書いた順に評価する。
// 封の型（utf8.View）をフィールドに持つ封の無いstructも部分リテラルで書ける — 封の型のフィールドはゼロ値（空の検査済み列 — 無害）

import "std/utf8"

type Q struct {
    c int
    d bool
}

type St struct {
    xs mut []int
    name string
    n int
    q Q
}

type Line struct {
    v utf8.View
    no int
}

type Img struct {
    w int
    h int
    tags []string
}

func tick(s string) int {
    println("eval ${s}")
    return len(bytes(s))
}

func main() {
    s := St{name: "x"}
    println(s.name, s.n, len(s.xs), s.q.c, s.q.d)
    // mutの束縛・入れ子の部分リテラル・フィールドの順と違う順（値は書いた順に評価）
    mut m := St{q: Q{d: true}, n: tick("ab")}
    m.xs = append(m.xs, 7)
    m.n += tick("c")
    println(m.n, len(m.xs), m.q.d, m.name == "")
    // immのフィールド（[]string）を省く
    i := Img{h: 2, w: 3}
    println(i.w * i.h, len(i.tags))
    l := Line{no: 4}
    println(l.no, len(utf8.Bytes(l.v)))
}
