package main

// V3-4 の検証例: V1 の lexer のトークン列を for-yield（Iter[T]）で消費する。
// for 式は Iter の引数位置でだけ消費され、消費点で展開する（F1。std/iter は暗黙に import される）

import "std/iter"

type Token struct {
    kind, start, end int
}

func isDigit(c int) int {
    return if c >= '0' && c <= '9' { 1 } else { 0 }
}

func isAlpha(c int) int {
    return if c >= 'a' && c <= 'z' { 1 } else { 0 }
}

func lex(text string) []Token {
    src := bytes(text)
    mut toks := mut []Token{}
    mut i := 0
    while i < len(src) {
        c := int(src[i])
        if c == ' ' {
            i += 1
        } else if isDigit(c) == 1 {
            mut j := i
            while j < len(src) && isDigit(int(src[j])) == 1 {
                j += 1
            }
            toks = append(toks, Token{0, i, j})
            i = j
        } else if isAlpha(c) == 1 {
            mut j := i
            while j < len(src) && (isAlpha(int(src[j])) == 1 || isDigit(int(src[j])) == 1) {
                j += 1
            }
            toks = append(toks, Token{1, i, j})
            i = j
        } else {
            toks = append(toks, Token{2, i, i + 1})
            i += 1
        }
    }
    return freeze(toks)
}

func printToken(t Token) {
    println(t.kind, t.start, t.end)
}

func main() {
    toks := lex("ab1 42+x 7")
    // 識別子の数（`|>` は for 式全体に掛かる）
    println(for t <- toks if t.kind == 1 yield t |> iter.Count())
    // 各トークンの長さ
    for t <- toks yield t.end - t.start |> iter.Each(_, (w) => { println(w) })
    // 数字トークンの長さの和
    println(iter.Sum(for t <- toks if t.kind == 0 yield t.end - t.start))
    // ブロック形: 記号トークンの位置
    iter.Each(for t <- toks {
        if t.kind == 2 {
            yield t.start
        }
    }, (p) => { println(p) })
    // struct を yield して消費側で使う
    for t <- toks if t.kind != 2 yield Token{t.kind, t.start, t.end} |> iter.Each(_, (tk) => { printToken(tk) })
}
