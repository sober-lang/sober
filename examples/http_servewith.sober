package main

// http.server.ServeWith: 転送路の受けのインターフェースrecvと送りのインターフェースsendを渡す形。ここではネットの代わりに、recvは決まった
// リクエストの列を1切片で渡す偽の転送路・sendは送られたレスポンスのバイト列を印字する（netの接続ならServeConn = `ServeWith((k) => net.Recv(c, k), (b) => net.Send(c, b), …)`・
// TLSなら `(k) => tls.Recv(c, k)` / `(b) => tls.Send(c, b)`）。streamのレスポンスのemitもsendを通る（展開待ちの捕捉 — language.md 25 節 (α-L0)）

import "std/http/server"

func route(r http.server.Request) http.server.Response {
    if r.path == "/stream" {
        return http.server.Response{status: 200, contentType: "text/plain", length: 6, stream: (out, emit) => emit(mut out, bytes("chunk\n"))}
    }
    return http.server.Text("hello\n")
}

func show(b []byte) error? {
    println("[${len(b)} bytes]")
    return nil
}

func feed(s string, k func([]byte)) error? {
    k(bytes(s))
    return nil
}

func main() {
    reqs := "GET / HTTP/1.1\r\nHost: x\r\n\r\nGET /stream HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"
    e := http.server.ServeWith((k) => feed(reqs, k), (b) => show(b), route)
    println(e == nil)
}
