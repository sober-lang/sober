package main

// 段 6 P3b（language.md 11 節「チャネル」）: 端点 2 型・SPSC・有界。送り端は give: でちょうど 1 つの子へ移る（名前付きの実引数は末尾・仮引数は親の名前と別の名前 — `task.Spawn(s, (out) => …, give: tx)`）。受け手は送られる数を
// 知っている形で書く（Close は P3b-2c の Lean 便まで無い — Recv は T? だが今は nil にならない）

import "std/task"

func main() {
    r, e := task.Run((s task.Scope) => {
        tx, rx := task.NewChannel[int](cap: 2)
        n := 5
        h := task.Spawn(s, (out) => {
            mut i := 0
            while i < n {
                task.Send(out, i * i)
                i += 1
            }
            n
        }, give: tx)
        mut sum := 0
        mut k := 0
        while k < n {
            v := task.Recv(rx)
            if v != nil {
                sum += v
            }
            k += 1
        }
        sum + task.Join(h)
    })
    println(r)
}
