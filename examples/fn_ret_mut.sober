package main

// mutの仮引数を持つ関数はmutの値を返せる（格納場所は呼び手のmutの実引数のregion — language.md 26 節）。
// mut の仮引数も関数型の仮引数も持たない関数は返せない（examples/fn_ret_mut_neg.sober）

import "std/iter"

// bの要素の2倍を新しいmutのsliceに積んで返す（bの末尾にマークを足す）
func doubled(b mut []int) mut []int {
    mut out := mut []int{}
    for i <- iter.Range(0, len(b)) {
        out = append(out, b[i] * 2)
    }
    b = append(b, 0)
    return out
}

func main() {
    mut b := mut []int{1, 2, 3}
    mut d := doubled(mut b)
    d = append(d, 8)
    println("${len(b)} ${len(d)} ${d[2]}")
}
