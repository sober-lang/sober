package main

// chan のペイロードに端点（kind 19） — check と build が同じ名指しで拒否（desugar/parcheck.sober）。縮退の前提「縮退した子が待てるのは自分の子孫だけ」の柵

import "std/task"

type W struct {
    rx task.Receiver[int]
}

func main() {
    r, e := task.Run((s task.Scope) => {
        tx, rx := task.NewChannel[int](cap: 1)
        ta, ra := task.NewChannel[W](cap: 1)
        task.Send(ta, W{rx: rx})
        h := task.Spawn(s, (q) => {
            w := task.Recv(q)
            if w != nil {
                v := task.Recv(w.rx)
                if v != nil { v } else { 0 }
            } else { 0 }
        }, give: ra)
        task.Send(tx, 3)
        task.Join(h)
    })
    println(r)
}
