package main

// 仮引数の名前の @errors（language.md 13 節 — 展開される関数の匿名の関数型の仮引数）: Pump の宣言は自分のラベル Bad と、仮引数 recv / send の
// 呼び出しの失敗。呼び手の switch は呼び出し点ごとに、その点で recv / send に渡した実引数のラベル（ラムダの本体の値・名前つき関数の集合）を網羅する
// — 1 つ目の呼び出しは Bad と Short、2 つ目は Bad と Gone。負例 testdata/analyzer_neg/errors_param*

type Short error {
    n int
}

type Bad error

type Gone error

@errors(Bad, recv, send)
func Pump(recv func(k func(n int)) error?, send func(n int) error?) error? {
    mut total := 0
    recv((n) => { total = total + n })?
    if total < 0 {
        return Bad{}
    }
    send(total)?
    return nil
}

// recv の失敗を包み替える（Bad の cause へ — 戻りへ漏れないので宣言に recv は要らない）
@errors(Bad)
func Frame(recv func(k func(n int)) error?) (int, error?) {
    mut total := 0
    recv((n) => { total = total + n })? Bad{}
    return total, nil
}

func feed(k func(n int)) error? {
    k(3)
    k(4)
    return nil
}

func put(n int) error? {
    if n > 5 {
        return Short{n: n}
    }
    return nil
}

func gone(n int) error? {
    return if n > 100 { Gone{} } else { nil }
}

func main() {
    e := Pump((k) => feed(k), (n) => put(n))
    switch e {
    case nil:
        println(0)
    case Bad{}:
        println(1)
    case Short{n}:
        println(n)
    }
    e2 := Pump(feed, gone)
    switch e2 {
    case nil:
        println(0)
    case Bad{}:
        println(1)
    case Gone{}:
        println(2)
    }
    t := Frame(feed) catch -1
    println(t)
}
