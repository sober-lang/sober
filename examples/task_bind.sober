package main

// 段 6 P3a: task.Run の多値の束縛（総称の多値 — 結果の型式からは読めない）を総称の呼び出しに渡す・ブロックの末尾に使う（check の誤拒否の回帰 — progen --par で発見）

import "std/task"

func pick2[T](b bool, x T, y T) T {
    return if b { x } else { y }
}

func main() {
    v1, pe1 := task.Run((s1 task.Scope) => 5)
    println(pick2(true, v1, v1))
}
