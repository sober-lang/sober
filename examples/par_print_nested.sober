package main

// 段 6 P4-2 (O1): 入れ子の scope の印字 — 孫の流れは子の流れの spawn の位置に、子の流れは親の spawn の位置に入る（先行順）。
// 孫が chan で待つので、子の後半と親の後半は孫が終わるまで溜まる

import "std/par"

func inner(tag string) int {
    println("${tag} opens")
    r, e := par.Scope((s par.S) => {
        tx, rx := par.NewChan[int](cap: 1)
        g := par.Spawn(s, (inp) => {
            println("${tag}.g waits")
            v := par.Recv(inp)
            mut got := 0
            if v != nil {
                println("${tag}.g got ${v}")
                got = v
            }
            got
        }, give: rx)
        println("${tag} sends")
        par.Send(tx, len(bytes(tag)))
        println("${tag} joins")
        par.Join(g)
    })
    println("${tag} closes ${r}")
    return r
}

func main() {
    println("start")
    r, e := par.Scope((s par.S) => {
        a := par.Spawn(s, () => inner("a"))
        b := par.Spawn(s, () => inner("bb"))
        println("parent")
        par.Join(a) + par.Join(b)
    })
    println("total ${r}")
}
