package main

// 負例（load が拒否 — diag.JsonShape 2）: shape[T] の第一便の範囲外の欄の型（map — union・総称・named scalar・[]T? も同じ）

import "std/json"

type Conf struct {
    name string
    env map[string]string
}

func main() {
    d, err := json.Parse(bytes("{}"))
    if err != nil {
        return
    }
    c, derr := json.Decode[Conf](d, json.Root(d))
    if derr == nil {
        println(c.name)
    }
}
