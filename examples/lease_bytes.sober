package main

// ウィンドウの値がsliceのlease（region-domain-pool.md 4d節）: ウィンドウの本体がmut実引数の関数の呼び出しで、その結果（ウィンドウのregionに作られた列）をウィンドウの値として
// 外へ出す素直な形。checkもbuildも受理し、値はウィンドウの出口で外のregionへコピーされる（展開される関数の結果は署名の座標で読む際にコピーを付ける必要がある —
// 付けないと check が受理しない式を build だけが受理してしまう）。束縛してから返す形・ブロックの値の形も同じ

import "std/task"
import "std/pool"

type Work struct {
    tab pool.Scratch
}

// bの各バイトにtabの世代の数え（ウィンドウのたびに0から）を足した列
func enc(w mut Work, b []byte) []byte {
    mut out := mut []byte{}
    mut i := 0
    while i < len(b) {
        pool.Store(mut w.tab, 0, pool.Load(mut w.tab, 0) + 1)
        out = append(out, byte(int(b[i]) + pool.Load(mut w.tab, 0)))
        i += 1
    }
    return freeze(out)
}

func main() {
    lw := task.NewLocal((w mut Work) => pool.NewScratch(mut w.tab, 1))
    b := bytes("abc")
    z := task.Lease(lw, (w mut Work) => enc(mut w, b))
    y := task.Lease(lw, (w mut Work) => {
        r := enc(mut w, b)
        r
    })
    x := {
        mut w := Work{}
        pool.NewScratch(mut w.tab, 1)
        enc(mut w, b)
    }
    println(string(z) catch "?")
    println(string(y) catch "?")
    println(string(x) catch "?")
}
