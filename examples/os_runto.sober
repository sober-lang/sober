package main

// std/os.RunTo: 子の標準出力と標準エラーを別々のファイルへ捕まえる（どちらも空にしてから書く）・同じ path を渡せば書いた順で 1 本に混ざる・
// 捕まえる先を開けなければ子を走らせずに error（親の出力は捕まらない — 子の付け替えは子の中だけ）
import "std/io"
import "std/os"

func show(path string) {
    b := io.ReadFile(path) catch return
    println("[${string(b) catch ""}]")
}

func main() {
    d := runDir("os_runto")
    defer removeAll(d)
    println("before")
    c, err := os.RunTo("/bin/sh", []string{"-c", "echo out; echo err >&2; exit 3"}, d + "/o", d + "/e")
    if err == nil {
        println(c)
    }
    show(d + "/o")
    show(d + "/e")
    m, merr := os.RunTo("/bin/sh", []string{"-c", "echo a; echo b >&2; echo c"}, d + "/m", d + "/m")
    if merr == nil {
        println(m)
    }
    show(d + "/m")
    _, nerr := os.RunTo("/bin/true", []string{}, d + "/no/such/dir/o", d + "/e")
    println(switch nerr {
    case nil: "ran"
    case io.NotFound{}: "not found"
    default: "other"
    })
    println("after")
}

// 実行ごとの置き場 out/<name>.<単調時計の値>（同じ作業ディレクトリで同時に走る実行どうしが上書きし合わない）。
// mkdirは既にあれば失敗するので、作れた名前がこの実行のもの。作れない状態で回り続けないよう、試す回数に上限を置く（作れなければ ""）
func runDir(name string) string {
    _ = os.Mkdir("out")
    mut n := 0
    while n < 100 {
        c := "out/${name}.${os.Monotonic()}"
        if os.Mkdir(c) == nil {
            return c
        }
        n = n + 1
    }
    return ""
}

// 置き場を中身ごと消す
func removeAll(d string) {
    if d != "" {
        _ = os.Run("/bin/rm", []string{"-rf", d}) catch 0
    }
}
