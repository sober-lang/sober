package main

const K = 1 << 4
const M = -64 >> 3

func shl(x, n int) int {
    return x << n
}

func shr(x, n int) int {
    return x >> n
}

// シフト（Go 準拠）: 量 ≥ 64 は << = 0・>> = 0 / -1。Examples.lean の突き合わせと同じケース
func main() {
    println(shl(1, 3), shl(-7, 2), shl(5, 0), shl(1, 64), shl(3, 100))
    println(shr(40, 3), shr(-7, 1), shr(-1, 100), shr(7, 64), shr(-8, 63), shr(5, 0))
    println(K, M)
    mut x := 3
    x <<= 4
    mut y := -100
    y >>= 2
    println(x, y)
}
