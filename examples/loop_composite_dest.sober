package main

import "std/builder"

// ループの中から外の mut 場所へ代入する struct リテラルは、mut のコンテナの欄を行き先（外の束縛の region）に作る。
// 省いた欄のゼロ値（Builder の seed / chunks）・入れ子のリテラル・丸ごとの代入・欄の imm の値（行き先へ写す）。
// 直さないと check が反復の region に作ってしまい def error になる（build は正しく走る）

type In struct {
    s mut []int
    tag string
}

type W struct {
    in In
    eh builder.Builder[int]
    sp int
}

func run(n int, name string) int {
    mut w := W{}
    mut i := 0
    while i < n {
        w.eh = builder.Builder[int]{}
        builder.Push(mut w.eh, i)
        w.in = In{tag: name + "!"}
        w.in.s = append(w.in.s, i)
        w = W{in: w.in, eh: w.eh, sp: w.sp + 1}
        i += 1
    }
    println(w.in.tag)
    return w.sp + len(w.in.s) + builder.Len(mut w.eh)
}

func main() {
    println(run(3, "x"))
}
