package main

// 文脈欄の負例: 局所の欄の秘密は、値が逃げる所（return・欄・リテラル）で型 × 名前のスロットへ移る — 呼び出しの結果の欄から読んでも秘密

type Box struct {
    v int
}

func put(b mut Box, x int) {
    b.v = x
}

@secret(k)
func make(k int) Box {
    mut b := Box{v: 0}
    put(mut b, k)
    return b
}

func main() {
    if make(3).v > 1 {
        println("big")
    }
}
