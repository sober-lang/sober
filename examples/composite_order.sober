package main

// compositeリテラルの値は書いた順に評価する（language.md 27 節・Goと同じ）: 名前つきでフィールドの宣言順と違う順に書いても
// fの出力は3 1 2 / 5 4。checkのコアは書いた順のletに束縛してからフィールドの順に組む（フィールドに正しい値が入ることは1 2 3 / 45で見る）

type P struct {
    x int
    y int
    z int
}

type U union {
    A { p int; q int }
    B {}
}

func f(n int) int {
    println(n)
    return n
}

func main() {
    s := P{z: f(3), x: f(1), y: f(2)}
    println(s.x, s.y, s.z)
    u := A{q: f(5), p: f(4)}
    println(switch u {
    case A{p, q}: p * 10 + q
    default: 0
    })
}
