package main

// composite リテラルの値は書いた順に評価する（language.md 27 節 — 2026-09-30、Go と同じ）: 名前つきで欄の宣言順と違う順に書いても
// f の出力は 3 1 2 / 5 4。check のコアは書いた順の let に束縛してから欄の順に組む（欄に正しい値が入ることは 1 2 3 / 45 で見る）

type P struct {
    x int
    y int
    z int
}

type U union {
    A { p int; q int }
    B {}
}

func f(n int) int {
    println(n)
    return n
}

func main() {
    s := P{z: f(3), x: f(1), y: f(2)}
    println(s.x, s.y, s.z)
    u := A{q: f(5), p: f(4)}
    println(switch u {
    case A{p, q}: p * 10 + q
    default: 0
    })
}
