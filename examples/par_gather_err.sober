package main

// P3b 残穴1・2: error を返す task の handle の slice（要素の型 `par.Task[(T, error?)]` — 多値の型は型引数の位置にだけ）・
// fallible な Gather（`([]T, error?)` — 全部を生んだ順で待ち、err は生んだ順で最初の失敗・失敗があれば結果は空）・
// fallible な Map（ラムダが `(U, error?)` を返す — 同じ規則・子が死ねば err = TaskDied）

import "std/par"
import "std/strings"

type Bad error {
    n int
}

func load(n int) (int, error?) {
    if n < 0 {
        return 0, Bad{n: n}
    }
    return n * 10, nil
}

func name(n int) (string, error?) {
    if n == 7 {
        return "", Bad{n: 7}
    }
    return "s" + strings.FormatInt(n), nil
}

func pick(xs []int, i int) (int, error?) {
    return xs[i], nil
}

func show(e error?) string {
    if e == nil {
        return "nil"
    }
    switch e {
    case Bad{n}: return "Bad ${n}"
    case par.TaskDied{}: return "TaskDied"
    default: return "?"
    }
}

// sum は関数の本体の fallible な Gather
func sum(ns []int) (int, error?) {
    r, e := par.Scope((s par.S) => {
        mut hs := mut []par.Task[(int, error?)]{}
        for n <- ns {
            hs = append(hs, par.Spawn(s, () => load(n)))
        }
        vs, err := par.Gather(hs)
        mut t := 0
        for v <- vs {
            t += v
        }
        if err != nil { 0 - 1 } else { t }
    })
    return r, e
}

func main() {
    r, e := par.Scope((s par.S) => {
        mut hs := mut []par.Task[(int, error?)]{}
        hs = append(hs, par.Spawn(s, () => load(3)))
        hs = append(hs, par.Spawn(s, () => load(4)))
        vs, err := par.Gather(hs)
        // 失敗が 2 つ: err は生んだ順で最初（Bad -5）・結果は空
        mut ks := mut []par.Task[(int, error?)]{}
        ks = append(ks, par.Spawn(s, () => load(1)))
        ks = append(ks, par.Spawn(s, () => load(-5)))
        ks = append(ks, par.Spawn(s, () => load(-6)))
        ws, err2 := par.Gather(ks)
        // 同じ handle を Join でも見られる（Gather は Join の列 — handle = future）
        v1, e1 := par.Join(ks[1])
        "${vs[0] + vs[1]} ${show(err)} ${len(ws)} ${show(err2)} ${v1} ${show(e1)}"
    })
    println(r)
    println(show(e))
    t, te := sum([]int{1, 2, 3})
    println("${t} ${show(te)}")
    ms, me := par.Map([]int{1, 2, 3}, (v) => name(v))
    println("${ms[0]}${ms[2]} ${show(me)}")
    ns, ne := []int{5, 7, 9, 7} |> par.Map((v) => name(v))
    println("${len(ns)} ${show(ne)}")
    xs, xe := par.Map([]int{1, 2}, (v) => load(v - 2))
    println("${len(xs)} ${show(xe)}")
    // 子が死ぬ（範囲外）: err = TaskDied（死が先）
    hs := []int{10, 20}
    ds, de := par.Map([]int{0, 5, 1}, (j) => pick(hs, j))
    println("${len(ds)} ${show(de)}")
}
