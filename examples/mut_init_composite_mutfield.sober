package main

// 拒否のまま（formal.md「checkのcallMの段階」の (ii)）: 外の mut slice をフィールドに持つmut局所をループの中で組み、callMのDefへ渡す。
// セルの中のmutの成分は束縛点のregionへ緩められず、anchor（= 束縛点）のコピーと合わない — language.md 21 節 (β) と同じ根。buildは受理して走る

type W struct {
    buf mut []int
    sp int
}

func walk(w mut W, n int) {
    if n > 0 {
        w.buf = append(w.buf, n)
        w.sp = w.sp + 1
        walk(mut w, n - 1)
    }
}

func main() {
    mut s := mut []int{}
    mut i := 0
    while i < 2 {
        i += 1
        mut w := W{buf: s}
        walk(mut w, 2)
        println(w.sp)
    }
}
