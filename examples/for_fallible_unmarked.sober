package main

type Bad error {
    at int
}

@errors(Bad)
func digits(s string, k func(int)) error? {
    bs := bytes(s)
    mut i := 0
    while i < len(bs) {
        if bs[i] < 48 {
            return Bad{at: i}
        }
        k(int(bs[i]) - 48)
        i += 1
    }
    return nil
}

// 失敗しうる生成元（結果が error?）に印 `?` が無い — error を黙って捨てる形（language.md 7 節 — diag.ForFallible kind 1）
func sum(s string) (int, error?) {
    mut n := 0
    for d <- digits(s) {
        n += d
    }
    return n, nil
}

func main() int {
    n := sum("12") catch return 1
    println(n)
    return 0
}
