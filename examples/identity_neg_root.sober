package main

// 負例（language.md 15 節 ② — 同一性の型のゼロ値）: io.Root のゼロ値リテラルは拒否（ゼロ値 = fd 0 を根に開く偽物になる — io.OpenRoot だけが作る）。
// 2026-10-21 まで io.Root は族の列に無く check を通っていた（report-964 (A)）

import "std/io"

func main() {
    r := io.Root{}
    f := io.OpenUnder(r, "etc/passwd") catch return
    defer io.Close(f)
    println("opened")
}
