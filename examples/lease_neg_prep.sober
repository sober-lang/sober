package main

// 整えはScratchのフィールドごとに定数の容量で1回だけ（diag.Par kind 27 — 容量が実行時の値）

import "std/task"
import "std/pool"

type Work struct {
    n int
    head pool.Scratch
}

func main() {
    n := 8
    lw := task.NewLocal((w mut Work) => pool.NewScratch(mut w.head, n))
    println(task.Lease(lw, (w mut Work) => w.n))
}
