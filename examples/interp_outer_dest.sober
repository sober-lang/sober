package main

// 外の束縛への補間の代入: 宣言より深い region（展開されたラムダの本体 = while の反復）から外の string へ補間を代入する場合、
// 補間は代入先の深度に直接確保する（格納点の写しを省くための前提）。--passes なしの lower は補間を `+` の連鎖に組み直すが、
// 穴 1 つの補間は穴の値そのものを返す形になるため、素直に反復の region に置くと後の確保で上書きされてしまう

func each(s []byte, k func([]byte)) {
    mut at := 0
    while at < len(s) {
        k(s)
        at += 1
    }
}

func main() int {
    s := []byte{65, 66}
    mut log := ""
    mut last := ""
    each(s, (f) => {
        t, _ := string(f)
        log = "${log}app ${t}\n"
        u := "${t}${t}"
        last = "${u}"
    })
    mut j := 0
    while j < 3 {
        println("${j}zzzzzzzzzzzzzzzz${j}")
        j += 1
    }
    println("${log}last ${last}")
    return 0
}
