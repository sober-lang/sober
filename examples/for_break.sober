package main

// 文形 for の break / continue（language.md 7 節）: for 全体を label で包む形 — break は生成元の展開ごと抜け、continue は本体の末尾へ。
// どちらも本体（と break なら生成元の展開）の defer を走らせてから飛ぶ

import "std/iter"

func firstBig(xs []int) int {
    mut r := -1
    for x <- xs {
        if x > 3 {
            r = x
            break
        }
    }
    return r
}

func main() {
    xs := []int{3, 1, 4, 1, 5, 9}
    mut s := 0
    for x <- xs {
        if x == 1 {
            continue
        }
        if x == 5 {
            break
        }
        s += x
    }
    println(s)
    println(firstBig(xs))
    mut n := 0
    mut w := 0
    while w < 3 {
        for i <- iter.Range(0, 10) {
            if i == 2 {
                break
            }
            n += 1
        }
        w += 1
    }
    println(n)
    mut p := 0
    for x <- xs {
        for y <- xs {
            if y > x {
                break
            }
            if y == x {
                continue
            }
            p += 1
        }
    }
    println(p)
    mut d := 0
    for i <- iter.Range(0, 4) {
        defer println(i)
        if i == 1 {
            continue
        }
        if i == 3 {
            break
        }
        d += 10
    }
    println(d)
}
