package main

import "std/http/server"

// 受理: 共有の静的ファイル + 認証の middleware の API（別の Mount）・共有のルートで認証でないヘッダ（Accept-Language）を読む・
// 認証つきの API の応答は Private / NoStore / 既定の private・認証つきのルートの Revalidate（共有可の宣言の外）
func api(r http.server.Request) http.server.Response {
    return http.server.Response{status: 200, contentType: "text/plain", body: bytes("hi ${if http.server.Cookie(r, "sid") != nil { "member" } else { "guest" }}\n"), cache: http.server.Private{maxAge: 30}}
}

func lang(r http.server.Request) http.server.Response {
    l := http.server.Header(r, "accept-language")
    return http.server.Text(if l != nil { l } else { "en" })
}

func main() {
    auth := http.server.Middleware{before: (r) => if http.server.Cookie(r, "sid") == nil { http.server.Status(401) } else { nil }}
    apis := http.server.Mount("/api", []http.server.Route{http.server.Route{method: "GET", path: "/me", handler: api}, http.server.Route{method: "GET", path: "/feed", handler: api, cache: http.server.Revalidate{}}}, []http.server.Middleware{auth})
    pub := http.server.Merge(http.server.Static("/assets", "/srv/www", cache: http.server.Shared{maxAge: 3600, sMaxAge: 86400}), []http.server.Route{http.server.Route{method: "GET", path: "/lang", handler: lang, cache: http.server.Fresh{maxAge: 60}}})
    rs := http.server.Merge(apis, pub)
    println(len(rs))
}
