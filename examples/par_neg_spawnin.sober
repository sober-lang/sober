package main

// 段 6 P5-4: par.SpawnIn の子の捕獲は par.Spawn と同じ柵（handle を捕獲できない — kind 6）。check と build が同じ名指しで拒否（desugar/parcheck.sober）

import "std/par"

func main() {
    p := par.NewPool(1 * par.MB, nil)
    r, e := par.Scope((s par.S) => {
        h0 := par.Spawn(s, () => 1)
        h, err := par.SpawnIn(s, p, () => par.Join(h0) + 1)
        if h != nil { par.Join(h) } else { 0 }
    })
    println(r)
}
