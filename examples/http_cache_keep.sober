package main

// ルートの方針（cache:）を書いた行でも、Dispatchはレスポンスの他のフィールドをそのまま送る: Set-Cookie（cookies）と待ち（Delayed）。
// 転送路は偽物。recvはリクエストの列を1切片で渡し、sendは送った切片を印字する（行末のCRは外す）。
// /slow（Delayed）は待ちの後に送るので、前のレスポンスと別の切片に分かれる

import "std/http/server"

func login(r http.server.Request) http.server.Response {
    return http.server.Response{status: 200, contentType: "text/plain", body: bytes("hi\n"), cookies: []http.server.SetCookie{http.server.SetCookie{name: "sid", value: "s1"}}}
}

func slow(r http.server.Request) http.server.Response {
    return http.server.Delayed(20, http.server.Text("slow\n"))
}

func show(b []byte) error? {
    mut out := mut []byte{}
    for x <- b {
        if x != '\r' {
            out = append(out, x)
        }
    }
    println("--- send")
    println(string(freeze(out)) catch "?")
    return nil
}

func give(a string, k func([]byte)) error? {
    k(bytes(a))
    return nil
}

func main() {
    rs := []http.server.Route{
        http.server.Route{method: "GET", path: "/plain", handler: login},
        http.server.Route{method: "GET", path: "/private", handler: login, cache: http.server.Private{maxAge: 30}},
        http.server.Route{method: "GET", path: "/nostore", handler: login, cache: http.server.NoStore{}},
        http.server.Route{method: "GET", path: "/slow", handler: slow, cache: http.server.Fresh{maxAge: 60}}}
    reqs := "GET /plain HTTP/1.1\r\nHost: x\r\n\r\nGET /private HTTP/1.1\r\nHost: x\r\n\r\nGET /nostore HTTP/1.1\r\nHost: x\r\n\r\nGET /slow HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"
    e := http.server.ServeWith((k) => give(reqs, k), (b) => show(b), (r) => http.server.Dispatch(rs, r))
    println(e == nil)
}
