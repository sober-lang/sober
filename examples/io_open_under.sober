package main

// 根の下の開き（language.md 28 節「根の下の開き」— static 便）: `r := io.OpenRoot(dir)?` + `defer io.CloseRoot(r)`・`f := io.OpenUnder(r, rel)?` + `defer io.Close(f)`。
// r の外へ出ないのはカーネルの保証（openat2 の RESOLVE_BENEATH）— `..`・絶対パス・外を指す symlink は io.Denied、中を指す symlink と中に留まる `..` は通る。
// std は rel を文字列として検査しない。io.Stat は開いた File の属性（大きさ・更新時刻・種類 — 通常のファイルでなくても誤りにしない）。後始末は /proc/self/fd の項目の数の差で見る。
// リポジトリのルートを cwd にして実行する（作業域は out/io_open_under — symlink は ln で張る）

import "std/io"
import "std/os"

func fds() int {
    es := io.ReadDir("/proc/self/fd") catch return -1
    return len(es)
}

func why(e error) string {
    return switch e {
    case io.NotFound{}: "not found"
    case io.Denied{}: "denied"
    case io.Other{errno}: "errno ${errno}"
    default: "other"
    }
}

// probe は r の下の rel を開いて大きさと中身を読む（Root を実引数で受ける helper）
@errors(io.NotFound, io.Denied, io.Other, io.Timeout, io.Expired)
func probe(r io.Root, rel string) (string, error?) {
    f := io.OpenUnder(r, rel)?
    defer io.Close(f)
    st := io.Stat(f)?
    k := st.kind
    if k == nil {
        return "no kind", nil
    }
    reg := switch k {
    case io.Regular{}: true
    default: false
    }
    if !reg {
        return "not a regular file", nil
    }
    n := st.size
    b := io.ReadAll(f)?
    s := string(b) catch "(not utf-8)"
    return "${n} bytes: ${s}", nil
}

func show(r io.Root, rel string) {
    s, e := probe(r, rel)
    println(if e != nil { "${rel}: ${why(e)}" } else { "${rel}: ${s}" })
}

// mkdir は d を作る（既にあってよい — EEXIST は読み捨てる）
@errors(io.NotFound, io.Denied, io.Other)
func mkdir(d string) error? {
    e := os.Mkdir(d)
    if e == nil || exists(e) {
        return nil
    }
    return e
}

// exists は e が EEXIST か
func exists(e error) bool {
    return switch e {
    case io.Other{errno}: errno == 17
    default: false
    }
}

@errors(io.NotFound, io.Denied, io.Other, io.Timeout, io.Expired)
func setup(w string) error? {
    mkdir(w)?
    mkdir(w + "/root")?
    mkdir(w + "/root/sub")?
    io.WriteFile(w + "/root/a.txt", bytes("inside"))?
    io.WriteFile(w + "/root/sub/b.txt", bytes("nested"))?
    io.WriteFile(w + "/outside.txt", bytes("secret"))?
    _ = os.Run("/bin/ln", []string{"-sfn", "../outside.txt", w + "/root/esc"})?
    _ = os.Run("/bin/ln", []string{"-sfn", "a.txt", w + "/root/in"})?
    return nil
}

@errors(io.NotFound, io.Denied, io.Other, io.Timeout, io.Expired)
func run(w string) error? {
    r := io.OpenRoot(w + "/root")?
    defer io.CloseRoot(r)
    show(r, "a.txt")
    show(r, "sub/b.txt")
    show(r, "sub/../a.txt")
    show(r, "in")
    show(r, "../outside.txt")
    show(r, "sub/../../outside.txt")
    show(r, "/etc/passwd")
    show(r, "esc")
    show(r, "sub")
    show(r, "nope")
    return nil
}

// rootOnFile は通常のファイルを根として開く（開ければ nil — ENOTDIR で NotFound になる）
@errors(io.NotFound, io.Denied, io.Other, io.Timeout, io.Expired)
func rootOnFile(w string) error? {
    r := io.OpenRoot(w + "/root/a.txt")?
    defer io.CloseRoot(r)
    return nil
}

func main() {
    w := "out/io_open_under"
    e := setup(w)
    if e != nil {
        println("setup: ${why(e)}")
        return
    }
    before := fds()
    e2 := run(w)
    if e2 != nil {
        println("run: ${why(e2)}")
    }
    e4 := rootOnFile(w)
    println(if e4 != nil { "root on a file: ${why(e4)}" } else { "root on a file: opened" })
    println("fds leaked: ${fds() - before}")
}
