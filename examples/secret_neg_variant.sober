package main

// 負例（load が拒否 — 文法）: 欄の後置の @secret は struct の欄だけ。union の variant・error・panic の欄は文法の外（syntax.md）

type U union {
    A { k int @secret }
    B {}
}

func pick(b bool) U {
    return if b { A{k: 1} } else { B{} }
}

func main() {
    switch pick(true) {
    case A{k}:
        println(k)
    case B{}:
        println(0)
    }
}
