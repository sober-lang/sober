package main

// 負例（loadが拒否 — 文法）: フィールドの後置の @secretはstructのフィールドだけ。unionのvariant・error・panicのフィールドは文法の外（syntax.md）

type U union {
    A { k int @secret }
    B {}
}

func pick(b bool) U {
    return if b { A{k: 1} } else { B{} }
}

func main() {
    switch pick(true) {
    case A{k}:
        println(k)
    case B{}:
        println(0)
    }
}
