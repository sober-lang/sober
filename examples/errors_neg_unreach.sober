package main

// 負例（checkが拒否 — analyzer）: subjectが持ちえないラベル（TooLong — parseは返さない）の分岐は到達しない（language.md 13 節）

type Empty error

type TooLong error {
    n int
}

func parse(s string) (int, error?) {
    if s == "" {
        return 0, Empty{}
    }
    return 1, nil
}

func main() {
    _, err := parse("")
    if err != nil {
        switch err {
        case Empty{}: println("empty")
        case TooLong{n}: println("too long", n)
        }
    }
}
