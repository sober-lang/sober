package main

import "std/http/server"

// 共有のルートのハンドラが表の関数値を呼び、その中で Cookie を読む（C を持つ関数値の呼び出し）
type Check func(r http.server.Request) bool

func main() {
    checks := []Check{(r) => http.server.Cookie(r, "sid") != nil}
    rs := []http.server.Route{http.server.Route{method: "GET", path: "/p", handler: (r) => http.server.Text(if checks[0](r) { "a" } else { "b" }), cache: http.server.Fresh{maxAge: 60}}}
    println(len(rs))
}
