package main

// ベクトル化（第三便のスパイク）の回帰例: 出口のバイトが無い走査は、塊の読み飛ばしの後のスカラーのループが境界の検査で panic する（位置と点は同じ）

import "std/iter"

func scanSemi(b []byte, i0 int) int {
    mut i := i0
    while b[i] != ';' {
        i += 1
    }
    return i
}

func main() int {
    mut b := mut []byte{}
    for k <- iter.Range(0, 37) {
        b = append(b, byte('a' + k % 26))
    }
    println(scanSemi(b, 0))
    return 0
}
