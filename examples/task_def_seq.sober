package main

// task_def の逐次の双子（seq ≡ par の照合 — scripts/seqpar.sh）

func work(n int, name string) int {
    return n * 10 + len(bytes(name))
}

func acc(xs mut []int, k int) {
    xs = append(xs, k * k)
}

func sum(n int) int {
    if n == 0 {
        return 0
    }
    return n + sum(n - 1)
}

func main() {
    println(work(4, "abc"))
    mut xs := mut []int{}
    acc(mut xs, 3)
    acc(mut xs, 5)
    println(xs[0] + xs[1])
    println(sum(10))
}
