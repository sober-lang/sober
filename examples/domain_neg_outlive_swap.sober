package main

// A domain cannot be stored in a field of a mut parameter (diag.Par kind 39) — even one taken from another parameter: the two may come from different scopes

import "std/task"

type C struct {
    n int
}

type App struct {
    d task.Domain[C]
}

func swap(a mut App, b App) {
    a.d = b.d
}

func main() {
    r, e := task.Run((s0 task.Scope) => {
        mut app := App{d: task.NewDomain(s0, C{n: 1})}
        _, e1 := task.Run((s1 task.Scope) => {
            swap(mut app, App{d: task.NewDomain(s1, C{n: 2})})
            0
        })
        _ = e1
        task.Read(app.d, (st C) => st.n)
    })
    println("${r} ${e == nil}")
}
