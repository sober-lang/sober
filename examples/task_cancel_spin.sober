package main

// 検査点の間引きの網（scripts/cutstat.sh）: 子 a が少し働いてから死ぬと、後ろの純な子 b / c は間引いた検査点で切られる。b / c は切られなければ
// 終わらない（b = 2^50 反復の帰納変数のループ〔帰納変数あり〕・c = 帰納変数の無い LCG のループ — どちらも数え口の形）— 変異 9（数え口が 0 に戻らない）
// では終わらず、網の timeout が鳴る
import "std/task"

func spinIv(n int) int {
    mut s := 0
    mut i := 0
    while i < n {
        s = (s + i * 7) % 1000003
        i += 1
    }
    return s
}

func spinLcg(x0 int) int {
    mut x := x0
    while x != 0 {
        x = x * 6364136223846793005 + 1442695040888963407
    }
    return 1
}

func main() {
    r, se := task.Run((s task.Scope) => {
        a := task.Spawn(s, () => {
            _ = spinIv(10000000)
            xs := []int{1}
            xs[3]
        })
        b := task.Spawn(s, () => spinIv(1 << 50))
        c := task.Spawn(s, () => spinLcg(12345))
        3
    })
    if se != nil {
        println("scope died")
    }
    println("${r}")
}
