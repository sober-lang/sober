package main

// catchの実引数の直書き・式位置のブロックのmutの束縛。式位置の `f() catch nil` は
// `{ $v, $e := f(); mut $r := $v; if $e != nil { $r = nil }; $r }` に変換され、mutのセルは束縛点（ブロックのregion）の座標に緩むので、
// ブロックの末尾の型の推定も同じ座標で読んで出口のコピーを付ける（check ≡ build）

type Bad error

@errors(Bad)
func get(k int) (string?, error?) {
    if k > 5 {
        return nil, Bad{}
    }
    return if k > 2 { "big" } else { nil }, nil
}

func num(s string?) int {
    return if s == nil { 0 } else { 1 }
}

func sum(k int) int {
    return num(get(k) catch nil) + num(get(k + 1) catch nil)
}

func main() {
    println(sum(1))
    println(sum(2))
    println(sum(3))
    println(sum(5))
    u := "outer"
    n := { mut r := u; r }
    println(n)
}
