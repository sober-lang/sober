package main

// std/http/server の静的ファイル（language.md 28 節「静的ファイル」）: http.server.Static(prefix, root, precompressed:) は `GET <prefix>/*path` の 1 行の表を返し、
// リクエストごとにrootをio.OpenRootして `*path` をio.OpenUnderで開く（rootの外へ出ないのはカーネルの保証 — `..`・外を指すsymlinkは404）。
// precompressed は Accept-Encoding で `.br` / `.gz` を選んで素通しし、Content-Encoding と Vary を付ける。Content-Type は元の名前の拡張子。
// 条件付きGET: 弱いETag（送る変種の更新時刻と大きさ + 変種のマーク）・Last-Modified・Cache-Control（cache: — 省略はno-cache）。If-None-Matchの一致・
// If-Modified-Since のちょうどの一致は 304（ETag・Cache-Control・Vary だけ — Content-Length も本文も無い）・If-Match / If-Unmodified-Since が偽なら 412。
// 更新時刻は touch -d で固定する（ETag と Last-Modified が決まる）。
// loopbackで1本のtaskがDial → パイプラインのリクエストを送る → AcceptしてServeConn → レスポンスを受ける（http_streamの形）。
// リポジトリのルートを cwd にして実行する（作業域は実行ごとの out/http_static.<n> — symlink は ln で張る）

import "std/http/server"
import "std/io"
import "std/net"
import "std/os"
import "std/task"

// d を作る（既にあってよい — EEXIST は読み捨てる）
@errors(io.NotFound, io.Denied, io.Other)
func mkdir(d string) error? {
    e := os.Mkdir(d)
    if e == nil || exists(e) {
        return nil
    }
    return e
}

// e が EEXIST か
func exists(e error) bool {
    return switch e {
    case io.Other{errno}: errno == 17
    default: false
    }
}

@errors(io.NotFound, io.Denied, io.Other, io.Timeout, io.Expired)
func setup(w string) error? {
    mkdir(w)?
    mkdir(w + "/www")?
    mkdir(w + "/www/sub")?
    io.WriteFile(w + "/www/index.html", bytes("<p>hi</p>"))?
    io.WriteFile(w + "/www/app.js", bytes("plain js"))?
    io.WriteFile(w + "/www/app.js.gz", bytes("[gz bytes]"))?
    io.WriteFile(w + "/www/app.js.br", bytes("[br]"))?
    io.WriteFile(w + "/www/.hidden", bytes("dot"))?
    io.WriteFile(w + "/www/sub/data.bin", bytes("01"))?
    io.WriteFile(w + "/outside.txt", bytes("secret"))?
    _ = os.Run("/bin/ln", []string{"-sfn", "../outside.txt", w + "/www/esc"})?
    touch(w + "/www/index.html", "@700000000.5")?
    touch(w + "/www/app.js", "@700000001")?
    touch(w + "/www/app.js.gz", "@700000002")?
    touch(w + "/www/app.js.br", "@700000003")?
    touch(w + "/www/.hidden", "@700000000")?
    touch(w + "/www/sub/data.bin", "@700000000")?
    return nil
}

// path の更新時刻を at（touch -d の形）にする
@errors(io.NotFound, io.Denied, io.Other)
func touch(path string, at string) error? {
    _ = os.Run("/usr/bin/touch", []string{"-d", at, path})?
    return nil
}

func req(method string, path string, ae string) string {
    return "${method} ${path} HTTP/1.1\r\nHost: x\r\n${ae}\r\n"
}

// 条件付きGETのリクエスト（index.htmlのETag = W/"9b6e64aac936500-9"・更新時刻の秒 = Sat, 07 Mar 1992 20:26:40 GMT・
// app.js = W/"9b6e64aca60ca00-8"・app.js.br = W/"9b6e64b41965e00-4-br"）
func conds() string {
    ix := "W/\"9b6e64aac936500-9\""
    lm := "Sat, 07 Mar 1992 20:26:40 GMT"
    return req("GET", "/s/index.html", "If-None-Match: ${ix}\r\n") +
        req("GET", "/s/index.html", "If-None-Match: \"x\", W/\"y\" ,${ix}\r\n") +
        req("GET", "/s/index.html", "If-None-Match: \"9b6e64aac936500-9\"\r\n") +
        req("GET", "/s/index.html", "If-None-Match: *\r\n") +
        req("HEAD", "/s/index.html", "If-None-Match: ${ix}\r\n") +
        req("GET", "/s/index.html", "If-None-Match: W/\"nope\"\r\nIf-Modified-Since: ${lm}\r\n") +
        req("GET", "/s/index.html", "If-Modified-Since: ${lm}\r\n") +
        req("GET", "/s/index.html", "If-Modified-Since: Saturday, 07-Mar-92 20:26:40 GMT\r\n") +
        req("GET", "/s/index.html", "If-Modified-Since: Sat Mar  7 20:26:40 1992\r\n") +
        req("GET", "/s/index.html", "If-Modified-Since: Sat, 07 Mar 1992 20:26:41 GMT\r\n") +
        req("GET", "/s/index.html", "If-Modified-Since: Sat, 07 Mar 1992 20:26:39 GMT\r\n") +
        req("GET", "/s/index.html", "If-Modified-Since: yesterday\r\n") +
        req("GET", "/s/index.html", "If-Modified-Since: ${lm}\r\nIf-Modified-Since: ${lm}\r\n") +
        req("GET", "/s/index.html", "If-Match: ${ix}\r\n") +
        req("GET", "/s/index.html", "If-Match: *\r\n") +
        req("GET", "/s/index.html", "If-Unmodified-Since: Sat, 07 Mar 1992 20:26:39 GMT\r\n") +
        req("GET", "/s/index.html", "If-Unmodified-Since: ${lm}\r\n") +
        req("GET", "/s/app.js", "Accept-Encoding: br\r\nIf-None-Match: W/\"9b6e64aca60ca00-8\"\r\n") +
        req("GET", "/s/app.js", "Accept-Encoding: br\r\nIf-None-Match: W/\"9b6e64b41965e00-4-br\"\r\n") +
        req("GET", "/f/app.js", "If-None-Match: W/\"9b6e64aca60ca00-8\"\r\n") +
        req("GET", "/f/app.js", "") +
        req("GET", "/n/sub/data.bin", "") +
        req("GET", "/none", "")
}

@errors(io.NotFound, io.Denied, io.Other, io.Timeout, io.Expired, io.Closed, net.Bad)
func run(w string) error? {
    setup(w)?
    for l <- net.Listen("127.0.0.1:0")? {
        for c <- net.Dial("127.0.0.1:${net.Port(l)}")? {
            all := req("GET", "/s/app.js", "Accept-Encoding: gzip, br\r\n") +
                req("GET", "/s/app.js", "Accept-Encoding: gzip\r\n") +
                req("GET", "/s/app.js", "Accept-Encoding: br;q=0, gzip;q=0\r\n") +
                req("HEAD", "/s/index.html", "") +
                req("GET", "/s/sub/data.bin", "") +
                req("GET", "/s/.hidden", "") +
                req("GET", "/s/../outside.txt", "") +
                req("GET", "/s/sub/../../outside.txt", "") +
                req("GET", "/s/esc", "") +
                req("GET", "/s/sub", "") +
                req("GET", "/s/", "") +
                req("POST", "/s/index.html", "Content-Length: 0\r\n") +
                conds() +
                req("GET", "/s/nope.css", "Connection: close\r\n")
            net.Send(c, bytes(all))?
            _, e := task.Run((s task.Scope) => serveOne(l, w) catch -1, deadline: 5000 * task.MS)
            if e != nil {
                println("serve failed")
            }
            mut got := mut []byte{}
            for chunk <- net.Recv(c)? {
                for x <- chunk { got = append(got, x) }
            }
            io.WriteStdout(freeze(got))?
        }
    }
    return nil
}

// 1 本だけ受けて ServeConn に渡す（Connection: close で返る）
func serveOne(l net.Listener, w string) (int, error?) {
    rs := http.server.Merge(http.server.Merge(http.server.Static("/s", w + "/www", precompressed: true), http.server.Static("/f", w + "/www", cache: http.server.Fresh{maxAge: 60, immutable: true})),
        http.server.Merge(http.server.Static("/n", w + "/www", cache: http.server.NoStore{}), []http.server.Route{http.server.Route{method: "GET", path: "/none", handler: (r) => http.server.Status(204), middleware: []http.server.Middleware{}}}))
    for c <- net.Accept(l)? {
        http.server.ServeConn(c, (r) => http.server.Dispatch(rs, r))?
        break
    }
    return 0, nil
}

func main() {
    d := runDir("http_static")
    defer removeAll(d)
    e := run(d)
    if e != nil {
        println("error")
    }
}

// 実行ごとの置き場 out/<name>.<単調時計の値>（同じ作業ディレクトリで同時に走る実行どうしが上書きし合わない）。
// mkdirは既にあれば失敗するので、作れた名前がこの実行のもの。作れない状態で回り続けないよう、試す回数に上限を置く（作れなければ ""）
func runDir(name string) string {
    _ = os.Mkdir("out")
    mut n := 0
    while n < 100 {
        c := "out/${name}.${os.Monotonic()}"
        if os.Mkdir(c) == nil {
            return c
        }
        n = n + 1
    }
    return ""
}

// 置き場を中身ごと消す
func removeAll(d string) {
    if d != "" {
        _ = os.Run("/bin/rm", []string{"-rf", d}) catch 0
    }
}
