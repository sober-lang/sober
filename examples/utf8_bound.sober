package main

// UTF-8 の境界の畳み（compiler/lower/ubf.sober）の負例: 区切りの事実があっても境界を保証しない形では、Str が境界の
// 検査を残して InvalidUtf8 の位置を返すこと。Str の部分インラインはループの中の点だけなので、全部ループの中で呼ぶ（opt / no-opt の出力が同じ — optdiff）。
// 正例（畳める形 — `;` の位置・ASCII の次）も並べて、畳んだ後の値が検査を残した値と同じことを見る

import "std/iter"
import "std/strings"
import "std/utf8"

// Str の結果を 1 語に畳む（成功 = 長さ・失敗 = 1000 + 境界でない位置）
func code(v utf8.View, s int, i int) int {
    x, err := utf8.Str(v, s, i)
    return if err != nil {
        switch err {
        case strings.InvalidUtf8{pos}: 1000 + pos
        }
    } else {
        len(bytes(x))
    }
}

// 正例: `;` の位置で切る（i 側）・行の頭は '\n' の次（s 側 — ループの頭の仮引数）
func fields(b []byte) int {
    v := utf8.Check(b) catch return -1
    mut acc := 0
    mut i := 0
    while i < len(b) {
        s := i
        while b[i] != ';' {
            i += 1
        }
        x, err := utf8.Str(v, s, i)
        acc = acc * 7 + if err != nil { 1000 } else { len(bytes(x)) }
        while b[i] != '\n' {
            i += 1
        }
        i += 1
    }
    return acc
}

// 負例 1: 区切りが非 ASCII の byte（0xC3 — 2 バイト文字の頭）の次は継続バイト（K > 127 の事実は使わない）
func afterLead(b []byte) int {
    v := utf8.Check(b) catch return -1
    mut acc := 0
    for i <- iter.Range(0, len(b)) {
        if b[i] == 195 {
            x, err := utf8.Str(v, 0, i + 1)
            acc = acc * 7 + if err != nil { 1000 + i } else { len(bytes(x)) }
        }
    }
    return acc
}

// 負例 2: ne の真の辺（b[i] は ';' でない — 何でもありうる）
func notSemi(b []byte) int {
    v := utf8.Check(b) catch return -1
    mut acc := 0
    for i <- iter.Range(1, len(b)) {
        if b[i] != ';' {
            x, err := utf8.Str(v, 0, i)
            acc = acc * 7 + if err != nil { 1 } else { len(bytes(x)) }
        }
    }
    return acc
}

// 負例 3: 事実は別の buffer（b2）のもの — b の同じ位置は継続バイト
func otherView(b []byte, b2 []byte) int {
    v := utf8.Check(b) catch return -1
    v2 := utf8.Check(b2) catch return -1
    mut acc := 0
    for i <- iter.Range(0, len(b2)) {
        if b2[i] == ';' {
            x, err := utf8.Str(v, 0, i)
            y, err2 := utf8.Str(v2, 0, i)
            acc = acc * 7 + (if err != nil { 1000 + i } else { len(bytes(x)) }) + (if err2 != nil { 500 } else { len(bytes(y)) })
        }
    }
    return acc
}

// 負例 4: ループの頭の仮引数の入りの 1 本（s0）だけが「0 か ASCII の次」でない
func badEntry(b []byte, s0 int) int {
    v := utf8.Check(b) catch return -1
    mut acc := 0
    mut s := s0
    mut i := s0
    while i < len(b) {
        if b[i] == ';' {
            x, err := utf8.Str(v, s, i)
            acc = acc * 7 + if err != nil { 1000 + s } else { len(bytes(x)) }
            s = i + 1
        }
        i += 1
    }
    return acc
}

// 負例 5: 事実（m[at] == ';'）を読んだ後、freeze の前の mut で書き換えてから Check（事実の読みが Check の点に支配されない — 同じ番地・同じ添字の値）
func writeBefore(n int, at int) int {
    mut acc := 0
    for k <- iter.Range(0, n) {
        mut m := mut []byte{'x', 195, ';', 'y'}
        if m[at] == ';' {
            m[at] = 169
            fm := freeze(m)
            v := utf8.Check(fm) catch return -1
            x, err := utf8.Str(v, 0, at)
            acc = acc * 7 + k + if err != nil { 1000 } else { len(bytes(x)) }
        }
    }
    return acc
}

// 負例 6: 値の腕の catch（`catch v0` — 脱出しない）では v は b の View とは限らない（b が不正なら v0）
func fallback(b []byte, v0 utf8.View) string {
    v := utf8.Check(b) catch v0
    mut out := ""
    for i <- iter.Range(0, len(b)) {
        if b[i] == ';' {
            x := utf8.Str(v, 0, i) catch "?"
            out = out + x + "|"
        }
    }
    return out
}

func main() {
    println(fields(bytes("ab;1\ncé;22\néé;3\n")))
    println(afterLead(bytes("aébé")))
    println(notSemi(bytes("aé;b")))
    println(otherView(bytes("aéc"), bytes("ab;")))
    println(badEntry(bytes("aéb;c;"), 2))
    println(writeBefore(2, 2))
    println(fallback([]byte{'x', 255, ';', 'a', 'b', ';'}, utf8.Check(bytes("pqrstuvw")) catch panic(Unreachable{})))
    println(code(utf8.Check(bytes("aé")) catch panic(Unreachable{}), 0, 2))
}
