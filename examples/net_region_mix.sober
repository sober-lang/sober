package main

// net.Serveのregion: の配置先のテスト: 小さいスロットの接続のtask（region: 1 MiB — 既定のスロットを割った小さいスロットを
// 深度ごとに1本）と既定の大きさの子taskが、同じワーカーの上で深いregionを持ったまま交互にディープスリープする。各レベルは自分のregionに列を作り
// （接続のレベルは約320 KB・既定の子のレベルは約1.3 MB）、深いレベルでディープスリープしてから戻り際に自分の列が壊れていないかを数える。SOBER_TASK_REGION_MB=4なら
// 既定のスロット1本が小さいスロット4本になる。配置先を取り違えると（大きさの違うスロットを予備やプールから採る）列が壊れて数が合わない

import "std/io"
import "std/iter"
import "std/net"
import "std/os"
import "std/task"
import "std/strings"
import "std/convert"

func show(e error?) string {
    return switch e {
    case nil: "ok"
    case io.Timeout{}: "timeout"
    case io.Expired{}: "expired"
    case io.Closed{}: "closed"
    case io.Denied{}: "denied"
    case io.Other{errno}: "errno ${errno}"
    case net.Bad{}: "bad"
    case net.NoHost{}: "nohost"
    case net.NonASCIIHost{}: "nonascii"
    case strings.BadUtf8{}: "invalid utf8"
    case convert.BadInt{}: "invalid int"
    case convert.IntOutOfRange{}: "int out of range"
    }
}

// seedから決まるnワードの列（呼び手のregion）
func fill(n int, seed int) []int {
    mut ys := mut []int{}
    for i <- iter.Range(0, n) {
        ys = append(ys, i * 7 + seed)
    }
    return freeze(ys)
}

// fill(len(xs), seed) と同じなら 1
func intact(xs []int, seed int) int {
    mut ok := 1
    for i <- iter.Range(0, len(xs)) {
        if xs[i] != i * 7 + seed {
            ok = 0
        }
    }
    return ok
}

// nレベルのregionを開き、各レベルでwワードの列を作って一番深いレベルでディープスリープし、戻り際に壊れていないレベルの数を返す
func level(n int, seed int, w int) int {
    xs := fill(w, seed + n)
    r := if n == 0 { sleepy() } else { level(n - 1, seed, w) }
    return r + intact(xs, seed + n)
}

func sleepy() int {
    os.Sleep(3)
    return 0
}

// 受けたレベルの数でlevelを走らせて結果を返す
func handle(c net.Conn) error? {
    for chunk <- net.Recv(c)? {
        n := convert.ParseInt(string(chunk)?)?
        net.Send(c, bytes("${level(n, 1000, 40000)}"))?
    }
    return nil
}

func main() {
    println(run() catch "listen failed")
}

func run() (string, error?) {
    mut out := ""
    for l <- net.Listen("127.0.0.1:0")? {
        port := net.Port(l)
        r, _ := task.Run((s task.Scope) => {
            // 接続 4 本（小さいスロット）と既定の子 4 本を同時に
            mut cs := mut []task.Handle[string]{}
            for k <- iter.Range(0, 4) {
                cs = append(cs, task.Spawn(s, () => client(port, 9 + k)))
            }
            mut ks := mut []task.Handle[int]{}
            for k <- iter.Range(0, 4) {
                ks = append(ks, task.Spawn(s, () => kid(9 + k)))
            }
            sv, _ := task.Run((s2 task.Scope) => show(net.Serve(l, handle, region: 1 * task.MB)), deadline: 2500 * task.MS)
            mut acc := "serve: ${sv}"
            for v <- task.Gather(cs) {
                acc = acc + "\n" + v
            }
            for v <- task.Gather(ks) {
                acc = acc + "\nkid: ${v}"
            }
            acc
        }, deadline: 10000 * task.MS)
        out = r
    }
    return out, nil
}

func client(port int, n int) string {
    v, e := ask(port, n)
    return if e == nil { "conn ${n}: ${v}" } else { show(e) }
}

// 接続を2本続けて張り、それぞれでレベルの数nを2回送って返った数を並べる（n + 1なら全レベルの列が壊れていない）。往復の間に接続のtaskは
// 浅いレベルでシャロースリープする（深いレベルのスロットを予備に返してから深く入り直す）・1本目の接続のtaskは2本目の前に終わる（スロットを返す — 既定の子がまだ深く動いている間）
func ask(port int, n int) (string, error?) {
    mut got := ""
    for conn <- iter.Range(0, 2) {
        for a <- net.Dial("127.0.0.1:${port}")? {
            for round <- iter.Range(0, 2) {
                net.Send(a, bytes("${n}"))?
                for chunk <- net.Recv(a)? {
                    got = got + (if conn + round == 0 { "" } else { "," }) + string(chunk)?
                    break
                }
                os.Sleep(2)
            }
        }
        os.Sleep(2)
    }
    return got, nil
}

// 既定の大きさの子: levelを4回（間にディープスリープする）。各段の列は1 MiBを越える（小さいスロット〔1 MiB〕を既定の子が採る取り違えは隣のスロットを壊す）
func kid(n int) int {
    mut r := 0
    for round <- iter.Range(0, 4) {
        r = r + level(n, 2000 + round, 160000)
        os.Sleep(1)
    }
    return r
}
