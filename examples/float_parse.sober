package main

// 浮動小数の解析の差分（scripts/oracles/float_parse.go — 境界・構文の負例と乱択の 10 進を Go の strconv.ParseFloat と照合: ビット列と状態）

import "std/floatfmt"
import "std/io"

func main() int {
    b := io.ReadStdin() catch return 1
    mut i := 0
    while i < len(b) {
        s := i
        while b[i] != '\n' {
            i += 1
        }
        v, err := floatfmt.ParseBits(b[s:i])
        st := switch err {
        case nil: 0
        case floatfmt.InvalidSyntax{}: 1
        default: 2
        }
        println(if st == 1 { 0 } else { v }, st)
        i += 1
    }
    return 0
}
