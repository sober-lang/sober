package main

// 同一性を持つ型を `T?` のフィールドに持つstructはゼロ値を作れる（`T?` のゼロ値はnil — 偽の端点を作らない・language.md 28 節 / 11 節）。
// 値の型の標準ストリームio.Stream（同一性なし）をフィールドに持つio.Writerのゼロ値も今どおり（標準出力へ書く）

import "std/io"
import "std/task"

type Slot struct {
    tx task.Sender[int]?
    n int
}

func main() {
    s := Slot{n: 2}
    println(if s.tx == nil { s.n } else { 0 })
    mut w := io.Writer{}
    io.WriteString(mut w, "ok\n")
    _ = io.Flush(mut w)
}
