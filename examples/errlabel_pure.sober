package main

// errlabel.sober との突き合わせの対（Lean 側: Examples.lean の v48）。errlabel.sober から出力を抜き、結果を 1 語に畳み込む形。
// main の末尾の値 r を codegen は println で、Lean は脱糖したコアを機械で走らせて照合する。
// 以下は errlabel.sober と同じ:
// 呼び手の string・callee で構築した string・slice がラベルに乗り、`?` で伝播し、戻り値の境界コピーで
// 呼び手の region へ写る（opt / union の中の relocate — codegen はタグで分岐、Lean は relocR が値ラッパの中まで締める）

type NotFound error {
    path string
}

type Many error {
    seen []int
}

type Bad error {
    code int
}

// 呼び手の string をそのままラベルへ
func open(p string, ok bool) (int, error?) {
    if ok {
        return len(bytes(p)), nil
    }
    return 0, NotFound{path: p}
}

// 1 段の `?` で伝播（ラベルの string が 2 回の境界を越える）
func openBoth(p string, q string) (int, error?) {
    a := open(p, true)?
    b := open(q, false)?
    return a + b, nil
}

// callee で構築した string をラベルへ
func backup(p string) (int, error?) {
    return 0, NotFound{path: p + ".bak"}
}

// callee で構築した slice をラベルへ（ループで伸ばしてから返す）
func collect(n int) (int, error?) {
    mut xs := []int{}
    mut i := 0
    while i < n {
        xs = append(xs, i * i)
        i += 1
    }
    if n > 3 {
        return 0, Many{seen: xs}
    }
    return n, nil
}

// string ラベルと並ぶ int ラベル
func codeOf(n int) (int, error?) {
    if n > 0 {
        return n, nil
    }
    return 0, Bad{code: n}
}

// ラベルの中身を 1 語へ: string は長さと先頭バイト、slice は長さと末尾
func digest(e error?) int {
    return if e != nil {
        switch e {
        case NotFound{path}: 1000 + len(bytes(path)) * 10 + int(bytes(path)[0])
        case Many{seen}: 2000 + len(seen) * 100 + seen[len(seen) - 1]
        case Bad{code}: 3000 - code
        }
    } else {
        0
    }
}

func main() {
    n1, e1 := openBoth("a.txt", "b.txt")
    _, e2 := backup("c.txt")
    _, e3 := collect(5)
    n4, e4 := collect(2)
    _, e5 := codeOf(0 - 3)
    r := n1 + n4 * 10 + digest(e1) * 100 + digest(e2) * 1000000 + digest(e3) * 100000000 +
        digest(e4) * 1000000000000 + digest(e5) * 10000000000000
    println(r)
    r
}
