package main

// 段 6 P4-4: 回収しなかった失敗の scope の err = 生んだ順で最初の失敗（到着順でない — M:N で遅い子が先に生まれ、速い子が先に終わっても同じ）。
// schedfuzz の変異の自己検査（--rt-mutant=1 = 到着順で選ぶ）の証人も兼ねる

import "std/par"

type Bad error {
    code int
}

func spin(n int) int {
    mut i := 0
    mut a := 0
    while i < n {
        a += i & 7
        i += 1
    }
    return a
}

@errors(Bad)
func slow(n int) (int, error?) {
    if spin(n) >= 0 {
        return 0, Bad{code: 1}
    }
    return 1, nil
}

@errors(Bad)
func fast() (int, error?) {
    return 0, Bad{code: 2}
}

func report(k int, r int, e error?) {
    if e == nil {
        println("round ${k}: nil")
        return
    }
    switch e {
    case Bad{code}: println("round ${k}: Bad ${code} (${r})")
    default: println("round ${k}: ?")
    }
}

func main() {
    mut k := 0
    while k < 3 {
        r, err := par.Scope((s par.S) => {
            a := par.Spawn(s, () => slow(3000000))
            b := par.Spawn(s, () => fast())
            0
        })
        report(k, r, err)
        k += 1
    }
}
