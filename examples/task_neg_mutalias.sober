package main

// imm の束縛の mut の別名（`v := m` — v は m と同じ mut の中身）の捕獲（diag.Par kind 21 — コアの givable が拒否。
// check と build が同じ拒否。desugar/parcheck.sober）

import "std/task"

func main() {
    r, e := task.Run((s task.Scope) => {
        mut m := mut []int{1}
        v := m
        h := task.Spawn(s, () => v[0])
        m[0] = 7
        task.Join(h)
    })
    if e != nil {
        println("err")
    } else {
        println("${r}")
    }
}
