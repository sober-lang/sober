package main

// 段 6 P5-2 入口: struct の欄に包んだ札の捕獲（kind 5） — check と build が同じ名指しで拒否（desugar/parcheck.sober）。縮退の前提「縮退した子が待てるのは自分の子孫だけ」の柵

import "std/par"

type W struct {
    s par.S
}

func main() {
    r, e := par.Scope((s par.S) => {
        w := W{s: s}
        h := par.Spawn(s, () => par.Join(par.Spawn(w.s, () => 2)))
        par.Join(h)
    })
    println(r)
}
