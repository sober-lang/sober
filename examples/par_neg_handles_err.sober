package main

// 段 6 P3b-5: error を返す task の handle を par.Task[int] の slice に積む（diag.Par kind 17 — 要素の型は par.Task[(T, error?)]〔P3b 残穴1〕。
// par.Task[T] の slice に積めると Join が失敗を落とす）

import "std/par"

func load(n int) (int, error?) {
    return n, nil
}

func main() {
    r, e := par.Scope((s par.S) => {
        mut hs := mut []par.Task[int]{}
        hs = append(hs, par.Spawn(s, () => load(3)))
        3
    })
    println(r)
}
