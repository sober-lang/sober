package main

// std/os.ModTime / Sleep（sober watchのmtimeポーリングのインターフェース）: 書いたファイルの更新時刻は0より大きく、スリープしてから書き直すと進む。
// 無いパスは io.NotFound。時刻の値そのものは印字しない（比べるだけ — 実行ごとに変わる）

import "std/io"
import "std/os"

func main() int {
    d := runDir("os_modtime")
    defer removeAll(d)
    p := d + "/os_modtime.txt"
    if io.WriteFile(p, bytes("a")) != nil {
        return 1
    }
    t0 := os.ModTime(p) catch return 2
    println(t0 > 0)
    os.Sleep(20)
    if io.WriteFile(p, bytes("bb")) != nil {
        return 3
    }
    t1 := os.ModTime(p) catch return 4
    println(t1 > t0)
    _, err := os.ModTime("out/no/such/file")
    println(switch err {
    case nil: "found"
    case io.NotFound{}: "not found"
    default: "other"
    })
    return 0
}

// 実行ごとの置き場 out/<name>.<単調時計の値>（同じ作業ディレクトリで同時に走る実行どうしが上書きし合わない）。
// mkdirは既にあれば失敗するので、作れた名前がこの実行のもの。作れない状態で回り続けないよう、試す回数に上限を置く（作れなければ ""）
func runDir(name string) string {
    _ = os.Mkdir("out")
    mut n := 0
    while n < 100 {
        c := "out/${name}.${os.Monotonic()}"
        if os.Mkdir(c) == nil {
            return c
        }
        n = n + 1
    }
    return ""
}

// 置き場を中身ごと消す
func removeAll(d string) {
    if d != "" {
        _ = os.Run("/bin/rm", []string{"-rf", d}) catch 0
    }
}
