package main

import "std/http/server"

// 共有のルートのハンドラが補助関数の 2 段奥で Authorization を読む（効果のビットの閉包）
func token(r http.server.Request) bool {
    return http.server.Authorization(r) != nil
}

func authed(r http.server.Request) bool {
    return token(r)
}

func page(r http.server.Request) http.server.Response {
    if authed(r) {
        return http.server.Text("member\n")
    }
    return http.server.Text("guest\n")
}

func main() {
    rs := []http.server.Route{http.server.Route{method: "GET", path: "/p", handler: page, cache: http.server.Shared{maxAge: 60}}}
    println(len(rs))
}
