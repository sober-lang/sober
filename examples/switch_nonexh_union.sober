package main

// 負例（check / buildとも専用の診断で拒否 — diag.NonExhaustive）: unionの文のswitchがvariantを落とす（defaultも `_` も無い）。
// 文面は落ちている最初の variant を添える（missing: A）。以前は check = Malformed・build = Mismatch

type V union {
    A {}
    B { n int }
}

func main() {
    v := B{n: 1}
    switch v {
    case B{n}: println(n)
    }
}
