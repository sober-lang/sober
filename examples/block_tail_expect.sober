package main

// 期待型（byte・byte?・string?）が、文を前に持つ塊の腕・ラムダの塊の本体・switch の腕の末尾まで届く形。
// 型なしの定数は末尾でも期待の byte に割り当て、return の値の catch nil は結果の T? から nil の型を取る

func g() {}

// byte? の腕の末尾の定数
func opt(s string) byte? {
    return if len(bytes(s)) > 2 { g(); 44 } else { nil }
}

// 絞り込んだ腕と、文を前に持つ else の塊
func orZero(v byte?) byte {
    return if v != nil { v } else { g(); 0 }
}

// byte を返す関数型の実引数のラムダ（塊の本体・式の本体）
func run(f func(int) byte) byte {
    return f(1)
}

// switch の腕（文を前に持つ腕・定数だけの腕）
func pick(n int) byte {
    return switch n {
    case 0: g(); 44
    default: 7
    }
}

// return の値の catch nil（値の型は string — 結果の string? が nil の型を決める）
func text(b []byte) string? {
    return string(b) catch nil
}

func main() {
    a := opt("abc")
    if a != nil { println(a) }
    println(opt("a") == nil)
    println(orZero(nil))
    println(orZero(5))
    println(run((x) => { g(); 9 }))
    println(run((x) => 8))
    println(pick(0))
    println(pick(1))
    t := text(bytes("ok"))
    if t != nil { println(t) }
    println(text([]byte{255}) == nil)
}
