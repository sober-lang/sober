package main

// 期待型（byte・byte?・string?）が、文を前に持つブロックの分岐・ラムダのブロックの本体・switchの分岐の末尾まで届く形。
// 型なしの定数は末尾でも期待の byte に割り当て、return の値の catch nil は結果の T? から nil の型を取る

func g() {}

// byte? の分岐の末尾の定数
func opt(s string) byte? {
    return if len(bytes(s)) > 2 { g(); 44 } else { nil }
}

// 絞り込んだ分岐と、文を前に持つelseのブロック
func orZero(v byte?) byte {
    return if v != nil { v } else { g(); 0 }
}

// byteを返す関数型の実引数のラムダ（ブロックの本体・式の本体）
func run(f func(int) byte) byte {
    return f(1)
}

// switchの分岐（文を前に持つ分岐・定数だけの分岐）
func pick(n int) byte {
    return switch n {
    case 0: g(); 44
    default: 7
    }
}

// return の値の catch nil（値の型は string — 結果の string? が nil の型を決める）
func text(b []byte) string? {
    return string(b) catch nil
}

func main() {
    a := opt("abc")
    if a != nil { println(a) }
    println(opt("a") == nil)
    println(orZero(nil))
    println(orZero(5))
    println(run((x) => { g(); 9 }))
    println(run((x) => 8))
    println(pick(0))
    println(pick(1))
    t := text(bytes("ok"))
    if t != nil { println(t) }
    println(text([]byte{255}) == nil)
}
