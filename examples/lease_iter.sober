package main

// ワーカー局所のleaseの反復（region-domain-pool.md 4d節）の回帰例: ウィンドウをn回借りても、配置先のエリアは使い回され（世代を進めるだけ）、ウィンドウの値は反復の
// regionに作られて積もらない — 子taskのウィンドウも同じ（json-compの接続のtaskの形）。n回（既定2000 — scripts/iterregion.shが10倍にして
// RSSが比例しないことを見る。ウィンドウのたびに配置先を作り直す〔倒れ〕形でも反復のregionに返るので平ら — 鳴るのはウィンドウの書きが外のregionに積もる形）

import "std/convert"
import "std/os"
import "std/task"
import "std/pool"

type Work struct {
    hits int
    tab pool.Scratch
}

// tabの64ワードを書いて読み、ウィンドウの値（小さな列）を返す
func touch(w mut Work, k int) []int {
    mut s := 0
    mut i := 0
    while i < 64 {
        pool.Store(mut w.tab, (k * 64 + i) % 4096, k + i)
        s += pool.Load(mut w.tab, (k * 64 + i) % 4096)
        i += 1
    }
    w.hits += 1
    return []int{s, w.hits}
}

func main() {
    args := os.Args() catch return
    mut n := 2000
    if len(args) == 2 {
        v, _ := convert.ParseInt(args[1])
        n = v
    }
    lw := task.NewLocal((w mut Work) => pool.NewScratch(mut w.tab, 4096))
    mut t := 0
    mut k := 0
    while k < n {
        r := task.Lease(lw, (w mut Work) => touch(mut w, k))
        t += r[1]
        k += 1
    }
    c, _ := task.Run((s task.Scope) => {
        mut j := 0
        mut u := 0
        while j < n / 100 {
            q := j
            h := task.Spawn(s, () => {
                mut a := 0
                mut z := 0
                while z < 100 {
                    a += task.Lease(lw, (w mut Work) => touch(mut w, q + z))[1]
                    z += 1
                }
                a
            })
            u += task.Join(h)
            j += 1
        }
        u
    })
    println(t, c)
}
