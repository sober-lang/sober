package main

// ワーカー局所の lease の反復（region-domain-pool.md 4d 節）の回帰例: 窓を n 回借りても、置き場の区画は使い回され（世代を進めるだけ）、窓の値は反復の
// region に作られて積もらない — 子 task の窓も同じ（json-comp の接続の task の形）。n 回（既定 2000 — scripts/iterregion.sh が 10 倍にして
// RSS が比例しないことを見る。窓のたびに置き場を作り直す〔倒れ〕形でも反復の region に返るので平ら — 鳴るのは窓の書きが外の region に積もる形）

import "std/convert"
import "std/os"
import "std/task"
import "std/pool"

type Work struct {
    hits int
    tab pool.Scratch
}

// tab の 64 語を書いて読み、窓の値（小さな列）を返す
func touch(w mut Work, k int) []int {
    mut s := 0
    mut i := 0
    while i < 64 {
        pool.Store(mut w.tab, (k * 64 + i) % 4096, k + i)
        s += pool.Load(mut w.tab, (k * 64 + i) % 4096)
        i += 1
    }
    w.hits += 1
    return []int{s, w.hits}
}

func main() {
    args := os.Args() catch return
    mut n := 2000
    if len(args) == 2 {
        v, _ := convert.ParseInt(args[1])
        n = v
    }
    lw := task.NewLocal((w mut Work) => pool.NewScratch(mut w.tab, 4096))
    mut t := 0
    mut k := 0
    while k < n {
        r := task.Lease(lw, (w mut Work) => touch(mut w, k))
        t += r[1]
        k += 1
    }
    c, _ := task.Run((s task.Scope) => {
        mut j := 0
        mut u := 0
        while j < n / 100 {
            q := j
            h := task.Spawn(s, () => {
                mut a := 0
                mut z := 0
                while z < 100 {
                    a += task.Lease(lw, (w mut Work) => touch(mut w, q + z))[1]
                    z += 1
                }
                a
            })
            u += task.Join(h)
            j += 1
        }
        u
    })
    println(t, c)
}
