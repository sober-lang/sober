package main

// 段 6 Skynet 回収 (a): ワーカーごとの列 + 未着手の子の盗み。木の形の spawn（fan-out 10・深さ 4 = 1 万の葉）と、1 scope に
// 列の大きさ（DQ_CAP = 256）を越える子（あふれ — 共有の積みへ）の両方を通す。値は Kahn によりスケジュールに依らない（schedfuzz が W 1/2/4/8 × 種で照合）

import "std/iter"
import "std/task"

func tree(num int, size int) int {
    if size == 1 {
        return num
    }
    sub := size / 10
    mut ds := mut []int{}
    for i <- iter.Range(0, 10) {
        ds = append(ds, i)
    }
    vs, e := task.Map(ds, (i) => tree(num + i * sub, sub))
    if e != nil {
        return -1
    }
    mut acc := 0
    for j <- iter.Range(0, len(vs)) {
        acc += vs[j]
    }
    return acc
}

func main() {
    println(tree(0, 10000))
    mut xs := mut []int{}
    for i <- iter.Range(0, 1000) {
        xs = append(xs, i)
    }
    ys, e := task.Map(xs, (v) => tree(v * 10, 10))
    if e != nil {
        println("err")
        return
    }
    mut acc := 0
    for j <- iter.Range(0, len(ys)) {
        acc += ys[j]
    }
    println(acc)
    println(ys[0])
    println(ys[999])
}
