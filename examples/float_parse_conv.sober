package main

// conv.ParseFloat（Clinger の速い道つき — 仮数 ≤ 2^53・|指数| ≤ 22 は float の乗除 1 回）の差分: float_parse と同じ入力と Go の答え（scripts/oracles/float_parse.go）

import "std/conv"
import "std/math"
import "std/io"

func main() int {
    b := io.ReadStdin() catch return 1
    mut i := 0
    while i < len(b) {
        s := i
        while b[i] != '\n' {
            i += 1
        }
        t, terr := string(b[s:i])
        f, err := conv.ParseFloat(t)
        v := math.Bits(f)
        st := switch err {
        case nil: 0
        case conv.InvalidFloat{}: 1
        default: 2
        }
        println(if st == 1 { 0 } else { v }, st)
        i += 1
    }
    return 0
}
