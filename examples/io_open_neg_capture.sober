package main

// 負例: 子 task の閉包は File を捕獲できない（親の defer が子の終わりより先に閉じうる）（diag.FileUse — desugar/filecheck・language.md 28 節「資源とストリーム」— IO 便 段 2）

import "std/io"
import "std/par"

func main() {
    f := io.Open("testdata/io/hello.txt") catch return
    defer io.Close(f)
    r, err := par.Scope((s par.S) => {
        h := par.Spawn(s, () => len(io.ReadAll(f) catch []byte{}))
        par.Join(h)
    })
    println(r)
}
