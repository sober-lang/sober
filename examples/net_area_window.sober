package main

// net.Serve + http.server.ServeConn の接続の task（区画の形 — language.md 11 節「接続の task の積み」）の区画の窓の網: 同じワーカーの上で
// (1) keep-alive の受けで浅く寝て起きる接続・(2) handler の中で深く寝て、起きてから要求の path（受けの region の中身）をそのまま返す接続・
// (3) 要求を 2 つに割って送り、途中の要求を受けの region に持ったまま待つ接続 が混ざる。浅く寝た接続の窓の深度は空のまま持たれ、起きた点で
// ワーカーの区画が替わっていれば付け替えられる。付け替えを取り違えると、深く寝た接続や途中の要求の中身が他の接続の受けで上書きされて答えが崩れる

import "std/iter"
import "std/net"
import "std/os"
import "std/strings"
import "std/task"
import "std/convert"
import "std/http/server"

func num(s string) int {
    return convert.ParseInt(s) catch 0
}

func route(r http.server.Request) http.server.Response {
    if strings.HasPrefix(r.path, "/hold/") {
        ms, _, _ := strings.Cut(strings.TrimPrefix(r.path, "/hold/"), "/")
        os.Sleep(num(ms))
        return http.server.Text(r.path)
    }
    return http.server.Text("ok")
}

func main() {
    println(run() catch "listen failed")
}

func run() (string, error?) {
    mut out := ""
    for l <- net.Listen("127.0.0.1:0")? {
        port := net.Port(l)
        r, _ := task.Run((s task.Scope) => {
            mut cs := mut []task.Handle[string]{}
            for k <- iter.Range(0, 9) {
                cs = append(cs, task.Spawn(s, () => client(port, k)))
            }
            _, _ = task.Run((s2 task.Scope) => net.Serve(l, (c net.Conn) => http.server.ServeConn(c, route)), deadline: 3000 * task.MS)
            mut acc := "served"
            for v <- task.Gather(cs) {
                acc = acc + "\n" + v
            }
            acc
        }, deadline: 10000 * task.MS)
        out = r
    }
    return out, nil
}

// 種類 k % 3: 0 = /ok の連打（浅く寝る）・1 = /hold（深く寝て path を返す）・2 = 割った /hold（途中の要求を持って待つ）
func client(port int, k int) string {
    v, e := talk(port, k)
    return if e == nil { "client ${k}: ${v}" } else { "client ${k}: error" }
}

func talk(port int, k int) (string, error?) {
    mut good := 0
    for a <- net.Dial("127.0.0.1:${port}")? {
        for round <- iter.Range(0, 6) {
            path := switch k % 3 {
            case 0: "/ok"
            default: "/hold/${2 + round % 3}/c${k}r${round}${pad(k)}"
            }
            want := if k % 3 == 0 { "ok" } else { path }
            req := "GET ${path} HTTP/1.1\r\nHost: x\r\n\r\n"
            if k % 3 == 2 {
                b := bytes(req)
                cut := 12 + round * 3
                net.Send(a, b[0:cut])?
                os.Sleep(2)
                net.Send(a, b[cut:len(b)])?
            } else {
                net.Send(a, bytes(req))?
            }
            mut acc := ""
            for chunk <- net.Recv(a)? {
                acc = acc + string(chunk)?
                if strings.HasSuffix(acc, "\r\n\r\n" + want) {
                    break
                }
            }
            if strings.HasSuffix(acc, "\r\n\r\n" + want) {
                good = good + 1
            }
        }
    }
    return "${good}/6", nil
}

// 接続ごとに長さの違う印（受けの region の中身の大きさを散らす）
func pad(k int) string {
    mut p := ""
    for i <- iter.Range(0, 20 * k) {
        p = p + "q"
    }
    return p
}
