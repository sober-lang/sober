package main

// 戻らない関数（ラベル panic の冷たい関数 — binary.outOfRange の形）は「確保しうる」に数えない（#8 — report-725 / 726）の回帰例:
// task のプログラム（std/task — ラベル panic の印字の道が rt.out_drain を呼ぶ）で、反復の本体の確保が死ぬ道の panic の値だけのループは
// 反復の enter が消える（旧形: lloop の軽い enter ≈ 20 命令が毎反復残る — flate の longest / lazy で命令 +368 K / 要求）。
// scripts/iterregion.sh が ① 形（llight 後の main の enter の数）と ② RSS（N と 10N で比例しない — 消した enter の region に
// 毎反復の確保が漏れていないこと）を見る

import "std/binary"
import "std/convert"
import "std/os"
import "std/task"

func main() {
    args := os.Args() catch return
    mut n := 20000
    if len(args) == 2 {
        v, _ := convert.ParseInt(args[1])
        n = v
    }
    // task のプログラムにする（panic の印字の道を out_drain の形に）
    w, _ := task.Run((s task.Scope) => {
        h := task.Spawn(s, () => 1)
        task.Join(h)
    })
    mut buf := []byte{}
    mut k := 0
    while k < 64 {
        buf = append(buf, byte(k))
        k += 1
    }
    mut t := 0
    mut i := 0
    while i < n {
        // 本体の確保は Load64 の死ぬ道（panic の値の組み立て — 戻らない outOfRange）だけ → 反復の enter は消える
        t += binary.Load64(buf, i % 56)
        i += 1
    }
    println("sum ${t % 1000003 + w}")
}
