package main

// 戻らない関数（ラベル panic の冷たい関数 — binary.outOfRange の形）は「確保しうる」に数えない、の回帰例:
// taskのプログラム（std/task — ラベルpanicの印字のパスがrt.out_drainを呼ぶ）で、反復の本体の確保が死ぬパスのpanicの値だけのループは
// 反復のenterが消える（消さないとlloopの軽いenter ≈ 20命令が毎反復残る — flateのlongest / lazyで命令 +368 K / リクエスト）。
// scripts/iterregion.sh が ① 形（llight 後の main の enter の数）と ② RSS（N と 10N で比例しない — 消した enter の region に
// 毎反復の確保が漏れていないこと）を見る

import "std/binary"
import "std/convert"
import "std/os"
import "std/task"

func main() {
    args := os.Args() catch return
    mut n := 20000
    if len(args) == 2 {
        v, _ := convert.ParseInt(args[1])
        n = v
    }
    // taskのプログラムにする（panicの印字のパスをout_drainの形に）
    w, _ := task.Run((s task.Scope) => {
        h := task.Spawn(s, () => 1)
        task.Join(h)
    })
    mut buf := []byte{}
    mut k := 0
    while k < 64 {
        buf = append(buf, byte(k))
        k += 1
    }
    mut t := 0
    mut i := 0
    while i < n {
        // 本体の確保はLoad64の死ぬパス（panicの値の組み立て — 戻らないoutOfRange）だけ → 反復のenterは消える
        t += binary.Load64(buf, i % 56)
        i += 1
    }
    println("sum ${t % 1000003 + w}")
}
