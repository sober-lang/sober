package main

// 段 6 P5-2 入口: struct の欄に包んだ兄弟の handle の捕獲（kind 6 — 弟が縮退すると親の続きを待って詰む形） — check と build が同じ名指しで拒否（desugar/parcheck.sober）。縮退の前提「縮退した子が待てるのは自分の子孫だけ」の柵

import "std/par"

type W struct {
    h par.Task[int]
}

func main() {
    r, e := par.Scope((s par.S) => {
        tx, rx := par.NewChan[int](cap: 1)
        h0 := par.Spawn(s, (q) => {
            v := par.Recv(q)
            if v != nil { v } else { 0 }
        }, give: rx)
        w := W{h: h0}
        h := par.Spawn(s, () => par.Join(w.h) + 1)
        par.Send(tx, 3)
        par.Join(h)
    })
    println(r)
}
