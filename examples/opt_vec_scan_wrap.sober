package main

// ベクトル化の回帰例: 始点が 2^63 − 16 より上の走査は、j + 16 が符号つきでは負に回る — 塊の比較が符号つきだと上限を素通りして
// 遠い番地を読む。スカラーと同じく最初の反復の添字の検査で panic する

import "std/iter"

func scanUntil(b []byte, i0 int, n int) int {
    mut i := i0
    while i < n && b[i] != ';' {
        i += 1
    }
    return i
}

func main() int {
    mut b := mut []byte{}
    for k <- iter.Range(0, 64) {
        b = append(b, byte('a' + k % 26))
    }
    println(scanUntil(b, 9223372036854775800, 9223372036854775807))
    return 0
}
