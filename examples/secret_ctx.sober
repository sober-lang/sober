package main

// 文脈欄（language.md 13 節の補 2）: 欄の秘密は「型 × 名前 × 値の出所」で数える。同じ型（ここでは逐次の状態 Acc）を秘密の文脈と公開の文脈で
// 使っても、公開の文脈の値は公開のまま（仮引数の欄の読みは呼び出し点が実引数の欄で具体化する）。秘密と公開の欄を並べた struct（Conn）も、
// 秘密を書いた欄だけが秘密。`mut x := c` の別名・仮引数を丸ごと返す呼び出しの結果も、行き先の欄で読む

import "std/iter"

// 逐次の状態（sha256.State の形 — 汎用の型）
type Acc struct {
    h int
    n int
}

func newAcc() Acc {
    return Acc{h: 17, n: 0}
}

// data を畳む（mut の仮引数の欄へ書く — 呼び手の実引数の欄へ戻る）
func write(a mut Acc, data []byte) {
    mut h := a.h
    for i <- iter.Range(0, len(data)) {
        h = (h * 31) ^ int(data[i])
    }
    a.h = h & 0xffffffff
    a.n = a.n + len(data)
}

func sum(a Acc) int {
    return a.h ^ a.n
}

// key で mac（秘密の文脈で Acc を使う）
@secret(key)
func mac(key []byte, msg []byte) int {
    mut a := newAcc()
    write(mut a, key)
    write(mut a, msg)
    return sum(a)
}

// 公開の文脈で同じ Acc を使う（分岐してよい）
func digest(msg []byte) int {
    mut a := newAcc()
    write(mut a, msg)
    return sum(a)
}

type Conn struct {
    state int
    key []byte
}

// 秘密を key の欄にだけ書く
@secret(k)
func setKey(c mut Conn, k []byte) {
    c.key = k
    c.state = 1
}

// c を写して state を進めて返す（仮引数を丸ごと返す — 呼び手の結果は実引数の別名）
func step(c Conn) Conn {
    mut x := c
    x.state = x.state + 1
    return x
}

func main() {
    m := mac([]byte{1, 2, 3}, []byte{4, 5})
    d := digest([]byte{4, 5})
    if d > 0 {
        println("digest", d)
    }
    println("mac", m)
    mut c := Conn{state: 0, key: []byte{}}
    setKey(mut c, []byte{9, 9})
    c2 := step(c)
    // 公開の欄 state の分岐は受理（key の秘密は state に混ざらない）
    if c2.state == 2 {
        println("state", c2.state)
    }
}
