package main

// chan で待つ子の印字。stdout = spawn の木の先行順 — 子の流れ全体が spawn の位置に入り、親が spawn の後に書いた行は
// 子が終わるまで溜まる（出力の順はスケジュールに依らない）

import "std/task"

func main() {
    println("start")
    r, e := task.Run((s task.Scope) => {
        tx, rx := task.NewChannel[int](cap: 1)
        h := task.Spawn(s, (inp) => {
            println("kid waits")
            mut sum := 0
            mut k := 0
            while k < 3 {
                v := task.Recv(inp)
                if v != nil {
                    println("kid got ${v}")
                    sum += v
                }
                k += 1
            }
            println("kid done")
            sum
        }, give: rx)
        mut i := 1
        while i <= 3 {
            println("parent sends ${i}")
            task.Send(tx, i * 10)
            i += 1
        }
        println("parent joins")
        task.Join(h)
    })
    println("sum ${r}")
}
