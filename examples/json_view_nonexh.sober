package main

// 負例（checkが拒否 — 網羅）: json.Atのビューをswitchで開くとき、variantを落とすと通らない（16 節「雑に読む手段が構成的に無い」— 1レベルのビューでも同じ）

import "std/json"

func main() {
    d, err := json.Parse(bytes("[1]"))
    if err != nil {
        return
    }
    switch json.At(d, json.Root(d)) {
    case json.ViewArray{items}: println(len(items))
    case json.ViewNumber{lit}: println(lit)
    }
}
