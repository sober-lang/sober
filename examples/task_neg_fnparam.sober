package main

// 関数型の仮引数（展開されるクロージャ）を子が捕獲する（diag.Par kind 11 — checkとbuildが同じ拒否。desugar/parcheck.sober）

import "std/task"

func run(g func(int) int, x int) int {
    r, e := task.Run((s task.Scope) => task.Join(task.Spawn(s, () => g(x))))
    return r
}
func main() {
    println(run((v) => v * 3, 5))
}
