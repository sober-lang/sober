package main

// 負例: ラムダの mut 仮引数の中身は freeze できない（language.md 17 節 U1 — 呼び手がまだ持っていて、呼び出しの後に書ける）。
// freeze は呼び手の中で呼び出しの後に

type Z struct {
    acc mut []byte
    n int
}

type Stream func(z mut Z, emit func(z mut Z, b []byte) error?) error?

func two(z mut Z, emit func(z mut Z, b []byte) error?) error? {
    return emit(mut z, bytes("de"))
}

func count(st Stream) int {
    mut z := Z{acc: mut []byte{1, 2}, n: 0}
    e := st(mut z, (y, b) => { w := freeze(y.acc); y.n += len(w); nil })
    if e != nil { return -1 }
    return z.n
}

func main() {
    println(count(two))
}
