package main

// ブロック本体のラムダの末尾のif式がT? の分岐（ラベルのリテラル / nil）を値にする形。
// 結果がT? 1つの関数型の実引数では、末尾の式を期待型で分岐ごとに寄せる（式本体のラムダ・returnのif式と同じ基準）

type Gone error

func run(x int, send func(n int) error?) error? {
    return send(x)
}

func try(n int) {
    e := run(n, (m) => { if m > 100 { Gone{} } else { nil } })
    f := run(n, (m) => { if m <= 100 { nil } else { Gone{} } })
    println(e == nil, f == nil)
}

func main() {
    try(7)
    try(700)
}
