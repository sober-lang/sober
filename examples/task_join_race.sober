package main

// Joinと子の終わりが別のワーカーでほぼ同時に起きる形を何度も確認する（待ちの型 — 待ち手のxchg・見直し・ウェイクアップする側のxchg — がウェイクアップし損ねないこと）。
// schedfuzzのミューテーションの自己検査（--rt-mutant=2 = 登録とウェイクアップを素のstore / loadに — ウェイクアップし損ねて止まる）の証人も兼ねる

import "std/task"

func work(n int) int {
    mut i := 0
    mut a := n
    while i < (n & 255) * 400 {
        a += i
        i += 1
    }
    return a
}

func main() {
    mut acc := 0
    mut i := 0
    while i < 300 {
        k := i
        r, e := task.Run((s task.Scope) => {
            h := task.Spawn(s, () => work(k))
            // 親も同じくらい働いてから Join（子が別のワーカーで走り、終わりと Join が重なる）
            z := work(k * 7)
            task.Join(h) + z - z
        })
        acc += r
        i += 1
    }
    println(acc)
}
