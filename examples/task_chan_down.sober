package main

// 段 6 P3b-4b: 親（チャネルを作った task）が string を子へ送る — 送り手 = 作った task の側の写し（借りない）。子は受けた値で組み立てて返す

import "std/task"

func main() {
    r, e := task.Run((s task.Scope) => {
        tx, rx := task.NewChannel[string](cap: 1)
        h := task.Spawn(s, (inp) => {
            mut acc := ""
            mut k := 0
            while k < 3 {
                v := task.Recv(inp)
                if v != nil {
                    acc = acc + v + "|"
                }
                k += 1
            }
            acc
        }, give: rx)
        mut i := 0
        while i < 3 {
            w := { "x" + "${i * 11}" }
            task.Send(tx, w)
            i += 1
        }
        task.Join(h)
    })
    println(r)
}
