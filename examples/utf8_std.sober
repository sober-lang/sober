package main

// Go の unicode/utf8 との突き合わせ。生成物 — scripts/utf8_oracle.ts から再生成する

import "std/utf8"

func show(b []byte) {
    s, err := string(b)
    if err != nil {
        switch err {
        case utf8.InvalidUtf8{pos}: println("bad", pos)
        }
    } else {
        println("ok", s)
    }
}

