package main

// std/crypto/rsa + std/crypto/pem: PKCS#8 の PEM の秘密鍵（testdata/crypto — 試験用の RSA-2048 と HttpArena の harness の鍵〔公開済み〕）を読み、
// RSASSA-PSS（SHA-256・MGF1-SHA256・salt 32）で決定的な salt の署名を出して、自分の検証器で受理・改竄で拒否を見る。
// 比較用のGoの実装 = scripts/oracles/crypto_rsa.go（同じsaltのEMSA-PSSをbig.Intのm^d mod n で作った署名とバイト一致 + crypto/crypto.rsa.VerifyPSSで受理）

import "std/crypto/pem"
import "std/crypto/rsa"
import "std/hex"
import "std/iter"

@embed("testdata/crypto/httparena-server.*")
const Certs = map[string]string{}

@embed("testdata/crypto/*.key")
const Keys = map[string]string{}

func file(fs map[string]string, p string) string {
    v := fs[p]
    if v != nil {
        return v
    }
    return ""
}

func salt(seed int) []byte {
    mut out := mut []byte{}
    for i <- iter.Range(0, 32) {
        out = append(out, byte((i * 37 + seed) % 256))
    }
    return freeze(out)
}

func flip(b []byte, at int) []byte {
    mut out := mut []byte{}
    for i <- iter.Range(0, len(b)) {
        out = append(out, if i == at { byte(int(b[i]) ^ 1) } else { b[i] })
    }
    return freeze(out)
}

func one(fs map[string]string, name string) {
    blocks, pe := crypto.pem.Parse(file(fs, "testdata/crypto/${name}.key"))
    if pe != nil || len(blocks) != 1 {
        println(name, "pem error")
        return
    }
    println(name, blocks[0].label, len(blocks[0].der))
    k, ke := crypto.rsa.ParsePKCS8(blocks[0].der)
    if ke != nil {
        println(name, "key error")
        return
    }
    pub := crypto.rsa.Public(k)
    println(name, "size", crypto.rsa.Size(pub))
    msgs := []string{"", "hello", "TLS 1.3, server CertificateVerify"}
    for i <- iter.Range(0, len(msgs)) {
        m := bytes(msgs[i])
        sig, se := crypto.rsa.SignPSS(k, m, salt(i))
        if se != nil {
            println(name, i, "sign error")
            continue
        }
        println(name, i, hex.Format(sig))
        println(name, i, "verify", crypto.rsa.VerifyPSS(pub, m, sig, 32), crypto.rsa.VerifyPSS(pub, flip(m, 0), sig, 32), crypto.rsa.VerifyPSS(pub, m, flip(sig, 100), 32), crypto.rsa.VerifyPSS(pub, m, sig, 20))
    }
}

// PEMの読みの境目: 証明書・2つ続きのチャンク（チェーンの形）・ENDの欠け・base64の綴りの誤り・'=' の位置の誤り
func pems(cs map[string]string) {
    crt := file(cs, "testdata/crypto/httparena-server.crt")
    b1, e1 := crypto.pem.Parse(crt)
    println("crt", e1 == nil, len(b1), if len(b1) == 1 { "${b1[0].label} ${len(b1[0].der)} ${hex.Format(b1[0].der)}" } else { "-" })
    b2, e2 := crypto.pem.Parse(crt + "junk between\n" + crt)
    println("chain", e2 == nil, len(b2))
    _, e3 := crypto.pem.Parse("-----BEGIN CERTIFICATE-----\nAAAA\n")
    println("no end", e3 != nil)
    _, e4 := crypto.pem.Parse("-----BEGIN X-----\nAA*A\n-----END X-----\n")
    println("bad char", e4 != nil)
    _, e5 := crypto.pem.Parse("-----BEGIN X-----\nA=AA\n-----END X-----\n")
    println("bad pad", e5 != nil)
    b6, e6 := crypto.pem.Parse("-----BEGIN X-----\nAAE=\n-----END X-----\n")
    println("pad ok", e6 == nil, if len(b6) == 1 { hex.Format(b6[0].der) } else { "-" })
}

func main() {
    fs := Keys
    one(fs, "rsa2048")
    one(fs, "httparena-server")
    pems(Certs)
}
