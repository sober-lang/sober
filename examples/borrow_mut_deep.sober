package main

// 借りの仮引数の mut の席の anchor: z はループの外（anchor = z の region < 呼び手の最内）・借りのラムダはループの中で作る。
// ラムダはループの中で作った imm（tag — 反復の region）も捕捉し、stream は反復の region の slice を emit する — imm の成分は anchor へ形式コピー

type Z struct {
    acc mut []byte
    n int
}

type Stream func(z mut Z, emit func(z mut Z, b []byte) error?) error?

func chunks(k int, z mut Z, emit func(z mut Z, b []byte) error?) error? {
    mut i := 0
    while i < k {
        mut buf := mut []byte{}
        buf = append(buf, byte(97 + i))
        buf = append(buf, byte(98 + i))
        emit(mut z, freeze(buf))?
        i += 1
    }
    return nil
}

func main() {
    mut z := Z{acc: mut []byte{}, n: 0}
    mut r := 0
    while r < 3 {
        tag := bytes("r${r}")
        st := mk(r + 1)
        e := st(mut z, (y, b) => {
            y.acc = append(y.acc, b[0])
            y.n += len(b) + len(tag)
            nil
        })
        if e != nil { println("error") }
        r += 1
    }
    println(z.n)
    println(len(z.acc))
}

func mk(k int) Stream {
    return (z, emit) => chunks(k, mut z, emit)
}
