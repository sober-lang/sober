package main

// 借りの閉包の mut 捕捉（(α-L1)）の anchor: z はループの外（anchor = z の region < 呼び手の最内）・借りのラムダはループの中で作る。
// ラムダはループの中で作った imm（tag — 反復の region）も捕捉し、stream は反復の region の slice を emit する — imm の成分は anchor へ形式コピー（M4 (a)）

type Stream func(emit func(b []byte) error?) error?

type Z struct {
    acc mut []byte
    n int
}

func chunks(k int, emit func(b []byte) error?) error? {
    mut i := 0
    while i < k {
        mut buf := mut []byte{}
        buf = append(buf, byte(97 + i))
        buf = append(buf, byte(98 + i))
        emit(freeze(buf))?
        i += 1
    }
    return nil
}

func main() {
    mut z := Z{acc: mut []byte{}, n: 0}
    mut r := 0
    while r < 3 {
        tag := bytes("r${r}")
        st := mk(r + 1)
        e := st((b []byte) => {
            z.acc = append(z.acc, b[0])
            z.n += len(b) + len(tag)
            nil
        })
        if e != nil { println("error") }
        r += 1
    }
    println(z.n)
    println(len(z.acc))
}

func mk(k int) Stream {
    return (emit) => chunks(k, emit)
}
