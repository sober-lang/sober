package main

// utf8.View を引数の型に書ける（以前は非公開の型で関数に受け渡せなかった）

import "std/utf8"

func count(v utf8.View, sep byte) int {
    b := utf8.Bytes(v)
    mut n := 0
    mut i := 0
    while i < len(b) {
        if b[i] == sep {
            n += 1
        }
        i += 1
    }
    return n
}

func main() {
    v := utf8.Check(bytes("あ;い;う")) catch return
    println(count(v, ';'))
}
