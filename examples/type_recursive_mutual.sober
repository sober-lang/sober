package main

// 相互再帰の型宣言: Dir は File を map で持ち、File は親の Dir を値（T?）で持つ — 閉路は map を通るので値の大きさは有限（D）

type Dir struct {
    name string
    files map[string]File
}

type File struct {
    name string
    parent Dir?
}

func main() {
    root := Dir{name: "root", files: map[string]File{}}
    f := File{name: "a", parent: root}
    d := Dir{name: "src", files: map[string]File{"a": f}}
    println(len(d.files) + len(bytes(f.name)))
}
