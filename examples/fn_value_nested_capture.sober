package main

// 値として持つラムダの中の値として持つラムダは、外側のラムダの仮引数と本体の束縛、外の関数の束縛を捕捉できる。
// 外側のラムダは、内側が使う外の束縛を自分でも捕捉し、内側のクロージャを作るときに渡す

import "std/iter"

type H func(x int) int

type P func(n int) H

type Q func(a int) P

type R struct {
    p P
}

func incr(x int) int {
    return x + 1
}

func local(k int) P {
    return (n int) => {
        m := n * 2
        (x int) => x + m + k
    }
}

func three(k int) Q {
    return (a int) => (b int) => (x int) => x * a + b * 10 + k * 100
}

func pick(k int) P {
    return (n int) => if n > k { (x int) => x * n } else { incr }
}

func loop(k int) P {
    return (n int) => {
        mut s := 0
        for i <- iter.Range(0, n) {
            s += i
        }
        t := s
        (x int) => x + t + k
    }
}

func mk2(k int) P {
    return (n int) => (x int) => x * n + k
}

func g(p P) int {
    return p(3)(4)
}

func main() {
    k := 7
    println("${mk2(2)(3)(4)} ${g((n int) => (x int) => x * n + k)}")
    r := R{p: (n int) => (x int) => x - n - k}
    ps := []P{(n int) => (x int) => x * n * k}
    println("${local(1)(3)(4)} ${three(1)(2)(3)(4)} ${pick(2)(5)(3)} ${pick(9)(5)(3)} ${loop(1)(4)(10)}")
    println("${r.p(2)(20)} ${ps[0](2)(3)}")
}
