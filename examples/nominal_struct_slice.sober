package main

// 負例（language.md 32 節）: structのsliceを名前なしのsliceに渡す（1フィールドのstructはコア型が下地と同じ — nominalの区別は表層型で見る。
// 旧 check は named scalar の無いプログラムで照合を飛ばしていて受理していた — C1 B3）

type S struct {
    a int
}

func sum(xs []int) int {
    mut t := 0
    for x <- xs {
        t += x
    }
    return t
}

func main() {
    ys := []S{S{a: 1}, S{a: 2}}
    println(sum(ys))
}
