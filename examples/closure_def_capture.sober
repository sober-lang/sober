package main

// 捕捉つきのクロージャをフィールドに持つstructはDefの境界を越える（envは named fn type の閉じたunion — language.md 25 節 工程 4 B1）:
// handlerのDefが引数のstringを捕捉した応答を返し、呼び手がフィールドを読んで呼ぶ

type Gen func(n int) int

type Resp struct {
    status int
    gen Gen?
}

func handle(path string) Resp {
    return Resp{status: 200, gen: (n int) => n + len(bytes(path))}
}

func main() {
    r := handle("/abc")
    g := r.gen
    if g != nil {
        println(g(1))
    }
    println(r.status)
}
