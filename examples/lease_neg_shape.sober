package main

// 配置先のTはスカラーとpool.Scratchのフィールドだけのstruct（diag.Par kind 26 — sliceのフィールドはウィンドウの中で配置先を伸ばしうる）

import "std/task"
import "std/pool"

type Work struct {
    n int
    head pool.Scratch
}

type Bad struct {
    xs []int
    head pool.Scratch
}

func main() {
    lw := task.NewLocal((w mut Bad) => pool.NewScratch(mut w.head, 8))
    println(task.Lease(lw, (w mut Bad) => len(w.xs)))
}
