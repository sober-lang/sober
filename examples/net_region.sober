package main

// net.Serve の region:（2026-10-23 — report-1076 / 1077）: 接続の task の region 1 つの上限。region: 1 MiB の Serve で、"big" を受けた接続は
// 1 つの region に 2 MiB を積んで死ぬ（RegionExceeded{cause: slot_capacity} — Serve が吸収して接続を閉じ、台帳の died が 1 つ数える）。
// 後の接続（"small"）は今どおり往復する — 死んだのはその接続の task だけ

import "std/io"
import "std/iter"
import "std/net"
import "std/task"
import "std/strings"

func show(e error?) string {
    return switch e {
    case nil: "ok"
    case io.Timeout{}: "timeout"
    case io.Expired{}: "expired"
    case io.Closed{}: "closed"
    case io.Denied{}: "denied"
    case io.Other{errno}: "errno ${errno}"
    case net.Bad{}: "bad"
    case strings.InvalidUtf8{}: "invalid utf8"
    }
}

// handle は "big" なら 1 つの region に 2 MiB を積んでから長さを返す（region: 1 MiB を越えて死ぬ）・それ以外は受けたものを返す
func handle(c net.Conn) error? {
    for chunk <- net.Recv(c)? {
        if string(chunk)? == "big" {
            mut xs := mut []int{}
            for i <- iter.Range(0, 262144) {
                xs = append(xs, i)
            }
            net.Send(c, bytes("${len(xs)}"))?
        } else {
            net.Send(c, chunk)?
        }
    }
    return nil
}

func main() {
    println(run() catch "listen failed")
    for pv <- task.Ledger().pools {
        println("pool ${pv.id}: admit ${pv.admit} died ${pv.died}")
    }
}

func run() (string, error?) {
    mut out := ""
    for l <- net.Listen("127.0.0.1:0")? {
        port := net.Port(l)
        r, _ := task.Run((s task.Scope) => {
            x := task.Spawn(s, () => client(port))
            sv, _ := task.Run((s2 task.Scope) => show(net.Serve(l, handle, region: 1 * task.MB)), deadline: 500 * task.MS)
            "serve: ${sv}\n${task.Join(x)}"
        }, deadline: 10000 * task.MS)
        out = r
    }
    return out, nil
}

func client(port int) string {
    v, e := both(port)
    return if e == nil { v } else { show(e) }
}

// both は 1 本目で "big" を送って受けた全部（死んで閉じられる — 空）を、続けて 2 本目で "small" の往復を返す
func both(port int) (string, error?) {
    mut first := mut []byte{}
    mut second := ""
    for a <- net.Dial("127.0.0.1:${port}")? {
        net.Send(a, bytes("big"))?
        for chunk <- net.Recv(a)? {
            for x <- chunk {
                first = append(first, x)
            }
        }
    }
    for b <- net.Dial("127.0.0.1:${port}")? {
        net.Send(b, bytes("small"))?
        for chunk <- net.Recv(b)? {
            second = string(chunk)?
            break
        }
    }
    return "big: [${string(freeze(first))?}] / small: ${second}", nil
}
