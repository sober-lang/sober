package main

// 反復の region の約束と宛先の深度のレジスタ（W_DEST）の回帰例: 印のある呼び出し（結果が return に流れ着く）は直前に
// 呼び手の宛先の深度をレジスタへ書き、印を持つ関数が入口で読んで 0 に戻す。読まない関数（keep — 本体に印が無い）へ書くと値が残り、
// 後のループの中の印の無い呼び出し（tag）の入口が拾って、結果を外の region（run の宛先）に作ってしまう。tag 自身も keep の前に同じ値を書き直すので、
// 反復ごとに外の region へ積もる（1 反復 4 KiB — 壊れると 2000 → 20000 回で RSS が比例）。回数は引数で変えられる（既定 2000 —
// scripts/iterregion.sh が 10 倍にして RSS が比例しないことを見る）

import "std/os"

// 印を持たない（return の式に確保も呼び出しも無い）— 宛先のレジスタを読まない
func keep(s string) string {
    return s
}

// 印つき（return の連結）— 入口で宛先のレジスタを読む。連結の左の keep(s) も印のある呼び出し
func tag(s string, big string) string {
    return keep(s) + big + "."
}

func run(s string, n int) string {
    mut big := "a"
    while len(bytes(big)) < 4096 {
        big = big + big
    }
    x := keep(s)
    mut t := 0
    mut i := 0
    while i < n {
        r := tag(s, big)
        b := bytes(r)
        t += len(b) + int(b[len(b) - 1])
        i += 1
    }
    return x + "${t}"
}

// run を印のある呼び出しで呼ぶ（run の宛先が wrap の呼び手の深度 = ループの外になる）
func wrap(n int) string {
    r := run("ab", n)
    return r
}

func count() int {
    args := os.Args() catch return 2000
    if len(args) != 2 {
        return 2000
    }
    mut n := 0
    for c <- bytes(args[1]) {
        n = n * 10 + int(c) - 48
    }
    return n
}

func main() int {
    r := wrap(count())
    println(r)
    return 0
}
