package main

// 段 6 P3b: 3 本の生産者がそれぞれのチャネル（容量 2）で送り、親が順に受ける（fan-in を正準順で — select なし）。
// 切替点が多い形（spawn ごとの子 / 親の順・走れる task の選び方）— schedvec が全スケジュールで同じ観測を確かめる

import "std/par"

func main() {
    r, e := par.Scope((s par.S) => {
        ta, ra := par.NewChan[int](cap: 2)
        tb, rb := par.NewChan[int](cap: 2)
        tc, rc := par.NewChan[int](cap: 2)
        ha := par.Spawn(s, (o) => {
            mut i := 0
            while i < 4 {
                par.Send(o, i + 10)
                i += 1
            }
            1
        }, give: ta)
        hb := par.Spawn(s, (o) => {
            mut i := 0
            while i < 4 {
                par.Send(o, i * 100)
                i += 1
            }
            2
        }, give: tb)
        hc := par.Spawn(s, (o) => {
            mut i := 0
            while i < 4 {
                par.Send(o, i * i)
                i += 1
            }
            3
        }, give: tc)
        mut acc := 0
        mut k := 0
        while k < 4 {
            a := par.Recv(ra)
            b := par.Recv(rb)
            c := par.Recv(rc)
            if a != nil && b != nil && c != nil {
                acc = acc * 7 + a + b * 3 + c * 5
            }
            k += 1
        }
        acc * 10 + par.Join(ha) + par.Join(hb) + par.Join(hc)
    })
    println(r)
}
