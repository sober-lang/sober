package main

// 負例（language.md 13 節「表の網羅」）: @exhaustive の union の switch が variant を名指していない（default が黙って Tri を拾う形）

type Shape union {
    Circle{r int}
    Rect{w int; h int}
    Tri{}
}

@exhaustive
func name(s Shape) string {
    return switch s {
    case Circle{}: "circle"
    case Rect{}: "rect"
    default: "other"
    }
}

func main() {
    println(name(Tri{}))
}
