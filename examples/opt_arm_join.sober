package main

// TとT? の分岐の合流（spec T-16）: 期待型の無い位置のif / switchの式で、分岐の型がTとT? に分かれるなら式の型はT?。
// nilの分岐から組むT?（examples/nil_sibling）と同じパスで、Tの分岐をT? へ寄せる。TとU?（T ≠ U）は今までどおり拒否

func get(n int) int? {
    if n > 0 {
        return n
    }
    return nil
}

func show(r int?) {
    if r != nil {
        println(r)
    } else {
        println(-1)
    }
}

type Op union {
    Add { n int }
    Neg {}
    Skip {}
}

func main() {
    q := get(0)
    p := get(7)
    show(if true { 4 } else { q })
    show(if false { 4 } else { q })
    show(if false { q } else { 5 })
    show(if p != nil { p } else { q })
    c := 2
    r := if c == 1 { 1 } else if c == 2 { p } else { 3 }
    show(r)
    s := switch c {
    case 1: q
    case 2: 20
    default: p
    }
    show(s)
    o := pick()
    t := switch o {
    case Add{n}: n
    case Neg{}: q
    case Skip{}: 0
    }
    show(t)
    w := if c == 2 { "x" } else { getS() }
    if w != nil {
        println(w)
    }
}

func getS() string? {
    return nil
}

func pick() Op {
    return Neg{}
}
