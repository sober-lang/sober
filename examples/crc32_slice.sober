package main

// std/hash/crc32 の slicing-by-8: 長さ 0〜599 の擬似乱数列の CRC-32 を混ぜた値（期待値は zlib.crc32 で同じ列を作って計算 — 256 未満は
// 1バイトずつのパス・256以上は8バイトのワードのパス + 端の7バイトまで）とRFC 1952の照合値0xcbf43926

import "std/convert"
import "std/hash/crc32"
import "std/iter"

func main() int {
    // 長さ0〜600の擬似乱数列でslicing-by-8 ≡ 1バイトずつ（256未満は1バイトずつのパス・以上はワードのパス + 端）
    mut b := mut []byte{}
    mut x := 12345
    mut sum := 0
    for n <- iter.Range(0, 600) {
        sum = sum ^ (hash.crc32.Sum(freeze(b)) * (n + 1))
        x = x * 1103515245 + 12345
        b = append(b, byte((x >> 16) & 0xff))
    }
    println(convert.FormatInt(sum))
    println(convert.FormatInt(hash.crc32.Sum(bytes("123456789"))))
    return 0
}
