package main

// map の挿入の償却の回帰例: 長い map は索引を横に持つ。索引をセル列の後ろに確保すると先端が外れ、次の挿入が全コピー →
// 引きで索引を作り直し（またセル列の後ろ）を毎回繰り返して O(n²) になる（挿入 2 万件で region の上限 — exit 102 だった）。
// 全コピーの道で索引を先に確保してセル列を先端に残す形なら、挿入 5 万件と途中の引きが線形で済む

import "std/iter"

func main() int {
    mut m := mut map[int]int{}
    mut hit := 0
    for i <- iter.Range(0, 50000) {
        m[i * 7] = i
        if m[i * 7 - 7] != nil {
            hit += 1
        }
    }
    mut sum := 0
    for i <- iter.Range(0, 50000) {
        v := m[i * 7]
        if v != nil {
            sum += v
        }
    }
    println(len(m))
    println(hit)
    println(sum)
    return 0
}
