package main

// 段 6 P4-1 → P4-2: 子と親が両方 stdout へ書く。P4-1 では行バッファが task で共有だったので出力の順はスケジュールで決まった（schedfuzz の
// 自己検査の証人だった）。P4-2 の (O1)「spawn の木の先行順」でスケジュールに依らない — 親の "parent" は 2 つの子の流れの後
// （証人の役は直書きの examples/par_print_direct へ）

import "std/par"

func work(tag string, n int) int {
    mut i := 0
    mut acc := 0
    while i < n {
        println("${tag} ${i}")
        acc += i
        i += 1
    }
    return acc
}

func main() {
    println("start")
    r, e := par.Scope((s par.S) => {
        a := par.Spawn(s, () => work("a", 2))
        b := par.Spawn(s, () => work("b", 2))
        println("parent")
        par.Join(a) + par.Join(b)
    })
    println(r)
}
