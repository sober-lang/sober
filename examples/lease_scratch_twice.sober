package main

// Scratchの容量は1回だけ — ウィンドウの中で作り直すとpanic(pool.ScratchSized{})（配置先が宙吊りにならない）

import "std/task"
import "std/pool"

type Work struct {
    n int
    head pool.Scratch
}

func main() {
    lw := task.NewLocal((w mut Work) => pool.NewScratch(mut w.head, 8))
    println(task.Lease(lw, (w mut Work) => pool.Cap(mut w.head)))
    task.Lease(lw, (w mut Work) => {
        pool.NewScratch(mut w.head, 16)
    })
    println("unreachable")
}
