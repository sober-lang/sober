package main

// http のルーター: ルートの表 `[]http.server.Route`（静的 / :name / *name のパターン）・Mount / Merge の合成・mw の before / after（外→内・内→外）・
// short-circuit・404 / 405 / HEAD → GET・優先順は表の並びに依らない（静的 > :name > *name）。ネットの代わりに recv が決まった要求の列を 1 切片で渡し、
// send が応答を印字する（examples/http_servewith の形 — 行末の CR は外して印字）

import "std/http/server"

// nil を "-" に
func or(s string?) string {
    return if s != nil { s } else { "-" }
}

func getUser(r http.server.Request) http.server.Response {
    return http.server.Text("user ${or(http.server.Param(r, "id"))}\n")
}

func me(r http.server.Request) http.server.Response {
    return http.server.Text("me\n")
}

func static(r http.server.Request) http.server.Response {
    return http.server.Text("file [${or(http.server.Param(r, "rest"))}]\n")
}

func top(r http.server.Request) http.server.Response {
    return http.server.Text("top ${or(http.server.Param(r, "name"))}\n")
}

func create(r http.server.Request) http.server.Response {
    return http.server.Response{status: 201, contentType: "text/plain", body: r.body}
}

func health(r http.server.Request) http.server.Response {
    return http.server.Text("ok\n")
}

// X-Token の無い要求を 401 で止める（short-circuit）
func auth(r http.server.Request) http.server.Response? {
    println("  auth before ${r.pattern}")
    if http.server.Header(r, "x-token") == nil {
        return http.server.Status(401)
    }
    return nil
}

func authAfter(r http.server.Request, w http.server.Response) http.server.Response {
    println("  auth after")
    return w
}

func logBefore(r http.server.Request) http.server.Response? {
    println("  log before ${r.method} ${r.path}")
    return nil
}

func logAfter(r http.server.Request, w http.server.Response) http.server.Response {
    println("  log after")
    return w
}

func users() []http.server.Route {
    return []http.server.Route{
        http.server.Route{method: "GET", path: "/:id", handler: getUser},
        http.server.Route{method: "GET", path: "/me", handler: me},
        http.server.Route{method: "POST", path: "/", handler: create}}
}

func files() []http.server.Route {
    return []http.server.Route{http.server.Route{method: "GET", path: "/*rest", handler: static}, http.server.Route{method: "GET", path: "/:name", handler: top}}
}

func app(rev bool) []http.server.Route {
    am := http.server.Middleware{before: auth, after: authAfter}
    lm := http.server.Middleware{before: logBefore, after: logAfter}
    a := http.server.Mount("/users", users(), []http.server.Middleware{am})
    b := http.server.Merge(http.server.Mount("/static", files(), []http.server.Middleware{}), []http.server.Route{http.server.Route{method: "GET", path: "/health", handler: health}})
    rs := if rev { http.server.Merge(b, a) } else { http.server.Merge(a, b) }
    return http.server.Mount("", rs, []http.server.Middleware{lm})
}

func show(b []byte) error? {
    mut out := mut []byte{}
    for x <- b {
        if x != '\r' {
            out = append(out, x)
        }
    }
    println(string(freeze(out)) catch "?")
    return nil
}

func feed(s string, k func([]byte)) error? {
    k(bytes(s))
    return nil
}

func serve(rs []http.server.Route, reqs string) {
    e := http.server.ServeWith((k) => feed(reqs, k), (b) => show(b), (r) => http.server.Dispatch(rs, r))
    println(e == nil)
}

func main() {
    reqs := "GET /users/42 HTTP/1.1\r\nX-Token: t\r\n\r\n" +
        "GET /users/me HTTP/1.1\r\nX-Token: t\r\n\r\n" +
        "GET /users/7 HTTP/1.1\r\n\r\n" +
        "POST /users/ HTTP/1.1\r\nX-Token: t\r\nContent-Length: 3\r\n\r\nabc" +
        "GET /static/css/a.css HTTP/1.1\r\n\r\n" +
        "GET /static HTTP/1.1\r\n\r\n" +
        "GET /static/a.css HTTP/1.1\r\n\r\n" +
        "HEAD /health HTTP/1.1\r\n\r\n" +
        "DELETE /health HTTP/1.1\r\n\r\n" +
        "GET /nope HTTP/1.1\r\nConnection: close\r\n\r\n"
    rs := app(false)
    // 表を歩く（introspect — 全ルートが見える）
    for x <- rs {
        println("${x.method} ${x.path} mw=${len(x.middleware)}")
    }
    serve(rs, reqs)
    // 表の並びを入れ替えても同じ（優先順は並びに依らない）
    println("-- reversed")
    serve(app(true), reqs)
}
