package main

// 境界検査の消去 ⑤（bce.sober — 定数添字の束）の網: 先に通った小さい定数添字（b[2]）の検査からは、大きい定数添字（b[4]）が範囲内と言えない —
// 長さ 3 の列では b[4] で添字の範囲外の panic（その前の出力は見える）。大きい添字が先なら小さい添字の検査は消してよい（b[1]）

func pick(b []int) int {
    return b[0] + b[2] + b[1] + b[4]
}

func main() {
    a := []int{1, 2, 3, 4, 5}
    println(pick(a))
    c := []int{1, 2, 3}
    println(pick(c))
}
