package main

// 浮動小数の印字の差分（scripts/oracles/float_format.go — 境界値と乱択のビット列を Go の strconv.FormatFloat(f, 'g', -1, 64) と照合）

import "std/convert"
import "std/io"
import "std/math"

func main() int {
    b := io.ReadStdin() catch return 1
    mut i := 0
    while i < len(b) {
        mut neg := false
        if b[i] == '-' {
            neg = true
            i += 1
        }
        mut v := 0
        while b[i] != '\n' {
            v = v * 10 + int(b[i]) - '0'
            i += 1
        }
        i += 1
        println(convert.FormatFloat(math.FromBits(if neg { 0 - v } else { v })))
    }
    return 0
}
