package main

// 入れ子の型パターンが網羅している switch（wild 無し）— build は逐次照合、check は同じ外側の variant の腕を並べて外れたら次の腕へ
// （パターン行列で網羅を確かめ、尽きた先は到達しない項 — language.md 13 節 A6）。網羅の検査が入れ子の欄まで見て受理を保つことの回帰例

type I union {
    I1{v int}
    I2{w int}
}

type O union {
    O1 {
        x I
        y int
    }
    O2{k int}
}

func f(o O) int {
    return switch o {
    case O1{x: I1{v}, y}: v + y
    case O1{x: I2{w}, y}: w * y
    case O2{k}: k
    }
}

func main() {
    println(f(O1{x: I1{v: 3}, y: 2}))
    println(f(O1{x: I2{w: 3}, y: 2}))
    println(f(O2{k: 9}))
}
