package main

// 入れ子の型パターンが網羅しているswitch（wild無し）— buildは逐次照合、checkは同じ外側のvariantの分岐を並べて外れたら次の分岐へ
// （パターン行列で網羅を確認し、尽きた先は到達しない項 — language.md 13 節A6）。網羅の検査が入れ子のフィールドまで見て受理を保つことの回帰例

type I union {
    I1{v int}
    I2{w int}
}

type O union {
    O1 {
        x I
        y int
    }
    O2{k int}
}

func f(o O) int {
    return switch o {
    case O1{x: I1{v}, y}: v + y
    case O1{x: I2{w}, y}: w * y
    case O2{k}: k
    }
}

func main() {
    println(f(O1{x: I1{v: 3}, y: 2}))
    println(f(O1{x: I2{w: 3}, y: 2}))
    println(f(O2{k: 9}))
}
