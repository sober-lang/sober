package main

// 段 6 P3a-1d: handle（task.Handle）の捕獲（diag.Par kind 6 — check と build が同じ拒否。desugar/parcheck.sober）

import "std/task"

func main() {
    r, e := task.Run((s task.Scope) => {
        h := task.Spawn(s, () => 1)
        task.Join(task.Spawn(s, () => task.Join(h)))
    })
    println(r)
}
