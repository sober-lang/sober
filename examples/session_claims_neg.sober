package main

// 負例: session.ClaimsはCheckだけが作る — Openで止めて、世代を見ずにClaimsを組むことはできない（封の型の外でのフィールドつきリテラルは拒否 — diag.Sealed・language.md 15 節）。
// ゼロ値 session.Claims{} は書けるが、中身が無いので session.Who も session.Of も false を返す

import "std/session"
import "std/time"

func main() {
    k := session.KeyNew()
    raw := session.Seal(session.Mint(k, "alice", 1, time.Now(), 60))
    u, _ := session.Open(k, raw, time.Now())
    c := session.Claims{v: session.Info{subject: session.Subject(u), gen: 0, id: "", issued: time.Now(), expires: time.Now()}}
    who, _ := session.Who(c)
    println(who)
}
