package main

// 負例: ラムダはmutの束縛を捕捉できない — 値の呼び出しの実引数のラムダ（借りのクロージャ）も同じ（旧 (α-L1) は2026-11-04に撤去 — language.md 25 節）。
// 状態は呼び手が持って mut 仮引数で渡す（borrow_mut_count の形）

type Stream func(emit func(b []byte) error?) error?

func count(st Stream) int {
    mut n := 0
    e := st((b []byte) => { n += len(b); nil })
    if e != nil { return -1 }
    return n
}

func two(emit func(b []byte) error?) error? {
    emit(bytes("abc"))?
    return emit(bytes("de"))
}

func main() {
    println(count((emit) => two(emit)))
}
