package main

// 段 6 P3b-5: Gather は Join の列 — 死んだ子を待った呼び手も死ぬ（この子の死は私の死）

import "std/par"

func pick(xs []int, i int) int {
    return xs[i]
}

func main() {
    xs := []int{10, 20}
    r, e := par.Scope((s par.S) => {
        mut hs := mut []par.Task[int]{}
        hs = append(hs, par.Spawn(s, () => pick(xs, 1)))
        hs = append(hs, par.Spawn(s, () => pick(xs, 2)))
        vs := par.Gather(hs)
        vs[0]
    })
    println(r)
}
