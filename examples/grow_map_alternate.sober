package main

// 交互に 2 本の map へ挿入する（データ構造便の続編 — rt.map_grow の幾何成長）と、同じセル列を共有する map の写しの独立（値の意味論）

import "std/iter"

func main() {
    mut m1 := mut map[int]int{}
    mut m2 := mut map[string]int{}
    for i <- iter.Range(0, 3000) {
        m1[i] = i * 2
        m2["k${i}"] = i
    }
    mut s := 0
    for i <- iter.Range(0, 3000) {
        a := m1[i]
        b := m2["k${i}"]
        if a != nil && b != nil {
            s += a + b
        }
    }
    println(len(m1) + len(m2))
    println(s)
    mut p := mut map[int]int{}
    for i <- iter.Range(0, 40) {
        p[i] = i
    }
    mut a := p
    mut b := p
    a[100] = 1
    b[200] = 2
    p[300] = 3
    println(len(a) + len(b) + len(p))
    x := a[200]
    y := b[100]
    println(if x == nil && y == nil { 1 } else { 0 })
}
