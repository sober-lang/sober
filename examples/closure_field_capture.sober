package main

// 値の位置のクロージャ（language.md 25 節）: 値化可能な named fn type のフィールドに置いたラムダは、外のimmの束縛を
// 作成点のコピーとして捕捉する（コアでは持ち上げたDef + 環境の組 — desugar/closure.sober）。buildはlowerのクロージャのstruct〔code + env〕— lower/closure.sober

type Score func(x int, y int) int

type Rule struct {
    name string
    score Score
}

func main() {
    base := 100
    tag := "abc"
    r := Rule{name: "r1", score: (x int, y int) => base + x * 10 + y + len(bytes(tag))}
    println(r.name)
    println(r.score(2, 3))
    f := r.score
    println(f(4, 5))
}
