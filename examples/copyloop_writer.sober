package main

// Writer への写しの一括化: ① std/io の WriteBytes の中の添字の写し（宛先が欄の経路 `w.buf` の (B) の形）と
// ② `for j <- iter.Range(lo, hi) { io.WriteByte(mut w, S[j]) }` — 区間が枠の空きにまるごと収まれば一括・枠の境目を跨ぐ回は元の for

import "std/io"
import "std/iter"

func put(w mut io.Writer, s []byte, lo int, hi int) {
    for j <- iter.Range(lo, hi) {
        io.WriteByte(mut w, s[j])
    }
}

func main() {
    mut src := mut []byte{}
    for i <- iter.Range(0, 100) {
        src = append(src, byte('a' + i % 26))
    }
    src = append(src, '\n')
    s := freeze(src)
    mut w := io.Writer{}
    // 局所の Writer（全体で約 80 KB — 枠〔64 KiB〕の境目を跨ぐ）
    for r <- iter.Range(0, 300) {
        for j <- iter.Range(r % 50, len(s)) {
            io.WriteByte(mut w, s[j])
        }
    }
    // mut 仮引数の Writer・空の区間
    for r <- iter.Range(0, 300) {
        put(mut w, s, 0, len(s) - r % 50)
        put(mut w, s, 90, 2)
    }
    // WriteBytes / WriteString（枠の空きの分ずつ）
    for r <- iter.Range(0, 300) {
        io.WriteBytes(mut w, s)
        io.WriteString(mut w, "-- 区切り --\n")
    }
    e := io.Flush(mut w)
    println(e == nil)
}
