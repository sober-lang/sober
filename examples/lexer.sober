package main

type Token struct {
    kind, start, end int
}

func isDigit(c int) int {
    return if c >= '0' && c <= '9' { 1 } else { 0 }
}

func isAlpha(c int) int {
    return if c >= 'a' && c <= 'z' { 1 } else { 0 }
}

func lex(text string) []Token {
    src := bytes(text)
    mut toks := mut []Token{}
    mut i := 0
    while i < len(src) {
        c := int(src[i])
        if c == ' ' {
            i += 1
        } else if isDigit(c) == 1 {
            mut j := i
            while j < len(src) && isDigit(int(src[j])) == 1 {
                j += 1
            }
            toks = append(toks, Token{0, i, j})
            i = j
        } else if isAlpha(c) == 1 {
            mut j := i
            while j < len(src) && (isAlpha(int(src[j])) == 1 || isDigit(int(src[j])) == 1) {
                j += 1
            }
            toks = append(toks, Token{1, i, j})
            i = j
        } else {
            toks = append(toks, Token{2, i, i + 1})
            i += 1
        }
    }
    return freeze(toks)
}

func printToken(t Token) {
    println(t.kind, t.start, t.end)
}

func main() {
    toks := lex("ab1 42+x 7")
    println(len(toks))
    mut k := 0
    while k < len(toks) {
        printToken(toks[k])
        k += 1
    }
}
