package main

// 関数型の結果の error?（language.md 25 節 — 2026-10-14）: `func(int) error?` / `func(int) (int, error?)` の仮引数に、失敗を値として返すラムダか
// 名前付き関数を渡せる。呼び先の `f(x)?` は閉包の失敗をそのまま上へ流し、`return f(x)` は値として返す。ラムダの本体の値は期待型で寄せる
// （ラベル・nil・if の腕）。ラムダの本体の `?` / return は従来どおり定義した関数へ（非局所 — 8 節）。
// η 展開（同じ節）: 関数型の仮引数に名前付き関数をそのまま渡すと、loader が同じ数の仮引数のラムダに写す（`app(3, dbl)` = `app(3, (a) => dbl(a))`）

import "std/task"

type Odd error {
    n int
}

type TooBig error {
    n int
}

// half は偶数の半分（奇数で Odd）
func half(v int) (int, error?) {
    if v % 2 == 1 {
        return 0, Odd{n: v}
    }
    return v / 2, nil
}

// small は 10 未満か（でなければ TooBig）
func small(v int) error? {
    if v >= 10 {
        return TooBig{n: v}
    }
    return nil
}

// each は xs を順に f に通し、最初の失敗で止まる（閉包の `?`）
func each(xs []int, f func(int) error?) error? {
    for x <- xs {
        f(x)?
    }
    return nil
}

// first は f(x) をそのまま返す（閉包の結果を値として）
func first(x int, f func(int) error?) error? {
    return f(x)
}

// sumE は f の成功値を足す（多値の結果の閉包への `?`）
func sumE(xs []int, f func(int) (int, error?)) (int, error?) {
    mut s := 0
    for x <- xs {
        s += f(x)?
    }
    return s, nil
}

func app(x int, f func(int) int) int {
    return f(x) + 1
}

func dbl(v int) int {
    return v * 2
}

func sq(x int) int {
    return x * x
}

func join(xs []int) string {
    mut out := ""
    for x <- xs {
        out = if out == "" { "${x}" } else { "${out} ${x}" }
    }
    return out
}

func show(e error?) string {
    return switch e {
    case nil: "ok"
    case Odd{n}: "odd ${n}"
    case TooBig{n}: "too big ${n}"
    }
}

func main() {
    // 名前付き関数（η 展開）
    println(show(each([]int{1, 2, 3}, small)))
    println(show(each([]int{1, 20, 30}, small)))
    // ラムダの本体の値: if の腕のラベル / nil
    println(show(each([]int{4, 6, 7}, (v) => if v % 2 == 1 { Odd{n: v} } else { nil })))
    // ブロックの本体（末尾の値を寄せる — 末尾が if 式で腕に nil を書く形は関数の本体と同じく未対応: `return` の無い末尾は型の分かる式）
    println(show(first(5, (v) => {
        w := v * 3
        small(w)
    })))
    println(show(first(2, (v) => small(v))))
    // 多値の結果: 成功値を足す・catch で受ける
    println("${sumE([]int{2, 4, 6}, half) catch -1} ${sumE([]int{2, 3}, half) catch -1} ${sumE([]int{8}, (v) => half(v)) catch -1}")
    s, e := sumE([]int{10, 12, 5}, half)
    println("${s} ${show(e)}")
    // η 展開の他の位置: 位置引数・パイプ段・std の展開される口（task.Map — 名前付き関数の本体が子 task の本体へ）
    println("${app(3, dbl)} ${4 |> app(dbl)}")
    r, me := task.Map([]int{1, 2, 3}, sq)
    println("${join(r)} ${me == nil}")
}
