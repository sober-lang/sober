package main

// 負例（型の不一致）: 絞った mut の名前へ代入した文の後ろでは、名前は外の T? のセルに戻る（絞りが外れる）。
// 代入の後ろで x を中身の int として使うには、もう一度絞る（`if x != nil { … }`）

func get(n int) int? {
    return if n > 0 { n } else { nil }
}

func main() {
    mut x := get(3)
    if x == nil {
        return
    }
    x = get(x - 1)
    println(x + 1)
}
