package main

// 回帰例: if 式の値の型（bytes の実引数・束縛）— check が Malformed で拒否し build は受理していた（check ⊂ build）

func pick(c bool) string {
    return if c { "ab" } else { "xyz" }
}

func direct(c bool) int {
    b := bytes(if c { "ab" } else { "xyz" })
    return len(b)
}

func bound(c bool) int {
    s := if c { pick(!c) } else { "q" }
    return len(bytes(s))
}

func main() {
    println(direct(true))
    println(direct(false))
    println(bound(true))
    println(bound(false))
}
