package main

// 検証例 errparse — ミニ lexer + 再帰下降 parser を位置つきエラーで書く。
// 位置は入力のバイトオフセット 1 語で運び、表示するときに line:col へ解決する

type UnexpectedChar error {
    pos int
}

type UnexpectedEnd error {
    pos int
}

// want はトークンの種類（0 = 項、5 = ')'、6 = 入力の終わり）
type Expected error {
    pos int
    want int
}

// 包み替えの行き先。K3 なので内側の位置は捨てられ、何番目の入力かだけが残る
type BadInput error {
    which int
}

// kind: 0 = 数、1 = '+'、2 = '-'、3 = '*'、4 = '('、5 = ')'、6 = 入力の終わり
type Token struct {
    kind, pos, val int
}

func isDigit(c int) bool {
    return c >= '0' && c <= '9'
}

func punct(c int, at int) (int, error?) {
    if c == '+' { return 1, nil }
    if c == '-' { return 2, nil }
    if c == '*' { return 3, nil }
    if c == '(' { return 4, nil }
    if c == ')' { return 5, nil }
    return 0, UnexpectedChar{pos: at}
}

// ループ内の ? — slice の結果成分のゼロ値（空 slice）は関数入口で束縛される（Z1）
func lex(text string) ([]Token, error?) {
    src := bytes(text)
    mut toks := mut []Token{}
    mut i := 0
    while i < len(src) {
        c := int(src[i])
        if c == ' ' || c == '\n' {
            i += 1
        } else if isDigit(c) {
            mut j := i
            mut v := 0
            while j < len(src) && isDigit(int(src[j])) {
                v = v * 10 + int(src[j]) - 48
                j += 1
            }
            toks = append(toks, Token{0, i, v})
            i = j
        } else {
            k := punct(c, i)?
            toks = append(toks, Token{k, i, 0})
            i += 1
        }
    }
    toks = append(toks, Token{6, len(src), 0})
    return toks, nil
}

// factor := 数 | '-' factor | '(' expr ')'。結果は（値, 次の位置, err）の 3 成分
func factor(ts []Token, i int) (int, int, error?) {
    t := ts[i]
    if t.kind == 0 {
        return t.val, i + 1, nil
    }
    if t.kind == 2 {
        v, j := factor(ts, i + 1)?
        return 0 - v, j, nil
    }
    if t.kind == 4 {
        v, j := expr(ts, i + 1)?
        if ts[j].kind != 5 {
            return 0, 0, Expected{pos: ts[j].pos, want: 5}
        }
        return v, j + 1, nil
    }
    if t.kind == 6 {
        return 0, 0, UnexpectedEnd{pos: t.pos}
    }
    return 0, 0, Expected{pos: t.pos, want: 0}
}

// term := factor ('*' factor)*
func term(ts []Token, i int) (int, int, error?) {
    v0, j0 := factor(ts, i)?
    mut v := v0
    mut j := j0
    while ts[j].kind == 3 {
        r, k := factor(ts, j + 1)?
        v = v * r
        j = k
    }
    return v, j, nil
}

// expr := term (('+' | '-') term)*
func expr(ts []Token, i int) (int, int, error?) {
    v0, j0 := term(ts, i)?
    mut v := v0
    mut j := j0
    while ts[j].kind == 1 || ts[j].kind == 2 {
        r, k := term(ts, j + 1)?
        v = if ts[j].kind == 1 { v + r } else { v - r }
        j = k
    }
    return v, j, nil
}

func run(text string) (int, error?) {
    ts := lex(text)?
    v, j := expr(ts, 0)?
    if ts[j].kind != 6 {
        return 0, Expected{pos: ts[j].pos, want: 6}
    }
    return v, nil
}

// トップの包み替え: どちらの入力で落ちたかに置き換える
func sum2(a string, b string) (int, error?) {
    x := run(a)? BadInput{which: 1}
    y := run(b)? BadInput{which: 2}
    return x + y, nil
}

// バイトオフセット → (line, col)。どちらも 1 始まり
func lineCol(text string, pos int) (int, int) {
    src := bytes(text)
    mut line := 1
    mut col := 1
    mut i := 0
    while i < pos {
        if src[i] == '\n' {
            line += 1
            col = 1
        } else {
            col += 1
        }
        i += 1
    }
    return line, col
}

func errPos(e error) int {
    return switch e {
    case UnexpectedChar{pos}: pos
    case UnexpectedEnd{pos}: pos
    case Expected{pos, want}: pos
    }
}

func show(text string) {
    v, err := run(text)
    if err != nil {
        l, c := lineCol(text, errPos(err))
        switch err {
        case UnexpectedChar{pos}: println("${l}:${c}: unexpected char")
        case UnexpectedEnd{pos}: println("${l}:${c}: unexpected end")
        case Expected{pos, want}: println("${l}:${c}: expected kind ${want}")
        }
    } else {
        println("= ${v}")
    }
}

func showSum(a string, b string) {
    v, err := sum2(a, b)
    if err != nil {
        switch err {
        case BadInput{which}: println("sum: bad input ${which}")
        }
    } else {
        println("sum = ${v}")
    }
}

func main() {
    show("1 + 2 * (3 - 4)")
    show("12 * 3\n  + 4 * -5")
    show("1 + $")
    show("2 * (3 + 4")
    show("7 +\n\n")
    show("1 2")
    show("3 *\n + 1")
    showSum("1+1", "2*")
    showSum("5", "(6)")
}
