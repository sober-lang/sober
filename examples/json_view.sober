package main

// std/json（language.md 16 節）: 平らな文書 Doc を 1 段ずつ開くビュー Value で歩く — 各段の switch は網羅が要る（負例 json_view_nonexh）。
// 入れ子は明示のスタックで（関数の再帰でも書ける — 普通の関数なので）。印字は決定的（空白なし・欄はソースの順・数は字句のまま）

import "std/io"
import "std/iter"
import "std/json"

// walk は節 n から下を深さ優先で 1 行ずつ印字する（path = そこまでの道）
func walk(d json.Doc, n int, path string) {
    switch json.At(d, n) {
    case json.Null{}: println("${path} = null")
    case json.Bool{v}: println("${path} = ${if v { "true" } else { "false" }}")
    case json.Number{lit}: println("${path} = num ${lit}")
    case json.String{v}: println("${path} = str \"${v}\" (${len(bytes(v))} bytes)")
    case json.Array{items}: {
        println("${path} = array of ${len(items)}")
        for i <- iter.Range(0, len(items)) {
            walk(d, items[i], "${path}[${i}]")
        }
    }
    case json.Object{names, vals}: {
        println("${path} = object of ${len(names)}")
        for i <- iter.Range(0, len(names)) {
            walk(d, vals[i], "${path}.${names[i]}")
        }
    }
    }
}

func main() {
    b, rerr := io.ReadStdin()
    if rerr != nil {
        println("read error")
        return
    }
    d, err := json.Parse(b)
    switch err {
    case json.InvalidJson{pos, kind}: println("invalid at ${pos} (kind ${kind})")
    case nil: {
        walk(d, json.Root(d), "$")
        println(json.Format(d, json.Root(d)))
        n := json.Get(d, json.Root(d), "name")
        if n != nil {
            println("name at byte ${json.Pos(d, n)}")
        }
    }
    }
}
