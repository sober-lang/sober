package main

// 段 6 P3a（language.md 11 節 — A1 (X)）: 死の扱いの 3 通り。task.Try は子の死を値（Outcome.Died）で見る・scope の err は
// 完走したが死んだ子（ChildDied）。build は即時形（P3a-2b — 子は Spawn の時点で走る）

import "std/task"

type Boom panic

func main() {
    a := 3
    r, err := task.Run((s task.Scope) => {
        ok := task.Spawn(s, () => a * 2)
        bad := task.Spawn(s, () => {
            if a > 2 {
                panic(Boom{})
            }
            1
        })
        k := switch task.Try(bad) {
        case task.Ok{v}: v
        case task.Failed{}: 100
        case task.Died{cause}: 100
        }
        task.Join(ok) + k
    })
    if err != nil {
        println(0)
    }
    println(r)
}
