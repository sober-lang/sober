package main

// os.Sleep の載せ替え（language.md 28 節「デッドライン」）: std/task のプログラムの Sleep は rt の期限つき待ち
// （timerfdをrt.fdwaitで待つ — スリープする間はワーカーを譲る）。期限つきのscopeの中のSleepは期限が来たらエラーなしで早く返り（SleepExpired = true）、
// 期限より短いSleep・期限の無いSleepは満了までスリープする（false）。スリープする子が8本でもワーカー1本で並んでスリープする（ワーカーを塞がない）。
// W1（協調形）でも W8 でも同じ出力

import "std/os"
import "std/task"

func main() {
    // 期限 50 ms の scope で 10 秒の Sleep — 期限で早く起きる（10 秒は待たない）
    c, _ := task.Run((s task.Scope) => os.SleepExpired(10000), deadline: 50 * task.MS)
    println("cut by deadline: ${c}")
    // 期限より短い Sleep は満了まで（切られない）
    d, _ := task.Run((s task.Scope) => os.SleepExpired(10), deadline: 5000 * task.MS)
    println("short sleep cut: ${d}")
    // 期限の無い Sleep
    println("no deadline cut: ${os.SleepExpired(20)}")
    // 子8本が期限100 msのscopeの中でそれぞれ1時間スリープする — 全部が期限でウェイクアップする（子は期限を継ぐ）
    n, _ := task.Run((s task.Scope) => {
        mut hs := mut []task.Handle[bool]{}
        mut i := 0
        while i < 8 {
            hs = append(hs, task.Spawn(s, () => os.SleepExpired(3600000)))
            i += 1
        }
        mut k := 0
        for v <- task.Gather(hs) {
            if v {
                k += 1
            }
        }
        k
    }, deadline: 100 * task.MS)
    println("children cut: ${n}")
    // 期限の外の Sleep(0) と負の値は待たない
    os.Sleep(0)
    os.Sleep(-5)
    println("done")
}
