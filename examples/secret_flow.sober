package main

// 秘密の値の流れ（language.md 13 節の補 2）: 源（`@secret` の仮引数・欄・const）から届いた値は算術・シフト・比較・変換で運ばれ、
// 分岐・添字・除算に届かなければ受理する。len は公開・mut の仮引数へ書いた値は呼び手の実引数へ戻る

import "std/iter"

type Key struct {
    id int
    k []byte @secret
}

// x が 0 なら 0、それ以外なら -1 の mask（シフトの量は sink でない）
func nonZero(x int) int {
    return (x | -x) >> 63
}

// m が -1 なら a、0 なら b
func sel(m int, a int, b int) int {
    return (a & m) | (b & ^m)
}

// k の全バイトの xor を out の末尾へ積む（mut の仮引数 — 呼び手の out も秘密になる）
@secret(k)
func fold(k []byte, out mut []int) {
    mut acc := 0
    for i <- iter.Range(0, len(k)) {
        acc = acc ^ int(k[i])
    }
    out = append(out, acc)
}

func main() {
    key := Key{id: 7, k: []byte{3, 5, 6, 9}}
    mut out := mut []int{}
    fold(key.k, mut out)
    m := nonZero(out[0])
    r := sel(m, 1, 2)
    // 秘密から導いた値の印字は sink でない（時間の網の外）
    println(r)
    // 公開の欄の分岐は受理
    if key.id > 3 {
        println(len(key.k))
    }
}
