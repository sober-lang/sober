package main

// 段 6 P3b-5: handle の slice と par.Gather（正準順 = 生んだ順で待つ fan-in）。handle は mut slice に積む
// （`mut hs := mut []par.Task[T]{}` — 要素の型は囲む scope の region の handle）。Gather は Join の列（死んだ子があれば呼び手も死ぬ）

import "std/par"

func work(n int) int {
    return n * n
}

func label(n int) string {
    return "t${n}"
}

// sumSquares は関数の本体の scope で Gather する
func sumSquares(n int) int {
    r, e := par.Scope((s par.S) => {
        mut hs := mut []par.Task[int]{}
        mut i := 0
        while i < n {
            k := i
            hs = append(hs, par.Spawn(s, () => work(k)))
            i += 1
        }
        vs := par.Gather(hs)
        mut acc := 0
        mut j := 0
        while j < len(vs) {
            acc += vs[j]
            j += 1
        }
        acc
    })
    return r
}

func main() {
    println(sumSquares(5))
    // string の結果（子の region から scope の region へ写る）・生んだ順に並ぶ
    r, e := par.Scope((s par.S) => {
        mut hs := mut []par.Task[string]{}
        mut i := 3
        while i > 0 {
            k := i
            hs = append(hs, par.Spawn(s, () => label(k)))
            i -= 1
        }
        vs := par.Gather(hs)
        "${vs[0]} ${vs[1]} ${vs[2]} (${len(vs)})"
    })
    println(r)
    // 同じ handle を 2 度（Join は冪等）・空の列
    r2, e2 := par.Scope((s par.S) => {
        mut hs := mut []par.Task[int]{}
        none := par.Gather(hs)
        hs = append(hs, par.Spawn(s, () => work(7)))
        hs = append(hs, hs[0])
        vs := par.Gather(hs)
        ws := par.Gather(hs)
        vs[0] + vs[1] + ws[1] + len(none)
    })
    println(r2)
}
