package main

// pool.Scratchの狭いワードのインターフェース（region-domain-pool.md 4d節）: ワードの列を16 / 32ビットの項目の列と見て読み書きする。添字は項目の単位・容量はワードのまま
// （容量4ワード = 16ビットの項目16個 = 32ビットの項目8個）。項目はワードの中に little endian で並び、書きは値の下位だけを残す。
// 64ビットのLoadRawと同じScratchで混ぜてよい（ここでは同じワードを両方の目で読んで並びを見せる）

import "std/iter"
import "std/pool"

// bの各バイトの出現の数を16ビットの項目の表に数える（表 = 256項目 = 64ワード）
func count(t mut pool.Scratch, b []byte) {
    for i <- iter.Range(0, len(b)) {
        k := int(b[i])
        pool.StoreRaw16(mut t, k, pool.LoadRaw16(mut t, k) + 1)
    }
}

func main() {
    mut s := pool.Scratch{}
    pool.NewScratch(mut s, 4)
    for i <- iter.Range(0, 16) {
        pool.StoreRaw16(mut s, i, i * 4099)
    }
    // 4099 × 15 = 61485 は 16 ビットに収まる・下位だけ残る書き
    pool.StoreRaw16(mut s, 1, 70000)
    println("${pool.LoadRaw16(mut s, 1)} ${pool.LoadRaw16(mut s, 15)}")
    // ワード0 = 項目0〜3の並び（項目0が最下位の16ビット）
    println("${pool.LoadRaw(mut s, 0)}")
    // 同じワードを32ビットの項目の目で: 項目0 = 16ビットの項目0 ‖ 1
    println("${pool.LoadRaw32(mut s, 0)} ${pool.LoadRaw32(mut s, 1)}")
    pool.StoreRaw32(mut s, 7, 4294967295 + 6)
    println("${pool.LoadRaw32(mut s, 7)} ${pool.LoadRaw16(mut s, 14)} ${pool.LoadRaw16(mut s, 15)}")

    mut t := pool.Scratch{}
    pool.NewScratch(mut t, 64)
    count(mut t, bytes("abracadabra"))
    println("a=${pool.LoadRaw16(mut t, 97)} b=${pool.LoadRaw16(mut t, 98)} r=${pool.LoadRaw16(mut t, 114)} z=${pool.LoadRaw16(mut t, 122)}")
}
