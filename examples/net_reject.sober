package main

// net 段 4a-3（N2 — reject）: Serve の admission はプールの節 1 つ（天井 = conns × budget）+ 接続ごとの SpawnIn。入れなければ reject の定数の
// バイト列を 1 回送って閉じる（利用者のコードは走らせない）。conns: 1 で 1 本目の接続が handler の中にいる間に 2 本目を Dial する —
// 2 本目は "busy" を受けて閉じられ、台帳の shed が 1 つ数えられる（決定的: 1 本目は戻りを受けるまで handler の中にいる）

import "std/io"
import "std/net"
import "std/task"
import "std/strings"

func show(e error?) string {
    return switch e {
    case nil: "ok"
    case io.Timeout{}: "timeout"
    case io.Expired{}: "expired"
    case io.Closed{}: "closed"
    case io.Denied{}: "denied"
    case io.Other{errno}: "errno ${errno}"
    case net.Bad{}: "bad"
    case strings.InvalidUtf8{}: "invalid utf8"
    }
}

// echo は接続 1 本の handler（失敗は Serve が吸収する）
func echo(c net.Conn) error? {
    for chunk <- net.Recv(c)? {
        net.Send(c, chunk)?
    }
    return nil
}

func main() {
    println(run() catch "listen failed")
    println("shed: ${task.Ledger().shed}")
}

func run() (string, error?) {
    mut out := ""
    for l <- net.Listen("127.0.0.1:0")? {
        port := net.Port(l)
        r, _ := task.Run((s task.Scope) => {
            x := task.Spawn(s, () => client(port))
            sv, _ := task.Run((s2 task.Scope) => show(net.Serve(l, echo, budget: 64 * task.KB, conns: 1, reject: "busy\n")), deadline: 300 * task.MS)
            "serve: ${sv}\n${task.Join(x)}"
        }, deadline: 10000 * task.MS)
        out = r
    }
    return out, nil
}

func client(port int) string {
    v, e := both(port)
    return if e == nil { v } else { show(e) }
}

// both は 1 本目で "a" を往復させてから（handler の中にいる間に）2 本目を Dial し、2 本目が受けた全部を返す
func both(port int) (string, error?) {
    mut first := ""
    mut second := mut []byte{}
    for a <- net.Dial("127.0.0.1:${port}")? {
        net.Send(a, bytes("a"))?
        for chunk <- net.Recv(a)? {
            first = string(chunk)?
            break
        }
        for b <- net.Dial("127.0.0.1:${port}")? {
            for chunk <- net.Recv(b)? {
                for x <- chunk {
                    second = append(second, x)
                }
            }
        }
    }
    return "first: ${first} / second: ${string(freeze(second))?}", nil
}
