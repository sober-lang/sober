package main

// 段 6 P3b: 容量 1 のチャネルで親子が交互に待ちながら、両側が自分の region に確保する（中断した task の region に他の task が入らない — R1' の網）

import "std/par"

func build(n int) []int {
    mut xs := mut []int{}
    mut i := 0
    while i < n {
        xs = append(xs, i * 7)
        i += 1
    }
    return freeze(xs)
}

func total(xs []int) int {
    mut s := 0
    for x <- xs {
        s += x
    }
    return s
}

func main() {
    r, e := par.Scope((s par.S) => {
        tx, rx := par.NewChan[int](cap: 1)
        h := par.Spawn(s, (out) => {
            mut acc := 0
            mut k := 0
            while k < 6 {
                ys := build(k + 3)
                par.Send(out, total(ys))
                zs := build(k + 10)
                acc += total(zs) - total(ys)
                k += 1
            }
            acc
        }, give: tx)
        mut got := 0
        mut j := 0
        while j < 6 {
            ws := build(j + 50)
            v := par.Recv(rx)
            if v != nil {
                got += v + total(ws) - total(build(j + 50))
            }
            j += 1
        }
        got * 1000 + par.Join(h)
    })
    println(r)
}
