package main

// http.server.ServeWithのput:（省略可の匿名関数型 — language.md 25 節Z）: 送りを2段階にする — 受けた切片1つ分のレスポンスをputで積み（送らない）、積んだ分はrecvが
// 次の受けを待つ前に送る約束（tls.Recvは切片1つを配り終えるたびにtls.Flushする）。sendはその場で送るインターフェースで、streamのレスポンス（前のレスポンスと頭・
// emit ごと）だけが使う。ここでは偽の転送路で、積み・送り・flush の順を印字する
// （TLS の接続なら `(k) => tls.Recv(c, k)`・`(b) => tls.Send(c, b)`・`put: (b) => tls.Put(c, b)`）

import "std/http/server"

func route(r http.server.Request) http.server.Response {
    if r.path == "/stream" {
        return http.server.Response{status: 200, contentType: "text/plain", length: 12, stream: (out, emit) => twice(mut out, emit)}
    }
    return http.server.Text("hello\n")
}

func twice(out mut http.server.Out, emit func(out mut http.server.Out, b []byte) error?) error? {
    emit(mut out, bytes("chunk\n"))?
    return emit(mut out, bytes("chunk\n"))
}

// 切片 1 つを k に渡し、戻ったら積んだ分を送る（tls.Recv の約束の形）
func feed(s string, k func([]byte)) error? {
    k(bytes(s))
    println("flush")
    return nil
}

func say(what string, b []byte) error? {
    println("${what} [${len(b)} bytes]")
    return nil
}

func main() {
    reqs := "GET / HTTP/1.1\r\nHost: x\r\n\r\nGET / HTTP/1.1\r\nHost: x\r\n\r\n"
    reqs2 := "GET / HTTP/1.1\r\nHost: x\r\n\r\nGET /stream HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"
    e := http.server.ServeWith((k) => feed(reqs, k), (b) => say("send", b), route, put: (b) => say("put", b))
    println(e == nil)
    e2 := http.server.ServeWith((k) => feed(reqs2, k), (b) => say("send", b), route, put: (b) => say("put", b))
    println(e2 == nil)
}
