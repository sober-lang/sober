package main

// 値位置のswitchの分岐のregionの合流: 仮引数のregion（呼び手）のstring / structと、
// 本体のリテラルを同じswitchで合流させる。脱糖器はif式と同じく、全分岐を最内のregionの型へannで緩める

type Item struct {
    name string
    n int
}

func same(v string, k int) string {
    return switch k { case 0: v; default: v }
}

func orLit(v string, k int) string {
    x := switch k { case 0: v; case 1: "one"; default: "many" }
    return x
}

func item(v string, k int) Item {
    return switch k { case 0: Item{name: v, n: 0}; default: Item{name: "z", n: k} }
}

func main() {
    println(same("p", 0), same("q", 3))
    println(orLit("given", 0), orLit("given", 1), orLit("given", 2))
    a := item("v", 0)
    b := item("v", 5)
    println(a.name, a.n, b.name, b.n)
}
