package main

// @layoutの固定長配列のフィールドに長さ違いの値を書くとpanic（language.md 36 節Y2 — exit 101）

import "std/builder"
import "std/layout"

@layout
type H struct {
    k u16le
    s i8
    a [2]u8
}

func main() {
    mut out := builder.Builder[byte]{}
    layout.Encode[H](mut out, H{k: 1, s: 0, a: bytes("ok")})
    println(builder.Len(mut out))
    layout.Encode[H](mut out, H{k: 1, s: 0, a: bytes("abc")})
    println("unreachable")
}
