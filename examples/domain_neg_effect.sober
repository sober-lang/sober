package main

// domainの本体はエフェクトなし（待たない・ioなし・nondetなし・明示のpanicなし — domainを持ったまま走る）: 本体の中のprintln（io）は拒否

import "std/task"

type Hits struct {
    n int
}

func main() {
    r, e := task.Run((s task.Scope) => {
        d := task.NewDomain(s, Hits{n: 0})
        task.Update(d, (st mut Hits) => {
            st.n += 1
            println(st.n)
            st.n
        })
    })
    println(r)
}
