package main

// domain の本体は効果なし（待たない・io なし・nondet なし・明示の panic なし — domain を持ったまま走る）: 本体の中の println（io）は拒否

import "std/task"

type Hits struct {
    n int
}

func main() {
    r, e := task.Run((s task.Scope) => {
        d := task.NewDomain(s, Hits{n: 0})
        task.Update(d, (st mut Hits) => {
            st.n += 1
            println(st.n)
            st.n
        })
    })
    println(r)
}
