package main

// TLS 1.3 のサーバ（std/tls — language.md 28 節の tls）: tls.Serve が handshake を済ませた接続だけを k に渡し、k は tls.Recv / tls.Send で
// net.Conn と同じ顔に読み書きする（ここでは echo）。既定の走りは設定の網（Parse の成功・ALPN の替え・壊れた PEM・鍵でない塊 — switch はラベルを網羅）。
// `tls_serve live <port>` は 127.0.0.1:<port> で待ち受ける（`live-once` は break の後の Recv を見る once）（openssl s_client で HRR・ChaCha20・KeyUpdate の受けを確かめる口）

import "std/crypto/pem"
import "std/crypto/rsa"
import "std/os"
import "std/tls"

@embed("testdata/crypto/httparena-server.*")
const Certs = map[string]string{}

func file(p string) string {
    v := Certs[p]
    return if v != nil { v } else { "" }
}

func echo(c tls.Conn) error? {
    for b <- tls.Recv(c)? {
        tls.Send(c, b)?
    }
    return nil
}

// 1 回だけ echo して break し、2 度目の tls.Recv の返しを送る（break で抜けた後の読みは終わり — Closed。net.Conn と顔が違う唯一の点）
func once(c tls.Conn) error? {
    for b <- tls.Recv(c)? {
        tls.Send(c, b)?
        break
    }
    return tls.Send(c, bytes("second recv: ${recvShow(tls.Recv(c, (b) => { }))}\n"))
}

func recvShow(e error?) string {
    return switch e {
        case nil: "nil"
        case tls.Closed{}: "closed"
        case tls.BadRecord{}: "bad record"
    }
}

func show(e error?) string {
    return switch e {
        case nil: "ok"
        case pem.Bad{}: "bad pem"
        case rsa.BadKey{}: "bad key"
    }
}

func main() int {
    crt := file("testdata/crypto/httparena-server.crt")
    key := file("testdata/crypto/httparena-server.key")
    cfg, e := tls.Parse(crt, key)
    println("parse: ${show(e)}")
    _, e2 := tls.Parse("-----BEGIN CERTIFICATE-----\n!!!\n-----END CERTIFICATE-----\n", key)
    println("broken pem: ${show(e2)}")
    _, e3 := tls.Parse(crt, crt)
    println("cert as key: ${show(e3)}")
    _, e4 := tls.Parse("no pem here", key)
    println("no certificate: ${show(e4)}")
    args, _ := os.Args()
    if len(args) >= 3 && args[1] == "live" {
        e5 := tls.Serve("127.0.0.1:${args[2]}", tls.Alpn(cfg, []string{"http/1.1"}), echo)
        return if e5 == nil { 0 } else { 1 }
    }
    if len(args) >= 3 && args[1] == "live-once" {
        e6 := tls.Serve("127.0.0.1:${args[2]}", cfg, once)
        return if e6 == nil { 0 } else { 1 }
    }
    return 0
}
