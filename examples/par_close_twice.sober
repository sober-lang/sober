package main

// 段 6 P3b-4 ③: 閉じた送り端をもう一度閉じると定義された panic（close of closed channel）

import "std/par"

func main() {
    r, e := par.Scope((s par.S) => {
        tx, rx := par.NewChan[int](cap: 1)
        par.Close(tx)
        v := par.Recv(rx)
        println(if v == nil { "nil" } else { "?" })
        par.Close(tx)
        0
    })
    if e != nil {
        println("err")
    }
    println(r)
}
