package main

// 負例（checkが拒否 — analyzer）: 秘密の値がprint.Logの記録のフィールドに届く（ログはプログラムの外へ出る出力）。拒否は届いたフィールドを示す

import "std/print"

type Login struct {
    user string
    key string
}

@secret(key)
func audit(user string, key string) {
    print.Log[Login](Login{user: user, key: key})
}

func main() {
    audit("ann", "s3cret")
}
