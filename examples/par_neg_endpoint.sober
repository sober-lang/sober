package main

// 段 6 P3b: 端点を give: でなく捕獲で子へ渡す（diag.Par kind 15 — check と build が同じ拒否。desugar/parcheck.sober）

import "std/par"

func main() {
    r, e := par.Scope((s par.S) => {
        tx, rx := par.NewChan[int](cap: 1)
        h := par.Spawn(s, () => {
            par.Send(tx, 1)
            1
        })
        par.Join(h)
    })
    println(r)
}
