package main

// 負例: File は struct・slice・map・チャネルに入れられない（diag.FileUse — desugar/filecheck・language.md 28 節「資源とストリーム」）

import "std/io"

type Src struct {
    name string
    f io.File
}

func main() {
    f := io.Open("testdata/io/hello.txt") catch return
    defer io.Close(f)
    s := Src{name: "hello", f: f}
    println(s.name)
}
