package main

// 借りの関数値を、それを格納して返す関数へ渡せない（(α-L0)）。借りの位置の安全は呼び先の本体で決まる。keepは仮引数をフィールドに入れて返すので、借りの位置でない

type Stream func(emit func(n int) int) int

type Resp struct {
    stream Stream?
}

type Box struct {
    f func(n int) int
}

func keep(k func(n int) int) Box { return Box{f: k} }

func main() {
    r := Resp{stream: (emit) => keep(emit).f(1)}
    st := r.stream
    if st != nil { println(st((n int) => n)) }
}
