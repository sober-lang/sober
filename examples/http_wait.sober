package main

// Serveの期限（http.server.ServeConnのheadWait:）: リクエストの頭が揃うまでの上限。keep-aliveの待ちも同じ期限で数える。
// 期限が来たら、待っていた受けがio.Timeoutで戻り、ServeConnが返って接続が閉じる（相手には何も送らない）。
// 1本目はリクエストを1件送ってレスポンスを読んだ後、次のリクエストを送らずに待つ。期限で閉じられる。
// 2本目は何も送らない。期限で閉じられる。数えるのはServeのプールの節のtimeout（接続ごとに1回）

import "std/http/server"
import "std/io"
import "std/net"
import "std/task"

func show(e error?) string {
    return switch e {
    case nil: "ok"
    case io.Timeout{}: "timeout"
    case io.Expired{}: "expired"
    case io.Closed{}: "closed"
    case io.Denied{}: "denied"
    case io.Other{errno}: "errno ${errno}"
    }
}

func route(r http.server.Request) http.server.Response {
    return http.server.Text("ok\n")
}

func app(c net.Conn) error? {
    return http.server.ServeConn(c, route, headWait: 500 * task.MS)
}

func main() {
    println(run() catch "listen failed")
    mut n := 0
    for p <- task.Ledger().pools {
        n += p.timeout
    }
    println("timeout: ${n}")
}

func run() (string, error?) {
    mut out := ""
    for l <- net.Listen("127.0.0.1:0")? {
        port := net.Port(l)
        r, _ := task.Run((s task.Scope) => {
            x := task.Spawn(s, () => keepAlive(port) catch "keep-alive: failed")
            y := task.Spawn(s, () => idle(port) catch "idle: failed")
            sv, _ := task.Run((s2 task.Scope) => show(net.Serve(l, app)), deadline: 4000 * task.MS)
            "serve: ${sv}\n${task.Join(x)}\n${task.Join(y)}"
        }, deadline: 20000 * task.MS)
        out = r
    }
    return out, nil
}

// リクエストを1件送り、相手が閉じるまで受ける（レスポンスを読んだかを返す）
func keepAlive(port int) (string, error?) {
    mut n := 0
    for c <- net.Dial("127.0.0.1:${port}")? {
        net.Send(c, bytes("GET / HTTP/1.1\r\nHost: x\r\n\r\n"))?
        for chunk <- net.Recv(c)? {
            n += len(chunk)
        }
    }
    return "keep-alive: response ${if n > 0 { "read" } else { "missing" }}, then closed by the server", nil
}

func idle(port int) (string, error?) {
    mut n := 0
    for c <- net.Dial("127.0.0.1:${port}")? {
        for chunk <- net.Recv(c)? {
            n += len(chunk)
        }
    }
    return "idle: closed by the server after ${n} bytes", nil
}
