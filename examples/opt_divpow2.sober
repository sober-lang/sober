package main

// 2 のべき乗の定数での div / rem（idiv をシフト列に）の回帰例: 負の数は 0 への切り捨て（rem の符号は被除数）・
// 境界の値（最小値・最大値）と 2^1 / 2^3 / 2^13 / 2^31

import "std/iter"

func main() {
    xs := []int{0, 1, -1, 7, -7, 8, -8, 9, -9, 8191, -8191, 8192, -8192, 8193, -8193, 9223372036854775807, -9223372036854775807 - 1, 2147483647, -2147483648, 4294967296, -4294967297}
    for i <- iter.Range(0, len(xs)) {
        x := xs[i]
        println("${x}: ${x / 2} ${x % 2} ${x / 8} ${x % 8} ${x / 8192} ${x % 8192} ${x / 2147483648} ${x % 2147483648}")
    }
}
