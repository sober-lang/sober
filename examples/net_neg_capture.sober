package main

// 負例: 子taskのクロージャはListenerを捕獲できない（forの本体を抜けるとstdが閉じる — 子が閉じたfdか再利用された番号を見る）。
// task.Run の本体の lambda への捕獲は許す（N6）が、その中の Spawn の g は今どおり拒否（diag.FileUse — desugar/filecheck・language.md 28 節の net）

import "std/net"
import "std/task"

func main() {
    _ = run()
}

func run() error? {
    for l <- net.Listen("127.0.0.1:0")? {
        r, err := task.Run((s task.Scope) => {
            h := task.Spawn(s, () => net.Port(l))
            task.Join(h)
        })
        println(r)
    }
    return nil
}
