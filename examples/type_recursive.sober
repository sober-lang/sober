package main

// 再帰の型宣言（D — slice の要素の位置を通る再帰）: JSON の値の形の union。値は木で、構築は下から・分解は switch

type Value union {
    Null {}
    Num { n int }
    Arr { xs []Value }
}

func sum(v Value) int {
    return switch v {
    case Arr{xs}: {
        mut s := 0
        for x <- xs {
            s += sum(x)
        }
        s
    }
    case Num{n}: n
    default: 0
    }
}

func main() {
    v := Arr{xs: []Value{Num{n: 1}, Null{}, Arr{xs: []Value{Num{n: 2}, Num{n: 3}}}}}
    println(sum(v))
}
