package main

// Clinger の速い道の境界（2^53 の際・指数 22 / 23 の際・負のゼロ・桁の多い 0 — scripts/oracles/float_clinger.go の Go の答えと照合）

import "std/conv"
import "std/math"
import "std/io"

func main() int {
    b := io.ReadStdin() catch return 1
    mut i := 0
    while i < len(b) {
        s := i
        while b[i] != '\n' {
            i += 1
        }
        t, terr := string(b[s:i])
        f, err := conv.ParseFloat(t)
        v := math.Bits(f)
        st := switch err {
        case nil: 0
        case conv.InvalidFloat{}: 1
        default: 2
        }
        println(if st == 1 { 0 } else { v }, st)
        i += 1
    }
    return 0
}
