package main

// 段 6 P5-2 入口: struct の欄に包んだ端点の捕獲（diag.Par kind 15） — check と build が同じ名指しで拒否（desugar/parcheck.sober）。縮退の前提「縮退した子が待てるのは自分の子孫だけ」の柵

import "std/task"

type W struct {
    rx task.Receiver[int]
}

func main() {
    r, e := task.Run((s task.Scope) => {
        tx, rx := task.NewChannel[int](cap: 1)
        w := W{rx: rx}
        h := task.Spawn(s, () => {
            v := task.Recv(w.rx)
            if v != nil { v } else { 0 }
        })
        task.Send(tx, 3)
        task.Join(h)
    })
    println(r)
}
