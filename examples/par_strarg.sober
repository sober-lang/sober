package main

// 段 6 P3a: Spawn の子の中で string リテラルを関数の実引数に（コアは呼び手空間の上界〔region 0〕に置くが、子は共有の接頭に確保できない —
// 子の中は子自前の region へ。desugar の taskFloor — progen --par の fuzz で発見した check の誤拒否の回帰）

import "std/par"

func g(s string) int {
    return len(bytes(s))
}

func h(s string) (int, error?) {
    return len(bytes(s)) * 10, nil
}

func main() {
    r, e := par.Scope((s par.S) => par.Join(par.Spawn(s, () => g("abc") + (h("de") catch -1))))
    println(r)
}
