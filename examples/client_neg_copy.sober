package main

// 負例: http.client.Session は写せない（同一性の型 — 接続の状態〔TLS の鍵と番号〕は値の外の置き場に住むので、写しが別の値の顔をすると
// 二つの写しが同じ番号で別の平文を封じうる。diag.FileUse — desugar/filecheck・language.md 28 節の HTTP クライアント）

import "std/http/client"

func main() {
    _ = http.client.Open("http://127.0.0.1:9", (s) => {
        d := s
        _, _ = http.client.Send(d, "/")
    })
}
