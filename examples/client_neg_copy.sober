package main

// 負例: http.client.Sessionはコピーできない（同一性の型 — 接続の状態〔TLSの鍵と番号〕は値の外の格納場所に住むので、コピーが別の値の顔をすると
// 二つのコピーが同じ番号で別の平文を封じうる。diag.FileUse — desugar/filecheck・language.md 28 節のHTTPクライアント）

import "std/http/client"

func main() {
    _ = http.client.Open("http://127.0.0.1:9", (s) => {
        d := s
        _, _ = http.client.Send(d, "/")
    })
}
