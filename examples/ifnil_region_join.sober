package main

// flow typing のif（ifnil）の分岐のregionの合流の検証例: `T?` の仮引数を絞った中身（呼び手のregion）と
// 本体のリテラルを同じifで合流させる。脱糖器は素のif（if_region_join）と同じく、両分岐を最内のregionの型へannで緩める

func sepOr(sep string?) string {
    s := if sep != nil { sep } else { " " }
    return s
}

func orDefault(sep string?) string {
    return if sep == nil { "-" } else { sep }
}

func main() {
    println(sepOr(","), sepOr(nil), orDefault("x"), orDefault(nil))
}
