package main

// 借りの関数値はtask.Spawnの子に捕捉させられない（(α-L0) — 借りのクロージャは同一性の型〔Conn〕を運びうる・子taskから叩く形は同一性の1 taskの破れ）

import "std/task"

type Stream func(emit func(n int) int) int

type Resp struct {
    stream Stream?
}

func main() {
    r := Resp{stream: (emit) => run1(emit)}
    st := r.stream
    if st != nil { println(st((n int) => n)) }
}

func run1(k func(n int) int) int {
    v, _ := task.Run((s task.Scope) => task.Join(task.Spawn(s, () => k(1))))
    return v
}
