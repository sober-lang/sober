package main

// 借りの仮引数の mut の席へ渡せるのは mut ローカルと mut 仮引数: mut 仮引数 z（割った struct — 欄ごとのセル）と n（int の ref）を
// それぞれ別の値の呼び出しの mut の席へ渡す

type Z struct {
    acc mut []byte
    n int
}

type SZ func(z mut Z, emit func(z mut Z, b []byte) error?) error?

type SN func(n mut int, emit func(n mut int, b []byte) error?) error?

func fill(z mut Z, n mut int, sz SZ, sn SN) {
    e := sz(mut z, (y, b) => {
        y.acc = append(y.acc, b[0])
        y.n += len(b)
        nil
    })
    if e != nil { z.n = -1 }
    f := sn(mut n, (c, b) => { c += 1; nil })
    if f != nil { n = -1 }
}

func twoZ(z mut Z, emit func(z mut Z, b []byte) error?) error? {
    emit(mut z, bytes("abc"))?
    return emit(mut z, bytes("de"))
}

func twoN(n mut int, emit func(n mut int, b []byte) error?) error? {
    emit(mut n, bytes("abc"))?
    return emit(mut n, bytes("de"))
}

func main() {
    mut z := Z{acc: mut []byte{}, n: 0}
    mut n := 0
    fill(mut z, mut n, twoZ, twoN)
    println(z.n * 100 + len(z.acc))
    println(n)
}
