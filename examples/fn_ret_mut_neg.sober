package main

// 負例（checkもbuildも拒否）: mutの仮引数を持たない関数は、mutの中身（mutのslice / map — structのフィールドの中も）を持つ値を返せない（language.md 26 節）。
// 作るのは呼び手のゼロ値リテラル（`mut e := Eng{}`）

import "std/table"

type Eng struct {
    sets table.Table[int]
    n int
}

func newEng() Eng {
    return Eng{sets: table.Table[int]{}, n: 0}
}

func main() {
    mut e := newEng()
    table.Push(mut e.sets, 3)
    println(table.Get(mut e.sets, 0))
}
