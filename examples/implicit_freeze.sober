package main

// 暗黙の freeze（language.md 17 節 — 2026-10-11）: 期待型が imm のコンテナの位置に mut のコンテナの道を置くと freeze(道) と同じ。
// 位置の全種（実引数・総称の実引数・composite の欄・slice / map のリテラルの要素・append の要素・添字 / map への格納・imm の場所への代入・return・for の生成元〔2026-10-13〕）。
// 明示の freeze を残した同じプログラムは testdata/implicitfreeze/positions.sober（暗黙 ≡ 明示のオラクルの入力）

import "std/iter"
import "std/strings"

type H struct {
    xs []int
    ys mut []int
}

type B struct {
    xs []int
}

func total(xs []int) int {
    mut s := 0
    for x <- xs {
        s += x
    }
    return s
}

func first[T](xs []T) T {
    return xs[0]
}

func build(n int) []int {
    mut out := mut []int{}
    for i <- iter.Range(0, n) {
        out = append(out, i)
    }
    return out
}

func count(m map[string]int) int {
    return len(m)
}

func main() int {
    mut a := mut []int{1, 2, 3}
    a[0] = 5
    t := total(a)
    mut b := mut []int{7}
    f := first(b)
    mut c := mut []int{4}
    h := H{xs: c, ys: mut []int{0}}
    h.ys[0] = 9
    mut d := mut []int{6}
    bb := B{xs: d}
    mut e := mut []int{8}
    ls := [][]int{e}
    mut g := mut []int{3}
    mm := map[string][]int{"g": g}
    mut k := mut []int{2}
    mut keep := mut [][]int{}
    keep = append(keep, k)
    mut p := mut []int{1}
    mut ys := mut [][]int{[]int{}}
    ys[0] = p
    mut q := mut []int{0}
    mut store := mut map[string][]int{}
    store["q"] = q
    mut r := mut []int{11}
    mut im := []int{}
    im = r
    mut mp := mut map[string]int{}
    mp["z"] = 1
    n := count(mp)
    mut w := mut []int{5}
    w = append(w, 6)
    mut ws := 0
    for x <- w {
        ws += x
    }
    sum := total(build(4))
    s := strings.Join([]string{"x"}, ",")
    println("${t} ${f} ${h.xs[0]} ${h.ys[0]} ${bb.xs[0]} ${ls[0][0]} ${len(mm)} ${keep[0][0]} ${ys[0][0]} ${len(store)} ${im[0]} ${n} ${sum} ${s} ${ws}")
    return 0
}
