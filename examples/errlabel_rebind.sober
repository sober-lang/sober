package main

// 回帰例（language.md 13 / 32 節）: error ラベルは型として使えず、ラベルのリテラルの値は組み込みの error。
// ラベルのリテラルで束縛した名前には別のラベルも入る（同形の別ラベルも — 区別は型パターンのタグ）。
// 同じラベルへの再代入も通ることを確かめる（束縛を閉じた error の union〔ERRS〕の表層型をラベルの型宣言と読み違えないこと）

type NotFound error { id int }
type Gone error { id int }

func tag(e error) int {
    return switch e {
    case Gone{id}: id
    case NotFound{id}: id + 100
    }
}

func main() {
    mut e := Gone{id: 2}
    println(tag(e))
    e = Gone{id: 1}
    println(tag(e))
    e = NotFound{id: 3}
    println(tag(e))
    g := NotFound{id: 4}
    mut f := g
    f = Gone{id: 5}
    println(tag(f) + tag(g))
}
