package main

// 回帰例（language.md 13 / 32 節）: error ラベルは型として使えず、ラベルのリテラルの値は組み込みの error。
// ラベルのリテラルで束縛した名前には別のラベルも入る（同形の別ラベルも — 区別は型パターンのタグ）。
// S-b 段 1 の表層型が束縛を閉じた error の union（ERRS）、リテラルをラベルの型宣言と読み違え、同じラベルの再代入まで check が拒否していた

type NotFound error { id int }
type Gone error { id int }

func tag(e error) int {
    return switch e {
    case Gone{id}: id
    case NotFound{id}: id + 100
    }
}

func main() {
    mut e := Gone{id: 2}
    println(tag(e))
    e = Gone{id: 1}
    println(tag(e))
    e = NotFound{id: 3}
    println(tag(e))
    g := NotFound{id: 4}
    mut f := g
    f = Gone{id: 5}
    println(tag(f) + tag(g))
}
