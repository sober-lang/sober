package main

// 借りの仮引数の mut の席の第一顧客の縮図（std/http の serveBuf の形）: 送りの状態 z（圧縮器の状態の代役 — 溜めの slice + 数）は呼び手が持ち、
// stream が emit に mut で渡し回す。送り先 send は展開待ちの捕捉（(α-L0) の borrow_pend の形）・入れ子の展開ラムダの中から呼ぶ。期待の出力 505

type Z struct {
    acc mut []byte
    n int
}

type Stream func(z mut Z, emit func(z mut Z, b []byte) error?) error?

func feed(z mut Z, p []byte, out func(q []byte) error?) error? {
    for c <- p {
        z.acc = append(z.acc, c)
    }
    z.n += len(p)
    return out(p)
}

func serveBuf(send func(b []byte) error?, st Stream) int {
    mut z := Z{acc: mut []byte{}, n: 0}
    e := st(mut z, (y, p) => feed(mut y, p, (q) => send(q)))
    if e != nil { return -1 }
    return z.n * 100 + len(z.acc)
}

func two(z mut Z, emit func(z mut Z, b []byte) error?) error? {
    emit(mut z, bytes("abc"))?
    return emit(mut z, bytes("de"))
}

func main() {
    println(serveBuf((b []byte) => nil, two))
}
