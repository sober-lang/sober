package main

// 負例（diag.Par kind 7 — check と build が同じ文面）: par.Spawn の g の中の `?`。本体の `?` = scope の失敗は scope の本体だけ
// （language.md 11 節「本体の `?`」— 子の失敗は g の結果 `(T, error?)` で書く）

import "std/par"

type Bad error {}

func get(n int) (int, error?) {
    return 0, Bad{}
}

func main() {
    r, e := par.Scope((s par.S) => {
        h := par.Spawn(s, () => {
            v := get(1)?
            v + 1
        })
        par.Join(h)
    })
    println(r)
}
