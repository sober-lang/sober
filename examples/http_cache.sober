package main

// 保存の方針と認証の源（language.md 12 節・28 節）: レスポンスのCache-Controlの既定はprivate（共有キャッシュに載せない）・
// レスポンス1件の方針はPrivate / NoStore・共有キャッシュも保存してよい方針（Fresh）はルートの行で書く（Dispatchがcacheの無いレスポンスに反映する — レスポンスの方針が勝つ）。
// 認証のヘッダ（Authorization・Cookie）は専用の API http.server.Authorization / http.server.Cookieでだけ読める（http.server.Headerはnil）。
// 保存の方針と検証子の名前（Cache-Control・ETagほか）を任意ヘッダに書くとpanic(BadHeader) — 最後のリクエストがそれで死ぬ（終了101。checkは名前のリテラルを拒否する — checkを通さないbuildの形）。
// ネットの代わりにrecvが決まったリクエストの列を1切片で渡し、sendがレスポンスを印字する（examples/http_routerの形 — 行末のCRは外して印字）

import "std/http"
import "std/http/server"
import "std/net"
import "std/strings"

func or(s string?) string {
    return if s != nil { s } else { "-" }
}

// 認証に届くレスポンス（共有の宣言はしない — 既定のprivateのまま）
func me(r http.server.Request) http.server.Response {
    return http.server.Text("sid=${or(http.server.Cookie(r, "sid"))} auth=${or(http.server.Authorization(r))} header=${or(http.server.Header(r, "cookie"))}\n")
}

// 個人のレスポンスをブラウザに30秒持たせる
func feed(r http.server.Request) http.server.Response {
    return http.server.Response{status: 200, contentType: "text/plain", body: bytes("feed\n"), cache: http.server.Private{maxAge: 30}}
}

// 秘密のレスポンスはどこにも保存させない
func token(r http.server.Request) http.server.Response {
    return http.server.Response{status: 200, contentType: "text/plain", body: bytes("t\n"), cache: http.server.NoStore{}}
}

// 共有の資産（認証を読まない — ルートの行が Fresh を宣言）
func logo(r http.server.Request) http.server.Response {
    return http.server.Text("logo\n")
}

// 方針を文字列で書く（予約名 — panic）
func raw(r http.server.Request) http.server.Response {
    return http.server.Response{status: 200, contentType: "text/plain", body: bytes("raw\n"), headers: http.server.Headers{list: []http.Field{http.Field{name: "cache-control", value: "public, max-age=60"}}}}
}

func show(b []byte) error? {
    mut out := mut []byte{}
    for x <- b {
        if x != '\r' {
            out = append(out, x)
        }
    }
    println(string(freeze(out)) catch "?")
    return nil
}

func main() {
    rs := []http.server.Route{
        http.server.Route{method: "GET", path: "/me", handler: me},
        http.server.Route{method: "GET", path: "/feed", handler: feed},
        http.server.Route{method: "GET", path: "/token", handler: token, cache: http.server.Fresh{maxAge: 60}},
        http.server.Route{method: "GET", path: "/logo", handler: logo, cache: http.server.Fresh{maxAge: 86400, immutable: true}},
        http.server.Route{method: "GET", path: "/raw", handler: raw}}
    reqs := "GET /me HTTP/1.1\r\nHost: x\r\nCookie: theme=dark; sid=\"s-42\"\r\nAuthorization: Bearer abc\r\n\r\n" +
        "GET /me HTTP/1.1\r\nHost: x\r\n\r\n" +
        "GET /feed HTTP/1.1\r\nHost: x\r\n\r\n" +
        "GET /token HTTP/1.1\r\nHost: x\r\n\r\n" +
        "GET /logo HTTP/1.1\r\nHost: x\r\n\r\n" +
        "GET /none HTTP/1.1\r\nHost: x\r\n\r\n"
    e := net.Pair((c) => http.server.ServeConn(c, (r) => http.server.Dispatch(rs, r)), (c) => {
        // 1つ目の切片の要求を送り、その応答を読み終えてから2つ目を送る（2つ目でサーバーが死ぬ前に、1つ目の応答が届く）
        first := reqs
        _ = net.Send(c, bytes(first))
        _ = show(readN(c, strings.Count(first, " HTTP/1.1\r\n")) catch []byte{})
        _ = net.Send(c, bytes("GET /raw HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"))
        _ = show(readAll(c))
    })
    println(e == nil)
}

// 相手が閉じるまで受けたバイト列（最後の要求はConnection: close — サーバーが応答の後に閉じる）
func readAll(c net.Conn) []byte {
    mut got := mut []byte{}
    _ = net.Recv(c, (x) => {
        for y <- x {
            got = append(got, y)
        }
    })
    return freeze(got)
}

// 相手からn件のレスポンス（頭とContent-Lengthの本文）を受け終えるまでのバイト列（1つ目の切片の応答だけを先に読む — 次の要求を送る前に）
func readN(c net.Conn, n int) ([]byte, error?) {
    mut got := mut []byte{}
    mut done := 0
    mut at := 0
    for x <- net.Recv(c)? {
        for y <- x {
            got = append(got, y)
        }
        mut more := true
        while more && done < n {
            h := headEnd(freeze(got), at)
            if h < 0 {
                more = false
            } else {
                end := h + bodyLen(freeze(got), at, h)
                if end > len(got) {
                    more = false
                } else {
                    done += 1
                    at = end
                }
            }
        }
        if done >= n {
            break
        }
    }
    return freeze(got), nil
}

// bのatから始まる頭の終わり（空行の後の位置。無ければ -1）
func headEnd(b []byte, at int) int {
    mut i := at
    while i + 3 < len(b) {
        if b[i] == '\r' && b[i + 1] == '\n' && b[i + 2] == '\r' && b[i + 3] == '\n' {
            return i + 4
        }
        i += 1
    }
    return 0 - 1
}

// bのat〜hの頭のContent-Lengthの値（無ければ0）
func bodyLen(b []byte, at int, h int) int {
    key := bytes("Content-Length: ")
    mut i := at
    while i + len(key) < h {
        mut j := 0
        while j < len(key) && b[i + j] == key[j] {
            j += 1
        }
        if j == len(key) {
            mut v := 0
            mut k := i + j
            while k < h && b[k] >= '0' && b[k] <= '9' {
                v = v * 10 + int(b[k]) - 48
                k += 1
            }
            return v
        }
        i += 1
    }
    return 0
}
