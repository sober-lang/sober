package main

// 展開の宛先の直結: 関数型の仮引数を持つ関数は呼び出し点に展開される。展開の呼び出し点そのものに呼び手の宛先のマークがある
// （ループ・ラムダの外で呼び手のreturnへ流れ着く — `return order(n, f)`）なら、本体のマークつきの確保（`mut ab := mut []int{}`）は呼び手の宛先へ
// 直に作る。展開入口の深度に作ると、呼び手のreturnが結果を呼び手の呼び手のregionへコピーしてしまう（二重のコピー）

func order(n int, key func(int) int) []int {
    mut ab := mut []int{}
    mut i := 0
    while i < n {
        ab = append(ab, key(i))
        i += 1
    }
    return freeze(ab)
}

func neg(x int) int {
    return 100 - x
}

// 展開の呼び出し点がマークつき（returnの式）
func ranks(n int) []int {
    return order(n, neg)
}

func main() int {
    rs := ranks(5)
    for r <- rs {
        println("${r}")
    }
    return 0
}
