package main

// checkを通さずにbuildしたプログラムで、共有キャッシュに保存されうる方針（Fresh）のルートがSet-Cookieを返すと、
// ヘッダを書くときにpanic(BadHeader{name: "Set-Cookie"})になる（checkはこの形を拒否する。language.md 12節「出所の依存」）。
// 前のリクエスト（Privateの行のSet-Cookie）は先に送られる。サーバーとクライアントはnet.Pairで繋ぎ（行末のCRは外して印字）、
// サーバーの死はnet.Pairが呼び手へ伝える（ChildDied — 終了101）

import "std/http/server"
import "std/net"
import "std/strings"

func login(r http.server.Request) http.server.Response {
    return http.server.Response{status: 200, contentType: "text/plain", body: bytes("hi\n"), cookies: []http.server.SetCookie{http.server.SetCookie{name: "sid", value: "s1"}}}
}

func show(b []byte) error? {
    mut out := mut []byte{}
    for x <- b {
        if x != '\r' {
            out = append(out, x)
        }
    }
    println(string(freeze(out)) catch "?")
    return nil
}

func main() {
    rs := []http.server.Route{
        http.server.Route{method: "GET", path: "/private", handler: login, cache: http.server.Private{maxAge: 30}},
        http.server.Route{method: "GET", path: "/cached", handler: login, cache: http.server.Fresh{maxAge: 60}}}
    e := net.Pair((c) => http.server.ServeConn(c, (r) => http.server.Dispatch(rs, r)), (c) => {
        // 1つ目の切片の要求を送り、その応答を読み終えてから2つ目を送る（2つ目でサーバーが死ぬ前に、1つ目の応答が届く）
        first := "GET /private HTTP/1.1\r\nHost: x\r\n\r\n"
        _ = net.Send(c, bytes(first))
        _ = show(readN(c, strings.Count(first, " HTTP/1.1\r\n")) catch []byte{})
        _ = net.Send(c, bytes("GET /cached HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"))
        _ = show(readAll(c))
    })
    println(e == nil)
}

// 相手が閉じるまで受けたバイト列（最後の要求はConnection: close — サーバーが応答の後に閉じる）
func readAll(c net.Conn) []byte {
    mut got := mut []byte{}
    _ = net.Recv(c, (x) => {
        for y <- x {
            got = append(got, y)
        }
    })
    return freeze(got)
}

// 相手からn件のレスポンス（頭とContent-Lengthの本文）を受け終えるまでのバイト列（1つ目の切片の応答だけを先に読む — 次の要求を送る前に）
func readN(c net.Conn, n int) ([]byte, error?) {
    mut got := mut []byte{}
    mut done := 0
    mut at := 0
    for x <- net.Recv(c)? {
        for y <- x {
            got = append(got, y)
        }
        mut more := true
        while more && done < n {
            h := headEnd(freeze(got), at)
            if h < 0 {
                more = false
            } else {
                end := h + bodyLen(freeze(got), at, h)
                if end > len(got) {
                    more = false
                } else {
                    done += 1
                    at = end
                }
            }
        }
        if done >= n {
            break
        }
    }
    return freeze(got), nil
}

// bのatから始まる頭の終わり（空行の後の位置。無ければ -1）
func headEnd(b []byte, at int) int {
    mut i := at
    while i + 3 < len(b) {
        if b[i] == '\r' && b[i + 1] == '\n' && b[i + 2] == '\r' && b[i + 3] == '\n' {
            return i + 4
        }
        i += 1
    }
    return 0 - 1
}

// bのat〜hの頭のContent-Lengthの値（無ければ0）
func bodyLen(b []byte, at int, h int) int {
    key := bytes("Content-Length: ")
    mut i := at
    while i + len(key) < h {
        mut j := 0
        while j < len(key) && b[i + j] == key[j] {
            j += 1
        }
        if j == len(key) {
            mut v := 0
            mut k := i + j
            while k < h && b[k] >= '0' && b[k] <= '9' {
                v = v * 10 + int(b[k]) - 48
                k += 1
            }
            return v
        }
        i += 1
    }
    return 0
}
