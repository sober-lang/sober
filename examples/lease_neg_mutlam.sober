package main

// 負例: ラムダの仮引数の mut の印は関数型の mut の席と合わせる — 関数型が値渡しの席に mut は書けない（diag.FnArg kind 4・language.md 25 節）

import "std/task"
import "std/pool"

type Work struct {
    n int
    head pool.Scratch
}

func apply(f func(Work) int) int {
    return f(Work{})
}

func main() {
    println(apply((w mut Work) => w.n))
}
