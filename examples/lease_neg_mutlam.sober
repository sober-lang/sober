package main

// 負例: ラムダの仮引数のmutのマークは関数型のmut仮引数と合わせる — 関数型が値渡しの仮引数にmutは書けない（diag.FnArg kind 4・language.md 25 節）

import "std/task"
import "std/pool"

type Work struct {
    n int
    head pool.Scratch
}

func apply(f func(Work) int) int {
    return f(Work{})
}

func main() {
    println(apply((w mut Work) => w.n))
}
