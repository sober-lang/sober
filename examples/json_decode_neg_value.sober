package main

// 負例（loadが拒否 — diag.JsonShape 4）: DecodeのTのフィールドに裸のjson.Value（unionはゼロ値を持たないので、`?` の早期returnで返すstructが
// 作れない — フィールドをjson.Value? にするかjson.Treeで読む。Encodeだけなら裸のフィールドも書ける）

import "std/json"

type Msg struct {
    id int
    body json.Value
}

func main() {
    d, err := json.Parse(bytes("{\"id\":1,\"body\":[]}"))
    if err != nil {
        return
    }
    m, derr := json.Decode[Msg](d, json.Root(d))
    if derr == nil {
        println(m.id)
    }
}
