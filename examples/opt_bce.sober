package main

// 境界検査の消去（性能投資 M3 — bce.sober）の網: 帰納変数が負から始まるループの `xs[i]` は `i < len(xs)` だけでは範囲内と言えない（i ≥ 0 が要る）—
// 検査を消すと範囲外を黙って読む。正しくは i = -1 で添字の範囲外の panic（scripts/optdiff.sh --mut の代表）

func sum(xs []int, from int) int {
    mut s := 0
    mut i := from
    while i < len(xs) {
        s += xs[i]
        i += 1
    }
    return s
}

func main() {
    xs := []int{1, 2, 3, 4}
    println(sum(xs, 0), sum(xs, 2))
    println(sum(xs, -1))
}
