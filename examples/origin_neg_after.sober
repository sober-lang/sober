package main

import "std/http/server"

// Cookie を読む after を持つ共有のルート
func main() {
    tag := http.server.Middleware{after: (r, w) => if http.server.Cookie(r, "beta") != nil { http.server.Text("beta\n") } else { w }}
    rs := []http.server.Route{http.server.Route{method: "GET", path: "/", handler: (r) => http.server.Text("home\n"), middleware: []http.server.Middleware{tag}, cache: http.server.Fresh{maxAge: 60}}}
    println(len(rs))
}
