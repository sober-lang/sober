package main

// 閉包の名前の呼び出し形の生成元（language.md 7 節 L-for）: 展開される関数の匿名の関数型の仮引数 `recv func(k func(T)) error?` を
// 文形 for の生成元に置ける — `for x <- recv()? { … }`。脱糖は呼び出し形の生成元と同じ（継続 `(x) => { … }` を末尾の実引数に足す — 展開で
// recv が実引数のラムダに置き換わってから文形 for の脱糖に乗る）。本体の `?`・break・continue・非局所 return は普通の文形 for と同じ。
// 使用例 = 転送路の抽象（http.ServeWith(recv, send, …)）の形

type Short error {
    v int
}

type Gone error {
    at int
}

// 0..n-1 を k へ渡す。stopAt に来たら Gone（受け側の失敗）
@errors(Gone)
func gen(n int, stopAt int, k func(int)) error? {
    defer println("  (gen done)")
    mut i := 0
    while i < n {
        if i == stopAt {
            return Gone{at: i}
        }
        k(i)
        i += 1
    }
    return nil
}

// v を印字する。limit を超えたら Short（送り側の失敗）
@errors(Short)
func sendv(v int, limit int) error? {
    if v > limit {
        return Short{v: v}
    }
    println("  send ${v}")
    return nil
}

// 受けの閉包から回して送りの閉包へ（1 は飛ばす・stop で打ち切り・ret で非局所 return）
func relay(recv func(k func(int)) error?, send func(v int) error?, stop int, ret int) error? {
    for x <- recv()? {
        if x == 1 {
            continue
        }
        if x == stop {
            break
        }
        if x == ret {
            return nil
        }
        send(x * 10)?
    }
    println("  after loop")
    return nil
}

func count(n int, k func(int)) {
    mut i := 0
    while i < n {
        k(i)
        i += 1
    }
}

// 失敗しない閉包の呼び出し形（印なし・実引数つき）
func sum(src func(n int, k func(int)), n int) int {
    mut s := 0
    for x <- src(n) {
        s += x
    }
    return s
}

func first[T](xs []T) T {
    return xs[0]
}

func pieces(k func([]byte)) {
    k(bytes("ab"))
    k(bytes("cde"))
}

// 要素の型がジェネリックの推論に効くこと（[]byte の要素を first[T] へ）
func heads(src func(k func([]byte))) int {
    mut n := 0
    for w <- src() {
        n += int(first(w))
    }
    return n
}

func show(e error?) {
    if e == nil {
        println("ok")
    } else {
        println(switch e {
        case Short{v}: "short ${v}"
        case Gone{at}: "gone at ${at}"
        })
    }
}

func main() int {
    show(relay((k) => gen(4, -1, k), (v) => sendv(v, 99), 99, -1))
    show(relay((k) => gen(9, -1, k), (v) => sendv(v, 99), 3, -1))
    show(relay((k) => gen(9, -1, k), (v) => sendv(v, 40), 99, -1))
    show(relay((k) => gen(9, 4, k), (v) => sendv(v, 99), 99, -1))
    show(relay((k) => gen(9, -1, k), (v) => sendv(v, 99), 99, 3))
    println(sum((n, k) => count(n, k), 5))
    println(heads((k) => pieces(k)))
    return 0
}
