package main

// imm の束縛の mut の別名（`v := m` — v は m と同じ mut の中身）の捕獲（diag.Par kind 21 — F-ao: check はコアの givable が拒否・build は 2026-10-11 まで通していた。
// check と build が同じ拒否。desugar/parcheck.sober）

import "std/par"

func main() {
    r, e := par.Scope((s par.S) => {
        mut m := mut []int{1}
        v := m
        h := par.Spawn(s, () => v[0])
        m[0] = 7
        par.Join(h)
    })
    if e != nil {
        println("err")
    } else {
        println("${r}")
    }
}
