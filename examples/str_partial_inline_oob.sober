package main

import "std/utf8"

// 部分インラインの意味の網（panic の位置）: 写した std/utf8.Str の切り出しの範囲の検査の panic は、写さない形と同じ位置（std/utf8 の行）を出す
func main() int {
    b := bytes("abc;de;")
    v := utf8.Check(b) catch return 1
    mut n := 0
    mut i := 0
    while i < len(b) + 3 {
        s := utf8.Str(v, 0, i) catch ""
        n += len(bytes(s))
        i += 1
    }
    println(n)
    return 0
}
