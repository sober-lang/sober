package main

// task_print_chan の逐次の双子（seq ≡ par — 段 6 P4-2 (O1)）: 子の流れ全体が spawn の位置に入る = 子の仕事を先に全部書く

func kid(vs []int) int {
    println("kid waits")
    mut sum := 0
    for v <- vs {
        println("kid got ${v}")
        sum += v
    }
    println("kid done")
    return sum
}

func main() {
    println("start")
    r := kid([]int{10, 20, 30})
    mut i := 1
    while i <= 3 {
        println("parent sends ${i}")
        i += 1
    }
    println("parent joins")
    println("sum ${r}")
}
