package main

// 凍った map を値で渡して呼ぶたびに引く（language.md 17 節の map の封）: 呼ばれた側は自分の仮引数の写しに索引を作るので、
// 凍らせた時点で索引が古い map（長さ 513 = 予約の尽きる長さ・関数から返した長さ 8）は、呼ぶたびに索引を作り直して region に積もり、
// 20 万回で RegionExceeded{slot_capacity} だった。凍った map は封じた形（索引が確定）なので写しの引きは確保も書きもしない

import "std/iter"

func mk(n int) map[int]int {
    mut m := mut map[int]int{}
    for i <- iter.Range(0, n) {
        m[i] = i * 2
    }
    return freeze(m)
}

func one(m map[int]int, k int) int {
    v := m[k]
    return if v != nil { v } else { 0 }
}

func main() {
    mut m0 := mut map[int]int{}
    for i <- iter.Range(0, 513) {
        m0[i] = i * 2
    }
    m := freeze(m0)
    mut s := 0
    for i <- iter.Range(0, 200000) {
        s += one(m, i % 513)
    }
    println(s)
    r := mk(8)
    mut t := 0
    for i <- iter.Range(0, 200000) {
        t += one(r, i % 8)
    }
    println(t)
}
