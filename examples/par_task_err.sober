package main

// 段 6 P3b-4 1b': error を返す task。Join は (T, error?) の 2 値・Try は Ok / Failed / Died・Join も Try もしなかった失敗は
// scope の err へ集約（生んだ順で最初のもの）・死と失敗が両方なら死が先（TaskDied）。err は string を持つ（子の region から写る）

import "std/par"

type Bad error {
    msg string
}

@errors(Bad)
func load(n int) (int, error?) {
    if n > 4 {
        return 0, Bad{msg: "too big: ${n}"}
    }
    return n * 10, nil
}

@errors(Bad)
func crash(n int) (int, error?) {
    xs := []int{1, 2}
    return xs[n], nil
}

func show(o par.Outcome[int]) string {
    return switch o {
    case par.Ok{v}: "ok ${v}"
    case par.Failed{e}: "failed"
    case par.Died{cause}: "died"
    }
}

func report(r string, e error?) {
    if e == nil {
        println("${r} | nil")
        return
    }
    switch e {
    case Bad{msg}: println("${r} | Bad: ${msg}")
    case par.TaskDied{}: println("${r} | TaskDied")
    default: println("${r} | ?")
    }
}

func main() {
    // 回収した失敗は集約しない
    r1, e1 := par.Scope((s par.S) => {
        h1 := par.Spawn(s, () => load(1))
        h2 := par.Spawn(s, () => load(5))
        h3 := par.Spawn(s, () => load(6))
        v1, x1 := par.Join(h1)
        v2, x2 := par.Join(h2)
        mut acc := v1 + v2
        if x1 == nil && x2 != nil {
            acc += 100
        }
        "${acc} ${show(par.Try(h3))}"
    })
    report(r1, e1)
    // 未回収の失敗: 生んだ順で最初のもの
    r2, e2 := par.Scope((s par.S) => {
        a := par.Spawn(s, () => load(2))
        b := par.Spawn(s, () => load(7))
        c := par.Spawn(s, () => load(8))
        3
    })
    report("${r2}", e2)
    // 死と失敗: 死が先
    r3, e3 := par.Scope((s par.S) => {
        b := par.Spawn(s, () => load(9))
        d := par.Spawn(s, () => crash(5))
        4
    })
    report("${r3}", e3)
}
