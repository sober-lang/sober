package main

// 負例（language.md 13 節「表の網羅」）: @exhaustiveのunionのswitchが全variantを列挙していてdefaultが到達しない（defaultは集合の外専用 — unionに外は無い）

type Shape union {
    Circle{r int}
    Tri{}
}

@exhaustive
func name(s Shape) string {
    return switch s {
    case Circle{}: "circle"
    case Tri{}: "tri"
    default: "other"
    }
}

func main() {
    println(name(Tri{}))
}
