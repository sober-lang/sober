package main

// std/os.WriteMode（ファイルの許可の bit を書く — chmod(2)）: シェルスクリプトを書き、実行の bit の有無で os.Run の結果が変わることを観測する。
// 0o755 = 493・0o644 = 420。exec に失敗した子は 127（os.Run の契約）。無い path は io.NotFound

import "std/io"
import "std/os"

func run(p string) int {
    c, err := os.Run(p, []string{})
    if err != nil {
        return -1
    }
    return c
}

func main() int {
    d := runDir("os_writemode")
    defer removeAll(d)
    p := d + "/os_writemode.sh"
    if io.WriteFile(p, bytes("#!/bin/sh\necho hi from the script\nexit 3\n")) != nil {
        println("cannot write")
        return 1
    }
    // 書いたばかり（0644）は走らない
    println(run(p))
    e1 := os.WriteMode(p, 493)
    println(e1 == nil)
    println(run(p))
    e2 := os.WriteMode(p, 420)
    println(e2 == nil)
    println(run(p))
    e3 := os.WriteMode("out/no/such/file", 493)
    switch e3 {
    case nil:
        println("unexpected")
    case io.NotFound{}:
        println("NotFound")
    default:
        println("other")
    }
    return 0
}

// 実行ごとの置き場 out/<name>.<単調時計の値>（同じ作業ディレクトリで同時に走る実行どうしが上書きし合わない）。
// mkdirは既にあれば失敗するので、作れた名前がこの実行のもの。作れない状態で回り続けないよう、試す回数に上限を置く（作れなければ ""）
func runDir(name string) string {
    _ = os.Mkdir("out")
    mut n := 0
    while n < 100 {
        c := "out/${name}.${os.Monotonic()}"
        if os.Mkdir(c) == nil {
            return c
        }
        n = n + 1
    }
    return ""
}

// 置き場を中身ごと消す
func removeAll(d string) {
    if d != "" {
        _ = os.Run("/bin/rm", []string{"-rf", d}) catch 0
    }
}
