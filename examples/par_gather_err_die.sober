package main

// P3b 残穴1: fallible な Gather も Join の列 — 死んだ子を待った呼び手は死ぬ（失敗は err・死は呼び手の死 — 生んだ順で前に失敗があっても）

import "std/par"

type Bad error

func pick(xs []int, i int) (int, error?) {
    if i == 0 {
        return 0, Bad{}
    }
    return xs[i], nil
}

func main() {
    xs := []int{10, 20}
    r, e := par.Scope((s par.S) => {
        mut hs := mut []par.Task[(int, error?)]{}
        hs = append(hs, par.Spawn(s, () => pick(xs, 0)))
        hs = append(hs, par.Spawn(s, () => pick(xs, 2)))
        vs, err := par.Gather(hs)
        len(vs)
    })
    println(r)
}
