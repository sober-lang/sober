package main

import "std/http/server"

// 共有のルートのハンドラが Cookie を読む（直）
func main() {
    rs := []http.server.Route{http.server.Route{method: "GET", path: "/me", handler: (r) => http.server.Text(if http.server.Cookie(r, "sid") != nil { "in" } else { "out" }), cache: http.server.Fresh{maxAge: 60}}}
    println(len(rs))
}
