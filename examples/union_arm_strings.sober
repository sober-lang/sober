package main

// 値の位置のif / switchの分岐が `[]string` を持つvariantを作る。
// 分岐の合流のupRegionはimmのsliceの要素のregionまで上げる（immの要素は上界へ読める — 31 節）

type V union {
    N {}
    O { names []string }
}

func mk(k int) V {
    return switch k {
    case 0: N{}
    default: O{names: []string{"a", "b"}}
    }
}

func mk2(k int, extra string) V {
    return if k == 0 { N{} } else { O{names: []string{extra, "z"}} }
}

func count(v V) int {
    return switch v {
    case O{names}: len(names)
    case N{}: 0
    }
}

func main() {
    println(count(mk(0)), count(mk(1)), count(mk2(1, "q")), count(mk2(0, "q")))
}
