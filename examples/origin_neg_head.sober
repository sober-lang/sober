package main

import "std/http/server"

// 共有のルートのハンドラがリクエストの頭（Request.head — 認証のヘッダを含む）を直に読む
import "std/utf8"

func main() {
    rs := []http.server.Route{http.server.Route{method: "GET", path: "/h", handler: (r) => http.server.Text("${len(utf8.Bytes(r.head))}\n"), cache: http.server.Fresh{maxAge: 60}}}
    println(len(rs))
}
