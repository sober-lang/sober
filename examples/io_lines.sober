package main

// io.Lines の確認: 切片（64 KiB）の境界をまたぐ行の縫い直し・空行・CRLF・LF の無い末尾の行。
// 行の設計: alpha / 空行 / crlf(CRLF) / 'x' × 70,000（切片 1 と 2 をまたぐ — またいだ行だけ std の中で写す）/ tail（LF なし）。
// リポジトリのルートを cwd にして実行する。書き込み先は out/ の下
import "std/io"
import "std/iter"

const longLen = 70000

// b が 'x' × longLen か
func allx(b []byte) bool {
    mut ok := len(b) == longLen
    for i <- iter.Range(0, len(b)) {
        ok = ok && b[i] == 'x'
    }
    return ok
}

func run(p string) (int, error?) {
    f := io.Open(p)?
    defer io.Close(f)
    mut n := 0
    mut bad := 0
    for l <- io.Lines(f)? {
        b := io.Raw(l)
        ok := switch n {
        case 0: string(b) catch "?" == "alpha"
        case 1: len(b) == 0
        case 2: string(b) catch "?" == "crlf"
        case 3: allx(b)
        case 4: string(b) catch "?" == "tail"
        default: false
        }
        if !ok {
            bad += 1
        }
        println("line ${n}: ${len(b)} bytes, ok=${ok}")
        n += 1
    }
    return 100 * n + bad, nil
}

func main() int {
    p := "out/io_lines.tmp"
    mut w := mut []byte{}
    for c <- bytes("alpha\n\ncrlf\r\n") {
        w = append(w, c)
    }
    for i <- iter.Range(0, longLen) {
        w = append(w, 'x')
    }
    w = append(w, '\n')
    for c <- bytes("tail") {
        w = append(w, c)
    }
    if io.WriteFile(p, freeze(w)) != nil {
        return 1
    }
    r := run(p) catch return 1
    // 500 = 5 行・下 2 桁 0 = 不一致なし
    println("result: ${r}")
    return 0
}
