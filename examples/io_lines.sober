package main

// io.Lines の確認: 切片（64 KiB）の境界をまたぐ行の縫い直し・空行・CRLF・LF の無い末尾の行。
// 行の設計: alpha / 空行 / crlf(CRLF) / 'x' × 70,000（切片1と2をまたぐ — またいだ行だけstdの中でコピーする）/ tail（LFなし）。
// リポジトリのルートを cwd にして実行する。書き込み先は実行ごとの out/io_lines.<n> の下
import "std/io"
import "std/iter"
import "std/os"

const longLen = 70000

// b が 'x' × longLen か
func allx(b []byte) bool {
    mut ok := len(b) == longLen
    for i <- iter.Range(0, len(b)) {
        ok = ok && b[i] == 'x'
    }
    return ok
}

func run(p string) (int, error?) {
    f := io.Open(p)?
    defer io.Close(f)
    mut n := 0
    mut bad := 0
    for l <- io.Lines(f)? {
        b := io.Raw(l)
        ok := switch n {
        case 0: string(b) catch "?" == "alpha"
        case 1: len(b) == 0
        case 2: string(b) catch "?" == "crlf"
        case 3: allx(b)
        case 4: string(b) catch "?" == "tail"
        default: false
        }
        if !ok {
            bad += 1
        }
        println("line ${n}: ${len(b)} bytes, ok=${ok}")
        n += 1
    }
    return 100 * n + bad, nil
}

func main() int {
    d := runDir("io_lines")
    defer removeAll(d)
    p := d + "/io_lines.tmp"
    mut w := mut []byte{}
    for c <- bytes("alpha\n\ncrlf\r\n") {
        w = append(w, c)
    }
    for i <- iter.Range(0, longLen) {
        w = append(w, 'x')
    }
    w = append(w, '\n')
    for c <- bytes("tail") {
        w = append(w, c)
    }
    if io.WriteFile(p, freeze(w)) != nil {
        return 1
    }
    r := run(p) catch return 1
    // 500 = 5 行・下 2 桁 0 = 不一致なし
    println("result: ${r}")
    return 0
}

// 実行ごとの置き場 out/<name>.<単調時計の値>（同じ作業ディレクトリで同時に走る実行どうしが上書きし合わない）。
// mkdirは既にあれば失敗するので、作れた名前がこの実行のもの。作れない状態で回り続けないよう、試す回数に上限を置く（作れなければ ""）
func runDir(name string) string {
    _ = os.Mkdir("out")
    mut n := 0
    while n < 100 {
        c := "out/${name}.${os.Monotonic()}"
        if os.Mkdir(c) == nil {
            return c
        }
        n = n + 1
    }
    return ""
}

// 置き場を中身ごと消す
func removeAll(d string) {
    if d != "" {
        _ = os.Run("/bin/rm", []string{"-rf", d}) catch 0
    }
}
