package main

// 負例: 値の位置のラムダ（関数型のフィールドに格納するクロージャ）はmutを捕捉できない — 格納されたクロージャへmutが逃げる（language.md 25 節 (α-L1)・U3）。
// 状態を更新し続けるなら呼び手が持って mut 仮引数で渡す（language.md 25 節「関数型の mut 仮引数」）

type Stream func(emit func(b []byte) error?) error?

type R struct {
    stream Stream?
}

func main() {
    mut n := 0
    r := R{stream: (emit) => { n += 1; emit(bytes("a")) }}
    println(r.stream == nil)
}
