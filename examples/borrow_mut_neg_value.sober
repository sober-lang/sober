package main

// 負例: 値の位置のラムダ（関数型の欄に格納する閉包）は mut を捕捉できない — 格納された閉包へ mut が逃げる（language.md 25 節 (α-L1)・U3）。
// mut を捕捉できるのは値の呼び出しの借りの実引数のラムダだけ

type Stream func(emit func(b []byte) error?) error?

type R struct {
    stream Stream?
}

func main() {
    mut n := 0
    r := R{stream: (emit) => { n += 1; emit(bytes("a")) }}
    println(r.stream == nil)
}
