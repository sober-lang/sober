package main

// 負例（language.md 7 節L-for）: 結果がerror? でないクロージャの呼び出し形にマーク `?` — 呼び出し形の生成元と同じ拒否

func count(n int, k func(int)) {
    mut i := 0
    while i < n {
        k(i)
        i += 1
    }
}

func relay(recv func(k func(int))) error? {
    for x <- recv()? {
        println(x)
    }
    return nil
}

func main() {
    println(relay((k) => count(3, k)) == nil)
}
