package main

// 負例: 同一性を持つ型（task.Receiver）をフィールドに持つstructの部分リテラルで、そのフィールドを省く — 省いたフィールドはゼロ値（language.md 15 節）なので、偽の端点を作る
// （diag.Identity — フィールドを通した推移も拒否。フィールドを `T?` にすればゼロ値はnilで偽物を作らない）

import "std/task"

type Inbox struct {
    rx task.Receiver[string]
    seen int
}

func main() {
    b := Inbox{seen: 0}
    println(b.seen)
}
