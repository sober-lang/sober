package main

// 段 6 P5-2 入口: struct の欄に包んだ札の捕獲（kind 5） — check と build が同じ名指しで拒否（desugar/parcheck.sober）。縮退の前提「縮退した子が待てるのは自分の子孫だけ」の柵

import "std/task"

type W struct {
    s task.Scope
}

func main() {
    r, e := task.Run((s task.Scope) => {
        w := W{s: s}
        h := task.Spawn(s, () => task.Join(task.Spawn(w.s, () => 2)))
        task.Join(h)
    })
    println(r)
}
