package main

// コピーの転送（cpfwd.sober）の検査: sliceの要素のstructを局所へコピーし、先頭のフィールドの文字列を == で比べる形（rt.str_eqに番地で渡る）。
// コピーと使い道の間に元のsliceを書き換える形では転送してはいけない（局所はコピーした時の値を見る）— 書き換えの無い形は転送して元の要素を直に読む

type Route struct {
    method string
    hits int
}

// rsの中でmethodがmに等しい要素の数（コピーの後に書き換えない — 転送する形）
func count(rs mut []Route, m string) int {
    mut n := 0
    mut i := 0
    while i < len(rs) {
        r := rs[i]
        if r.method == m {
            n += r.hits
        }
        i += 1
    }
    return n
}

// 要素をコピーしてから元の要素のフィールドを書き換え、コピーの方を比べて足す（転送してはいけない形 — 書き換えは別の要素のコピー — relocateを伴わないstore）
func swapCount(rs mut []Route, m string, to int) int {
    mut n := 0
    mut i := 0
    while i < len(rs) {
        r := rs[i]
        rs[i] = rs[to]
        if r.method == m {
            n += r.hits
        }
        i += 1
    }
    return n
}

// 局所rを2か所のコピー（先頭の要素・条件つきでk番目）から作って比べる（使い道は合流の後 — どちらのコピーも使い道を支配しないパスがある）
func pick(rs mut []Route, k int, m string) int {
    mut r := rs[0]
    if k > 2 {
        r = rs[k]
    }
    if r.method == m {
        return r.hits
    }
    return 0 - r.hits
}

func main() {
    mut rs := mut []Route{}
    names := []string{"GET", "POST", "DELETE", "PATCH", "GET", "OPTIONS"}
    for k <- names {
        rs = append(rs, Route{method: k + "_route", hits: len(rs) + 1})
    }
    m := names[0] + "_route"
    println(count(mut rs, m))
    println(swapCount(mut rs, m, 5))
    println(count(mut rs, m))
    println(swapCount(mut rs, names[2] + "_route", 1))
    println(pick(mut rs, 1, m), pick(mut rs, 3, m), pick(mut rs, 4, rs[4].method))
}
