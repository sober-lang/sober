package main

import "std/http/server"

// 共有の静的ファイルを認証の middleware の Mount に入れる（Mount の出会い）
func main() {
    auth := http.server.Middleware{before: (r) => if http.server.Authorization(r) == nil { http.server.Status(401) } else { nil }}
    rs := http.server.Mount("/members", http.server.Static("/files", "/srv/members", cache: http.server.Fresh{maxAge: 86400}), []http.server.Middleware{auth})
    println(len(rs))
}
