package main

// elseつきifの本体の絞り（spec T-17）: `A && x != nil && B` の本体と `A || x == nil || B` のelseの分岐でxはT

func label(n int?, loud bool) string {
    return if loud && n != nil { "N${n + 1}" } else { "-" }
}

func show(s string?, skip bool) string {
    return if skip || s == nil { "_" } else { s + "!" }
}

func sum(a int?, b int?) int {
    if a != nil && b != nil && a < b {
        return a + b
    } else if a == nil || b == nil {
        return 0
    } else {
        return a * b
    }
}

func main() {
    println(label(3, true) + label(3, false) + label(nil, true))
    println(show("a", false) + show(nil, false) + show("b", true))
    println("${sum(2, 5)} ${sum(5, 2)} ${sum(nil, 2)} ${sum(2, nil)}")
}
