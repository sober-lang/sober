package main

// 文脈欄の負例: 別名（`y := x`）の欄の読みは行き先の欄 — 行き先に書いた秘密は別名から読んでも秘密

type Box struct {
    v int
    w int
}

func put(b mut Box, x int) {
    b.v = x
}

@secret(k)
func use(k int) {
    mut b := Box{v: 0, w: 0}
    put(mut b, k)
    y := b
    if y.v > 1 {
        println("big")
    }
}

func main() {
    use(3)
}
