package main

// 借りの仮引数の mut の席の格納点の写し: 借りの本体が深い region の imm（stream の反復の region の chunk・本体の中で作った文字列）を
// mut の席の欄へ格納する — lower は mut 仮引数の格納点の floor = 呼び手が書いた anchor（26 節の M5 と同じ）。写しが無いと
// stream の次の反復の確保が置き場を上書きして z.keep が壊れる

type Z struct {
    last []byte
    keep []byte
    n int
}

type Stream func(z mut Z, emit func(z mut Z, b []byte) error?) error?

func chunks(z mut Z, emit func(z mut Z, b []byte) error?) error? {
    mut i := 0
    while i < 4 {
        mut buf := mut []byte{}
        mut j := 0
        while j < 40 {
            buf = append(buf, byte(97 + i))
            j += 1
        }
        emit(mut z, freeze(buf))?
        // 次の反復の region の確保で前の buf の置き場を上書きさせる
        mut junk := mut []byte{}
        mut q := 0
        while q < 200 {
            junk = append(junk, byte(48))
            q += 1
        }
        i += 1
    }
    return nil
}

func run(st Stream) Z {
    mut z := Z{last: bytes(""), keep: bytes(""), n: 0}
    e := st(mut z, (y, b) => {
        t := bytes("x${len(b)}${string(b) catch "?"}")
        y.last = b
        if y.n == 1 { y.keep = t }
        y.n += 1
        nil
    })
    if e != nil { z.n = -1 }
    return z
}

func main() {
    z := run(chunks)
    println(z.n)
    println(string(z.last) catch "?")
    println(string(z.keep) catch "?")
}
