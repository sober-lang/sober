package main

// 借りの仮引数が持つmut仮引数の格納点のコピー: 借りの本体が深いregionのimm（streamの反復のregionのchunk・本体の中で作った文字列）を
// mut仮引数のフィールドへ格納する — lowerはmut仮引数の格納点のfloor = 呼び手が書いたanchor（26 節のM5と同じ）。コピーが無いと
// streamの次の反復の確保が格納場所を上書きしてz.keepが壊れる

type Z struct {
    last []byte
    keep []byte
    n int
}

type Stream func(z mut Z, emit func(z mut Z, b []byte) error?) error?

func chunks(z mut Z, emit func(z mut Z, b []byte) error?) error? {
    mut i := 0
    while i < 4 {
        mut buf := mut []byte{}
        mut j := 0
        while j < 40 {
            buf = append(buf, byte(97 + i))
            j += 1
        }
        emit(mut z, freeze(buf))?
        // 次の反復のregionの確保で前のbufの格納場所を上書きさせる
        mut junk := mut []byte{}
        mut q := 0
        while q < 200 {
            junk = append(junk, byte(48))
            q += 1
        }
        i += 1
    }
    return nil
}

func run(st Stream) Z {
    mut z := Z{last: bytes(""), keep: bytes(""), n: 0}
    e := st(mut z, (y, b) => {
        t := bytes("x${len(b)}${string(b) catch "?"}")
        y.last = b
        if y.n == 1 { y.keep = t }
        y.n += 1
        nil
    })
    if e != nil { z.n = -1 }
    return z
}

func main() {
    z := run(chunks)
    println(z.n)
    println(string(z.last) catch "?")
    println(string(z.keep) catch "?")
}
