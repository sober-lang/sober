package main

// SSEのイベントの差し込みの封（language.md 28 節の「SSE」）: Eventのevent / idに改行を書けると、受け手に別のイベントやフィールド（`data:` の行・`id:` の上書き）を
// 足せる — http.server.FormatEventはevent / idのCR・LF・NULをpanic(BadEvent) で断る（レスポンスの頭のBadHeaderと同じ基準）。dataの改行は割って送るので書ける。
// リクエストの値（ここではqueryの名前）をそのままeventに入れる形が入口 — 1つ目のイベントは組めて、2つ目で死ぬ（終了101）

import "std/http/server"

func main() {
    println(http.server.FormatEvent(http.server.Event{event: "greet", data: "line 1\nline 2"}))
    name := "x\ndata: injected"
    println(http.server.FormatEvent(http.server.Event{event: name, data: "hello"}))
}
