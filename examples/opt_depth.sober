package main

// 深度の流れ（depth.sober）の回帰例: ループの中で式ブロックが region を開き、その中のループの頭に setdepth が立つ。
// 内のループの中でもう一段の式ブロックが region を開き、出口の setdepth が内の深度へ戻す。式ブロックを出た後の append は外の region に積まれる — 内の region の深度を外の深度と取り違えると、次の周回の式ブロックが
// out の中身を上書きする

import "std/iter"

func main() int {
    mut out := mut []int{}
    mut i := 0
    while i < 6 {
        v := {
            mut ys := mut []int{}
            mut j := 0
            while j < 4 {
                w := {
                    zs := append([]int{}, i * 10 + j)
                    zs[0]
                }
                ys = append(ys, w)
                j += 1
            }
            ys[3]
        }
        out = append(out, v)
        out = append(out, i)
        i += 1
    }
    for k <- iter.Range(0, len(out)) {
        println(out[k])
    }
    return 0
}
