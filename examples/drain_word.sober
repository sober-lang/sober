package main

// copyloopの形D（ワード → バイト列の直列化のループ）の意味の検査:
//   `while x >= 8 { out = append(out, byte(b & 0xff)); b = b >> 8; x = x - 8 }`
// を b の符号・x の端（0 / 8 未満 / 8 の倍数でない / ちょうど 64 / 64 超）の組で回し、書いたバイト列と x・b の最終値を印字する。
// ゴールデン = 畳む前の素直な意味（--no-optのパスと同じ値 — optdiffが照合）。x ≥ 64のワードのパス・端の1バイトのパス・畳まれない負のxを全部通す

import "std/iter"

func one(b0 int, x0 int) {
    mut out := mut []byte{}
    mut b := b0
    mut x := x0
    while x >= 8 {
        out = append(out, byte(b & 0xff))
        b = b >> 8
        x = x - 8
    }
    mut s := mut []byte{}
    for i <- iter.Range(0, len(out)) {
        h := "0123456789abcdef"
        s = append(s, bytes(h)[int(out[i]) >> 4])
        s = append(s, bytes(h)[int(out[i]) & 15])
    }
    t := string(freeze(s)) catch return
    println("${t} b=${b} x=${x}")
}

func main() {
    one(578437695752307201, 64)    // 0x0807060504030201 — ちょうど1ワード
    one(578437695752307201, 20)    // 端だけ（2 バイト・x の残り 4）
    one(-1, 64)                    // 負の b — 全部 0xff・算術シフトで b は -1 のまま
    one(-2, 72)                    // ワード + 端1バイト（fe ff×8 — 9バイト）
    one(255, 0)                    // 回らない
    one(255, 7)                    // 回らない（x < 8）
    one(255, -8)                   // 回らない(負の x)
    one(4822678189205111, 128)     // 2ワード（0x00112233445566F7 — 上位0込み・2ワード目は0）
}
