package main

// 負例（diag.CatchLhs — check と build が同じ文面）: error を返さない task の Join に catch。Join の結果は字面で T 1 つなので
// loader は判定を保留し、表層型の後（ParCheck の層）が T = int を見て名指す（language.md 11 節・13 節）

import "std/task"

func main() {
    r, err := task.Run((s task.Scope) => {
        h := task.Spawn(s, () => 3)
        task.Join(h) catch -1
    })
    println(r)
}
