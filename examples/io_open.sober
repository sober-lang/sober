package main

// IO 便 段 2: 開いたファイル io.File（language.md 28 節「資源とストリーム」）。`f := io.Open(p)?`（か catch）の直後の文が `defer io.Close(f)`・
// 読みは io.ReadAll(f)・File は利用者の関数の実引数に渡せる（受けた側も写せない・外へ出せない）。後始末が抜けないことは開いている fd の数
// （/proc/self/fd の項目の数）の差で見る。リポジトリのルートを cwd にして実行する

import "std/io"

func fds() int {
    es := io.ReadDir("/proc/self/fd") catch return -1
    return len(es)
}

// size は開いた File を今の位置から全部読んだ長さ（File を実引数で受ける helper）
@errors(io.NotFound, io.Denied, io.Other)
func size(f io.File) (int, error?) {
    b := io.ReadAll(f)?
    return len(b), nil
}

// sizeOf は path を開いて読む（`?` の形 — 失敗は呼び手へ）
@errors(io.NotFound, io.Denied, io.Other)
func sizeOf(p string) (int, error?) {
    f := io.Open(p)?
    defer io.Close(f)
    return size(f)
}

// firstLine は path の先頭の行（catch の形 — 開けなければ "(none)"）
func firstLine(p string) string {
    f := io.Open(p) catch return "(none)"
    defer io.Close(f)
    b := io.ReadAll(f) catch return "(unreadable)"
    mut i := 0
    while i < len(b) && b[i] != '\n' {
        i += 1
    }
    return string(b[0:i]) catch "(not utf-8)"
}

func why(e error) string {
    return switch e {
    case io.NotFound{}: "not found"
    case io.Denied{}: "denied"
    case io.Other{errno}: "errno ${errno}"
    }
}

func main() {
    n0 := fds()
    n, err := sizeOf("testdata/io/hello.txt")
    if err == nil {
        println("hello.txt: ${n} bytes")
    }
    _, err2 := sizeOf("testdata/io/missing.txt")
    if err2 != nil {
        println("missing.txt: ${why(err2)}")
    }
    // ディレクトリは開けるが読めない（EISDIR）
    _, err3 := sizeOf("testdata/io")
    if err3 != nil {
        println("testdata/io: ${why(err3)}")
    }
    println(firstLine("testdata/io/hello.txt"))
    println(firstLine("testdata/io/missing.txt"))
    mut k := 0
    while k < 100 {
        _, _ = sizeOf("testdata/io/hello.txt")
        k += 1
    }
    println("open fds after: ${fds() - n0}")
}
