package main

// P3b 残穴1: fallible な Gather も Join の列 — 死んだ子を待った呼び手は死ぬ（失敗は err・死は呼び手の死 — 生んだ順で前に失敗があっても）

import "std/task"

type Bad error

func pick(xs []int, i int) (int, error?) {
    if i == 0 {
        return 0, Bad{}
    }
    return xs[i], nil
}

func main() {
    xs := []int{10, 20}
    r, e := task.Run((s task.Scope) => {
        mut hs := mut []task.Handle[(int, error?)]{}
        hs = append(hs, task.Spawn(s, () => pick(xs, 0)))
        hs = append(hs, task.Spawn(s, () => pick(xs, 2)))
        vs, err := task.Gather(hs)
        len(vs)
    })
    println(r)
}
