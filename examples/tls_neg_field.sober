package main

// 負例: tls.Connはstructのフィールドに置けない（同一性の型 — 状態は値の外の格納場所に住むので、コピーが別の値の顔をすると隠れた可変が観測できてしまう。
// diag.FileUse — desugar/filecheck・language.md 28 節の tls）

import "std/tls"

type Peer struct {
    c tls.Conn
    n int
}

func h(c tls.Conn) error? {
    p := Peer{c: c, n: 1}
    return tls.Send(p.c, bytes("x"))
}

func main() {
    cfg, _ := tls.Parse("", "")
    _ = tls.Serve("127.0.0.1:9", cfg, h)
}
