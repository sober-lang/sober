package main

// The value an Await body returns belongs to the caller: 8 producers append text lines to a byte window with task.Update, and one
// consumer waits with task.Await, whose body returns a clone of the window and a string, then empties the window. The consumer keeps
// allocating while the producers keep writing, so every line arrives intact only if neither the result nor the window shares memory
// with the other

import "std/iter"
import "std/task"

const CAP = 8192

type Buf struct {
    b mut []byte
    n int
    closed bool
}

type Got struct {
    b []byte
    n int
    c bool
    tag string
}

func put(d task.Domain[Buf], line string) {
    lb := bytes(line)
    _ = task.Update(d, (st mut Buf) => {
        for i <- iter.Range(0, len(lb)) {
            st.b[st.n + i] = lb[i]
        }
        st.b[st.n + len(lb)] = 10
        st.n += len(lb) + 1
        0
    })
}

// lines * 1e9 + the sum of the bytes; -1 if a tag did not match its window
func drain(d task.Domain[Buf]) int {
    mut lines := 0
    mut sum := 0
    mut bad := 0
    mut more := true
    while more {
        got, e := task.Await(d, (st mut Buf) => {
            g := Got{b: clone(st.b), n: st.n, c: st.closed, tag: "n=${st.n}"}
            st.n = 0
            g
        }, (st Buf) => st.n > 0 || st.closed)
        if e != nil {
            return -2
        }
        if got.tag != "n=${got.n}" {
            bad += 1
        }
        for j <- iter.Range(0, got.n) {
            sum += int(got.b[j])
            if got.b[j] == 10 {
                lines += 1
            }
        }
        more = !got.c
    }
    return if bad > 0 { -1 } else { lines * 1000000000 + sum }
}

func main() {
    r, e := task.Run((s task.Scope) => {
        mut z := mut []byte{}
        for _ <- iter.Range(0, CAP) {
            z = append(z, 0)
        }
        d := task.NewDomain(s, Buf{b: z, n: 0, closed: false})
        w := task.Spawn(s, () => drain(d))
        mut hs := mut []task.Handle[int]{}
        for i <- iter.Range(0, 8) {
            hs = append(hs, task.Spawn(s, () => {
                for k <- iter.Range(0, 100) {
                    put(d, "p${i} ${k}")
                }
                0
            }))
        }
        _ = task.Gather(hs)
        _ = task.Update(d, (st mut Buf) => {
            st.closed = true
            0
        })
        task.Join(w)
    })
    if e != nil {
        println("died")
        return
    }
    println(r)
}
