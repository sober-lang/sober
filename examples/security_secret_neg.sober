package main

// Security: timing — an early-exit comparison of a secret leaks where the bytes differ (rejected by check) (docs/guide/security.md)

@secret(tag)
func same(tag []byte, got []byte) bool {
    if len(tag) != len(got) {
        return false
    }
    mut i := 0
    while i < len(tag) {
        if tag[i] != got[i] {
            return false
        }
        i += 1
    }
    return true
}

func main() {
    println(same(bytes("abc"), bytes("abd")))
}
