package main

// 展開される関数型の仮引数の呼び出しの結果（struct）から欄を読む回帰例

type R struct {
    status int
    body []byte
}

func mk(n int) R {
    return R{status: n, body: bytes("ab")}
}

func use(f func(int) R) int {
    r := f(7)
    mut out := mut []byte{}
    for x <- r.body {
        out = append(out, x)
    }
    return r.status * 10 + len(out)
}

func main() {
    println(use(mk))
    println(use((n) => R{status: n + 1, body: bytes("abc")}))
}
