// 名前つきプールを spawn なしで使うプログラム: NewPool / Fail / Ledger だけでも task の rt（rt.pool_new・rt.ledger の
// 本体が読む台帳の大域）が建つ必要がある（rt.pool_new 等が空の関数のまま x86 に渡ると build が ICE になる — check は受理するので build 側の回帰例）
package main

import "std/task"

func main() {
    p := task.NewPool(4 * task.KB, nil)
    q := task.NewPool(2 * task.KB, p)
    task.MarkFailed(q)
    task.MarkFailed(q)
    l := task.Ledger()
    println("pools ${len(l.pools)}")
    for v <- l.pools {
        println("pool ${v.id} parent ${v.parent} cap ${v.cap} tasks ${v.tasks} fail ${v.fail}")
    }
}
