package main

// Go の strings パッケージとの突き合わせ。生成物 — scripts/strings_oracle.ts から再生成する

import "std/strings"

func showCut(s string, sep string) {
    a, b, ok := strings.Cut(s, sep)
    println(a, b, ok)
}

func showCutLast(s string, sep string) {
    a, b, ok := strings.CutLast(s, sep)
    println(a, b, ok)
}

func main() {
    println(strings.HasPrefix("hello world", "hello"))
    println(strings.HasPrefix("hello world", "world"))
    println(strings.HasPrefix("hi", "hello"))
    println(strings.HasPrefix("hello", ""))
    println(strings.HasPrefix("", ""))
    println(strings.HasPrefix("", "a"))
    println(strings.HasPrefix("abc", "abc"))
    println(strings.HasPrefix("abc", "abcd"))
    println(strings.HasSuffix("hello world", "world"))
    println(strings.HasSuffix("hello world", "hello"))
    println(strings.HasSuffix("lo", "hello"))
    println(strings.HasSuffix("abc", ""))
    println(strings.HasSuffix("", ""))
    println(strings.HasSuffix("abc", "abc"))
    println(strings.HasSuffix("abcabc", "cabc"))
    println(strings.Index("chicken", "ken"))
    println(strings.Index("chicken", "dmr"))
    println(strings.Index("abc", ""))
    println(strings.Index("", ""))
    println(strings.Index("", "a"))
    println(strings.Index("abc", "abc"))
    println(strings.Index("ab", "abc"))
    println(strings.Index("aaab", "aab"))
    println(strings.Index("abcabc", "cab"))
    println(strings.Index("xxxxx", "x"))
    println(strings.Index("あいう", "い"))
    println(strings.Index("あいう", "え"))
    println(strings.Contains("seafood", "foo"))
    println(strings.Contains("seafood", "bar"))
    println(strings.Contains("seafood", ""))
    println(strings.Contains("", ""))
    println(strings.Contains("", "a"))
    println(strings.Contains("ab", "ba"))
    println(strings.Count("cheese", "e"))
    println(strings.Count("five", ""))
    println(strings.Count("", ""))
    println(strings.Count("aaaa", "aa"))
    println(strings.Count("aaaaa", "aa"))
    println(strings.Count("abc", "abcd"))
    println(strings.Count("abcabcab", "abc"))
    println(strings.Count("あいう", ""))
    println(strings.Count("ababab", "bab"))
    println(strings.IndexByte("golang", 108))
    println(strings.IndexByte("gophers", 104))
    println(strings.IndexByte("golang", 120))
    println(strings.IndexByte("", 97))
    println(strings.IndexByte("aaa", 97))
    println(strings.IndexByte("abc", 99))
    println(strings.TrimPrefix(":id", ":"))
    println(strings.TrimPrefix("id", ":"))
    println(strings.TrimPrefix("abc", ""))
    println(strings.TrimPrefix("", ""))
    println(strings.TrimPrefix("ab", "abc"))
    println(strings.TrimPrefix("あいう", "あ"))
    println(strings.TrimPrefix("abcabc", "abc"))
    showCut("k=v", "=")
    showCut("k=v=w", "=")
    showCut("kv", "=")
    showCut("", "=")
    showCut("abc", "")
    showCut("=v", "=")
    showCut("k=", "=")
    showCut("あ=い", "=")
    showCut("aXXbXXc", "XX")
    showCut("あいう", "い")
    showCutLast("a/b/c", "/")
    showCutLast("abc", "/")
    showCutLast("/abc", "/")
    showCutLast("abc/", "/")
    showCutLast("abc", "")
    showCutLast("", "")
    showCutLast("aXXbXXc", "XX")
    showCutLast("あ/い/う", "/")
    showCutLast("aaa", "aa")
}
