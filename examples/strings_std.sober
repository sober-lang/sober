package main

// Go の strings パッケージとの突き合わせ。生成物 — scripts/strings_oracle.ts から再生成する

import "std/strings"

func showCut(s string, sep string) {
    a, b, ok := strings.Cut(s, sep)
    println(a, b, ok)
}

func showCutLast(s string, sep string) {
    a, b, ok := strings.CutLast(s, sep)
    println(a, b, ok)
}

func showSplit(s string, sep string) {
    ps := strings.Split(s, sep)
    println(len(ps), strings.Join(ps, "|"))
}

func showFields(s string) {
    ps := strings.Fields(s)
    println(len(ps), strings.Join(ps, "|"))
}

func main() {
    println(strings.HasPrefix("hello world", "hello"))
    println(strings.HasPrefix("hello world", "world"))
    println(strings.HasPrefix("hi", "hello"))
    println(strings.HasPrefix("hello", ""))
    println(strings.HasPrefix("", ""))
    println(strings.HasPrefix("", "a"))
    println(strings.HasPrefix("abc", "abc"))
    println(strings.HasPrefix("abc", "abcd"))
    println(strings.HasSuffix("hello world", "world"))
    println(strings.HasSuffix("hello world", "hello"))
    println(strings.HasSuffix("lo", "hello"))
    println(strings.HasSuffix("abc", ""))
    println(strings.HasSuffix("", ""))
    println(strings.HasSuffix("abc", "abc"))
    println(strings.HasSuffix("abcabc", "cabc"))
    println(strings.Index("chicken", "ken"))
    println(strings.Index("chicken", "dmr"))
    println(strings.Index("abc", ""))
    println(strings.Index("", ""))
    println(strings.Index("", "a"))
    println(strings.Index("abc", "abc"))
    println(strings.Index("ab", "abc"))
    println(strings.Index("aaab", "aab"))
    println(strings.Index("abcabc", "cab"))
    println(strings.Index("xxxxx", "x"))
    println(strings.Index("あいう", "い"))
    println(strings.Index("あいう", "え"))
    println(strings.Contains("seafood", "foo"))
    println(strings.Contains("seafood", "bar"))
    println(strings.Contains("seafood", ""))
    println(strings.Contains("", ""))
    println(strings.Contains("", "a"))
    println(strings.Contains("ab", "ba"))
    println(strings.Count("cheese", "e"))
    println(strings.Count("five", ""))
    println(strings.Count("", ""))
    println(strings.Count("aaaa", "aa"))
    println(strings.Count("aaaaa", "aa"))
    println(strings.Count("abc", "abcd"))
    println(strings.Count("abcabcab", "abc"))
    println(strings.Count("あいう", ""))
    println(strings.Count("ababab", "bab"))
    println(strings.IndexByte("golang", 108))
    println(strings.IndexByte("gophers", 104))
    println(strings.IndexByte("golang", 120))
    println(strings.IndexByte("", 97))
    println(strings.IndexByte("aaa", 97))
    println(strings.IndexByte("abc", 99))
    println(strings.TrimPrefix(":id", ":"))
    println(strings.TrimPrefix("id", ":"))
    println(strings.TrimPrefix("abc", ""))
    println(strings.TrimPrefix("", ""))
    println(strings.TrimPrefix("ab", "abc"))
    println(strings.TrimPrefix("あいう", "あ"))
    println(strings.TrimPrefix("abcabc", "abc"))
    showCut("k=v", "=")
    showCut("k=v=w", "=")
    showCut("kv", "=")
    showCut("", "=")
    showCut("abc", "")
    showCut("=v", "=")
    showCut("k=", "=")
    showCut("あ=い", "=")
    showCut("aXXbXXc", "XX")
    showCut("あいう", "い")
    showCutLast("a/b/c", "/")
    showCutLast("abc", "/")
    showCutLast("/abc", "/")
    showCutLast("abc/", "/")
    showCutLast("abc", "")
    showCutLast("", "")
    showCutLast("aXXbXXc", "XX")
    showCutLast("あ/い/う", "/")
    showCutLast("aaa", "aa")
    println(strings.TrimSuffix("a.go", ".go"))
    println(strings.TrimSuffix("a.go", ".rs"))
    println(strings.TrimSuffix("abc", ""))
    println(strings.TrimSuffix("", ""))
    println(strings.TrimSuffix("bc", "abc"))
    println(strings.TrimSuffix("あいう", "う"))
    println(strings.TrimSuffix("abcabc", "abc"))
    println(strings.LastIndex("go gopher", "go"))
    println(strings.LastIndex("go gopher", "rodent"))
    println(strings.LastIndex("abc", ""))
    println(strings.LastIndex("", ""))
    println(strings.LastIndex("", "a"))
    println(strings.LastIndex("aaa", "aa"))
    println(strings.LastIndex("あいあい", "あ"))
    println(strings.LastIndex("ab", "abc"))
    showSplit("a,b,c", ",")
    showSplit("a,b,,c,", ",")
    showSplit("", ",")
    showSplit("abc", "")
    showSplit("", "")
    showSplit("abc", "abc")
    showSplit("abc", "x")
    showSplit("aXXbXXXc", "XX")
    showSplit("あいう", "")
    showSplit("a,あ,", ",")
    showSplit("aaa", "a")
    showSplit("aaaa", "aa")
    showSplit("€𝄞x", "")
    showFields("  foo bar  baz   ")
    showFields("")
    showFields(" \t\n\r ")
    showFields("a")
    showFields("\ta\nb\rc")
    showFields("あ い\tう")
    showFields("x  ")
    println(strings.TrimSpace(" \t\n Hello, Gophers \n\t\r\n"))
    println(strings.TrimSpace(""))
    println(strings.TrimSpace("   "))
    println(strings.TrimSpace("a b"))
    println(strings.TrimSpace("\r\nx\t"))
    println(strings.TrimSpace(" あ "))
    println(strings.Replace("oink oink oink", "k", "ky", 2))
    println(strings.Replace("oink oink oink", "oink", "moo", -1))
    println(strings.Replace("abc", "", "-", -1))
    println(strings.Replace("abc", "", "-", 2))
    println(strings.Replace("", "", "x", -1))
    println(strings.Replace("", "", "x", 0))
    println(strings.Replace("abc", "b", "", -1))
    println(strings.Replace("aaa", "a", "aa", -1))
    println(strings.Replace("aaaa", "aa", "b", 1))
    println(strings.Replace("abc", "x", "y", -1))
    println(strings.Replace("abc", "b", "B", 0))
    println(strings.Replace("あいう", "", "|", -1))
    println(strings.Replace("あいあい", "い", "う", -1))
    println(strings.Replace("abc", "abc", "", -1))
    println(strings.Replace("abab", "ab", "ab", -1))
    println(strings.ToLower("Gopher"))
    println(strings.ToLower(""))
    println(strings.ToLower("ABC-XYZ@[`{"))
    println(strings.ToLower("already"))
    println(strings.ToLower("あA"))
    println(strings.ToUpper("Gopher"))
    println(strings.ToUpper(""))
    println(strings.ToUpper("abc-xyz@[`{"))
    println(strings.ToUpper("ALREADY"))
    println(strings.ToUpper("あa"))
    println(strings.EqualFold("Go", "GO"))
    println(strings.EqualFold("Go", "Ga"))
    println(strings.EqualFold("", ""))
    println(strings.EqualFold("a", ""))
    println(strings.EqualFold("@", "`"))
    println(strings.EqualFold("[", "{"))
    println(strings.EqualFold("Content-Type", "content-type"))
    println(strings.EqualFold("あA", "あa"))
    println(strings.EqualFold("abc", "abcd"))
}
