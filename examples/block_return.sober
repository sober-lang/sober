package main

// ブロック式の中からの値つき return（F-h — 2026-10-02 まで check が def error・build は受理）: ブロックの末尾の値が string のとき。
// F-f と同じ層（ブロックの末尾の型を点座標で読む — block_region_value）

func early(v bool) string {
    x := {
        if v {
            return "early"
        }
        "late"
    }
    return x + "!"
}

func main() {
    println(early(true), early(false))
}
