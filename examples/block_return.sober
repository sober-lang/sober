package main

// ブロック式の中からの値つき return の例: ブロックの末尾の値が string のとき。
// block_region_value と同じ層（ブロックの末尾の型を点座標で読む）

func early(v bool) string {
    x := {
        if v {
            return "early"
        }
        "late"
    }
    return x + "!"
}

func main() {
    println(early(true), early(false))
}
