package main

// 負例（language.md 22 / 270 行 — sum type の switch の網羅はコンパイラ）: 入れ子の型パターンが網羅していない（O1 の x が I2 の値が漏れる）のに
// wild（default / `_`）が無い。build は外れると値ゼロを返していた（入れ子の欄の中身を網羅の検査が見ていなかった）

type I union {
    I1{v int}
    I2{w int}
}

type O union {
    O1 {
        x I
        y int
    }
    O2{k int}
}

func g(o O) int {
    return switch o {
    case O1{x: I1{v}, y}: v + y
    case O2{k}: k
    }
}

func main() {
    println(g(O1{x: I2{w: 3}, y: 2}))
}
