package main

// 回帰: `?` の脱出と `T{}` が float の欄のゼロ値（0.0）を埋める（lower の requireZero は float のゼロ値も扱う）

type M struct {
    name string
    v float
}

type Bad error {}

func get(ok bool) (float, error?) {
    if !ok {
        return 0.0, Bad{}
    }
    return 2.5, nil
}

func load(ok bool) (M, error?) {
    v := get(ok)?
    return M{name: "m", v: v}, nil
}

func main() {
    a, ea := load(true)
    b, eb := load(false)
    z := M{}
    println(a.v, ea == nil, b.v, eb == nil, z.v)
}
