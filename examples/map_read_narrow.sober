package main

// mapの読み（値のT?）を絞ってからフィールドを読む

type P struct {
    rows []int
    name string
}

func rows(m map[string]P, k string) int {
    e := m[k]
    if e != nil {
        return len(e.rows)
    }
    return -1
}

func main() {
    m := map[string]P{"x": P{rows: []int{1, 2}, name: "x"}}
    println(rows(m, "x"), rows(m, "y"))
}
