package main

// 段 6 P3b: 全 task が待っている（受け手の子に誰も送らない）= 定義された死 `panic: Deadlock{}`（exit 101 — Kahn により有無はスケジュールに依らない）

import "std/par"

func main() {
    r, e := par.Scope((s par.S) => {
        tx, rx := par.NewChan[int](cap: 1)
        h := par.Spawn(s, (inp) => {
            v := par.Recv(inp)
            mut t := 0
            if v != nil {
                t = v
            }
            t
        }, give: rx)
        par.Join(h)
    })
    println(r)
}
