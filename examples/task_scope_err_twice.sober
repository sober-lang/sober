package main

// 2 つ目の scope の未回収の失敗の err が出口で scope の外へ写ること。子の結果の預かりの印を d - 1 にすると、
// 最適化の経路（loopLight が scope の本体の region の enter を消す — 確保しないので）で d - 1 = 外の深度になり写しが飛んで、解放済みの預かりを読む。
// 印の不変条件（印 X の値は深度 X の region 以上に生きる）の証人

import "std/task"

type Bad error {
    msg string
}

@errors(Bad)
func load(n int) (int, error?) {
    if n > 4 {
        return 0, Bad{msg: "too big: ${n}"}
    }
    return n * 10, nil
}

func report(r string, e error?) {
    if e == nil {
        println("${r} | nil")
        return
    }
    switch e {
    case Bad{msg}: println("${r} | Bad: ${msg}")
    default: println("${r} | ?")
    }
}

func main() {
    r1, e1 := task.Run((s task.Scope) => {
        7
    })
    println("${r1}")
    r2, e2 := task.Run((s task.Scope) => {
        b := task.Spawn(s, () => load(7))
        3
    })
    report("${r2}", e2)
}
