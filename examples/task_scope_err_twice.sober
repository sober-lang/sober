package main

// 2つ目のscopeの未回収の失敗のerrが出口でscopeの外へコピーされること。子の結果の預かりのマークをd - 1にすると、
// 最適化の経路（loopLightがscopeの本体のregionのenterを消す — 確保しないので）でd - 1 = 外の深度になりコピーが飛んで、解放済みの預かりを読む。
// マークの不変条件（マークXの値は深度Xのregion以上に生きる）の証人

import "std/task"

type Bad error {
    msg string
}

@errors(Bad)
func load(n int) (int, error?) {
    if n > 4 {
        return 0, Bad{msg: "too big: ${n}"}
    }
    return n * 10, nil
}

func report(r string, e error?) {
    if e == nil {
        println("${r} | nil")
        return
    }
    switch e {
    case Bad{msg}: println("${r} | Bad: ${msg}")
    default: println("${r} | ?")
    }
}

func main() {
    r1, e1 := task.Run((s task.Scope) => {
        7
    })
    println("${r1}")
    r2, e2 := task.Run((s task.Scope) => {
        b := task.Spawn(s, () => load(7))
        3
    })
    report("${r2}", e2)
}
