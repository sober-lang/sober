package main

// 型の別名と package（language.md 32 節「型の別名」・20 節）: 公開の別名は他の package の型（実体）を公開の名前で出す。
// 利用者は別名の package だけを import し、実体の package を書かない（loader が合成の import を足す）。公開の別名は非公開の型も指せる

import "testdata/alias/wrap"

func main() {
    mut w := testdata.alias.wrap.Work{}
    testdata.alias.wrap.Feed(mut w, 4)
    testdata.alias.wrap.Feed(mut w, 8)
    println(testdata.alias.wrap.Value(testdata.alias.wrap.Mean(w)))
    println(testdata.alias.wrap.Last(testdata.alias.wrap.NewAcc(5)))
}
