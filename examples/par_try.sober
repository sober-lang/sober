package main

// 段 6 P3a（language.md 11 節 — A1 (X)）: 死の扱いの 3 通り。par.Try は子の死を値（Outcome.Died）で見る・scope の err は
// 完走したが死んだ子（TaskDied）。build は即時形（P3a-2b — 子は Spawn の時点で走る）

import "std/par"

type Boom panic

func main() {
    a := 3
    r, err := par.Scope((s par.S) => {
        ok := par.Spawn(s, () => a * 2)
        bad := par.Spawn(s, () => {
            if a > 2 {
                panic(Boom{})
            }
            1
        })
        k := switch par.Try(bad) {
        case par.Ok{v}: v
        case par.Failed{}: 100
        case par.Died{cause}: 100
        }
        par.Join(ok) + k
    })
    if err != nil {
        println(0)
    }
    println(r)
}
