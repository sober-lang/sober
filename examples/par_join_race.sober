package main

// 段 6 P4-4: Join と子の終わりが別のワーカーでほぼ同時に起きる形を何度も（待ちの型 — 待ち手の xchg・見直し・起こし手の xchg — が起こし損ねないこと）。
// schedfuzz の変異の自己検査（--rt-mutant=2 = 登録と起こしを素の store / load に — 起こし損ねて止まる）の証人も兼ねる

import "std/par"

func work(n int) int {
    mut i := 0
    mut a := n
    while i < (n & 255) * 400 {
        a += i
        i += 1
    }
    return a
}

func main() {
    mut acc := 0
    mut i := 0
    while i < 300 {
        k := i
        r, e := par.Scope((s par.S) => {
            h := par.Spawn(s, () => work(k))
            // 親も同じくらい働いてから Join（子が別のワーカーで走り、終わりと Join が重なる）
            z := work(k * 7)
            par.Join(h) + z - z
        })
        acc += r
        i += 1
    }
    println(acc)
}
