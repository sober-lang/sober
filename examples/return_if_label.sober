package main

// 反復のregion（whileの本体）からの `return if c { nil } else { L{} }`。ラベルの値はcauseのチェーンが最内のregionに、
// nilは戻り型で作られるので、iteの両分岐の型が食い違っていた — returnのコピー（copyTo / ann）はifの分岐ごとに掛ける（check ≡ build）

type Closed error

type Bad error

@errors(Closed, Bad)
func scan(xs []int) error? {
    mut i := 0
    while i < len(xs) {
        if xs[i] < 0 {
            return if xs[i] == -1 { nil } else { Closed{} }
        }
        if xs[i] > 100 {
            return Bad{}
        }
        i += 1
    }
    return nil
}

func main() {
    println(scan([]int{1, 2, -1}) == nil)
    println(scan([]int{1, -2}) == nil)
    println(scan([]int{200}) == nil)
}
