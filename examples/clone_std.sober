    s_neg = append(s_neg, 0)
    s_neg = append(s_neg, -9007199254740991)
    showInts("neg.view", clone(s_neg))
    c_neg := clone(s_neg)
    s_neg[0] = -5
    showInts("neg.orig", freeze(s_neg))
    showInts("neg.clone", c_neg)
    mut w_neg := clone(c_neg)
    w_neg[0] = 4242
    w_neg = append(w_neg, 1)
    showInts("neg.rewrite", freeze(w_neg))
    showInts("neg.clone2", c_neg)
    mut s_grow := mut []int{}
    s_grow = append(s_grow, 0)
    s_grow = append(s_grow, 1)
    s_grow = append(s_grow, 4)
    s_grow = append(s_grow, 9)
    s_grow = append(s_grow, 16)
    s_grow = append(s_grow, 25)
    s_grow = append(s_grow, 36)
    s_grow = append(s_grow, 49)
    s_grow = append(s_grow, 64)
    s_grow = append(s_grow, 81)
    s_grow = append(s_grow, 100)
    s_grow = append(s_grow, 121)
    s_grow = append(s_grow, 144)
    s_grow = append(s_grow, 169)
    s_grow = append(s_grow, 196)
    s_grow = append(s_grow, 225)
    s_grow = append(s_grow, 256)
    s_grow = append(s_grow, 289)
    s_grow = append(s_grow, 324)
    s_grow = append(s_grow, 361)
    s_grow = append(s_grow, 400)
    s_grow = append(s_grow, 441)
    s_grow = append(s_grow, 484)
    s_grow = append(s_grow, 529)
    s_grow = append(s_grow, 576)
    s_grow = append(s_grow, 625)
    s_grow = append(s_grow, 676)
    s_grow = append(s_grow, 729)
    s_grow = append(s_grow, 784)
    s_grow = append(s_grow, 841)
    s_grow = append(s_grow, 900)
    s_grow = append(s_grow, 961)
    s_grow = append(s_grow, 1024)
    s_grow = append(s_grow, 1089)
    s_grow = append(s_grow, 1156)
    s_grow = append(s_grow, 1225)
    s_grow = append(s_grow, 1296)
    s_grow = append(s_grow, 1369)
    s_grow = append(s_grow, 1444)
    s_grow = append(s_grow, 1521)
    showInts("grow.view", clone(s_grow))
    c_grow := clone(s_grow)
    s_grow = append(s_grow, 41)
    s_grow = append(s_grow, 42)
    s_grow = append(s_grow, 43)
    s_grow[0] = 999
    showInts("grow.orig", freeze(s_grow))
    showInts("grow.clone", c_grow)
    mut w_grow := clone(c_grow)
    w_grow[0] = 4242
    w_grow = append(w_grow, 1)
    showInts("grow.rewrite", freeze(w_grow))
    showInts("grow.clone2", c_grow)
    mut t_words := mut []string{}
    t_words = append(t_words, "a")
    t_words = append(t_words, "bb")
    t_words = append(t_words, "ccc")
    d_words := clone(t_words)
    t_words = append(t_words, "dddd")
    t_words[0] = "changed"
    showStrs("words.orig", freeze(t_words))
    showStrs("words.clone", d_words)
    mut t_utf8 := mut []string{}
    t_utf8 = append(t_utf8, "あ")
    t_utf8 = append(t_utf8, "いう")
    t_utf8 = append(t_utf8, "")
    d_utf8 := clone(t_utf8)
    t_utf8 = append(t_utf8, "え")
    t_utf8[0] = "changed"
    showStrs("utf8.orig", freeze(t_utf8))
    showStrs("utf8.clone", d_utf8)
    mut m_empty := mut map[string]int{}
    n_empty := clone(m_empty)
    println("empty.order", sameOrder(keys(m_empty), keys(n_empty)))
    m_empty["x"] = 1
    showMap("empty.orig", freeze(m_empty), []string{"x"})
    showMap("empty.clone", n_empty, []string{"x"})
    mut m_small := mut map[string]int{}
    m_small["a"] = 1
    m_small["b"] = 2
    m_small["c"] = 3
    n_small := clone(m_small)
    println("small.order", sameOrder(keys(m_small), keys(n_small)))
    m_small["a"] = 10
    m_small["d"] = 4
    delete(m_small, "b")
    showMap("small.orig", freeze(m_small), []string{"a", "b", "c", "d"})
    showMap("small.clone", n_small, []string{"a", "b", "c", "d"})
    mut m_tomb := mut map[string]int{}
    m_tomb["k1"] = 1
    m_tomb["k2"] = 2
    m_tomb["k3"] = 3
    m_tomb["k4"] = 4
    delete(m_tomb, "k2")
    n_tomb := clone(m_tomb)
    println("tomb.order", sameOrder(keys(m_tomb), keys(n_tomb)))
    m_tomb["k2"] = 22
    delete(m_tomb, "k4")
    showMap("tomb.orig", freeze(m_tomb), []string{"k1", "k2", "k3", "k4"})
    showMap("tomb.clone", n_tomb, []string{"k1", "k2", "k3", "k4"})
    mut m_long := mut map[string]int{}
    m_long["long-key-for-the-clone-test-0"] = 0
    m_long["long-key-for-the-clone-test-1"] = 1
    m_long["long-key-for-the-clone-test-2"] = 2
    m_long["long-key-for-the-clone-test-3"] = 3
