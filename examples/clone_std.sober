    m_long["long-key-for-the-clone-test-7"] = 7
    m_long["long-key-for-the-clone-test-8"] = 8
    m_long["long-key-for-the-clone-test-9"] = 9
    m_long["long-key-for-the-clone-test-10"] = 10
    m_long["long-key-for-the-clone-test-11"] = 11
    delete(m_long, "long-key-for-the-clone-test-3")
    n_long := clone(m_long)
    println("long.order", sameOrder(keys(m_long), keys(n_long)))
    m_long["long-key-for-the-clone-test-0"] = 100
    delete(m_long, "long-key-for-the-clone-test-5")
    showMap("long.orig", freeze(m_long), []string{"long-key-for-the-clone-test-0", "long-key-for-the-clone-test-1", "long-key-for-the-clone-test-2", "long-key-for-the-clone-test-3", "long-key-for-the-clone-test-4", "long-key-for-the-clone-test-5", "long-key-for-the-clone-test-6", "long-key-for-the-clone-test-7", "long-key-for-the-clone-test-8", "long-key-for-the-clone-test-9", "long-key-for-the-clone-test-10", "long-key-for-the-clone-test-11"})
    showMap("long.clone", n_long, []string{"long-key-for-the-clone-test-0", "long-key-for-the-clone-test-1", "long-key-for-the-clone-test-2", "long-key-for-the-clone-test-3", "long-key-for-the-clone-test-4", "long-key-for-the-clone-test-5", "long-key-for-the-clone-test-6", "long-key-for-the-clone-test-7", "long-key-for-the-clone-test-8", "long-key-for-the-clone-test-9", "long-key-for-the-clone-test-10", "long-key-for-the-clone-test-11"})
    mut im := mut map[int]int{}
    im[3] = 30
    im[1] = 10
    im[2] = 20
    im[100] = 1000
    delete(im, 1)
    ic := clone(im)
    im[7] = 70
    im[3] = 33
    showIntMap("int.orig", freeze(im), []int{3, 1, 2, 100, 7})
    showIntMap("int.clone", ic, []int{3, 1, 2, 100, 7})
