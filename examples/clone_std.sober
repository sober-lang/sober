package main

// 生成物 — scripts/clone_oracle.ts（期待値 clone_std.out は Go の slices.Clone / maps.Clone の双子の出力）。手で直さない。
// 写した後に元を書き換えても写しは変わらないこと・元は凍らずに書き続けられること（clone は写すだけ — 元を凍らせない）・
// 写しは書ける（mut — imm の列からも書ける写しが取れる）・imm の位置に置いた clone(x) はその場で凍ること（showInts(…, clone(xs)) の形）を見る

func showInts(tag string, xs []int) {
    mut line := "${tag} ${len(xs)}:"
    for x <- xs {
        line = line + " ${x}"
    }
    println(line)
}

func showStrs(tag string, xs []string) {
    mut line := "${tag} ${len(xs)}:"
    for x <- xs {
        line = line + " [" + x + "]"
    }
    println(line)
}

func showMap(tag string, m map[string]int, ks []string) {
    mut line := "${tag} ${len(m)}:"
    for k <- ks {
        v := m[k]
        if v != nil {
            line = line + " " + k + "=${v}"
        }
    }
    println(line)
}

func showIntMap(tag string, m map[int]int, ks []int) {
    mut line := "${tag} ${len(m)}:"
    for k <- ks {
        v := m[k]
        if v != nil {
            line = line + " ${k}=${v}"
        }
    }
    println(line)
}

func sameOrder(a []string, b []string) bool {
    if len(a) != len(b) {
        return false
    }
    mut i := 0
    while i < len(a) {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    return true
}

func main() {
    mut s_empty := mut []int{}
    showInts("empty.view", clone(s_empty))
    c_empty := clone(s_empty)
    showInts("empty.orig", freeze(s_empty))
    showInts("empty.clone", c_empty)
    mut s_one := mut []int{}
    s_one = append(s_one, 7)
    showInts("one.view", clone(s_one))
    c_one := clone(s_one)
    s_one = append(s_one, 8)
    s_one[0] = 70
    showInts("one.orig", freeze(s_one))
    showInts("one.clone", c_one)
    mut w_one := clone(c_one)
    w_one[0] = 4242
    w_one = append(w_one, 1)
    showInts("one.rewrite", freeze(w_one))
    showInts("one.clone2", c_one)
    mut s_many := mut []int{}
    s_many = append(s_many, 1)
    s_many = append(s_many, 2)
    s_many = append(s_many, 3)
    s_many = append(s_many, 4)
    s_many = append(s_many, 5)
    showInts("many.view", clone(s_many))
    c_many := clone(s_many)
    s_many = append(s_many, 6)
    s_many = append(s_many, 7)
    s_many[0] = 100
    showInts("many.orig", freeze(s_many))
    showInts("many.clone", c_many)
    mut w_many := clone(c_many)
    w_many[0] = 4242
    w_many = append(w_many, 1)
    showInts("many.rewrite", freeze(w_many))
    showInts("many.clone2", c_many)
    mut s_neg := mut []int{}
