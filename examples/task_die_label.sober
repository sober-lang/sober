package main

// 段 6 P3a: 子の `panic(L{…})` を Join で受ける — 死因はラベルの名前（欄は運ばない — `L{…}`）と死んだ点の位置。
// 罠の中ではラベルを点で印字しない（死を受けるのは罠を張った側）

import "std/task"

type Boom panic {
    n int
}

func main() {
    k := 3
    r, e := task.Run((s task.Scope) => {
        h := task.Spawn(s, () => {
            if k > 2 {
                panic(Boom{n: k})
            }
            k
        })
        println(1)
        task.Join(h)
    })
    println(r)
}
