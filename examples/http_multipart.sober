package main

// multipart/form-data の受け（http.Multipart — RFC 7578）: ブラウザのファイルのアップロードの形（Chrome の境界の綴り・テキストの欄・ファイルの欄・
// 選ばなかったファイルの欄〔filename=""〕）を部分ごとに印字し、閉じの境界の無い本文は 400 を返す。
// ネットの代わりに recv が決まった要求の列を 1 切片で渡し、send が応答を印字する（examples/http_reqresp の形 — 行末の CR は外して印字）

import "std/http"
import "std/iter"

func upload(r http.Request) http.Response {
    parts := http.Multipart(r) catch return http.Status(http.BadRequest)
    mut out := ""
    for i <- iter.Range(0, len(parts)) {
        p := parts[i]
        f := p.filename
        kind := if f == nil { "field" } else { "file \"${f}\" (${p.contentType})" }
        out = out + "${p.name}: ${kind} ${len(p.body)} bytes\n"
    }
    return http.Text(out)
}

func show(b []byte) error? {
    mut out := mut []byte{}
    for x <- b {
        if x != '\r' {
            out = append(out, x)
        }
    }
    println(string(freeze(out)) catch "?")
    return nil
}

func feed(s string, k func([]byte)) error? {
    k(bytes(s))
    return nil
}

func main() {
    bd := "----WebKitFormBoundary7MA4YWxkTrZu0gW"
    body := "--${bd}\r\nContent-Disposition: form-data; name=\"title\"\r\n\r\nholiday\r\n" +
        "--${bd}\r\nContent-Disposition: form-data; name=\"photo\"; filename=\"beach.txt\"\r\nContent-Type: text/plain\r\n\r\nsand\r\nsea\r\n" +
        "--${bd}\r\nContent-Disposition: form-data; name=\"extra\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n" +
        "--${bd}--\r\n"
    broken := "--${bd}\r\nContent-Disposition: form-data; name=\"title\"\r\n\r\nholiday\r\n"
    ct := "multipart/form-data; boundary=${bd}"
    reqs := "POST /upload HTTP/1.1\r\nContent-Type: ${ct}\r\nContent-Length: ${len(bytes(body))}\r\n\r\n${body}" +
        "POST /upload HTTP/1.1\r\nContent-Type: ${ct}\r\nContent-Length: ${len(bytes(broken))}\r\nConnection: close\r\n\r\n${broken}"
    e := http.ServeWith((k) => feed(reqs, k), (b) => show(b), (r) => upload(r))
    println(e == nil)
}
