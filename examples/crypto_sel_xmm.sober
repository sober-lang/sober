package main

// xmm を作業に使う塊（std/crypto/rsa の表引き mmsel）を含む呼び出しを、float を 14 本 xmm に持ったまま跨ぐ（塊を含む関数が
// 呼び手の xmm2〜15 を退避すること — 退避しないと float が壊れる）
import "std/crypto/rsa"
import "std/iter"

func main() {
    mut s := 0
    for r <- iter.Range(0, 3) {
        a := float(r) + 1.5
        b := a * 2.0
        c := b + 0.25
        d := c * 3.0
        f := d - 1.0
        g := f * 0.5
        h := g + 7.0
        i := h * 1.25
        j := i - 2.0
        k := j * 1.5
        l := k + 0.75
        m := l * 2.5
        n := m - 3.0
        o := n * 1.125
        s = s + rsa.SelSelfCheck(r + 1, 16)
        println(a + b + c + d + f + g + h + i + j + k + l + m + n + o)
    }
    println(s)
}
