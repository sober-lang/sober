package main

// 検証例: callee のフレームで作った入れ子のコンテナ（中身もフレームで作ったもの）を返す。
// 戻りの境界コピーが中身ごと呼び手の region へ写る。

import "std/convert"

// "w0" .. "w{n-1}" を callee のフレームで作って返す（[]string — 中身の string もフレーム）
func words(n int) []string {
    mut out := mut []string{}
    mut i := 0
    while i < n {
        out = append(out, "w" + convert.FormatInt(i))
        i += 1
    }
    return out
}

// n × n の九九の表を返す（[][]int）
func grid(n int) [][]int {
    mut rows := mut [][]int{}
    mut i := 1
    while i <= n {
        mut row := mut []int{}
        mut j := 1
        while j <= n {
            row = append(row, i * j)
            j += 1
        }
        rows = append(rows, row)
        i += 1
    }
    return rows
}

// 2 段の呼び出し越しに転送する（call 結果の再転送 — 深く締めた型が一致する）
func twice(n int) [][]int {
    return grid(n)
}

func main() {
    ws := words(3)
    println("${len(ws)} ${ws[0]} ${ws[2]}")
    g := twice(4)
    println("${len(g)} ${g[1][2]} ${g[3][3]}")
}
