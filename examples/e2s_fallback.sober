package main

// E2-Sの逃げ（docs/formal.md「checkのcallMのフェーズ」の条件6）の検証例: renameは上げる条件1〜5を満たすが、Defとして型が付かないので展開へ戻る（周回2回）

import "std/convert"

type S struct {
    name string
    n int
}

// mut仮引数のフィールドへ、本体で組んだstringを入れる — 展開なら呼び手の最内regionに置かれて通るが、callMのDef（自分のregionを開く）では
// フレームの値を呼び手空間のフィールドへ入れることになり型が付かない → E2-Sの逃げで展開へ戻る
func rename(x mut S, k int) {
    x.name = "v" + convert.FormatInt(k)
    x.n = k
}

func main() {
    mut s := S{name: "a", n: 0}
    rename(mut s, 7)
    println(s.name)
    println(s.n)
}
