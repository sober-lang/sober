package main

// 本体が走っている間は、子の死で兄弟の io の待ちを切らない（language.md 28 節「子の死で待ちを切る」— 切るのは本体が出口に着いた後だけ）。
// 本体は死んだ子を task.Try で値として見て続け、待っている兄弟（accept と受け）へ繋いで送り、兄弟の決着も Try で待つ。兄弟は切られずに受け取る（done）。
// 本体がそのまま出口へ行く形（examples/net_sibcut）では、同じ兄弟の待ちが切れる

import "std/io"
import "std/net"
import "std/os"
import "std/task"

func main() {
    port := freePort() catch 0
    _, e := task.Run((s task.Scope) => {
        r := task.Spawn(s, () => receiver(port))
        h := task.Spawn(s, () => dier())
        switch task.Try(h) {
        case task.Ok{v}: println("body: ok ${v}")
        case task.Failed{}: println("body: failed")
        case task.Died{}: println("body: saw the death")
        }
        // 死を見た後も本体は続ける: 兄弟へ繋いで送る（兄弟は切られていない）
        println("body: send ${label(sendTo(port, "hello"))}")
        // 受け手の決着も本体の中で待つ（出口に着くのはその後 — 受け手の待ちは本体が走っている間なので切れない）
        _ = task.Try(r)
        0
    })
    println("scope died=${e != nil}")
}

func dier() int {
    os.Sleep(20)
    xs := []int{1}
    return xs[9]
}

func freePort() (int, error?) {
    mut port := 0
    for l <- net.Listen("127.0.0.1:0")? {
        port = net.Port(l)
    }
    return port, nil
}

// 1 本だけ受けて、届いた分を印字する
func receiver(port int) int {
    println("receiver: ${label(acceptOne(port))}")
    return 0
}

func acceptOne(port int) error? {
    for l <- net.Listen("127.0.0.1:${port}")? {
        for c <- net.Accept(l)? {
            for chunk <- net.Recv(c)? {
                println("receiver: got ${string(chunk) catch "?"}")
                break
            }
            break
        }
        break
    }
    return nil
}

// 繋がるまで試して（受け手の listen を待つ）、送る
func sendTo(port int, msg string) error? {
    mut tries := 0
    while tries < 200 {
        e := sendOnce(port, msg)
        if e == nil {
            return nil
        }
        tries += 1
        os.Sleep(10)
    }
    return io.Timeout{}
}

func sendOnce(port int, msg string) error? {
    for c <- net.Dial("127.0.0.1:${port}")? {
        net.Send(c, bytes(msg))?
    }
    return nil
}

func label(e error?) string {
    return switch e {
    case nil: "done"
    case io.Expired{}: "expired"
    case io.Timeout{}: "timeout"
    case io.Closed{}: "closed"
    case io.Denied{}: "denied"
    case io.Other{errno}: "errno ${errno}"
    case net.Bad{}: "bad"
    }
}
