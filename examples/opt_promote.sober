package main

// ループの中のメモリの積算のレジスタ昇格（promote.sober）の網（scripts/optdiff.sh --mut の代表）:
//   pairs: 天体の組の積算（nbody の形 — j は i + 1 から・a[o + k] の読み書きを昇格・a[o + 3] は読みだけの不変番地）
//   alias: j が i から始まる（j = i で a[p + 1] と a[o + 1] が同じ番地 — 昇格すると読み書きの順が変わって値が変わる。昇格してはいけない形）
//   spare: i の最後の回は o が範囲外だが内側が 0 回（前置きの読み込みが範囲外を読んではいけない — 守りの網）
//   early: 内側の break（出口が 2 つ — 両方で書き戻す）

import "std/iter"

const N = 4
const W = 4

func pairs(a mut []int) {
    for i <- iter.Range(0, N) {
        o := i * W
        for j <- iter.Range(i + 1, N) {
            p := j * W
            d := a[o] - a[p] + a[o + 3]
            a[o + 1] = a[o + 1] + d
            a[o + 2] = a[o + 2] - d * 2
            a[p + 1] = a[p + 1] - d
            a[p + 2] = a[p + 2] + a[o + 1]
        }
    }
}

func alias(a mut []int) {
    for i <- iter.Range(0, N) {
        o := i * W
        for j <- iter.Range(i, N) {
            p := j * W
            a[o + 1] = a[o + 1] + a[p] + 1
            a[p + 1] = a[p + 1] * 3
        }
    }
}

func spare(a mut []int) {
    for i <- iter.Range(0, N + 1) {
        o := i * W
        for j <- iter.Range(i + 1, N) {
            p := j * W
            a[o + 1] = a[o + 1] + a[p]
        }
    }
}

func early(a mut []int) {
    for i <- iter.Range(0, N) {
        o := i * W
        for j <- iter.Range(i + 1, N) {
            p := j * W
            a[o + 2] = a[o + 2] + a[p] + 1
            if a[o + 2] > 40 {
                break
            }
        }
    }
}

func show(a mut []int) {
    mut s := ""
    for k <- iter.Range(0, len(a)) {
        s = s + " ${a[k]}"
    }
    println(s)
}

func main() {
    mut a := mut []int{0, 7, 3, 10, 6, 2, 9, 5, 1, 8, 4, 0, 7, 3, 10, 6}
    pairs(mut a)
    show(mut a)
    mut b := mut []int{0, 7, 3, 10, 6, 2, 9, 5, 1, 8, 4, 0, 7, 3, 10, 6}
    alias(mut b)
    show(mut b)
    mut c := mut []int{0, 7, 3, 10, 6, 2, 9, 5, 1, 8, 4, 0, 7, 3, 10, 6}
    spare(mut c)
    show(mut c)
    mut d := mut []int{0, 7, 3, 10, 6, 2, 9, 5, 1, 8, 4, 0, 7, 3, 10, 6}
    early(mut d)
    show(mut d)
}
