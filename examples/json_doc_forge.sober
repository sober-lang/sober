package main

// 負例（loaderが拒否 — diag.Sealed）: json.DocはParseだけが作る証人 — 外からcompositeで偽造できない（非公開の型の封のフィールドsealを持つ封の型は、
// 外ではフィールドつきのリテラルを書けない。部分リテラルの解禁でも封のフィールドをゼロ値で埋める形は拒否する — language.md 15 節）

import "std/json"

func main() {
    d := json.Doc{src: bytes("1"), esc: []byte{}, kind: []int{3}, a: []int{0}, b: []int{1}, pos: []int{0}, kids: []int{}}
    println(json.Pos(d, 0))
}
