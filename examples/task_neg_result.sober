package main

// taskの結果がコピーできない（関数値 — diag.Par kind 8 — checkとbuildが同じ拒否。desugar/parcheck.sober）。
// string・slice・map・errorはscopeのregionへコピーできる（examples/task_result_string）

import "std/task"

func inc(x int) int {
    return x + 1
}

func pick() func(int) int {
    return inc
}

func main() {
    r, e := task.Run((s task.Scope) => {
        h := task.Spawn(s, () => pick())
        task.Join(h)(1)
    })
    println(r)
}
