package main

// 借りの関数型仮引数（(α-L0) — language.md 25 節「借り」）: Stream の匿名の関数型の仮引数 emit は借り。
// ServeConn の形（serve）が渡す emit は Conn を捕捉してよい借りの閉包・stream 本体の早期脱出は名前付き関数へ（sendBody — 借りの emit を展開の仮引数へ転送 = η）。
// build は lower の閉包の値形（借りの env = 借りの位置の関数型の構造ごとの閉じた union — lower/closure.sober）

import "std/net"
import "std/iter"

type Stream func(emit func(b []byte) error?) error?

type Resp struct {
    status int
    stream Stream?
}

func sendBody(path string, n int, emit func(b []byte) error?) error? {
    for i <- iter.Range(0, n) {
        emit(bytes(path))?
    }
    return nil
}

func handle(path string) Resp {
    return Resp{status: 200, stream: (emit) => sendBody(path, 3, emit)}
}

func serve(c net.Conn, r Resp) error? {
    st := r.stream
    if st != nil {
        return st((b []byte) => net.Send(c, b))
    }
    return nil
}

func run() error? {
    for l <- net.Listen("127.0.0.1:0")? {
        for c <- net.Dial("127.0.0.1:${net.Port(l)}")? {
            serve(c, handle("/abc"))?
        }
    }
    return nil
}

func main() { _ = run() }
