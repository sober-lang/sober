package main

// R31: os.Args — 0番 = プログラム名（配置先で変わるので印字しない）。引数ありの照合はscripts/io_args.sh
// （実行ハーネスは引数を渡さないので、ここでの .out は引数なしの形）。不正な UTF-8 の引数があれば全体が strings.BadUtf8、終了コード 2

import "std/os"
import "std/strings"

func main() int {
    args, err := os.Args()
    if err != nil {
        switch err {
        case strings.BadUtf8{pos}: println("invalid utf-8 at ${pos}")
        }
        return 2
    }
    println("${len(args) - 1} args")
    mut i := 1
    while i < len(args) {
        println("[${i}] ${args[i]} (${len(bytes(args[i]))} bytes)")
        i += 1
    }
    return 0
}
