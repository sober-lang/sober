package main

// 負例（checkが専用の診断で拒否 — diag.TypeMismatch kind 1）: stringの値のswitchは言語に無い（language.md 15 節 — 単値のsubjectは
// int〔default 必須〕/ union / error / T?）。文字列の分岐は if / else if で書く。

func route(p string) int {
    return switch p {
    case "/stream": 1
    case "/json": 2
    default: 0
    }
}

func main() {
    println("${route("/json")} ${route("/x")}")
}
