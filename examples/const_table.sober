package main

// 組み立ての const の表（language.md 25 節）: コマンドの表を const の struct と slice で書く — 欄に名前付き関数の参照とラムダ、
// 同じ const（フラグ・ラムダを持つ辞書）を複数の表から参照する。参照する点で組み立てるが、持ち上げたラムダは 1 本に寄せる
type Flag struct {
    name string
    help string
}

type Command struct {
    name string
    flags []Flag
    run func(int) int
}

type App struct {
    name string
    version string
    commands []Command
}

const Out = Flag{name: "o", help: "write to <file>"}

const Quiet = Flag{name: "q", help: "say less"}

const Twice = Command{name: "twice", flags: []Flag{Out}, run: (x) => x * 2}

const Build = Command{name: "build", flags: []Flag{Out, Quiet}, run: build}

const Tool = App{name: "tool", version: "0.1.0", commands: []Command{Build, Twice, Command{name: "id", run: (x) => x}}}

func build(n int) int {
    return n + 100
}

func find(a App, name string) int {
    mut i := 0
    while i < len(a.commands) {
        if a.commands[i].name == name {
            return i
        }
        i += 1
    }
    return 0 - 1
}

func main() {
    t := Tool
    println(t.name + " " + t.version, len(t.commands))
    for c <- t.commands {
        println(c.name, len(c.flags), c.run(5))
    }
    println(find(Tool, "twice"), find(Tool, "nope"))
    // 同じラムダを別の参照から
    println(Twice.run(21), Tool.commands[1].run(4))
}
