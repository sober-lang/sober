package main

// 段 6 P4-2 (O1): chan で待つ子の印字。stdout = spawn の木の先行順 — 子の流れ全体が spawn の位置に入り、親が spawn の後に書いた行は
// 子が終わるまで溜まる（P3b の共有の行バッファでは「待った時点で交互」だった — 今はスケジュールに依らない）

import "std/par"

func main() {
    println("start")
    r, e := par.Scope((s par.S) => {
        tx, rx := par.NewChan[int](cap: 1)
        h := par.Spawn(s, (inp) => {
            println("kid waits")
            mut sum := 0
            mut k := 0
            while k < 3 {
                v := par.Recv(inp)
                if v != nil {
                    println("kid got ${v}")
                    sum += v
                }
                k += 1
            }
            println("kid done")
            sum
        }, give: rx)
        mut i := 1
        while i <= 3 {
            println("parent sends ${i}")
            par.Send(tx, i * 10)
            i += 1
        }
        println("parent joins")
        par.Join(h)
    })
    println("sum ${r}")
}
