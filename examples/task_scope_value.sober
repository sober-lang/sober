package main

// scopeの本体の値の境界コピー（regionを持つ値 — 子の結果はscopeのregionへコピーされるので、その値をscopeの値に
// するとscopeのregionを指す）。出口で親の最内へコピーしないと、同じ深度で開き直したregionが上書きしてゴミになる

import "std/convert"
import "std/task"

func main() {
    mut out := mut []string{}
    mut i := 0
    while i < 4 {
        k := i
        a, e1 := task.Run((s) => {
            h := task.Spawn(s, () => "v" + convert.FormatInt(k) + "-xxxxxxxx")
            task.Join(h)
        })
        mut j := 0
        n, e2 := task.Run((s) => {
            mut ys := mut []string{}
            while j < 30 {
                ys = append(ys, "Q" + convert.FormatInt(j))
                j += 1
            }
            len(ys)
        })
        if e1 == nil && e2 == nil && n == 30 {
            out = append(out, a)
        }
        i += 1
    }
    // sliceの値（中身ごとコピーされる）
    c := i
    xs, e3 := task.Run((s) => {
        h := task.Spawn(s, () => []string{"p", "q" + convert.FormatInt(c)})
        task.Join(h)
    })
    _, e4 := task.Run((s) => {
        mut zs := mut []string{}
        mut q := 0
        while q < 20 {
            zs = append(zs, "ZZZZZZZZZZ")
            q += 1
        }
        len(zs)
    })
    mut q := 0
    while q < len(out) {
        println(out[q])
        q += 1
    }
    if e3 == nil && e4 == nil {
        println(xs[0] + xs[1])
    }
}
