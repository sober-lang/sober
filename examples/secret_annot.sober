package main

// 秘密の値の宣言の面（language.md 12 節「秘密の値の流れ」）: 関数の前置 `@secret(仮引数の名前…)`・struct の欄の後置 `@secret`・`@secret const`。
// この例は構文だけを確認する（読んで木に載せる）— 値の流れの検査は別途 analyzer が行う

type Key struct {
    id int
    k []byte @secret
}

@secret
const Pepper = 7

// k と salt は関数の中で源（呼び手に約束は課さない）。分岐・添字・除算に使わず、xor と加算だけで混ぜる
@secret(k, salt)
func mix(k []byte, salt int) int {
    mut acc := salt
    for b <- k {
        acc = acc ^ int(b)
    }
    return acc
}

func main() {
    key := Key{id: 1, k: []byte{3, 5, 6}}
    println(mix(key.k, Pepper))
    println(key.id)
}
