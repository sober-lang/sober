package main

// 関数の本体の par（Def の本体の解禁 — Lean の noNewchan を緩めて許可）。仮引数（imm）を子へ渡す・
// mut の仮引数を持つ関数の中で scope を開く（mut は捕獲しない — 結果を親が書く）・再帰の中の scope

import "std/task"

func work(n int, name string) int {
    r, e := task.Run((s task.Scope) => {
        a := task.Spawn(s, () => n * 10)
        b := task.Spawn(s, () => len(bytes(name)))
        task.Join(a) + task.Join(b)
    })
    if e != nil {
        return -1
    }
    return r
}

func acc(xs mut []int, k int) {
    r, e := task.Run((s task.Scope) => task.Join(task.Spawn(s, () => k * k)))
    if e == nil {
        xs = append(xs, r)
    }
}

func sum(n int) int {
    if n == 0 {
        return 0
    }
    r, e := task.Run((s task.Scope) => task.Join(task.Spawn(s, () => n)))
    return if e != nil { -1 } else { r + sum(n - 1) }
}

func main() {
    println(work(4, "abc"))
    mut xs := mut []int{}
    acc(mut xs, 3)
    acc(mut xs, 5)
    println(xs[0] + xs[1])
    println(sum(10))
}
