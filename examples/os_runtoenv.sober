package main

// std/os.RunToEnv: 子の環境を「足した `NAME=値` の列 → 親の環境のうち同名の無いもの」にする（同名は足した側が勝つ — 親の同名は渡さないので、
// 子がシェルでも getenv(3) でも同じ値を読む。足した列の中の同名は先の 1 つ）。os.Monotonic: 単調時計（同じプロセスの 2 点の差だけに意味がある）
import "std/io"
import "std/os"

func show(path string) {
    b := io.ReadFile(path) catch return
    _ = io.WriteStdout(b)
}

func main() {
    d := runDir("os_runtoenv")
    defer removeAll(d)
    o := d + "/o"
    sh := "echo \"X=[$SOBER_EX_X] Y=[$SOBER_EX_Y]\""
    a, _ := os.RunToEnv("/bin/sh", []string{"-c", sh}, []string{"SOBER_EX_X=one", "SOBER_EX_X=two", "SOBER_EX_Y=three"}, o, o)
    println(a)
    show(o)
    // 足す列が空なら親の環境のまま（RunTo と同じ）
    b, _ := os.RunToEnv("/bin/sh", []string{"-c", sh}, []string{}, o, o)
    println(b)
    show(o)
    t0 := os.Monotonic()
    println(os.Monotonic() >= t0)
}

// 実行ごとの置き場 out/<name>.<単調時計の値>（同じ作業ディレクトリで同時に走る実行どうしが上書きし合わない）。
// mkdirは既にあれば失敗するので、作れた名前がこの実行のもの。作れない状態で回り続けないよう、試す回数に上限を置く（作れなければ ""）
func runDir(name string) string {
    _ = os.Mkdir("out")
    mut n := 0
    while n < 100 {
        c := "out/${name}.${os.Monotonic()}"
        if os.Mkdir(c) == nil {
            return c
        }
        n = n + 1
    }
    return ""
}

// 置き場を中身ごと消す
func removeAll(d string) {
    if d != "" {
        _ = os.Run("/bin/rm", []string{"-rf", d}) catch 0
    }
}
