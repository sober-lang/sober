package main

// デッドライン（language.md 28 節「デッドライン」）: `task.Run(body, deadline: d)` の中（子孫の task も）では、期限の後に開いた
// io の口が io.Expired を返す。走っている仕事は切らない（待ちの上限であって実行時間の上限ではない）・入れ子は早い方・scope の外には効かない。
// 網は時刻に依らない両端だけ: 期限 0（必ず来る）・1 時間（必ず来ない）・1 ms + 20 ms 眠ってから（必ず来る）

import "std/io"
import "std/iter"
import "std/os"
import "std/task"

const hour = 3600000 * task.MS

func show(e error?) string {
    return switch e {
    case nil: "ok"
    case io.Timeout{}: "timeout"
    case io.Expired{}: "expired"
    case io.NotFound{}: "not found"
    case io.Denied{}: "denied"
    case io.Other{errno}: "errno ${errno}"
    }
}

// io の口を 1 回開く（読めれば ok）
func probe() string {
    _, e := io.ReadFile("testdata/io/hello.txt")
    return show(e)
}

// 純な仕事（期限の後も切られずに最後まで走る）
func spin(n int) int {
    mut s := 0
    for i <- iter.Range(0, n) {
        s += i % 7
    }
    return s
}

func main() {
    // 両端
    a, _ := task.Run((s task.Scope) => probe(), deadline: 0)
    b, _ := task.Run((s task.Scope) => probe(), deadline: hour)
    println("zero: ${a}, hour: ${b}")
    // 入れ子は早い方（外が先 / 内が先 / どちらも来ない）
    c, _ := task.Run((s task.Scope) => {
        x, _ := task.Run((t task.Scope) => probe(), deadline: hour)
        x
    }, deadline: 0)
    d, _ := task.Run((s task.Scope) => {
        x, _ := task.Run((t task.Scope) => probe(), deadline: 0)
        x
    }, deadline: hour)
    f, _ := task.Run((s task.Scope) => {
        x, _ := task.Run((t task.Scope) => probe(), deadline: hour)
        x
    }, deadline: hour)
    println("outer first: ${c}, inner first: ${d}, neither: ${f}")
    // 内の scope を抜けたら外の期限に戻る
    g, _ := task.Run((s task.Scope) => {
        _, _ = task.Run((t task.Scope) => probe(), deadline: 0)
        probe()
    }, deadline: hour)
    println("after the inner scope: ${g}")
    // 子は期限を継ぐ（Spawn / Map）
    h, _ := task.Run((s task.Scope) => task.Join(task.Spawn(s, () => probe())), deadline: 0)
    ms, _ := task.Run((s task.Scope) => {
        ys, _ := task.Map([]int{1, 2, 3}, (x) => "${x} ${probe()}")
        ys
    }, deadline: 0)
    println("spawned: ${h}, mapped: ${ms[0]} / ${ms[1]} / ${ms[2]}")
    // 純な仕事は期限の後も最後まで走る（切らない）
    p, _ := task.Run((s task.Scope) => spin(1000000), deadline: 0)
    println("pure: ${p}")
    // 期限の後に眠り明けで開いた口（1 ms の期限・20 ms 眠る — 必ず来る）
    q, _ := task.Run((s task.Scope) => {
        os.Sleep(20)
        probe()
    }, deadline: task.MS)
    println("slept: ${q}")
    // 書きの口も同じ（Writer は書かずに失敗を貯め、Flush が Timeout を返す）
    w, _ := task.Run((s task.Scope) => {
        mut out := io.Writer{}
        io.WriteString(mut out, "never written\n")
        show(io.Flush(mut out))
    }, deadline: 0)
    println("flush: ${w}")
    // scope の外には効かない
    println("outside: ${probe()}")
}
