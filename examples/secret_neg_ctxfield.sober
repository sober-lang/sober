package main

// 文脈フィールドの負例: 秘密の文脈でmutの仮引数のフィールドへ書いた値は、呼び手の実引数のフィールドの秘密（同じ型を公開の文脈で使う所とは分けても、ここは秘密）

type Acc struct {
    h int
}

func write(a mut Acc, x int) {
    a.h = a.h ^ x
}

@secret(k)
func use(k int) {
    mut a := Acc{h: 0}
    write(mut a, k)
    if a.h == 0 {
        println("zero")
    }
}

func main() {
    use(3)
}
