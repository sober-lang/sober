package main

// structのフィールドから束縛した `U?`（Uはstruct）を絞ってフィールドを読む
// （declOfExprのフィールドの読み出しが `U?` のフィールドの中身の宣言を返す — 仮引数の `U?` の束縛と同じ）

type P struct {
    x int
}

type S struct {
    o P?
    n int?
}

func main() {
    s := S{o: P{x: 3}, n: nil}
    o := s.o
    if o != nil {
        println(o.x)
    }
    t := S{o: nil, n: 4}
    u := t.o
    if u != nil {
        println(u.x)
    } else {
        println("none")
    }
}
