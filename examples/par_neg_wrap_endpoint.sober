package main

// 段 6 P5-2 入口: struct の欄に包んだ端点の捕獲（diag.Par kind 15） — check と build が同じ名指しで拒否（desugar/parcheck.sober）。縮退の前提「縮退した子が待てるのは自分の子孫だけ」の柵

import "std/par"

type W struct {
    rx par.Rx[int]
}

func main() {
    r, e := par.Scope((s par.S) => {
        tx, rx := par.NewChan[int](cap: 1)
        w := W{rx: rx}
        h := par.Spawn(s, () => {
            v := par.Recv(w.rx)
            if v != nil { v } else { 0 }
        })
        par.Send(tx, 3)
        par.Join(h)
    })
    println(r)
}
