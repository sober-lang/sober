package main

// F-aj（並列 1.0× 便）: Def の本体の par（Map・Scope + Spawn + Join）と、slice を欄に持つ error ラベル（Missing の string）が
// 同じプログラムにある形。Scope の「子が死んだ」側の腕で組む ChildDied の注釈が宣言の形（region 0）のままで、Def の本体（点が region 0 でない）
// では腕の型が食い違って check が def error だった（main の本体では通る・build は受理）

import "std/task"

type Missing error {
    pos int
    field string
}

func scan(b []byte, k int) int {
    return if b[k] == 'b' { k } else { -1 }
}

func first(b []byte) int {
    ats, e := task.Map([]int{0, 1, 2}, (k) => scan(b, k))
    if e != nil {
        return -2
    }
    mut at := -1
    mut k := 0
    while k < len(ats) {
        if at < 0 && ats[k] >= 0 {
            at = ats[k]
        }
        k += 1
    }
    return at
}

func joined(x int) int {
    r, e := task.Run((s task.Scope) => {
        h := task.Spawn(s, () => x * 2)
        task.Join(h)
    })
    if e != nil {
        return -2
    }
    return r
}

@errors(Missing)
func need(x int) (int, error?) {
    if x < 0 {
        return 0, Missing{pos: x, field: "f"}
    }
    return x, nil
}

func main() int {
    v := need(first(bytes("abc"))) catch return 1
    w := need(joined(v)) catch return 1
    println("${v} ${w}")
    _, err := need(-1)
    if err != nil {
        println("missing")
    }
    return 0
}
