package main

// 段 6 P4-2 (O1): 死の時点の溜め — 子 a が chan で待ったまま親が死ぬ（Join した子 b の死 = 親の死）。終わりの前に溜めた区間を先行順で全部出す
// （b の行・親の行は a の区間の後ろに溜まっていた）

import "std/par"

func boom(xs []int, i int) int {
    println("b runs")
    return xs[i]
}

func main() {
    println("start")
    r, e := par.Scope((s par.S) => {
        tx, rx := par.NewChan[int](cap: 1)
        a := par.Spawn(s, (inp) => {
            println("a waits")
            v := par.Recv(inp)
            mut got := 0
            if v != nil {
                got = v
            }
            got
        }, give: rx)
        b := par.Spawn(s, () => boom([]int{1}, 3))
        println("parent joins b")
        x := par.Join(b)
        par.Send(tx, 1)
        x + par.Join(a)
    })
    println(r)
}
