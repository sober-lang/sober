package main

// std/quick の fuzz の仕組み（sober fuzz — language.md 35 節）: quick.Check を持つ実行ファイルは、引数の `quick:` の指示で自分を子として走らせ直す。
// ここでは main が自分を駆動役（quick:fuzz=<ms>）で走らせる — 100 試行では出ない稀な panic（試行 802）を束の二分探索で見つけ、シュリンクした反例を
// 子の標準エラーへ報告して終了コード 101 で終わる。引数なしの回は試行 100 で通る

import "std/io"
import "std/os"
import "std/strings"
import "std/quick"

func main() {
    args := os.Args() catch panic(Unreachable{})
    mut q := quick.Seed(0)
    quick.Check(mut q, () => {
        xs := quick.Slice(mut q, 8, () => quick.Int(mut q, 0, 20))
        if len(xs) >= 3 && xs[0] == 17 && xs[2] == 5 {
            ys := []int{1}
            ys[xs[1] + 5] == 1
        } else {
            true
        }
    })
    if len(args) == 1 {
        println("100 trials passed")
        // 子の出力の置き場は実行ごとに別のディレクトリにする（同じ作業ディレクトリで同時に走る実行どうしが上書きし合わない）。
        // mkdir は既にあれば失敗するので、作れた名前がこの実行のもの。作れない状態で回り続けないよう、試す回数に上限を置く
        _ = os.Mkdir("out")
        mut d := ""
        mut n := 0
        while d == "" && n < 100 {
            c := "out/quick_fuzz.${os.Monotonic()}"
            if os.Mkdir(c) == nil {
                d = c
            }
            n = n + 1
        }
        ec := os.RunTo(args[0], []string{"quick:fuzz=60000", "quick:tmp=${d}"}, d + "/o", d + "/e") catch -1
        println("fuzz: exit ${ec}")
        e := io.ReadFile(d + "/e") catch []byte{}
        _ = os.Remove(d + "/o")
        _ = os.Remove(d + "/e")
        _ = os.RemoveDir(d)
        for ln <- strings.Split(string(e) catch "", "\n") {
            if strings.HasPrefix(ln, "quick:") || strings.HasPrefix(ln, "    Int") {
                println(ln)
            }
        }
    }
}
