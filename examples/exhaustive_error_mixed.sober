package main

// 表の網羅（language.md 13 節「表の網羅」）: 分岐のラベルが2つのpackageに跨るerrorのswitchは閉じた集合が定まらないので素通し
// （mainのBusyとstd/ioのNotFound — ioの他のラベルもmainの他のラベルも列挙しなくてよい）

import "std/io"

type Busy error {}
type Idle error {}

@exhaustive
func name(e error?) string {
    return switch e {
    case nil: "ok"
    case Busy{}: "busy"
    case io.NotFound{}: "not found"
    default: "other"
    }
}

func open(p string) error? {
    if p == "" {
        return Busy{}
    }
    if p == "-" {
        return Idle{}
    }
    f := io.Open(p)?
    defer io.Close(f)
    return nil
}

func main() {
    println(name(open("")))
    println(name(open("-")))
    println(name(open("/nonexistent/x")))
}
