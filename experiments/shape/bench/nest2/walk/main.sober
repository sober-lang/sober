package main

// 実験3（shape-m0）の題材 nest2・形 walk。gen.ts の生成物

import "std/builder"
import "std/iter"
import "std/json"

type Leaf struct {
    z0 int
    z1 string
    z2 int
    z3 string
}

type Mid struct {
    y0 int
    y1 string
    y2 Leaf
    y3 int
}

type R struct {
    x0 int
    x1 string
    x2 Mid
    x3 string
}

func mk(i int) R {
    return R{x0: i + 10, x1: "s11_${i % 100}", x2: Mid{y0: i + 120, y1: "s121_${i % 100}", y2: Leaf{z0: i + 1220, z1: "s1221_${i % 100}", z2: i + 1222, z3: "s1223_${i % 100}"}, y3: i + 123}, x3: "s13_${i % 100}"}
}

const Sh = []int{3, 4, 0, 10, 1, 12, 2, 14, 11, 48, 0, 0, 1, 1, 3, 4, 3, 24, 4, 26, 5, 28, 10, 46, 0, 2, 1, 3, 3, 4, 6, 38, 7, 40, 8, 42, 9, 44, 0, 4, 1, 5, 0, 6, 1, 7, 0, 8, 1, 9}

func name(id int) string {
    return switch id {
    case 0: "x0"
    case 1: "x1"
    case 2: "x2"
    case 3: "y0"
    case 4: "y1"
    case 5: "y2"
    case 6: "z0"
    case 7: "z1"
    case 8: "z2"
    case 9: "z3"
    case 10: "y3"
    case 11: "x3"
    default: ""
    }
}

func leafInt(v R, id int) int {
    return switch id {
    case 0: v.x0
    case 2: v.x2.y0
    case 4: v.x2.y2.z0
    case 6: v.x2.y2.z2
    case 8: v.x2.y3
    default: 0
    }
}

func leafStr(v R, id int) string {
    return switch id {
    case 1: v.x1
    case 3: v.x2.y1
    case 5: v.x2.y2.z1
    case 7: v.x2.y2.z3
    case 9: v.x3
    default: ""
    }
}

// 定数の表 sh の節 node に従って v を書く（kind と葉の番号で読みを選ぶ — 実験2の dyn の読みの代用）
func walk(o mut builder.Builder[byte], v R, sh []int, node int) {
    k := sh[node]
    if k == 0 {
        json.PutInt(mut o, leafInt(v, sh[node + 1]))
    } else if k == 1 {
        json.PutString(mut o, leafStr(v, sh[node + 1]))
    } else {
        n := sh[node + 1]
        builder.Push(mut o, '{')
        for i <- iter.Range(0, n) {
            json.PutKey(mut o, name(sh[node + 2 + 2 * i]), i == 0)
            walk(mut o, v, sh, sh[node + 3 + 2 * i])
        }
        builder.Push(mut o, '}')
    }
}

func enc(v R) string {
    mut o := builder.Builder[byte]{}
    walk(mut o, v, Sh, 0)
    return json.Done(mut o)
}

func main() {
    println(enc(mk(7)))
    mut total := 0
    for i <- iter.Range(0, 200000) {
        total += len(bytes(enc(mk(i))))
    }
    println(total)
}
