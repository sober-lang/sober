package main

// 実験3（shape-m0）の題材 f4・形 json。gen.ts の生成物

import "std/iter"
import "std/json"

type R struct {
    a0 int
    a1 string
    a2 int
    a3 string
}

func mk(i int) R {
    return R{a0: i + 10, a1: "s11_${i % 100}", a2: i + 12, a3: "s13_${i % 100}"}
}

func enc(v R) string {
    return json.Encode[R](v)
}

func main() {
    println(enc(mk(7)))
    mut total := 0
    for i <- iter.Range(0, 200000) {
        total += len(bytes(enc(mk(i))))
    }
    println(total)
}
