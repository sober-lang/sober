package main

// 実験3（shape-m0）の題材 f4・形 walk。gen.ts の生成物

import "std/builder"
import "std/iter"
import "std/json"

type R struct {
    a0 int
    a1 string
    a2 int
    a3 string
}

func mk(i int) R {
    return R{a0: i + 10, a1: "s11_${i % 100}", a2: i + 12, a3: "s13_${i % 100}"}
}

const Sh = []int{3, 4, 0, 10, 1, 12, 2, 14, 3, 16, 0, 0, 1, 1, 0, 2, 1, 3}

func name(id int) string {
    return switch id {
    case 0: "a0"
    case 1: "a1"
    case 2: "a2"
    case 3: "a3"
    default: ""
    }
}

func leafInt(v R, id int) int {
    return switch id {
    case 0: v.a0
    case 2: v.a2
    default: 0
    }
}

func leafStr(v R, id int) string {
    return switch id {
    case 1: v.a1
    case 3: v.a3
    default: ""
    }
}

// 定数の表 sh の節 node に従って v を書く（kind と葉の番号で読みを選ぶ — 実験2の dyn の読みの代用）
func walk(o mut builder.Builder[byte], v R, sh []int, node int) {
    k := sh[node]
    if k == 0 {
        json.PutInt(mut o, leafInt(v, sh[node + 1]))
    } else if k == 1 {
        json.PutString(mut o, leafStr(v, sh[node + 1]))
    } else {
        n := sh[node + 1]
        builder.Push(mut o, '{')
        for i <- iter.Range(0, n) {
            json.PutKey(mut o, name(sh[node + 2 + 2 * i]), i == 0)
            walk(mut o, v, sh, sh[node + 3 + 2 * i])
        }
        builder.Push(mut o, '}')
    }
}

func enc(v R) string {
    mut o := builder.Builder[byte]{}
    walk(mut o, v, Sh, 0)
    return json.Done(mut o)
}

func main() {
    println(enc(mk(7)))
    mut total := 0
    for i <- iter.Range(0, 200000) {
        total += len(bytes(enc(mk(i))))
    }
    println(total)
}
