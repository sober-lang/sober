package main

// 実験3（shape-m0）の題材 f32・形 walk。gen.ts の生成物

import "std/builder"
import "std/iter"
import "std/json"

type R struct {
    a0 int
    a1 string
    a2 int
    a3 string
    a4 int
    a5 string
    a6 int
    a7 string
    a8 int
    a9 string
    a10 int
    a11 string
    a12 int
    a13 string
    a14 int
    a15 string
    a16 int
    a17 string
    a18 int
    a19 string
    a20 int
    a21 string
    a22 int
    a23 string
    a24 int
    a25 string
    a26 int
    a27 string
    a28 int
    a29 string
    a30 int
    a31 string
}

func mk(i int) R {
    return R{a0: i + 10, a1: "s11_${i % 100}", a2: i + 12, a3: "s13_${i % 100}", a4: i + 14, a5: "s15_${i % 100}", a6: i + 16, a7: "s17_${i % 100}", a8: i + 18, a9: "s19_${i % 100}", a10: i + 20, a11: "s21_${i % 100}", a12: i + 22, a13: "s23_${i % 100}", a14: i + 24, a15: "s25_${i % 100}", a16: i + 26, a17: "s27_${i % 100}", a18: i + 28, a19: "s29_${i % 100}", a20: i + 30, a21: "s31_${i % 100}", a22: i + 32, a23: "s33_${i % 100}", a24: i + 34, a25: "s35_${i % 100}", a26: i + 36, a27: "s37_${i % 100}", a28: i + 38, a29: "s39_${i % 100}", a30: i + 40, a31: "s41_${i % 100}"}
}

const Sh = []int{3, 32, 0, 66, 1, 68, 2, 70, 3, 72, 4, 74, 5, 76, 6, 78, 7, 80, 8, 82, 9, 84, 10, 86, 11, 88, 12, 90, 13, 92, 14, 94, 15, 96, 16, 98, 17, 100, 18, 102, 19, 104, 20, 106, 21, 108, 22, 110, 23, 112, 24, 114, 25, 116, 26, 118, 27, 120, 28, 122, 29, 124, 30, 126, 31, 128, 0, 0, 1, 1, 0, 2, 1, 3, 0, 4, 1, 5, 0, 6, 1, 7, 0, 8, 1, 9, 0, 10, 1, 11, 0, 12, 1, 13, 0, 14, 1, 15, 0, 16, 1, 17, 0, 18, 1, 19, 0, 20, 1, 21, 0, 22, 1, 23, 0, 24, 1, 25, 0, 26, 1, 27, 0, 28, 1, 29, 0, 30, 1, 31}

func name(id int) string {
    return switch id {
    case 0: "a0"
    case 1: "a1"
    case 2: "a2"
    case 3: "a3"
    case 4: "a4"
    case 5: "a5"
    case 6: "a6"
    case 7: "a7"
    case 8: "a8"
    case 9: "a9"
    case 10: "a10"
    case 11: "a11"
    case 12: "a12"
    case 13: "a13"
    case 14: "a14"
    case 15: "a15"
    case 16: "a16"
    case 17: "a17"
    case 18: "a18"
    case 19: "a19"
    case 20: "a20"
    case 21: "a21"
    case 22: "a22"
    case 23: "a23"
    case 24: "a24"
    case 25: "a25"
    case 26: "a26"
    case 27: "a27"
    case 28: "a28"
    case 29: "a29"
    case 30: "a30"
    case 31: "a31"
    default: ""
    }
}

func leafInt(v R, id int) int {
    return switch id {
    case 0: v.a0
    case 2: v.a2
    case 4: v.a4
    case 6: v.a6
    case 8: v.a8
    case 10: v.a10
    case 12: v.a12
    case 14: v.a14
    case 16: v.a16
    case 18: v.a18
    case 20: v.a20
    case 22: v.a22
    case 24: v.a24
    case 26: v.a26
    case 28: v.a28
    case 30: v.a30
    default: 0
    }
}

func leafStr(v R, id int) string {
    return switch id {
    case 1: v.a1
    case 3: v.a3
    case 5: v.a5
    case 7: v.a7
    case 9: v.a9
    case 11: v.a11
    case 13: v.a13
    case 15: v.a15
    case 17: v.a17
    case 19: v.a19
    case 21: v.a21
    case 23: v.a23
    case 25: v.a25
    case 27: v.a27
    case 29: v.a29
    case 31: v.a31
    default: ""
    }
}

// 定数の表 sh の節 node に従って v を書く（kind と葉の番号で読みを選ぶ — 実験2の dyn の読みの代用）
func walk(o mut builder.Builder[byte], v R, sh []int, node int) {
    k := sh[node]
    if k == 0 {
        json.PutInt(mut o, leafInt(v, sh[node + 1]))
    } else if k == 1 {
        json.PutString(mut o, leafStr(v, sh[node + 1]))
    } else {
        n := sh[node + 1]
        builder.Push(mut o, '{')
        for i <- iter.Range(0, n) {
            json.PutKey(mut o, name(sh[node + 2 + 2 * i]), i == 0)
            walk(mut o, v, sh, sh[node + 3 + 2 * i])
        }
        builder.Push(mut o, '}')
    }
}

func enc(v R) string {
    mut o := builder.Builder[byte]{}
    walk(mut o, v, Sh, 0)
    return json.Done(mut o)
}

func main() {
    println(enc(mk(7)))
    mut total := 0
    for i <- iter.Range(0, 200000) {
        total += len(bytes(enc(mk(i))))
    }
    println(total)
}
