package main

// 実験3（shape-m0）の題材 f16・形 walk。gen.ts の生成物

import "std/builder"
import "std/iter"
import "std/json"

type R struct {
    a0 int
    a1 string
    a2 int
    a3 string
    a4 int
    a5 string
    a6 int
    a7 string
    a8 int
    a9 string
    a10 int
    a11 string
    a12 int
    a13 string
    a14 int
    a15 string
}

func mk(i int) R {
    return R{a0: i + 10, a1: "s11_${i % 100}", a2: i + 12, a3: "s13_${i % 100}", a4: i + 14, a5: "s15_${i % 100}", a6: i + 16, a7: "s17_${i % 100}", a8: i + 18, a9: "s19_${i % 100}", a10: i + 20, a11: "s21_${i % 100}", a12: i + 22, a13: "s23_${i % 100}", a14: i + 24, a15: "s25_${i % 100}"}
}

const Sh = []int{3, 16, 0, 34, 1, 36, 2, 38, 3, 40, 4, 42, 5, 44, 6, 46, 7, 48, 8, 50, 9, 52, 10, 54, 11, 56, 12, 58, 13, 60, 14, 62, 15, 64, 0, 0, 1, 1, 0, 2, 1, 3, 0, 4, 1, 5, 0, 6, 1, 7, 0, 8, 1, 9, 0, 10, 1, 11, 0, 12, 1, 13, 0, 14, 1, 15}

func name(id int) string {
    return switch id {
    case 0: "a0"
    case 1: "a1"
    case 2: "a2"
    case 3: "a3"
    case 4: "a4"
    case 5: "a5"
    case 6: "a6"
    case 7: "a7"
    case 8: "a8"
    case 9: "a9"
    case 10: "a10"
    case 11: "a11"
    case 12: "a12"
    case 13: "a13"
    case 14: "a14"
    case 15: "a15"
    default: ""
    }
}

func leafInt(v R, id int) int {
    return switch id {
    case 0: v.a0
    case 2: v.a2
    case 4: v.a4
    case 6: v.a6
    case 8: v.a8
    case 10: v.a10
    case 12: v.a12
    case 14: v.a14
    default: 0
    }
}

func leafStr(v R, id int) string {
    return switch id {
    case 1: v.a1
    case 3: v.a3
    case 5: v.a5
    case 7: v.a7
    case 9: v.a9
    case 11: v.a11
    case 13: v.a13
    case 15: v.a15
    default: ""
    }
}

// 定数の表 sh の節 node に従って v を書く（kind と葉の番号で読みを選ぶ — 実験2の dyn の読みの代用）
func walk(o mut builder.Builder[byte], v R, sh []int, node int) {
    k := sh[node]
    if k == 0 {
        json.PutInt(mut o, leafInt(v, sh[node + 1]))
    } else if k == 1 {
        json.PutString(mut o, leafStr(v, sh[node + 1]))
    } else {
        n := sh[node + 1]
        builder.Push(mut o, '{')
        for i <- iter.Range(0, n) {
            json.PutKey(mut o, name(sh[node + 2 + 2 * i]), i == 0)
            walk(mut o, v, sh, sh[node + 3 + 2 * i])
        }
        builder.Push(mut o, '}')
    }
}

func enc(v R) string {
    mut o := builder.Builder[byte]{}
    walk(mut o, v, Sh, 0)
    return json.Done(mut o)
}

func main() {
    println(enc(mk(7)))
    mut total := 0
    for i <- iter.Range(0, 200000) {
        total += len(bytes(enc(mk(i))))
    }
    println(total)
}
